n ya desplegada." style="text;html=0;whiteSpace=wrap;align=left;fontSize=15;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="885" width="1330" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="capas" name="N1 - La solución organizada por capas"><mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="EXUX | UNIVERSIDAD MAYA | PROPUESTA SIN APLICAR" style="text;html=0;align=left;fontSize=12;fontColor=#587286;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1300" height="30" as="geometry" /></mxCell><mxCell id="title" value="La solución organizada por capas" style="text;html=0;align=left;fontSize=26;fontStyle=1;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="50" width="1340" height="50" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;1 · Personas y acceso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Áreas, responsables y auditores · Empresa, sucursal y permisos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="105" y="140" width="1180" height="94" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;2 · Experiencia de usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Portales y pantallas para solicitar, operar, autorizar y consultar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#A8BCCC;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="105" y="270" width="1180" height="94" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;3 · Procesos y servicios de negocio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;15 módulos · Reglas, validaciones y transacciones coordinadas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#096D9B;strokeColor=#096D9B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="105" y="400" width="1180" height="94" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;4 · Persistencia y evidencia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SQL Server · EmptyProjects + complemento de GestionEmpresarial + ERD EXUX&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#FCF5E8;strokeColor=#D0AC69;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="105" y="530" width="1180" height="94" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;5 · Intercambio con otros sistemas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Contratos de banco, SAT/PAC y OCR por definir · No se implementaron conectores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F5F1FA;strokeColor=#AA95C4;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="105" y="660" width="1180" height="94" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="interfaces posteriores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="447.0" /><mxPoint x="40" y="707.0" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Dependencia conceptual entre responsabilidades; no son claves foráneas." style="text;html=0;whiteSpace=wrap;align=left;fontSize=12;fontColor=#5E7282;" vertex="1" parent="1"><mxGeometry x="25" y="840" width="1330" height="35" as="geometry" /></mxCell><mxCell id="note" value="Las capas superiores son una propuesta de organización. Los scripts entregados concretan principalmente la capa de datos." style="text;html=0;whiteSpace=wrap;align=left;fontSize=15;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="885" width="1330" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="modulos" name="N2 - Mapa de módulos"><mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="EXUX | UNIVERSIDAD MAYA | PROPUESTA SIN APLICAR" style="text;html=0;align=left;fontSize=12;fontColor=#587286;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1300" height="30" as="geometry" /></mxCell><mxCell id="title" value="Mapa de módulos" style