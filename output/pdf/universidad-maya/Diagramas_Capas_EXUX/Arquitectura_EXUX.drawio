 parent="1" source="n5" target="n0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="350" /><mxPoint x="220.0" y="350" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Relaciones reales del SQL propuesto. ALMA.Almacen es el registro legado, no el catálogo físico nuevo." style="text;html=0;whiteSpace=wrap;align=left;fontSize=12;fontColor=#5E7282;" vertex="1" parent="1"><mxGeometry x="25" y="840" width="1330" height="35" as="geometry" /></mxCell><mxCell id="note" value="Las FK compuestas verifican coherencia de empresa, almacén y producto. La disponibilidad concurrente debe protegerse al reservar y aplicar movimientos." style="text;html=0;whiteSpace=wrap;align=left;fontSize=15;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="885" width="1330" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="transferencia" name="N4 - Transferencia con recepción parcial"><mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="EXUX | UNIVERSIDAD MAYA | PROPUESTA SIN APLICAR" style="text;html=0;align=left;fontSize=12;fontColor=#587286;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1300" height="30" as="geometry" /></mxCell><mxCell id="title" value="Transferencia con recepción parcial" style="text;html=0;align=left;fontSize=26;fontStyle=1;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="50" width="1340" height="50" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;Origen · 100&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;INICIO&lt;br&gt;Disponible en almacén de origen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="330" height="125" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Tránsito · 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;INICIO&lt;br&gt;Sin mercancía enviada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="330" height="125" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Destino · 20&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;INICIO&lt;br&gt;Existencia previa en destino&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="1015" y="150" width="330" height="125" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Origen · 60&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ENVÍO DE 40&lt;br&gt;Movimiento de salida: -40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#EFF8F3;strokeColor=#7FBAA5;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="65" y="395" width="330" height="125" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Tránsito · 40&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ENVÍO DE 40&lt;br&gt;Movimiento de entrada: +40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#096D9B;strokeColor=#096D9B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="540" y="395" width="330" height="125" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Destino · 20&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ENVÍO DE 40&lt;br&gt;Aún no recibe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="1015" y="395" width="330" height="125" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Origen · 60&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RECEPCIÓN DE 25&lt;br&gt;No cambia con la recepción&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="65" y="640" width="330" height="125" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Tránsito · 15&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RECEPCIÓN DE 25&lt;br&gt;Salida: -25; faltan por recibir 15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#096D9B;strokeColor=#096D9B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="330" height="125" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Destino · 45&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RECEPCIÓN DE 25&lt;br&gt;Movimiento de entrada: +25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#EFF8F3;strokeColor=#7FBAA5;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="1015" y="640" width="330" height="125" as="geometry" /></mxCell><mxCell id="e0" value="40 enviadas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="25 recibidas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="legend" value="Ejemplo operativo, no transacciones ejecutadas. Cada fila suma 120 unidades." style="text;html=0;whiteSpace=wrap;align=left;fontSize=12;fontColor=#5E7282;" vertex="1" parent="1"><mxGeometry x="25" y="840" width="1330" height="35" as="geometry" /></mxCell><mxCell id="note" value="Cada envío y recepción genera movimientos compensados. Las 15 unidades en tránsito no se cuentan como recibidas en destino." style="text;html=0;whiteSpace=wrap;align=left;fontSize=15;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="885" width="1330" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="despliegue" name="N4 - Del diseño a una base preparada"><mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="EXUX | UNIVERSIDAD MAYA | PROPUESTA SIN APLICAR" style="text;html=0;align=left;fontSize=12;fontColor=#587286;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1300" height="30" as="geometry" /></mxCell><mxCell id="title" value="Del diseño a una base preparada" style="text;html=0;align=left;fontSize=26;fontStyle=1;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="50" width="1340" height="50" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;EmptyProjects&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;26 tablas de origen&lt;br&gt;Seguridad y organización&lt;br&gt;Base destino de referencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F0F4F8;strokeColor=#ABBDC9;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="35" y="290" width="285" height="175" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Complemento seleccionado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;169 tablas de GestionEmpresarial&lt;br&gt;Sin módulo RH&lt;br&gt;Adaptaciones por reestructura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#FCF5E8;strokeColor=#D0AC69;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="385" y="290" width="300" height="175" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Ampliación ERD EXUX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;90 tablas nuevas&lt;br&gt;Multi almacén y brechas&lt;br&gt;128 entidades trazadas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#EFF8F3;strokeColor=#7FBAA5;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="750" y="290" width="285" height="175" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Paquete modular&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;35 archivos SQL&lt;br&gt;A · Estructuras&lt;br&gt;B · Relaciones&lt;br&gt;C · Controles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#096D9B;strokeColor=#096D9B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1105" y="290" width="270" height="175" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Pendiente para operar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Aplicación autorizada · Carga de catálogos y saldos · Adaptación de servicios · Pruebas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=17;fontFamily=Arial;fillColor=#F5F1FA;strokeColor=#AA95C4;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="355" y="615" width="700" height="112" as="geometry" /></mxCell><mxCell id="e0" value="base" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="ampliación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="archivo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="trabajo posterior" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#658A9F;fontColor=#456A80;fontSize=12;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1105" y="671.0" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Ruta de preparación propuesta. No se crearon ni alteraron objetos en las bases." style="text;html=0;whiteSpace=wrap;align=left;fontSize=12;fontColor=#5E7282;" vertex="1" parent="1"><mxGeometry x="25" y="840" width="1330" height="35" as="geometry" /></mxCell><mxCell id="note" value="Se revisaron sintaxis y modelo sin ejecutar los scripts. El diseño de tablas no acredita integración, carga de datos ni operación del sistema." style="text;html=0;whiteSpace=wrap;align=left;fontSize=15;fontColor=#143044;" vertex="1" parent="1"><mxGeometry x="25" y="885" width="1330" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>