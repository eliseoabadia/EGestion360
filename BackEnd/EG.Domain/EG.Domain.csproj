<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <DefineConstants>$(DefineConstants);EG_BROWSER_WASM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Compile Remove="Interfaces\IRepositorySP.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DTOs\Requests\ConteoCiclico\" />
    <Folder Include="DTOs\Responses\ConteoCiclico\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EG.Common\EG.Common.csproj" />
  </ItemGroup>

</Project>
