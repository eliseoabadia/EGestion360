@page "/Presupuesto/Tesorería/Inversiones/Listado_Inversiones"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Dommain.DTOs.Responses
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<InversionResponse, InversionResponse>

@inject IGenericCrudService<InteresResponse> InteresService
@inject IGenericCrudService<RetiroResponse> RetiroService
@inject IGenericCrudService<PolizaDetalleResponse> PolizaDetalleService
@inject IGenericCrudService<PolizaResponse> PolizaService
@inject IGenericCrudService<UsuarioResponse> UsuarioService

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        @if (SelectedInversion == null)
        {
            <div Style="display:flex;flex-direction:column;flex-grow:1;overflow:hidden;min-height:0;">
                <PageHeader Title="Listado de Inversiones"
                            Subtitle="Control integral de inversiones y su detalle contable (debe / haber)"
                            Icon="@Icons.Material.Filled.AssuredWorkload"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex-grow:1;overflow:hidden;min-height:0;">
                    <GenericTable TItem="InversionResponse"
                                  @ref="table"
                                  Title="Inversiones"
                                  SearchPlaceholder="Buscar por cuenta, instrumento o monto..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
                        <Header>
                            <MudTh>Acciones</MudTh>
                            <MudTh><MudTableSortLabel SortLabel="PkidInversion" T="InversionResponse">ID</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="CuentaBan" T="InversionResponse">Cuenta bancaria</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Instrumento" T="InversionResponse">Instrumento</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Monto" T="InversionResponse">Monto</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Intereses" T="InversionResponse">Intereses</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Retiros" T="InversionResponse">Retiros</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Saldo" T="InversionResponse">Saldo</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="FechaInversion" T="InversionResponse">Fecha inversion</MudTableSortLabel></MudTh>
                            <MudTh>Estado</MudTh>
                        </Header>
                        <Row Context="item">
                            <MudTd>
                                <MudTooltip Text="Ver detalle">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Info" OnClick="@(() => SelectInversion(item))" />
                                </MudTooltip>
                                <MudTooltip Text="Editar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Visible="@CanUpdate"
                                                   Disabled="@IsLocked(item.PkidInversion)"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => EditItem(item.PkidInversion))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Visible="@CanDelete"
                                                   Disabled="@IsLocked(item.PkidInversion)"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteItem(item.PkidInversion))" />
                                </MudTooltip>
                            </MudTd>
                            <MudTd>@item.PkidInversion</MudTd>
                            <MudTd>@TextOrDash(item.CuentaBan)</MudTd>
                            <MudTd>@TextOrDash(item.Instrumento)</MudTd>
                            <MudTd>@Money(item.Monto)</MudTd>
                            <MudTd>@Money(item.Intereses)</MudTd>
                            <MudTd>@Money(item.Retiros)</MudTd>
                            <MudTd>@Money(item.Saldo ?? item.Monto)</MudTd>
                            <MudTd>@item.FechaInversion.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>
                                @if (IsLocked(item.PkidInversion))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Autorizada</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">En captura</MudChip>
                                }
                            </MudTd>
                        </Row>
                    </GenericTable>
                </div>
            </div>
        }
        else
        {
            <div Style="display:flex;flex-direction:column;flex-grow:1;overflow:hidden;min-height:0;gap:8px;">
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background:transparent;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="BackToTable" />
                    <div class="ml-2">
                        <MudText Typo="Typo.h6" Style="font-weight:700">@TextOrDash(SelectedInversion.Instrumento)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@TextOrDash(SelectedInversion.CuentaBan)</MudText>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedLocked ? Color.Success : Color.Warning)">
                        @(SelectedLocked ? "Autorizada" : "Pendiente de autorizacion")
                    </MudChip>
                    <MudTooltip Text="Agregar interes">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Visible="@CanCreate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Success" OnClick="AddInteres" Class="ml-2" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar retiro">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Visible="@CanCreate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Warning" OnClick="AddRetiro" Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar movimiento contable">
                        <MudIconButton Icon="@Icons.Material.Filled.PostAdd" Visible="@CanCreate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Info" OnClick="AddContabilidad" Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Actualizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Default" OnClick="RefreshSelectedAndChildren" Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-3" Style="flex-shrink:0;border-radius:8px;">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Monto</MudText><MudText Typo="Typo.body2" Style="font-weight:700">@Money(SelectedInversion.Monto)</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Intereses</MudText><MudText Typo="Typo.body2" Style="font-weight:700">@Money(SelectedInversion.Intereses)</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Retiros</MudText><MudText Typo="Typo.body2" Style="font-weight:700">@Money(SelectedInversion.Retiros)</MudText></MudItem>
                        <MudItem xs="6" md="3"><MudText Typo="Typo.caption">Saldo</MudText><MudText Typo="Typo.body2" Style="font-weight:700">@Money(SelectedInversion.Saldo ?? SelectedInversion.Monto)</MudText></MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTabs Rounded="true" Border="true" Color="Color.Primary" Style="flex-grow:1;overflow:hidden;min-height:0;">
                    <MudTabPanel Text="Intereses">
                        <GenericTable TItem="InteresResponse" @ref="interesTable" Title="Intereses"
                                      SearchPlaceholder="Buscar por monto o fecha..."
                                      ServerDataFunc="LoadInteresesData"
                                      SearchString="@interesSearch"
                                      SearchStringChanged="(s) => interesSearch = s"
                                      OnSearch="ReloadIntereses">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh>ID</MudTh>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Monto</MudTh>
                            </Header>
                            <Row Context="item">
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditInteres(item.PkidInteres))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteInteres(item.PkidInteres))" />
                                </MudTd>
                                <MudTd>@item.PkidInteres</MudTd>
                                <MudTd>@item.FechaGeneracion.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>@Money(item.Monto)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Retiros">
                        <GenericTable TItem="RetiroResponse" @ref="retiroTable" Title="Retiros"
                                      SearchPlaceholder="Buscar por monto o fecha..."
                                      ServerDataFunc="LoadRetirosData"
                                      SearchString="@retiroSearch"
                                      SearchStringChanged="(s) => retiroSearch = s"
                                      OnSearch="ReloadRetiros">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh>ID</MudTh>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Tipo de retiro</MudTh>
                                <MudTh>Monto</MudTh>
                            </Header>
                            <Row Context="item">
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditRetiro(item.PkidRetiro))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRetiro(item.PkidRetiro))" />
                                </MudTd>
                                <MudTd>@item.PkidRetiro</MudTd>
                                <MudTd>@item.FechaRetiro.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>@(string.IsNullOrWhiteSpace(item.TipoRetiroDescripcion) ? "-" : item.TipoRetiroDescripcion)</MudTd>
                                <MudTd>@Money(item.Monto)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudTabPanel>
                    <MudTabPanel Text="Contabilidad (Debe/Haber)">
                        <GenericTable TItem="PolizaDetalleResponse" @ref="contaTable" Title="Movimientos contables"
                                      SearchPlaceholder="Buscar por poliza, cuenta o concepto..."
                                      ServerDataFunc="LoadContaData"
                                      SearchString="@contaSearch"
                                      SearchStringChanged="(s) => contaSearch = s"
                                      OnSearch="ReloadConta">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh>Poliza</MudTh>
                                <MudTh>Cuenta</MudTh>
                                <MudTh>Concepto</MudTh>
                                <MudTh>Debe</MudTh>
                                <MudTh>Haber</MudTh>
                                <MudTh>Estado</MudTh>
                            </Header>
                            <Row Context="item">
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditContabilidad(item.PkidPolizaDetalle))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteContabilidad(item.PkidPolizaDetalle))" />
                                    @if (CanAuthorize && !IsPolizaAutorizada(item.FkidPolizaConta))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Verified" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Success" OnClick="@(() => AutorizarPoliza(item.FkidPolizaConta))" />
                                    }
                                </MudTd>
                                <MudTd>@item.ClavePoliza</MudTd>
                                <MudTd>@item.CuentaClaveNombre</MudTd>
                                <MudTd>@item.Descripcion</MudTd>
                                <MudTd>@Money(item.ImporteDebe ?? 0m)</MudTd>
                                <MudTd>@Money(item.ImporteHaber ?? 0m)</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@(IsPolizaAutorizada(item.FkidPolizaConta) ? Color.Success : Color.Warning)">
                                        @(IsPolizaAutorizada(item.FkidPolizaConta) ? "Autorizada" : "Pendiente")
                                    </MudChip>
                                </MudTd>
                            </Row>
                        </GenericTable>
                    </MudTabPanel>
                </MudTabs>
            </div>
        }
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<InversionResponse> table = null!;
    private GenericTable<InteresResponse> interesTable = null!;
    private GenericTable<RetiroResponse> retiroTable = null!;
    private GenericTable<PolizaDetalleResponse> contaTable = null!;
    private InversionResponse? SelectedInversion;

    private string interesSearch = string.Empty;
    private string retiroSearch = string.Empty;
    private string contaSearch = string.Empty;
    private string _currencySymbol = "$";
    private bool SelectedLocked;
    private readonly Dictionary<int, bool> _lockByInversionId = new();
    private readonly Dictionary<int, bool> _autorizacionPoliza = new();
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Listado_Inversiones";
    protected override Type CreateDialogType => typeof(InversionDialog);
    protected override Type EditDialogType => typeof(InversionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<InversionResponse>);
    protected override string GetDefaultSortLabel() => "FechaInversion";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<InversionResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var data = await base.LoadServerData(state, cancellationToken);
        await BuildLockStatusAsync(data.Items);
        return data;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<InversionResponse> items) =>
        items.Select(x => new
        {
            x.PkidInversion,
            x.CuentaBan,
            x.Instrumento,
            Monto = x.Monto.ToString("0.00", NumberCulture),
            Intereses = x.Intereses.ToString("0.00", NumberCulture),
            Retiros = x.Retiros.ToString("0.00", NumberCulture),
            Saldo = (x.Saldo ?? x.Monto).ToString("0.00", NumberCulture),
            FechaInversion = x.FechaInversion.ToString("dd/MM/yyyy")
        });

    protected override async Task ReloadData()
    {
        if (table != null) await table.ReloadData();
    }

    private async Task SelectInversion(InversionResponse item)
    {
        SelectedInversion = item;
        interesSearch = string.Empty;
        retiroSearch = string.Empty;
        contaSearch = string.Empty;
        await RefreshSelectedAndChildren();
        await InvokeAsync(StateHasChanged);
    }

    private async Task BackToTable()
    {
        SelectedInversion = null;
        if (table != null) await table.ReloadData();
    }

    private async Task RefreshSelectedAndChildren()
    {
        if (SelectedInversion == null) return;
        await RefreshSelectedInversion();
        await ReloadIntereses();
        await ReloadRetiros();
        await ReloadConta();
        await EvaluateSelectedLockAsync();
    }

    private async Task RefreshSelectedInversion()
    {
        if (SelectedInversion == null) return;
        var response = await Service.GetByIdAsync(SelectedInversion.PkidInversion);
        if (response?.Success == true && response.Data != null)
        {
            SelectedInversion = response.Data;
        }
    }

    private async Task<TableData<InteresResponse>> LoadInteresesData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedInversion == null) return new TableData<InteresResponse> { Items = [], TotalItems = 0 };
        var response = await InteresService.GetAllPaginadoAsync(Math.Max(1, state.Page + 1), state.PageSize, interesSearch, state.SortLabel ?? "FechaGeneracion", state.SortDirection, new() { ["FkidInversion"] = SelectedInversion.PkidInversion });
        return new TableData<InteresResponse> { Items = response?.Items ?? [], TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task<TableData<RetiroResponse>> LoadRetirosData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedInversion == null) return new TableData<RetiroResponse> { Items = [], TotalItems = 0 };
        var response = await RetiroService.GetAllPaginadoAsync(Math.Max(1, state.Page + 1), state.PageSize, retiroSearch, state.SortLabel ?? "FechaRetiro", state.SortDirection, new() { ["FkidInversion"] = SelectedInversion.PkidInversion });
        return new TableData<RetiroResponse> { Items = response?.Items ?? [], TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task<TableData<PolizaDetalleResponse>> LoadContaData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedInversion == null) return new TableData<PolizaDetalleResponse> { Items = [], TotalItems = 0 };

        var response = await PolizaDetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            contaSearch,
            state.SortLabel ?? "PkidPolizaDetalle",
            state.SortDirection,
            new() { ["FkidReferencia"] = SelectedInversion.PkidInversion });

        var items = response?.Items?.ToList() ?? new List<PolizaDetalleResponse>();
        await LoadPolizasStateAsync(items);
        return new TableData<PolizaDetalleResponse> { Items = items, TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task LoadPolizasStateAsync(IEnumerable<PolizaDetalleResponse> details)
    {
        var polizaIds = details.Select(x => x.FkidPolizaConta).Distinct().ToList();
        foreach (var polizaId in polizaIds)
        {
            if (_autorizacionPoliza.ContainsKey(polizaId)) continue;
            var polizaResponse = await PolizaService.GetByIdAsync(polizaId);
            _autorizacionPoliza[polizaId] = polizaResponse?.Success == true && polizaResponse.Data?.Autorizado == true;
        }
    }

    private async Task BuildLockStatusAsync(IEnumerable<InversionResponse> inversiones)
    {
        foreach (var inversion in inversiones)
        {
            if (_lockByInversionId.ContainsKey(inversion.PkidInversion)) continue;
            var locked = await IsInversionLockedAsync(inversion.PkidInversion);
            _lockByInversionId[inversion.PkidInversion] = locked;
        }
    }

    private async Task EvaluateSelectedLockAsync()
    {
        if (SelectedInversion == null)
        {
            SelectedLocked = false;
            return;
        }

        SelectedLocked = await IsInversionLockedAsync(SelectedInversion.PkidInversion);
        _lockByInversionId[SelectedInversion.PkidInversion] = SelectedLocked;
        StateHasChanged();
    }

    private async Task<bool> IsInversionLockedAsync(int inversionId)
    {
        var conta = await PolizaDetalleService.GetAllPaginadoAsync(1, 200, string.Empty, "PkidPolizaDetalle", SortDirection.Descending, new() { ["FkidReferencia"] = inversionId });
        var detalles = conta?.Items?.ToList() ?? new List<PolizaDetalleResponse>();
        if (detalles.Count == 0) return false;

        await LoadPolizasStateAsync(detalles);
        return detalles.Any(d => IsPolizaAutorizada(d.FkidPolizaConta));
    }

    private bool IsPolizaAutorizada(int polizaId) =>
        _autorizacionPoliza.TryGetValue(polizaId, out var autorizado) && autorizado;

    private bool IsLocked(int inversionId) =>
        _lockByInversionId.TryGetValue(inversionId, out var locked) && locked;

    private async Task ReloadIntereses() { if (interesTable != null) await interesTable.ReloadData(); }
    private async Task ReloadRetiros() { if (retiroTable != null) await retiroTable.ReloadData(); }
    private async Task ReloadConta() { if (contaTable != null) await contaTable.ReloadData(); }

    private async Task AddInteres() => await OpenInteresDialog(null);
    private async Task EditInteres(int id) => await OpenInteresDialog(id);
    private async Task AddRetiro() => await OpenRetiroDialog(null);
    private async Task EditRetiro(int id) => await OpenRetiroDialog(id);
    private async Task AddContabilidad() => await OpenContabilidadDialog(null);
    private async Task EditContabilidad(int id) => await OpenContabilidadDialog(id);

    private async Task OpenInteresDialog(int? id)
    {
        if (SelectedInversion == null || SelectedLocked) return;
        var parameters = new DialogParameters { ["Id"] = id, ["InversionId"] = SelectedInversion.PkidInversion };
        var dialog = await DialogService.ShowAsync<InversionInteresDialog>(id.HasValue ? "Editar interes" : "Nuevo interes", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await RefreshSelectedAndChildren();
    }

    private async Task OpenRetiroDialog(int? id)
    {
        if (SelectedInversion == null || SelectedLocked) return;
        var parameters = new DialogParameters { ["Id"] = id, ["InversionId"] = SelectedInversion.PkidInversion };
        var dialog = await DialogService.ShowAsync<InversionRetiroDialog>(id.HasValue ? "Editar retiro" : "Nuevo retiro", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await RefreshSelectedAndChildren();
    }

    private async Task OpenContabilidadDialog(int? id)
    {
        if (SelectedInversion == null || SelectedLocked) return;
        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["InversionId"] = SelectedInversion.PkidInversion,
            ["CurrencySymbol"] = _currencySymbol
        };
        var dialog = await DialogService.ShowAsync<InversionContabilidadDialog>(id.HasValue ? "Editar movimiento contable" : "Nuevo movimiento contable", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await RefreshSelectedAndChildren();
    }

    private async Task DeleteInteres(int id)
    {
        if (SelectedLocked) return;
        await InteresService.DeleteAsync(id);
        await RefreshSelectedAndChildren();
    }

    private async Task DeleteRetiro(int id)
    {
        if (SelectedLocked) return;
        await RetiroService.DeleteAsync(id);
        await RefreshSelectedAndChildren();
    }

    private async Task DeleteContabilidad(int id)
    {
        if (SelectedLocked) return;
        await PolizaDetalleService.DeleteAsync(id);
        await RefreshSelectedAndChildren();
    }

    private async Task AutorizarPoliza(int polizaId)
    {
        if (SelectedLocked) return;
        var polizaResponse = await PolizaService.GetByIdAsync(polizaId);
        if (polizaResponse?.Success != true || polizaResponse.Data == null)
        {
            Snackbar.Add("No se pudo cargar la poliza.", Severity.Error);
            return;
        }

        var poliza = polizaResponse.Data;
        if (poliza.Autorizado == true)
        {
            await EvaluateSelectedLockAsync();
            return;
        }

        poliza.Autorizado = true;
        poliza.PermitirModificar = false;
        poliza.FechaAutorizacion = DateTime.Now;
        var update = await PolizaService.UpdateAsync(poliza, polizaId);
        if (update?.Success == true)
        {
            _autorizacionPoliza[polizaId] = true;
            Snackbar.Add("Poliza autorizada. La inversion queda bloqueada para edicion.", Severity.Success);
            await RefreshSelectedAndChildren();
            return;
        }

        Snackbar.Add(update?.Message ?? "No se pudo autorizar la poliza.", Severity.Error);
    }

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string Money(decimal amount) => $"{_currencySymbol}{amount.ToString("0.00", NumberCulture)}";

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                }
            }
        }
        catch
        {
        }
    }
}
