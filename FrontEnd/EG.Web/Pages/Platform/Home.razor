    private sealed record PermissionRequirement(
        string Module,
        string SubModule);

    private sealed record WorkflowStep(
        string Title,
        string Stage,
        string Description,
        string Icon,
        string Status,
        string Tone,
        string Owner,
        string Duration,
        string Document,
        string FutureRoute,
        IReadOnlyList<string>? ExpectedDocumentsSource = null)
    {
        public IReadOnlyList<string> ExpectedDocuments { get; } = ExpectedDocumentsSource ?? [Document];
    }

    private sealed record DocumentItem(
        string Title,
        string Status,
        string Detail,
        string Icon,
        string Tone);

    private sealed record TimelineItem(
        string Title,
        string Detail,
        string Tone);

