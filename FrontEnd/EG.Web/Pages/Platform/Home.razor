@page "/"
@using System.Globalization
@using System.Text
@using EG.Web.Contracts.Configuration
@implements IDisposable
@inject NavigationManager NavigationManager
@inject INavigateService NavigateService
@inject AuthService AuthService
@inject MenuStateService MenuStateService
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService

@{
    var visibleCards = FilteredCards;
    var primaryCard = visibleCards.FirstOrDefault();
    var secondaryCards = visibleCards.Skip(1).Take(2).ToList();
}

<MudContainer Class="home-page" MaxWidth="MaxWidth.False">
    <section class="home-shell">
        <header class="home-hero">
            <div class="home-hero-main">
                <div class="brand-panel">
                    <img src="img/logo_egestion_empresarial_horizontal.png" alt="EGestion Empresarial" />
                    <span>PCI</span>
                </div>

                <div class="home-title">
                    <span class="home-icon">
                        <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Medium" />
                    </span>
                    <div>
                        <span class="eyebrow">Centro operativo</span>
                        <h1>Inicio</h1>
                        <p>@EmpresaTexto - @AnioTexto</p>
                    </div>
                </div>
            </div>

            <div class="command-panel" aria-label="Resumen operativo">
                <div class="command-stat">
                    <span>Empresa</span>
                    <strong>@EmpresaTexto</strong>
                </div>
                <div class="command-stat">
                    <span>Ejercicio</span>
                    <strong>@AnioTexto</strong>
                </div>
                <div class="command-stat accent">
                    <span>Modulos</span>
                    <strong>@_moduleCards.Count.ToString("N0", CultureInfo.InvariantCulture)</strong>
                </div>
            </div>
        </header>

        <section class="home-command-grid">
            <article class="next-action-card">
                <div class="panel-kicker">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                    <span>Siguiente accion</span>
                </div>
                @if (primaryCard is not null)
                {
                    <div class="next-action-body" style="@AccentStyle(primaryCard.Accent)">
                        <span class="next-icon">
                            <MudIcon Icon="@primaryCard.Icon" Size="Size.Medium" />
                        </span>
                        <div>
                            <strong>@primaryCard.Title</strong>
                            <small>@primaryCard.Subtitle</small>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => OpenModule(primaryCard))">
                            Abrir
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="next-action-empty">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" />
                        <strong>Sin accesos disponibles</strong>
                    </div>
                }
            </article>

            <article class="signal-board">
                <div class="signal-item success">
                    <span>Contexto</span>
                    <strong>Activo</strong>
                    <small>@EmpresaTexto</small>
                </div>
                <div class="signal-item info">
                    <span>Navegacion</span>
                    <strong>@visibleCards.Count.ToString("N0", CultureInfo.InvariantCulture)</strong>
                    <small>Accesos visibles</small>
                </div>
                <div class="signal-item warning">
                    <span>Prioridad</span>
                    <strong>Workflow</strong>
                    <small>Modulo principal</small>
                </div>
            </article>

            @if (secondaryCards.Count > 0)
            {
                <article class="quick-stack">
                    @foreach (var card in secondaryCards)
                    {
                        <button type="button"
                                class="quick-card"
                                style="@AccentStyle(card.Accent)"
                                @onclick="@(() => OpenModule(card))">
                            <MudIcon Icon="@card.Icon" Size="Size.Small" />
                            <span>@card.Title</span>
                            <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" />
                        </button>
                    }
                </article>
            }
        </section>

        <section class="home-tools" aria-label="Herramientas de inicio">
            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Placeholder="Buscar modulo..."
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="module-search" />

            <MudTooltip Text="Recargar menu">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               Disabled="@_loading"
                               OnClick="ReloadMenuAsync"
                               aria-label="Recargar menu" />
            </MudTooltip>
        </section>

        @if (_loading)
        {
            <section class="home-state" role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <strong>Cargando menu</strong>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <section class="home-state" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Medium" Color="Color.Warning" />
                <strong>@_loadError</strong>
            </section>
        }
        else if (visibleCards.Count == 0)
        {
            <section class="home-state">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" Color="Color.Info" />
                <strong>Sin modulos disponibles</strong>
            </section>
        }
        else
        {
            <section class="home-module-grid" aria-label="Modulos principales">
                @foreach (var card in visibleCards)
                {
                    <button type="button"
                            class="module-tile"
                            style="@AccentStyle(card.Accent)"
                            title="@card.Route"
                            @onclick="@(() => OpenModule(card))">
                        <span class="tile-spark" aria-hidden="true"></span>
                        <span class="module-icon">
                            <MudIcon Icon="@card.Icon" Size="Size.Medium" />
                        </span>
                        <span class="module-copy">
                            <strong>@card.Title</strong>
                            <small>@card.Subtitle</small>
                        </span>
                        <span class="module-arrow" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </span>
                    </button>
                }
            </section>
        }
    </section>
</MudContainer>

@code {
    private List<HomeModuleCard> _moduleCards = new();
    private string _searchText = string.Empty;
    private string? _loadError;
    private bool _loading;

    private string EmpresaTexto =>
        FirstText(SucursalStateService.EmpresaNombreCorto, SucursalStateService.EmpresaNombre, "Sin empresa");

    private string AnioTexto =>
        string.IsNullOrWhiteSpace(AnioStateService.AnioTexto)
            ? "Sin anio"
            : AnioStateService.AnioTexto;

    private IReadOnlyList<HomeModuleCard> FilteredCards
    {
        get
        {
            var term = NormalizeText(_searchText);
            var cards = string.IsNullOrWhiteSpace(term)
                ? _moduleCards
                : _moduleCards
                    .Where(card => NormalizeText($"{card.Title} {card.Subtitle}").Contains(term, StringComparison.Ordinal))
                    .ToList();

            return cards
                .OrderBy(card => card.Order)
                .ThenBy(card => card.Title)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SucursalStateService.OnSucursalChanged += OnSucursalChanged;
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        AnioStateService.OnAnioChanged += OnAnioChanged;

        await LoadContextAsync();
        await LoadMenuAsync();
    }

    private async Task LoadContextAsync()
    {
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();
    }

    private async Task LoadMenuAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var userId = await AuthService.GetUserIdAsync();
            if (userId <= 0)
            {
                _moduleCards = new();
                _loadError = "Sesion no disponible.";
                return;
            }

            if (!MenuStateService.TryGetItems(userId, out var menuItems))
            {
                var result = await NavigateService.GetMenuAsync(userId);
                menuItems = NormalizeMenuItems(result?.Items);
                MenuStateService.Initialize(userId, menuItems);
            }

            _moduleCards = BuildModuleCards(menuItems).ToList();
        }
        catch
        {
            _moduleCards = new();
            _loadError = "No se pudo cargar el menu.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadMenuAsync()
    {
        if (_loading)
            return;

        MenuStateService.Clear();
        await LoadMenuAsync();
    }

    private void OpenModule(HomeModuleCard card)
    {
        if (!string.IsNullOrWhiteSpace(card.Route))
        {
            NavigationManager.NavigateTo(card.Route);
        }
    }

    private IEnumerable<HomeModuleCard> BuildModuleCards(IEnumerable<MenuItem>? items)
    {
        foreach (var item in (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre))
        {
            var route = GetLandingRoute(item);
            if (string.IsNullOrWhiteSpace(route))
                continue;

            var moduleKey = ResolveModuleKey(item);
            var style = GetModuleStyle(moduleKey, item);
            var optionCount = CountNavigableItems(item);

            yield return new HomeModuleCard(
                Title: item.Nombre,
                Subtitle: FormatOptionCount(optionCount),
                Route: route,
                Icon: style.Icon,
                Accent: style.Accent,
                Order: item.Orden ?? int.MaxValue);
        }
    }

    private static List<MenuItem> NormalizeMenuItems(IEnumerable<MenuItem>? items)
    {
        return (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre)
            .Select(item =>
            {
                item.Children = NormalizeMenuItems(item.Children);
                return item;
            })
            .ToList();
    }

    private static string? GetLandingRoute(MenuItem item)
    {
        var dashboardRoute = GetDashboardRoute(item);
        if (!string.IsNullOrWhiteSpace(dashboardRoute))
            return dashboardRoute;

        if (IsNavigableRoute(item.Ruta))
            return item.Ruta;

        return FindFirstNavigableRoute(item.Children);
    }

    private static string? FindFirstNavigableRoute(IEnumerable<MenuItem>? items)
    {
        foreach (var item in (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre))
        {
            if (IsNavigableRoute(item.Ruta))
                return item.Ruta;

            var childRoute = FindFirstNavigableRoute(item.Children);
            if (!string.IsNullOrWhiteSpace(childRoute))
                return childRoute;
        }

        return null;
    }

    private static int CountNavigableItems(MenuItem item) =>
        Flatten(item).Count(menuItem => IsNavigableRoute(menuItem.Ruta));

    private static IEnumerable<MenuItem> Flatten(MenuItem item)
    {
        yield return item;

        foreach (var child in item.Children ?? Enumerable.Empty<MenuItem>())
        {
            foreach (var nested in Flatten(child))
            {
                yield return nested;
            }
        }
    }

    private static bool IsNavigableRoute(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return false;

        var value = route.Trim();
        return value != "/" && value != "#" && !value.Equals("javascript:void(0)", StringComparison.OrdinalIgnoreCase);
    }

    private static string? GetDashboardRoute(MenuItem item)
    {
        var key = NormalizeText($"{item.Nombre} {item.LegacyName} {item.Ruta}");

        if (key.Contains("tesoreria", StringComparison.Ordinal))
            return "/Tesoreria/Dashboard";

        if (key.Contains("reportes cxc", StringComparison.Ordinal) ||
            key.Contains("cuentasxcobrar", StringComparison.Ordinal) ||
            key.Contains("cuentas por cobrar", StringComparison.Ordinal))
            return "/ReportesCxC/Dashboard";

        if (key.Contains("contabilidad", StringComparison.Ordinal))
            return "/Contabilidad/Dashboard";

        if (key.Contains("adquisicion", StringComparison.Ordinal))
            return "/Adquisiciones/Dashboard";

        if (key.Contains("patrimonio", StringComparison.Ordinal))
            return "/Patrimonio/Dashboard";

        if (key.Contains("almacen", StringComparison.Ordinal))
            return "/Almacen/Dashboard";

        if (key.Contains("presupuesto", StringComparison.Ordinal))
            return "/Presupuesto/Dashboard";

        if (key.Contains("nomina", StringComparison.Ordinal))
            return "/Nomina/Dashboard";

        if (key == "pbr" || key.Contains(" pbr", StringComparison.Ordinal))
            return "/PBR/Dashboard";

        if (key.Contains("configuracion", StringComparison.Ordinal))
            return "/Configuracion/Dashboard";

        return null;
    }

    private static string ResolveModuleKey(MenuItem item)
    {
        var key = NormalizeText($"{item.Nombre} {item.LegacyName} {item.Ruta}");

        if (key.Contains("configuracion", StringComparison.Ordinal)) return "configuracion";
        if (key.Contains("tesoreria", StringComparison.Ordinal)) return "tesoreria";
        if (key.Contains("reportes cxc", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("cuentasxcobrar", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("cuentas por cobrar", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("presupuesto", StringComparison.Ordinal)) return "presupuesto";
        if (key.Contains("contabilidad", StringComparison.Ordinal)) return "contabilidad";
        if (key.Contains("adquisicion", StringComparison.Ordinal)) return "adquisiciones";
        if (key.Contains("patrimonio", StringComparison.Ordinal)) return "patrimonio";
        if (key.Contains("almacen", StringComparison.Ordinal)) return "almacen";
        if (key.Contains("nomina", StringComparison.Ordinal)) return "nomina";
        if (key == "pbr" || key.Contains(" pbr", StringComparison.Ordinal)) return "pbr";
        if (key.Contains("ayuda", StringComparison.Ordinal)) return "ayuda";

        return "default";
    }

    private static ModuleStyle GetModuleStyle(string moduleKey, MenuItem item)
    {
        if (ModuleStyles.TryGetValue(moduleKey, out var style))
            return style;

        return new ModuleStyle("#667085", IconosDisponibles.GetMaterialIcon(item.ImageUrl));
    }

    private static string FormatOptionCount(int count) =>
        count == 1 ? "1 opcion" : $"{count} opciones";

    private static string AccentStyle(string accent) =>
        $"--module-accent:{accent};";

    private static string FirstText(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static string NormalizeText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var normalized = text.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(char.ToLowerInvariant(c));
            }
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private void OnSucursalChanged(int sucursalId, string sucursalNombre) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnEmpresaChanged(int empresaId) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAnioChanged(int? anioId) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SucursalStateService.OnSucursalChanged -= OnSucursalChanged;
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }

    private static readonly IReadOnlyDictionary<string, ModuleStyle> ModuleStyles =
        new Dictionary<string, ModuleStyle>(StringComparer.OrdinalIgnoreCase)
        {
            ["configuracion"] = new("#667085", Icons.Material.Filled.Settings),
            ["presupuesto"] = new("#2F5F9F", Icons.Material.Filled.AccountBalance),
            ["contabilidad"] = new("#2F7D68", Icons.Material.Filled.ReceiptLong),
            ["adquisiciones"] = new("#6B5A9A", Icons.Material.Filled.ShoppingCartCheckout),
            ["patrimonio"] = new("#9A6A2E", Icons.Material.Filled.Inventory2),
            ["almacen"] = new("#34776B", Icons.Material.Filled.Warehouse),
            ["tesoreria"] = new("#347C9F", Icons.Material.Filled.Payments),
            ["nomina"] = new("#7A5A9E", Icons.Material.Filled.Groups),
            ["reportescxc"] = new("#3A7999", Icons.Material.Filled.RequestQuote),
            ["pbr"] = new("#5966A8", Icons.Material.Filled.DashboardCustomize),
            ["ayuda"] = new("#667085", Icons.Material.Filled.Help)
        };

    private sealed record HomeModuleCard(
        string Title,
        string Subtitle,
        string Route,
        string Icon,
        string Accent,
        int Order);

    private sealed record ModuleStyle(string Accent, string Icon);
}

<style>
    .home-page {
        height: 100%;
        min-height: 0;
        overflow: auto;
        padding: 22px 26px 30px !important;
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--mud-palette-primary) 3%, transparent) 1px, transparent 1px),
            linear-gradient(0deg, color-mix(in srgb, var(--eg-support-accent) 2%, transparent) 1px, transparent 1px),
            var(--mud-palette-background);
        background-size: 48px 48px;
    }

    .home-shell {
        min-height: 100%;
        display: grid;
        align-content: start;
        gap: 16px;
    }

    .home-hero,
    .home-command-grid > article,
    .home-tools,
    .module-tile,
    .home-state {
        border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 82%, transparent);
        border-radius: 8px;
        background: var(--mud-palette-surface);
        box-shadow: 0 18px 44px color-mix(in srgb, var(--eg-shell-shadow, rgba(2, 8, 23, .14)) 72%, transparent);
    }

    .home-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(360px, 520px);
        gap: 18px;
        align-items: stretch;
        overflow: hidden;
        padding: 20px;
        border-left: 4px solid var(--eg-primary);
        isolation: isolate;
    }

    .home-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(120deg, color-mix(in srgb, var(--eg-primary) 8%, transparent), transparent 40%),
            linear-gradient(285deg, color-mix(in srgb, var(--eg-support-accent) 5%, transparent), transparent 48%),
            linear-gradient(180deg, color-mix(in srgb, var(--eg-warm-accent) 4%, transparent), transparent 58%);
        opacity: 1;
    }

    .home-hero-main {
        min-width: 0;
        display: grid;
        gap: 20px;
        align-content: space-between;
    }

    .brand-panel {
        width: fit-content;
        max-width: 100%;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 11px;
        border: 1px solid color-mix(in srgb, var(--eg-primary) 22%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 86%, transparent);
        box-shadow: inset 0 1px 0 color-mix(in srgb, var(--mud-palette-white) 72%, transparent);
    }

    .brand-panel img {
        width: min(210px, 54vw);
        max-height: 28px;
        object-fit: contain;
    }

    .brand-panel span {
        color: var(--mud-palette-primary);
        font-size: .78rem;
        font-weight: 900;
    }

    .home-title {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .home-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 30%, var(--mud-palette-lines-default));
        border-radius: 8px;
        color: var(--mud-palette-primary);
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--mud-palette-primary) 18%, transparent), color-mix(in srgb, var(--eg-support-accent) 10%, transparent)),
            var(--mud-palette-surface);
    }

    .eyebrow {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .74rem;
        font-weight: 850;
        line-height: 1;
        text-transform: uppercase;
    }

    .home-title h1 {
        margin: 3px 0 0;
        color: var(--mud-palette-text-primary);
        font-size: clamp(2.05rem, 3vw, 3rem);
        font-weight: 900;
        line-height: 1.02;
        letter-spacing: 0;
    }

    .home-title p {
        margin: 4px 0 0;
        color: var(--mud-palette-text-secondary);
        font-size: .92rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .command-panel {
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .command-stat {
        min-width: 0;
        min-height: 108px;
        display: grid;
        align-content: center;
        gap: 8px;
        padding: 14px;
        border: 1px solid color-mix(in srgb, var(--eg-primary) 18%, var(--mud-palette-lines-default));
        border-radius: 8px;
        color: var(--mud-palette-text-primary);
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--eg-primary) 4%, transparent), transparent),
            color-mix(in srgb, var(--mud-palette-surface) 82%, transparent);
    }

    .command-stat.accent {
        border-color: color-mix(in srgb, var(--eg-warm-accent) 24%, var(--mud-palette-lines-default));
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--eg-warm-accent) 7%, transparent), transparent),
            color-mix(in srgb, var(--mud-palette-surface) 84%, transparent);
    }

    .command-stat span,
    .signal-item span,
    .panel-kicker span {
        color: var(--mud-palette-text-secondary);
        font-size: .72rem;
        font-weight: 850;
        line-height: 1;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .command-stat strong {
        min-width: 0;
        color: var(--mud-palette-text-primary);
        font-size: 1.08rem;
        font-weight: 900;
        line-height: 1.2;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
    }

    .home-command-grid {
        display: grid;
        grid-template-columns: minmax(420px, 1.18fr) minmax(360px, .9fr) minmax(260px, .58fr);
        gap: 12px;
        align-items: stretch;
    }

    .next-action-card,
    .signal-board,
    .quick-stack {
        min-width: 0;
        padding: 13px;
    }

    .next-action-card {
        display: grid;
        gap: 12px;
    }

    .panel-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--mud-palette-primary);
    }

    .next-action-body {
        min-width: 0;
        display: grid;
        grid-template-columns: 56px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 14px;
        border: 1px solid color-mix(in srgb, var(--module-accent) 24%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background:
            linear-gradient(120deg, color-mix(in srgb, var(--module-accent) 8%, transparent), transparent 62%),
            var(--mud-palette-surface);
    }

    .next-icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: var(--module-accent);
        background: color-mix(in srgb, var(--module-accent) 10%, transparent);
    }

    .next-action-body strong {
        display: block;
        min-width: 0;
