@page "/"
@using System.Globalization
@using System.Text
@using EG.Web.Contracts.Configuration
@implements IDisposable
@inject NavigationManager NavigationManager
@inject INavigateService NavigateService
@inject AuthService AuthService
@inject MenuStateService MenuStateService
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService

@{
    var visibleCards = FilteredCards;
    var primaryCard = visibleCards.FirstOrDefault();
}

<MudContainer Class="home-page" MaxWidth="MaxWidth.False">
    <section class="home-shell">
        <header class="home-hero">
            <div class="hero-decoration hero-decoration-one" aria-hidden="true"></div>
            <div class="hero-decoration hero-decoration-two" aria-hidden="true"></div>

            <div class="hero-content">
                <div class="brand-lockup">
                    <img src="img/logo_egestion_empresarial_horizontal.png" alt="EGestion Empresarial" />
                    <span aria-hidden="true"></span>
                    <strong>PCI</strong>
                </div>

                <div class="hero-copy">
                    <span class="eyebrow">Centro de operaciones</span>
                    <h1>Todo tu trabajo,<br /><em>en un solo lugar.</em></h1>
                    <p>Consulta tus módulos y continúa con las tareas de @EmpresaTexto sin perder el contexto.</p>

                    <div class="context-list" aria-label="Contexto de trabajo">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                            @EmpresaTexto
                        </span>
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                            Ejercicio @AnioTexto
                        </span>
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" />
                            @_moduleCards.Count.ToString("N0", CultureInfo.InvariantCulture) módulos
                        </span>
                    </div>
                </div>
            </div>

            @if (primaryCard is not null)
            {
                <aside class="featured-access" style="@AccentStyle(primaryCard.Accent)">
                    <div class="featured-label">
                        <span>Acceso destacado</span>
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" />
                    </div>
                    <span class="featured-icon">
                        <MudIcon Icon="@primaryCard.Icon" Size="Size.Large" />
                    </span>
                    <div class="featured-copy">
                        <strong>@primaryCard.Title</strong>
                        <small>@primaryCard.Subtitle disponibles</small>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               FullWidth="true"
                               OnClick="@(() => OpenModule(primaryCard))">
                        Entrar al módulo
                    </MudButton>
                </aside>
            }
        </header>

        <section class="module-directory" aria-labelledby="modules-title">
            <div class="directory-header">
                <div class="directory-title">
                    <span class="directory-icon">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                    </span>
                    <div>
                        <h2 id="modules-title">Módulos de trabajo</h2>
                        <p>@visibleCards.Count.ToString("N0", CultureInfo.InvariantCulture) accesos disponibles para tu perfil</p>
                    </div>
                </div>

                <div class="directory-tools" aria-label="Herramientas de módulos">
                    <MudTextField T="string"
                                  @bind-Value="_searchText"
                                  Placeholder="Buscar un módulo"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="module-search" />

                    <MudTooltip Text="Actualizar módulos">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Disabled="@_loading"
                                       OnClick="ReloadMenuAsync"
                                       aria-label="Actualizar módulos" />
                    </MudTooltip>
                </div>
            </div>

            @if (_loading)
            {
                <div class="home-state" role="status">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    <strong>Cargando módulos</strong>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="home-state" role="alert">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Medium" Color="Color.Warning" />
                    <strong>@_loadError</strong>
                </div>
            }
            else if (visibleCards.Count == 0)
            {
                <div class="home-state">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" Color="Color.Info" />
                    <strong>No encontramos módulos con ese nombre</strong>
                    <small>Prueba con otra palabra.</small>
                </div>
            }
            else
            {
                <div class="home-module-grid" aria-label="Módulos principales">
                    @foreach (var card in visibleCards)
                    {
                        <button type="button"
                                class="module-tile"
                                style="@AccentStyle(card.Accent)"
                                title="Abrir @card.Title"
                                @onclick="@(() => OpenModule(card))">
                            <span class="module-icon">
                                <MudIcon Icon="@card.Icon" Size="Size.Medium" />
                            </span>
                            <span class="module-copy">
                                <strong>@card.Title</strong>
                                <small>@card.Subtitle</small>
                            </span>
                            <span class="module-arrow" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </span>
                        </button>
                    }
                </div>
            }
        </section>
    </section>
</MudContainer>

@code {
    private List<HomeModuleCard> _moduleCards = new();
    private string _searchText = string.Empty;
    private string? _loadError;
    private bool _loading;

    private string EmpresaTexto =>
        FirstText(SucursalStateService.EmpresaNombreCorto, SucursalStateService.EmpresaNombre, "Sin entidad");

    private string AnioTexto =>
        string.IsNullOrWhiteSpace(AnioStateService.AnioTexto)
            ? "Sin anio"
            : AnioStateService.AnioTexto;

    private IReadOnlyList<HomeModuleCard> FilteredCards
    {
        get
        {
            var term = NormalizeText(_searchText);
            var cards = string.IsNullOrWhiteSpace(term)
                ? _moduleCards
                : _moduleCards
                    .Where(card => NormalizeText($"{card.Title} {card.Subtitle}").Contains(term, StringComparison.Ordinal))
                    .ToList();

            return cards
                .OrderBy(card => card.Order)
                .ThenBy(card => card.Title)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SucursalStateService.OnSucursalChanged += OnSucursalChanged;
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        AnioStateService.OnAnioChanged += OnAnioChanged;

        await LoadContextAsync();
        await LoadMenuAsync();
    }

    private async Task LoadContextAsync()
    {
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();
    }

    private async Task LoadMenuAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var userId = await AuthService.GetUserIdAsync();
            if (userId <= 0)
            {
                _moduleCards = new();
                _loadError = "Sesion no disponible.";
                return;
            }

            if (!MenuStateService.TryGetItems(userId, out var menuItems))
            {
                var result = await NavigateService.GetMenuAsync(userId);
                menuItems = NormalizeMenuItems(result?.Items);
                MenuStateService.Initialize(userId, menuItems);
            }

            _moduleCards = BuildModuleCards(menuItems).ToList();
        }
        catch
        {
            _moduleCards = new();
            _loadError = "No se pudo cargar el menu.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadMenuAsync()
    {
        if (_loading)
            return;

        MenuStateService.Clear();
        await LoadMenuAsync();
    }

    private void OpenModule(HomeModuleCard card)
    {
        if (!string.IsNullOrWhiteSpace(card.Route))
        {
            NavigationManager.NavigateTo(card.Route);
        }
    }

    private IEnumerable<HomeModuleCard> BuildModuleCards(IEnumerable<MenuItem>? items)
    {
        foreach (var item in (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre))
        {
            var route = GetLandingRoute(item);
            if (string.IsNullOrWhiteSpace(route))
                continue;

            var moduleKey = ResolveModuleKey(item);
            var style = GetModuleStyle(moduleKey, item);
            var optionCount = CountNavigableItems(item);

            yield return new HomeModuleCard(
                Title: item.Nombre,
                Subtitle: FormatOptionCount(optionCount),
                Route: route,
                Icon: style.Icon,
                Accent: style.Accent,
                Order: item.Orden ?? int.MaxValue);
        }
    }

    private static List<MenuItem> NormalizeMenuItems(IEnumerable<MenuItem>? items)
    {
        return (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre)
            .Select(item =>
            {
                item.Children = NormalizeMenuItems(item.Children);
                return item;
            })
            .ToList();
    }

    private static string? GetLandingRoute(MenuItem item)
    {
        var dashboardRoute = GetDashboardRoute(item);
        if (!string.IsNullOrWhiteSpace(dashboardRoute))
            return dashboardRoute;

        if (IsNavigableRoute(item.Ruta))
            return item.Ruta;

        return FindFirstNavigableRoute(item.Children);
    }

    private static string? FindFirstNavigableRoute(IEnumerable<MenuItem>? items)
    {
        foreach (var item in (items ?? Enumerable.Empty<MenuItem>())
            .Where(item => item.Activo)
            .OrderBy(item => item.Orden ?? int.MaxValue)
            .ThenBy(item => item.Nombre))
        {
            if (IsNavigableRoute(item.Ruta))
                return item.Ruta;

            var childRoute = FindFirstNavigableRoute(item.Children);
            if (!string.IsNullOrWhiteSpace(childRoute))
                return childRoute;
        }

        return null;
    }

    private static int CountNavigableItems(MenuItem item) =>
        Flatten(item).Count(menuItem => IsNavigableRoute(menuItem.Ruta));

    private static IEnumerable<MenuItem> Flatten(MenuItem item)
    {
        yield return item;

        foreach (var child in item.Children ?? Enumerable.Empty<MenuItem>())
        {
            foreach (var nested in Flatten(child))
            {
                yield return nested;
            }
        }
    }

    private static bool IsNavigableRoute(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
            return false;

        var value = route.Trim();
        return value != "/" && value != "#" && !value.Equals("javascript:void(0)", StringComparison.OrdinalIgnoreCase);
    }

    private static string? GetDashboardRoute(MenuItem item)
    {
        var key = NormalizeText($"{item.Nombre} {item.LegacyName} {item.Ruta}");

        if (key.Contains("tesoreria", StringComparison.Ordinal))
            return "/Tesoreria/Dashboard";

        if (key.Contains("reportes cxc", StringComparison.Ordinal) ||
            key.Contains("cuentasxcobrar", StringComparison.Ordinal) ||
            key.Contains("cuentas por cobrar", StringComparison.Ordinal))
            return "/ReportesCxC/Dashboard";

        if (key.Contains("contabilidad", StringComparison.Ordinal))
            return "/Contabilidad/Dashboard";

        if (key.Contains("adquisicion", StringComparison.Ordinal))
            return "/Adquisiciones/Dashboard";

        if (key.Contains("patrimonio", StringComparison.Ordinal))
            return "/Patrimonio/Dashboard";

        if (key.Contains("almacen", StringComparison.Ordinal))
            return "/Almacen/Dashboard";

        if (key.Contains("presupuesto", StringComparison.Ordinal))
            return "/Presupuesto/Dashboard";

        if (key.Contains("nomina", StringComparison.Ordinal))
            return "/Nomina/Dashboard";

        if (key == "pbr" || key.Contains(" pbr", StringComparison.Ordinal))
            return "/PBR/Dashboard";

        if (key.Contains("configuracion", StringComparison.Ordinal))
            return "/Configuracion/Dashboard";

        return null;
    }

    private static string ResolveModuleKey(MenuItem item)
    {
        var key = NormalizeText($"{item.Nombre} {item.LegacyName} {item.Ruta}");

        if (key.Contains("configuracion", StringComparison.Ordinal)) return "configuracion";
        if (key.Contains("tesoreria", StringComparison.Ordinal)) return "tesoreria";
        if (key.Contains("reportes cxc", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("cuentasxcobrar", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("cuentas por cobrar", StringComparison.Ordinal)) return "reportescxc";
        if (key.Contains("presupuesto", StringComparison.Ordinal)) return "presupuesto";
        if (key.Contains("contabilidad", StringComparison.Ordinal)) return "contabilidad";
        if (key.Contains("adquisicion", StringComparison.Ordinal)) return "adquisiciones";
        if (key.Contains("patrimonio", StringComparison.Ordinal)) return "patrimonio";
        if (key.Contains("almacen", StringComparison.Ordinal)) return "almacen";
        if (key.Contains("nomina", StringComparison.Ordinal)) return "nomina";
        if (key == "pbr" || key.Contains(" pbr", StringComparison.Ordinal)) return "pbr";
        if (key.Contains("ayuda", StringComparison.Ordinal)) return "ayuda";

        return "default";
    }

    private static ModuleStyle GetModuleStyle(string moduleKey, MenuItem item)
    {
        if (ModuleStyles.TryGetValue(moduleKey, out var style))
            return style;

        return new ModuleStyle("#667085", IconosDisponibles.GetMaterialIcon(item.ImageUrl));
    }

    private static string FormatOptionCount(int count) =>
        count == 1 ? "1 opcion" : $"{count} opciones";

    private static string AccentStyle(string accent) =>
        $"--module-accent:{accent};";

    private static string FirstText(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private static string NormalizeText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var normalized = text.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(char.ToLowerInvariant(c));
            }
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private void OnSucursalChanged(int sucursalId, string sucursalNombre) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnEmpresaChanged(int empresaId) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAnioChanged(int? anioId) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SucursalStateService.OnSucursalChanged -= OnSucursalChanged;
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }

    private static readonly IReadOnlyDictionary<string, ModuleStyle> ModuleStyles =
        new Dictionary<string, ModuleStyle>(StringComparer.OrdinalIgnoreCase)
        {
            ["configuracion"] = new("#5F6B7A", Icons.Material.Filled.Settings),
            ["presupuesto"] = new("#235A8F", Icons.Material.Filled.AccountBalance),
            ["contabilidad"] = new("#2C7468", Icons.Material.Filled.ReceiptLong),
            ["adquisiciones"] = new("#65578F", Icons.Material.Filled.ShoppingCartCheckout),
            ["patrimonio"] = new("#86652D", Icons.Material.Filled.Inventory2),
            ["almacen"] = new("#327163", Icons.Material.Filled.Warehouse),
            ["tesoreria"] = new("#2D728F", Icons.Material.Filled.Payments),
            ["nomina"] = new("#71558F", Icons.Material.Filled.Groups),
            ["reportescxc"] = new("#34728D", Icons.Material.Filled.RequestQuote),
            ["pbr"] = new("#53619A", Icons.Material.Filled.DashboardCustomize),
            ["ayuda"] = new("#667085", Icons.Material.Filled.Help)
        };

    private sealed record HomeModuleCard(
        string Title,
        string Subtitle,
        string Route,
        string Icon,
        string Accent,
        int Order);

    private sealed record ModuleStyle(string Accent, string Icon);
}

<style media="not all">
