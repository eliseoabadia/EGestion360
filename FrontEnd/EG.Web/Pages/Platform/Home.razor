@page "/"
@inject NavigationManager NavigationManager
@inject AuthenticationProviderJWT AuthProvider

<MudContainer Class="workflow-home" MaxWidth="MaxWidth.False">
    <section class="workflow-shell">
        <header class="workflow-header">
            <div class="workflow-heading">
                <div class="workflow-kicker">
                    <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" />
                    <span>Sala de control</span>
                </div>
                <h1>Centro de mando</h1>
                <p>Workflow ejecutivo del recurso: solicitud, compra, suficiencia, factura y pago.</p>
            </div>

            <div class="header-actions">
                <span class="workflow-mode">
                    <span class="mode-dot"></span>
                    <span>Sin cargas</span>
                </span>
                <button type="button" class="next-action" aria-label="@($"Siguiente accion: {SelectedWorkflow.NextAction}")" disabled="@(!HasVisibleWorkflows)" @onclick="OpenSelectedWorkflow">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesomeMotion" Size="Size.Small" />
                    <span>Siguiente accion</span>
                    <strong>@SelectedWorkflow.NextAction</strong>
                </button>
            </div>
        </header>

        <section class="compliance-band" aria-label="Alineacion CONAC LGCG">
            <div class="compliance-copy">
                <span class="compliance-kicker">
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" />
                    CONAC / LGCG
                </span>
                <strong>Alineado a momentos contables: comprometido, devengado, ejercido, pagado</strong>
                <p>Diseñado para conectar presupuesto, contabilidad y evidencia operativa con informacion ejecutiva en tiempo real.</p>
            </div>
            <a class="compliance-link" href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LGCG.pdf" target="_blank" rel="noopener noreferrer">
                Ver LGCG
            </a>
        </section>

        @if (!permissionsReady)
        {
            <section class="access-state" aria-label="Validando permisos">
                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Medium" />
                <div>
                    <strong>Validando claims del usuario</strong>
                    <span>El centro de mando solo mostrara workflows con permiso de vista o menu.</span>
                </div>
            </section>
        }
        else if (!HasVisibleWorkflows)
        {
            <section class="access-state" aria-label="Sin workflows disponibles">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Medium" />
                <div>
                    <strong>Sin workflows principales disponibles</strong>
                    <span>Este usuario no trae claims para Presupuesto, Adquisiciones o Cuentas por Pagar.</span>
                </div>
            </section>
        }
        else
        {
        <section class="overview-panel" aria-label="Resumen ejecutivo">
            <div class="executive-strip" aria-label="Indicadores ejecutivos">
                @foreach (var metric in ExecutiveMetrics)
                {
                    <article class="metric-card" style="@AccentStyle(metric.Accent)">
                        <span class="metric-icon">
                            <MudIcon Icon="@metric.Icon" Size="Size.Small" />
                        </span>
                        <div>
                            <span>@metric.Label</span>
                            <strong>@metric.Value</strong>
                            <small>@metric.Detail</small>
                        </div>
                    </article>
                }
            </div>

            <div class="bottleneck-summary" aria-label="Donde se esta atorando la operacion">
                <div class="panel-title">
                    <MudIcon Icon="@Icons.Material.Filled.Troubleshoot" Size="Size.Small" />
                    <span>Cuellos de botella</span>
                </div>
                <div class="bottleneck-strip">
                    @foreach (var item in BottleneckSnapshots)
                    {
                        <article class="snapshot-card" style="@ToneStyle(item.Tone)">
                            <span class="status-dot"></span>
                            <div>
                                <strong>@item.Count</strong>
                                <span>@item.Label</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <div class="workflow-layout">
            <aside class="workflow-selector" aria-label="Workflows disponibles">
                <div class="selector-heading">
                    <span>Workflows</span>
                    <strong>@VisibleWorkflows.Count</strong>
                </div>

                @foreach (var workflow in VisibleWorkflows)
                {
                    <article class="@WorkflowCardClass(workflow)" style="@($"{AccentStyle(workflow.Accent)} {ToneStyle(workflow.HealthTone)}")">
                        <button type="button"
                                class="workflow-select"
                                aria-pressed="@(workflow.Id == selectedWorkflowId)"
                                @onclick="@(() => SelectWorkflow(workflow.Id))">
                            <span class="workflow-icon">
                                <MudIcon Icon="@workflow.Icon" Size="Size.Small" />
                            </span>
                            <span class="workflow-copy">
                                <strong>@workflow.Title</strong>
                                <small>@workflow.Subtitle</small>
                                <span class="workflow-card-kpis">
                                    <strong>@workflow.ActiveProcesses</strong> activos
                                    <span aria-hidden="true">/</span>
                                    <strong>@workflow.BlockedProcesses</strong> atorados
                                    <span aria-hidden="true">/</span>
                                    <strong>@workflow.AverageDays</strong> dias
                                </span>
                            </span>
                            <span class="status-chip">
                                <span></span>
                                @workflow.Health
                            </span>
                        </button>
                        <button type="button"
                                class="workflow-open"
                                title="@($"Abrir {workflow.Title}")"
                                aria-label="@($"Abrir {workflow.Title}")"
                                @onclick="@(() => OpenWorkflow(workflow))">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                        </button>
                    </article>
                }

                <section class="semaphore-card" aria-label="Semaforo por workflow">
                    <div class="panel-title">
                        <MudIcon Icon="@Icons.Material.Filled.Traffic" Size="Size.Small" />
                        <span>Semaforo por workflow</span>
                    </div>
                    <div class="semaphore-list">
                        <span class="semaphore-item" style="@ToneStyle("success")"><span class="status-dot"></span>Verde: normal</span>
                        <span class="semaphore-item" style="@ToneStyle("warning")"><span class="status-dot"></span>Amarillo: requiere autorizacion</span>
                        <span class="semaphore-item" style="@ToneStyle("error")"><span class="status-dot"></span>Rojo: detenido por soporte</span>
                    </div>
                </section>
            </aside>

            <section class="workflow-detail" style="@AccentStyle(SelectedWorkflow.Accent)">
                <div class="detail-header">
                    <div class="detail-title">
                        <span class="detail-icon">
                            <MudIcon Icon="@SelectedWorkflow.Icon" Size="Size.Medium" />
                        </span>
                        <div>
                            <span>@SelectedWorkflow.Owner</span>
                            <h2>@SelectedWorkflow.Title</h2>
                        </div>
                    </div>

                    <div class="detail-actions">
                        <div class="detail-badges">
                            <span>@SelectedWorkflow.Signal</span>
                            <span>@SelectedWorkflow.Outcome</span>
                            <span>@SelectedWorkflow.BudgetSignal</span>
                        </div>
                        <button type="button" class="module-link" @onclick="OpenSelectedWorkflow" title="@SelectedWorkflow.Route">
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                            Abrir modulo
                        </button>
                    </div>
                </div>

                <div class="detail-health" style="@ToneStyle(SelectedWorkflow.HealthTone)">
                    <span class="status-dot"></span>
                    <div>
                        <strong>@SelectedWorkflow.Health</strong>
                        <small>@SelectedWorkflow.HealthReason</small>
                    </div>
                </div>

                <div class="workflow-insight">
                    <div>
                        <span class="insight-label">Entrada</span>
                        <strong>@SelectedWorkflow.EntryPoint</strong>
                    </div>
                    <div>
                        <span class="insight-label">Control</span>
                        <strong>@SelectedWorkflow.ControlPoint</strong>
                    </div>
                    <div>
                        <span class="insight-label">Salida</span>
                        <strong>@SelectedWorkflow.ExitPoint</strong>
                    </div>
                </div>

                <div class="action-row">
                    <button type="button" class="primary-action" @onclick="OpenSelectedWorkflow">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                        <span>Siguiente accion</span>
                        <strong>@SelectedWorkflow.NextAction</strong>
                    </button>
                    <div class="action-context">
                        <span>Regla de avance</span>
                        <strong>@SelectedWorkflow.AssistantRule</strong>
                    </div>
                </div>

                <div class="flow-lane" aria-label="@($"Flujo {SelectedWorkflow.Title}")">
                    @for (var i = 0; i < SelectedWorkflow.Steps.Count; i++)
                    {
                        var step = SelectedWorkflow.Steps[i];
                        var stepNumber = i + 1;

                        <article class="flow-node" style="@ToneStyle(step.Tone)">
                            <div class="node-index">@stepNumber.ToString("00")</div>
                            <div class="node-panel">
                                <div class="node-status">
                                    <span class="status-chip">
                                        <span></span>
                                        @step.Status
                                    </span>
                                </div>
                                <div class="node-title">
                                    <MudIcon Icon="@step.Icon" Size="Size.Small" />
                                    <strong>@step.Title</strong>
                                </div>
                                <p>@step.Description</p>
                                <div class="node-meta">
                                    <div>
                                        <span>Responsable</span>
                                        <strong>@step.Owner</strong>
                                    </div>
                                    <div>
                                        <span>Tiempo</span>
                                        <strong>@step.Duration</strong>
                                    </div>
                                    <div>
                                        <span>Documento</span>
                                        <strong>@step.Document</strong>
                                    </div>
                                </div>
                                <div class="expected-docs" aria-label="Documentos esperados">
                                    @foreach (var expectedDocument in step.ExpectedDocuments)
                                    {
                                        <span>@expectedDocument</span>
                                    }
                                </div>
                                <div class="node-footer">
                                    <span>@step.Stage</span>
                                    @if (CanViewRoute(step.FutureRoute))
                                    {
                                        <button type="button" class="node-link" title="@step.FutureRoute" @onclick="@(() => OpenStep(step))">
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" />
                                            Abrir
                                        </button>
                                    }
                                </div>
                            </div>
                        </article>

                        @if (i < SelectedWorkflow.Steps.Count - 1)
                        {
                            <div class="flow-connector" aria-hidden="true">
                                <span></span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </div>
                        }
                    }
                </div>

                <section class="operations-grid" aria-label="Control del workflow seleccionado">
                    <article class="control-panel">
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Troubleshoot" Size="Size.Small" />
                            <span>Cuellos de botella</span>
                        </div>
                        <div class="bottleneck-list">
                            @foreach (var item in SelectedWorkflow.Bottlenecks)
                            {
                                <div class="bottleneck-item" style="@ToneStyle(item.Tone)">
                                    <span class="status-dot"></span>
                                    <div>
                                        <strong>@item.Title</strong>
                                        <small>@item.Detail</small>
                                    </div>
                                    <em>@item.Count</em>
                                </div>
                            }
                        </div>
                    </article>

                    <article class="control-panel">
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.FolderCopy" Size="Size.Small" />
                            <span>Expediente digital</span>
                        </div>
                        <div class="document-list">
                            @foreach (var document in SelectedWorkflow.Documents)
                            {
                                <div class="document-item" style="@ToneStyle(document.Tone)">
                                    <MudIcon Icon="@document.Icon" Size="Size.Small" />
                                    <div>
                                        <strong>@document.Title</strong>
                                        <small>@document.Detail</small>
                                    </div>
                                    <span>@document.Status</span>
                                </div>
                            }
                        </div>
                    </article>

                    <article class="control-panel">
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" />
                            <span>Timeline de auditoria</span>
                        </div>
                        <div class="timeline">
                            @foreach (var eventItem in SelectedWorkflow.Timeline)
                            {
                                <div class="timeline-item" style="@ToneStyle(eventItem.Tone)">
                                    <span class="status-dot"></span>
                                    <div>
                                        <strong>@eventItem.Title</strong>
                                        <small>@eventItem.Detail</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>

                    <article class="control-panel feature-panel">
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                            <span>Portal proveedor</span>
                        </div>
                        <strong>Proveedor cotiza, sube factura y consulta estatus</strong>
                        <p>Cierra la historia comercial: menos llamadas, mas evidencia y una ruta clara para compras y cuentas por pagar.</p>
                        <div class="feature-tags">
                            <span>Cotiza</span>
                            <span>Factura</span>
                            <span>Consulta estatus</span>
                        </div>
                    </article>

                    <article class="control-panel assistant-panel" style="@ToneStyle(SelectedWorkflow.AssistantTone)">
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                            <span>Asistente de proceso</span>
                        </div>
                        <strong>@SelectedWorkflow.AssistantTitle</strong>
                        <p>@SelectedWorkflow.AssistantMessage</p>
                        <div class="assistant-rule">
                            <span>Regla simple</span>
                            <strong>@SelectedWorkflow.AssistantRule</strong>
                        </div>
                    </article>
                </section>
            </section>
        </div>

        <section class="handoff-strip" aria-label="Puntos de union entre workflows">
            <div class="handoff-title">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                <span>Puentes preparados</span>
            </div>
            <div class="handoff-items">
                <span>Requisicion -> Cotizacion -> Suficiencia</span>
                <span>Autorizacion -> Contrato -> Compromiso</span>
                <span>Factura -> Provision -> Pago</span>
                <span>Documentos -> Bitacora -> Auditoria</span>
            </div>
        </section>
        }
    </section>
</MudContainer>

@code {
    private string selectedWorkflowId = "presupuesto";
    private bool permissionsReady;
    private IReadOnlyList<WorkflowDefinition> visibleWorkflows = [];

    private WorkflowDefinition SelectedWorkflow =>
        visibleWorkflows.FirstOrDefault(workflow => workflow.Id == selectedWorkflowId)
        ?? visibleWorkflows.FirstOrDefault()
        ?? Workflows[0];

    private IReadOnlyList<WorkflowDefinition> VisibleWorkflows => visibleWorkflows;

    private bool HasVisibleWorkflows => visibleWorkflows.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await AuthProvider.GetAuthenticationStateAsync();

        visibleWorkflows = Workflows
            .Where(CanViewWorkflow)
            .ToList();

        if (visibleWorkflows.Count > 0 && !visibleWorkflows.Any(workflow => workflow.Id == selectedWorkflowId))
        {
            selectedWorkflowId = visibleWorkflows[0].Id;
        }

        permissionsReady = true;
    }

    private void SelectWorkflow(string workflowId)
    {
        selectedWorkflowId = workflowId;
    }

    private string WorkflowCardClass(WorkflowDefinition workflow) =>
        workflow.Id == selectedWorkflowId ? "workflow-card active" : "workflow-card";

    private void OpenSelectedWorkflow() => OpenRoute(SelectedWorkflow.Route);

    private void OpenWorkflow(WorkflowDefinition workflow)
    {
        selectedWorkflowId = workflow.Id;
        OpenRoute(workflow.Route);
    }

    private void OpenStep(WorkflowStep step) => OpenRoute(step.FutureRoute);

    private void OpenRoute(string route)
    {
        if (!string.IsNullOrWhiteSpace(route) && CanViewRoute(route))
        {
            NavigationManager.NavigateTo(route);
        }
    }

    private bool CanViewWorkflow(WorkflowDefinition workflow) =>
        workflow.RequiredPermissions.Count == 0
        || workflow.RequiredPermissions.Any(HasViewPermission);

    private bool CanViewRoute(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return false;
        }

        return RoutePermissions.TryGetValue(NormalizeRoute(route), out var permission)
            ? HasViewPermission(permission)
            : CanViewWorkflow(SelectedWorkflow);
    }

    private bool HasViewPermission(PermissionRequirement permission) =>
        AuthProvider.HasPermission(permission.Module, permission.SubModule, "view")
        || AuthProvider.HasPermission(permission.Module, permission.SubModule, "view-menu");

    private static string NormalizeRoute(string route) =>
        route.Trim().TrimEnd('/').ToLowerInvariant();

    private static string AccentStyle(string accent) =>
        $"--workflow-accent: {accent};";

    private static string ToneStyle(string tone) => tone switch
    {
        "success" => "--tone-color: var(--mud-palette-success);",
        "warning" => "--tone-color: var(--mud-palette-warning);",
        "error" => "--tone-color: var(--mud-palette-error);",
        "info" => "--tone-color: var(--mud-palette-info);",
        _ => "--tone-color: var(--mud-palette-primary);"
    };

    private static readonly IReadOnlyList<ExecutiveMetric> ExecutiveMetrics =
    [
        new("Presupuesto disponible", "$12.45 M", "Disponible para nuevas solicitudes", Icons.Material.Filled.Savings, "#2F80ED"),
        new("Presupuesto comprometido", "$4.82 M", "Contratos y ordenes en curso", Icons.Material.Filled.AssignmentTurnedIn, "#0F766E"),
        new("En proceso de compra", "14", "Requisiciones, cotizaciones y contratos", Icons.Material.Filled.ShoppingCartCheckout, "#7C3AED"),
        new("Pendiente de pago", "$1.18 M", "Facturas listas para provision o pago", Icons.Material.Filled.ReceiptLong, "#A11A1F"),
        new("Dias promedio por flujo", "12", "De requisicion a factura", Icons.Material.Filled.QueryStats, "#B7791F")
    ];

    private static readonly IReadOnlyList<BottleneckSnapshot> BottleneckSnapshots =
    [
        new(8, "requisiciones sin cotizar", "warning"),
        new(5, "solicitudes esperando suficiencia", "warning"),
        new(3, "contratos pendientes", "error"),
        new(6, "facturas sin provisionar", "info")
    ];

    private static readonly IReadOnlyList<WorkflowDefinition> Workflows =
    [
        new(
            Id: "presupuesto",
            Title: "Presupuesto",
            Subtitle: "De la solicitud al ejercicio",
            Icon: Icons.Material.Filled.AccountBalance,
            Accent: "#2F80ED",
            Health: "Amarillo",
            HealthTone: "warning",
            HealthReason: "Requiere autorizacion de suficiencia antes de comprometer recursos.",
            ActiveProcesses: 18,
            BlockedProcesses: 6,
            AverageDays: 9,
            Owner: "GRP / Presupuesto",
            Signal: "Egreso",
            Outcome: "Ejercido",
            BudgetSignal: "Momentos contables",
            EntryPoint: "Necesidad presupuestal",
            ControlPoint: "Suficiencia autorizada",
            ExitPoint: "Egreso ejercido",
            NextAction: "Revisar solicitudes de suficiencia",
            AssistantTitle: "Esta solicitud no debe avanzar sin suficiencia autorizada",
            AssistantMessage: "El flujo detecta presupuesto disponible, pero falta la autorizacion que permite reservar el recurso y preparar el compromiso.",
            AssistantRule: "Sin suficiencia autorizada, no se habilita compromiso.",
            AssistantTone: "warning",
            Steps:
            [
                new("Solicitado", "Origen", "Nace la necesidad y se identifica la partida presupuestal.", Icons.Material.Filled.Assignment, "Completo", "success", "Area solicitante", "1 dia", "Requisicion", "/Adquisiciones/Requisicion", ["Requisicion", "Partida", "Evidencia"]),
                new("Autorizado", "Base", "Se reconoce el presupuesto aprobado contra el que se operara.", Icons.Material.Filled.Verified, "Completo", "success", "Presupuesto", "Mismo dia", "Presupuesto autorizado", "/Presupuesto/Egreso/Presupuesto_Autorizado", ["Presupuesto autorizado", "Techo presupuestal"]),
                new("Modificado", "Ajuste", "Ampliaciones, reducciones o adecuaciones preparan disponibilidad real.", Icons.Material.Filled.Tune, "En curso", "info", "Planeacion", "2 dias", "Adecuacion", "/Presupuesto/Egreso/Presupesto_Modificado/Adecuaciones", ["Adecuacion", "Justificacion"]),
                new("Suficiencia", "Reserva", "La solicitud valida disponibilidad antes de comprometer recursos.", Icons.Material.Filled.RuleFolder, "Atorado", "warning", "Presupuesto", "3 dias", "Suficiencia", "/Presupuesto/Egreso/Presupuesto_Comprometido/Solicitud_Suficiencia", ["Solicitud suficiencia", "Autorizacion suficiencia"]),
                new("Comprometido", "Obligacion", "Contrato u orden formaliza el compromiso presupuestal.", Icons.Material.Filled.AssignmentTurnedIn, "Pendiente", "info", "Adquisiciones", "2 dias", "Contrato/OC", "/Presupuesto/Egreso/Presupuesto_Comprometido/Registro_Comprometido", ["Contrato", "Orden compra", "Poliza compromiso"]),
                new("Devengado", "Documento", "La factura comprueba recepcion, monto y soporte.", Icons.Material.Filled.ReceiptLong, "Pendiente", "info", "Cuentas por pagar", "2 dias", "Factura", "/Presupuesto/Tesoreria/CuentasXPagar/Factura_Pago", ["Factura", "Comprobante", "Evidencia recepcion"]),
                new("Ejercido", "Pago", "Tesoreria provisiona y ejecuta el pago correspondiente.", Icons.Material.Filled.Payments, "Pendiente", "info", "Tesoreria", "1 dia", "CLC/Pago", "/Presupuesto/Tesoreria/CuentasXPagar/Provision_Pago", ["Poliza", "CLC", "Comprobante pago"])
            ],
            Documents:
            [
                new("Requisicion", "Completo", "Solicitud y partidas identificadas", Icons.Material.Filled.Description, "success"),
                new("Suficiencia", "Pendiente", "Esperando autorizacion presupuestal", Icons.Material.Filled.RuleFolder, "warning"),
                new("Contrato u orden", "Esperado", "Se habilita al comprometer", Icons.Material.Filled.Article, "info"),
                new("Factura", "Esperado", "Base del devengado", Icons.Material.Filled.Receipt, "info"),
                new("Poliza / CLC", "Esperado", "Evidencia del ejercido", Icons.Material.Filled.AccountBalanceWallet, "info")
            ],
            Timeline:
            [
                new("Solicito: Area usuaria", "10:18 - Capturo requisicion y anexo evidencia.", "success"),
                new("Cambio: Planeacion", "11:02 - Ajusto disponibilidad por adecuacion.", "info"),
                new("Autoriza: Presupuesto", "Pendiente - Falta visto bueno de suficiencia.", "warning"),
                new("Documento: Contrato/OC", "Preparado para compromiso cuando se libere la suficiencia.", "info")
            ],
            Bottlenecks:
            [
                new("Suficiencias pendientes", "Solicitudes listas para autorizar.", 8, "warning"),
                new("Adecuaciones por cuadrar", "Movimientos que no deben avanzar sin balance.", 3, "error"),
                new("Facturas sin provision", "Documentos recibidos sin generar pago.", 5, "warning")
            ])
        {
            Route = "/Presupuesto/Egreso/Presupuesto_Comprometido/Solicitud_Suficiencia",
            RequiredPermissions =
            [
                new("Egreso", "Presupuesto_Autorizado"),
                new("Presupuesto_Modificado", "Ampliaciones"),
                new("Presupuesto_Comprometido", "Solicitud_Suficiencia"),
                new("Presupuesto_Comprometido", "Registro_Comprometido")
            ]
        },
        new(
            Id: "orden-compra",
            Title: "Orden de compra",
            Subtitle: "De requisicion a factura",
            Icon: Icons.Material.Filled.ShoppingCartCheckout,
            Accent: "#0F766E",
            Health: "Verde",
            HealthTone: "success",
            HealthReason: "Normal: el paquete de compra avanza con evidencia suficiente.",
            ActiveProcesses: 14,
            BlockedProcesses: 2,
            AverageDays: 12,
            Owner: "GRP / Adquisiciones",
            Signal: "Compra",
            Outcome: "Factura",
            BudgetSignal: "Expediente completo",
            EntryPoint: "Requisicion capturada",
            ControlPoint: "Suficiencia autorizada",
            ExitPoint: "Factura lista para pago",
            NextAction: "Solicitar cotizaciones faltantes",
