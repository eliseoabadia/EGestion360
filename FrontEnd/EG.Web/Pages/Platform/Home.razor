        string Tone);

    private sealed record WorkflowDefinition(
        string Id,
        string Title,
        string Subtitle,
        string Icon,
        string Accent,
        string Health,
        string HealthTone,
        string HealthReason,
        int ActiveProcesses,
        int BlockedProcesses,
        int AverageDays,
        string Owner,
        string Signal,
        string Outcome,
        string BudgetSignal,
        string EntryPoint,
        string ControlPoint,
        string ExitPoint,
        string NextAction,
        string AssistantTitle,
        string AssistantMessage,
        string AssistantRule,
        string AssistantTone,
