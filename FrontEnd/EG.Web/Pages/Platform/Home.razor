        height: 100%;
        min-height: 0;
        overflow: auto;
        padding: 24px 28px 32px !important;
        background:
            radial-gradient(circle at 82% 4%, color-mix(in srgb, var(--mud-palette-primary) 5%, transparent), transparent 28rem),
            var(--mud-palette-background);
        background-size: auto;
    }

    .home-shell {
