@page "/Reporting/Viewer"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.False" Class="pa-3 reporting-viewer-page">
    <MudPaper Elevation="1" Class="reporting-viewer-toolbar">
        <div class="reporting-viewer-title">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="GoBack" />
            <MudText Typo="Typo.h6">@ViewerTitle</MudText>
        </div>
    </MudPaper>

    @if (_isResolvingReport)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" />
    }
    else if (string.IsNullOrWhiteSpace(ResolvedReportName))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-3">
            No se recibio el nombre del reporte.
        </MudAlert>
    }
    else
    {
        <div class="reporting-viewer-shell">
            <DxWasmDocumentViewer ReportName="@ResolvedReportName" Height="calc(100vh - 108px)">
                <DxWasmDocumentViewerRequestOptions Host="@ApiHost" InvokeAction="DXXRDV" />
                <DxDocumentViewerExportSettings UseSameTab="false" />
            </DxWasmDocumentViewer>
        </div>
    }
</MudContainer>

<style>
    .reporting-viewer-page {
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .reporting-viewer-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .reporting-viewer-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .reporting-viewer-shell {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        border: 1px solid var(--mud-palette-lines-default);
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "title")]
    public string? Title { get; set; }

    private string? ResolvedReportName { get; set; }
    private string? ResolvedTitle { get; set; }
    private bool _isResolvingReport = true;

    private string ViewerTitle => string.IsNullOrWhiteSpace(ResolvedTitle) ? "Reporte" : ResolvedTitle;

    private string ApiHost => ResolveApiHost();

    protected override async Task OnParametersSetAsync()
    {
        _isResolvingReport = true;
        ResolvedReportName = await ResolveReportNameAsync();
        ResolvedTitle = await ResolveReportTitleAsync();
        _isResolvingReport = false;
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private async Task<string?> ResolveReportNameAsync()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            return null;
        }

        var storedReport = await JS.InvokeAsync<string?>("sessionStorage.getItem", BuildReportStorageKey(Name));
        if (!string.IsNullOrWhiteSpace(storedReport))
        {
            return storedReport;
        }

        return IsReportToken(Name) ? null : Name;
    }

    private async Task<string?> ResolveReportTitleAsync()
    {
        if (!string.IsNullOrWhiteSpace(Title))
        {
            return Title;
        }

        if (string.IsNullOrWhiteSpace(Name))
        {
            return null;
        }

        return await JS.InvokeAsync<string?>("sessionStorage.getItem", BuildReportTitleStorageKey(Name));
    }

    private string ResolveApiHost()
    {
        var configured = Configuration.GetSection("ApiSetting:baseUrl").Value;
        var baseUri = Navigation.BaseUri?.ToString() ?? "/";
        if (string.IsNullOrWhiteSpace(configured))
        {
            return baseUri;
        }

        return Uri.TryCreate(configured, UriKind.Absolute, out var absolute)
            ? absolute.ToString()
            : new Uri(new Uri(baseUri), configured).ToString();
    }

    private static bool IsReportToken(string value) =>
        value.StartsWith("RPT-", StringComparison.OrdinalIgnoreCase);

    private static string BuildReportStorageKey(string token) => $"eg.report.{token}";

    private static string BuildReportTitleStorageKey(string token) => $"eg.report.title.{token}";
}
