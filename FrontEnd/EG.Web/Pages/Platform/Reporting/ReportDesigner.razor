@page "/Reporting/Designer"
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False" Class="pa-3">
    <MudPaper Elevation="1" Class="pa-4">
        <div class="d-flex align-center gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="GoBack" />
            <MudText Typo="Typo.h6">Disenador de reporte</MudText>
        </div>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            El disenador se mantiene deshabilitado para aligerar el arranque del sistema.
        </MudAlert>
    </MudPaper>
</MudContainer>

@code {
    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
