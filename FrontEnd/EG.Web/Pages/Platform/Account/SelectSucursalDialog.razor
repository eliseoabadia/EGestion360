@using EG.Domain.DTOs.Responses.General
@using EG.Web.Services
@using MudBlazor

@inject SucursalStateService SucursalStateService

<MudDialog>
<TitleContent>
<MudText Typo="Typo.h6">
<MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Class="mr-2" />
Selecciona una Sucursal
</MudText>
</TitleContent>

<DialogContent>
<MudText Class="mb-4">
Tienes asignadas varias sucursales. Por favor, selecciona una para continuar:
</MudText>

@foreach (var sucursal in Sucursales)
{
<MudCard Class="mb-2 cursor-pointer" @onclick="() => SeleccionarSucursal(sucursal)" Style="cursor: pointer;">
<MudCardContent>
<div class="d-flex align-center">
<MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-3" Color="Color.Primary" />
<div>
<MudText><strong>@sucursal.NombreSucursal</strong></MudText>
<MudText Typo="Typo.caption">@sucursal.NombreEmpresa</MudText>
<MudText Typo="Typo.caption">@sucursal.DireccionSucursal</MudText>
</div>
</div>
</MudCardContent>
</MudCard>
}
</DialogContent>
</MudDialog>

@code {
[Parameter]
public List<UsuarioSucursalResponse> Sucursales { get; set; } = new();

[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private async Task SeleccionarSucursal(UsuarioSucursalResponse sucursal)
    {
        await SucursalStateService.SetSucursalAsync(
            sucursal.IdSucursal,
            sucursal.NombreSucursal ?? string.Empty,
            GetEmpresaId(sucursal),
            sucursal.NombreEmpresa);
        MudDialog.Close(DialogResult.Ok(sucursal));
    }

    private static int? GetEmpresaId(UsuarioSucursalResponse sucursal)
    {
        if (sucursal.PkidEmpresa > 0)
            return sucursal.PkidEmpresa;

        if (sucursal.IdEmpresa.GetValueOrDefault() > 0)
            return sucursal.IdEmpresa;

        return null;
    }
}
