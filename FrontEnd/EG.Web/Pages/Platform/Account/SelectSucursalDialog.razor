@using EG.Domain.DTOs.Responses.General
@using EG.Web.Services
@using MudBlazor

@inject SucursalStateService SucursalStateService

<MudDialog Class="sucursal-dialog">
    <TitleContent>
        <div class="sucursal-dialog__header">
            <div class="sucursal-dialog__header-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
            </div>
            <div class="sucursal-dialog__heading">
                <MudText Typo="Typo.overline" Class="sucursal-dialog__eyebrow">Espacio de trabajo</MudText>
                <MudText Typo="Typo.h5" Class="sucursal-dialog__title">Elige una sucursal</MudText>
            </div>
            <span class="sucursal-dialog__count">@Sucursales.Count @(Sucursales.Count == 1 ? "opción" : "opciones")</span>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="sucursal-dialog__content">
            <MudText Typo="Typo.body2" Class="sucursal-dialog__description">
                Tu cuenta tiene acceso a varias sucursales. Selecciona aquella con la que deseas trabajar.
            </MudText>

            <ul class="sucursal-dialog__list" aria-label="Sucursales disponibles">
                @foreach (var sucursal in Sucursales)
                {
                    <li @key="sucursal.IdSucursal" class="sucursal-dialog__list-item">
                        <button type="button"
                                class="sucursal-option"
                                aria-label="Seleccionar sucursal @sucursal.NombreSucursal"
                                @onclick="() => SeleccionarSucursal(sucursal)">
                            <span class="sucursal-option__icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Business" />
                            </span>

                            <span class="sucursal-option__details">
                                <span class="sucursal-option__name">@sucursal.NombreSucursal</span>

                                @if (!string.IsNullOrWhiteSpace(sucursal.NombreEmpresa))
                                {
                                    <span class="sucursal-option__meta">
                                        <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" />
                                        <span>@sucursal.NombreEmpresa</span>
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(sucursal.DireccionSucursal))
                                {
                                    <span class="sucursal-option__meta sucursal-option__address">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                                        <span>@sucursal.DireccionSucursal</span>
                                    </span>
                                }
                            </span>

                            <span class="sucursal-option__action" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                            </span>
                        </button>
                    </li>
                }
            </ul>

            <div class="sucursal-dialog__hint">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                <MudText Typo="Typo.caption">Podrás cambiar de sucursal más adelante desde el menú principal.</MudText>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public List<UsuarioSucursalResponse> Sucursales { get; set; } = new();

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private async Task SeleccionarSucursal(UsuarioSucursalResponse sucursal)
    {
        await SucursalStateService.SetSucursalAsync(
            sucursal.IdSucursal,
            sucursal.NombreSucursal ?? string.Empty,
            GetEmpresaId(sucursal),
            sucursal.NombreEmpresa);
        MudDialog.Close(DialogResult.Ok(sucursal));
    }

    private static int? GetEmpresaId(UsuarioSucursalResponse sucursal)
    {
        if (sucursal.PkidEmpresa > 0)
            return sucursal.PkidEmpresa;

        if (sucursal.IdEmpresa.GetValueOrDefault() > 0)
            return sucursal.IdEmpresa;

        return null;
    }
}
