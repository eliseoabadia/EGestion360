@page "/login"
@implements IDisposable
@using EG.Web.Auth
@using EG.Web.Contracts
@using EG.Web.Contracts.Configuration
@using EG.Web.Models
@using EG.Web.Models.DTO
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Services
@using MudBlazor

@inject SucursalStateService SucursalStateService
@inject ThemeStateService ThemeStateService
@inject IGenericCrudService<UsuarioSucursalResponse> _serviceUS
@inject IJSRuntime _jsRuntime
@inject INavigateService _navigateService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILoginService LoginService
@inject IDialogService DialogService
@inject ILogger<Login> Logger

<div class="login-root">
    <div class="login-shell">
        <section class="login-brand-panel" aria-label="EGestion360">
            <div class="login-theme-selector" aria-label="Seleccionar tema">
                @foreach (var option in Enum.GetValues<AppThemeOption>())
                {
                    <MudTooltip Text="@GetThemeLabel(option)">
                        <MudIconButton Icon="@GetThemeIcon(option)"
                                       Size="Size.Small"
                                       Color="@(ThemeStateService.SelectedOption == option ? Color.Primary : Color.Default)"
                                       Class="@GetLoginThemeButtonClass(option)"
                                       aria-label="@GetThemeLabel(option)"
                                       Disabled="@isLoading"
                                       OnClick="@(() => SelectThemeAsync(option))" />
                    </MudTooltip>
                }
            </div>

            <div class="brand-lockup">
                <div class="brand-mark">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Class="brand-name">EGestion<span>360</span></MudText>
                    <MudText Typo="Typo.body2" Class="brand-caption">Gestion empresarial</MudText>
                </div>
            </div>

            <div class="login-context">
                <MudText Typo="Typo.overline">Acceso institucional</MudText>
                <MudText Typo="Typo.h4">Portal administrativo</MudText>
                <MudText Typo="Typo.body2">
                    Utiliza tu cuenta asignada para continuar con tu sesion de trabajo.
                </MudText>
            </div>

            <div class="trust-list">
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                    <span>Sesion protegida</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.Business" />
                    <span>Perfil por entidad y sucursal</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                    <span>Soporte operativo</span>
                </div>
            </div>
        </section>

        <section class="login-form-panel">
            <MudPaper Elevation="0" Class="form-paper">
                <div class="form-header">
                    <MudText Typo="Typo.h4" Class="form-title">Iniciar sesion</MudText>
                    <MudText Typo="Typo.body2" Class="form-subtitle">Ingresa tus credenciales para acceder al sistema.</MudText>
                </div>

                <MudForm @ref="loginForm" Class="login-form">
                    @if (isLoading)
                    {
                        <div class="login-progress-state" role="status" aria-live="polite">
                            <div class="login-progress-header">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="login-progress-title">@LoginStatusText</MudText>
                                    <MudText Typo="Typo.caption" Class="login-progress-caption">Espera un momento, estamos preparando tu sesion.</MudText>
                                </div>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" Class="mt-2" />
                        </div>
                    }

                    <MudTextField @bind-Value="login.Usuario"
                                  Label="Usuario o correo"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Disabled="@isLoading"
                                  InputId="@UserInputId"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="El usuario es requerido"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  Class="login-field" />

                    <MudTextField @bind-Value="login.Password"
                                  Label="Contrasena"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  InputId="@PasswordInputId"
                                  Immediate="true"
                                  Disabled="@isLoading"
                                  InputType="@passwordInputType"
                                  Required="true"
                                  RequiredError="La contrasena es requerida"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Class="login-field" />

                    <div class="form-actions-row">
                        <MudLink Href="/resetPassword"
                                 Typo="Typo.body2"
                                 Color="Color.Primary"
                                 Class="@(isLoading ? "login-disabled-link" : null)">
                            ¿Olvidaste tu contraseña?
                        </MudLink>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="login-button"
                               OnClick="HandleLogin"
                               Disabled="isLoading">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                        }
                        @(isLoading ? LoginButtonText : "Acceder")
                    </MudButton>
                </MudForm>

                <div class="form-footer">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        Sin cuenta activa?
                        <MudLink Href="/soporte" Color="Color.Primary">Contacta a soporte</MudLink>
                    </MudText>
                </div>
            </MudPaper>
        </section>
    </div>
</div>

<style media="not all">
    .login-root {
        position: relative;
        isolation: isolate;
        min-height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background:
            linear-gradient(120deg, color-mix(in srgb, var(--mud-palette-primary) 8%, transparent), transparent 42%),
            var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
        font-family: var(--mud-typography-default-font-family);
    }

    .login-root::before,
    .login-root::after {
        content: "";
        position: absolute;
        z-index: -1;
        width: min(32vw, 360px);
        aspect-ratio: 1;
        border-radius: 999px;
        filter: blur(24px);
        opacity: .32;
        pointer-events: none;
    }

    .login-root::before {
        top: 8%;
        left: 7%;
        background: color-mix(in srgb, var(--mud-palette-primary) 46%, transparent);
    }

    .login-root::after {
        right: 8%;
        bottom: 7%;
        background: color-mix(in srgb, var(--mud-palette-secondary) 34%, transparent);
    }

    .login-shell {
        display: grid;
        grid-template-columns: minmax(340px, .86fr) minmax(360px, 1fr);
        width: min(1120px, 100%);
        min-height: 620px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 16px;
        overflow: hidden;
        background: var(--mud-palette-surface);
        box-shadow: 0 28px 68px color-mix(in srgb, var(--mud-palette-black) 24%, transparent);
    }

    .login-brand-panel {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 32px;
        padding: 34px;
        background:
            linear-gradient(160deg, color-mix(in srgb, var(--mud-palette-primary) 18%, var(--mud-palette-surface)), var(--mud-palette-surface));
        border-right: 1px solid var(--mud-palette-lines-default);
    }

    .login-theme-selector {
        display: inline-flex;
        align-self: flex-start;
        gap: 6px;
        padding: 4px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 92%, transparent);
    }

    .login-theme-button {
        border-radius: 6px;
        color: var(--mud-palette-text-secondary);
    }

    .login-theme-button.active {
        background: var(--eg-primary-soft);
        color: var(--mud-palette-primary);
    }

    .brand-lockup {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-mark {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--mud-palette-primary);
        color: var(--eg-on-primary);
    }

    .brand-mark .mud-icon-root {
        font-size: 30px;
    }

    .brand-name {
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: 0;
    }

    .brand-name span {
        color: var(--mud-palette-primary);
        font-weight: 600;
    }

    .brand-caption,
    .login-context .mud-typography-body2,
    .form-subtitle,
    .form-footer {
        color: var(--mud-palette-text-secondary);
    }

    .login-context {
        display: grid;
        gap: 10px;
        max-width: 430px;
    }

    .login-context .mud-typography-overline {
        color: var(--mud-palette-primary);
        font-weight: 800;
        letter-spacing: .08em;
    }

    .login-context .mud-typography-h4 {
        font-weight: 800;
        line-height: 1.14;
    }

    .trust-list {
        display: grid;
        gap: 10px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 18%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-primary) 5%, var(--mud-palette-surface));
        color: var(--mud-palette-text-primary);
    }

    .trust-item .mud-icon-root {
        color: var(--mud-palette-primary);
    }

    .login-form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
        background: var(--mud-palette-surface);
    }

    .form-paper {
        width: 100%;
        max-width: 430px;
        background: transparent !important;
        box-shadow: none !important;
    }

    .form-paper:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    .form-header {
        margin-bottom: 28px;
    }

    .form-title {
        font-weight: 800;
        color: var(--mud-palette-text-primary);
        line-height: 1.18;
    }

    .form-subtitle {
        margin-top: 8px;
    }

    .login-form {
        display: grid;
        gap: 14px;
    }

    .login-progress-state {
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 24%, var(--mud-palette-lines-default));
        border-radius: 8px;
        padding: 12px;
        background: color-mix(in srgb, var(--mud-palette-primary) 7%, var(--mud-palette-surface));
    }

    .login-progress-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .login-progress-title {
        font-weight: 700;
        color: var(--mud-palette-text-primary);
    }

    .login-progress-caption {
        color: var(--mud-palette-text-secondary);
    }

    .login-field .mud-input-root {
        min-height: 44px;
    }

    .form-actions-row {
        display: flex;
        justify-content: flex-end;
        margin-top: -4px;
        margin-bottom: 4px;
    }

    .login-button {
        min-height: 44px;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 0;
        box-shadow: none;
        transition: transform .16s ease, filter .16s ease;
    }

    .login-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.02);
    }

    .login-button:disabled {
        transform: none;
    }

    .login-disabled-link {
        pointer-events: none;
        opacity: .55;
    }

    .form-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid var(--mud-palette-lines-default);
        text-align: center;
    }

    @@media (max-width: 900px) {
        .login-root {
            padding: 0;
        }

        .login-shell {
            min-height: 100%;
            grid-template-columns: 1fr;
            border-radius: 0;
            border-left: 0;
            border-right: 0;
        }

        .login-brand-panel {
            gap: 22px;
            padding: 24px;
            border-right: 0;
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }

        .login-form-panel {
            padding: 32px 24px;
            align-items: flex-start;
        }
    }

    @@media (max-width: 560px) {
        .login-brand-panel {
            padding: 20px;
        }

        .brand-lockup {
            align-items: flex-start;
        }

        .trust-list {
            display: none;
        }

        .login-form-panel {
            padding: 28px 20px;
        }
    }
</style>
