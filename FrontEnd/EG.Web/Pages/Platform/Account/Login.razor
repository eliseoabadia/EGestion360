@page "/login"
@implements IDisposable
@using EG.Web.Auth
@using EG.Web.Contracts
@using EG.Web.Contracts.Configuration
@using EG.Web.Models
@using EG.Web.Models.DTO
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Services
@using MudBlazor

@inject SucursalStateService SucursalStateService
@inject ThemeStateService ThemeStateService
@inject IGenericCrudService<UsuarioSucursalResponse> _serviceUS
@inject IJSRuntime _jsRuntime
@inject INavigateService _navigateService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILoginService LoginService
@inject IDialogService DialogService

<div class="login-root">
    <div class="login-shell">
        <section class="login-brand-panel" aria-label="EGestion360">
            <div class="login-theme-selector" aria-label="Seleccionar tema">
                @foreach (var option in Enum.GetValues<AppThemeOption>())
                {
                    <MudTooltip Text="@GetThemeLabel(option)">
                        <MudIconButton Icon="@GetThemeIcon(option)"
                                       Size="Size.Small"
                                       Color="@(ThemeStateService.SelectedOption == option ? Color.Primary : Color.Default)"
                                       Class="@GetLoginThemeButtonClass(option)"
                                       OnClick="@(() => SelectThemeAsync(option))" />
                    </MudTooltip>
                }
            </div>

            <div class="brand-lockup">
                <div class="brand-mark">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Class="brand-name">EGestion<span>360</span></MudText>
                    <MudText Typo="Typo.body2" Class="brand-caption">Gestion empresarial</MudText>
                </div>
            </div>

            <div class="login-context">
                <MudText Typo="Typo.overline">Acceso institucional</MudText>
                <MudText Typo="Typo.h4">Portal administrativo</MudText>
                <MudText Typo="Typo.body2">
                    Utiliza tu cuenta asignada para continuar con tu sesion de trabajo.
                </MudText>
            </div>

            <div class="trust-list">
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                    <span>Sesion protegida</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.Business" />
                    <span>Perfil por empresa y sucursal</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                    <span>Soporte operativo</span>
                </div>
            </div>
        </section>

        <section class="login-form-panel">
            <MudPaper Elevation="0" Class="form-paper">
                <div class="form-header">
                    <MudText Typo="Typo.h4" Class="form-title">Iniciar sesion</MudText>
                    <MudText Typo="Typo.body2" Class="form-subtitle">Ingresa tus credenciales para acceder al sistema.</MudText>
                </div>

                <MudForm @ref="loginForm" Class="login-form">
                    <MudTextField @bind-Value="login.Usuario"
                                  Label="Usuario o correo"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="El usuario es requerido"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  Class="login-field" />

                    <MudTextField @bind-Value="login.Password"
                                  Label="Contrasena"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  InputType="@passwordInputType"
                                  Required="true"
                                  RequiredError="La contrasena es requerida"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Class="login-field" />

                    <div class="form-actions-row">
                        <MudLink Href="/resetPassword" Typo="Typo.body2" Color="Color.Primary">Recuperar acceso</MudLink>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="login-button"
                               OnClick="HandleLogin"
                               Disabled="isLoading">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                        }
                        Acceder
                    </MudButton>
                </MudForm>

                <div class="form-footer">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        Sin cuenta activa?
                        <MudLink Href="/soporte" Color="Color.Primary">Contacta a soporte</MudLink>
                    </MudText>
                </div>
            </MudPaper>
        </section>
    </div>
</div>

<style>
    .login-root {
        min-height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background:
            linear-gradient(120deg, color-mix(in srgb, var(--mud-palette-primary) 8%, transparent), transparent 42%),
            var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
        font-family: var(--mud-typography-default-font-family);
    }

    .login-shell {
        display: grid;
        grid-template-columns: minmax(340px, .86fr) minmax(360px, 1fr);
        width: min(1120px, 100%);
        min-height: 620px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        overflow: hidden;
        background: var(--mud-palette-surface);
        box-shadow: 0 18px 45px rgba(0, 0, 0, .18);
    }

    .login-brand-panel {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 32px;
        padding: 34px;
        background:
            linear-gradient(160deg, color-mix(in srgb, var(--mud-palette-primary) 18%, var(--mud-palette-surface)), var(--mud-palette-surface));
        border-right: 1px solid var(--mud-palette-lines-default);
    }

    .login-theme-selector {
        display: inline-flex;
        align-self: flex-start;
        gap: 6px;
        padding: 4px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 92%, transparent);
    }

    .login-theme-button {
        border-radius: 6px;
        color: var(--mud-palette-text-secondary);
    }

    .login-theme-button.active {
        background: var(--eg-primary-soft);
        color: var(--mud-palette-primary);
    }

    .brand-lockup {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .brand-mark {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--mud-palette-primary);
        color: var(--eg-on-primary);
    }

    .brand-mark .mud-icon-root {
        font-size: 30px;
    }

    .brand-name {
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: 0;
    }

    .brand-name span {
        color: var(--mud-palette-primary);
        font-weight: 600;
    }

    .brand-caption,
    .login-context .mud-typography-body2,
    .form-subtitle,
    .form-footer {
        color: var(--mud-palette-text-secondary);
    }

    .login-context {
        display: grid;
        gap: 10px;
        max-width: 430px;
    }

    .login-context .mud-typography-overline {
        color: var(--mud-palette-primary);
        font-weight: 800;
        letter-spacing: .08em;
    }

    .login-context .mud-typography-h4 {
        font-weight: 800;
        line-height: 1.14;
    }

    .trust-list {
        display: grid;
        gap: 10px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 18%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-primary) 5%, var(--mud-palette-surface));
        color: var(--mud-palette-text-primary);
    }

    .trust-item .mud-icon-root {
        color: var(--mud-palette-primary);
    }

    .login-form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
        background: var(--mud-palette-surface);
    }

    .form-paper {
        width: 100%;
        max-width: 430px;
        background: transparent !important;
        box-shadow: none !important;
    }

    .form-paper:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    .form-header {
        margin-bottom: 28px;
    }

    .form-title {
        font-weight: 800;
        color: var(--mud-palette-text-primary);
        line-height: 1.18;
    }

    .form-subtitle {
        margin-top: 8px;
    }

    .login-form {
        display: grid;
        gap: 14px;
    }

    .login-field .mud-input-root {
        min-height: 44px;
    }

    .form-actions-row {
        display: flex;
        justify-content: flex-end;
        margin-top: -4px;
        margin-bottom: 4px;
    }

    .login-button {
        min-height: 44px;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 0;
        box-shadow: none;
        transition: transform .16s ease, filter .16s ease;
    }

    .login-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.02);
    }

    .form-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid var(--mud-palette-lines-default);
        text-align: center;
    }

    @@media (max-width: 900px) {
        .login-root {
            padding: 0;
        }

        .login-shell {
            min-height: 100%;
            grid-template-columns: 1fr;
            border-radius: 0;
            border-left: 0;
            border-right: 0;
        }

        .login-brand-panel {
            gap: 22px;
            padding: 24px;
            border-right: 0;
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }

        .login-form-panel {
            padding: 32px 24px;
            align-items: flex-start;
        }
    }

    @@media (max-width: 560px) {
        .login-brand-panel {
            padding: 20px;
        }

        .brand-lockup {
            align-items: flex-start;
        }

        .trust-list {
            display: none;
        }

        .login-form-panel {
            padding: 28px 20px;
        }
    }
</style>

@code {
    private LoginDTO login = new();
    private MudForm? loginForm;

    private bool isShow;
    private bool isLoading;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    [Inject] private HttpClient HttpClient { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await ThemeStateService.InitializeAsync();
        ThemeStateService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(AppThemeOption option)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SelectThemeAsync(AppThemeOption option)
    {
        await ThemeStateService.SetThemeAsync(option);
    }

    private static string GetThemeIcon(AppThemeOption option) => option switch
    {
        AppThemeOption.Claro => Icons.Material.Outlined.LightMode,
        AppThemeOption.Oscuro => Icons.Material.Outlined.DarkMode,
        AppThemeOption.Morena => Icons.Material.Filled.Park,
        _ => Icons.Material.Outlined.DarkMode
    };

    private static string GetThemeLabel(AppThemeOption option) =>
        EG.Web.Services.ThemeStateService.GetThemeName(option);

    private string GetLoginThemeButtonClass(AppThemeOption option) =>
        ThemeStateService.SelectedOption == option
            ? "login-theme-button active"
            : "login-theme-button";

    private void TogglePasswordVisibility()
    {
        isShow = !isShow;
        passwordIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        passwordInputType = isShow ? InputType.Text : InputType.Password;
    }

    private async Task HandleLogin()
    {
        if (isLoading)
            return;

        if (loginForm != null)
        {
            await loginForm.Validate();
            if (!loginForm.IsValid)
            {
                Snackbar.Add("Completa usuario y contrasena.", Severity.Warning);
                return;
            }
        }

        isLoading = true;

        try
        {
            UserResult result = await LoginService.LoginAsync(login.Usuario, login.Password);

            if (result != null && !string.Equals(result.PayrollId, "0", StringComparison.Ordinal))
            {
                await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.AccessToken);
                await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "userId", result.PkIdUsuario);
                await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "userName", result.NombreUsuario);
                var authProvider = (AuthenticationProviderJWT)AuthenticationStateProvider;
                await authProvider.LoginAsync(result.AccessToken);

                // Los permisos se cargan fuera del JWT para mantener pequena la
                // cabecera Authorization aunque el usuario tenga muchos accesos.
                var permissionClaimsTask = _navigateService.GetAllClaimsByUserAsync(result.PkIdUsuario);
                var sucursalesTask = LoadSucursalesUsuarioAsync(result.PkIdUsuario, result.AccessToken);
                await Task.WhenAll(permissionClaimsTask, sucursalesTask);

                var permissionClaims = await permissionClaimsTask;
                await authProvider.LoadClaimsFromDbAsync(permissionClaims);

                var sucursalesUsuario = await sucursalesTask;

                if (sucursalesUsuario.Success != true)
                {
                    Snackbar.Add(sucursalesUsuario.Message ?? "No se pudieron cargar las sucursales del usuario.", Severity.Error);
                }
                else if (sucursalesUsuario.Items.Count > 1)
                {
                    var parameters = new DialogParameters { { "Sucursales", sucursalesUsuario.Items.ToList() } };
                    var options = new DialogOptions { CloseOnEscapeKey = false };
                    var dialog = await DialogService.ShowAsync<SelectSucursalDialog>("Seleccionar Sucursal", parameters, options);
                    var dialogResult = await dialog.Result;

                    if (dialogResult.Canceled)
                        return;

                    var selectedSucursal = dialogResult.Data as UsuarioSucursalResponse;
                    if (selectedSucursal != null)
                    {
                        Snackbar.Add($"Sucursal seleccionada: {selectedSucursal.NombreSucursal}", Severity.Info);
                        NavigationManager.NavigateTo("/", replace: true);
                    }
                }
                else if (sucursalesUsuario.Items.Count == 1)
                {
                    await SucursalStateService.SetSucursalAsync(
                        sucursalesUsuario.Items[0].IdSucursal,
                        sucursalesUsuario.Items[0].NombreSucursal,
                        sucursalesUsuario.Items[0].IdEmpresaPersona,
                        sucursalesUsuario.Items[0].NombreEmpresa);
                    Snackbar.Add("Bienvenido.", Severity.Success);
                    NavigationManager.NavigateTo("/", replace: true);
                }
                else
                {
                    Snackbar.Add(sucursalesUsuario.Message ?? "No tienes sucursales asignadas. Contacta al administrador.", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add("Correo o contrasena incorrectos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al iniciar sesion: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<ApiResponse<UsuarioSucursalResponse>> LoadSucursalesUsuarioAsync(int usuarioId, string? accessToken)
    {
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/UsuarioSucursal/usuario/{usuarioId}");
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", accessToken?.Trim('"', '\''));

            using var response = await HttpClient.SendAsync(request);
            var responseBody = await response.Content.ReadAsStringAsync();
            var result = string.IsNullOrWhiteSpace(responseBody)
                ? null
                : System.Text.Json.JsonSerializer.Deserialize<ApiResponse<UsuarioSucursalResponse>>(
                    responseBody,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (response.IsSuccessStatusCode)
            {
                return result ?? new ApiResponse<UsuarioSucursalResponse>
                {
                    Success = false,
                    Message = "No se pudieron leer las sucursales del usuario."
                };
            }

            return result ?? new ApiResponse<UsuarioSucursalResponse>
            {
                Success = false,
                Message = $"Error al cargar sucursales: {(int)response.StatusCode} {response.ReasonPhrase}"
            };
        }
        catch (Exception ex)
        {
            return new ApiResponse<UsuarioSucursalResponse>
            {
                Success = false,
                Message = $"Error al cargar sucursales: {ex.Message}"
            };
        }
    }

    public void Dispose()
    {
        ThemeStateService.OnThemeChanged -= OnThemeChanged;
    }
}
