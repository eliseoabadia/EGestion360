@page "/resetPassword"

<PageTitle>Recuperar acceso · EGestion360</PageTitle>
<div class="password-recovery-page">
    <MudPaper Class="password-recovery-card pa-6" Elevation="2">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="mt-3">@(_hasToken ? "Restablecer contraseña" : "¿Olvidaste tu contraseña?")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-5">
            @(_hasToken ? "Captura y confirma una nueva contraseña para tu cuenta." : "Escribe el correo registrado en tu cuenta y te enviaremos un enlace de recuperación.")
        </MudText>

        @if (!string.IsNullOrEmpty(_message))
        {
            <MudAlert Severity="@(_success ? Severity.Success : Severity.Error)" Class="mb-4" role="status">@_message</MudAlert>
        }

        @if (!_completed && _ready)
        {
            @if (_hasToken)
            {
                <EditForm Model="_reset" OnValidSubmit="ResetAsync" FormName="reset-password">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <MudTextField @bind-Value="_reset.NewPassword" For="@(() => _reset.NewPassword)"
                                  Label="Nueva contraseña" InputType="InputType.Password" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Disabled="_busy" autocomplete="new-password" MaxLength="128" />
                    <MudTextField @bind-Value="_reset.ConfirmPassword" For="@(() => _reset.ConfirmPassword)"
                                  Label="Confirmar contraseña" InputType="InputType.Password" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Disabled="_busy" autocomplete="new-password" MaxLength="128" Class="mt-3" />
                    <MudText Typo="Typo.caption" Class="mt-2">Usa entre 6 y 128 caracteres y una contraseña diferente a la actual.</MudText>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled"
                               FullWidth="true" Disabled="_busy" Class="mt-5">
                        @(_busy ? "Actualizando…" : "Actualizar contraseña")
                    </MudButton>
                </EditForm>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RequestAnotherLink" Disabled="_busy" Class="mt-4">Solicitar otro enlace</MudButton>
            }
            else
            {
                <EditForm Model="_forgot" OnValidSubmit="RequestAsync" FormName="forgot-password">
                    <DataAnnotationsValidator />
                    <MudTextField @bind-Value="_forgot.Email" For="@(() => _forgot.Email)" Label="Correo electrónico"
                                  InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Disabled="_busy" autocomplete="email" MaxLength="256" />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled"
                               FullWidth="true" Disabled="_busy" Class="mt-5">
                        @(_busy ? "Enviando solicitud…" : "Enviar enlace de recuperación")
                    </MudButton>
                </EditForm>
            }
        }

        <MudDivider Class="my-5" />
        <MudLink Href="login">Volver al inicio de sesión</MudLink>
    </MudPaper>
</div>
