@page "/{ModuleSlug}/Dashboard"
@using System.Globalization
@using System.Text
@inject NavigationManager NavigationManager
@inject AuthenticationProviderJWT AuthProvider

<MudContainer MaxWidth="MaxWidth.False" Class="module-dashboard">
    <section class="module-shell" style="@AccentStyle(Current.Accent)">
        <header class="module-hero">
            <div class="hero-title">
                <button type="button" class="back-button" aria-label="Regresar" @onclick="GoHome">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                </button>
                <span class="module-icon">
                    <MudIcon Icon="@Current.Icon" Size="Size.Medium" />
                </span>
                <div>
                    <span class="eyebrow">@Current.Owner</span>
                    <h1>@Current.Title</h1>
                    <p>@Current.Summary</p>
                </div>
            </div>

            <div class="hero-status">
                <span>@Current.Signal</span>
                <strong>Etapa @(RecommendedStageIndex + 1) de @Current.Stages.Count</strong>
            </div>
        </header>

        <section class="metric-strip" aria-label="Indicadores del modulo">
            @foreach (var metric in Current.Metrics)
            {
                <article class="module-metric" style="@ToneStyle(metric.Tone)">
                    <MudIcon Icon="@metric.Icon" Size="Size.Small" />
                    <div>
                        <span>@metric.Label</span>
                        <strong>@metric.Value</strong>
                        <small>@metric.Detail</small>
                    </div>
                </article>
            }
        </section>

        @if (RecommendedStage is { } recommendedStage)
        {
            <section class="guide-panel" aria-label="Guía de avance del módulo">
                <div class="guide-heading">
                    <div class="guide-title">
                        <span class="guide-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                        </span>
                        <div>
                            <span>Ayuda del proceso</span>
                            <strong>Qué llevas, qué sigue y qué falta</strong>
                            <p>Usa esta ruta como guía; abre cada etapa para consultar el estado de sus expedientes.</p>
                        </div>
                    </div>
                    <button type="button"
                            class="next-button guide-cta"
                            @onclick="OpenNextAction"
                            disabled="@(!CanOpenStage(recommendedStage))">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                        <span>@Current.NextAction</span>
                    </button>
                </div>

                <div class="guide-progress" style="@GuideProgressStyle">
                    <div class="guide-progress-bar" aria-hidden="true">
                        <span></span>
                    </div>
                    <small>@AccessibleStageCount pantallas disponibles de @Current.Stages.Count en esta ruta</small>
                </div>

                <div class="guide-summary">
                    <article class="guide-summary-card completed">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                            Ya recorrido
                        </span>
                        <strong>@CompletedStageCount @(CompletedStageCount == 1 ? "etapa" : "etapas")</strong>
                        <p>@CompletedStagesText</p>
                    </article>

                    <article class="guide-summary-card current">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
                            Haz esto ahora
                        </span>
                        <strong>@recommendedStage.Title</strong>
                        <p>@recommendedStage.Detail</p>
                        <div class="guide-requirements">
                            <small><b>Necesitas:</b> @GetStageRequirement(RecommendedStageIndex)</small>
                            <small><b>Obtienes:</b> @GetStageResult(RecommendedStageIndex)</small>
                        </div>
                    </article>

                    <article class="guide-summary-card pending">
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                            Falta después
                        </span>
                        <strong>@PendingStageCount @(PendingStageCount == 1 ? "etapa" : "etapas")</strong>
                        <p>@PendingStagesText</p>
                    </article>
                </div>
            </section>
        }

        <section class="module-grid">
            <article class="workflow-panel">
                <div class="panel-heading">
                    <div>
                        <span>Ruta completa</span>
                        <strong>@Current.FlowName</strong>
                    </div>
                    <div class="workflow-legend" aria-label="Estados de la ruta">
                        <span class="completed"><i></i>Recorrido</span>
                        <span class="current"><i></i>Ahora</span>
                        <span class="pending"><i></i>Después</span>
                    </div>
                </div>

                <div class="stage-lane">
                    @for (var index = 0; index < Current.Stages.Count; index++)
                    {
                        var stage = Current.Stages[index];
                        var progress = GetStageProgress(index);
                        <article class="stage-card @progress.CssClass" style="@ToneStyle(progress.Tone)">
                            <div class="stage-marker">
                                <span class="stage-number">@((index + 1).ToString("00"))</span>
                                <span class="stage-progress-state">
                                    <MudIcon Icon="@progress.Icon" Size="Size.Small" />
                                    @progress.Label
                                </span>
                            </div>
                            <div class="stage-body">
                                <div class="stage-title">
                                    <MudIcon Icon="@stage.Icon" Size="Size.Small" />
                                    <strong>@stage.Title</strong>
                                </div>
                                <p>@stage.Detail</p>
                                <div class="stage-guidance">
                                    <small><b>Entrada:</b> @GetStageRequirement(index)</small>
                                    <small><b>Salida:</b> @GetStageResult(index)</small>
                                </div>
                                <div class="stage-meta">
                                    <span>@stage.Status</span>
                                    <span>@stage.Document</span>
                                </div>
                                @if (CanOpenStage(stage))
                                {
                                    <button type="button" class="stage-action" @onclick="@(() => OpenStage(stage))">
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" />
                                        @GetStageActionLabel(index)
                                    </button>
                                }
                                else
                                {
                                    <span class="stage-no-access">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                        Sin acceso asignado
                                    </span>
                                }
                            </div>
                        </article>

                        @if (index < Current.Stages.Count - 1)
                        {
                            <span class="stage-connector" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </span>
                        }
                    }
                </div>
            </article>

            <aside class="side-rail">
                <article class="focus-panel">
                    <div class="panel-heading compact">
                        <span>Qué requiere atención</span>
                        <MudIcon Icon="@Icons.Material.Filled.Troubleshoot" Size="Size.Small" />
                    </div>
                    <div class="insight-list">
                        @foreach (var insight in Current.Insights)
                        {
                            <div class="insight-row" style="@ToneStyle(insight.Tone)">
                                <span class="dot"></span>
                                <div>
                                    <strong>@insight.Title</strong>
                                    <small>@insight.Detail</small>
                                </div>
                                <em>@insight.Count</em>
                            </div>
                        }
                    </div>
                </article>

                <article class="focus-panel">
                    <div class="panel-heading compact">
                        <span>Expediente digital</span>
                        <MudIcon Icon="@Icons.Material.Filled.FolderCopy" Size="Size.Small" />
                    </div>
                    <div class="document-stack">
                        @for (var documentIndex = 0; documentIndex < Current.Documents.Count; documentIndex++)
                        {
                            var document = Current.Documents[documentIndex];
                            <span style="@ToneStyle(document.Tone)">
                                <MudIcon Icon="@document.Icon" Size="Size.Small" />
                                <b>@document.Title</b>
                                <small>@GetDocumentStatus(documentIndex)</small>
                            </span>
                        }
                    </div>
                </article>

                <article class="assistant-card" style="@ToneStyle(Current.AssistantTone)">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                    <div>
                        <span>Antes de continuar</span>
                        <strong>@Current.AssistantMessage</strong>
                    </div>
                </article>
            </aside>
        </section>
    </section>
</MudContainer>

@code {
    [Parameter] public string? ModuleSlug { get; set; }

    private ModuleModel Current { get; set; } = Catalog["default"];

    private int AccessibleStageCount => Current.Stages.Count(CanOpenStage);
    private int RecommendedStageIndex =>
        Current.Stages.Count == 0
            ? -1
            : Math.Clamp(Current.GuideStageIndex, 0, Current.Stages.Count - 1);
    private StageModel? RecommendedStage =>
        RecommendedStageIndex >= 0 ? Current.Stages[RecommendedStageIndex] : null;
    private int CompletedStageCount => Math.Max(RecommendedStageIndex, 0);
    private int PendingStageCount =>
        RecommendedStageIndex < 0 ? 0 : Math.Max(Current.Stages.Count - RecommendedStageIndex - 1, 0);
    private string CompletedStagesText =>
        CompletedStageCount == 0
            ? "Esta es la primera etapa de la ruta."
            : string.Join(" · ", Current.Stages.Take(CompletedStageCount).Select(stage => stage.Title));
    private string PendingStagesText =>
        PendingStageCount == 0
            ? "Al concluir este paso habrás completado la ruta."
            : string.Join(" · ", Current.Stages.Skip(RecommendedStageIndex + 1).Select(stage => stage.Title));
    private string GuideProgressStyle
    {
        get
        {
            var percentage = Current.Stages.Count == 0
                ? 0
                : ((RecommendedStageIndex + 1d) / Current.Stages.Count) * 100d;
            return $"--guide-progress:{percentage.ToString("0.##", CultureInfo.InvariantCulture)}%;";
        }
    }

    protected override void OnParametersSet()
    {
        Current = ResolveModule(ModuleSlug);
    }

    private void GoHome() => NavigationManager.NavigateTo("/");

    private void OpenNextAction()
    {
        var stage = RecommendedStage is { } recommended && CanOpenStage(recommended)
            ? recommended
            : Current.Stages
                .Skip(Math.Max(RecommendedStageIndex, 0))
                .FirstOrDefault(CanOpenStage)
              ?? Current.Stages.FirstOrDefault(CanOpenStage);

        if (stage != null)
        {
            OpenStage(stage);
        }
    }

    private void OpenStage(StageModel stage)
    {
        if (!string.IsNullOrWhiteSpace(stage.Route))
        {
            NavigationManager.NavigateTo(stage.Route);
        }
    }

    private bool CanOpenStage(StageModel? stage)
    {
        if (stage == null || string.IsNullOrWhiteSpace(stage.Route))
            return false;

        if (stage.PermissionModules.Count == 0 || string.IsNullOrWhiteSpace(stage.PermissionSubModule))
            return true;

        return stage.PermissionModules.Any(module =>
            HasPermission(module, stage.PermissionSubModule, "view") ||
            HasPermission(module, stage.PermissionSubModule, "view-menu") ||
            HasPermission(module, stage.PermissionSubModule, "authorize") ||
            HasPermission(module, stage.PermissionSubModule, "CanExportToExcel"));
    }

    private bool HasPermission(string module, string subModule, string action) =>
        AuthProvider.HasPermission(module, subModule, action);

    private StageProgressView GetStageProgress(int index) =>
        index < RecommendedStageIndex
            ? new("Recorrido", "completed", "success", Icons.Material.Filled.CheckCircle)
            : index == RecommendedStageIndex
                ? new("Ahora", "current", "warning", Icons.Material.Filled.PlayCircle)
                : new("Después", "pending", "neutral", Icons.Material.Filled.Schedule);

    private string GetStageRequirement(int index)
    {
        if (index <= 0 || Current.Stages.Count == 0)
            return "Datos base, periodo activo y permisos para operar el módulo.";

        var previous = Current.Stages[index - 1];
        return $"{previous.Document} validado desde {previous.Title}.";
    }

    private string GetStageResult(int index)
    {
        if (index < 0 || index >= Current.Stages.Count)
            return "Documento de la etapa.";

        var stage = Current.Stages[index];
        return index == Current.Stages.Count - 1
            ? $"{stage.Document} integrado para cerrar el proceso."
            : $"{stage.Document} listo para continuar a {Current.Stages[index + 1].Title}.";
    }

    private string GetStageActionLabel(int index) =>
        index < RecommendedStageIndex
            ? "Consultar"
            : index == RecommendedStageIndex
                ? "Continuar"
                : "Preparar";

    private string GetDocumentStatus(int index) =>
        index < RecommendedStageIndex
            ? "Integrado"
            : index == RecommendedStageIndex
                ? "En integración"
                : "Pendiente";

    private static ModuleModel ResolveModule(string? slug)
    {
        var key = NormalizeKey(slug);
        return Catalog.TryGetValue(key, out var module) ? module : Catalog["default"];
    }

    private static string AccentStyle(string accent) => $"--module-accent:{accent};";

    private static string ToneStyle(string tone)
    {
        var color = tone switch
        {
            "success" => "var(--eg-status-success)",
            "warning" => "var(--eg-status-warning)",
            "error" => "var(--mud-palette-error)",
            "info" => "var(--eg-status-info)",
            "neutral" => "#667085",
            _ => "var(--module-accent)"
        };

        return $"--tone-color:{color};";
    }

    private static string NormalizeKey(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var normalized = text.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(char.ToLowerInvariant(c));
            }
        }

        return builder.ToString()
            .Normalize(NormalizationForm.FormC)
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .Replace("-", string.Empty, StringComparison.Ordinal)
            .Replace("_", string.Empty, StringComparison.Ordinal);
    }

