                    new("Catalogos", "18", "Activos", Icons.Material.Filled.SettingsApplications, "neutral")
                ],
                [
                    Stage("Menus", "Estructura de navegacion.", "Base", "Menu", Icons.Material.Filled.Menu, "info", "/Sistema/Menu", ["Sistema"], "Menu"),
                    Stage("Usuarios", "Cuentas, perfil y sucursal.", "Control", "Usuario", Icons.Material.Filled.ManageAccounts, "success", "/Sistema/Usuario", ["Sistema"], "Usuario"),
                    Stage("Accesos", "Claims por rol y menu.", "Seguridad", "Claims", Icons.Material.Filled.AdminPanelSettings, "warning", "/Sistema/Configurar_Accesos", ["Sistema"], "Configurar_Accesos"),
                    Stage("Catalogos", "Datos base de operacion.", "Soporte", "Catalogo", Icons.Material.Filled.SettingsApplications, "neutral", "/configuracion/presupuestales/clave-programa/anios", ["Sistema", "Configuracion"], "Catalogos")
                ],
                [
                    new("Menus sin claim", "Revisar perfiles", "6", "warning"),
                    new("Usuarios sin sucursal", "Operacion bloqueada", "2", "error"),
                    new("Catalogos activos", "Listos para uso", "18", "success")
                ],
                StandardDocuments(["Rol", "Menu", "Claim", "Catalogo"]))
        };

        modules["default"] = new(
            "Dashboard de modulo",
            "Centro operativo",
            Icons.Material.Filled.SpaceDashboard,
            "#2563EB",
            "Vista conceptual",
            "Selecciona un dashboard desde el icono del menu principal.",
            "Workflow",
            "Volver al inicio",
            "Sin modulo reconocido para esta ruta.",
            "neutral",
            [new("Modulo", "N/D", "Ruta no configurada", Icons.Material.Filled.Info, "neutral")],
            [Stage("Inicio", "Centro de mando general.", "Vista", "Dashboard", Icons.Material.Filled.Home, "neutral", "/", [], string.Empty)],
            [new("Sin datos", "Configura el modulo", "0", "neutral")],
            StandardDocuments(["Dashboard"]));

        return modules;
    }

    private static StageModel Stage(
        string title,
        string detail,
        string status,
        string document,
        string icon,
        string tone,
        string route,
        IReadOnlyList<string> permissionModules,
        string permissionSubModule) =>
        new(title, detail, status, document, icon, tone, route, permissionModules, permissionSubModule);

    private static IReadOnlyList<DocumentModel> StandardDocuments(IReadOnlyList<string> titles) =>
        titles.Select((title, index) => new DocumentModel(
            title,
            index % 3 == 0 ? Icons.Material.Filled.Article : index % 3 == 1 ? Icons.Material.Filled.FolderCopy : Icons.Material.Filled.ReceiptLong,
            index % 3 == 0 ? "success" : index % 3 == 1 ? "info" : "warning"))
        .ToList();

    private sealed record ModuleModel(
        string Title,
        string Owner,
        string Icon,
        string Accent,
        string Signal,
        string Summary,
        string FlowName,
        string NextAction,
        string AssistantMessage,
        string AssistantTone,
        IReadOnlyList<MetricModel> Metrics,
        IReadOnlyList<StageModel> Stages,
        IReadOnlyList<InsightModel> Insights,
        IReadOnlyList<DocumentModel> Documents);

    private sealed record MetricModel(string Label, string Value, string Detail, string Icon, string Tone);

    private sealed record StageModel(
        string Title,
        string Detail,
        string Status,
        string Document,
        string Icon,
        string Tone,
        string Route,
        IReadOnlyList<string> PermissionModules,
        string PermissionSubModule);

    private sealed record InsightModel(string Title, string Detail, string Count, string Tone);

    private sealed record DocumentModel(string Title, string Icon, string Tone);
}

