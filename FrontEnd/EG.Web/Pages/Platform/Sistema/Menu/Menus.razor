@implements IDisposable
@page "/configuracion/sistema/menu"
@using System.ComponentModel.DataAnnotations
@using EG.Web.Auth
@using EG.Web.Contracts
@using EG.Dommain.DTOs.Responses
@using EG.Web.Services
@using MiniExcelLibs
@using MudBlazor

@inject NavigationManager NavigationManager
@inject IGenericCrudService<MenuItemsResponse> _service
@inject ISnackbar Snackbar

@inject IJSRuntime _jsRuntime
@inject IDialogService DialogService


<MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False">
    @if (!_isInitialized)
    {
        <!-- Loading inicial -->
        <MudOverlay Visible="true" Fixed="true" ZIndex="10">
            <div class="d-flex flex-column align-center justify-center" style="height:100%">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="mt-4">Cargando...</MudText>
            </div>
        </MudOverlay>
    }
    else if (!_hasAccess)
    {
        <!-- Acceso denegado -->
        <MudCard Elevation="3" Class="mt-8">
            <MudCardContent>
                <div class="d-flex flex-column align-center justify-center" style="min-height: 400px;">
                    <MudIcon Icon="@Icons.Material.Filled.OutlinedFlag" Size="Size.Large" Color="Color.Error" />
                    <MudText Typo="Typo.h5" Color="Color.Error" Class="mt-4">Acceso Denegado</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-2 text-center">
                        No tienes permisos para acceder a esta página.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NavigateToHome" Class="mt-6">
                        Volver al inicio
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <PageHeader Title="Gestion de menus"
                    Subtitle="Administra la estructura de navegacion del sistema."
                    Kicker="Configuracion del sistema"
                    Icon="@Icons.Material.Filled.Menu"
                    CanCreate="@_canCreate"
                    CreateTooltip="Nuevo menu"
                    OnCreate="CrearMenu"
                    OnRefresh="() => mudTableRef.ReloadData()" />

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@loadError</MudAlert>
        }

        <MudPaper Elevation="0" Class="pa-4 rounded-lg eg-content-surface">

            <!-- Tabla -->
            <GenericDataGrid TItem="MenuItemsResponse"
                             @ref="mudTableRef"
                             Title="Lista de Menus"
                             SearchPlaceholder="Buscar por nombre..."
                             SearchString="@searchString"
                             SearchStringChanged="value => searchString = value"
                             ShowExportButton="@_canExport"
                             ServerDataFunc="LoadServerData"
                             ExportFunc="ExportarExcel"
                             PageSize="@pageSize"
                             FixedHeader="true"
                             TableHeight="500px">
                <Columns>
                    <TemplateColumn T="MenuItemsResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                        <CellTemplate Context="cell">
                            <MudTooltip Text="Agregar menú">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                            Color="Color.Error"
                            Size="Size.Small"
                            Visible="_canCreate"
                            OnClick="@(() => CrearHijoMenu(cell.Item.PkidMenu, cell.Item.Nombre))" />
                            </MudTooltip>


                            <MudTooltip Text="Editar menú">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                            Color="Color.Primary"
                            Size="Size.Small"
                            Visible="_canUpdate"
                            OnClick="@(() => EditarMenu(cell.Item.PkidMenu))" />
                            </MudTooltip>

                            <MudTooltip Text="Eliminar menú">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
                            Size="Size.Small"
                            Visible="_canDelete"
                            OnClick="@(() => EliminarMenu(cell.Item.PkidMenu))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    
                    <TemplateColumn T="MenuItemsResponse" Title="Nombre" Identifier="Nombre" PropertyName="Nombre" SortBy="x => x.Nombre">
                        <CellTemplate Context="cell">
                            @if (cell.Item.Tipo == 1)
                            {
                            <MudText Style="font-weight: 500;">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                            @cell.Item.Nombre
                            </MudText>
                            }
                            else
                            {
                            <MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Info" Class="mr-1" />
                            @cell.Item.Nombre
                            </MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="MenuItemsResponse" Title="Tipo" Identifier="Tipo" PropertyName="Tipo" SortBy="x => x.Tipo">
                        <CellTemplate Context="cell">
                            @cell.Item.Tipo
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="MenuItemsResponse" Title="Menú Padre" Identifier="NombreMenuPadre" PropertyName="NombreMenuPadre" SortBy="x => x.NombreMenuPadre">
                        <CellTemplate Context="cell">
                            @(cell.Item.NombreMenuPadre ?? "-")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="MenuItemsResponse" Title="Orden" Identifier="Orden" PropertyName="Orden" SortBy="x => x.Orden">
                        <CellTemplate Context="cell">
                            @cell.Item.Orden
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </GenericDataGrid>
        </MudPaper>
    }
    </MudContainer>
