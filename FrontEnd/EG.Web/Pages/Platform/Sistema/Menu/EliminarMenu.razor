@using EG.Dommain.DTOs.Responses

<BaseCrudDialog TItem="MenuItemsResponse" @ref="dialog" Title="Eliminar menú"
                MaxWidth="MaxWidth.Small" ActionColor="Color.Error" ActionIcon="@Icons.Material.Filled.Delete"
                ActionText="@EG.Common.ApplicationText.Actions.Delete" ProcessingText="Eliminando..."
                CanConfirm="@(!loading && menu != null && menu.TieneSubmenus == 0)" OnConfirm="DeleteMenuAsync">
    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Cargando menú" />
    }
    else if (menu == null)
    {
        <MudAlert Severity="Severity.Error">No fue posible cargar el menú.</MudAlert>
        <MudButton OnClick="LoadMenuAsync" StartIcon="@Icons.Material.Filled.Refresh">Reintentar</MudButton>
    }
    else
    {
        <MudText Typo="Typo.subtitle1">@menu.Nombre</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@menu.Ruta</MudText>
        <MudAlert Severity="@(menu.TieneSubmenus > 0 ? Severity.Error : Severity.Warning)">
            @(menu.TieneSubmenus > 0
                ? "Este menú tiene submenús activos. Retíralos antes de darlo de baja."
                : "El menú se dará de baja y dejará de estar disponible en la navegación.")
        </MudAlert>
    }
</BaseCrudDialog>
