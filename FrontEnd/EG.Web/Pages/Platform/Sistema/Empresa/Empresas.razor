@page "/configuracion/sistema/empresa"
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<EmpresaResponse, EmpresaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Empresas"
                    Subtitle="Administra y mantén el registro de empresas del sistema"
                    Icon="@Icons.Material.Filled.Business"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="EmpresaResponse"
                      @ref="table"
                      Title="Lista de Empresas"
                      SearchPlaceholder="Buscar por nombre, nombre corto, RFC o registro IMSS..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidEmpresa" T="EmpresaResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="EmpresaNombre" T="EmpresaResponse">Nombre</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="NombreCorto" T="EmpresaResponse">Nombre corto</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="RazonSocial" T="EmpresaResponse">Razon social</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="EstadoNombre" T="EmpresaResponse">Entidad</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Rfc" T="EmpresaResponse">RFC</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="RegImss" T="EmpresaResponse">Registro IMSS</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="empresa">
                <MudTd>
                    <MudTooltip Text="Editar empresa">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(empresa.PkidEmpresa))" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar departamento a esta empresa">
                        <MudIconButton Icon="@Icons.Material.Filled.DomainAdd"
                                       Visible="@CanCreate"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(() => CrearDepartamentoEmpresa(empresa))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar empresa">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(empresa.PkidEmpresa))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@empresa.PkidEmpresa</MudTd>
                <MudTd>@empresa.EmpresaNombre</MudTd>
                <MudTd>@empresa.NombreCorto</MudTd>
                <MudTd>@empresa.RazonSocial</MudTd>
                <MudTd>@empresa.EstadoNombre</MudTd>
                <MudTd>@empresa.Rfc</MudTd>
                <MudTd>@empresa.RegImss</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<EmpresaResponse> table = null!;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Empresa";

    protected override Type CreateDialogType => typeof(EmpresaDialog);
    protected override Type EditDialogType => typeof(EmpresaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EmpresaResponse>);

    protected override string GetDefaultSortLabel() => "EmpresaNombre";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EmpresaResponse> items)
    {
        return items.Select(e => new
        {
            ID = e.PkidEmpresa,
            Nombre = e.EmpresaNombre,
            NombreCorto = e.NombreCorto,
            RazonSocial = e.RazonSocial,
            RFC = e.Rfc,
            RegistroIMSS = e.RegImss,
            Entidad = e.EstadoNombre,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.EmpresaNombre ?? "la empresa";
        }
        catch
        {
            return "la empresa";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            Console.WriteLine("🔄 Recargando tabla de empresas...");
            await table.ReloadData();
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("⚠️ table es null en ReloadData");
        }
    }

    private async Task CrearDepartamentoEmpresa(EmpresaResponse empresa)
    {
        if (empresa.PkidEmpresa <= 0)
        {
            Snackbar.Add("No se pudo identificar la empresa para crear el departamento.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = empresa.PkidEmpresa
        };

        var dialog = await DialogService.ShowAsync<DepartamentoDialog>(
            $"Nuevo departamento - {empresa.EmpresaNombre}",
            parameters,
            new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            Snackbar.Add($"Departamento agregado a {empresa.EmpresaNombre}", Severity.Success);
        }
    }
}
