@page "/configuracion/sistema/empresa"
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<EmpresaResponse, EmpresaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Entidades"
                    Subtitle="Administra y mantén el registro de entidades del sistema"
                    Icon="@Icons.Material.Filled.Business"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="EmpresaResponse"
                      @ref="table"
                      Title="Lista de Entidades"
                      SearchPlaceholder="Buscar por nombre, nombre corto, RFC o registro IMSS..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="EmpresaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar entidad"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidEmpresa))" /></MudTooltip><MudTooltip Text="Agregar departamento a esta entidad"><MudIconButton Icon="@Icons.Material.Filled.DomainAdd" Visible="@CanCreate" Color="Color.Success" Size="Size.Small" OnClick="@(() => CrearDepartamentoEmpresa(context.Item))" /></MudTooltip><MudTooltip Text="Eliminar entidad"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidEmpresa))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="EmpresaResponse" TProperty="int" Property="x => x.PkidEmpresa" Title="ID" Identifier="PkidEmpresa" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.EmpresaNombre" Title="Nombre" Identifier="EmpresaNombre" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.NombreCorto" Title="Nombre corto" Identifier="NombreCorto" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.RazonSocial" Title="Razón social" Identifier="RazonSocial" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.EstadoNombre" Title="Entidad" Identifier="EstadoNombre" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.Rfc" Title="RFC" Identifier="Rfc" />
                <PropertyColumn T="EmpresaResponse" TProperty="string" Property="x => x.RegImss" Title="Registro IMSS" Identifier="RegImss" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<EmpresaResponse> table = null!;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Empresa";

    protected override Type CreateDialogType => typeof(EmpresaDialog);
    protected override Type EditDialogType => typeof(EmpresaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EmpresaResponse>);

    protected override string GetDefaultSortLabel() => "EmpresaNombre";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EmpresaResponse> items)
    {
        return items.Select(e => new
        {
            ID = e.PkidEmpresa,
            Nombre = e.EmpresaNombre,
            NombreCorto = e.NombreCorto,
            RazonSocial = e.RazonSocial,
            RFC = e.Rfc,
            RegistroIMSS = e.RegImss,
            Entidad = e.EstadoNombre,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.EmpresaNombre ?? "la entidad";
        }
        catch
        {
            return "la entidad";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }

    private async Task CrearDepartamentoEmpresa(EmpresaResponse empresa)
    {
        if (empresa.PkidEmpresa <= 0)
        {
            Snackbar.Add("No se pudo identificar la entidad para crear el departamento.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = empresa.PkidEmpresa
        };

        var dialog = await DialogService.ShowAsync<DepartamentoDialog>(
            $"Nuevo departamento - {empresa.EmpresaNombre}",
            parameters,
            new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            Snackbar.Add($"Departamento agregado a {empresa.EmpresaNombre}", Severity.Success);
        }
    }
}
