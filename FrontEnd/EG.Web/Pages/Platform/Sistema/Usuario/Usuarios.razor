@page "/configuracion/sistema/usuarios"
@using EG.Dommain.DTOs.Responses
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<UsuarioResponse, UsuarioResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    @if (!string.IsNullOrEmpty(_pageError))
    {
        <MudAlert Severity="Severity.Error" Class="my-4" Variant="Variant.Filled">
            <MudText>Error al cargar la página</MudText>
            <MudText Typo="Typo.body2">@_pageError</MudText>
        </MudAlert>
    }

    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Usuarios"
                    Subtitle="Administra y mantén el registro de usuarios del sistema"
                    Icon="@Icons.Material.Filled.PeopleAlt"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table?.ReloadData()" />

        <GenericTable TItem="UsuarioResponse"
                      @ref="table"
                      Title="Lista de Usuarios"
                      SearchPlaceholder="Buscar por nombre, email o teléfono..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkIdUsuario" T="UsuarioResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="NombreCompletoPersona" T="UsuarioResponse">Persona</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="EmailPersona" T="UsuarioResponse">Email</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TelefonoMovil" T="UsuarioResponse">Teléfono</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="ClavePersona" T="UsuarioResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="PayrollId" T="UsuarioResponse">Payroll ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="NombreEmpresa" T="UsuarioResponse">Empresa</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="usuario">
                <MudTd>
                    <MudTooltip Text="Editar usuario">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(usuario.PkIdUsuario))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar usuario">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(usuario.PkIdUsuario))" />

                    </MudTooltip>
                    <MudTooltip Text="Asignar Sucursal">
                        <MudIconButton Icon="@Icons.Material.Filled.AssignmentInd"
                                       Visible="@CanUpdate"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => AssingSucursal(usuario.PkIdUsuario))" />

                    </MudTooltip>
                </MudTd>
                <MudTd>@usuario.PkIdUsuario</MudTd>
                <MudTd>@usuario.NombreCompletoPersona</MudTd>
                <MudTd>@usuario.EmailPersona</MudTd>
                <MudTd>@(usuario.TelefonoMovil ?? usuario.TelefonoParticular ?? "-")</MudTd>
                <MudTd>@usuario.ClavePersona</MudTd>
                <MudTd>@usuario.PayrollId</MudTd>
                <MudTd>@usuario.NombreEmpresa</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<UsuarioResponse> table = null!;
    private string _pageError = string.Empty;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Usuario";

    protected override Type CreateDialogType => typeof(UsuarioDialog);
    protected override Type EditDialogType => typeof(UsuarioDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<UsuarioResponse>);

    protected override string GetDefaultSortLabel() => "NombreCompleto";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<UsuarioResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkIdUsuario,
            Nombre_Completo = u.NombreCompleto,
            Email = u.Email,
            Telefono = u.TelefonoUsuario,
            Departamento = u.NombreEmpresa
        });
    }

    // Sobrescribir DeleteItem para manejar la eliminación de usuarios
    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        try
        {
            // Mostrar indicador de carga
            Loading = true;
            StateHasChanged();

            // Obtener el nombre del usuario para mostrarlo en el diálogo
            var response = await Service.GetByIdAsync(id);
            var usuarioNombre = response?.Data?.NombreCompleto ?? "el usuario";

            var parameters = new DialogParameters
            {
                ["Id"] = id,
                ["ItemName"] = usuarioNombre,
                ["DeleteFunc"] = new Func<int, Task<bool>>(async (deleteId) =>
                {
                    try
                    {
                        Console.WriteLine($"🗑️ Ejecutando eliminación de usuario ID: {deleteId}");

                        var deleteResponse = await Service.DeleteAsync(deleteId);

                        if (deleteResponse?.Success == true)
                        {
                            var message = deleteResponse.Message ?? "Usuario eliminado correctamente";
                            Console.WriteLine($"✅ {message}");
                            Snackbar.Add(message, Severity.Success);

                            // Recargar la tabla después de eliminar
                            await table.ReloadData();

                            return true;
                        }
                        else
                        {
                            var errorMessage = deleteResponse?.Message ?? "Error al eliminar el usuario";
                            Console.WriteLine($"❌ {errorMessage}");
                            Snackbar.Add(errorMessage, Severity.Error);
                            return false;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"❌ Error en DeleteFunc: {ex.Message}");
                        Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
                        return false;
                    }
                })
            };

            Console.WriteLine($"📤 Mostrando diálogo de eliminación para usuario ID: {id}");

            var dialog = await DialogService.ShowAsync(DeleteDialogType, $"Eliminar {SubModuleName}", parameters,
                new DialogOptions
                {
                    CloseButton = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,
                    Position = DialogPosition.Center
                });

            var result = await dialog.Result;

            if (!result.Canceled)
            {
                Console.WriteLine("✅ Usuario eliminado correctamente");
            }
            else
            {
                Console.WriteLine("❌ Eliminación cancelada por el usuario");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en DeleteItem: {ex.Message}");
            Snackbar.Add($"Error al preparar eliminación: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    
    private async Task AssingSucursal(int id)
    {
        try
        {
            var parameters = new DialogParameters { ["UsuarioId"] = id };
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            };

            //var dialog = await DialogService.ShowAsync<EditarUsuario>("Editar Usuario", parameters, options);

            var dialog = await DialogService.ShowAsync<AsignarUsuariosDepartamento>("Asignar Sucursal", parameters, options);
            var result = await dialog.Result;

            await table.ReloadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocurrió un error: " + ex.Message, Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("🔷 Usuarios: OnInitializedAsync iniciado");
            await base.OnInitializedAsync();
            Console.WriteLine("🔷 Usuarios: OnInitializedAsync completado");
        }
        catch (Exception ex)
        {
            _pageError = $"Error de inicialización: {ex.Message}";
            Console.WriteLine($"❌ Usuarios: OnInitializedAsync error: {ex}");
            Snackbar.Add(_pageError, Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            Console.WriteLine($"🔷 Usuarios: OnAfterRenderAsync firstRender={firstRender}");
            await base.OnAfterRenderAsync(firstRender);
            Console.WriteLine("🔷 Usuarios: OnAfterRenderAsync completado");
        }
        catch (Exception ex)
        {
            _pageError = $"Error de renderizado: {ex.Message}";
            Console.WriteLine($"❌ Usuarios: OnAfterRenderAsync error: {ex}");
            Snackbar.Add(_pageError, Severity.Error);
        }
    }

    // Método auxiliar para recargar la tabla (opcional)
    protected override async Task ReloadData()
    {
        if (table != null)
        {
            Console.WriteLine("🔄 Recargando tabla de usuarios...");
            await table.ReloadData();
            StateHasChanged();
        }
    }
}