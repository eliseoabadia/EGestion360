@page "/configuracion/sistema/usuarios"
@using EG.Dommain.DTOs.Responses
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<UsuarioResponse, UsuarioResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    @if (!string.IsNullOrEmpty(_pageError))
    {
        <MudAlert Severity="Severity.Error" Class="my-4" Variant="Variant.Filled">
            <MudText>Error al cargar la página</MudText>
            <MudText Typo="Typo.body2">@_pageError</MudText>
        </MudAlert>
    }

    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Usuarios"
                    Subtitle="Administra y mantén el registro de usuarios del sistema"
                    Icon="@Icons.Material.Filled.PeopleAlt"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table?.ReloadData()" />

        <GenericDataGrid TItem="UsuarioResponse"
                      @ref="table"
                      Title="Lista de Usuarios"
                      SearchPlaceholder="Buscar por ID, persona, clave, email, telefono o empresa..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="UsuarioResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar usuario"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkIdUsuario))" /></MudTooltip><MudTooltip Text="Eliminar usuario"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkIdUsuario))" /></MudTooltip><MudTooltip Text="Asignar Sucursal"><MudIconButton Icon="@Icons.Material.Filled.AssignmentInd" Visible="@CanUpdate" Color="Color.Error" Size="Size.Small" OnClick="@(() => AssingSucursal(context.Item.PkIdUsuario))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="UsuarioResponse" TProperty="int" Property="x => x.PkIdUsuario" Title="ID" Identifier="PkIdUsuario" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.NombreCompletoPersona" Title="Persona" Identifier="NombreCompletoPersona" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.EmailPersona" Title="Email" Identifier="EmailPersona" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.TelefonoMovil" Title="Teléfono" Identifier="TelefonoMovil" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.ClavePersona" Title="Clave" Identifier="ClavePersona" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.PayrollId" Title="Payroll ID" Identifier="PayrollId" />
                <PropertyColumn T="UsuarioResponse" TProperty="string" Property="x => x.NombreEmpresa" Title="Empresa" Identifier="NombreEmpresa" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<UsuarioResponse> table = null!;
    private string _pageError = string.Empty;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Usuario";

    protected override Type CreateDialogType => typeof(UsuarioDialog);
    protected override Type EditDialogType => typeof(UsuarioDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<UsuarioResponse>);

    protected override string GetDefaultSortLabel() => "NombreCompleto";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<UsuarioResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkIdUsuario,
            Nombre_Completo = u.NombreCompleto,
            Email = u.Email,
            Telefono = u.TelefonoUsuario,
            Departamento = u.NombreEmpresa
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.NombreCompletoPersona
                ?? response?.Data?.NombreCompleto
                ?? "el usuario";
        }
        catch
        {
            return "el usuario";
        }
    }

    private async Task AssingSucursal(int id)
    {
        try
        {
            var parameters = new DialogParameters
            {
                ["UsuarioId"] = id,
                ["ReturnUrl"] = "/configuracion/sistema/usuarios"
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            };

            //var dialog = await DialogService.ShowAsync<EditarUsuario>("Editar Usuario", parameters, options);

            var dialog = await DialogService.ShowAsync<AsignarUsuariosDepartamento>("Asignar Sucursal", parameters, options);
            var result = await dialog.Result;

            await table.ReloadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocurrió un error: " + UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex), Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _pageError = UserFacingExceptionMessages.ForDisplay(
                AppLoggerFactory,
                ex,
                "No fue posible inicializar la pantalla de usuarios. Recarga la pagina e intenta nuevamente.");
            Snackbar.Add(_pageError, Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await base.OnAfterRenderAsync(firstRender);
        }
        catch (Exception ex)
        {
            _pageError = UserFacingExceptionMessages.ForDisplay(
                AppLoggerFactory,
                ex,
                "No fue posible completar la pantalla de usuarios. Recarga la pagina e intenta nuevamente.");
            Snackbar.Add(_pageError, Severity.Error);
        }
    }

    // Método auxiliar para recargar la tabla (opcional)
    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }
}
