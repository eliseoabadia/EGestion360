    private static int GetEmpresaIdFromUsuarioSucursal(UsuarioSucursalResponse asignacion)
    {
        if (asignacion.PkidEmpresa > 0)
            return asignacion.PkidEmpresa;

        return asignacion.IdEmpresa.GetValueOrDefault();
    }

    private async Task CargarEmpresasUsuario()
    {
        if (!Id.HasValue)
            return;

        _loadingEmpresasUsuario = true;
        try
        {
            var asignacionesResponse = await usuarioSucursalService.GetActionAsync($"usuario/{Id.Value}");
            var asignacionesActivas = asignacionesResponse?.Items?
                .Where(x => x.AsignacionActiva)
                .ToList() ?? new List<UsuarioSucursalResponse>();

            _empresasUsuario = listadoEmpresas
                .Select(empresa =>
                {
                    var asignacionEmpresa = asignacionesActivas
                        .Where(x => GetEmpresaIdFromUsuarioSucursal(x) == empresa.PkidEmpresa)
                        .OrderByDescending(x => x.EsMatriz)
                        .ThenBy(x => x.NombreSucursal)
                        .FirstOrDefault();

                    var sucursal = listadoSucursales
                        .Where(x => x.FkidEmpresaSis == empresa.PkidEmpresa)
                        .OrderByDescending(x => x.EsMatriz)
                        .ThenBy(x => x.Nombre)
                        .FirstOrDefault();

                    return new EmpresaUsuarioAsignacion
                    {
                        IdEmpresa = empresa.PkidEmpresa,
                        NombreEmpresa = empresa.EmpresaNombre ?? empresa.RazonSocial ?? $"Empresa {empresa.PkidEmpresa}",
                        IdSucursal = asignacionEmpresa?.IdSucursal ?? sucursal?.PkidSucursal ?? 0,
                        NombreSucursal = asignacionEmpresa?.NombreSucursal ?? sucursal?.Nombre ?? "Se creará matriz al activar",
                        Asignada = asignacionEmpresa != null,
                        PuedeAsignarse = true
                    };
                })
                .OrderBy(x => x.NombreEmpresa)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresas del usuario: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _loadingEmpresasUsuario = false;
        }
    }

    private async Task ToggleEmpresaAsync(EmpresaUsuarioAsignacion empresa, bool asignar)
    {
        if (!Id.HasValue)
        {
            Snackbar.Add("Guarda el usuario antes de asignar empresas", Severity.Warning);
            return;
        }

        if (!asignar && empresa.IdSucursal <= 0)
        {
            Snackbar.Add("No se encontró una sucursal activa para retirar", Severity.Warning);
            return;
        }

        empresa.Procesando = true;
        try
        {
            ApiResponse<UsuarioSucursalResponse> response;
            if (asignar)
            {
                response = await usuarioSucursalService.CreateAsync(new UsuarioSucursalResponse
                {
                    PkIdUsuario = Id.Value,
                    IdEmpresa = empresa.IdEmpresa,
                    PkidEmpresa = empresa.IdEmpresa,
                    IdSucursal = empresa.IdSucursal,
                    PuedeAcceder = true,
                    PuedeOperar = true,
                    AsignacionActiva = true
                });
            }
            else
            {
                response = await usuarioSucursalService.DeleteActionAsync($"{Id.Value}/{empresa.IdSucursal}");
            }

            if (response?.Success == true)
            {
                empresa.Asignada = asignar;
                if (asignar)
                {
                    var asignacion = response.Data ?? response.Items?.FirstOrDefault();
                    if (asignacion != null)
                    {
                        empresa.IdSucursal = asignacion.IdSucursal;
                        empresa.NombreSucursal = string.IsNullOrWhiteSpace(asignacion.NombreSucursal)
                            ? empresa.NombreSucursal
                            : asignacion.NombreSucursal;
                    }

                    await CargarEmpresasUsuario();
                }
                _selectedDepartamento = null;
                Snackbar.Add(asignar
                    ? "Empresa asignada al usuario"
                    : "Empresa retirada del usuario",
                    Severity.Success);
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No se pudo actualizar la asignacion", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al actualizar asignacion: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            empresa.Procesando = false;
            StateHasChanged();
        }
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        NormalizarEmpresaUsuario();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (usuario.IdEmpresa <= 0)
        {
            Snackbar.Add("Debe seleccionar una empresa", Severity.Warning);
            return;
        }

        usuario.PkidEmpresa = usuario.IdEmpresa;
        usuario.IdPersona = _selectedPersona?.Id;

        try
        {
            ApiResponse<UsuarioResponse> response;

            if (Id.HasValue)
            {
                response = await usuarioService.UpdateAsync(usuario, Id.Value);
            }
            else
            {
                response = await usuarioService.CreateAsync(usuario);
            }

            if (response?.Success == true)
            {
                var usuarioId = Id ?? response.Data?.PkIdUsuario ?? response.Items?.FirstOrDefault()?.PkIdUsuario ?? 0;
                if (usuarioId > 0)
                {
                    await EnsureEmpresaPredeterminadaAsignadaAsync(usuarioId, usuario.IdEmpresa);
                }

                var message = response.Message ?? $"Usuario {(Id.HasValue ? "actualizado" : "creado")} exitosamente";
                Snackbar.Add(message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error en la operación", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task EnsureEmpresaPredeterminadaAsignadaAsync(int usuarioId, int empresaId)
    {
        if (usuarioId <= 0 || empresaId <= 0)
            return;

        var asignacionesResponse = await usuarioSucursalService.GetActionAsync($"usuario/{usuarioId}");
        var yaAsignada = asignacionesResponse?.Items?
            .Where(x => x.AsignacionActiva)
            .Any(x => GetEmpresaIdFromUsuarioSucursal(x) == empresaId) == true;

        if (yaAsignada)
            return;

        var sucursal = listadoSucursales
            .Where(x => x.FkidEmpresaSis == empresaId)
            .OrderByDescending(x => x.EsMatriz)
            .ThenBy(x => x.Nombre)
            .FirstOrDefault();

        if (sucursal == null)
        {
            Snackbar.Add("La empresa predeterminada no tiene sucursal activa para habilitar login.", Severity.Warning);
            return;
        }

        var response = await usuarioSucursalService.CreateAsync(new UsuarioSucursalResponse
        {
            PkIdUsuario = usuarioId,
            IdEmpresa = empresaId,
            PkidEmpresa = empresaId,
            IdSucursal = sucursal.PkidSucursal,
            PuedeAcceder = true,
            PuedeOperar = true,
            AsignacionActiva = true
        });

        if (response?.Success != true)
        {
            Snackbar.Add(response?.Message ?? "No se pudo habilitar la empresa predeterminada para login", Severity.Warning);
        }
    }

    private void NormalizarEmpresaUsuario()
    {
        if (usuario.IdEmpresa <= 0 && usuario.PkidEmpresa > 0)
        {
            usuario.IdEmpresa = usuario.PkidEmpresa;
        }

        if (usuario.IdEmpresa <= 0 && SucursalStateService.EmpresaId.GetValueOrDefault() > 0)
        {
            usuario.IdEmpresa = SucursalStateService.EmpresaId.Value;
        }

        if (usuario.PkidEmpresa <= 0 && usuario.IdEmpresa > 0)
        {
            usuario.PkidEmpresa = usuario.IdEmpresa;
        }
    }

    private sealed class EmpresaUsuarioAsignacion
    {
        public int IdEmpresa { get; set; }
        public string NombreEmpresa { get; set; } = string.Empty;
        public int IdSucursal { get; set; }
        public string NombreSucursal { get; set; } = string.Empty;
        public bool Asignada { get; set; }
        public bool PuedeAsignarse { get; set; }
        public bool Procesando { get; set; }
    }

