    private bool TieneEmpresasParaDepartamento => GetEmpresasDisponiblesParaDepartamento().Any();

    private async Task<ComboLookupResult> LoadDepartamentosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var empresaIds = GetEmpresasDisponiblesParaDepartamento().ToList();
        if (empresaIds.Count == 0)
        {
            return new ComboLookupResult
            {
                Items = Enumerable.Empty<LookupItem>(),
                TotalCount = 0
            };
        }

        var departamentos = new List<DepartamentoResponse>();

        foreach (var empresaId in empresaIds)
        {
            ct.ThrowIfCancellationRequested();

            var response = await departamentoService.GetActionAsync($"empresa/{empresaId}");
            if (response?.Success == true && response.Items != null)
            {
                departamentos.AddRange(response.Items.Where(x =>
                    x.DepartamentoActivo &&
                    x.PkidEmpresa == empresaId));
            }
        }

        var query = departamentos
            .GroupBy(x => x.PkidDepartamento)
            .Select(x => x.First())
            .AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x =>
                (x.DepartamentoNombre ?? string.Empty).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                (x.EmpresaNombre ?? string.Empty).Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        var ordered = query
            .OrderBy(x => x.EmpresaNombre)
            .ThenBy(x => x.DepartamentoNombre)
            .ToList();

        return new ComboLookupResult
        {
            Items = ordered
                .Skip(Math.Max(page - 1, 0) * pageSize)
                .Take(pageSize)
                .Select(departamento => new LookupItem
                {
                    Id = departamento.PkidDepartamento,
                    Text = FormatDepartamentoText(departamento)
                }),
            TotalCount = ordered.Count
        };
    }

