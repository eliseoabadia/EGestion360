@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Requests.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Dommain.DTOs.Responses
@using EG.Common.GenericModel
@using MudBlazor

@inject IGenericCrudService<EmpresaResponse> empresaService
@inject IGenericCrudService<UsuarioResponse> usuarioService
@inject IGenericCrudService<PersonaResponse> personaService
@inject IGenericCrudService<AreaResponse> areaCatalogService
@inject IGenericCrudService<UsuarioAreaResponse> usuarioAreaService
@inject IGenericCrudService<DepartamentoResponse> departamentoService
@inject IGenericCrudService<UsuarioDepartamentoResponse> usuarioDepartamentoService
@inject IGenericCrudService<SucursalResponse> sucursalService
@inject IGenericCrudService<UsuarioSucursalResponse> usuarioSucursalService
@inject SucursalStateService SucursalStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="UsuarioResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos del usuario..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="UsuarioResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4">
            <MudTabPanel Text="Datos" Icon="@Icons.Material.Filled.Person">
        <MudGrid GutterSize="2">
            <MudItem xs="12" md="6">
                <MudSelect Label="Empresa predeterminada"
                           Value="@usuario.IdEmpresa"
                           ValueChanged="OnEmpresaChanged"
                           T="int"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar una empresa predeterminada"
                           For="@(() => usuario.IdEmpresa)">
                    <MudSelectItem T="int" Value="0">Seleccione una empresa predeterminada</MudSelectItem>
                    @foreach (var empresa in listadoEmpresas)
                    {
                        <MudSelectItem T="int" Value="@empresa.PkidEmpresa">@empresa.EmpresaNombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Payroll ID -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.PayrollId"
                              Label="Payroll ID"
                              Variant="Variant.Outlined" />
            </MudItem>

            <!-- Persona (opcional) -->
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">
                    <span>Persona vinculada</span>
                </MudText>
                <PagedAutocomplete Value="@_selectedPersona"
                                   ValueChanged="OnPersonaChanged"
                                   Label="Seleccione una persona"
                                   LoadPage="LoadPersonasPageAsync" />
            </MudItem>

            @if (_selectedPersona != null)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="1" Style="border-radius: 8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Datos de la persona vinculada</MudText>
                        <MudDivider Class="mb-2" />
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Nombre completo</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaNombreCompleto</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Email</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaEmail</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Telefono</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaTelefono</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Clave</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaClave</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">RFC</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaRfc</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="1" Style="border-radius: 8px;">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.subtitle2">Areas asignadas</MudText>
                            <MudChip T="string"
                                     Color="@(_areasPersona.Count > 0 ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @_areasPersona.Count
                            </MudChip>
                        </div>
                        <MudDivider Class="mb-3" />

                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="12" md="8">
                                <PagedAutocomplete Value="@_selectedArea"
                                                   ValueChanged="@((LookupItem? item) => _selectedArea = item)"
                                                   Label="Seleccione un area"
                                                   LoadPage="LoadAreasPageAsync" />
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.AddLocationAlt"
                                           Disabled="@(_selectedArea == null || _savingArea)"
                                           OnClick="AsignarAreaPersonaAsync">
                                    Asignar area
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_loadingAreasPersona)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (!_areasPersona.Any())
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Esta persona no tiene areas asignadas.
                            </MudAlert>
                        }
                        else
                        {
                            <GenericDataGrid TItem="UsuarioAreaResponse" @key="_areasPersona"
                                 Items="@_areasPersona"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="UsuarioAreaResponse" Title="Area" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Area">
                                @cell.Item.UsuarioAreaDescripcion
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="UsuarioAreaResponse" Title="Permisos" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Permisos">
                                <div class="d-flex flex-wrap gap-2">
                                @if (cell.Item.IsAdscrito)
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Adscrito</MudChip>
                                }
                                @if (cell.Item.EsSolicitante)
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Solicitante</MudChip>
                                }
                                @if (cell.Item.EsAutorizador)
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Autorizador</MudChip>
                                }
                                </div>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="UsuarioAreaResponse" Title="" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Acciones" class="text-right">
                                <MudTooltip Text="Retirar area">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                Color="Color.Error"
                                Size="Size.Small"
                                Disabled="@(_savingArea || !cell.Item.PkidPersonaArea.HasValue)"
                                OnClick="@(() => EliminarAreaPersonaAsync(cell.Item))" />
                                </MudTooltip>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
                        }
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12">
                <MudPaper Class="pa-3" Elevation="1" Style="border-radius: 8px;">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2">Departamentos asignados</MudText>
                        <MudChip T="string"
                                 Color="@(_departamentosUsuario.Count > 0 ? Color.Success : Color.Default)"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small">
                            @_departamentosUsuario.Count
                        </MudChip>
                    </div>
                    <MudDivider Class="mb-3" />

                    @if (!Id.HasValue)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            Guarda el usuario para asignarle departamentos.
                        </MudAlert>
                    }
                    else if (!TieneEmpresasParaDepartamento)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            Selecciona la empresa del usuario para cargar sus departamentos.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="12" md="7">
                                <PagedAutocomplete Value="@_selectedDepartamento"
                                                   ValueChanged="@((LookupItem? item) => _selectedDepartamento = item)"
                                                   Label="Seleccione un departamento de sus empresas"
                                                   LoadPage="LoadDepartamentosPageAsync" />
                            </MudItem>
                            <MudItem xs="12" md="2" Class="d-flex align-center">
                                <MudCheckBox @bind-Value="_departamentoEsJefe"
                                             Color="Color.Primary"
                                             Label="Es jefe" />
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.AccountTree"
                                           Disabled="@(_selectedDepartamento == null || _savingDepartamento)"
                                           OnClick="AsignarDepartamentoUsuarioAsync">
                                    Asignar departamento
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_loadingDepartamentosUsuario)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (!_departamentosUsuario.Any())
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Este usuario no tiene departamentos asignados.
                            </MudAlert>
                        }
                        else
                        {
                            <GenericDataGrid TItem="UsuarioDepartamentoResponse" @key="_departamentosUsuario"
                                 Items="@_departamentosUsuario"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="UsuarioDepartamentoResponse" Title="Empresa" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Empresa">
                                @cell.Item.EmpresaNombre
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="UsuarioDepartamentoResponse" Title="Departamento" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Departamento">
                                @cell.Item.DepartamentoNombre
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="UsuarioDepartamentoResponse" Title="Rol" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Rol">
                                @if (cell.Item.EsJefe)
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Jefe</MudChip>
                                }
                                else
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Miembro</MudChip>
                                }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="UsuarioDepartamentoResponse" Title="" Identifier="__local_3" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Acciones" class="text-right">
                                <MudTooltip Text="Retirar departamento">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                Color="Color.Error"
                                Size="Size.Small"
                                Disabled="@_savingDepartamento"
                                OnClick="@(() => EliminarDepartamentoUsuarioAsync(cell.Item))" />
                                </MudTooltip>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
                        }
                    }
                </MudPaper>
            </MudItem>

            <!-- Estado del Usuario -->
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px;">
                    <MudText Class="mb-2" Typo="Typo.subtitle2">Estado del Usuario</MudText>
                    <MudDivider Class="mb-3" />

                    @if (Id.HasValue && usuario.UsuarioActivo == true)
                    {
                        <div class="d-flex align-center">
                            <MudSwitch @bind-Value="usuario.UsuarioActivo"
                                       Color="Color.Error"
                                       ThumbIcon="@Icons.Material.Filled.PowerOff">
                                <MudText>Dar de baja</MudText>
                            </MudSwitch>
                            <MudTooltip Text="Los usuarios inactivos no podrán acceder al sistema">
                                <MudIcon Icon="@Icons.Material.Filled.Info"
                                         Size="Size.Small"
                                         Class="ml-2"
                                         Color="Color.Info" />
                            </MudTooltip>
                        </div>
                    }
                    else if (Id.HasValue && usuario.UsuarioActivo == false)
                    {
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Error"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Inactivo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Usuario dado de baja)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                    else
                    {
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Success"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Activo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Los nuevos usuarios se crean activos)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Empresas login" Icon="@Icons.Material.Filled.Business">
                @if (!Id.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Guarda el usuario para asignarle empresas adicionales.
                    </MudAlert>
                }
                else if (_loadingEmpresasUsuario)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else
                {
                    <GenericDataGrid TItem="EmpresaUsuarioAsignacion" @key="_empresasUsuario"
                                 Items="@_empresasUsuario"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="EmpresaUsuarioAsignacion" Title="Empresa" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Empresa">
                                @cell.Item.NombreEmpresa
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="EmpresaUsuarioAsignacion" Title="Sucursal de acceso" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Sucursal de acceso">
                                @cell.Item.NombreSucursal
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="EmpresaUsuarioAsignacion" Title="Tipo" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Tipo">
                                @if (cell.Item.IdEmpresa == GetEmpresaUsuarioId())
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                Predeterminada
                                </MudChip>
                                }
                                else
                                {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                Adicional
                                </MudChip>
                                }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="EmpresaUsuarioAsignacion" Title="Acceso" Identifier="__local_3" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <div DataLabel="Acceso">
                                <MudSwitch T="bool"
                                Value="@cell.Item.Asignada"
                                ValueChanged="@((bool value) => ToggleEmpresaAsync(cell.Item, value))"
                                Color="Color.Success"
                                Disabled="@(!cell.Item.PuedeAsignarse || cell.Item.Procesando)" />
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
                }
            </MudTabPanel>
        </MudTabs>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    
    private BaseEntityForm<UsuarioResponse> form = null!;
    private UsuarioResponse usuario = new() { UsuarioActivo = true };
    private IList<EmpresaResponse> listadoEmpresas = new List<EmpresaResponse>();
    private IList<SucursalResponse> listadoSucursales = new List<SucursalResponse>();
    private List<EmpresaUsuarioAsignacion> _empresasUsuario = new();
    private bool _loadingEmpresasUsuario;

    private string dialogTitle => Id.HasValue ? "Editar Usuario" : "Nuevo Usuario";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private LookupItem? _selectedPersona;
    private string _personaNombreCompleto = string.Empty;
    private string _personaEmail = string.Empty;
    private string _personaTelefono = string.Empty;
    private string _personaClave = string.Empty;
    private string _personaRfc = string.Empty;
    private LookupItem? _selectedArea;
    private List<UsuarioAreaResponse> _areasPersona = new();
    private bool _loadingAreasPersona;
    private bool _savingArea;
    private LookupItem? _selectedDepartamento;
    private List<UsuarioDepartamentoResponse> _departamentosUsuario = new();
    private bool _loadingDepartamentosUsuario;
    private bool _savingDepartamento;
    private bool _departamentoEsJefe;

    protected override async Task OnInitializedAsync()
    {
        await SucursalStateService.InitializeAsync();
        await CargarSucursales();

        if (Id.HasValue)
        {
            await CargarUsuario();
            await CargarEmpresasUsuario();
        }
        else
        {
            NormalizarEmpresaUsuario();
        }
    }

    private async Task CargarSucursales()
    {
        try
        {
            var response = await empresaService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                listadoEmpresas = response.Items.ToList();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar empresas", Severity.Warning);
            }

            var sucursalesResponse = await sucursalService.GetAllAsync();
            if (sucursalesResponse?.Success == true && sucursalesResponse.Items != null)
            {
                listadoSucursales = sucursalesResponse.Items
                    .Where(x => x.Activo || x.EsActiva)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresas: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private Task OnEmpresaChanged(int empresaId)
    {
        usuario.IdEmpresa = empresaId;
        usuario.PkidEmpresa = empresaId;
        _selectedDepartamento = null;
        return Task.CompletedTask;
    }

    private async Task CargarUsuario()
    {
        try
        {
            var response = await usuarioService.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                usuario = response.Data;
                NormalizarEmpresaUsuario();
                if (usuario.IdPersona.HasValue)
                {
                    _selectedPersona = new LookupItem
                    {
                        Id = usuario.IdPersona.Value,
                        Text = !string.IsNullOrWhiteSpace(usuario.NombreCompletoPersona)
                            ? usuario.NombreCompletoPersona.Trim()
                            : $"{usuario.PersonaNombre} {usuario.PersonaPaterno} {usuario.PersonaMaterno}".Trim()
                    };
                    await CargarDatosPersona(usuario.IdPersona.Value);
                    await CargarAreasPersona(usuario.IdPersona.Value);
                }

                await CargarDepartamentosUsuario();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar usuario", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando usuario: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task CargarDatosPersona(int personaId)
    {
        try
        {
            var response = await personaService.GetByIdAsync(personaId);
            if (response?.Success == true && response.Data != null)
            {
                var p = response.Data;
                _personaNombreCompleto = $"{p.Nombre} {p.Paterno} {p.Materno}".Trim();
                _personaEmail = p.CorreoElectronico ?? string.Empty;
                _personaTelefono = p.TelefonoMovil ?? p.TelefonoParticular ?? string.Empty;
                _personaClave = p.Clave ?? string.Empty;
                _personaRfc = p.Rfc ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("UsuarioDialog")
                .LogWarning(ex, "No se pudieron restaurar los datos de la persona vinculada al usuario.");
            AppSnackbar.Add("No se pudieron recuperar todos los datos de la persona. Revisa el formulario antes de guardar.", Severity.Warning);
        }
    }

    private async Task OnPersonaChanged(LookupItem? item)
    {
        _selectedPersona = item;
        usuario.IdPersona = item?.Id;
        _selectedArea = null;
        if (item != null)
        {
            await CargarDatosPersona(item.Id);
            await CargarAreasPersona(item.Id);
        }
        else
        {
            _personaNombreCompleto = string.Empty;
            _personaEmail = string.Empty;
            _personaTelefono = string.Empty;
            _personaClave = string.Empty;
            _personaRfc = string.Empty;
            _areasPersona.Clear();
        }
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await personaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Select(persona => new LookupItem
            {
                Id = persona.PkidPersona,
                Text = $"{persona.Nombre} {persona.Paterno} {persona.Materno}".Trim()
            }) ?? Enumerable.Empty<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private async Task<ComboLookupResult> LoadAreasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await areaCatalogService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Select(area => new LookupItem
            {
                Id = area.PkidArea,
                Text = FormatAreaText(area)
