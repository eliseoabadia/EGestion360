    private IEnumerable<int> GetEmpresasDisponiblesParaDepartamento()
    {
        var ids = new HashSet<int>();
        var empresaPrincipal = GetEmpresaUsuarioId();

        if (empresaPrincipal > 0)
        {
            ids.Add(empresaPrincipal);
        }

        foreach (var empresa in _empresasUsuario.Where(x => x.Asignada && x.IdEmpresa > 0))
        {
            ids.Add(empresa.IdEmpresa);
        }

        return ids;
    }

    private int GetEmpresaUsuarioId()
    {
        return usuario.IdEmpresa > 0
            ? usuario.IdEmpresa
            : usuario.PkidEmpresa;
    }

    private static string FormatDepartamentoText(DepartamentoResponse departamento)
    {
        var nombre = departamento.DepartamentoNombre ?? string.Empty;
        var empresa = departamento.EmpresaNombre ?? string.Empty;

        return string.IsNullOrWhiteSpace(empresa)
            ? nombre
            : $"{empresa} - {nombre}".Trim();
