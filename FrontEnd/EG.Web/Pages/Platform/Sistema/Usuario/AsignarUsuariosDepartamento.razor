@using EG.Domain.DTOs.Responses.General
@using EG.Dommain.DTOs.Responses
@using MudBlazor

@inject NavigationManager NavigationManager
@inject IGenericCrudService<UsuarioResponse> _service
@inject IGenericCrudService<UsuarioSucursalResponse> _serviceUsuarioSucursal
@inject IGenericCrudService<SucursalResponse> _serviceSucursal
@inject ISnackbar MudSnackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="assignment-page">
    @if (_loading)
    {
        <div class="d-flex justify-center ma-16">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudText Typo="Typo.h5" Class="assignment-title">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" />
            Asignar Sucursales - @_usuario?.NombreCompleto
        </MudText>

        @if (_processing)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }

        <MudDropContainer T="SucursalItem"
                          Items="_items"
                          ItemsSelector="@((item, dropzone) => item.Zona == dropzone)"
                          ItemDropped="@((dropInfo) => OnItemDropped(dropInfo))">
            <ChildContent>
                <MudGrid>
                    <!-- Zona No Asignadas -->
                    <MudItem xs="12" md="6">
                        <MudPaper Class="assignment-column" Elevation="2">
                            <MudText Typo="Typo.h6" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
                                Disponibles (@ContarItemsEnZona("no-asignadas"))
                            </MudText>

                            <div class="assignment-list">
                                <MudDropZone T="SucursalItem"
                                             Identifier="no-asignadas"
                                             Class="dropzone"
                                             Style="min-height: 100%; height: auto;">
                                </MudDropZone>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Zona Asignadas -->
                    <MudItem xs="12" md="6">
                        <MudPaper Class="assignment-column" Elevation="2">
                            <MudText Typo="Typo.h6" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="mr-2" />
                                Asignadas (@ContarItemsEnZona("asignadas"))
                            </MudText>

                            <div class="assignment-list">
                                <MudDropZone T="SucursalItem"
                                             Identifier="asignadas"
                                             Class="dropzone"
                                             Style="min-height: 100%; height: auto;">
                                </MudDropZone>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </ChildContent>
            <ItemRenderer>
                <MudPaper Class="pa-2 mb-2 item-card" Elevation="1" Style="cursor: grab;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">
                            @ObtenerIniciales(context.Nombre)
                        </MudAvatar>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">
                                <strong>@context.Nombre</strong>
                            </MudText>
                            @if (!string.IsNullOrEmpty(context.Codigo))
                            {
                                <MudText Typo="Typo.caption" Class="text-secondary">
                                    @context.Codigo
                                </MudText>
                            }
                        </MudStack>
                        </MudStack>
                        <MudTooltip Text="@(context.Zona == "asignadas" ? "Quitar sucursal" : "Asignar sucursal")">
                            <MudIconButton Icon="@(context.Zona == "asignadas" ? Icons.Material.Filled.RemoveCircleOutline : Icons.Material.Filled.AddCircleOutline)"
                                           Color="@(context.Zona == "asignadas" ? Color.Error : Color.Primary)"
                                           Size="Size.Small"
                                           Disabled="@_processing"
                                           OnClick="@(() => CambiarAsignacionAsync(context))" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>

        <!-- Botones -->
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="assignment-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Volver">
                Volver
            </MudButton>
        </MudStack>
    }
</MudContainer>

    @code {
    [Parameter] public int UsuarioId { get; set; }
    [Parameter] public string ReturnUrl { get; set; } = "/configuracion/sistema/usuarios";

    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Inject]
    private AuthenticationProviderJWT AuthProvider { get; set; } = null!;

    private bool _loading = true;
    private bool _processing;
    private UsuarioResponse? _usuario;
    private List<SucursalItem> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            // Verificar permiso básico
            if (!AuthProvider.HasPermission("Sistema", "Usuario", "view"))
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            await CargarDatos();
        }
        catch (Exception ex)
        {
            MudSnackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CargarDatos()
    {
        // Cargar usuario
        var usuarioResponse = await _service.GetByIdAsync(UsuarioId);
        if (usuarioResponse?.Success == true)
        {
            _usuario = usuarioResponse.Data;
        }

        // Cargar todas las sucursales
        var sucursalesResponse = await _serviceSucursal.GetAllAsync();
        var todasSucursales = sucursalesResponse?.Success == true
            ? sucursalesResponse.Items?.ToList() ?? new()
            : new();

        // Cargar asignaciones
        var asignacionesResponse = await _serviceUsuarioSucursal.GetActionAsync($"usuario/{UsuarioId}");
        var sucursalesAsignadas = asignacionesResponse?.Success == true
            ? asignacionesResponse.Items?
                .Where(x => x.AsignacionActiva)
                .Select(x => x.IdSucursal)
                .ToHashSet() ?? new()
            : new();

        // Crear items
        _items = todasSucursales.Select(s => new SucursalItem
        {
            Id = s.PkidSucursal,
            EmpresaId = s.FkidEmpresaSis,
            Nombre = s.Nombre ?? "",
            Codigo = s.CodigoSucursal ?? "",
            Zona = sucursalesAsignadas.Contains(s.PkidSucursal) ? "asignadas" : "no-asignadas"
        }).ToList();
    }

    private async Task OnItemDropped(MudItemDropInfo<SucursalItem> dropInfo)
    {
        var item = dropInfo.Item;
        var nuevaZona = dropInfo.DropzoneIdentifier;

        if (_processing || item.Zona == nuevaZona) return;

        await GuardarAsignacionAsync(item, nuevaZona);
    }

    private Task CambiarAsignacionAsync(SucursalItem item)
    {
        var nuevaZona = item.Zona == "asignadas" ? "no-asignadas" : "asignadas";
        return GuardarAsignacionAsync(item, nuevaZona);
    }

    private async Task GuardarAsignacionAsync(SucursalItem item, string nuevaZona)
    {
        if (_processing || item.Zona == nuevaZona) return;

        try
        {
            _processing = true;

            if (nuevaZona == "asignadas")
            {
                var response = await _serviceUsuarioSucursal.CreateAsync(new UsuarioSucursalResponse
                {
                    PkIdUsuario = UsuarioId,
                    AspNetUserId = UsuarioId.ToString(),
                    IdEmpresa = item.EmpresaId,
                    PkidEmpresa = item.EmpresaId,
                    IdSucursal = item.Id,
                    PuedeAcceder = true,
                    PuedeOperar = true,
                    AsignacionActiva = true
                });

                EnsureSuccess(response, "No fue posible asignar la sucursal.");
                MudSnackbar.Add("Sucursal asignada correctamente", Severity.Success);
            }
            else
            {
                var response = await _serviceUsuarioSucursal.DeleteActionAsync($"{UsuarioId}/{item.Id}");
                EnsureSuccess(response, "No fue posible quitar la sucursal.");
                MudSnackbar.Add("Sucursal retirada correctamente", Severity.Info);
            }

            // Actualizar zona del item
            item.Zona = nuevaZona;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MudSnackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private static void EnsureSuccess(EG.Web.Models.ApiResponse<UsuarioSucursalResponse>? response, string fallbackMessage)
    {
        if (response?.Success != true)
            throw new InvalidOperationException(response?.Message ?? fallbackMessage);
    }

    private int ContarItemsEnZona(string zona) => _items.Count(x => x.Zona == zona);

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrEmpty(nombre)) return "??";
        var palabras = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (palabras.Length >= 2)
            return $"{palabras[0][0]}{palabras[1][0]}".ToUpper();
        return nombre.Length >= 2 ? nombre.Substring(0, 2).ToUpper() : nombre[0].ToString().ToUpper();
    }

    private void Volver()
    {
        if (MudDialog is not null)
        {
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        NavigationManager.NavigateTo(ReturnUrl, replace: true);
    }

    // Clase para los items del drag & drop
    public class SucursalItem
    {
        public int Id { get; set; }
        public int EmpresaId { get; set; }
        public string Nombre { get; set; } = "";
        public string Codigo { get; set; } = "";
        public string Zona { get; set; } = "";
    }
}
