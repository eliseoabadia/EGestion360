    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        try
        {
            _saving = true;
            var request = new SaveAccessRoleRequest
            {
                Id = _selectedRoleId,
                Name = _roleName,
                Code = _roleCode,
                AssignedUserIds = _userItems.Where(x => x.Zone == AssignedZone).Select(x => x.PkIdUsuario).ToList(),
                ReplaceClaims = _claims.Count > 0,
                Claims = _claims
                    .Where(x => x.HasAnyAction && !string.IsNullOrWhiteSpace(x.Group) && !string.IsNullOrWhiteSpace(x.SubGroup))
                    .Select(x => new SaveAccessClaimRequest
                    {
                        Id = x.Id,
                        Group = x.Group,
                        SubGroup = x.SubGroup,
                        Name = x.DisplayName,
                        Code = x.SubGroup,
                        Description = x.Route,
                        ReferenceId = x.ReferenceId,
                        Values = x.SelectedActions.OrderBy(v => v).ToList()
                    })
                    .ToList()
            };

            var response = await AccessService.SaveRoleAsync(request);
            if (response?.Success != true || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "No se pudo guardar la configuracion.", Severity.Error);
                return;
            }

            Snackbar.Add(response.Message, Severity.Success);
            await LoadSnapshotAsync();
            await SelectRoleAsync(response.Data.Role.Id, forceReload: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SynchronizeAsync()
    {
        try
        {
            _saving = true;
            var response = await AccessService.SynchronizeMenuRolesAsync();
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message, Severity.Success);
                await LoadSnapshotAsync();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No se pudo sincronizar MenuRole.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

