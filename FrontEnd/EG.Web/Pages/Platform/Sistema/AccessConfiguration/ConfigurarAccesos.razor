    private async Task OnAccessUserLookupChanged(LookupItem? item)
    {
        if (item == null)
        {
            ClearAccessUserSelection();
            return;
        }

        var user = _snapshot.Users.FirstOrDefault(x => x.PkIdUsuario == item.Id);
        if (user == null)
        {
            ClearAccessUserSelection();
            return;
        }

        try
        {
            _selectedAccessUserLookup = ToAccessUserLookupItem(user);
            _selectedAccessUserDetail = null;
            _selectedUserRoleIds.Clear();
            _userRoleDirty = false;

            var response = await AccessService.GetUserRoleDetailAsync(user.PkIdUsuario);
            if (response?.Success != true || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "No se pudieron cargar los roles del usuario.", Severity.Error);
                return;
            }

            _selectedAccessUserDetail = response.Data;
            foreach (var roleId in response.Data.AssignedRoleIds.Where(x => !string.IsNullOrWhiteSpace(x)))
            {
                _selectedUserRoleIds.Add(roleId);
            }

            _selectedAccessUserLookup = ToAccessUserLookupItem(response.Data.User);
            _userRoleDirty = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar roles del usuario: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
