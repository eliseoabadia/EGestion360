    private async Task<ComboLookupResult> LoadRolesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var items = _snapshot.Roles
            .Where(role => MatchesRoleFilter(role, filter))
            .Select(ToRoleLookupItem);

        return await Task.FromResult(ToPagedComboResult(items, page, pageSize));
    }

    private Task OnUserLookupChanged(LookupItem? item)
    {
        if (item == null)
        {
            ClearUserAndClaims();
            return Task.CompletedTask;
        }

        var user = _userItems.FirstOrDefault(x => x.PkIdUsuario == item.Id);
        if (user != null)
        {
            if (user.Zone != AssignedZone)
            {
                user.Zone = AssignedZone;
                _dirty = true;
            }

            SelectUserContext(user);
        }

        return Task.CompletedTask;
    }

    private async Task<ComboLookupResult> LoadUsersPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var items = _userItems
            .Where(user => MatchesUserFilter(user, filter))
            .OrderBy(user => user.DisplayName)
            .Select(user => new LookupItem
            {
                Id = user.PkIdUsuario,
                Text = UserLookupText(user)
            });

        return await Task.FromResult(ToPagedComboResult(items, page, pageSize));
    }

