@page "/configuracion/sistema/Configurar_Accesos"
@using EG.Common.GenericModel
@using EG.Common.Enums
@using EG.Domain.Platform.DTOs.Requests.AccessConfiguration
@using EG.Domain.Platform.DTOs.Responses.AccessConfiguration
@using EG.Web.Auth
@using EG.Web.Contracts.Configuration
@using EG.Web.Models
@using MudBlazor

@inject IAccessConfigurationService AccessService
@inject AuthenticationProviderJWT AuthProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="access-page">
    @if (_loading)
    {
        <div class="access-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">Cargando matriz de accesos...</MudText>
        </div>
    }
    else if (!_hasAccess)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">
            No tienes permisos para configurar accesos.
        </MudAlert>
    }
    else
    {
        <section class="access-hero">
            <div>
                <MudText Typo="Typo.h4" Class="access-title">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                    Configurar Accesos
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Asigna roles por usuario y controla menus/permisos desde una matriz por rol.
                </MudText>
            </div>
            <MudSpacer />
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                    @_snapshot.Roles.Count roles
                </MudChip>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                    @_snapshot.Users.Count usuarios activos
                </MudChip>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                    @_snapshot.MenuRoleCount menu-role
                </MudChip>
                <MudTooltip Text="Sincronizar SIS.MenuRole con claims view-menu">
                    <MudIconButton Icon="@Icons.Material.Filled.Sync"
                                   Color="Color.Primary"
                                   Disabled="@_saving"
                                   OnClick="SynchronizeAsync" />
                </MudTooltip>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(!CanSave)"
                           OnClick="SaveAsync">
                    @SaveButtonText
                </MudButton>
            </MudStack>
        </section>

        <MudTabs Elevation="0"
                 Rounded="false"
                 ActivePanelIndex="@_activePanelIndex"
                 ActivePanelIndexChanged="OnActivePanelChanged"
                 Class="access-tabs">
            <MudTabPanel Text="Usuarios y roles" Icon="@Icons.Material.Filled.ManageAccounts">
                <div class="tab-surface">
                    <div class="tab-grid users-tab">
                        <section class="access-panel user-command-panel">
                            <div class="panel-toolbar">
                                <div>
                                    <MudText Typo="Typo.subtitle1">Usuario activo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Selecciona un usuario y arma su paquete de roles</MudText>
                                </div>
                            </div>

                            <PagedAutocomplete Value="@_selectedAccessUserLookup"
                                               ValueChanged="OnAccessUserLookupChanged"
                                               Label="Usuario"
                                               Clearable="true"
                                               Disabled="@_saving"
                                               PageSize="25"
                                               LoadingText="Buscando usuarios..."
                                               NoItemsText="No hay usuarios activos"
                                               LoadPage="LoadAccessUsersPageAsync" />

                            @if (_selectedAccessUserDetail == null)
                            {
                                <div class="empty-state user-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Info" />
                                    <MudText Typo="Typo.body2">Selecciona un usuario para ver sus roles.</MudText>
                                </div>
                            }
                            else
                            {
                                <div class="user-profile-card">
                                    <MudAvatar Size="Size.Large" Color="Color.Primary">@Initials(_selectedAccessUserDetail.User.DisplayName)</MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle1">@_selectedAccessUserDetail.User.DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AccessUserCaption(_selectedAccessUserDetail.User)</MudText>
                                    </div>
                                </div>

                                <div class="metric-row user-metrics">
                                    <div>
                                        <strong>@_selectedUserRoleIds.Count</strong>
                                        <span>seleccionados</span>
                                    </div>
                                    <div>
                                        <strong>@_selectedAccessUserDetail.User.RoleCount</strong>
                                        <span>actuales</span>
                                    </div>
                                    <div>
                                        <strong>@_snapshot.Roles.Count</strong>
                                        <span>disponibles</span>
                                    </div>
                                </div>

                                <div class="action-strip">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Backspace"
                                               Disabled="@(_saving || _selectedUserRoleIds.Count == 0)"
                                               OnClick="ClearSelectedUserRoles">
                                        Limpiar roles
                                    </MudButton>
                                    <MudChip T="string"
                                             Color="@(_userRoleDirty ? Color.Warning : Color.Success)"
                                             Variant="Variant.Outlined"
                                             Size="Size.Small">
                                        @(_userRoleDirty ? "Cambios pendientes" : "Sin cambios")
                                    </MudChip>
                                </div>
                            }
                        </section>

                        <section class="access-panel role-picker-panel">
                            <div class="panel-toolbar">
                                <div>
                                    <MudText Typo="Typo.subtitle1">Roles disponibles</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Activa o desactiva roles completos para el usuario</MudText>
                                </div>
                                <MudSpacer />
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                    @_selectedUserRoleIds.Count seleccionados
                                </MudChip>
                            </div>

                            <MudTextField T="string"
                                          Value="@_userRoleFilter"
                                          ValueChanged="OnUserRoleFilterChanged"
                                          Placeholder="Buscar rol, codigo o id"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Disabled="@(_selectedAccessUserDetail == null || _saving)" />

                            @if (_selectedAccessUserDetail == null)
                            {
                                <div class="empty-state role-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Info" />
                                    <MudText Typo="Typo.body2">Primero elige un usuario.</MudText>
                                </div>
                            }
                            else if (!FilteredUserRoles.Any())
                            {
                                <div class="empty-state role-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Info" />
                                    <MudText Typo="Typo.body2">No hay roles con ese filtro.</MudText>
                                </div>
                            }
                            else
                            {
                                <div class="role-picker-list">
                                    @foreach (var role in FilteredUserRoles)
                                    {
                                        var selected = IsUserRoleSelected(role.Id);
                                        <div class="@RoleOptionClass(role)" @onclick="@(() => ToggleUserRole(role.Id, !selected))">
                                            <span @onclick:stopPropagation="true">
                                                <MudCheckBox T="bool"
                                                             Value="@selected"
                                                             ValueChanged="@((bool value) => ToggleUserRole(role.Id, value))"
                                                             Dense="true"
                                                             Color="Color.Primary"
                                                             Disabled="@_saving" />
                                            </span>
                                            <div class="role-option-main">
                                                <MudText Typo="Typo.body2" Class="claim-title">@role.Name</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@RoleSecondaryText(role)</MudText>
                                            </div>
                                            <MudSpacer />
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                                @(string.IsNullOrWhiteSpace(role.Code) ? "sin codigo" : role.Code)
                                            </MudChip>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Roles y menus" Icon="@Icons.Material.Filled.AccountTree">
                <div class="tab-surface">
                    <MudGrid Spacing="2" Class="access-grid">
                        <MudItem xs="12" lg="3" xl="3">
                            <section class="access-panel access-left-stack">
                                <div class="panel-toolbar">
                                    <div>
                                        <MudText Typo="Typo.subtitle1">Rol administrador</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Selecciona un rol para configurar menus y claims</MudText>
                                    </div>
                                    <MudSpacer />
                                    <MudTooltip Text="Nuevo rol">
                                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                       Color="Color.Primary"
                                                       Disabled="@(!_canCreate || _saving)"
                                                       OnClick="NewRoleAsync" />
                                    </MudTooltip>
                                </div>

                                <MudSelect T="string"
                                           Value="@_selectedAccessProfilePrefix"
                                           ValueChanged="OnAccessProfileChanged"
                                           Label="Perfil general"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Disabled="@_saving"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.Category">
                                    <MudSelectItem T="string" Value="@string.Empty">Todos los perfiles</MudSelectItem>
                                    @foreach (var profile in _accessProfiles)
                                    {
                                        <MudSelectItem T="string" Value="@profile.Prefix">@profile.Label</MudSelectItem>
                                    }
                                </MudSelect>

                                <PagedAutocomplete Value="@_selectedRoleLookup"
                                                   ValueChanged="OnRoleLookupChanged"
                                                   Label="@RoleLookupLabel"
                                                   Clearable="true"
                                                   PageSize="30"
                                                   LoadingText="Cargando roles..."
                                                   NoItemsText="No hay roles"
                                                   LoadPage="LoadRolesPageAsync" />

                                <MudDivider Class="my-3" />

                                <MudText Typo="Typo.subtitle2">Rol seleccionado</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(_isNewRole ? "Alta rapida de rol" : string.IsNullOrWhiteSpace(_selectedRoleId) ? "Sin rol seleccionado" : _selectedRoleId)
                                </MudText>

                                <MudTextField T="string"
                                              Value="@_roleName"
                                              ValueChanged="OnRoleNameChanged"
                                              Label="Nombre del rol"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Disabled="@(!HasRoleContext || _saving)" />

                                <MudTextField T="string"
                                              Value="@_roleCode"
                                              ValueChanged="OnRoleCodeChanged"
                                              Label="Codigo"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Disabled="@(!HasRoleContext || _saving)" />

                                <div class="metric-row role-metrics">
                                    <div>
                                        <strong>@EnabledClaimCount</strong>
                                        <span>claims</span>
                                    </div>
                                    <div>
                                        <strong>@EnabledMenuCount</strong>
                                        <span>menus</span>
                                    </div>
                                </div>

                                <MudDivider Class="my-3" />

                                <MudText Typo="Typo.subtitle2">Menu raiz</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Selecciona el menu que recibira permisos</MudText>

                                <div class="root-menu-row">
                                    <PagedAutocomplete Value="@_selectedRootMenuLookup"
                                                       ValueChanged="OnRootMenuLookupChanged"
                                                       Label="Menu raiz"
                                                       Clearable="true"
                                                       Disabled="@(!HasRoleContext || _loadingDetail || _saving)"
                                                       PageSize="20"
                                                       LoadingText="Cargando menus..."
                                                       NoItemsText="No hay menus raiz"
                                                       LoadPage="LoadRootMenusPageAsync" />
                                </div>
                            </section>
                        </MudItem>

                        <MudItem xs="12" lg="9" xl="9">
                            <section class="access-panel claims-panel">
                                <div class="panel-toolbar">
                                    <div>
                                        <MudText Typo="Typo.subtitle1">Claims del menu</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@ClaimsPanelSubtitle</MudText>
                                    </div>
                                    <MudSpacer />
                                    @if (SelectedAccessProfile != null)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                            @SelectedAccessProfile.Label
                                        </MudChip>
                                    }
                                    <MudTooltip Text="Activar vista y menu en tabla">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck"
                                                       Color="Color.Success"
                                                       Disabled="@(_saving || !HasMenuContext)"
                                                       OnClick="EnableVisibleMenus" />
                                    </MudTooltip>
                                    <MudTooltip Text="Limpiar acciones de tabla">
                                        <MudIconButton Icon="@Icons.Material.Filled.CleaningServices"
                                                       Color="Color.Warning"
                                                       Disabled="@(_saving || !HasMenuContext)"
                                                       OnClick="ClearVisibleClaims" />
                                    </MudTooltip>
                                </div>

                                @if (!HasRoleContext)
                                {
                                    <div class="empty-state claim-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Info" />
                                        <MudText Typo="Typo.body2">Selecciona un rol para continuar.</MudText>
                                    </div>
                                }
                                else if (_loadingDetail)
                                {
                                    <div class="empty-state claim-empty">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
                                        <MudText Typo="Typo.body2">Cargando datos del rol...</MudText>
                                    </div>
                                }
                                else if (!HasClaimContext)
                                {
                                    <div class="empty-state claim-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Info" />
                                        <MudText Typo="Typo.body2">Este rol no tiene menus disponibles para configurar.</MudText>
                                    </div>
                                }
                                else
                                {
                                    @if (!HasMenuContext)
                                    {
                                        <div class="empty-state claim-empty small">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Info" />
                                            <MudText Typo="Typo.body2">Selecciona un menu raiz para ver permisos.</MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <GenericDataGrid TItem="ClaimEditorItem"
                                                      @ref="_claimsTable"
                                                      Title="@ClaimsTableTitle"
                                                      SearchPlaceholder="Buscar menu, ruta o subgrupo"
                                                      PageSize="10"
                                                      PageSizeOptions="@(new[] { 10, 20, 50 })"
                                                      TableHeight="clamp(320px, calc(100dvh - 500px), 620px)"
                                                      ShowExportButton="false"
                                                      ServerDataFunc="LoadClaimsTableAsync"
                                                      SearchString="@_claimFilter"
                                                      SearchStringChanged="OnClaimsSearchChanged"
                                                      OnSearch="ReloadClaimsTableAsync">
                                            <Columns>
                                                <TemplateColumn Resizable="true" T="ClaimEditorItem" Title="Menú" Identifier="DisplayName"><CellTemplate><MudText Typo="Typo.body2" Class="claim-title">@context.Item.DisplayName</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.SubGroup</MudText></CellTemplate></TemplateColumn>
                                                <PropertyColumn T="ClaimEditorItem" TProperty="string" Property="x => x.Route" Title="Ruta" Identifier="Route" />
                                                @foreach (var action in _snapshot.PermissionActions)
                                                {
                                                    <TemplateColumn Resizable="true" T="ClaimEditorItem" Title="@ActionLabel(action)" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudCheckBox T="bool" Value="@context.Item.HasAction(action)" ValueChanged="@((bool value) => ToggleAction(context.Item, action, value))" Dense="true" Color="@ActionColor(action)" Disabled="@_saving" /></CellTemplate></TemplateColumn>
                                                }
                                            </Columns>
                                        </GenericDataGrid>
                                    }
                                }
                            </section>
                        </MudItem>
                    </MudGrid>
                </div>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<style>
    .access-page {
        display: flex;
        flex-direction: column;
        height: auto;
        min-height: 100%;
        min-width: 0;
        padding: 12px;
        overflow: visible;
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--mud-palette-primary) 9%, transparent), transparent 38%),
            linear-gradient(45deg, color-mix(in srgb, var(--mud-palette-success) 7%, transparent), transparent 42%),
            var(--mud-palette-background);
    }

    .access-loading {
        min-height: 70vh;
        display: grid;
        place-items: center;
        align-content: center;
        gap: 14px;
    }

    .access-hero,
    .access-panel {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 96%, white);
        box-shadow: var(--mud-elevation-1);
    }

    .access-hero {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 12px;
        flex: 0 0 auto;
    }

    .access-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
    }

    .access-hero > .mud-stack-row {
        flex-wrap: wrap;
        justify-content: flex-end;
        min-width: 0;
    }

    .access-grid {
        align-items: stretch;
        height: auto;
        min-height: 0;
    }

    .access-tabs {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 98%, white);
        box-shadow: var(--mud-elevation-1);
        display: flex;
        flex: 0 0 auto;
        flex-direction: column;
        min-height: 0;
        overflow: visible;
    }

    .access-tabs > .mud-tabs-toolbar {
        flex: 0 0 auto;
    }

    .access-tabs > .mud-tabs-panels {
        flex: 1 1 auto;
        min-height: 0;
        overflow: visible;
    }

    .access-tabs .mud-tabs-panel {
        height: auto;
        min-height: 0;
        overflow: visible;
    }

    .tab-surface {
        height: auto;
        min-height: 0;
        overflow: visible;
        padding: 12px;
        background: color-mix(in srgb, var(--mud-palette-primary) 3%, var(--mud-palette-background));
    }

    .tab-grid {
        display: grid;
        gap: 12px;
        align-items: stretch;
        min-height: 0;
    }

    .tab-grid.users-tab {
        grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
        height: auto;
    }

    .access-panel {
        padding: 12px;
        margin-bottom: 0;
        min-height: 0;
    }

    .access-left-stack {
        height: auto;
        min-height: 0;
    }

    .panel-toolbar,
    .drop-title,
    .claim-head,
    .user-card,
    .user-profile-card,
    .role-option,
    .action-strip {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .panel-toolbar {
        margin-bottom: 10px;
    }

    .selected-role-summary {
        display: flex;
        gap: 8px;
        align-items: center;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        margin-top: 10px;
        padding: 10px;
        background: color-mix(in srgb, var(--mud-palette-primary) 5%, var(--mud-palette-surface));
    }

    .selected-role-summary > div {
        min-width: 0;
        overflow: hidden;
    }

    .metric-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 10px;
    }

    .role-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric-row div {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px;
        background: color-mix(in srgb, var(--mud-palette-info) 5%, var(--mud-palette-surface));
    }

    .metric-row strong,
    .metric-row span {
        display: block;
    }

    .metric-row strong {
        font-size: 1.25rem;
        line-height: 1;
    }

    .metric-row span {
        color: var(--mud-palette-text-secondary);
        font-size: .75rem;
    }

    .user-command-panel,
    .role-picker-panel {
        height: auto;
        min-height: 0;
    }

    .role-picker-panel {
        display: flex;
        flex-direction: column;
        overflow: visible;
    }

    .user-profile-card {
        margin-top: 12px;
        padding: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-primary) 7%, var(--mud-palette-surface));
    }

    .user-profile-card > div:last-child,
    .role-option-main {
        min-width: 0;
        overflow: hidden;
    }

    .user-metrics {
        margin-top: 12px;
    }

    .action-strip {
        flex-wrap: wrap;
        justify-content: space-between;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .role-picker-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 8px;
        align-content: start;
        flex: 1 1 auto;
        margin-top: 10px;
        min-height: 0;
        max-height: none;
        overflow-y: auto;
        padding: 0 6px 10px 0;
        scrollbar-gutter: stable;
    }

    @@media (max-width: 1400px) {
        .tab-grid.users-tab {
            grid-template-columns: 1fr;
        }

        .role-picker-list {
            max-height: 420px;
        }

        .user-empty,
        .role-empty {
            min-height: 180px;
        }
    }

    .role-option {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        min-height: 58px;
        padding: 9px 10px;
        background: var(--mud-palette-surface);
        cursor: pointer;
        transition: border-color .16s ease, background-color .16s ease, transform .16s ease;
    }

    .role-option .mud-chip {
        flex: 0 0 auto;
    }

    .role-option-main .mud-typography {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .role-option:hover {
        border-color: var(--mud-palette-primary);
        transform: translateY(-1px);
    }

    .role-option.active {
        border-color: var(--mud-palette-primary);
        background: color-mix(in srgb, var(--mud-palette-primary) 10%, var(--mud-palette-surface));
    }

    .user-empty,
    .role-empty {
        min-height: 360px;
    }

    .users-panel,
    .claims-panel {
        height: auto;
        min-height: 0;
    }

    .claims-panel {
        overflow: visible;
    }

    .assigned-users-shell {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        overflow: hidden;
        background: var(--mud-palette-surface);
        margin-top: 10px;
    }

    .drop-title {
        padding: 8px 10px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        font-weight: 700;
    }

    .assigned-users-list {
        min-height: 386px;
        max-height: 386px;
        overflow-y: auto;
        padding: 8px;
        background: color-mix(in srgb, var(--mud-palette-primary) 3%, var(--mud-palette-surface));
    }

    .assigned-users-shell.compact {
        margin-top: 10px;
    }

    .assigned-users-list.compact {
        min-height: 176px;
        max-height: 268px;
    }

    .user-card {
