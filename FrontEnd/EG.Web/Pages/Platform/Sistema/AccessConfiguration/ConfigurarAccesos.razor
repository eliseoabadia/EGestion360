    private void BuildClaims(IEnumerable<AccessClaimResponse> roleClaims, IEnumerable<AccessMenuSummaryResponse> menus)
    {
        var roleClaimList = roleClaims.ToList();
        var existing = roleClaimList
            .GroupBy(x => NormalizeLookupKey(x.SubGroup), StringComparer.OrdinalIgnoreCase)
            .Where(x => !string.IsNullOrWhiteSpace(x.Key))
            .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);

        _claims.Clear();
        var menuList = menus.ToList();
        var menusById = menuList.ToDictionary(x => x.PkIdMenu);
        var existingMenuSubGroups = menuList
            .Select(x => x.LegacyName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var matchedClaimIds = new HashSet<int>();

        foreach (var menu in menuList.Where(x => !string.IsNullOrWhiteSpace(x.LegacyName)).OrderBy(x => x.ParentMenuId).ThenBy(x => x.Order).ThenBy(x => x.Name))
        {
            var claim = FindClaimForMenu(menu, roleClaimList, existing);
            if (claim != null)
            {
                matchedClaimIds.Add(claim.Id);
            }

            _claims.Add(new ClaimEditorItem
            {
                Id = claim?.Id ?? 0,
                Group = string.IsNullOrWhiteSpace(claim?.Group) ? InferGroup(menu) : claim!.Group,
                SubGroup = menu.LegacyName,
                DisplayName = menu.Name,
                Route = menu.Route ?? string.Empty,
                Icon = ResolveIcon(menu.Icon),
                ReferenceId = menu.PkIdMenu,
                RootMenuId = ResolveRootMenuId(menu, menusById),
                MenuOrder = menu.Order ?? 0,
                SelectedActions = BuildSelectedActions(claim)
            });
        }

        foreach (var claim in roleClaimList.Where(x => !matchedClaimIds.Contains(x.Id) && !existingMenuSubGroups.Contains(x.SubGroup)))
        {
            _claims.Add(new ClaimEditorItem
            {
                Id = claim.Id,
                Group = claim.Group,
                SubGroup = claim.SubGroup,
                DisplayName = string.IsNullOrWhiteSpace(claim.Name) ? claim.SubGroup : claim.Name,
                Route = claim.Description ?? string.Empty,
                Icon = Icons.Material.Filled.Key,
                ReferenceId = claim.ReferenceId,
                RootMenuId = claim.ReferenceId,
                SelectedActions = BuildSelectedActions(claim),
                ShowAdvanced = true
            });
        }
    }

