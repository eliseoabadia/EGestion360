    private static bool MatchesRoleFilter(AccessRoleSummaryResponse role, string? filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        return role.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || role.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || (role.Code?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);
    }

    private static bool MatchesAccessUserFilter(AccessUserSummaryResponse user, string? filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        return user.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || (user.Email?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)
               || (user.PayrollId?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)
               || (user.AccessNumber?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);
    }

    private bool MatchesUserRoleFilter(AccessRoleSummaryResponse role)
    {
        if (string.IsNullOrWhiteSpace(_userRoleFilter))
        {
            return true;
        }

        return role.Name.Contains(_userRoleFilter, StringComparison.OrdinalIgnoreCase)
               || role.Id.Contains(_userRoleFilter, StringComparison.OrdinalIgnoreCase)
               || (role.Code?.Contains(_userRoleFilter, StringComparison.OrdinalIgnoreCase) == true);
    }

    private bool MatchesClaimFilter(ClaimEditorItem item)
    {
        if (string.IsNullOrWhiteSpace(_claimFilter))
        {
            return true;
        }

        return item.Group.Contains(_claimFilter, StringComparison.OrdinalIgnoreCase)
               || item.SubGroup.Contains(_claimFilter, StringComparison.OrdinalIgnoreCase)
               || item.DisplayName.Contains(_claimFilter, StringComparison.OrdinalIgnoreCase)
               || item.Route.Contains(_claimFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSelectedAccessProfileRole(AccessRoleSummaryResponse role)
    {
        var profile = SelectedAccessProfile;
        if (profile == null)
        {
            return true;
        }

        return StartsWithProfilePrefix(role.Code, profile)
               || StartsWithProfilePrefix(role.Id, profile)
               || ContainsProfileKeyword(role.Name, profile)
               || ContainsProfileKeyword(role.Code, profile);
    }

    private bool MatchesSelectedAccessProfileMenu(AccessMenuSummaryResponse menu)
    {
        var profile = SelectedAccessProfile;
        if (profile == null)
        {
            return true;
        }

        return ContainsProfileKeyword(menu.Name, profile)
               || ContainsProfileKeyword(menu.LegacyName, profile)
               || ContainsProfileKeyword(menu.Route, profile);
    }

    private bool MatchesSelectedAccessProfileClaim(ClaimEditorItem item)
    {
        var profile = SelectedAccessProfile;
        if (profile == null)
        {
            return true;
        }

        return ContainsProfileKeyword(item.Group, profile)
               || ContainsProfileKeyword(item.SubGroup, profile)
               || ContainsProfileKeyword(item.DisplayName, profile)
               || ContainsProfileKeyword(item.Route, profile);
    }

    private static bool ContainsProfileKeyword(string? value, AccessProfileOption profile) =>
        !string.IsNullOrWhiteSpace(value)
        && (StartsWithProfilePrefix(value, profile)
            || profile.Keywords.Any(keyword => value.Contains(keyword, StringComparison.OrdinalIgnoreCase)));

    private static bool StartsWithProfilePrefix(string? value, AccessProfileOption profile) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Trim().StartsWith(profile.Prefix, StringComparison.OrdinalIgnoreCase);

    private bool MatchesSelectedRootMenu(ClaimEditorItem item) =>
        !_selectedRootMenuId.HasValue || item.RootMenuId == _selectedRootMenuId.Value;

    private static bool IsRootMenu(AccessMenuSummaryResponse menu) =>
        !menu.ParentMenuId.HasValue || menu.ParentMenuId.Value == 0;

    private static int ResolveRootMenuId(AccessMenuSummaryResponse menu, IReadOnlyDictionary<int, AccessMenuSummaryResponse> menusById)
    {
        var current = menu;
        var guard = 0;
        while (current.ParentMenuId.HasValue && current.ParentMenuId.Value > 0 && guard++ < 25)
        {
            if (!menusById.TryGetValue(current.ParentMenuId.Value, out var parent))
            {
                break;
            }

            current = parent;
        }

        return current.PkIdMenu;
    }

    private AccessRoleSummaryResponse? RoleFromLookup(LookupItem item) =>
        _snapshot.Roles.FirstOrDefault(role => RoleLookupId(role) == item.Id);

    private LookupItem ToRoleLookupItem(AccessRoleSummaryResponse role) => new()
    {
        Id = RoleLookupId(role),
        Text = string.IsNullOrWhiteSpace(role.Code)
            ? role.Name
            : $"{role.Name} - {role.Code}"
    };

    private int RoleLookupId(AccessRoleSummaryResponse role)
    {
        var index = _snapshot.Roles.FindIndex(x => string.Equals(x.Id, role.Id, StringComparison.OrdinalIgnoreCase));
        return index < 0 ? 0 : index + 1;
    }

    private static ComboLookupResult ToPagedComboResult(IEnumerable<LookupItem> source, int page, int pageSize)
    {
        var filtered = source.Where(x => !string.IsNullOrWhiteSpace(x.Text)).ToList();
        return new ComboLookupResult
        {
            Items = filtered.Skip(Math.Max(page - 1, 0) * pageSize).Take(pageSize),
            TotalCount = filtered.Count
        };
    }

    private static LookupItem ToAccessUserLookupItem(AccessUserSummaryResponse user) => new()
    {
        Id = user.PkIdUsuario,
        Text = AccessUserLookupText(user)
    };

    private string RoleOptionClass(AccessRoleSummaryResponse role) =>
        IsUserRoleSelected(role.Id)
            ? "role-option active"
            : "role-option";

    private static List<string> SplitValues(string? values) =>
        (values ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static HashSet<string> BuildSelectedActions(AccessClaimResponse? claim)
    {
        if (claim == null)
        {
            return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }

        var values = new List<string>();
        foreach (var value in claim.ValueList)
        {
            values.AddRange(SplitValues(value));
        }

        values.AddRange(SplitValues(claim.Values));
        return values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static AccessClaimResponse? FindClaimForMenu(
        AccessMenuSummaryResponse menu,
        IReadOnlyCollection<AccessClaimResponse> claims,
        IReadOnlyDictionary<string, AccessClaimResponse> claimsBySubGroup)
    {
        var legacyKey = NormalizeLookupKey(menu.LegacyName);
        if (!string.IsNullOrWhiteSpace(legacyKey) && claimsBySubGroup.TryGetValue(legacyKey, out var byLegacy))
        {
            return byLegacy;
        }

        var menuKeys = BuildMenuMatchKeys(menu);
        return claims.FirstOrDefault(claim =>
        {
            if (claim.ReferenceId == menu.PkIdMenu)
            {
                return true;
            }

            var claimKeys = new[]
            {
                claim.SubGroup,
                claim.Code,
                claim.Name,
                claim.Description
            }
            .Select(NormalizeLooseKey)
            .Where(key => !string.IsNullOrWhiteSpace(key));

            return claimKeys.Any(menuKeys.Contains);
        });
    }

    private static string NormalizeLookupKey(string? value) =>
        (value ?? string.Empty)
            .Trim()
            .Replace(" ", "_", StringComparison.Ordinal)
            .ToLowerInvariant();

    private static HashSet<string> BuildMenuMatchKeys(AccessMenuSummaryResponse menu)
    {
        var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        AddLooseKey(keys, menu.LegacyName);
        AddLooseKey(keys, menu.Name);
        AddLooseKey(keys, menu.Route);

        var routeSegments = (menu.Route ?? string.Empty)
            .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (routeSegments.Length > 0)
        {
            AddLooseKey(keys, routeSegments[^1]);
            AddLooseKey(keys, routeSegments[0]);
        }

        if (routeSegments.Length > 1)
        {
            AddLooseKey(keys, $"{routeSegments[^1]}_{routeSegments[0]}");
            AddLooseKey(keys, $"{routeSegments[0]}_{routeSegments[^1]}");
        }

        return keys;
    }

    private static void AddLooseKey(HashSet<string> keys, string? value)
    {
        var key = NormalizeLooseKey(value);
        if (!string.IsNullOrWhiteSpace(key))
        {
            keys.Add(key);
        }
    }

    private static string NormalizeLooseKey(string? value)
    {
        var normalized = (value ?? string.Empty)
            .Trim()
            .Normalize(System.Text.NormalizationForm.FormD);

        return new string(normalized
            .Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark)
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private static string Initials(string value)
    {
        var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string AccessUserCaption(AccessUserSummaryResponse user) =>
        string.Join(" - ", new[] { user.Email, user.PayrollId, user.AccessNumber, $"{user.RoleCount} roles" }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string AccessUserLookupText(AccessUserSummaryResponse user) =>
        string.Join(" - ", new[] { user.DisplayName, user.Email, user.PayrollId, user.AccessNumber }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string RoleSecondaryText(AccessRoleSummaryResponse role) =>
        $"{(string.IsNullOrWhiteSpace(role.Code) ? role.Id : role.Code)} - {role.UserCount} usuarios - {role.ClaimCount} claims";

    private static string ActionLabel(string action) => NormalizeActionKey(action) switch
    {
        "view-menu" => "Menu",
        "excel" => "Excel",
        "new" => "Nuevo",
        "update" => "Editar",
        "delete" => "Eliminar",
        "authorize" => "Autorizar",
        "view" => "Ver",
        _ => action
    };

    private static Color ActionColor(string action) => NormalizeActionKey(action) switch
    {
        "view-menu" => Color.Info,
        "delete" => Color.Error,
        "new" => Color.Success,
        "update" => Color.Warning,
        "excel" => Color.Tertiary,
        "authorize" => Color.Secondary,
        _ => Color.Primary
    };

    private static string NormalizeActionKey(string action)
    {
        var key = (action ?? string.Empty)
            .Trim()
            .Replace("_", "-", StringComparison.Ordinal)
            .Replace(" ", "-", StringComparison.Ordinal)
            .ToLowerInvariant();

        return key switch
        {
            "viewmenu" or "view-menu" or "menu" => "view-menu",
            "canexporttoexcel" or "can-export-to-excel" or "export" or "export-excel" or "excel" => "excel",
            "new" or "nuevo" or "create" or "crear" or "add" or "agregar" => "new",
            "update" or "editar" or "edit" or "modify" or "modificar" => "update",
            "delete" or "eliminar" or "remove" or "borrar" => "delete",
            "authorize" or "autorizar" or "auth" => "authorize",
            "view" or "ver" => "view",
            _ => key
        };
    }

    private static string InferGroup(AccessMenuSummaryResponse menu)
    {
        var route = menu.Route ?? string.Empty;
        if (route.Contains("contabilidad", StringComparison.OrdinalIgnoreCase)) return "Contabilidad";
        if (route.Contains("presupuesto", StringComparison.OrdinalIgnoreCase)) return "Presupuesto";
        if (route.Contains("adquisiciones", StringComparison.OrdinalIgnoreCase)) return "Adquisiciones";
        if (route.Contains("patrimonio", StringComparison.OrdinalIgnoreCase)) return "Patrimonio";
        if (route.Contains("tesoreria", StringComparison.OrdinalIgnoreCase)) return "Tesoreria";
        if (route.Contains("nomina", StringComparison.OrdinalIgnoreCase)) return "Nomina";
        return "Sistema";
    }

    private static string ResolveIcon(string? icon) =>
        string.IsNullOrWhiteSpace(icon) ? Icons.Material.Filled.Article : icon;

    private sealed record AccessProfileOption(string Prefix, string Label, string Name, string[] Keywords);

    private sealed class ClaimEditorItem
    {
        public int Id { get; set; }
        public string Group { get; set; } = string.Empty;
        public string SubGroup { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Route { get; set; } = string.Empty;
        public string Icon { get; set; } = Icons.Material.Filled.Article;
        public int ReferenceId { get; set; }
        public int RootMenuId { get; set; }
        public int MenuOrder { get; set; }
        public bool ShowAdvanced { get; set; }
        public HashSet<string> SelectedActions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public bool HasAnyAction => SelectedActions.Count > 0;
        public bool HasAction(string action) =>
            SelectedActions.Contains(action)
            || SelectedActions.Any(selected => string.Equals(NormalizeActionKey(selected), NormalizeActionKey(action), StringComparison.OrdinalIgnoreCase));

        public void RemoveAction(string action)
        {
            if (SelectedActions.Remove(action))
            {
                return;
            }

            var normalizedAction = NormalizeActionKey(action);
            SelectedActions.RemoveWhere(selected => string.Equals(NormalizeActionKey(selected), normalizedAction, StringComparison.OrdinalIgnoreCase));
        }
    }
}
