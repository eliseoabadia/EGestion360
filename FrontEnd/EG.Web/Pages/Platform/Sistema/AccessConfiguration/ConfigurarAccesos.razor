            {
                Snackbar.Add(response?.Message ?? "No se pudo cargar la configuracion.", Severity.Error);
                return;
            }

            _snapshot = response.Data;
            if (_snapshot.PermissionActions.Count == 0)
            {
                _snapshot.PermissionActions.AddRange(PermissionActionExtensions.GetAllClaimValues());
            }

            if (_snapshot.Roles.Count == 0)
            {
                await NewRoleAsync();
            }
        }
        catch (Exception ex)
        {
