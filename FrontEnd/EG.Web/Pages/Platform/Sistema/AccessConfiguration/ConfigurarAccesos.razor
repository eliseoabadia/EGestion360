    private async Task<ComboLookupResult> LoadRootMenusPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var items = (_detail?.Menus ?? [])
            .Where(IsRootMenu)
            .Where(menu => string.IsNullOrWhiteSpace(filter)
                           || menu.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                           || menu.LegacyName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                           || (menu.Route?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true))
            .OrderBy(menu => menu.Order)
            .ThenBy(menu => menu.Name)
            .Select(menu => new LookupItem
            {
                Id = menu.PkIdMenu,
                Text = menu.Name
            });

        return await Task.FromResult(ToPagedComboResult(items, page, pageSize));
    }

    private Task<TableData<ClaimEditorItem>> LoadClaimsTableAsync(TableState state, CancellationToken ct)
    {
        var query = VisibleClaims;

        query = state.SortLabel switch
        {
            "DisplayName" => state.SortDirection == SortDirection.Descending
                ? query.OrderByDescending(x => x.DisplayName)
                : query.OrderBy(x => x.DisplayName),
            "Route" => state.SortDirection == SortDirection.Descending
                ? query.OrderByDescending(x => x.Route)
                : query.OrderBy(x => x.Route),
            _ => query.OrderBy(x => x.MenuOrder).ThenBy(x => x.DisplayName)
        };

        var list = query.ToList();
        var pageItems = list
            .Skip(state.Page * state.PageSize)
            .Take(state.PageSize)
            .ToList();

        return Task.FromResult(new TableData<ClaimEditorItem>
        {
            Items = pageItems,
            TotalItems = list.Count
        });
    }

