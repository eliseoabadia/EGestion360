    private async Task SaveUserRolesAsync()
    {
        if (!CanSaveUserRoles || _selectedAccessUserDetail == null)
        {
            return;
        }

        try
        {
            _saving = true;
            var request = new SaveAccessUserRolesRequest
            {
                PkIdUsuario = _selectedAccessUserDetail.User.PkIdUsuario,
                RoleIds = _selectedUserRoleIds.OrderBy(x => x).ToList()
            };

            var response = await AccessService.SaveUserRolesAsync(request);
            if (response?.Success != true || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "No se pudieron guardar los roles del usuario.", Severity.Error);
                return;
            }

            _selectedAccessUserDetail = response.Data;
            _selectedAccessUserLookup = ToAccessUserLookupItem(response.Data.User);
            _selectedUserRoleIds.Clear();
            foreach (var roleId in response.Data.AssignedRoleIds.Where(x => !string.IsNullOrWhiteSpace(x)))
            {
                _selectedUserRoleIds.Add(roleId);
            }

            _userRoleDirty = false;
            Snackbar.Add(response.Message, Severity.Success);
            await LoadSnapshotAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar roles del usuario: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveRoleMenusAsync()
    {
        if (!CanSaveRoleMenus)
        {
            return;
        }

        try
        {
            _saving = true;
            var request = new SaveAccessRoleRequest
            {
                Id = _selectedRoleId,
                Name = _roleName,
                Code = _roleCode,
                ReplaceUsers = false,
                ReplaceClaims = _claims.Count > 0,
                Claims = _claims
                    .Where(x => x.HasAnyAction && !string.IsNullOrWhiteSpace(x.Group) && !string.IsNullOrWhiteSpace(x.SubGroup))
                    .Select(x => new SaveAccessClaimRequest
                    {
                        Id = x.Id,
                        Group = x.Group,
                        SubGroup = x.SubGroup,
                        Name = x.DisplayName,
                        Code = x.SubGroup,
                        Description = x.Route,
                        ReferenceId = x.ReferenceId,
                        Values = x.SelectedActions.OrderBy(v => v).ToList()
                    })
                    .ToList()
            };

            var response = await AccessService.SaveRoleAsync(request);
            if (response?.Success != true || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "No se pudo guardar la configuracion.", Severity.Error);
                return;
            }

            Snackbar.Add(response.Message, Severity.Success);
            await LoadSnapshotAsync();
            await SelectRoleAsync(response.Data.Role.Id, forceReload: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SynchronizeAsync()
