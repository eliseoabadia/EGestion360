@page "/configuracion/sistema/sucursal"
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<SucursalResponse, SucursalResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestion de Sucursales"
                    Subtitle="Administra las sedes operativas por empresa"
                    Icon="@Icons.Material.Filled.Store"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="SucursalResponse"
                      @ref="table"
                      Title="Lista de Sucursales"
                      SearchPlaceholder="Buscar por nombre, codigo, empresa, ciudad o estado..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="SucursalResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar sucursal"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidSucursal))" /></MudTooltip><MudTooltip Text="Eliminar sucursal"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@context.Item.EsMatriz" OnClick="@(() => DeleteItem(context.Item.PkidSucursal))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="SucursalResponse" TProperty="int" Property="x => x.PkidSucursal" Title="ID" Identifier="PkidSucursal" />
                <PropertyColumn T="SucursalResponse" TProperty="string" Property="x => x.CodigoSucursal" Title="Código" Identifier="CodigoSucursal" />
                <PropertyColumn T="SucursalResponse" TProperty="string" Property="x => x.Nombre" Title="Sucursal" Identifier="Nombre" />
                <PropertyColumn T="SucursalResponse" TProperty="string" Property="x => x.NombreEmpresa" Title="Empresa" Identifier="NombreEmpresa" />
                <PropertyColumn T="SucursalResponse" TProperty="string" Property="x => x.Ciudad" Title="Ciudad" Identifier="Ciudad" />
                <PropertyColumn T="SucursalResponse" TProperty="string" Property="x => x.NombreEstado" Title="Estado" Identifier="NombreEstado" />
                <TemplateColumn Resizable="true" T="SucursalResponse" Title="Matriz" Identifier="EsMatriz"><CellTemplate><MudChip T="string" Size="Size.Small" Color="@(context.Item.EsMatriz ? Color.Info : Color.Default)">@(context.Item.EsMatriz ? "Sí" : "No")</MudChip></CellTemplate></TemplateColumn>
                <TemplateColumn Resizable="true" T="SucursalResponse" Title="Activa" Identifier="EsActiva"><CellTemplate><MudChip T="string" Size="Size.Small" Color="@(context.Item.EsActiva && context.Item.Activo ? Color.Success : Color.Default)">@(context.Item.EsActiva && context.Item.Activo ? "Activa" : "Inactiva")</MudChip></CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<SucursalResponse> table = null!;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Sucursal";

    protected override Type CreateDialogType => typeof(SucursalDialog);
    protected override Type EditDialogType => typeof(SucursalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SucursalResponse>);

    protected override string GetDefaultSortLabel() => "Nombre";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SucursalResponse> items)
    {
        return items.Select(s => new
        {
            ID = s.PkidSucursal,
            Codigo = s.CodigoSucursal,
            Sucursal = s.Nombre,
            Empresa = s.NombreEmpresa,
            Direccion = s.Direccion,
            Ciudad = s.Ciudad,
            Estado = s.NombreEstado,
            Telefono = s.TelefonoPrincipal,
            Email = s.Email,
            Matriz = s.EsMatriz ? "Si" : "No",
            Activa = s.EsActiva && s.Activo ? "Si" : "No"
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Nombre ?? "la sucursal";
        }
        catch
        {
            return "la sucursal";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }
}
