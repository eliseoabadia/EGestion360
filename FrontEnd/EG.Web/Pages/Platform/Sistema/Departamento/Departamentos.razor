@page "/configuracion/sistema/departamento"
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<DepartamentoResponse, DepartamentoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False">
        <PageHeader Title="Gestión de Departamentos"
                    Subtitle="Administra y mantén el registro de departamentos del sistema"
                    Icon="@Icons.Material.Filled.Domain"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="DepartamentoResponse"
                      @ref="table"
                      Title="Lista de Departamentos"
                      SearchPlaceholder="Buscar por nombre..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="DepartamentoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar departamento"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidDepartamento))" /></MudTooltip><MudTooltip Text="Eliminar departamento"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidDepartamento))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="DepartamentoResponse" TProperty="int" Property="x => x.PkidDepartamento" Title="ID" Identifier="PkidDepartamento" />
                <PropertyColumn T="DepartamentoResponse" TProperty="string" Property="x => x.DepartamentoNombre" Title="Nombre" Identifier="DepartamentoNombre" />
                <PropertyColumn T="DepartamentoResponse" TProperty="string" Property="x => x.EmpresaNombre" Title="Empresa" Identifier="EmpresaNombre" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<DepartamentoResponse> table = null!;

    protected override string ModuleName => "Sistema";
    protected override string SubModuleName => "Departamento";

    protected override Type CreateDialogType => typeof(DepartamentoDialog);
    protected override Type EditDialogType => typeof(DepartamentoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<DepartamentoResponse>);

    protected override string GetDefaultSortLabel() => "DepartamentoNombre";

    protected override async Task CreateItem()
    {
        CurrentPage = 0;
        SearchString = string.Empty;
        await base.CreateItem();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<DepartamentoResponse> items)
    {
        return items.Select(d => new
        {
            ID = d.PkidDepartamento,
            Nombre = d.DepartamentoNombre,
            Descripcion = d.Descripcion ?? "",
            Empresa = d.EmpresaNombre,
            Nivel_Jerarquico = d.NivelJerarquico,
            Fecha_Creacion = d.FechaCreacion?.ToString("dd/MM/yyyy") ?? "",
            Usuario_Creacion = d.UsuarioCreacionNombre
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.DepartamentoNombre ?? "el departamento";
        }
        catch
        {
            return "el departamento";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }
}
