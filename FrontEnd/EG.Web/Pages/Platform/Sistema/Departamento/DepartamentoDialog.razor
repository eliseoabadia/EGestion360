@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.General
@inject IGenericCrudService<DepartamentoResponse> _service
@inject IGenericCrudService<EmpresaResponse> empresaService
@inject SucursalStateService SucursalStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="DepartamentoResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Small"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos del departamento..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="DepartamentoResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudSelect Label="Empresa"
                           @bind-Value="departamento.PkidEmpresa"
                           T="int"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar una empresa">
                    <MudSelectItem T="int" Value="0">Seleccione una empresa</MudSelectItem>
                    @foreach (var empresa in empresas)
                    {
                        <MudSelectItem T="int" Value="@empresa.PkidEmpresa">@empresa.EmpresaNombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="departamento.DepartamentoNombre"
                              Label="Nombre del Departamento"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre del departamento es requerido"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidarNombre))" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="departamento.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="2" />
            </MudItem>

            <MudItem xs="12">
                <MudNumericField @bind-Value="departamento.NivelJerarquico"
                                Label="Nivel Jerárquico"
                                Variant="Variant.Outlined"
                                Min="0"
                                Max="99" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int? EmpresaId { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<DepartamentoResponse> form = null!;
    private DepartamentoResponse departamento = new() { DepartamentoActivo = true };
    private IList<EmpresaResponse> empresas = new List<EmpresaResponse>();

    private string dialogTitle => Id.HasValue ? "Editar Departamento" : "Nuevo Departamento";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await SucursalStateService.InitializeAsync();
        await CargarEmpresas();

        if (Id.HasValue)
        {
            await CargarDepartamento();
        }
        else if (EmpresaId.HasValue && EmpresaId.Value > 0)
        {
            departamento.PkidEmpresa = EmpresaId.Value;
        }
        else if (SucursalStateService.EmpresaId.HasValue)
        {
            departamento.PkidEmpresa = SucursalStateService.EmpresaId.Value;
        }
    }

    private async Task CargarEmpresas()
    {
        try
        {
            var response = await empresaService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                empresas = response.Items
                    .Where(e => e.EmpresaActivo)
                    .OrderBy(e => e.EmpresaNombre)
                    .ToList();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar empresas", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresas: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task CargarDepartamento()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                departamento = response.Data;
                departamento.DepartamentoActivo = true;
                departamento.NivelJerarquico ??= 1;
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar departamento", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar departamento: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private IEnumerable<string> ValidarNombre(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            yield return "El nombre del departamento es requerido";
            yield break;
        }

        nombre = nombre.Trim();

        if (nombre.Length < 3)
            yield return "El nombre debe tener al menos 3 caracteres";

        if (nombre.Length > 100)
            yield return "El nombre no puede exceder los 100 caracteres";
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (departamento.PkidEmpresa <= 0)
        {
            Snackbar.Add("Debe seleccionar la empresa del departamento.", Severity.Warning);
            return;
        }

        if (!departamento.NivelJerarquico.HasValue || departamento.NivelJerarquico <= 0)
        {
            departamento.NivelJerarquico = 1;
        }

        try
        {
            ApiResponse<DepartamentoResponse> response;

            if (Id.HasValue)
            {
                response = await _service.UpdateAsync(departamento, Id.Value);
            }
            else
            {
                response = await _service.CreateAsync(departamento);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? $"Departamento {(Id.HasValue ? "actualizado" : "creado")} exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error en la operación", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
