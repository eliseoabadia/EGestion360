@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Dommain.DTOs.Responses
@using EG.Common.GenericModel
@using MudBlazor

@inject IGenericCrudService<EmpresaResponse> empresaService
@inject IGenericCrudService<UsuarioResponse> usuarioService
@inject IGenericCrudService<PersonaResponse> personaService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="UsuarioResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos del usuario..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="UsuarioResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <!-- Empresa -->
            <MudItem xs="12" md="6">
                <MudSelect Label="Empresa"
                           @bind-Value="usuario.IdEmpresa"
                           T="int"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar una empresa"
                           For="@(() => usuario.IdEmpresa)">
                    <MudSelectItem T="int" Value="0">Seleccione una empresa</MudSelectItem>
                    @foreach (var empresa in listadoEmpresas)
                    {
                        <MudSelectItem T="int" Value="@empresa.PkidEmpresa">@empresa.EmpresaNombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Payroll ID -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.PayrollId"
                              Label="Payroll ID"
                              Variant="Variant.Outlined" />
            </MudItem>

            <!-- Persona (requerido) -->
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">
                    <span>Persona vinculada</span>
                </MudText>
                <PagedAutocomplete Value="@_selectedPersona"
                                   ValueChanged="OnPersonaChanged"
                                   Label="Seleccione una persona"
                                   Required="true"
                                   RequiredError="Debe seleccionar una persona"
                                   LoadPage="LoadPersonasPageAsync" />
            </MudItem>

            @if (_selectedPersona != null)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="1" Style="border-radius: 8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Datos de la persona vinculada</MudText>
                        <MudDivider Class="mb-2" />
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Nombre completo</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaNombreCompleto</MudText>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Email</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaEmail</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Teléfono</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaTelefono</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Clave</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaClave</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">RFC</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@_personaRfc</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

            <!-- Estado del Usuario -->
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px;">
                    <MudText Class="mb-2" Typo="Typo.subtitle2">Estado del Usuario</MudText>
                    <MudDivider Class="mb-3" />

                    @if (Id.HasValue && usuario.UsuarioActivo == true)
                    {
                        <div class="d-flex align-center">
                            <MudSwitch @bind-Value="usuario.UsuarioActivo"
                                       Color="Color.Error"
                                       ThumbIcon="@Icons.Material.Filled.PowerOff">
                                <MudText>Dar de baja</MudText>
                            </MudSwitch>
                            <MudTooltip Text="Los usuarios inactivos no podr�n acceder al sistema">
                                <MudIcon Icon="@Icons.Material.Filled.Info"
                                         Size="Size.Small"
                                         Class="ml-2"
                                         Color="Color.Info" />
                            </MudTooltip>
                        </div>
                    }
                    else if (Id.HasValue && usuario.UsuarioActivo == false)
                    {
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Error"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Inactivo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Usuario dado de baja)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                    else
                    {
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Success"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Activo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Los nuevos usuarios se crean activos)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    
    private BaseEntityForm<UsuarioResponse> form = null!;
    private UsuarioResponse usuario = new() { UsuarioActivo = true };
    private IList<EmpresaResponse> listadoEmpresas = new List<EmpresaResponse>();

    private string dialogTitle => Id.HasValue ? "Editar Usuario" : "Nuevo Usuario";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private LookupItem? _selectedPersona;
    private string _personaNombreCompleto = string.Empty;
    private string _personaEmail = string.Empty;
    private string _personaTelefono = string.Empty;
    private string _personaClave = string.Empty;
    private string _personaRfc = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarSucursales());

        if (Id.HasValue)
        {
            await CargarUsuario();
        }
    }

    private async Task CargarSucursales()
    {
        try
        {
            var response = await empresaService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                listadoEmpresas = response.Items.ToList();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar empresas", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresas: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarUsuario()
    {
        try
        {
            var response = await usuarioService.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                usuario = response.Data;
                if (usuario.IdPersona.HasValue)
                {
                    _selectedPersona = new LookupItem
                    {
                        Id = usuario.IdPersona.Value,
                        Text = !string.IsNullOrWhiteSpace(usuario.NombreCompletoPersona)
                            ? usuario.NombreCompletoPersona.Trim()
                            : $"{usuario.PersonaNombre} {usuario.PersonaPaterno} {usuario.PersonaMaterno}".Trim()
                    };
                    await CargarDatosPersona(usuario.IdPersona.Value);
                }
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar usuario", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando usuario: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarDatosPersona(int personaId)
    {
        try
        {
            var response = await personaService.GetByIdAsync(personaId);
            if (response?.Success == true && response.Data != null)
            {
                var p = response.Data;
                _personaNombreCompleto = $"{p.Nombre} {p.Paterno} {p.Materno}".Trim();
                _personaEmail = p.CorreoElectronico ?? string.Empty;
                _personaTelefono = p.TelefonoMovil ?? p.TelefonoParticular ?? string.Empty;
                _personaClave = p.Clave ?? string.Empty;
                _personaRfc = p.Rfc ?? string.Empty;
            }
        }
        catch { }
    }

    private void OnPersonaChanged(LookupItem? item)
    {
        _selectedPersona = item;
        usuario.IdPersona = item?.Id;
        if (item != null)
        {
            _ = CargarDatosPersona(item.Id);
        }
        else
        {
            _personaNombreCompleto = string.Empty;
            _personaEmail = string.Empty;
            _personaTelefono = string.Empty;
            _personaClave = string.Empty;
            _personaRfc = string.Empty;
        }
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await personaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Select(persona => new LookupItem
            {
                Id = persona.PkidPersona,
                Text = $"{persona.Nombre} {persona.Paterno} {persona.Materno}".Trim()
            }) ?? Enumerable.Empty<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (usuario.IdEmpresa == null || usuario.IdEmpresa <= 0)
        {
            Snackbar.Add("Debe seleccionar una empresa", Severity.Warning);
            return;
        }

        if (_selectedPersona == null)
        {
            Snackbar.Add("Debe seleccionar una persona vinculada", Severity.Warning);
            return;
        }

        usuario.IdPersona = _selectedPersona.Id;

        try
        {
            ApiResponse<UsuarioResponse> response;

            if (Id.HasValue)
            {
                response = await usuarioService.UpdateAsync(usuario, usuario.PkIdUsuario);
            }
            else
            {
                response = await usuarioService.CreateAsync(usuario);
            }

            if (response?.Success == true)
            {
                var message = response.Message ?? $"Usuario {(Id.HasValue ? "actualizado" : "creado")} exitosamente";
                Snackbar.Add(message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error en la operaci�n", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

}
