@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Dommain.DTOs.Responses
@using EG.Common.GenericModel
@using MudBlazor

@inject IGenericCrudService<EmpresaResponse> empresaService
@inject IGenericCrudService<UsuarioResponse> usuarioService
@inject IGenericCrudService<PersonaResponse> personaService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="UsuarioResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Large"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos del usuario..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="UsuarioResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <!-- Datos personales - Fila 1 -->
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="usuario.NombreCompleto"
                              Label="Nombre completo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre completo es requerido"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidarNombreCompleto))"
                              For="@(() => usuario.NombreCompleto)" />
            </MudItem>

            <!-- Sucursal -->
            <MudItem xs="12" md="4">
                <MudSelect Label="Sucursal"
                           @bind-Value="usuario.IdEmpresa"
                           T="int"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar una sucursal"
                           For="@(() => usuario.IdEmpresa)">
                    <MudSelectItem T="int" Value="0">Seleccione una empresa</MudSelectItem>
                    @foreach (var empresa in listadoEmpresas)
                    {
                        <MudSelectItem T="int" Value="@empresa.PkidEmpresa">@empresa.EmpresaNombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Persona -->
            <MudItem xs="12" md="6">
                <PagedAutocomplete Value="@_selectedPersona"
                                   ValueChanged="OnPersonaChanged"
                                   Label="Nombre Persona"
                                   Clearable="true"
                                   LoadPage="LoadPersonasPageAsync" />
            </MudItem>

            <!-- Contacto - Fila 2 -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="El email es requerido"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidarEmail))"
                              For="@(() => usuario.Email)" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.TelefonoUsuario"
                              Label="Tel�fono"
                              Variant="Variant.Outlined"
                              Placeholder="(99) 9999-9999" />
                @* Sin Mask para permitir edici�n libre *@
            </MudItem>

            <!-- Direcci�n - Fila 3 -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.Direccion1"
                              Label="Direcci�n 1"
                              Required="true"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="usuario.Direccion2"
                              Label="Direcci�n 2"
                              Variant="Variant.Outlined" />
            </MudItem>

            <!-- Fila 4: 4 columnas -->
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="usuario.CodigoPostalUsuario"
                              Label="C�digo Postal"
                              Required="true"
                              Variant="Variant.Outlined"
                              Placeholder="12345" />
                @* Sin Mask para permitir edici�n libre *@
            </MudItem>

            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="usuario.PayrollId"
                              Label="Payroll ID"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="usuario.NumeroSocial"
                              Label="N�mero Social"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="usuario.Gafete"
                              Label="Gafete"
                              Variant="Variant.Outlined" />
            </MudItem>

            <!-- Fila 5: Estado y G�nero en la misma l�nea -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px; height: 100%;">
                    <MudText Class="mb-2" Typo="Typo.subtitle2">Estado del Usuario</MudText>
                    <MudDivider Class="mb-3" />

                    @if (Id.HasValue && usuario.UsuarioActivo == true)
                    {
                        <!-- Caso 1: Edici�n - Usuario ACTIVO (puede dar de baja) -->
                        <div class="d-flex align-center">
                            <MudSwitch @bind-Value="usuario.UsuarioActivo"
                                       Color="Color.Error"
                                       ThumbIcon="@Icons.Material.Filled.PowerOff">
                                <MudText>Dar de baja</MudText>
                            </MudSwitch>
                            <MudTooltip Text="Los usuarios inactivos no podr�n acceder al sistema">
                                <MudIcon Icon="@Icons.Material.Filled.Info"
                                         Size="Size.Small"
                                         Class="ml-2"
                                         Color="Color.Info" />
                            </MudTooltip>
                        </div>
                    }
                    else if (Id.HasValue && usuario.UsuarioActivo == false)
                    {
                        <!-- Caso 2: Edici�n - Usuario INACTIVO (solo lectura) -->
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Error"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Inactivo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Usuario dado de baja)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                    else
                    {
                        <!-- Caso 3: Alta - Nuevo usuario (siempre activo) -->
                        <div class="d-flex align-center">
                            <MudBadge Color="Color.Success"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                Activo
                            </MudBadge>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Los nuevos usuarios se crean activos)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="usuario.UsuarioActivo" />
                    }
                </MudPaper>
            </MudItem>

            <!-- G�nero -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px; height: 100%;">
                    <MudText Class="mb-2" Typo="Typo.subtitle2">G�nero</MudText>
                    <MudDivider Class="mb-3" />
                    <div class="d-flex align-center" style="min-height: 36px;">
                        <MudRadioGroup @bind-Value="usuario.Sexo" Dense="true" Class="d-flex">
                            <MudRadio Value="true" Color="Color.Primary">Femenino</MudRadio>
                            <MudRadio Value="false" Color="Color.Primary" Class="ml-4">Masculino</MudRadio>
                        </MudRadioGroup>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    
    private BaseEntityForm<UsuarioResponse> form = null!;
    private UsuarioResponse usuario = new() { UsuarioActivo = true };
    private IList<EmpresaResponse> listadoEmpresas = new List<EmpresaResponse>();

    private string dialogTitle => Id.HasValue ? "Editar Usuario" : "Nuevo Usuario";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarSucursales());

        if (Id.HasValue)
        {
            await CargarUsuario();
        }
    }

    private async Task CargarSucursales()
    {
        try
        {
            var response = await empresaService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                listadoEmpresas = response.Items.ToList();
                Console.WriteLine($"Cargadas {listadoEmpresas.Count} sucursales");
            }
            else
            {
                Console.WriteLine("No se pudieron cargar las sucursales");
                Snackbar.Add(response?.Message ?? "Error al cargar sucursales", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando sucursales: {ex.Message}");
            Snackbar.Add($"Error al cargar sucursales: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarUsuario()
    {
        try
        {
            var response = await usuarioService.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                usuario = response.Data;
                if (usuario.IdPersona.HasValue)
                {
                    _selectedPersona = new LookupItem
                    {
                        Id = usuario.IdPersona.Value,
                        Text = !string.IsNullOrWhiteSpace(usuario.NombreCompletoPersona)
                            ? usuario.NombreCompletoPersona.Trim()
                            : $"{usuario.PersonaNombre} {usuario.PersonaPaterno} {usuario.PersonaMaterno}".Trim()
                    };
                }
                Console.WriteLine($"Usuario cargado: {usuario.NombreCompleto}");
            }
            else
            {
                Console.WriteLine("No se pudo cargar el usuario");
                Snackbar.Add(response?.Message ?? "Error al cargar usuario", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando usuario: {ex.Message}");
            Snackbar.Add($"Error al cargar usuario: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<string> ValidarNombreCompleto(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            yield return "El nombre completo es requerido";
            yield break;
        }
        nombre = nombre.Trim();
        if (nombre.Length < 3)
            yield return "El nombre debe tener al menos 3 caracteres";
        if (nombre.Length > 100)
            yield return "El nombre no puede exceder los 100 caracteres";
    }

    private IEnumerable<string> ValidarEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            yield return "El email es requerido";
            yield break;
        }
        email = email.Trim().ToLowerInvariant();
        if (!email.Contains("@") || !email.Contains("."))
        {
            yield return "El email no tiene un formato v�lido";
            yield break;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            yield return "El formato del email no es v�lido";
        }
    }

    private string GenerarIniciales()
    {
        if (string.IsNullOrWhiteSpace(usuario.NombreCompleto))
            return string.Empty;
        var palabras = usuario.NombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (palabras.Length == 0)
            return string.Empty;
        var iniciales = string.Concat(palabras.Select(p => char.ToUpper(p[0])));
        return iniciales.Length > 3 ? iniciales.Substring(0, 3) : iniciales;
    }

    private LookupItem? _selectedPersona;

    private void OnPersonaChanged(LookupItem? item)
    {
        _selectedPersona = item;
        usuario.IdPersona = item?.Id;
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await personaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Select(persona => new LookupItem
            {
                Id = persona.PkidPersona,
                Text = $"{persona.Nombre} {persona.Paterno} {persona.Materno}".Trim()
            }) ?? Enumerable.Empty<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (usuario.IdEmpresa == null || usuario.IdEmpresa <= 0)
        {
            Snackbar.Add("Debe seleccionar una sucursal", Severity.Warning);
            return;
        }

        usuario.IdPersona = _selectedPersona?.Id;

        try
        {
            usuario.Iniciales = GenerarIniciales();

            ApiResponse<UsuarioResponse> response;

            if (Id.HasValue)
            {
                response = await usuarioService.UpdateAsync(usuario, usuario.PkIdUsuario);
            }
            else
            {
                response = await usuarioService.CreateAsync(usuario);
            }

            if (response?.Success == true)
            {
                var message = response.Message ?? $"Usuario {(Id.HasValue ? "actualizado" : "creado")} exitosamente";
                Snackbar.Add(message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error en la operaci�n", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

}
