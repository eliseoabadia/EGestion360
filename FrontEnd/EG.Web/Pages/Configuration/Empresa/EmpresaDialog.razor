@using MudBlazor
@using EG.Web.Models.Configuration

@inject IGenericCrudService<EstadoResponse> estadoService
@inject IGenericCrudService<EmpresaResponse> _service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="EmpresaResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos de la empresa..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="EmpresaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <!-- Fila 1: Nombre y RFC -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="empresa.EmpresaNombre"
                              Label="Nombre de la Empresa"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre de la empresa es requerido"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidarNombre))"
                              For="@(() => empresa.EmpresaNombre)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="empresa.Rfc"
                              Label="RFC"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El RFC es requerido"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidarRFC))"
                              For="@(() => empresa.Rfc)" />
            </MudItem>

            <!-- Fila 2: Razón Social y Giro -->
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="empresa.RazonSocial"
                              Label="Razón Social"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="empresa.Giro"
                              Label="Giro"
                              Variant="Variant.Outlined" />
            </MudItem>

            <!-- Fila 3: Estado, Moneda e Idioma -->
            <MudItem xs="12" md="4">
                <MudSelect Label="Estado (Entidad Federativa)"
                           @bind-Value="estadoSeleccionado"
                           T="int?"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar un estado"
                           Disabled="@(Id.HasValue && estados.Count == 1)"
                           For="@(() => estadoSeleccionado)">
                    <MudSelectItem T="int?" Value="null">Seleccione un estado</MudSelectItem>
                    @foreach (var estado in estados)
                    {
                        <MudSelectItem T="int?" Value="@estado.PkidEstado">@estado.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @* <MudItem xs="12" md="4">
                <MudSelect Label="Moneda Base"
                           @bind-Value="empresa.FkidMonedaBaseSis"
                           T="int"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Debe seleccionar una moneda"
                           Disabled="@(Id.HasValue && monedas.Count == 1)">
                    <MudSelectItem T="int" Value="0">Seleccione una moneda</MudSelectItem>
                    @foreach (var moneda in monedas)
                    {
                        <MudSelectItem T="int" Value="@moneda.PkidMoneda">@moneda.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem> *@
            @* <MudItem xs="12" md="4">
                <MudSelect Label="Idioma Preferido"
                           @bind-Value="empresa.FkidIdiomaPreferidoSis"
                           T="int?"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="int?" Value="null">Seleccione un idioma</MudSelectItem>
                    @foreach (var idioma in idiomas)
                    {
                        <MudSelectItem T="int?" Value="@idioma.PkidIdioma">@idioma.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem> *@

            <!-- Fila 4: Fecha de Apertura y Oficina Principal -->
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Value="fechaApertura"
                               Label="Fecha de Apertura"
                               Variant="Variant.Outlined"
                               For="@(() => fechaApertura)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSwitch @bind-Value="empresa.EsOficinaPrincipal"
                           Color="Color.Primary"
                           Label="¿Es oficina principal?" />
            </MudItem>

            <!-- Fila 5: Estatus (solo en edición) -->
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px;">
                    <MudText Class="mb-2" Typo="Typo.subtitle2" Color="Color.Default">Estatus de la Empresa</MudText>
                    <MudDivider Class="mb-3" />
                    @if (Id.HasValue)
                    {
                        <div class="d-flex align-center">
                            <MudSwitch @bind-Value="empresa.EmpresaActivo"
                                       Color="Color.Primary"
                                       ThumbIcon="@(empresa.EmpresaActivo? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                                <MudText>@(empresa.EmpresaActivo ? "Activa" : "Inactiva")</MudText>
                            </MudSwitch>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Activa</MudChip>
                            <MudText Typo="Typo.body2" Class="ml-2 text-secondary">
                                (Las nuevas empresas se crean activas)
                            </MudText>
                        </div>
                        <input type="hidden" @bind="empresa.EmpresaActivo" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<EmpresaResponse> form = null!;
    private EmpresaResponse empresa = new() { EmpresaActivo = true };
    private IList<EstadoResponse> estados = new List<EstadoResponse>();
    // private IList<MonedaResponse> monedas = new List<MonedaResponse>();
    // private IList<IdiomaResponse> idiomas = new List<IdiomaResponse>();

    private int? estadoSeleccionado;
    private DateTime? fechaApertura;

    private string dialogTitle => Id.HasValue ? "Editar Empresa" : "Nueva Empresa";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await CargarEstados();
        // await CargarMonedas();
        // await CargarIdiomas();

        if (Id.HasValue)
        {
            await CargarEmpresa();
        }
        else
        {
            // Valores por defecto para nueva empresa
            empresa.FkidMonedaBaseSis = 1; // Moneda por defecto (ajusta según tu catálogo)
            empresa.FkidIdiomaPreferidoSis = null;
            empresa.EsOficinaPrincipal = false;
        }
    }

    private async Task CargarEstados()
    {
        try
        {
            var response = await estadoService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                estados = response.Items.ToList();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar estados", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar estados: {ex.Message}", Severity.Error);
        }
    }

