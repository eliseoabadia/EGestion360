    //             Snackbar.Add(response?.Message ?? "Error al cargar idiomas", Severity.Warning);
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Snackbar.Add($"Error al cargar idiomas: {ex.Message}", Severity.Error);
    //     }
    // }

    private async Task CargarEmpresa()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                empresa = response.Data;
                estadoSeleccionado = empresa.PkidEstado;
                if (empresa.FechaApertura.HasValue)
                {
                    fechaApertura = new DateTime(empresa.FechaApertura.Value.Year,
                                                  empresa.FechaApertura.Value.Month,
                                                  empresa.FechaApertura.Value.Day);
                }
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al cargar empresa", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresa: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<string> ValidarNombre(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            yield return "El nombre de la empresa es requerido";
            yield break;
        }
        nombre = nombre.Trim();
        if (nombre.Length < 3)
            yield return "El nombre debe tener al menos 3 caracteres";
        if (nombre.Length > 100)
            yield return "El nombre no puede exceder los 100 caracteres";
    }

    private IEnumerable<string> ValidarRFC(string? rfc)
    {
        if (string.IsNullOrWhiteSpace(rfc)) yield break;
        rfc = rfc.ToUpperInvariant().Trim();
        if (rfc.Length < 12 || rfc.Length > 13)
            yield return "El RFC debe tener 12 o 13 caracteres";
        if (!System.Text.RegularExpressions.Regex.IsMatch(rfc, "^[A-ZÑ&]{3,4}[0-9]{6}[A-Z0-9]{2,3}$"))
            yield return "El formato del RFC no es válido";
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (!estadoSeleccionado.HasValue)
        {
            Snackbar.Add("Debe seleccionar un estado (entidad federativa)", Severity.Warning);
            return;
        }
        empresa.PkidEstado = estadoSeleccionado.Value;

        if (empresa.FkidMonedaBaseSis <= 0)
        {
            Snackbar.Add("Debe seleccionar una moneda base", Severity.Warning);
            return;
        }

        if (fechaApertura.HasValue)
            empresa.FechaApertura = DateOnly.FromDateTime(fechaApertura.Value);
        else
            empresa.FechaApertura = null;

        if (!Id.HasValue)
        {
            empresa.EmpresaActivo = true;
            empresa.PkidEmpresa = 0;
        }

        try
        {
            ApiResponse<EmpresaResponse> response;
            if (Id.HasValue)
                response = await _service.UpdateAsync(empresa, empresa.PkidEmpresa);
            else
                response = await _service.CreateAsync(empresa);

            if (response?.Success == true)
            {
                var message = response.Message ?? $"Empresa {(Id.HasValue ? "actualizada" : "creada")} exitosamente";
                Snackbar.Add(message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error en la operación", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }
}