@page "/configuracion/contabilidad/matriz-conversion-ingresos"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MatrizIngresoResponse, MatrizIngresoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Matriz de Ingresos"
                    Subtitle="Catálogo de matriz de ingresos"
                    Icon="@Icons.Material.Filled.SwapHoriz"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="MatrizIngresoResponse"
                  @ref="table"
                  Title="Lista de Matriz de Ingresos"
                  SearchPlaceholder="Buscar por clave o descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidMatrizIngreso" T="MatrizIngresoResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="MatrizIngresoResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="MatrizIngresoResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="MatrizIngresoResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidMatrizIngreso))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidMatrizIngreso))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidMatrizIngreso</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<MatrizIngresoResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "MatrizIngreso";

    protected override Type CreateDialogType => typeof(MatrizIngresoDialog);
    protected override Type EditDialogType => typeof(MatrizIngresoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MatrizIngresoResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MatrizIngresoResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMatrizIngreso,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            Activo = u.Activo
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la matriz de ingreso";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
