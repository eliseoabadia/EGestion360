@page "/configuracion/contabilidad/matriz-conversion-ingresos"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MatrizIngresoResponse, MatrizIngresoResponse>

<AccessVerification IsInitialized="@IsInitialized"
    HasAccess="@HasAccess"
    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100%;">
        <PageHeader Title="Matriz de Ingresos"
            Subtitle="Relación entre programas, orígenes y cuentas contables"
            Icon="@Icons.Material.Filled.SwapHoriz"
            CanCreate="@CanCreate"
            OnCreate="CreateItem"
            OnRefresh="() => table.ReloadData()" />

        <div style="overflow-x: auto; flex: 1;" class="custom-matriz-table">
            <GenericTable TItem="MatrizIngresoResponse"
                @ref="table"
                Title="Lista de Matriz de Ingresos"
                SearchPlaceholder="Buscar por programa u origen..."
                ShowExportButton="@CanExport"
                ServerDataFunc="LoadServerData"
                ExportFunc="ExportToExcel"
                SearchString="@SearchString"
                SearchStringChanged="(s) => SearchString = s"
                OnSearch="OnSearch">

                <Header>
                    <MudTh Class="col-acciones">Acciones</MudTh>
                    <MudTh Class="col-id"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="PkidMatrizIngreso">pK</MudTableSortLabel></MudTh>
                    <MudTh Class="col-programa"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="ProgramaClave">Programa</MudTableSortLabel></MudTh>
                    <MudTh Class="col-origen"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="OrigenDescripcion">Origen de Recursos</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaAutorizadoNombre">Cta. Presupuesto Autorizado</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaPorEjecutarNombre">Cuenta Presupuesto por Ejecutar</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaModificadoNombre">Cuenta Presupuesto Modificado</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaDevengadoNombre">Cuenta Presupuesto Devengado</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaRecaudadoNombre">Cuenta Presupuesto Recaudado</MudTableSortLabel></MudTh>
                    <MudTh Class="col-cuenta"><MudTableSortLabel T="MatrizIngresoResponse" SortLabel="CuentaDepositoNombre">Cuenta de Depósito</MudTableSortLabel></MudTh>
                </Header>

                <Row Context="item">
                    <MudTd Class="col-acciones" @ondblclick="@(() => OpenDetail(item))">
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                Visible="@CanUpdate"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="@(() => EditItem(item.PkidMatrizIngreso))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                Visible="@CanDelete"
                                Color="Color.Error"
                                Size="Size.Small"
                                OnClick="@(() => DeleteItem(item.PkidMatrizIngreso))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd Class="col-id" @ondblclick="@(() => OpenDetail(item))">@item.PkidMatrizIngreso</MudTd>
                    <MudTd Class="col-programa" @ondblclick="@(() => OpenDetail(item))">@item.ProgramaClave</MudTd>
                    <MudTd Class="col-origen" @ondblclick="@(() => OpenDetail(item))">@item.OrigenDescripcion</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaAutorizadoNombre</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaPorEjecutarNombre</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaModificadoNombre</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaDevengadoNombre</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaRecaudadoNombre</MudTd>
                    <MudTd Class="col-cuenta" @ondblclick="@(() => OpenDetail(item))">@item.CuentaDepositoNombre</MudTd>
                </Row>
            </GenericTable>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<MatrizIngresoResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Matriz_Conversion_Ingresos";

    protected override Type CreateDialogType => typeof(MatrizIngresoDialog);
    protected override Type EditDialogType => typeof(MatrizIngresoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MatrizIngresoResponse>);

    protected override string GetDefaultSortLabel() => "ProgramaClave";

    private async Task OpenDetail(MatrizIngresoResponse item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<MatrizIngresoPersonalizado>(string.Empty, parameters, options);
        await dialog.Result;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MatrizIngresoResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMatrizIngreso,
            Programa = u.ProgramaClave,
            OrigenRecursos = u.OrigenDescripcion,
            CtaAutorizado = u.CuentaAutorizadoNombre,
            CtaPorEjecutar = u.CuentaPorEjecutarNombre,
            CtaModificado = u.CuentaModificadoNombre,
            CtaDevengado = u.CuentaDevengadoNombre,
            CtaRecaudado = u.CuentaRecaudadoNombre,
            CtaDeposito = u.CuentaDepositoNombre,
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ProgramaClave ?? "la matriz de ingreso";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}

<style>
    .custom-matriz-table .col-acciones {
        min-width: 120px;
        max-width: 120px;
        text-align: center;
    }

    .custom-matriz-table .col-id {
        min-width: 60px;
        max-width: 60px;
        text-align: center;
    }

    .custom-matriz-table .col-programa {
        min-width: 120px;
        max-width: 150px;
    }

    .custom-matriz-table .col-origen {
        min-width: 150px;
        max-width: 200px;
    }

    .custom-matriz-table .col-cuenta {
        min-width: 150px;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .custom-matriz-table .mud-table-container {
        min-width: 2000px;
    }

    .mud-table-row {
        cursor: pointer;
    }
</style>
