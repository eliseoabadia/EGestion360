@page "/configuracion/contabilidad/tipo-polizas"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoPolizaResponse, TipoPolizaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Pólizas"
                    Subtitle="Catálogo de tipos de pólizas"
                    Icon="@Icons.Material.Filled.Description"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="TipoPolizaResponse"
                      @ref="table"
                      Title="Lista de Tipos de Pólizas"
                      SearchPlaceholder="Buscar por descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
        <MudTh><MudTableSortLabel SortLabel="PkidTipoPoliza" T="TipoPolizaResponse">ID</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoPolizaResponse">Descripción</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="Activo" T="TipoPolizaResponse">Activo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="TipoPolizaResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoPoliza))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoPoliza))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoPoliza</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoPolizaResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Tipo_Polizas";

    protected override Type CreateDialogType => typeof(TipoPolizaDialog);
    protected override Type EditDialogType => typeof(TipoPolizaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoPolizaResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoPolizaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoPoliza,
            Descripcion = u.Descripcion,
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el tipo de póliza";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
