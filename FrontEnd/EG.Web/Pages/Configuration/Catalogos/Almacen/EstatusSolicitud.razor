@page "/configuracion/almacen/estatus_solicitud"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<EstatusSolicitudResponse, EstatusSolicitudResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Estatus de Solicitudes"
                    Subtitle="Gestión del catálogo de estatus"
                    Icon="@Icons.Material.Filled.Info"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericTable TItem="EstatusSolicitudResponse"
                      @ref="table"
                      Title="Lista de Estatus"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidEstatusSolicitud" T="EstatusSolicitudResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="EstatusSolicitudResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Color" T="EstatusSolicitudResponse">Color</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="EstatusSolicitudResponse">Activo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaCreacion" T="EstatusSolicitudResponse">Fecha Creación</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="UsuarioCreacion" T="EstatusSolicitudResponse">Usuario Creación</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidEstatusSolicitud))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidEstatusSolicitud))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidEstatusSolicitud</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@item.Color</MudTd>
                <MudTd>@item.Activo</MudTd>
                <MudTd>@(item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "")</MudTd>
                <MudTd>@item.UsuarioCreacion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<EstatusSolicitudResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Estatus_Solicitud";

    protected override Type CreateDialogType => typeof(EstatusSolicitudDialog);
    protected override Type EditDialogType => typeof(EstatusSolicitudDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EstatusSolicitudResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EstatusSolicitudResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidEstatusSolicitud,
            Descripcion = u.Descripcion ?? string.Empty,
            Color = u.Color ?? string.Empty,
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}










