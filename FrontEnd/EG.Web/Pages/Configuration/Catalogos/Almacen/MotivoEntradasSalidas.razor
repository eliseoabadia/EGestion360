@page "/configuracion/almacen/motivo_entradas_salidas"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MotivoEsResponse, MotivoEsResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Motivo de Entradas y Salidas"
                    Subtitle="Gestión del catálogo de motivos"
                    Icon="@Icons.Material.Filled.List"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericTable TItem="MotivoEsResponse"
                      @ref="table"
                      Title="Lista de Motivos"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidMotivoEs" T="MotivoEsResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="MotivoEsResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="AplicaEntrada" T="MotivoEsResponse">Aplica Entrada</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="AplicaSalida" T="MotivoEsResponse">Aplica Salida</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="MotivoEsResponse">Activo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaCreacion" T="MotivoEsResponse">Fecha Creación</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="UsuarioCreacion" T="MotivoEsResponse">Usuario Creación</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidMotivoEs))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidMotivoEs))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidMotivoEs</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@item.AplicaEntrada</MudTd>
                <MudTd>@item.AplicaSalida</MudTd>
                <MudTd>@item.Activo</MudTd>
                <MudTd>@(item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "")</MudTd>
                <MudTd>@item.UsuarioCreacion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<MotivoEsResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Movimiento_Entrada_Salida";

    protected override Type CreateDialogType => typeof(MotivoEsDialog);
    protected override Type EditDialogType => typeof(MotivoEsDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MotivoEsResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MotivoEsResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMotivoEs,
            Descripcion = u.Descripcion ?? string.Empty,
            AplicaEntrada = u.AplicaEntrada ? "Sí" : "No",
            AplicaSalida = u.AplicaSalida ? "Sí" : "No",
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}




