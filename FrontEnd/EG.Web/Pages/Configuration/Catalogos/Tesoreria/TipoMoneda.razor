@page "/configuracion/tesoreria/tipo_moneda"
@using EG.Web.Models.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoMonedaResponse, TipoMonedaResponse>
<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Moneda" Subtitle="Gestión del catálogo de monedas" Icon="@Icons.Material.Filled.AttachMoney"
            CanCreate="@CanCreate" OnCreate="CreateItem" />
        <GenericTable TItem="TipoMonedaResponse" @ref="table"
            OnEntitySelected="OnEntitySelected" CanDelete="@CanDelete" CanUpdate="@CanUpdate" OnDelete="DeleteItem"
            OnEdit="EditItem" OnCreate="CreateItem" />
    </MudContainer>
</AccessVerification>
@code {
    private GenericTable<TipoMonedaResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Moneda";
    protected override Type CreateDialogType => typeof(TipoMonedaDialog);
    protected override Type EditDialogType => typeof(TipoMonedaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoMonedaResponse>);
    protected override string GetDefaultSortLabel() => "Codigo";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoMonedaResponse> items) =>
        items.Select(u => new { ID = u.PkidTipoMoneda, Codigo = u.Codigo, Simbolo = u.Simbolo, Descripcion = u.Descripcion, Activo = u.Activo ? "Sí" : "No" });
}













