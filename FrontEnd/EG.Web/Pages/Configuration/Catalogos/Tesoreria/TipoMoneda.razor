@page "/configuracion/tesoreria/Tipo_Moneda"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoMonedaResponse, TipoMonedaResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Moneda" Subtitle="Gestion del catalogo de monedas" Icon="@Icons.Material.Filled.AttachMoney"
            CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericTable TItem="TipoMonedaResponse"
                      @ref="table"
                      Title="Lista de Monedas"
                      SearchPlaceholder="Buscar por codigo ISO, descripcion o pais..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoMoneda" T="TipoMonedaResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CodigoIso4217" T="TipoMonedaResponse">Codigo ISO</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Simbolo" T="TipoMonedaResponse">Simbolo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoMonedaResponse">Descripcion</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="PaisNombre" T="TipoMonedaResponse">Pais</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Decimales" T="TipoMonedaResponse">Decimales</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoMoneda))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoMoneda))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoMoneda</MudTd>
                <MudTd>@item.CodigoIso4217</MudTd>
                <MudTd>@item.Simbolo</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(item.PaisNombre) ? "-" : item.PaisNombre)</MudTd>
                <MudTd>@item.Decimales</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoMonedaResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Moneda";
    protected override Type CreateDialogType => typeof(TipoMonedaDialog);
    protected override Type EditDialogType => typeof(TipoMonedaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoMonedaResponse>);
    protected override string GetDefaultSortLabel() => "CodigoIso4217";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoMonedaResponse> items) =>
        items.Select(u => new
        {
            ID = u.PkidTipoMoneda,
            CodigoISO = u.CodigoIso4217,
            u.Simbolo,
            u.Descripcion,
            Pais = u.PaisNombre,
            u.Decimales,
        });

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }
}
