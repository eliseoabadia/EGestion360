@page "/configuracion/tesoreria/Tipo_Cambio"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoCambioResponse, TipoCambioResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Cambio"
                    Subtitle="Gestión del catálogo de tipos de cambio"
                    Icon="@Icons.Material.Filled.CurrencyExchange"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="TipoCambioResponse"
                      @ref="table"
                      Title="Lista de Tipos de Cambio"
                      SearchPlaceholder="Buscar por moneda..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoCambio" T="TipoCambioResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="MonedaCodigo" T="TipoCambioResponse">Moneda</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="MonedaDescripcion" T="TipoCambioResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Cantidad" T="TipoCambioResponse">Cantidad</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Fecha" T="TipoCambioResponse">Fecha</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="TipoCambioResponse">Activo</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoCambio))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoCambio))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoCambio</MudTd>
                <MudTd>@item.MonedaCodigo</MudTd>
                <MudTd>@item.MonedaDescripcion</MudTd>
                <MudTd>@item.Cantidad.ToString("N4")</MudTd>
                <MudTd>@item.Fecha.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@item.Activo</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoCambioResponse> table = null!;

    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Cambio";

    protected override Type CreateDialogType => typeof(TipoCambioDialog);
    protected override Type EditDialogType => typeof(TipoCambioDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoCambioResponse>);

    protected override string GetDefaultSortLabel() => "Fecha";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoCambioResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoCambio,
            Moneda = u.MonedaCodigo ?? string.Empty,
            Descripcion = u.MonedaDescripcion ?? string.Empty,
            Cantidad = u.Cantidad,
            Fecha = u.Fecha.ToString("dd/MM/yyyy"),
            Activo = u.Activo ? "Sí" : "No"
        });
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
