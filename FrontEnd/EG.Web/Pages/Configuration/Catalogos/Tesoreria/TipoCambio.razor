@page "/configuracion/tesoreria/Tipo_Cambio"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoCambioResponse, TipoCambioResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Cambio"
                    Subtitle="Gestión del catálogo de tipos de cambio"
                    Icon="@Icons.Material.Filled.CurrencyExchange"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericTable TItem="TipoCambioResponse"
                      @ref="table">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoCambio" T="TipoCambioResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Codigo" T="TipoCambioResponse">Código</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoCambioResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Valor" T="TipoCambioResponse">Valor</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="TipoCambioResponse">Activo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaCreacion" T="TipoCambioResponse">Fecha Creación</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="UsuarioCreacion" T="TipoCambioResponse">Usuario Creación</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoCambio))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoCambio))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoCambio</MudTd>
                <MudTd>@item.Codigo</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@item.Valor</MudTd>
                <MudTd>@item.Activo</MudTd>
                <MudTd>@item.FechaCreacion</MudTd>
                <MudTd>@item.UsuarioCreacion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoCambioResponse> table = null!;

    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Cambio";

    protected override Type CreateDialogType => typeof(TipoCambioDialog);
    protected override Type EditDialogType => typeof(TipoCambioDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoCambioResponse>);

    protected override string GetDefaultSortLabel() => "Codigo";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoCambioResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoCambio,
            Codigo = u.Codigo ?? string.Empty,
            Descripcion = u.Descripcion ?? string.Empty,
            Valor = u.Valor,
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}






