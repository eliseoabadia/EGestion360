@page "/configuracion/tesoreria/tipo_pago"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoPagoResponse, TipoPagoResponse>
<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Pago" Subtitle="Gestión del catálogo de tipos de pago" Icon="@Icons.Material.Filled.Payment"
            CanCreate="@CanCreate" OnCreate="CreateItem" />
        <GenericTable TItem="TipoPagoResponse" @ref="table">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoPago" T="TipoPagoResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Codigo" T="TipoPagoResponse">Código</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoPagoResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="TipoPagoResponse">Activo</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoPago))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoPago))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoPago</MudTd>
                <MudTd>@item.Codigo</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@item.Activo</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>
@code {
    private GenericTable<TipoPagoResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Pago";
    protected override Type CreateDialogType => typeof(TipoPagoDialog);
    protected override Type EditDialogType => typeof(TipoPagoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoPagoResponse>);
    protected override string GetDefaultSortLabel() => "Codigo";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoPagoResponse> items) =>
        items.Select(u => new { ID = u.PkidTipoPago, Codigo = u.Codigo, Descripcion = u.Descripcion, Activo = u.Activo ? "Sí" : "No" });
}













