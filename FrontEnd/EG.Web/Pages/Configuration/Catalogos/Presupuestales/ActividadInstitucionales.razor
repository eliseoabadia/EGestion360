@page "/configuracion/presupuestales/clave-programa/actividad-institucional"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ActividadInstitucionalResponse, ActividadInstitucionalResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Actividades Institucionales"
                    Subtitle="Catálogo de actividades institucionales"
                    Icon="@Icons.Material.Filled.PlaylistAddCheck"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="ActividadInstitucionalResponse"
                      @ref="table"
                      Title="Lista de Actividades Institucionales"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidActividadInstitucional" T="ActividadInstitucionalResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="ActividadInstitucionalResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="ActividadInstitucionalResponse">Descripción</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidActividadInstitucional))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidActividadInstitucional))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidActividadInstitucional</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<ActividadInstitucionalResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Actividad_Institucional";

    protected override Type CreateDialogType => typeof(ActividadInstitucionalDialog);
    protected override Type EditDialogType => typeof(ActividadInstitucionalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ActividadInstitucionalResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ActividadInstitucionalResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidActividadInstitucional,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la actividad institucional";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
