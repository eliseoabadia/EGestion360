@page "/configuracion/presupuestales/programas-presupuesta-old"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ProgramaPresupuestalResponse, ProgramaPresupuestalResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Programas Presupuestales"
                    Subtitle="Catálogo de programas presupuestales"
                    Icon="@Icons.Material.Filled.Event"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="ProgramaPresupuestalResponse"
                      @ref="table"
                      Title="Lista de Programas Presupuestales"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidPp" T="ProgramaPresupuestalResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="ProgramaPresupuestalResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="ProgramaPresupuestalResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="ProgramaPresupuestalResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidPp))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidPp))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidPp</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<ProgramaPresupuestalResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Programa_Presupuestal";

    protected override Type CreateDialogType => typeof(ProgramaPresupuestalDialog);
    protected override Type EditDialogType => typeof(ProgramaPresupuestalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ProgramaPresupuestalResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ProgramaPresupuestalResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidPp,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            Activo = u.Activo
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el programa presupuestal";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
