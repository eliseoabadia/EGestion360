@page "/configuracion/presupuestales/grupo-funcional-dialog"
@using EG.Web.Models.Presupuestales
@using MudBlazor
@inject IGenericCrudService<GfResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="GfResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Medium"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="GfResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle">
        <MudTextField @bind-Value="item.Clave"
                      Label="Clave"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-3"
                      Required="true"
                      For="@(() => item.Clave)" />

        <MudTextField @bind-Value="item.Descripcion"
                      Label="Descripción"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-3"
                      Required="true"
                      For="@(() => item.Descripcion)" />

        <MudSwitch T="bool" 
                   @bind-Value="item.Activo" 
                   Label="Activo" 
                   Color="Color.Primary" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<GfResponse> form = null!;
    private GfResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Grupo Funcional" : "Nuevo Grupo Funcional";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        var result = await Service.GetByIdAsync(Id.Value);
        if (result != null && result.Success && result.Data != null)
        {
            item = result.Data;
        }
    }

    private async Task GuardarCambiosAsync()
    {
        MudDialog.Close(item);
    }
}
