@page "/configuracion/presupuestales/grupo-funcional"
@using EG.Web.Models.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<GfResponse, GfResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Grupos Funcionales"
                    Subtitle="Gestión del catálogo de grupos funcionales"
                    Icon="@Icons.Material.Filled.Category"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem" />

        <GenericTable TItem="GfResponse"
                      @ref="table"
                      Items="_items"
                      OnEntitySelected="OnEntitySelected"
                      CanDelete="@CanDelete"
                      CanUpdate="@CanUpdate"
                      OnDelete="DeleteItem"
                      OnEdit="EditItem"
                      OnCreate="CreateItem" />
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<GfResponse> table = null!;

    protected override string ModuleName => "Presupuestales";
    protected override string SubModuleName => "GrupoFuncional";

    protected override Type CreateDialogType => typeof(GrupoFuncionalDialog);
    protected override Type EditDialogType => typeof(GrupoFuncionalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<GfResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<GfResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidGf,
            Clave = u.Clave,
            Descripcion = u.Descripcion ?? string.Empty,
            Activo = u.Activo ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}
