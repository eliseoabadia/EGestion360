@page "/configuracion/presupuestales/clave-programa/sector"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<SectorResponse, SectorResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Sectores"
                    Subtitle="Catálogo de sectores"
                    Icon="@Icons.Material.Filled.Business"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="SectorResponse"
                      @ref="table"
                      Title="Lista de Sectores"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidSector" T="SectorResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="SectorResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="SectorResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="SectorResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidSector))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidSector))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidSector</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<SectorResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Sector";

    protected override Type CreateDialogType => typeof(SectorDialog);
    protected override Type EditDialogType => typeof(SectorDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SectorResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SectorResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidSector,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            Activo = u.Activo
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el sector";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
