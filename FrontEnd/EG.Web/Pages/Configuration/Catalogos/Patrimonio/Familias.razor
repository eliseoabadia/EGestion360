@page "/configuracion/patrimonio/familias"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<FamiliaResponse, FamiliaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Familias"
                    Subtitle="Catálogo de familias"
                    Icon="@Icons.Material.Filled.Category"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="FamiliaResponse"
                  @ref="table"
                  Title="Lista de Familias"
                  SearchPlaceholder="Buscar por descripción o clave..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidFamilia" T="FamiliaResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="FamiliaResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="FamiliaResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="FamiliaResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Visible="@CanUpdate"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                    OnClick="@(() => EditItem(item.PkidFamilia))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Visible="@CanDelete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                    OnClick="@(() => DeleteItem(item.PkidFamilia))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidFamilia</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo == true ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo == true ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<FamiliaResponse> table = null!;

    protected override string ModuleName => "Patrimonio";
    protected override string SubModuleName => "Familia";

    protected override Type CreateDialogType => typeof(FamiliaDialog);
    protected override Type EditDialogType => typeof(FamiliaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<FamiliaResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<FamiliaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidFamilia,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            Activo = u.Activo ? "Sí" : "No"
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la familia";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
