@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Services

@inject IGenericCrudService<PersonaResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="PersonaResponse"
    Title="@dialogTitle"
    MaxWidth="MaxWidth.Medium"
    ActionText="@actionText"
    ProcessingText="@processingText"
    LoadingMessage="Cargando datos..."
    OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="PersonaResponse"
        @ref="form"
        ShowHeader="true"
        HeaderTitle="@dialogTitle">
        <MudTextField @bind-Value="item.Clave"
            Label="Clave"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.Clave)" />

        <MudTextField @bind-Value="item.Nombre"
            Label="Nombre"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            Required="true"
            For="@(() => item.Nombre)" />

        <MudTextField @bind-Value="item.Paterno"
            Label="Apellido Paterno"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.Paterno)" />

        <MudTextField @bind-Value="item.Materno"
            Label="Apellido Materno"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.Materno)" />

        <MudTextField @bind-Value="item.Rfc"
            Label="RFC"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.Rfc)" />

        <MudTextField @bind-Value="item.Curp"
            Label="CURP"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.Curp)" />

        <MudTextField @bind-Value="item.TelefonoMovil"
            Label="Teléfono Móvil"
            Variant="Variant.Outlined"
            FullWidth="true"
            Class="mb-3"
            For="@(() => item.TelefonoMovil)" />

        <MudSwitch T="bool" @bind-Value="item.Activo" Label="Activo" Color="Color.Primary" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PersonaResponse> form = null!;
    private PersonaResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Persona" : "Nueva Persona";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Persona actualizada correctamente" : "Persona creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}

