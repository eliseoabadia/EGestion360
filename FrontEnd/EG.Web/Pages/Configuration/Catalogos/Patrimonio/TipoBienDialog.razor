@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Services
@using System.Net.Http.Json
@using EG.Common.GenericModel

@inject IGenericCrudService<TipoBienResponse> Service
@inject HttpClient Http
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoBienResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.ExtraExtraLarge"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando catálogos..."
                 OnConfirm="GuardarCambiosAsync">

    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-8">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-3">Cargando catálogos...</MudText>
        </div>
    }
    else
    {
        <MudContainer Class="py-2">
            <MudGrid GutterSize="2" Spacing="2">

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Información General</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedGrupoText" ValueChanged="OnGrupoChanged"
                                     Label="Clave CUCOP (SICOP)" Variant="Variant.Outlined"
                                     SearchFunc="SearchGrupo" Dense="true"
                                     DebounceInterval="150" Required="true"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedNivelText" ValueChanged="OnNivelChanged"
                                     Label="Nivel" Variant="Variant.Outlined"
                                     SearchFunc="SearchNivel" Dense="true"
                                     DebounceInterval="150" Required="false"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CodigoClave"
                                  Label="Código o Clave"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  RequiredError="El código es requerido" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.Identificador"
                                  Label="Identificador de Almacén"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="item.TipoBienDescripcion"
                                  Label="Descripción"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  RequiredError="La descripción es requerida" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedPartidaText" ValueChanged="OnPartidaChanged"
                                     Label="Partida" Variant="Variant.Outlined"
                                     SearchFunc="SearchPartida" Dense="true"
                                     DebounceInterval="150" Required="false"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedCuentaText" ValueChanged="OnCuentaChanged"
                                     Label="Cuenta Contable" Variant="Variant.Outlined"
                                     SearchFunc="SearchCuenta" Dense="true"
                                     DebounceInterval="150" Required="false"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Unidades y Medidas</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedUnidadText" ValueChanged="OnUnidadChanged"
                                     Label="Unidades" Variant="Variant.Outlined"
                                     SearchFunc="SearchUnidad" Dense="true"
                                     DebounceInterval="150" Required="false"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Value="@_selectedUnidadEqText" ValueChanged="OnUnidadEqChanged"
                                     Label="Unidades Equivalente" Variant="Variant.Outlined"
                                     SearchFunc="SearchUnidadEq" Dense="true"
                                     DebounceInterval="150" Required="false"
                                     Virtualize="true" MaxItems="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CantidadEquivalente"
                                  Label="Cantidad Equivalente"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.Consecutivo"
                                  Label="Consecutivo"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Financiero y Control</MudText>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.DepreciacionAnual"
                                  Label="Depreciación Anual"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.TiempoVida"
                                  Label="Tiempo de Vida (Días)"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.Cuota"
                                  Label="Cuota"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.ExistenciaMinima"
                                  Label="Existencia Mínima"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.ExistenciaMaxima"
                                  Label="Existencia Máxima"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.Cabms"
                                  Label="CABMS"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.CucopPlus"
                                  Label="Cucop Plus"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCheckBox @bind-Value="item.ProveeduriaNac" Label="Proveeduría Nacional" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCheckBox @bind-Value="item.CatalogoBasico" Label="Catálogo Básico" />
                </MudItem>

                @if (Id.HasValue)
                {
                    <MudItem xs="12" class="mt-2">
                        <MudSwitch T="bool" @bind-Value="item.Activo" Label="Registro Activo" Color="Color.Success" Dense="true" />
                    </MudItem>
                }

            </MudGrid>
        </MudContainer>
    }
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private TipoBienResponse item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Tipo de Bien" : "Nuevo Tipo de Bien";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private bool _loading = true;

    private string _selectedGrupoText = string.Empty;
    private string _selectedNivelText = string.Empty;
    private string _selectedPartidaText = string.Empty;
    private string _selectedCuentaText = string.Empty;
    private string _selectedUnidadText = string.Empty;
    private string _selectedUnidadEqText = string.Empty;

    private List<LookupItem> _allGrupos = new();
    private List<LookupItem> _allNiveles = new();
    private List<LookupItem> _allPartidas = new();
    private List<LookupItem> _allCuentas = new();
    private List<LookupItem> _allUnidades = new();

    private const int MaxItemsPerCombo = 500;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogosAsync();
        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
        _loading = false;
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            var tasks = new[]
            {
                LoadCatalogAsync("api/GrupoBien/GetLookup", x => _allGrupos = x),
                LoadCatalogAsync("api/Nivel/GetLookup", x => _allNiveles = x),
                LoadCatalogAsync("api/Partida/GetLookup", x => _allPartidas = x),
                LoadCatalogAsync("api/CuentaContable/GetLookup", x => _allCuentas = x),
                LoadCatalogAsync("api/Unidades/GetLookup", x => _allUnidades = x),
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar catálogos: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadCatalogAsync(string url, Action<List<LookupItem>> assign)
    {
        var result = await Http.GetFromJsonAsync<List<LookupItem>>(url);
        if (result != null)
            assign(result.Where(x => !string.IsNullOrEmpty(x.Text)).ToList());
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true)
            {
                var d = response.Data ?? response.Items?.FirstOrDefault();
                if (d != null)
                {
                    item = d;

                    var g = _allGrupos.FirstOrDefault(x => x.Id == d.FkidGrupoBienAlma);
                    if (g != null) _selectedGrupoText = g.Text ?? "";

                    var n = _allNiveles.FirstOrDefault(x => x.Id == d.FkidNivelAlma);
                    if (n != null) _selectedNivelText = n.Text ?? "";

                    var p = _allPartidas.FirstOrDefault(x => x.Id == d.FkidPartidaConta);
                    if (p != null) _selectedPartidaText = p.Text ?? "";

                    var c = _allCuentas.FirstOrDefault(x => x.Id == d.FkidCuentaContableConta);
                    if (c != null) _selectedCuentaText = c.Text ?? "";

                    var u = _allUnidades.FirstOrDefault(x => x.Id == d.FkidUnidadesAlma);
                    if (u != null) _selectedUnidadText = u.Text ?? "";

                    var ue = _allUnidades.FirstOrDefault(x => x.Id == d.FkidUnidadesEquivalente);
                    if (ue != null) _selectedUnidadEqText = ue.Text ?? "";
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    // Search functions
    private Task<IEnumerable<string>> SearchGrupo(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allGrupos
            : _allGrupos.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchNivel(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allNiveles
            : _allNiveles.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchPartida(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allPartidas
            : _allPartidas.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchCuenta(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allCuentas
            : _allCuentas.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchUnidad(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allUnidades
            : _allUnidades.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    private Task<IEnumerable<string>> SearchUnidadEq(string value, CancellationToken ct)
    {
        var items = string.IsNullOrWhiteSpace(value)
            ? _allUnidades
            : _allUnidades.Where(x => x.Text != null && x.Text.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(items.Select(x => x.Text ?? "").Distinct().Take(MaxItemsPerCombo).AsEnumerable());
    }

    // OnChanged handlers
    private void OnGrupoChanged(string value) { _selectedGrupoText = value; }
    private void OnNivelChanged(string value) { _selectedNivelText = value; }
    private void OnPartidaChanged(string value) { _selectedPartidaText = value; }
    private void OnCuentaChanged(string value) { _selectedCuentaText = value; }
    private void OnUnidadChanged(string value) { _selectedUnidadText = value; }
    private void OnUnidadEqChanged(string value) { _selectedUnidadEqText = value; }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            var g = _allGrupos.FirstOrDefault(x => x.Text == _selectedGrupoText);
            if (g != null) item.FkidGrupoBienAlma = g.Id; else item.FkidGrupoBienAlma = null;

            var n = _allNiveles.FirstOrDefault(x => x.Text == _selectedNivelText);
            if (n != null) item.FkidNivelAlma = n.Id; else item.FkidNivelAlma = null;

            var p = _allPartidas.FirstOrDefault(x => x.Text == _selectedPartidaText);
            if (p != null) item.FkidPartidaConta = p.Id; else item.FkidPartidaConta = null;

            var c = _allCuentas.FirstOrDefault(x => x.Text == _selectedCuentaText);
            if (c != null) item.FkidCuentaContableConta = c.Id; else item.FkidCuentaContableConta = null;

            var u = _allUnidades.FirstOrDefault(x => x.Text == _selectedUnidadText);
            if (u != null) item.FkidUnidadesAlma = u.Id; else item.FkidUnidadesAlma = null;

            var ue = _allUnidades.FirstOrDefault(x => x.Text == _selectedUnidadEqText);
            if (ue != null) item.FkidUnidadesEquivalente = ue.Id; else item.FkidUnidadesEquivalente = null;

            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Tipo de bien actualizado correctamente" : "Tipo de bien creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
