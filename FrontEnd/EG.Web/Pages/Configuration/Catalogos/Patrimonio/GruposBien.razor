@page "/configuracion/Patrimonio/Grupo_Bien"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<GrupoBienResponse, GrupoBienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Grupos de Bien"
                    Subtitle="Catálogo de grupos de bien"
                    Icon="@Icons.Material.Filled.ViewModule"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="GrupoBienResponse"
                      @ref="table"
                      Title="Lista de Grupos de Bien"
                      SearchPlaceholder="Buscar por descripción, familia o clave..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="FamiliaClave" T="GrupoBienResponse">Clave Familia</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FamiliaDescripcion" T="GrupoBienResponse">Familia</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GrupoBienClave" T="GrupoBienResponse">Clave Grupo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GrupoBienDescripcion" T="GrupoBienResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="ClaveCucop" T="GrupoBienResponse">CUCOP</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Activo" T="GrupoBienResponse">Activo</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidGrupoBien))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidGrupoBien))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.FamiliaClave</MudTd>
                <MudTd>@item.FamiliaDescripcion</MudTd>
                <MudTd>@item.GrupoBienClave</MudTd>
                <MudTd>@item.GrupoBienDescripcion</MudTd>
                <MudTd>@item.ClaveCucop</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                        @(item.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<GrupoBienResponse> table = null!;

    protected override string ModuleName => "Patrimonio";
    protected override string SubModuleName => "Grupo_Bien";

    protected override Type CreateDialogType => typeof(GrupoBienDialog);
    protected override Type EditDialogType => typeof(GrupoBienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<GrupoBienResponse>);

    protected override string GetDefaultSortLabel() => "GrupoBienDescripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<GrupoBienResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidGrupoBien,
            ClaveFamilia = u.FamiliaClave,
            Familia = u.FamiliaDescripcion ?? string.Empty,
            ClaveGrupo = u.GrupoBienClave,
            GrupoBien = u.GrupoBienDescripcion ?? string.Empty,
            CUCOP = u.ClaveCucop ?? string.Empty,
            Medida = u.Medida ?? string.Empty,
            Activo = u.Activo ? "Sí" : "No"
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.GrupoBienDescripcion ?? "el grupo de bien";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
