@using EG.Web.Contracs
@using EG.Web.Models.Almacen
@using MudBlazor

@inject IGenericCrudService<UnidadResponse> _service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="UnidadResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Small"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos de la unidad..."
                OnConfirm="GuardarCambiosAsync"
                OnCancel="HandleCancel">

    <BaseEntityForm TEntity="UnidadResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="unidad.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true"
                              Placeholder="Ej. Pieza, Metro, Litro, Kilogramo..." />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="unidad.Activo"
                           Color="Color.Primary"
                           Label="@(unidad.Activo ? "Activo" : "Inactivo")" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<UnidadResponse> form = null!;
    private UnidadResponse unidad = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Unidad" : "Nueva Unidad";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarUnidad();
        }
    }

    private async Task CargarUnidad()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                unidad = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar unidad: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Complete los campos requeridos", Severity.Warning);
            return;
        }

        try
        {
            ApiResponse<UnidadResponse> response;

            if (Id.HasValue)
            {
                response = await _service.UpdateAsync(unidad, unidad.PkidUnidades);
            }
            else
            {
                response = await _service.CreateAsync(unidad);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Unidad guardada exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}