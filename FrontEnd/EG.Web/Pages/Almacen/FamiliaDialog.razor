@using EG.Web.Contracts.Almacen
@using EG.Web.Models.Almacen
@using MudBlazor


@inject IGenericCrudService<FamiliaResponse> _service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="FamiliaResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Small"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos de la familia..."
                OnConfirm="GuardarCambiosAsync"
                OnCancel="HandleCancel">

    <BaseEntityForm TEntity="FamiliaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="familia.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="familia.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="familia.Activo"
                           Color="Color.Primary"
                           Label="@(familia.Activo == true ? "Activo" : "Inactivo")" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<FamiliaResponse> form = null!;
    private FamiliaResponse familia = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Familia" : "Nueva Familia";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarFamilia();
        }
    }

    private async Task CargarFamilia()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                familia = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar familia: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Complete los campos requeridos", Severity.Warning);
            return;
        }

        try
        {
            ApiResponse<FamiliaResponse> response;

            if (Id.HasValue)
            {
                response = await _service.UpdateAsync(familia, familia.PkidFamilia);
            }
            else
            {
                response = await _service.CreateAsync(familia);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Familia guardada exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
