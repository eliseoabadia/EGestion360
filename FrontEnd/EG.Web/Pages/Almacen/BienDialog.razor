                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<BienResponse> form = null!;
    private BienEditModel editModel = new();


    private readonly CultureInfo mxCulture = CultureInfo.GetCultureInfo("es-MX");
  
    private string dialogTitle => Id.HasValue ? "Editar Bien" : "Nuevo Bien";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarBien();
        }
    }

    private async Task CargarBien()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                // Mapear desde BienResponse a BienEditModel
                editModel = new BienEditModel
                {
                    PkidBien = response.Data.PkidBien,
                    Clave = response.Data.Clave,
                    ClaveAnt = response.Data.ClaveAnt,
                    Descripcion = response.Data.Descripcion,
                    Modelo = response.Data.Modelo,
                    Serie = response.Data.Serie,
                    Costo = response.Data.Costo,
                    FechaAdq = response.Data.FechaAdq,
                    Factura = response.Data.Factura,
                    Requisicion = response.Data.Requisicion,
                    Referencia = response.Data.Referencia,
                    Notas = response.Data.Notas,
                    Ubicacion = response.Data.Ubicacion,
                    Caracteristicas = response.Data.Caracteristicas,
                    Frente = response.Data.Frente,
                    Fondo = response.Data.Fondo,
                    Altura = response.Data.Altura,
                    Diametro = response.Data.Diametro,
                    VerificacionesDias = response.Data.VerificacionesDias,
                    MantenimientoDias = response.Data.MantenimientoDias,
                    Mantenimiento = response.Data.Mantenimiento,
                    Calibracion = response.Data.Calibracion,
                    ValorRescate = response.Data.ValorRescate,
                    ValorActual = response.Data.ValorActual,
                    Activo = response.Data.Activo,
                    // Las propiedades FK no vienen en BienResponse, deberán cargarse por separado
                    // o asumir que ya están incluidas si la vista las tiene
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar bien: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Complete los campos requeridos", Severity.Warning);
            return;
        }

        try
        {
            // Aquí deberías convertir editModel a un DTO de solicitud (BienDto)
            // y llamar al método correspondiente del servicio.
            // Como ejemplo, usamos un método ficticio:

            ApiResponse<BienResponse> response;

            if (Id.HasValue)
            {
                // response = await _service.UpdateAsync(bienDto, Id.Value);
                response = new ApiResponse<BienResponse> { Success = true, Message = "Simulado" };
            }
            else
            {
                // response = await _service.CreateAsync(bienDto);
                response = new ApiResponse<BienResponse> { Success = true, Message = "Simulado" };
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Bien guardado exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // Modelo local para edición (basado en BienDto)
    public class BienEditModel
    {
        public int PkidBien { get; set; }
        public int? FkidGrupoBienAlma { get; set; }
        public int FkidTipoBienAlma { get; set; }
        public int? FkidAreaSis { get; set; }
        public int? FkidProveedorSis { get; set; }
        public int? FkidEstadoBienAlma { get; set; }
        public int? FkidTipoPatrimonioAlma { get; set; }
        public int? FkidMarcaAlma { get; set; }
        public int? FkidMaterialAlma { get; set; }
        public int? FkidTipoAdqAlma { get; set; }
        public int? FkidPartidaConta { get; set; }
        public string Clave { get; set; }
        public string ClaveAnt { get; set; }
        public string Descripcion { get; set; }
        public string Modelo { get; set; }
        public string Serie { get; set; }
        public string Requisicion { get; set; }
        public string Factura { get; set; }
        public decimal? Costo { get; set; }
        public DateTime? FechaAdq { get; set; }
        public string Referencia { get; set; }
        public string Notas { get; set; }
        public string Ubicacion { get; set; }
        public string Caracteristicas { get; set; }
        public int? Frente { get; set; }
        public int? Fondo { get; set; }
        public int? Altura { get; set; }
        public int? Diametro { get; set; }
        public int VerificacionesDias { get; set; }
        public int MantenimientoDias { get; set; }
        public bool Mantenimiento { get; set; }
        public bool Calibracion { get; set; }
        public decimal? ValorRescate { get; set; }
        public decimal? ValorActual { get; set; }
        public bool Activo { get; set; }
    }
}