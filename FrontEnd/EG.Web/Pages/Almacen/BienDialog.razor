                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="editModel.Serie"
                                      Label="Serie"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="editModel.Ubicacion"
                                      Label="Ubicación"
