                                         Label="Mantenimiento (días)"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudSwitch @bind-Value="editModel.Mantenimiento"
                                   Color="Color.Primary"
                                   Label="Requiere Mantenimiento" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudSwitch @bind-Value="editModel.Calibracion"
                                   Color="Color.Primary"
