@page "/almacen/tipo-bien"
@using EG.Web.Models.Almacen
@using EG.Web.Models.Configuration
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoBienResponse, TipoBienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Bienes y Servicios"
                    Subtitle="Gestión del catálogo de bienes y servicios"
                    Icon="@Icons.Material.Filled.Category"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="TipoBienResponse"
                      @ref="table"
                      Title="Lista de Bienes y Servicios"
                      SearchPlaceholder="Buscar por código o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoBien" T="TipoBienResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CodigoArticulo" T="TipoBienResponse">Código</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="DescripcionArticulo" T="TipoBienResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GrupoBien" T="TipoBienResponse">Grupo Bien</MudTableSortLabel></MudTh>
                <MudTh>Estado</MudTh>
            </Header>

            <Row Context="tipo">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(tipo.PkidTipoBien))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(tipo.PkidTipoBien))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@tipo.PkidTipoBien</MudTd>
                <MudTd>@tipo.CodigoArticulo</MudTd>
                <MudTd>@tipo.DescripcionArticulo</MudTd>
                <MudTd>@tipo.GrupoBien</MudTd>
                <MudTd>
                    <MudBadge Color="@(tipo.Activo == true ? Color.Success : Color.Error)"
                              Variant="Variant.Filled"
                              Size="Size.Small">
                        @(tipo.Activo == true ? "Activo" : "Inactivo")
                    </MudBadge>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoBienResponse> table = null!;

    protected override string ModuleName => "almacen";
    protected override string SubModuleName => "tipo-bien";

    protected override Type CreateDialogType => typeof(TipoBienDialog);
    protected override Type EditDialogType => typeof(TipoBienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoBienResponse>);

    protected override string GetDefaultSortLabel() => "DescripcionArticulo";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoBienResponse> items)
    {
        return items.Select(d => new
        {
            ID = d.PkidTipoBien,
            Código = d.CodigoArticulo,
            Descripción = d.DescripcionArticulo,
            Grupo_Bien = d.GrupoBien ?? "",
            Exist_Mínima = d.ExistenciaMinima,
            Exist_Máxima = d.ExistenciaMaxima,
            Tiempo_Vida = d.TiempoVida,
            Cucop_Plus = d.CucopPlus ?? "",
            Estado = d.Activo ? "Activo" : "Inactivo"
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.DescripcionArticulo ?? "el bien/servicio";
        }
        catch
        {
            return "el bien/servicio";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        var response = await Service.GetByIdAsync(id);
        var nombre = response?.Data?.DescripcionArticulo ?? "el bien/servicio";

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["ItemName"] = nombre,
            ["DeleteFunc"] = new Func<Task<bool>>(() => EliminarTipoBien(id))
        };

        var dialog = await DialogService.ShowAsync(DeleteDialogType, $"Eliminar {SubModuleName}", parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        await dialog.Result;
    }

    private async Task<bool> EliminarTipoBien(int id)
    {
        var deleteResponse = await Service.DeleteAsync(id);
        if (deleteResponse?.Success == true)
        {
            Snackbar.Add(deleteResponse.Message ?? "Eliminado correctamente", Severity.Success);
            await table.ReloadData();
            return true;
        }
        else
        {
            Snackbar.Add(deleteResponse?.Message ?? "Error al eliminar", Severity.Error);
            return false;
        }
    }
}
