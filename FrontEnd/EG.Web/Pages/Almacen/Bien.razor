@page "/almacen/bien"
@using EG.Web.Models.Almacen
@using EG.Web.Models.Configuration
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<BienResponse, BienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Bienes"
                    Subtitle="Administra el inventario de bienes"
                    Icon="@Icons.Material.Filled.Inventory"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="BienResponse"
                      @ref="table"
                      Title="Lista de Bienes"
                      SearchPlaceholder="Buscar por clave, descripción o serie..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidBien" T="BienResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="BienResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="BienResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Modelo" T="BienResponse">Modelo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Serie" T="BienResponse">Serie</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Costo" T="BienResponse">Costo</MudTableSortLabel></MudTh>
                <MudTh>Estado</MudTh>
            </Header>

            <Row Context="bien">
                <MudTd>
                    <MudTooltip Text="Editar Bien">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(bien.PkidBien))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar Bien">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(bien.PkidBien))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@bien.PkidBien</MudTd>
                <MudTd>@bien.Clave</MudTd>
                <MudTd>@bien.Descripcion</MudTd>
                <MudTd>@bien.Modelo</MudTd>
                <MudTd>@bien.Serie</MudTd>
                <MudTd>@bien.Costo?.ToString("C")</MudTd>
                <MudTd>
                    <MudBadge Color="@(bien.Activo? Color.Success: Color.Error)"
                              Variant="Variant.Filled"
                              Size="Size.Small">
                        @(bien.Activo ? "Activo" : "Inactivo")
                    </MudBadge>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<BienResponse> table = null!;

    protected override string ModuleName => "almacen";
    protected override string SubModuleName => "bien";

    protected override Type CreateDialogType => typeof(BienDialog);
    protected override Type EditDialogType => typeof(BienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<BienResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<BienResponse> items)
    {
        return items.Select(d => new
        {
            ID = d.PkidBien,
            Clave = d.Clave,
            Descripción = d.Descripcion,
            Modelo = d.Modelo,
            Serie = d.Serie,
            Costo = d.Costo,
            Estado = d.Activo ? "Activo" : "Inactivo"
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Descripcion ?? "el bien";
        }
        catch
        {
            return "el bien";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        var response = await Service.GetByIdAsync(id);
        var nombre = response?.Data?.Descripcion ?? "el bien";

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["ItemName"] = nombre,
            ["DeleteFunc"] = new Func<Task<bool>>(() => EliminarBien(id))
        };

        var dialog = await DialogService.ShowAsync(DeleteDialogType, $"Eliminar {SubModuleName}", parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        await dialog.Result;
    }

    private async Task<bool> EliminarBien(int id)
    {
        var deleteResponse = await Service.DeleteAsync(id);
        if (deleteResponse?.Success == true)
        {
            Snackbar.Add(deleteResponse.Message ?? "Bien eliminado correctamente", Severity.Success);
            await table.ReloadData();
            return true;
        }
        else
        {
            Snackbar.Add(deleteResponse?.Message ?? "Error al eliminar", Severity.Error);
            return false;
        }
    }
}