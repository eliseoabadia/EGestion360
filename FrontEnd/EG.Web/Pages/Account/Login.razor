@page "/login"
@using EG.Web.Auth
@using EG.Web.Contracs
@using EG.Web.Models
@using EG.Web.Models.DTO
@using EG.Web.Models.Configuration
@using EG.Web.Services
@using MudBlazor


@inject IGenericCrudService<UsuarioSucursalResponse> _serviceUS
@inject IJSRuntime _jsRuntime

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-10">
    <MudPaper Class="pa-6 rounded-lg" Elevation="25">
        <MudIcon Icon="@Icons.Material.Filled.Business"
                 Color="Color.Primary"
                 Size="Size.Large"
                 Class="mx-auto d-block mb-2" />
        <MudText Typo="Typo.h4" Color="Color.Primary" Class="text-center mb-6">CoWorkSpace</MudText>
        <MudText Typo="Typo.h6" Class="text-center mb-6">Iniciar Sesión</MudText>
        <MudTextField @bind-Value="login.Usuario" Label="Correo Electrónico" Variant="Variant.Outlined"
                      FullWidth="true" Margin="Margin.Dense" Required="true"
                      HelperText="Por favor, ingresa tu correo electrónico." />

        <MudTextField @bind-Value="login.Password" Label="Contraseña" Variant="Variant.Outlined"
                      FullWidth="true" Margin="Margin.Dense" InputType="@PasswordInput"
                      Required="true" HelperText="Por favor, ingresa tu contraseña."
                      Class="mt-4" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon"
                      OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6 w-100"
                   OnClick="HandleLogin" Disabled="isLoading">
            @if (isLoading)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <text>Iniciar Sesión</text>
            }
        </MudButton>

        <MudText Class="text-center mt-4">
            ¿No tienes cuenta? <MudLink Href="/register" Color="Color.Primary">Regístrate aquí</MudLink>
        </MudText>
        <MudText Class="text-center mt-4">
            ¿Olvidaste tu contraseña? <MudLink Href="/resetPassword" Color="Color.Primary">Recuperala aquí</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>


@code {
    private LoginDTO login = new();
    public string Password { get; set; } = string.Empty;

    [Inject] private HttpClient HttpClient { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;
    [Inject] private ILoginService LoginService { get; set; } = null!;
    [Inject] private SucursalStateService SucursalStateService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;

    private bool isShow;
    private bool isLoading = false;
    //private List<SucursalResponse> sucursalesUsuario = new();
    
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override void OnInitialized()
    {
        Password = login.Password;
    }

    private void ButtonTestclick()
    {
        if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        
        UserResult result = await LoginService.LoginAsync(login.Usuario, login.Password);
        
        if (!result.PayrollId.Equals("0"))
        {
            await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.AccessToken);
            await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "userId", result.PkIdUsuario);
            await _jsRuntime.InvokeVoidAsync("localStorage.setItem", "userName", result.NombreUsuario);

            await ((AuthenticationProviderJWT)AuthenticationStateProvider).LoginAsync(result.AccessToken);

            var _sucursalesUsuario = await _serviceUS.GetAllPaginadoAsync(1, int.MaxValue, string.Empty, "Descripcion", SortDirection.Ascending);

			// var sucursalesUsuario = _sucursalesUsuario.Items.Where(s => s.PkIdUsuario == result.PkIdUsuario).ToList();

             var _result = await LoginService.GetSucursalesUsuarioAsync(result.PkIdUsuario);

            if (_sucursalesUsuario.TotalCount > 1)
            {
                var parameters = new DialogParameters
                {
                    { "Sucursales", _sucursalesUsuario }
                };
                
                var options = new DialogOptions 
                { 
                    CloseOnEscapeKey = false
                };
                
                var dialog = await DialogService.ShowAsync<SelectSucursalDialog>("Seleccionar Sucursal", parameters, options);
                var dialogResult = await dialog.Result;
                
                if (dialogResult.Canceled)
                {
                    isLoading = false;
                    return;
                }
                
                var selectedSucursal = dialogResult.Data as UsuarioSucursalResponse;
                if (selectedSucursal != null)
                {
                    Snackbar.Add($"Sucursal seleccionada: {selectedSucursal.NombreSucursal}", Severity.Success);
                    NavigationManager.NavigateTo("/", forceLoad: true);
                }
            }
            else if (_sucursalesUsuario.Items.Count == 1)
            {
                await SucursalStateService.SetSucursalAsync(_sucursalesUsuario.Items[0].IdSucursal, _sucursalesUsuario.Items[0].NombreSucursal);
                Snackbar.Add("¡Bienvenido!", Severity.Success);
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                Snackbar.Add("No tienes sucursales asignadas. Contacta al administrador.", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add("Correo o contraseña incorrectos.", Severity.Error);
        }
        
        isLoading = false;
    }
}
