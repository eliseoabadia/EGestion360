@page "/ALMAConteo"
@using EG.Web.Models.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Contracts
@inherits BaseCrudPage<ConteoResponse, ConteoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">

        <PageHeader Title="Mis Períodos de Conteo"
                    Subtitle="Gestión y seguimiento de los conteos cíclicos de inventario"
                    Icon="@Icons.Material.Filled.ListAlt"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => tableConteos.ReloadData()" />

        <MudTabs Elevation="2"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-4"
                 Class="mt-2"
                 ActivePanelIndexChanged="OnTabChanged">

            <!-- ========== TAB 1: CONTEOS ========== -->
            <MudTabPanel Text="Conteos" Icon="@Icons.Material.Filled.FactCheck" BadgeData="@TotalCount.ToString()" BadgeColor="Color.Primary">

                <GenericTable TItem="ConteoResponse"
                              @ref="tableConteos"
                              Title="Lista de Conteos Cíclicos"
                              SearchPlaceholder="Buscar por descripción, tipo de bien, período..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerData"
                              ExportFunc="ExportToExcel"
                              SearchString="@SearchString"
                              SearchStringChanged="(s) => SearchString = s"
                              OnSearch="OnSearch">

                    <Header>
                        <MudTh>Acciones</MudTh>
                        <MudTh><MudTableSortLabel SortLabel="PkidConteo" T="ConteoResponse">ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Descripcion" T="ConteoResponse">Descripción</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="DescripcionTipoBien" T="ConteoResponse">Tipo de Bien</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="NombrePeriodo" T="ConteoResponse">Período</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="FechaInicio" T="ConteoResponse">Fecha Inicio</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="EstatusPeriodo" T="ConteoResponse">Estatus</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="EstadoConteo" T="ConteoResponse">Estado</MudTableSortLabel></MudTh>
                        <MudTh>Cantidad Inventario</MudTh>
                        <MudTh>Lecturas</MudTh>
                        <MudTh>Personas</MudTh>
                    </Header>

                    <Row Context="conteo">
                        <MudTd>
                            <MudTooltip Text="Escanear Bienes">
                                <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="@(() => AbrirScanner(conteo))" />
                            </MudTooltip>
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Visible="@CanUpdate"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => EditItem(conteo.PkidConteo))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Visible="@CanDelete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteItem(conteo.PkidConteo))" />
                            </MudTooltip>
                            <MudTooltip Text="Ver Escaneos">
                                <MudIconButton Icon="@Icons.Material.Filled.List"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               OnClick="@(() => VerEscaneosDeConteo(conteo))" />
                            </MudTooltip>
                        </MudTd>
                        <MudTd>@conteo.PkidConteo</MudTd>
                        <MudTd>@conteo.Descripcion</MudTd>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@conteo.DescripcionTipoBien</MudText>
                                @if (!string.IsNullOrEmpty(conteo.CodigoClaveTipoBien))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@conteo.CodigoClaveTipoBien</MudText>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@conteo.NombrePeriodo</MudText>
                                @if (!string.IsNullOrEmpty(conteo.CodigoPeriodo))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@conteo.CodigoPeriodo</MudText>
                                }
                            </div>
                        </MudTd>
                        <MudTd>@conteo.FechaInicio.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="@GetEstatusColor(conteo.EstatusPeriodo)"
                                     Size="Size.Small">
                                @(conteo.EstatusPeriodo ?? "–")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="@GetEstadoConteoColor(conteo.EstadoConteo)"
                                     Size="Size.Small">
                                @(conteo.EstadoConteo ?? "–")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudText Align="Align.Right">@conteo.CantidadInventario.ToString("N2")</MudText>
                        </MudTd>
                        <MudTd>
                            <MudBadge Content="@conteo.TotalLecturas" Color="Color.Info" Overlap="true">
                                <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Size="Size.Small" />
                            </MudBadge>
                        </MudTd>
                        <MudTd>
                            <MudBadge Content="@conteo.PersonasParticipantes" Color="Color.Success" Overlap="true">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                            </MudBadge>
                        </MudTd>
                    </Row>
                </GenericTable>
            </MudTabPanel>

            <!-- ========== TAB 2: ESCANEOS / LECTURAS ========== -->
            <MudTabPanel Text="Escaneos / Lecturas" Icon="@Icons.Material.Filled.QrCodeScanner" BadgeData="@TotalEscaneos.ToString()" BadgeColor="Color.Secondary">

                @if (conteoSeleccionado != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                        <MudText>
                            Mostrando escaneos del conteo:
                            <strong>@conteoSeleccionado.Descripcion</strong>
                            (ID: @conteoSeleccionado.PkidConteo)
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                       Size="Size.Small"
                                       OnClick="LimpiarFiltroConteo"
                                       title="Ver todos los escaneos" />
                    </MudAlert>
                }

                <GenericTable TItem="ConteoDetalleEscaneoResponse"
                              @ref="tableEscaneos"
                              Title="Escaneos de Bienes"
                              SearchPlaceholder="Buscar por código de barras, bien, persona..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerDataEscaneos"
                              ExportFunc="ExportEscaneosToExcel"
                              SearchString="@SearchStringEscaneos"
                              SearchStringChanged="(s) => SearchStringEscaneos = s"
                              OnSearch="OnSearchEscaneos">

                    <Header>
                        <MudTh>ID</MudTh>
                        <MudTh><MudTableSortLabel SortLabel="CodigoBarras" T="ConteoDetalleEscaneoResponse">Código de Barras</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="PersonaNombre" T="ConteoDetalleEscaneoResponse">Persona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="PersonaClave" T="ConteoDetalleEscaneoResponse">Clave Persona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="BienClave" T="ConteoDetalleEscaneoResponse">Clave Bien</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="BienDescripcion" T="ConteoDetalleEscaneoResponse">Bien</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="BienSerie" T="ConteoDetalleEscaneoResponse">Serie</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="TipoBienDescripcion" T="ConteoDetalleEscaneoResponse">Tipo de Bien</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="FechaEscaneo" T="ConteoDetalleEscaneoResponse">Fecha Escaneo</MudTableSortLabel></MudTh>
                        <MudTh>Activo</MudTh>
                    </Header>

                    <Row Context="escaneo">
                        <MudTd>@escaneo.PkidDetalleEscaneo</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="Color.Dark" Size="Size.Small">
                                @escaneo.CodigoBarras
                            </MudChip>
                        </MudTd>
                        <MudTd>@escaneo.PersonaNombreCompleto</MudTd>
                        <MudTd>@escaneo.PersonaClave</MudTd>
                        <MudTd>@escaneo.BienClave</MudTd>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@escaneo.BienDescripcion</MudText>
                                @if (!string.IsNullOrEmpty(escaneo.BienModelo))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Modelo: @escaneo.BienModelo</MudText>
                                }
                            </div>
                        </MudTd>
                        <MudTd>@escaneo.BienSerie</MudTd>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@escaneo.TipoBienDescripcion</MudText>
                                @if (!string.IsNullOrEmpty(escaneo.TipoBienCodigoClave))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@escaneo.TipoBienCodigoClave</MudText>
                                }
                            </div>
                        </MudTd>
                        <MudTd>@escaneo.FechaEscaneo.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd>
                            <MudBadge Color="@(escaneo.Activo ? Color.Success : Color.Error)"
                                      Variant="Variant.Filled"
                                      Size="Size.Small">
                                @(escaneo.Activo ? "Activo" : "Inactivo")
                            </MudBadge>
                        </MudTd>
                    </Row>
                </GenericTable>
            </MudTabPanel>

        </MudTabs>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<ConteoResponse> tableConteos = null!;
    private GenericTable<ConteoDetalleEscaneoResponse> tableEscaneos = null!;

    [Inject] private IGenericCrudService<ConteoDetalleEscaneoResponse> EscaneoService { get; set; } = null!;

    protected override string ModuleName => "conteociclico";
    protected override string SubModuleName => "mis-periodos";

    protected override Type CreateDialogType => typeof(ConteoDialog);
    protected override Type EditDialogType => typeof(ConteoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ConteoResponse>);

    protected override string GetDefaultSortLabel() => "FechaInicio";

    // Escaneos state
    private List<ConteoDetalleEscaneoResponse> Escaneos { get; set; } = new();
    private int TotalEscaneos { get; set; }
    private string SearchStringEscaneos { get; set; } = string.Empty;
    private CancellationTokenSource SearchCtsEscaneos { get; set; } = new();
    private ConteoResponse? conteoSeleccionado;
    private int tabActivo = 0;

    private async Task OnTabChanged(int index)
    {
        tabActivo = index;
        if (index == 1 && tableEscaneos != null)
        {
            await tableEscaneos.ReloadData();
        }
    }

    private async Task<TableData<ConteoDetalleEscaneoResponse>> LoadServerDataEscaneos(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            int page = state.Page + 1;
            int pageSize = state.PageSize;
            string sortLabel = state.SortLabel ?? "FechaEscaneo";
            var sortDir = state.SortDirection;

            var response = await EscaneoService.GetAllPaginadoAsync(
                page, pageSize, SearchStringEscaneos, sortLabel, sortDir);

            if (response?.Success == true && response.Items != null)
            {
                // Filtrar por conteo seleccionado si aplica
                var items = response.Items.ToList();
                if (conteoSeleccionado != null)
                {
                    items = items.Where(e => e.FkidConteoAlma == conteoSeleccionado.PkidConteo).ToList();
                }
                Escaneos = items;
                TotalEscaneos = conteoSeleccionado != null ? items.Count : response.TotalCount;

                return new TableData<ConteoDetalleEscaneoResponse>
                {
                    Items = Escaneos,
                    TotalItems = TotalEscaneos
                };
            }

            return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar escaneos: {ex.Message}", Severity.Error);
            return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchEscaneos()
    {
        SearchCtsEscaneos?.Cancel();
        SearchCtsEscaneos = new CancellationTokenSource();
        try
        {
            await Task.Delay(500, SearchCtsEscaneos.Token);
            if (!SearchCtsEscaneos.Token.IsCancellationRequested && tableEscaneos != null)
                await tableEscaneos.ReloadData();
        }
        catch (TaskCanceledException) { }
    }

    private async Task VerEscaneosDeConteo(ConteoResponse conteo)
    {
        conteoSeleccionado = conteo;
        StateHasChanged();
        // Cambiar al tab de escaneos
        if (tableEscaneos != null)
            await tableEscaneos.ReloadData();
    }

    private async Task LimpiarFiltroConteo()
    {
        conteoSeleccionado = null;
        StateHasChanged();
        if (tableEscaneos != null)
            await tableEscaneos.ReloadData();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ConteoResponse> items)
    {
        return items.Select(c => new
        {
            ID = c.PkidConteo,
            Descripción = c.Descripcion ?? "",
            Tipo_Bien = c.DescripcionTipoBien ?? "",
            Código_Clave = c.CodigoClaveTipoBien ?? "",
            Período = c.NombrePeriodo ?? "",
            Código_Período = c.CodigoPeriodo ?? "",
            Estatus_Período = c.EstatusPeriodo ?? "",
            Estado_Conteo = c.EstadoConteo ?? "",
            Cantidad_Inventario = c.CantidadInventario,
            Total_Cantidad_Contada = c.TotalCantidadContada,
            Total_Lecturas = c.TotalLecturas,
            Personas_Participantes = c.PersonasParticipantes,
            Fecha_Inicio = c.FechaInicio.ToString("dd/MM/yyyy"),
            Fecha_Fin = c.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin definir",
            Activo = c.Activo ? "Sí" : "No"
        });
    }

    private async Task ExportEscaneosToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        try
        {
            var response = await EscaneoService.GetAllPaginadoAsync(1, int.MaxValue, SearchStringEscaneos, "FechaEscaneo", SortDirection.Descending);
            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add("No hay datos para exportar", Severity.Warning);
                return;
            }

            var items = response.Items.ToList();
            if (conteoSeleccionado != null)
                items = items.Where(e => e.FkidConteoAlma == conteoSeleccionado.PkidConteo).ToList();

            var excelData = items.Select(e => new
            {
                ID = e.PkidDetalleEscaneo,
                Conteo_ID = e.FkidConteoAlma,
                Código_Barras = e.CodigoBarras ?? "",
                Persona = e.PersonaNombreCompleto,
                Clave_Persona = e.PersonaClave ?? "",
                Clave_Bien = e.BienClave ?? "",
                Descripción_Bien = e.BienDescripcion ?? "",
                Serie = e.BienSerie ?? "",
                Modelo = e.BienModelo ?? "",
                Tipo_Bien = e.TipoBienDescripcion ?? "",
                Código_Tipo_Bien = e.TipoBienCodigoClave ?? "",
                Fecha_Escaneo = e.FechaEscaneo.ToString("dd/MM/yyyy HH:mm"),
                Activo = e.Activo ? "Sí" : "No"
            });

            using var ms = new MemoryStream();
            await ms.SaveAsAsync(excelData);
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"escaneos_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"✅ Exportación exitosa: {items.Count} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Descripcion ?? "el conteo";
        }
        catch
        {
            return "el conteo";
        }
    }

    protected override async Task ReloadData()
    {
        if (tableConteos != null)
        {
            await tableConteos.ReloadData();
            StateHasChanged();
        }
    }

    private Color GetEstatusColor(string? estatus) =>
        estatus?.ToLower() switch
        {
            "abierto" or "abierta" => Color.Success,
            "cerrado" or "cerrada" => Color.Error,
            "en proceso" or "proceso" => Color.Warning,
            "pendiente" => Color.Info,
            _ => Color.Default
        };

    private Color GetEstadoConteoColor(string? estado) =>
        estado?.ToLower() switch
        {
            "completado" or "completo" => Color.Success,
            "en proceso" => Color.Warning,
            "pendiente" or "iniciado" => Color.Info,
            "cerrado" => Color.Error,
            _ => Color.Default
        };

    private async Task AbrirScanner(ConteoResponse conteo)
    {
        var parameters = new DialogParameters
        {
            ["ConteoId"] = conteo.PkidConteo,
            ["PersonaId"] = 1,
            ["FkidTipoBienAlma"] = conteo.IdTipoBien ?? 0,
            ["CodigoClaveTipoBien"] = conteo.CodigoClaveTipoBien,
            ["DescripcionTipoBien"] = conteo.DescripcionTipoBien ?? "Sin tipo de bien"
        };

        var dialog = await DialogService.ShowAsync<AgregarBienScannerDialog>(
            $"Escanear Bienes - {conteo.Descripcion}",
            parameters,
            new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            });

        var result = await dialog.Result;
        if (result?.Data is true)
        {
            Snackbar.Add("Bienes agregados exitosamente", Severity.Success);
            await tableConteos.ReloadData();
        }
    }
}
