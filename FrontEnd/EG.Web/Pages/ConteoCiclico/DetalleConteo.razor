@page "/conteociclico/detalle/{PkidConteo:int}"
@using EG.Web.Models.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Services
@inject IGenericCrudService<ConteoDetalleResponse> ConteoService
@inject IGenericCrudService<ConteoDetalleEscaneoResponse> EscaneoService
@inject ISnackbar Snackbar

<MudContainer Class="px-2 pt-4 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
    <!-- En lugar de PageHeader, podemos usar una UI simplificada -->
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudItem>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 600;">
                            Detalle del Conteo Cíclico
                        </MudText>
                        @if(conteoActual != null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                                Descripción: <strong>@conteoActual.ConteoDescripcion</strong> | 
                                Tipo Bien: @conteoActual.TipoBienDescripcion | 
                                Inventario Inicial: @conteoActual.CantidadInventarioInicial
                            </MudText>
                        }
                    </MudStack>
                </MudItem>
                <MudItem>
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Href="/conteociclico/periodo">
                        Volver
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <!-- PESTAÑA: AGREGAR POR TOTALES -->
        <MudTabPanel Text="Carga por Totales" Icon="@Icons.Material.Filled.Functions">
            @if(conteoActual != null)
            {
                <MudPaper Class="pa-6 mx-auto mb-4" MaxWidth="MaxWidth.Medium" Elevation="3">
                    <MudText Typo="Typo.h6" Class="mb-4">Ingresar Cantidad Contada para el Tipo: @conteoActual.TipoBienDescripcion</MudText>
                    <MudDivider Class="mb-4" />
                    
                    <MudNumericField @bind-Value="cantidadTotal" 
                                     Label="Total Encontrado" 
                                     Variant="Variant.Outlined" 
                                     Min="0.0m" 
                                     Max="1000000.0m"
                                     Format="N2"
                                     HelperText="Ingrese la suma o cantidad física exacta de bienes encontrados." />
                                     
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Class="mt-4"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="GuardarTotales">
                        Guardar Conteo Total
                    </MudButton>
                </MudPaper>
            }
        </MudTabPanel>

        <!-- PESTAÑA: AGREGAR POR ESCANEO -->
        <MudTabPanel Text="Escaneo Individual" Icon="@Icons.Material.Filled.QrCodeScanner">
            <MudPaper Class="pa-4 mb-4" Elevation="3">
                <MudGrid AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="8" md="6">
                        <MudTextField @bind-Value="codigoEscaneado" 
                                      Label="Código de Barras / QR" 
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.QrCode"
                                      OnKeyDown="ProcesarEnterEnBusqueda"
                                      Immediate="true"
                                      AutoFocus="true"/>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   Size="Size.Large"
                                   FullWidth="true"
                                   OnClick="AgregarPorEscaneo">
                            Escanear
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <GenericTable TItem="ConteoDetalleEscaneoResponse"
                          @ref="tableEscaneos"
                          Title="Bienes Escaneados"
                          SearchPlaceholder="Buscar registro escaneado..."
                          ShowExportButton="true"
                          ServerDataFunc="LoadEscaneosData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="(s) => SearchString = s"
                          OnSearch="OnSearch">
                <Header>
                    <MudTh>Acciones</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="CodigoBarras" T="ConteoDetalleEscaneoResponse">Código de Barras</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="BienDescripcion" T="ConteoDetalleEscaneoResponse">Descripción del Bien</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FechaEscaneo" T="ConteoDetalleEscaneoResponse">Fecha Escaneo</MudTableSortLabel></MudTh>
                </Header>

                <Row Context="escaneo">
                    <MudTd>
                        <MudTooltip Text="Eliminar Registro">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => EliminarEscaneo(escaneo.PkidDetalleEscaneo))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd>@escaneo.CodigoBarras</MudTd>
                    <MudTd>@escaneo.BienDescripcion</MudTd>
                    <MudTd>@escaneo.FechaEscaneo.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                </Row>
            </GenericTable>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    [Parameter]
    public int PkidConteo { get; set; }

    private ConteoDetalleResponse? conteoActual;
    private decimal cantidadTotal = 0.0m;
    
    // Variables para escaneo
    private string codigoEscaneado = string.Empty;
    private GenericTable<ConteoDetalleEscaneoResponse> tableEscaneos = null!;
    protected string SearchString { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Cargar datos actuales del conteo
        await CargarConteoGeneral();
    }

    private async Task CargarConteoGeneral()
    {
        try
        {
            var result = await ConteoService.GetByIdAsync(PkidConteo);
            if (result != null && result.Success && result.Data != null)
            {
                conteoActual = result.Data;
                cantidadTotal = conteoActual.CantidadContada;
            }
            else
            {
                Snackbar.Add("No se pudo obtener la informacion del conteo.", Severity.Error);
            }
        }
        catch(Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // Guardado rápido "Por Totales"
    private async Task GuardarTotales()
    {
        if (conteoActual == null) return;

        // Actualizamos de un solo golpe la cantidad total en este detalle ConteoDetalle
        conteoActual.CantidadContada = cantidadTotal;
        var result = await ConteoService.UpdateAsync(conteoActual, conteoActual.PkidConteo);
        
        if (result.Success)
        {
            Snackbar.Add("Cantidad Total guardada exitosamente.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Error al guardar cantidad: {result.Message}", Severity.Error);
        }
    }

    // ============= LÓGICA PARA ESCANEO ======================
    private async void ProcesarEnterEnBusqueda(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AgregarPorEscaneo();
        }
    }

    private async Task AgregarPorEscaneo()
    {
        if(string.IsNullOrWhiteSpace(codigoEscaneado)) return;

        // Aquí se crearía el registro en VwConteoDetalleEscaneo
        var nuevoEscaneo = new ConteoDetalleEscaneoResponse
        {
            FkidConteoAlma = PkidConteo,
            CodigoBarras = codigoEscaneado,
            FechaEscaneo = DateTime.Now,
            Activo = true
        };

        var response = await EscaneoService.CreateAsync(nuevoEscaneo);
        if(response.Success)
        {
            Snackbar.Add("Bien incorporado al conteo exitosamente.", Severity.Success);
            codigoEscaneado = string.Empty;
            await tableEscaneos.ReloadData();
            
            // Actualizamos la cantidad contada en la pantalla tras añadir localmente un item
            cantidadTotal++; 
            StateHasChanged();
        }
        else
        {
            Snackbar.Add($"No se pudo guardar el escaneo: {response.Message}", Severity.Warning);
        }
    }

    private async Task EliminarEscaneo(int pkidEscaneo)
    {
        var result = await EscaneoService.DeleteAsync(pkidEscaneo);
        if (result.Success)
        {
            Snackbar.Add("Registro escaneado eliminado.", Severity.Info);
            await tableEscaneos.ReloadData();
        }
        else
        {
            Snackbar.Add($"Error al eliminar: {result.Message}", Severity.Error);
        }
    }

    private async Task<TableData<ConteoDetalleEscaneoResponse>> LoadEscaneosData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            // Filtro custom que obtiene solo los de esta tabla
            // Supongamos que el API acepta un query string "conteoId" y "SearchString"
            var response = await EscaneoService.GetAllPaginadoAsync(
                state.Page + 1,
                state.PageSize,
                SearchString,
                state.SortLabel ?? "FechaEscaneo",
                state.SortDirection
            );

            // TODO: si esto devuelve todo, tal vez haya que filtrarlo.
            // Para el DEMO, usamos la respuesta directo asumiendo mapeo en backend o filtrado in-memory como fallback
            var items = response?.Items?.Where(x => x.FkidConteoAlma == PkidConteo).ToList() ?? new List<ConteoDetalleEscaneoResponse>();

            return new TableData<ConteoDetalleEscaneoResponse>
            {
                Items = items,
                TotalItems = response?.TotalCount ?? 0
            };
        }
        catch
        {
            return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };
        }
    }

    protected virtual async Task OnSearch() => await tableEscaneos.ReloadData();

    protected virtual Task ExportToExcel()
    {
        // ... Logica basica de exportacion de escaneos
        return Task.CompletedTask;
    }
}
