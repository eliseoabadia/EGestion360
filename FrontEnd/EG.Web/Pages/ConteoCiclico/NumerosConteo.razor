@page "/numero-conteo"
@using EG.Web.Models.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NumeroConteoResponse, NumeroConteoResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Periodos de Conteo"
                    Subtitle="Administra los periodos de conteo cíclico"
                    Icon="@Icons.Material.Filled.FormatListNumbered"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="NumeroConteoResponse"
                      @ref="table"
                      Title="Lista de Periodos de Conteo"
                      SearchPlaceholder="Buscar por código, nombre..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="CodigoPeriodo" T="NumeroConteoResponse">Código</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Nombre" T="NumeroConteoResponse">Nombre</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TipoConteo" T="NumeroConteoResponse">Tipo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Sucursal" T="NumeroConteoResponse">Sucursal</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaInicio" T="NumeroConteoResponse">Fecha Inicio</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaFin" T="NumeroConteoResponse">Fecha Fin</MudTableSortLabel></MudTh>
                <MudTh>Estado</MudTh>
            </Header>

            <Row Context="pc">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="@(() => EditItem(pc.PkidPeriodoConteo))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Visible="@CanDelete"
                                       OnClick="@(() => DeleteItem(pc.PkidPeriodoConteo))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@pc.CodigoPeriodo</MudTd>
                <MudTd>@pc.Nombre</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" 
                             Color="@(pc.TipoConteo.Contains("Anual") ? Color.Warning : Color.Info)">
                        @pc.TipoConteo
                    </MudChip>
                </MudTd>
                <MudTd>@pc.Sucursal</MudTd>
                <MudTd>@pc.FechaInicio.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@(pc.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(pc.Activo ? Color.Success : Color.Error)"
                             Variant="Variant.Filled">
                        @(pc.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                </MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<NumeroConteoResponse> table = null!;

    protected override string ModuleName => "configuracion";
    protected override string SubModuleName => "numero-conteo";
    protected override Type CreateDialogType => typeof(NumeroConteoDialog);
    protected override Type EditDialogType => typeof(NumeroConteoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NumeroConteoResponse>);
    protected override string GetDefaultSortLabel() => "Nombre";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<NumeroConteoResponse> items) =>
        items.Select(d => new
        {
            Código = d.CodigoPeriodo,
            Nombre = d.Nombre,
            Descripcion = d.Descripcion,
            Tipo = d.TipoConteo,
            Sucursal = d.Sucursal,
            FechaInicio = d.FechaInicio.ToString("dd/MM/yyyy"),
            FechaFin = d.FechaFin?.ToString("dd/MM/yyyy") ?? "-",
            Estado = d.Activo ? "Activo" : "Inactivo"
        });
}
