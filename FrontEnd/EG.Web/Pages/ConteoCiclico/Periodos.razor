@page "/conteociclico/periodo"
@using EG.Web.Models.ConteoCiclico
@using EG.Web.Contracs.ConteoCiclico
@using EG.Web.Services.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Auth
@inject IPeriodoConteoService periodoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationProviderJWT AuthProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
    <PageHeader Title="Periodos de Conteo Cíclico"
                Subtitle="Gestiona los períodos de conteo de inventario"
                Icon="@Icons.Material.Filled.CalendarMonth"
                CanCreate="@CanCreate"
                OnCreate="CreateItem"
                OnRefresh="() => table.ReloadData()" />

    <GenericTable TItem="PeriodoConteoResponse"
                  @ref="table"
                  Title="Lista de Periodos"
                  SearchPlaceholder="Buscar por código, nombre o sucursal..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

        <Header>
            <MudTh>Acciones</MudTh>
            <MudTh><MudTableSortLabel SortLabel="CodigoPeriodo" T="PeriodoConteoResponse">Código</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Nombre" T="PeriodoConteoResponse">Nombre</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="SucursalNombre" T="PeriodoConteoResponse">Sucursal</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="TipoConteoNombre" T="PeriodoConteoResponse">Tipo</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="EstatusNombre" T="PeriodoConteoResponse">Estatus</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="FechaInicio" T="PeriodoConteoResponse">Fecha Inicio</MudTableSortLabel></MudTh>
            <MudTh>Avance</MudTh>
        </Header>

        <Row Context="periodo">
            <MudTd>
                <MudTooltip Text="Ver Artículos">
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="@(() => VerArticulos(periodo.Id))" />
                </MudTooltip>
                <MudTooltip Text="Editar Periodo">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditItem(periodo.Id))" />
                </MudTooltip>
                <MudTooltip Text="Eliminar Periodo">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteItem(periodo.Id))" />
                </MudTooltip>
            </MudTd>
            <MudTd>@periodo.CodigoPeriodo</MudTd>
            <MudTd>@periodo.Nombre</MudTd>
            <MudTd>@periodo.SucursalNombre</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @periodo.TipoConteoNombre
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" 
                         Color="@GetEstatusColor(periodo.EstatusId)"
                         Variant="Variant.Filled">
                    @periodo.EstatusNombre
                </MudChip>
            </MudTd>
            <MudTd>@periodo.FechaInicio.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>
                <MudProgressLinear Value="@((double)(periodo.PorcentajeAvance ?? 0))" 
                                  Color="Color.Primary" 
                                  Size="Size.Small" 
                                  Class="my-1" />
                <MudText Typo="Typo.caption">@((periodo.PorcentajeAvance ?? 0).ToString("F1"))%</MudText>
            </MudTd>
        </Row>
    </GenericTable>
</MudContainer>

@code {
    private GenericTable<PeriodoConteoResponse> table = null!;

    private string SearchString { get; set; } = string.Empty;
    private bool Loading { get; set; }
    private bool CanCreate { get; set; } = true;
    private bool CanUpdate { get; set; } = true;
    private bool CanDelete { get; set; } = true;
    private bool CanExport { get; set; } = true;

    private string ModuleName => "conteociclico";
    private string SubModuleName => "periodo";

    protected override async Task OnInitializedAsync()
    {
        CanCreate = AuthProvider.HasPermission(ModuleName, SubModuleName, "new");
        CanUpdate = AuthProvider.HasPermission(ModuleName, SubModuleName, "update");
        CanDelete = AuthProvider.HasPermission(ModuleName, SubModuleName, "delete");
        CanExport = AuthProvider.HasPermission(ModuleName, SubModuleName, "CanExportToExcel");
    }

    private async Task<TableData<PeriodoConteoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var response = await periodoService.GetAllPaginadoAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                filtro: SearchString,
                sortLabel: state.SortLabel ?? "FechaInicio",
                sortDirection: state.SortDirection);

            if (response?.Success == true && response.Items != null)
            {
                return new TableData<PeriodoConteoResponse>
                {
                    Items = response.Items,
                    TotalItems = response.TotalCount
                };
            }

            return new TableData<PeriodoConteoResponse>
            {
                Items = new List<PeriodoConteoResponse>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            return new TableData<PeriodoConteoResponse>
            {
                Items = new List<PeriodoConteoResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task OnSearch()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private Color GetEstatusColor(int? estatusId)
    {
        return estatusId switch
        {
            1 => Color.Success,
            2 => Color.Warning,
            3 => Color.Default,
            4 => Color.Error,
            _ => Color.Default
        };
    }

    private void VerArticulos(int id)
    {
        if (id <= 0)
        {
            Snackbar.Add("ID de periodo no válido", Severity.Warning);
            return;
        }
        NavigationManager.NavigateTo($"/conteo-ciclico/articulos/{id}");
    }

    private async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<PeriodoConteoDialog>(
            "Crear Periodo",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await table.ReloadData();
            Snackbar.Add("Periodo creado correctamente", Severity.Success);
        }
    }

    private async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Id"] = id };
        var dialog = await DialogService.ShowAsync<PeriodoConteoDialog>(
            "Editar Periodo",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await table.ReloadData();
            Snackbar.Add("Periodo actualizado correctamente", Severity.Success);
        }
    }

    private async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        var response = await periodoService.GetByIdAsync(id);
        var periodoNombre = response?.Data?.Nombre ?? "el periodo";

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["ItemName"] = periodoNombre,
            ["DeleteFunc"] = new Func<int, Task<bool>>(async (deleteId) =>
            {
                var deleteResponse = await periodoService.DeleteAsync(deleteId);
                if (deleteResponse?.Success == true)
                {
                    Snackbar.Add(deleteResponse.Message ?? "Periodo eliminado", Severity.Success);
                    await table.ReloadData();
                    return true;
                }
                else
                {
                    Snackbar.Add(deleteResponse?.Message ?? "Error al eliminar", Severity.Error);
                    return false;
                }
            })
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog<PeriodoConteoResponse>>(
            "Eliminar Periodo",
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        await dialog.Result;
    }

    private async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var response = await periodoService.GetAllPaginadoAsync(
                page: 1,
                pageSize: int.MaxValue,
                filtro: SearchString);

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add("No hay datos para exportar", Severity.Warning);
                return;
            }

            var excelData = response.Items.Select(p => new
            {
                ID = p.Id,
                Código = p.CodigoPeriodo,
                Nombre = p.Nombre,
                Descripción = p.Descripcion,
                Sucursal = p.SucursalNombre,
                Tipo = p.TipoConteoNombre,
                Estatus = p.EstatusNombre,
                Fecha_Inicio = p.FechaInicio.ToString("dd/MM/yyyy"),
                Fecha_Fin = p.FechaFin?.ToString("dd/MM/yyyy") ?? "-",
                Total_Artículos = p.TotalArticulos,
                Avance_Porcentaje = p.PorcentajeAvance
            });

            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(excelData);

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"Periodos_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportación exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }
}
