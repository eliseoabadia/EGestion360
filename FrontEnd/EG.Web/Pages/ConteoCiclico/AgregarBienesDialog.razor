@using EG.Web.Models.Almacen
@using EG.Web.Contracs.Almacen
@using EG.Web.Contracs.ConteoCiclico
@using EG.Web.Services
@using EG.Web.Models.ConteoCiclico
@using SortDirection = MudBlazor.SortDirection

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" CloseOnEscapeKey="true">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h6">Agregar Bienes al Periodo</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancelar" />
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Seleccione los bienes que desea agregar al periodo de conteo
        </MudText>

        @if (_addedBienIds.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                <MudText Typo="Typo.caption">
                    <b>@_addedBienIds.Count</b> bien(es) ya agregados a este periodo
                </MudText>
            </MudAlert>
        }

        <MudGrid Class="mb-3">
            <MudItem xs="12" md="10">
                <MudTextField @bind-Value="_searchString"
                              Label="Buscar por código, descripción o serie"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              @ref="searchField"
                              OnKeyDown="OnSearchKeyDown" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="SearchBienes"
                           Disabled="@_isLoading">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                    Buscar
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudTable T="BienResponse"
                  Items="@_bienes"
                  Loading="@_isLoading"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  RowsPerPage="@_pageSize"
                  @bind-Page="@_currentPage"
                  SelectedItems="_selectedItems"
                  SelectedItemsChanged="OnSelectionChanged"
                  MultiSelection="true"
                  SelectOnRowClick="true"
                  ServerItemsLoading="_isLoading">
            <HeaderContent>
                <MudTh style="width: 50px;"></MudTh>
                <MudTh>Código</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh>Ubicación</MudTh>
                <MudTh>Serie</MudTh>
            </HeaderContent>
            <RowTemplate Context="bien">
                <MudTd>
                    @if (_addedBienIds.Contains(bien.PkidBien))
                    {
                        <MudTooltip Text="Ya agregado">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Success"
                                     Size="Size.Small" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudCheckBox Value="true" Dense="true" Disabled="true" />
                    }
                </MudTd>
                <MudTd>@bien.Clave</MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2">@bien.Descripcion</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @bien.Modelo | @bien.Serie
                    </MudText>
                </MudTd>
                <MudTd>@bien.Ubicacion</MudTd>
                <MudTd>@bien.Serie</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>
                    @(_hasSearched
                        ? "No se encontraron bienes con ese criterio"
                        : "Presione Enter o clic en Buscar para cargar los bienes")
                </MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Cargando...</MudText>
            </LoadingContent>
            <PagerContent>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(_hasSearched ? $"Total: {_totalCount} registros" : "")
                    </MudText>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }"
                                   RowsPerPageString="Por página" />
                </div>
            </PagerContent>
        </MudTable>

        @if (_selectedItems.Any())
        {
            <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">
                <MudText Typo="Typo.body2">
                    <b>@_selectedItems.Count</b> bien(es) seleccionado(s) para agregar
                </MudText>
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="Cancelar">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AgregarSeleccionados"
                   Disabled="@(!_selectedItems.Any() || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Agregando...</span>
            }
            else
            {
                <span>@(_selectedItems.Any() ? $"Agregar ({_selectedItems.Count})" : "Agregar")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int PeriodoId { get; set; }
    [Parameter] public HashSet<int>? ExistingBienIds { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    @inject IGenericCrudService<BienResponse> bienService
    @inject IArticuloConteoService articuloService
    @inject ISnackbar Snackbar

    private List<BienResponse> _bienes = new();
    private HashSet<BienResponse> _selectedItems = new();
    private HashSet<int> _addedBienIds = new();

    private MudTextField<string> searchField = new();
    private string _searchString = string.Empty;

    private bool _isLoading = false;
    private bool _isSaving = false;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private int _totalCount = 0;
    private bool _hasSearched = false;

    protected override async Task OnInitializedAsync()
    {
        if (ExistingBienIds != null)
        {
            _addedBienIds = new HashSet<int>(ExistingBienIds);
        }
        await Task.CompletedTask;
    }

    private async Task LoadBienes()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            // DEBUG: Verificar que el filtro se está enviando
            Console.WriteLine($"Buscando con filtro: '{_searchString}'");
            
            var response = await bienService.GetAllPaginadoAsync(
                page: _currentPage,
                pageSize: _pageSize,
                filtro: _searchString,
                sortLabel: "Descripcion",
                sortDirection: SortDirection.Ascending);

            if (response?.Success == true && response.Items != null)
            {
                _bienes = response.Items.ToList();
                _totalCount = response.TotalCount;
                _hasSearched = true;
                
                // DEBUG: Verificar resultados
                Console.WriteLine($"Encontrados {_bienes.Count} bienes");
            }
            else
            {
                _bienes = new List<BienResponse>();
                _totalCount = 0;
                Console.WriteLine("No se encontraron resultados o respuesta fue nula");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar bienes: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error en LoadBienes: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SearchBienes()
    {
        _currentPage = 1;
        await LoadBienes();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchBienes();
        }
    }

    private void OnSelectionChanged(HashSet<BienResponse> selectedItems)
    {
        _selectedItems = selectedItems;
    }

    private async Task AgregarSeleccionados()
    {
        if (!_selectedItems.Any())
        {
            Snackbar.Add("Seleccione al menos un bien", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            int agregados = 0;
            int errores = 0;

            foreach (var bien in _selectedItems)
            {
                var articuloConteo = new ArticuloConteoResponse
                {
                    PeriodoId = PeriodoId,
                    BienId = bien.PkidBien,
                    CodigoArticulo = bien.Clave ?? string.Empty,
                    DescripcionArticulo = bien.Descripcion ?? string.Empty,
                    Ubicacion = bien.Ubicacion ?? string.Empty,
                    Serie = bien.Serie ?? string.Empty,
                    Modelo = bien.Modelo ?? string.Empty,
                    ExistenciaSistema = 0,
                    Activo = true
                };

                var response = await articuloService.CreateAsync(articuloConteo);

                if (response?.Success == true)
                {
                    agregados++;
                    _addedBienIds.Add(bien.PkidBien);
                }
                else
                {
                    errores++;
                }
            }

            if (errores == 0)
            {
                Snackbar.Add($"Se agregaron {agregados} bien(es) al periodo", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Se agregaron {agregados} bien(es). {errores} errores.",
                    agregados > 0 ? Severity.Warning : Severity.Error);
            }

            _selectedItems.Clear();
            await LoadBienes();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al agregar bienes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
}
