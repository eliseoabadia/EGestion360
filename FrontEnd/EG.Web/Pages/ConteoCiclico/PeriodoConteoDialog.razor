@using EG.Web.Contracs.ConteoCiclico
@using EG.Web.Models.ConteoCiclico
@using MudBlazor

@inject IPeriodoConteoService _service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="PeriodoConteoResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos del periodo..."
                OnConfirm="GuardarCambiosAsync"
                OnCancel="HandleCancel">

    <BaseEntityForm TEntity="PeriodoConteoResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="periodo.CodigoPeriodo"
                              Label="Código de Periodo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El código es requerido" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="periodo.EstatusId"
                           T="int"
                           Label="Estatus"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="int" Value="1">Abierto</MudSelectItem>
                    <MudSelectItem T="int" Value="2">En Proceso</MudSelectItem>
                    <MudSelectItem T="int" Value="3">Cerrado</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="periodo.Nombre"
                              Label="Nombre del Periodo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre es requerido" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="periodo.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="2" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="periodo.TipoConteoId"
                           T="int"
                           Label="Tipo de Conteo"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="int" Value="1">Total</MudSelectItem>
                    <MudSelectItem T="int" Value="2">Parcial</MudSelectItem>
                    <MudSelectItem T="int" Value="3">Cíclico</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="periodo.MaximoConteosPorArticulo"
                                 Label="Máximo Conteos por Artículo"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="10"
                                 Required="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="fechaInicio"
                               Label="Fecha de Inicio"
                               Variant="Variant.Outlined"
                               Required="true"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="fechaFin"
                               Label="Fecha de Fin"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12">
                <MudSwitch @bind-Value="periodo.RequiereAprobacionSupervisor"
                           Color="Color.Primary"
                           Label="Requiere Aprobación de Supervisor" />
            </MudItem>

            <MudItem xs="12">
                <MudSwitch @bind-Value="periodo.Activo"
                           Color="Color.Primary"
                           Label="@(periodo.Activo == true ? "Activo" : "Inactivo")" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PeriodoConteoResponse> form = null!;
    private PeriodoConteoResponse periodo = new() { Activo = true, FechaInicio = DateOnly.FromDateTime(DateTime.Now) };

    private DateTime? fechaInicio
    {
        get => periodo.FechaInicio.ToDateTime(TimeOnly.MinValue);
        set => periodo.FechaInicio = DateOnly.FromDateTime(value ?? DateTime.Now);
    }

    private DateTime? fechaFin
    {
        get => periodo.FechaFin.HasValue ? periodo.FechaFin.Value.ToDateTime(TimeOnly.MinValue) : null;
        set => periodo.FechaFin = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private string dialogTitle => Id.HasValue ? "Editar Periodo" : "Nuevo Periodo";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarPeriodo();
        }
    }

    private async Task CargarPeriodo()
    {
        try
        {
            var response = await _service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                periodo = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar periodo: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Complete los campos requeridos", Severity.Warning);
            return;
        }

        try
        {
            ApiResponse<PeriodoConteoResponse> response;

            if (Id.HasValue)
            {
                response = await _service.UpdateAsync(periodo, periodo.Id);
            }
            else
            {
                response = await _service.CreateAsync(periodo);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Periodo guardado exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
