@using EG.Web.Models.ConteoCiclico
@using EG.Web.Models.Configuration
@using EG.Web.Contracs
@using MudBlazor

@inject IGenericCrudService<NumeroConteoResponse> _numeroConteoService
@inject IGenericCrudService<TipoConteoResponse> _tipoConteoService
@inject SucursalStateService _sucursalStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="NumeroConteoResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync"
                OnCancel="HandleCancel">

    <BaseEntityForm TEntity="NumeroConteoResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="numeroConteo.CodigoPeriodo"
                              Label="Código del Periodo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El código es requerido"
                              Disabled="@loading" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="numeroConteo.IdTipoConteo"
                           Label="Tipo de Conteo"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="El tipo de conteo es requerido"
                           Disabled="@loading"
                           Dense="true">
                    @foreach (var tipo in tiposConteo)
                    {
                        <MudSelectItem T="int?" Value="@tipo.Id">
                            @tipo.Nombre - @tipo.Descripcion
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="numeroConteo.Nombre"
                              Label="Nombre del Periodo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre es requerido"
                              Disabled="@loading" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Value="@sucursalNombre"
                             Label="Sucursal"
                             Variant="Variant.Outlined"
                             Disabled="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Business" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="numeroConteo.MaximoConteosPorArticulo"
                                Label="Máximo Conteos por Artículo"
                                Variant="Variant.Outlined"
                                Min="1"
                                Max="10"
                                Disabled="@loading" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="fechaInicio"
                               Label="Fecha de Inicio"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="La fecha de inicio es requerida"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@loading" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="fechaFin"
                               Label="Fecha de Fin"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@loading" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="numeroConteo.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="2"
                              Disabled="@loading" />
            </MudItem>

            <MudItem xs="12">
                <MudSwitch @bind-Value="numeroConteo.RequiereAprobacionSupervisor"
                           Color="Color.Primary"
                           Label="Requiere Aprobación de Supervisor"
                           Disabled="@loading" />
            </MudItem>

            <MudItem xs="12">
                <MudSwitch @bind-Value="numeroConteo.Activo"
                           Color="Color.Primary"
                           Label="@(numeroConteo.Activo ? "Activo" : "Inactivo")"
                           Disabled="@loading" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<NumeroConteoResponse> form = null!;
    private NumeroConteoResponse numeroConteo = new() 
    { 
        Activo = true, 
        MaximoConteosPorArticulo = 3,
        RequiereAprobacionSupervisor = false,
        IdEstatusPeriodo = 1 // Estatus por defecto: Pendiente/Abierto
    };
    private List<TipoConteoResponse> tiposConteo = new();
    private bool loading = false;
    private string sucursalNombre = "Cargando...";

    private string dialogTitle => Id.HasValue ? "Editar Periodo de Conteo" : "Nuevo Periodo de Conteo";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private DateTime? fechaInicio
    {
        get => numeroConteo.FechaInicio != default ? numeroConteo.FechaInicio.ToDateTime(TimeOnly.MinValue) : null;
        set => numeroConteo.FechaInicio = value.HasValue ? DateOnly.FromDateTime(value.Value) : default;
    }

    private DateTime? fechaFin
    {
        get => numeroConteo.FechaFin.HasValue ? numeroConteo.FechaFin.Value.ToDateTime(TimeOnly.MinValue) : null;
        set => numeroConteo.FechaFin = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        numeroConteo.IdSucursal = _sucursalStateService.SucursalId;
        sucursalNombre = _sucursalStateService.SucursalNombre ?? "No seleccionada";

        if (numeroConteo.IdSucursal == null || numeroConteo.IdSucursal == 0)
        {
            Snackbar.Add("No se ha seleccionado una sucursal. Por favor, seleccione una sucursal primero.", Severity.Warning);
            MudDialog.Close(DialogResult.Cancel());
            return;
        }

        await CargarTiposConteo();

        if (Id.HasValue)
        {
            loading = true;
            StateHasChanged();
            try
            {
                var response = await _numeroConteoService.GetByIdAsync(Id!.Value);
                if (response?.Success == true && response.Data != null)
                {
                    numeroConteo = response.Data;
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
            }
            finally
            {
                loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task CargarTiposConteo()
    {
        try
        {
            var response = await _tipoConteoService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                tiposConteo = response.Items.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar tipos de conteo: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Complete los campos requeridos", Severity.Warning);
            return;
        }

        if (numeroConteo.IdTipoConteo == null || numeroConteo.IdTipoConteo == 0)
        {
            Snackbar.Add("Seleccione un tipo de conteo", Severity.Warning);
            return;
        }

        if (numeroConteo.FechaInicio == default)
        {
            Snackbar.Add("Ingrese la fecha de inicio", Severity.Warning);
            return;
        }

        if (numeroConteo.FechaFin.HasValue && numeroConteo.FechaFin.Value <= numeroConteo.FechaInicio)
        {
            Snackbar.Add("La fecha de fin debe ser posterior a la fecha de inicio", Severity.Warning);
            return;
        }

        loading = true;
        StateHasChanged();

        try
        {
            ApiResponse<NumeroConteoResponse> response;

            if (Id.HasValue)
            {
                response = await _numeroConteoService.UpdateAsync(numeroConteo, numeroConteo.PkidPeriodoConteo);
            }
            else
            {
                response = await _numeroConteoService.CreateAsync(numeroConteo);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Guardado exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
}
