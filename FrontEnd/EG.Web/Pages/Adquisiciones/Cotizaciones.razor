    private async Task EditDetalle(int id)
    {
        if (SelectedCotizacion == null)
        {
            return;
        }

        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["CotizacionId"] = SelectedCotizacion.PkidCotizacion,
            ["RequisicionId"] = SelectedCotizacion.FkidRequisicionOrco,
            ["CotizacionNombre"] = SelectedCotizacion.ProveedorNombre,
            ["RequisicionNombre"] = SelectedCotizacion.RequisicionDescripcion,
            ["CurrencySymbol"] = _currencySymbol
        };

        var dialog = await DialogService.ShowAsync<CotizacionDetalleDialog>(
            "Editar Bien Cotizado",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSelectedAndDetails();
        }
    }

    private async Task DeleteDetalle(CotizacionDetalleResponse detalle)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar el bien cotizado {TextOrDash(detalle.TipoBienDescripcion)}?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var response = await DetalleService.DeleteAsync(detalle.PkidCotizacionDetalle);
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Bien cotizado eliminado correctamente.", Severity.Success);
                await RefreshSelectedAndDetails();
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al eliminar el bien cotizado.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RefreshSelectedAndDetails()
    {
        await RefreshSelectedCotizacion();
        await ReloadDetalles();
    }

    private async Task RefreshSelectedCotizacion()
    {
        if (SelectedCotizacion == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedCotizacion.PkidCotizacion);
        if (response?.Success == true && response.Data != null)
        {
            SelectedCotizacion = response.Data;
            StateHasChanged();
        }
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                }
            }
        }
        catch
        {
        }
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(async () =>
        {
            SelectedCotizacion = null;
            await ReloadData();
        });
    }

    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";

    private string MoneyOrDash(decimal? value) =>
        value.HasValue ? Money(value.Value) : "-";

    private static string Quantity(decimal value) => value.ToString("0.00", NumberCulture);

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DateOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string ProviderMeta(CotizacionResponse item)
    {
        var text = $"{item.ProveedorClave} {item.ProveedorRfc}".Trim();
        return string.IsNullOrWhiteSpace(text) ? string.Empty : text;
    }
}
