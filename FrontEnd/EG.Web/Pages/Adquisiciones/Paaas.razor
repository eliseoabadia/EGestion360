    private async Task<List<PaaaspartidumResponse>> GetPartidasAsync(CancellationToken cancellationToken = default)
    {
        if (SelectedPaaa == null)
        {
            return new List<PaaaspartidumResponse>();
        }

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PaaaspartidumResponse>>(
                $"api/Paaa/{SelectedPaaa.PkidPaaas}/partidas",
                cancellationToken);

            return response?.Success == true && response.Items != null
                ? response.Items.ToList()
                : new List<PaaaspartidumResponse>();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return new List<PaaaspartidumResponse>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading partidas: {ex.Message}");
            return new List<PaaaspartidumResponse>();
        }
    }

    private async Task<List<PaaasdetalleResponse>> GetBienesAsync(CancellationToken cancellationToken = default)
    {
        if (SelectedPartida == null)
        {
            return new List<PaaasdetalleResponse>();
        }

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PaaasdetalleResponse>>(
                $"api/Paaa/partida/{SelectedPartida.PkidPaaaspartida}/detalles",
                cancellationToken);

            return response?.Success == true && response.Items != null
                ? response.Items.ToList()
                : new List<PaaasdetalleResponse>();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return new List<PaaasdetalleResponse>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bienes: {ex.Message}");
            return new List<PaaasdetalleResponse>();
        }
    }

    private IEnumerable<PaaaspartidumResponse> FilterPartidas(IEnumerable<PaaaspartidumResponse> source)
    {
        var filter = partidaSearchString?.Trim();
        if (string.IsNullOrWhiteSpace(filter))
        {
            return source;
        }

        return source.Where(partida =>
            ContainsText(partida.ClavePartida, filter) ||
            ContainsText(partida.Descripcion, filter) ||
            ContainsText(partida.Observaciones, filter) ||
            ContainsText(Quantity(partida.Monto), filter) ||
            ContainsText(partida.Monto.ToString(), filter));
    }

    private IEnumerable<PaaasdetalleResponse> FilterBienes(IEnumerable<PaaasdetalleResponse> source)
    {
        var filter = bienSearchString?.Trim();
        if (string.IsNullOrWhiteSpace(filter))
        {
            return source;
        }

        return source.Where(bien =>
            ContainsText(bien.TipoBienCodigoClave, filter) ||
            ContainsText(bien.TipoBienDescripcion, filter) ||
            ContainsText(bien.Unidad, filter) ||
            ContainsText(bien.LugarEntrega, filter) ||
            ContainsText(bien.Observaciones, filter) ||
            ContainsText(Quantity(bien.Cantidad), filter) ||
            ContainsText(bien.Cantidad.ToString(), filter));
    }

    private static IEnumerable<PaaaspartidumResponse> SortPartidas(
        IEnumerable<PaaaspartidumResponse> source,
        string? sortLabel,
        SortDirection sortDirection)
    {
        var descending = sortDirection == SortDirection.Descending;

        return sortLabel switch
        {
            "Descripcion" => OrderByDirection(source, x => x.Descripcion, descending),
            "Monto" => OrderByDirection(source, x => x.Monto, descending),
            _ => OrderByDirection(source, x => x.ClavePartida, descending)
        };
    }

    private static IEnumerable<PaaasdetalleResponse> SortBienes(
        IEnumerable<PaaasdetalleResponse> source,
        string? sortLabel,
        SortDirection sortDirection)
    {
        var descending = sortDirection == SortDirection.Descending;

        return sortLabel switch
        {
            "TipoBienDescripcion" => OrderByDirection(source, x => x.TipoBienDescripcion, descending),
            "Cantidad" => OrderByDirection(source, x => x.Cantidad, descending),
            "Unidad" => OrderByDirection(source, x => x.Unidad, descending),
            "LugarEntrega" => OrderByDirection(source, x => x.LugarEntrega, descending),
            _ => OrderByDirection(source, x => x.TipoBienCodigoClave, descending)
        };
    }

    private static IEnumerable<T> OrderByDirection<T, TKey>(IEnumerable<T> source, Func<T, TKey> keySelector, bool descending) =>
        descending ? source.OrderByDescending(keySelector) : source.OrderBy(keySelector);

    private static TableData<T> ToTableData<T>(IEnumerable<T> source, TableState state)
    {
        var items = source.ToList();
        var pageSize = state.PageSize <= 0 ? 10 : state.PageSize;

        return new TableData<T>
        {
            Items = items.Skip(state.Page * pageSize).Take(pageSize).ToList(),
            TotalItems = items.Count
        };
    }

    private bool IsSelectedPartida(PaaaspartidumResponse partida) =>
        SelectedPartida?.PkidPaaaspartida == partida.PkidPaaaspartida;

    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private static bool ContainsText(string? value, string filter) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(filter, StringComparison.OrdinalIgnoreCase);

