    private async Task DeletePartida(PaaaspartidumResponse partida)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la partida {partida.ClavePartida}?\nSe eliminarán también todos los bienes asociados.");
        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Paaa/partida/{partida.PkidPaaaspartida}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Partida eliminada correctamente", Severity.Success);
                if (SelectedPartida?.PkidPaaaspartida == partida.PkidPaaaspartida)
                {
                    SelectedPartida = null;
                    bienes = new List<PaaasdetalleResponse>();
                }
                await ReloadPartidas();
                await ReloadBienes();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ApiResponse<PaaaspartidumResponse>>();
                Snackbar.Add(error?.Message ?? "Error al eliminar la partida", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

