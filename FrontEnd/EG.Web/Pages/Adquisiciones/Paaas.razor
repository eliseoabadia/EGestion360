@page "/Adquisiciones/Programa_Anual"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using EG.Web.Services
@using EG.Web.Models
@using MudBlazor
@attribute [StreamRendering(true)]
@implements IDisposable
@inject IJSRuntime JS
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject HttpClient Http
@inherits BaseCrudPage<PaaaResponse, PaaaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3" MaxWidth="MaxWidth.False" Style="height: 100vh; display: flex; flex-direction: column; overflow: hidden;">
        @if (SelectedPaaa == null)
        {
            @* ─── LISTADO DE PROGRAMAS ANUALES ─── *@
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Programa Anual de Adquisiciones"
                            Subtitle="Selecciona un programa para administrar sus partidas y bienes"
                            Icon="@Icons.Material.Filled.CalendarMonth"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericTable TItem="PaaaResponse"
                                  @ref="table"
                                  Title="Programas Anuales"
                                  SearchPlaceholder="Buscar por descripción, área o responsable..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">

                <Header>
                    <MudTh>Acciones</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="PkidPaaas" T="PaaaResponse">ID</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Descripcion" T="PaaaResponse">Descripción</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="AreaNombre" T="PaaaResponse">Área</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="ProgramaDescripcion" T="PaaaResponse">Programa</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FuenteFinanciamientoDescripcion" T="PaaaResponse">Fuente Financiamiento</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="ResponsableCompleto" T="PaaaResponse">Responsable</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Fecha" T="PaaaResponse">Fecha</MudTableSortLabel></MudTh>
                </Header>

                <Row Context="item">
                    <MudTd>
                        <MudTooltip Text="Ver detalle del programa">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => SelectPaaa(item))" />
                        </MudTooltip>
                        <ReportOpenButton ReportName=""
                                          EntityId="@item.PkidPaaas"
                                          Title="@($"Reporte PAAA {item.PkidPaaas}")"
                                          Tooltip="Ver reporte PAAAS"
                                          Color="Color.Secondary"
                                          Visible="@CanView" />
                        <ReportDesignerOpenButton ReportName=""
                                                  Title="Disenador reporte PAAAS"
                                                  Tooltip="Editar diseno del reporte PAAAS"
                                                  Color="Color.Primary"
                                                  Visible="@CanUpdate" />
                        <DocumentSupportButton Modulo="Adquisiciones"
                                               SubModulo="Programa_Anual_Adquisiciones"
                                               Controlador="Paaa"
                                               EntidadId="@item.PkidPaaas"
                                               FkidEmpresaSis="@item.FkidEmpresaSis"
                                               RegistroTitulo="@item.Descripcion"
                                               RegistroDescripcion="@($"PAAA {item.PkidPaaas} · {item.AreaNombre}")" />
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Visible="@CanUpdate"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditItem(item.PkidPaaas))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Visible="@CanDelete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteItem(item.PkidPaaas))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">@item.PkidPaaas</MudChip>
                    </MudTd>
                    <MudTd Style="font-weight: 500;">@item.Descripcion</MudTd>
                    <MudTd Style="font-weight: 500;">@item.ProgramaDescripcion</MudTd>
                    <MudTd Style="font-weight: 500;">@item.FuenteFinanciamientoDescripcion</MudTd>
                    <MudTd>@item.AreaNombre</MudTd>
                    <MudTd>@item.ResponsableCompleto</MudTd>
                    <MudTd>@item.Fecha.ToString("dd/MM/yyyy")</MudTd>
                </Row>
            </GenericTable>
                </div>
            </div>
        }
        else
        {
            @* ─── CONTENEDOR FLEX QUE LLENA EL ESPACIO RESTANTE ─── *@
            <div Class="d-flex flex-column paaa-detail-page" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                @* ─── ENCABEZADO DEL PAAA SELECCIONADO ─── *@
                <MudPaper Elevation="1" Class="paaa-selected-header">
                    <div class="paaa-header-main">
                        <div class="paaa-title-group">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="BackToTable"
                                           Class="paaa-back-button"
                                           Tooltip="Volver al listado" />
                            <div class="paaa-title-copy">
                                <div class="paaa-title-line">
                                    <MudText Typo="Typo.h6" Class="paaa-title">@TextOrDash(SelectedPaaa.Descripcion)</MudText>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@(SelectedPaaa.Activo ? Color.Success : Color.Error)"
                                             Variant="Variant.Filled">
                                        @(SelectedPaaa.Activo ? "Activo" : "Inactivo")
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="paaa-subtitle">
                                    Programa anual @SelectedPaaa.PkidPaaas.ToString("N0") | @SelectedPaaa.Fecha.ToString("dd/MM/yyyy")
                                </MudText>
                            </div>
                        </div>

                        <div class="paaa-header-actions">
                            <DocumentSupportButton Modulo="Adquisiciones"
                                                   SubModulo="Programa_Anual_Adquisiciones"
                                                   Controlador="Paaa"
                                                   EntidadId="@SelectedPaaa.PkidPaaas"
                                                   FkidEmpresaSis="@SelectedPaaa.FkidEmpresaSis"
                                                   RegistroTitulo="@SelectedPaaa.Descripcion"
                                                   RegistroDescripcion="@($"Programa anual {SelectedPaaa.PkidPaaas} · {SelectedPaaa.AreaNombre}")" />
                            <ReportOpenButton ReportName=""
                                              EntityId="@SelectedPaaa.PkidPaaas"
                                              Title="@($"Reporte PAAA {SelectedPaaa.PkidPaaas}")"
                                              Tooltip="Ver reporte PAAAS"
                                              Color="Color.Secondary"
                                              Visible="@CanView" />
                            <ReportDesignerOpenButton ReportName=""
                                                      Title="Disenador reporte PAAAS"
                                                      Tooltip="Editar diseno del reporte PAAAS"
                                                      Color="Color.Primary"
                                                      Visible="@CanUpdate" />
                            <MudTooltip Text="Editar programa">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Visible="@CanUpdate"
                                               OnClick="@(() => EditItem(SelectedPaaa.PkidPaaas))" />
                            </MudTooltip>
                            <MudTooltip Text="Agregar partida">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="AddPartida" />
                            </MudTooltip>
                        </div>
                    </div>
                </MudPaper>

                @* ─── TARJETA DE INFORMACIÓN GENERAL (compacta) ─── *@
                <MudPaper Elevation="0" Class="paaa-summary-panel">
                    <div class="paaa-summary-content">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Área</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.AreaNombre</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Programa</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.ProgramaDescripcion</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fuente Financiamiento</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.FuenteFinanciamientoDescripcion</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.Fecha.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Responsable</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.ResponsableCompleto</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Proyecto</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@(SelectedPaaa.ProyectoDescripcion ?? "N/A")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Partidas</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@(partidas?.Count ?? 0)</MudChip>
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Monto partidas</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@Money(PartidasTotal)</MudText>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudPaper>

                @* ─── CUERPO MAESTRO-DETALLE: OCUPA EL RESTO ─── *@
                <MudGrid Spacing="2" Class="flex-grow-1" Style="overflow: hidden; min-height: 0;">
                    @* ─── PANEL IZQUIERDO: LISTA DE PARTIDAS ─── *@
                    <MudItem xs="12" lg="5" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericTable TItem="PaaaspartidumResponse"
                                      @ref="partidaTable"
                                      Title="Partidas"
                                      SearchPlaceholder="Buscar partida..."
                                      ShowExportButton="false"
                                      ShowAddButton="@CanCreate"
                                      PageSize="5"
                                      ServerDataFunc="LoadPartidasServerData"
                                      SearchString="@partidaSearchString"
                                      SearchStringChanged="(s) => partidaSearchString = s"
                                      OnSearch="ReloadPartidas"
                                      OnAdd="AddPartida">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh><MudTableSortLabel SortLabel="ClavePartida" T="PaaaspartidumResponse">Clave</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="PaaaspartidumResponse">Partida</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Monto" T="PaaaspartidumResponse">Monto</MudTableSortLabel></MudTh>
                            </Header>
                            <Row Context="partida">
                                <MudTd>
                                    <MudTooltip Text="Ver bienes">
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                                       Color="@(IsSelectedPartida(partida) ? Color.Success : Color.Info)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => SelectPartida(partida))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar partida">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Visible="@CanDelete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeletePartida(partida))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@(IsSelectedPartida(partida) ? Color.Success : Color.Primary)">
                                        @TextOrDash(partida.ClavePartida)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@TextOrDash(partida.Descripcion)</MudTd>
                                <MudTd>@Money(partida.Monto)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudItem>

                        @* ─── PANEL DERECHO: DETALLE DE BIENES ─── *@
                    <MudItem xs="12" lg="7" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericTable TItem="PaaasdetalleResponse"
                                      @ref="bienTable"
                                      Title="@BienesTableTitle"
                                      SearchPlaceholder="Buscar bien o servicio..."
                                      ShowExportButton="false"
                                      ShowAddButton="@(CanCreate && SelectedPartida != null)"
                                      PageSize="5"
                                      ServerDataFunc="LoadBienesServerData"
                                      SearchString="@bienSearchString"
                                      SearchStringChanged="(s) => bienSearchString = s"
                                      OnSearch="ReloadBienes"
                                      OnAdd="AddBien">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh><MudTableSortLabel SortLabel="TipoBienCodigoClave" T="PaaasdetalleResponse">Clave</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="TipoBienDescripcion" T="PaaasdetalleResponse">Bien / Servicio</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Cantidad" T="PaaasdetalleResponse">Cantidad</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Unidad" T="PaaasdetalleResponse">Unidad</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="LugarEntrega" T="PaaasdetalleResponse">Lugar</MudTableSortLabel></MudTh>
                            </Header>
                            <Row Context="bien">
                                <MudTd>
                                    <MudTooltip Text="Editar bien">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Visible="@CanUpdate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditBien(bien))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar bien">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Visible="@CanDelete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteBien(bien))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>@TextOrDash(bien.TipoBienCodigoClave)</MudTd>
                                <MudTd>@TextOrDash(bien.TipoBienDescripcion)</MudTd>
                                <MudTd>@Quantity(bien.Cantidad)</MudTd>
                                <MudTd>@TextOrDash(bien.Unidad)</MudTd>
                                <MudTd>@TextOrDash(bien.LugarEntrega)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudItem>
                </MudGrid>
                </div>
        }
    </MudContainer>
</AccessVerification>

