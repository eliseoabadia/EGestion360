@page "/Adquisiciones/Programa_Anual"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Services
@using EG.Web.Models
@using MudBlazor
@attribute [StreamRendering(true)]
@implements IDisposable
@inject IJSRuntime JS
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject HttpClient Http
@inherits BaseCrudPage<PaaaResponse, PaaaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3" MaxWidth="MaxWidth.False" Style="height: 100vh; display: flex; flex-direction: column; overflow: hidden;">
        @if (SelectedPaaa == null)
        {
            @* ─── LISTADO DE PROGRAMAS ANUALES ─── *@
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Programa Anual de Adquisiciones"
                            Subtitle="Selecciona un programa para administrar sus partidas y bienes"
                            Icon="@Icons.Material.Filled.CalendarMonth"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericTable TItem="PaaaResponse"
                                  @ref="table"
                                  Title="Programas Anuales"
                                  SearchPlaceholder="Buscar por descripción, área o responsable..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">

                <Header>
                    <MudTh>Acciones</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="PkidPaaas" T="PaaaResponse">ID</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Descripcion" T="PaaaResponse">Descripción</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="AreaNombre" T="PaaaResponse">Área</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="ProgramaDescripcion" T="PaaaResponse">Programa</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FuenteFinanciamientoDescripcion" T="PaaaResponse">Fuente Financiamiento</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="ResponsableCompleto" T="PaaaResponse">Responsable</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Fecha" T="PaaaResponse">Fecha</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Activo" T="PaaaResponse">Estatus</MudTableSortLabel></MudTh>
                </Header>

                <Row Context="item">
                    <MudTd>
                        <MudTooltip Text="Ver detalle del programa">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => SelectPaaa(item))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Visible="@CanUpdate"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditItem(item.PkidPaaas))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Visible="@CanDelete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteItem(item.PkidPaaas))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">@item.PkidPaaas</MudChip>
                    </MudTd>
                    <MudTd Style="font-weight: 500;">@item.Descripcion</MudTd>
                    <MudTd Style="font-weight: 500;">@item.ProgramaDescripcion</MudTd>
                    <MudTd Style="font-weight: 500;">@item.FuenteFinanciamientoDescripcion</MudTd>
                    <MudTd>@item.AreaNombre</MudTd>
                    <MudTd>@item.ResponsableCompleto</MudTd>
                    <MudTd>@item.Fecha.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@(item.Activo ? Color.Success : Color.Error)" Size="Size.Small">
                            @(item.Activo ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                </Row>
            </GenericTable>
                </div>
            </div>
        }
        else
        {
            @* ─── CONTENEDOR FLEX QUE LLENA EL ESPACIO RESTANTE ─── *@
            <div Class="d-flex flex-column" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 6px;">
                @* ─── ENCABEZADO DEL PAAA SELECCIONADO ─── *@
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background: transparent; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="BackToTable"
                                   Tooltip="Volver al listado" />
                    <MudText Typo="Typo.h6" Style="font-weight: 600;" Class="ml-2">
                        @SelectedPaaa.Descripcion
                    </MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedPaaa.Activo ? Color.Success : Color.Error)">
                        @(SelectedPaaa.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                    <MudTooltip Text="Editar programa">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="@(() => EditItem(SelectedPaaa.PkidPaaas))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar partida">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="AddPartida"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                @* ─── TARJETA DE INFORMACIÓN GENERAL (compacta) ─── *@
                <MudCard Elevation="1" Style="flex-shrink: 0;">
                    <MudCardContent Style="padding: 8px 12px;">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Área</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.AreaNombre</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Programa</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.ProgramaDescripcion</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fuente Financiamiento</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.FuenteFinanciamientoDescripcion</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.Fecha.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Responsable</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedPaaa.ResponsableCompleto</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Proyecto</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@(SelectedPaaa.ProyectoDescripcion ?? "N/A")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Partidas</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@(partidas?.Count ?? 0)</MudChip>
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                @* ─── CUERPO MAESTRO-DETALLE: OCUPA EL RESTO ─── *@
                <div Style="display: flex; flex-direction: row; flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                    @* ─── PANEL IZQUIERDO: LISTA DE PARTIDAS ─── *@
                    <div Style="width: 33.33%; display: flex; flex-direction: column; min-height: 0;">
                        <MudCard Elevation="1" Class="d-flex flex-column" Style="border-top: 3px solid var(--mud-palette-primary); flex-grow: 1; overflow: hidden;">
                                <MudCardContent Class="d-flex flex-column pa-0" Style="overflow: hidden; flex-grow: 1;">
                                    <div Class="pa-2 pb-0" Style="flex-shrink: 0;">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600; flex-grow: 1;">
                                                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                                                PARTIDAS
                                            </MudText>
                                            <MudTooltip Text="Agregar partida">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Small" OnClick="AddPartida" />
                                            </MudTooltip>
                                        </MudStack>
                                        <MudTextField @bind-Value="_partidaFilter"
                                                      Placeholder="Buscar partida..."
                                                      Variant="Variant.Outlined"
                                                      Size="Size.Small"
                                                      Immediate="true"
                                                      Clearable="true"
                                                      Class="mb-2" />
                                    </div>

                                    <div Class="flex-grow-1" Style="overflow-y: auto; min-height: 0; padding: 0 8px 4px;">
                                        @if (_partidasLoading)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex justify-center my-3" />
                                        }
                                        else if (_filteredPartidas.Count > 0)
                                        {
                                            <MudStack Spacing="1">
                                                @foreach (var partida in _filteredPartidas)
                                                {
                                                    var isSelected = SelectedPartida?.PkidPaaaspartida == partida.PkidPaaaspartida;
                                                    <div @onclick="@(() => SelectPartida(partida))"
                                                         @onclick:stopPropagation
                                                         class="pa-1 rounded-lg cursor-pointer"
                                                         style="@(isSelected ? "background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); display: flex; align-items: center; gap: 4px;" : "border-left: 3px solid transparent; display: flex; align-items: center; gap: 4px;")">
                                                        <div style="flex-grow: 1; min-width: 0;">
                                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                                                @($"{partida.ClavePartida} - {partida.Descripcion}")
                                                            </MudText>
                                                            @if (!string.IsNullOrWhiteSpace(partida.Observaciones))
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="text-truncate">
                                                                    @partida.Observaciones
                                                                </MudText>
                                                            }
                                                        </div>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                       Color="Color.Error"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => DeletePartida(partida))" />
                                                    </div>
                                                }
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-6">
                                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size: 2rem; color: var(--mud-palette-action-disabled);" />
                                                <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
                                                    @(string.IsNullOrEmpty(_partidaFilter) ? "No hay partidas" : "Sin resultados")
                                                </MudText>
                                            </MudStack>
                                        }
                                    </div>

                                    @if (partidas?.Count > 0)
                                    {
                                        <div Style="flex-shrink: 0; border-top: 1px solid var(--mud-palette-lines-inputs);" Class="pa-2">
                                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                <strong>@(partidas?.Count ?? 0)</strong> partida(s)
                                            </MudText>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </div>

                        @* ─── PANEL DERECHO: DETALLE DE BIENES ─── *@
                        <div Style="width: 66.66%; display: flex; flex-direction: column; min-height: 0;">
                            <MudCard Elevation="1" Class="d-flex flex-column" Style="border-top: 3px solid var(--mud-palette-success); flex-grow: 1; overflow: hidden;">
                                <MudCardContent Class="d-flex flex-column pa-0" Style="overflow: hidden; flex-grow: 1;">
                                    @if (SelectedPartida != null)
                                    {
                                        <div Class="pa-2 pb-0" Style="flex-shrink: 0;">
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; flex-grow: 1;">
                                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />
                                                    BIENES / SERVICIOS
                                                </MudText>
                                                <MudTooltip Text="Agregar bien">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Small" OnClick="AddBien" />
                                                </MudTooltip>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">
                                                @($"{SelectedPartida.ClavePartida} - {SelectedPartida.Descripcion}")
                                            </MudText>
                                        </div>

                                        <div Class="flex-grow-1" Style="overflow-y: auto; min-height: 0; padding: 0 8px 4px;">
                                            @if (_bienesLoading)
                                            {
                                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex justify-center my-3" />
                                            }
                                            else if (bienes?.Count > 0)
                                            {
                                                <MudTable Items="bienes"
                                                          Dense="true"
                                                          Hover="true"
                                                          Striped="true"
                                                          Elevation="0"
                                                          Class="rounded-lg"
                                                          Style="width: 100%;">
                                                    <HeaderContent>
                                                        <MudTh Style="width: 30px;">#</MudTh>
                                                        <MudTh>Tipo de Bien</MudTh>
                                                        <MudTh Style="width: 70px;">Cant.</MudTh>
                                                        <MudTh Style="width: 70px;">Unidad</MudTh>
                                                        <MudTh>Lugar de Entrega</MudTh>
                                                        <MudTh>Observaciones</MudTh>
                                                        <MudTh Style="width: 80px;">Acciones</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate Context="bien">
                                                        <MudTd>
                                                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                                @(bienes.IndexOf(bien) + 1)
                                                            </MudText>
                                                        </MudTd>
                                                        <MudTd Style="font-weight: 500;">@bien.TipoBienDescripcion</MudTd>
                                                        <MudTd>@bien.Cantidad.ToString("N2")</MudTd>
                                                        <MudTd>@TextOrDash(bien.Unidad)</MudTd>
                                                        <MudTd>@TextOrDash(bien.LugarEntrega)</MudTd>
                                                        <MudTd>
                                                            <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 150px;">
                                                                @TextOrDash(bien.Observaciones)
                                                            </MudText>
                                                        </MudTd>
                                                        <MudTd>
                                                            <MudTooltip Text="Editar bien">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditBien(bien))" />
                                                            </MudTooltip>
                                                            <MudTooltip Text="Eliminar bien">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBien(bien))" />
                                                            </MudTooltip>
                                                        </MudTd>
                                                    </RowTemplate>
                                                    <NoRecordsContent>
                                                        <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center" Class="py-3">
                                                            No hay bienes registrados
                                                        </MudText>
                                                    </NoRecordsContent>
                                                </MudTable>
                                            }
                                            else
                                            {
                                                <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-6">
                                                    <MudIcon Icon="@Icons.Material.Filled.Category" Style="font-size: 2rem; color: var(--mud-palette-action-disabled);" />
                                                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
                                                        No hay bienes registrados para esta partida
                                                    </MudText>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="AddBien">
                                                        Agregar primer bien
                                                    </MudButton>
                                                </MudStack>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="flex-grow-1">
                                            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Style="font-size: 3rem; color: var(--mud-palette-action-disabled);" />
                                            <MudText Typo="Typo.h6" Color="Color.Tertiary">Selecciona una partida</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
                                                Haz clic en una partida del panel izquierdo
                                            </MudText>
                                        </MudStack>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </div>
                    </div>
                </div>
        }
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<PaaaResponse> table = null!;
    private int _empresaId;
    private PaaaResponse? SelectedPaaa;
    private List<PaaaspartidumResponse>? partidas;
    private PaaaspartidumResponse? SelectedPartida;
    private List<PaaasdetalleResponse>? bienes;
    private string _partidaFilter = string.Empty;
    private bool _partidasLoading = false;
    private bool _bienesLoading = false;

    private List<PaaaspartidumResponse> _filteredPartidas
    {
        get
        {
            if (partidas == null) return new();
            if (string.IsNullOrWhiteSpace(_partidaFilter)) return partidas;
            var f = _partidaFilter.ToLower();
            return partidas.Where(p =>
                (p.ClavePartida ?? string.Empty).ToLower().Contains(f) ||
                (p.Descripcion ?? string.Empty).ToLower().Contains(f) ||
                (p.Observaciones ?? string.Empty).ToLower().Contains(f) ||
                p.Monto.ToString().Contains(f)).ToList();
        }
    }

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Programa_Anual_Adquisiciones";

    protected override Type CreateDialogType => typeof(PaaaDialog);
    protected override Type EditDialogType => typeof(PaaaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<PaaaResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override async Task<TableData<PaaaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var page = Math.Max(1, state.Page + 1);
            CurrentPage = page;
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!AnioStateService.AnioId.HasValue)
            {
                Elements.Clear();
                TotalCount = 0;
                return new TableData<PaaaResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId.Value
            };

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrEmpty(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<PaaaResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
            return new TableData<PaaaResponse>
            {
                Items = new List<PaaaResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadEmpresaId();
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(async () =>
        {
            BackToTable();
            await ReloadData();
        });
    }

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }

    private async Task LoadEmpresaId()
    {
        try
        {
            await SucursalStateService.InitializeAsync();
            if (SucursalStateService.EmpresaId.HasValue)
            {
                _empresaId = SucursalStateService.EmpresaId.Value;
            }
            else
            {
                var empresaIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "empresa_seleccionada");
                if (!string.IsNullOrEmpty(empresaIdStr) && int.TryParse(empresaIdStr, out int empresaId))
                {
                    _empresaId = empresaId;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading empresaId: {ex.Message}");
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<PaaaResponse> items)
    {
        return items.Select(e => new
        {
            ID = e.PkidPaaas,
            Descripción = e.Descripcion,
            Área = e.AreaNombre,
            Responsable = e.ResponsableCompleto,
            Fecha = e.Fecha.ToString("dd/MM/yyyy"),
            Proyecto = e.ProyectoDescripcion,
            Programa = e.ProgramaDescripcion,
            FuenteFinanciamiento = e.FuenteFinanciamientoDescripcion,
            Activo = e.Activo ? "Activo" : "Inactivo"
        });
    }

    protected override async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        if (!AnioStateService.AnioId.HasValue)
        {
            Snackbar.Add("Selecciona un año presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId.Value
            };

            var response = await Service.GetAllPaginadoAsync(1, int.MaxValue, SearchString, SortLabel, SortDirection, filters);

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add(response?.Message ?? "No hay datos para exportar", Severity.Warning);
                return;
            }

            var excelData = MapToExcelData(response.Items);
            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(excelData);

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JS.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{AnioStateService.AnioClave}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportación exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Descripcion ?? "el programa anual";
        }
        catch { return "el programa anual"; }
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        if (!AnioStateService.AnioId.HasValue)
        {
            Snackbar.Add("Selecciona un año presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = _empresaId,
            ["AnioId"] = AnioStateService.AnioId.Value
        };

        var dialog = await DialogService.ShowAsync(CreateDialogType, $"Crear {SubModuleName}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await ReloadData();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = _empresaId,
            ["AnioId"] = AnioStateService.AnioId
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, $"Editar {SubModuleName}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (SelectedPaaa != null && id == SelectedPaaa.PkidPaaas)
                await RefreshSelectedPaaa();
            else
                await ReloadData();
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }

    private async Task SelectPaaa(PaaaResponse item)
    {
        _partidaFilter = string.Empty;
        SelectedPartida = null;
        bienes = null;
        SelectedPaaa = item;
        await LoadPartidas();
        StateHasChanged();
    }

    private async Task RefreshSelectedPaaa()
    {
        if (SelectedPaaa == null) return;
        try
        {
            var response = await Service.GetByIdAsync(SelectedPaaa.PkidPaaas);
            if (response?.Success == true && response.Data != null)
                SelectedPaaa = response.Data;
        }
        catch { }
        await LoadPartidas();
        StateHasChanged();
    }

    private async Task LoadPartidas()
    {
        if (SelectedPaaa == null) return;

        _partidasLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PaaaspartidumResponse>>($"api/Paaa/{SelectedPaaa.PkidPaaas}/partidas");
            if (response?.Success == true && response.Items != null)
                partidas = response.Items.ToList();
            else
                partidas = new List<PaaaspartidumResponse>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading partidas: {ex.Message}");
            partidas = new List<PaaaspartidumResponse>();
        }
        finally
        {
            _partidasLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectPartida(PaaaspartidumResponse partida)
    {
        SelectedPartida = partida;
        await LoadBienes();
        StateHasChanged();
    }

    private async Task LoadBienes()
    {
        if (SelectedPartida == null) return;

        _bienesLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PaaasdetalleResponse>>($"api/Paaa/partida/{SelectedPartida.PkidPaaaspartida}/detalles");
            if (response?.Success == true && response.Items != null)
                bienes = response.Items.ToList();
            else
                bienes = new List<PaaasdetalleResponse>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bienes: {ex.Message}");
            bienes = new List<PaaasdetalleResponse>();
        }
        finally
        {
            _bienesLoading = false;
            StateHasChanged();
        }
    }

    private void BackToTable()
    {
        SelectedPaaa = null;
        SelectedPartida = null;
        partidas = null;
        bienes = null;
        _partidaFilter = string.Empty;
        StateHasChanged();
    }

    private async Task DeletePartida(PaaaspartidumResponse partida)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la partida {partida.ClavePartida}?\nSe eliminarán también todos los bienes asociados.");
        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Paaa/partida/{partida.PkidPaaaspartida}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Partida eliminada correctamente", Severity.Success);
                if (SelectedPartida?.PkidPaaaspartida == partida.PkidPaaaspartida)
                {
                    SelectedPartida = null;
                    bienes = null;
                }
                await LoadPartidas();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ApiResponse<PaaaspartidumResponse>>();
                Snackbar.Add(error?.Message ?? "Error al eliminar la partida", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task AddPartida()
    {
        if (SelectedPaaa == null)
        {
            Snackbar.Add("Selecciona un programa anual primero", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = _empresaId,
            ["PaaaId"] = SelectedPaaa.PkidPaaas
        };

        var dialog = await DialogService.ShowAsync<PaaasPartidaDialog>("Agregar Partida", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadPartidas();
        }
    }

    private async Task AddBien()
    {
        if (SelectedPartida == null)
        {
            Snackbar.Add("Selecciona una partida primero", Severity.Warning);
            return;
        }

        await OpenBienDialog(null);
    }

    private async Task EditBien(PaaasdetalleResponse bien)
    {
        if (SelectedPartida == null)
        {
            Snackbar.Add("Selecciona una partida primero", Severity.Warning);
            return;
        }

        await OpenBienDialog(bien);
    }

    private async Task DeleteBien(PaaasdetalleResponse bien)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar el tipo de bien {TextOrDash(bien.TipoBienDescripcion)}?");
        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Paaa/detalle/{bien.PkidPaaasdetalle}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Tipo de bien eliminado correctamente", Severity.Success);
                await LoadBienes();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el tipo de bien", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenBienDialog(PaaasdetalleResponse? bien)
    {
        if (SelectedPartida == null)
            return;

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = _empresaId,
            ["PartidaId"] = SelectedPartida.PkidPaaaspartida,
            ["PartidaNombre"] = $"{SelectedPartida.ClavePartida} - {SelectedPartida.Descripcion}",
            ["Item"] = bien
        };

        var title = bien == null ? "Agregar Tipo de Bien" : "Editar Tipo de Bien";
        var dialog = await DialogService.ShowAsync<PaaasDetalleDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (!result.Canceled)
            await LoadBienes();
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;
}
