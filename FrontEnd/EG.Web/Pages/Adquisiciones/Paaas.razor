    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = _empresaId,
            ["AnioId"] = AnioStateService.AnioId
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, $"Editar {SubModuleName}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (SelectedPaaa != null && id == SelectedPaaa.PkidPaaas)
                await RefreshSelectedPaaa();
            else
                await ReloadData();
        }
    }

    protected override async Task ReloadData()
    {
        if (SelectedPaaa == null)
        {
            if (table != null)
            {
                await table.ReloadData();
                StateHasChanged();
            }

            return;
        }

        await ReloadPartidas();
        await ReloadBienes();
    }

    private async Task SelectPaaa(PaaaResponse item)
    {
        partidaSearchString = string.Empty;
        bienSearchString = string.Empty;
        SelectedPartida = null;
        bienes = null;
        SelectedPaaa = item;
        await LoadPartidas();
        StateHasChanged();
    }

    private async Task RefreshSelectedPaaa()
    {
        if (SelectedPaaa == null) return;
        try
        {
            var response = await Service.GetByIdAsync(SelectedPaaa.PkidPaaas);
            if (response?.Success == true && response.Data != null)
                SelectedPaaa = response.Data;
        }
        catch { }
        await ReloadPartidas();
        await ReloadBienes();
        StateHasChanged();
    }

    private async Task<TableData<PaaaspartidumResponse>> LoadPartidasServerData(TableState state, CancellationToken cancellationToken)
    {
        var source = await GetPartidasAsync(cancellationToken);
        partidas = source;

        if (SelectedPartida != null && !source.Any(x => x.PkidPaaaspartida == SelectedPartida.PkidPaaaspartida))
        {
            SelectedPartida = null;
            bienes = new List<PaaasdetalleResponse>();
        }

        var query = FilterPartidas(source);
        query = SortPartidas(query, state.SortLabel, state.SortDirection);

        return ToTableData(query, state);
    }

    private async Task<TableData<PaaasdetalleResponse>> LoadBienesServerData(TableState state, CancellationToken cancellationToken)
    {
        var source = await GetBienesAsync(cancellationToken);
        bienes = source;

        var query = FilterBienes(source);
        query = SortBienes(query, state.SortLabel, state.SortDirection);

        return ToTableData(query, state);
    }

