@using MudBlazor
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.General
@using EG.Common.GenericModel
@inject IGenericCrudService<PaaaResponse> Service
@inject IGenericCrudService<AniosResponse> anioService
@inject IGenericCrudService<PersonaResponse> personaService
@inject IGenericCrudService<ProyectoResponse> proyectoService
@inject IGenericCrudService<FuenteFinanciamientoResponse> fuenteService
@inject IGenericCrudService<ProgramaPresupuestalResponse> programaService
@inject IGenericCrudService<UsuarioAreaResponse> areaService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="PaaaResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Medium"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando catálogos..."
                 OnConfirm="GuardarCambiosAsync">

    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-8">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-3">Cargando catálogos...</MudText>
        </div>
    }
    else
    {
        <BaseEntityForm TEntity="PaaaResponse"
                        @ref="form"
                        ShowHeader="true"
                        HeaderTitle="@dialogTitle">

            <MudGrid GutterSize="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="item.Descripcion"
                                  Label="Descripción"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="La descripción es requerida" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedAnio"
                                       ValueChanged="value => _selectedAnio = value"
                                       Label="Año"
                                       Required="true"
                                       LoadPage="LoadAniosPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedArea"
                                       ValueChanged="value => _selectedArea = value"
                                       Label="Área"
                                       Required="true"
                                       RequiredError="El área es requerida"
                                       LoadPage="LoadAreasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPersona"
                                       ValueChanged="value => _selectedPersona = value"
                                       Label="Responsable"
                                       Required="true"
                                       LoadPage="LoadPersonasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Value="_fecha"
                                   Label="Fecha"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="La fecha es requerida" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedProyecto"
                                       ValueChanged="value => _selectedProyecto = value"
                                       Label="Proyecto"
                                       Clearable="true"
                                       LoadPage="LoadProyectosPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPrograma"
                                       ValueChanged="value => _selectedPrograma = value"
                                       Label="Programa"
                                       Clearable="true"
                                       LoadPage="LoadProgramasPageAsync" />
                </MudItem>

                <MudItem xs="12">
                    <PagedAutocomplete Value="@_selectedFuente"
                                       ValueChanged="value => _selectedFuente = value"
                                       Label="Fuente de Financiamiento"
                                       Clearable="true"
                                       LoadPage="LoadFuentesPageAsync" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="item.Observaciones"
                                  Label="Observaciones"
                                  Variant="Variant.Outlined"
                                  Lines="3" />
                </MudItem>

                @if (Id.HasValue)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="item.Activo" Label="Registro Activo" Color="Color.Success" Dense="true" />
                    </MudItem>
                }
            </MudGrid>
        </BaseEntityForm>
    }
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PaaaResponse> form = null!;
    private PaaaResponse item = new() { Activo = true, Fecha = DateTime.Today };
    private DateTime? _fecha;
    private bool _loading = true;

    private LookupItem? _selectedAnio;
    private LookupItem? _selectedPersona;
    private LookupItem? _selectedProyecto;
    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedFuente;
    private LookupItem? _selectedArea;

    private string dialogTitle => Id.HasValue ? "Editar Programa Anual" : "Nuevo Programa Anual";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
        _loading = false;
    }

    private async Task<ComboLookupResult> LoadAniosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await anioService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidAnio, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await personaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPersona, Text = $"{x.Nombre} {x.Paterno} {x.Materno}".Trim() }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadProyectosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await proyectoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidProyecto, Text = x.Descripcion }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await programaService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPp, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadFuentesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await fuenteService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidFuenteFinanciamiento, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadAreasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await areaService.GetAllPaginadoAsync(page, pageSize, filter, "UsuarioAreaDescripcion", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidArea, Text = x.UsuarioAreaDescripcion }), response?.TotalCount);
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _fecha = item.Fecha;

                _selectedAnio = new LookupItem { Id = item.FkidAnioSis, Text = $"{item.AnioClave} - {item.AnioDescripcion}" };
                _selectedPersona = new LookupItem { Id = item.FkidPersonaNom, Text = item.ResponsableCompleto };
                _selectedArea = new LookupItem { Id = item.FkidAreaSis, Text = item.AreaNombre };

                if (item.FkidProyectoOrco.HasValue)
                    _selectedProyecto = new LookupItem { Id = item.FkidProyectoOrco.Value, Text = item.ProyectoDescripcion ?? string.Empty };

                if (item.FkidProgramaPres.HasValue)
                    _selectedPrograma = new LookupItem { Id = item.FkidProgramaPres.Value, Text = $"{item.ProgramaClave} - {item.ProgramaDescripcion}" };

                if (item.FkidFuenteFinanciamientoPres.HasValue)
                    _selectedFuente = new LookupItem { Id = item.FkidFuenteFinanciamientoPres.Value, Text = $"{item.FuenteFinanciamientoClave} - {item.FuenteFinanciamientoDescripcion}" };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        if (_selectedAnio == null) { Snackbar.Add("Debe seleccionar un año válido", Severity.Warning); return; }
        item.FkidAnioSis = _selectedAnio.Id;

        if (_selectedPersona == null) { Snackbar.Add("Debe seleccionar un responsable válido", Severity.Warning); return; }
        item.FkidPersonaNom = _selectedPersona.Id;

        item.FkidProyectoOrco = _selectedProyecto?.Id;

        item.FkidProgramaPres = _selectedPrograma?.Id;

        item.FkidFuenteFinanciamientoPres = _selectedFuente?.Id;

        if (_selectedArea == null) { Snackbar.Add("Debe seleccionar un área válida", Severity.Warning); return; }
        item.FkidAreaSis = _selectedArea.Id;

        if (_fecha.HasValue)
            item.Fecha = _fecha.Value;

        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                item.PkidPaaas = 0;
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(Id.HasValue ? "Programa anual actualizado correctamente" : "Programa anual creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
