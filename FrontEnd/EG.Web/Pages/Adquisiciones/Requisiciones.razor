    private async Task<TableData<RequisicionPartidaResponse>> LoadPartidasServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedRequisicion == null)
        {
            return new TableData<RequisicionPartidaResponse> { Items = new List<RequisicionPartidaResponse>(), TotalItems = 0 };
        }

        var response = await PartidaService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            partidaSearchString,
            state.SortLabel ?? "PartidaClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidRequisicionOrco"] = SelectedRequisicion.PkidRequisicion });

        if (SelectedPartida != null && response?.Items?.Any(x => x.PkidRequisicionPartida == SelectedPartida.PkidRequisicionPartida) != true)
        {
            SelectedPartida = null;
            await ReloadDetalles();
        }

        return new TableData<RequisicionPartidaResponse>
        {
            Items = response?.Items ?? new List<RequisicionPartidaResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task<TableData<RequisicionDetalleResponse>> LoadDetallesServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedRequisicion == null || SelectedPartida == null)
        {
            return new TableData<RequisicionDetalleResponse> { Items = new List<RequisicionDetalleResponse>(), TotalItems = 0 };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "TipoBienCodigoClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidRequisicionOrco"] = SelectedRequisicion.PkidRequisicion });

        return new TableData<RequisicionDetalleResponse>
        {
            Items = response?.Items ?? new List<RequisicionDetalleResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

