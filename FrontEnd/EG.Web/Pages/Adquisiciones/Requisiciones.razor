@page "/Adquisiciones/Requisicion"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Services
@using MiniExcelLibs
@using MudBlazor
@implements IDisposable
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject HttpClient Http
@inherits BaseCrudPage<RequisicionResponse, RequisicionResponse>

@inject IGenericCrudService<RequisicionPartidaResponse> PartidaService
@inject IGenericCrudService<RequisicionDetalleResponse> DetalleService
@inject IGenericCrudService<CotizacionDetalleResponse> CotizacionDetalleService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        @if (SelectedRequisicion == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Requisiciones"
                            Subtitle="Selecciona una requisicion para administrar sus partidas y detalles"
                            Icon="@Icons.Material.Filled.Assignment"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericTable TItem="RequisicionResponse"
                                  @ref="table"
                                  Title="Lista de Requisiciones"
                                  SearchPlaceholder="Buscar por descripcion, area o solicitante..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">

                        <Header>
                            <MudTh>Acciones</MudTh>
                            <MudTh><MudTableSortLabel SortLabel="PkidRequisicion" T="RequisicionResponse">ID</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Descripcion" T="RequisicionResponse">Descripcion</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="AreaNombre" T="RequisicionResponse">Area</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="SolicitanteCompleto" T="RequisicionResponse">Solicitante</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="FechaRequisicion" T="RequisicionResponse">Fecha</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Importe" T="RequisicionResponse">Importe</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Servicio" T="RequisicionResponse">Tipo</MudTableSortLabel></MudTh>
                            <MudTh>Flujo</MudTh>
                        </Header>

                        <Row Context="item">
                            <MudTd>
                                <MudTooltip Text="Ver detalle">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => SelectRequisicion(item))" />
                                </MudTooltip>
                                <MudTooltip Text="Editar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Visible="@CanUpdate"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@IsLocked(item)"
                                                   OnClick="@(() => EditItem(item.PkidRequisicion))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Visible="@CanDelete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Disabled="@IsLocked(item)"
                                                   OnClick="@(() => DeleteItem(item.PkidRequisicion))" />
                                </MudTooltip>
                                <MudTooltip Text="Generar cotizacion">
                                    <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                                                   Visible="@CanCreate"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenCotizacionFromRequisicion(item))" />
                                </MudTooltip>
                                <MudTooltip Text="Generar solicitud de suficiencia">
                                    <MudIconButton Icon="@Icons.Material.Filled.RuleFolder"
                                                   Visible="@CanCreate"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenSolicitudSuficienciaFromRequisicion(item))" />
                                </MudTooltip>
                            </MudTd>
                            <MudTd>@item.PkidRequisicion</MudTd>
                            <MudTd>@item.Descripcion</MudTd>
                            <MudTd>@TextOrDash(item.AreaNombre)</MudTd>
                            <MudTd>@TextOrDash(item.SolicitanteCompleto)</MudTd>
                            <MudTd>@item.FechaRequisicion.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>@MoneyOrDash(item.Importe)</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@(item.Servicio ? Color.Info : Color.Primary)" Size="Size.Small">
                                    @(item.Servicio ? "Servicio" : "Bien")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string"
                                         Color="@(IsLocked(item) ? Color.Warning : Color.Success)"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small">
                                    @(IsLocked(item) ? $"En cotizacion ({item.CotizacionesActivas})" : "Libre")
                                </MudChip>
                            </MudTd>
                        </Row>
                    </GenericTable>
                </div>
            </div>
        }
        else
        {
            <div Class="d-flex flex-column" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background: transparent; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="BackToTable"
                                   Tooltip="Volver al listado" />
                    <MudText Typo="Typo.h6" Style="font-weight: 600;" Class="ml-2">
                        @SelectedRequisicion.Descripcion
                    </MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedRequisicion.Activo ? Color.Success : Color.Error)">
                        @(SelectedRequisicion.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(IsSelectedLocked ? Color.Warning : Color.Success)"
                             Variant="Variant.Outlined"
                             Class="ml-1">
                        @(IsSelectedLocked ? $"En cotizacion ({SelectedRequisicion.CotizacionesActivas})" : "Libre")
                    </MudChip>
                    <MudTooltip Text="Editar requisicion">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       Disabled="@IsSelectedLocked"
                                       OnClick="@(() => EditItem(SelectedRequisicion.PkidRequisicion))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar partida">
                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       Disabled="@IsSelectedLocked"
                                       OnClick="AddPartida"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar detalle">
                        <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       Disabled="@(SelectedPartida == null || IsSelectedLocked)"
                                       OnClick="AddDetalle"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Generar cotizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="@(() => OpenCotizacionFromRequisicion(SelectedRequisicion))"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Generar solicitud de suficiencia">
                        <MudIconButton Icon="@Icons.Material.Filled.RuleFolder"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="@(() => OpenSolicitudSuficienciaFromRequisicion(SelectedRequisicion))"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudCard Elevation="1" Style="flex-shrink: 0;">
                    <MudCardContent Style="padding: 8px 12px;">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Area</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.AreaNombre)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Solicitante</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.SolicitanteCompleto)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedRequisicion.FechaRequisicion.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Importe</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@MoneyOrDash(SelectedRequisicion.Importe)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Tipo</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(SelectedRequisicion.Servicio ? Color.Info : Color.Primary)">
                                    @(SelectedRequisicion.Servicio ? "Servicio" : "Bien")
                                </MudChip>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Programa</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.ProgramaDescripcion)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fuente financiamiento</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.FuenteFinanciamientoDescripcion)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Oficio</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.Oficio)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <MudGrid Spacing="2" Class="flex-grow-1" Style="overflow: hidden; min-height: 0;">
                    <MudItem xs="12" lg="5" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericTable TItem="RequisicionPartidaResponse"
                                      @ref="partidaTable"
                                      Title="Partidas"
                                      SearchPlaceholder="Buscar partida..."
                                      ShowExportButton="false"
                                      ShowAddButton="@(CanCreate && !IsSelectedLocked)"
                                      PageSize="5"
                                      ServerDataFunc="LoadPartidasServerData"
                                      SearchString="@partidaSearchString"
                                      SearchStringChanged="(s) => partidaSearchString = s"
                                      OnSearch="ReloadPartidas"
                                      OnAdd="AddPartida">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh><MudTableSortLabel SortLabel="PartidaClave" T="RequisicionPartidaResponse">Clave</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="PartidaDescripcion" T="RequisicionPartidaResponse">Partida</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Monto" T="RequisicionPartidaResponse">Monto</MudTableSortLabel></MudTh>
                            </Header>
                            <Row Context="partida">
                                <MudTd>
                                    <MudTooltip Text="Seleccionar partida">
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                                       Color="@(IsSelectedPartida(partida) ? Color.Success : Color.Info)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => SelectPartida(partida))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Editar partida">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Visible="@CanUpdate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@IsSelectedLocked"
                                                       OnClick="@(() => EditPartida(partida.PkidRequisicionPartida))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar partida">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Visible="@CanDelete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="@IsSelectedLocked"
                                                       OnClick="@(() => DeletePartida(partida))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@(IsSelectedPartida(partida) ? Color.Success : Color.Primary)">
                                        @TextOrDash(partida.PartidaClave)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@TextOrDash(partida.PartidaDescripcion)</MudTd>
                                <MudTd>@MoneyOrDash(partida.Monto)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudItem>

                    <MudItem xs="12" lg="7" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericTable TItem="RequisicionDetalleResponse"
                                      @ref="detalleTable"
                                      Title="@DetalleTableTitle"
                                      SearchPlaceholder="Buscar bien o servicio..."
                                      ShowExportButton="false"
                                      ShowAddButton="@(CanCreate && SelectedPartida != null && !IsSelectedLocked)"
                                      AddButtonTooltip="Agregar bien a la requisicion"
                                      AddButtonIcon="@Icons.Material.Filled.AddShoppingCart"
                                      PageSize="5"
                                      ServerDataFunc="LoadDetallesServerData"
                                      SearchString="@detalleSearchString"
                                      SearchStringChanged="(s) => detalleSearchString = s"
                                      OnSearch="ReloadDetalles"
                                      OnAdd="AddDetalle">
                            <Header>
                                <MudTh>Acciones</MudTh>
                                <MudTh><MudTableSortLabel SortLabel="TipoBienCodigoClave" T="RequisicionDetalleResponse">Clave</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="TipoBienDescripcion" T="RequisicionDetalleResponse">Bien / Servicio</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="Cantidad" T="RequisicionDetalleResponse">Cantidad</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="UnidadMedida" T="RequisicionDetalleResponse">Unidad</MudTableSortLabel></MudTh>
                            </Header>
                            <Row Context="detalle">
                                <MudTd>
                                    <MudTooltip Text="Editar detalle">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Visible="@CanUpdate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@IsSelectedLocked"
                                                       OnClick="@(() => EditDetalle(detalle.PkidRequisicionDetalle))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar detalle">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Visible="@CanDelete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="@IsSelectedLocked"
                                                       OnClick="@(() => DeleteDetalle(detalle))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>@TextOrDash(detalle.TipoBienCodigoClave)</MudTd>
                                <MudTd>@TextOrDash(detalle.TipoBienDescripcion)</MudTd>
                                <MudTd>@Quantity(detalle.Cantidad)</MudTd>
                                <MudTd>@TextOrDash(detalle.UnidadMedida)</MudTd>
                            </Row>
                        </GenericTable>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<RequisicionResponse> table = null!;
    private GenericTable<RequisicionPartidaResponse>? partidaTable;
    private GenericTable<RequisicionDetalleResponse>? detalleTable;
    private RequisicionResponse? SelectedRequisicion;
    private RequisicionPartidaResponse? SelectedPartida;
    private string partidaSearchString = string.Empty;
    private string detalleSearchString = string.Empty;
    private string DetalleTableTitle => SelectedPartida == null
        ? "Detalle de Requisicion"
        : $"Detalle de Requisicion - {SelectedPartida.PartidaClave}";
    private bool IsSelectedLocked => IsLocked(SelectedRequisicion);

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "requisicion";

    protected override Type CreateDialogType => typeof(RequisicionDialog);
    protected override Type EditDialogType => typeof(RequisicionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<RequisicionResponse>);

    protected override string GetDefaultSortLabel() => "PkidRequisicion";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
    }

    protected override async Task<TableData<RequisicionResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var page = Math.Max(1, state.Page + 1);
            CurrentPage = page;
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
                return new TableData<RequisicionResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrEmpty(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<RequisicionResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
            return new TableData<RequisicionResponse>
            {
                Items = new List<RequisicionResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        if (await IsRequisicionLockedAsync(id, "editarla"))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0,
            ["AnioId"] = AnioStateService.AnioId ?? 0
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, $"Editar {SubModuleName}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }

        if (SelectedRequisicion?.PkidRequisicion == id)
        {
            await RefreshSelectedRequisicion();
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        if (await IsRequisicionLockedAsync(id, "eliminarla"))
        {
            return;
        }

        await base.DeleteItem(id);
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<RequisicionResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidRequisicion,
            item.Descripcion,
            Area = item.AreaNombre,
            Solicitante = item.SolicitanteCompleto,
            Fecha = item.FechaRequisicion.ToString("dd/MM/yyyy"),
            item.Importe,
            Tipo = item.Servicio ? "Servicio" : "Bien",
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la requisicion";
    }

    protected override async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            var response = await Service.GetAllPaginadoAsync(1, int.MaxValue, SearchString, sortLabel, SortDirection, filters);

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add(response?.Message ?? "No hay datos para exportar", Severity.Warning);
                return;
            }

            var excelData = MapToExcelData(response.Items);
            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(excelData);

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{AnioStateService.AnioClave}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportacion exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task ReloadData()
    {
        if (SelectedRequisicion == null && table != null)
        {
            await table.ReloadData();
        }
        else
        {
            await ReloadPartidas();
            await ReloadDetalles();
        }
    }

    private void SelectRequisicion(RequisicionResponse item)
    {
        partidaSearchString = string.Empty;
        detalleSearchString = string.Empty;
        SelectedPartida = null;
        SelectedRequisicion = item;
        StateHasChanged();
    }

    private async Task RefreshSelectedRequisicion()
    {
        if (SelectedRequisicion == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedRequisicion.PkidRequisicion);
        if (response?.Success == true && response.Data != null)
        {
            SelectedRequisicion = response.Data;
        }

        await ReloadPartidas();
        await ReloadDetalles();
    }

    private void BackToTable()
    {
        SelectedRequisicion = null;
        SelectedPartida = null;
        partidaSearchString = string.Empty;
        detalleSearchString = string.Empty;
        StateHasChanged();
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
