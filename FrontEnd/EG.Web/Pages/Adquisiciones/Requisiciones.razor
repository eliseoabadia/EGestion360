    private async Task DeletePartida(RequisicionPartidaResponse partida)
    {
        if (!CanModifySelectedRequisicion("eliminar partidas"))
        {
            return;
        }

        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Eliminar la partida {TextOrDash(partida.ClaveNombre)}?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/RequisicionPartida/{partida.PkidRequisicionPartida}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Partida eliminada correctamente", Severity.Success);
                if (SelectedPartida?.PkidRequisicionPartida == partida.PkidRequisicionPartida)
                {
                    SelectedPartida = null;
                }
                await ReloadPartidas();
                await ReloadDetalles();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar la partida", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

