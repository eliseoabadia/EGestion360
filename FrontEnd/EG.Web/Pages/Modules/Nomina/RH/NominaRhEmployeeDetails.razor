@using System.Globalization
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Shared.SoporteDocumental

<section class="rh-inline-details">
    @if (ShowHeader)
    {
        <div class="rh-inline-heading">
            <div>
                <MudText Typo="Typo.subtitle1"><strong>@Employee.ClaveNombre</strong></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                @TextOrDash(Employee.Empresa) · @TextOrDash(Employee.Puesto) · @TextOrDash(Employee.TipoContratacion)
                </MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                Expediente del empleado
            </MudChip>
        </div>
    }

    <MudTabs Elevation="0" Rounded="false" ActivePanelIndex="@activeDetailIndex" ActivePanelIndexChanged="index => activeDetailIndex = index" Class="rh-inline-tabs">
        <MudTabPanel Text="Contratos" Icon="@Icons.Material.Filled.AssignmentInd" />
        <MudTabPanel Text="Expedientes" Icon="@Icons.Material.Filled.FolderCopy" />
        <MudTabPanel Text="Dependientes" Icon="@Icons.Material.Filled.Group" />
        <MudTabPanel Text="Incidencias" Icon="@Icons.Material.Filled.EventBusy" />
        <MudTabPanel Text="Pensiones" Icon="@Icons.Material.Filled.AccountBalance" />
    </MudTabs>

    @switch (activeDetailIndex)
    {
        case 0:
            <NominaRhDetailTable TItem="NominaRhContratoResponse"
                                 @key="@($"contratos-{Employee.Id}")"
                                 PersonaId="@Employee.Id" EmpresaId="@Employee.EmpresaId" PersonaNombre="@Employee.ClaveNombre"
                                 Title="Contratos" AddButtonText="Nuevo contrato" SearchPlaceholder="Buscar contrato, puesto o departamento..."
                                 DefaultSort="FechaInicio" DialogType="@typeof(NominaRhContratoDialog)"
                                 IdSelector="item => item.PkidContratoLaboral" NameSelector="item => item.NumeroContrato"
                                 ExportMapper="MapContratoExport" CanCreate="@CanCreate" CanUpdate="@CanUpdate" CanDelete="@CanDelete" CanExport="@CanExport"
                                 OnChanged="OnChanged">

                <Columns>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Contrato" Identifier="NumeroContrato" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@cell.Item.NumeroContrato</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Puesto" Identifier="PuestoNombre" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.PuestoNombre)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Contratacion" Identifier="TipoContratacionDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.TipoContratacionDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Departamento" Identifier="DepartamentoNombre" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.DepartamentoNombre)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Inicio" Identifier="FechaInicio" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.FechaInicio)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Fin" Identifier="FechaFin" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.FechaFin)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Sueldo" Identifier="SueldoMensual" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatMoney(cell.Item.SueldoMensual)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhContratoResponse" Title="Vigencia" Identifier="Vigencia" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.Vigencia)</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </NominaRhDetailTable>
            break;
        case 1:
            <NominaRhDetailTable TItem="NominaRhExpedienteResponse"
                                 @key="@($"expedientes-{Employee.Id}")"
                                 PersonaId="@Employee.Id" EmpresaId="@Employee.EmpresaId" PersonaNombre="@Employee.ClaveNombre"
                                 Title="Expedientes" AddButtonText="Nuevo documento" SearchPlaceholder="Buscar documento, tipo o descripcion..."
                                 DefaultSort="FechaExpedicion" DialogType="@typeof(NominaRhExpedienteDialog)"
                                 IdSelector="item => item.PkidExpediente" NameSelector="item => item.NombreDocumento"
                                 ExportMapper="MapExpedienteExport" CanCreate="@CanCreate" CanUpdate="@CanUpdate" CanDelete="@CanDelete" CanExport="@CanExport"
                                 OnChanged="OnChanged">

                <Columns>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Documento" Identifier="NombreDocumento" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@cell.Item.NombreDocumento</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Tipo" Identifier="TipoExpedienteDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.TipoExpedienteDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Descripcion" Identifier="Descripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.Descripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Expedicion" Identifier="FechaExpedicion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.FechaExpedicion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Renovacion" Identifier="FechaRenovacion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.FechaRenovacion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Referencia heredada" Identifier="Ruta" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@if (HasLegacyReference(cell.Item.Ruta))
                        {
                            <MudLink Href="@cell.Item.Ruta" Target="_blank" Typo="Typo.caption">
                                Abrir referencia
                            </MudLink>
                        }
                        else
                        {
                            <span>-</span>
                        }</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhExpedienteResponse" Title="Control" Identifier="NecesitaRenovacion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@(cell.Item.NecesitaRenovacion == true ? "Renovable" : "Permanente")</CellTemplate>
                    </TemplateColumn>
                </Columns>
                <AdditionalActions Context="item">
                    <DocumentSupportButton Modulo="Nomina"
                                           SubModulo="Empleados"
                                           Controlador="Expediente"
                                           Servicio="NomRhExpediente"
                                           EntidadId="@item.PkidExpediente"
                                           FkidEmpresaSis="@Employee.EmpresaId"
                                           RegistroTitulo="@item.NombreDocumento"
                                           RegistroDescripcion="@($"{item.TipoExpedienteDescripcion} | {TextOrDash(item.Descripcion)}")"
                                           CanManage="@CanUpdate" />
                </AdditionalActions>
            </NominaRhDetailTable>
            break;
        case 2:
            <NominaRhDetailTable TItem="NominaRhDependienteResponse"
                                 @key="@($"dependientes-{Employee.Id}")"
                                 PersonaId="@Employee.Id" EmpresaId="@Employee.EmpresaId" PersonaNombre="@Employee.ClaveNombre"
                                 Title="Dependientes" AddButtonText="Nuevo dependiente" SearchPlaceholder="Buscar dependiente o parentesco..."
                                 DefaultSort="Nombre" DialogType="@typeof(NominaRhDependienteDialog)"
                                 IdSelector="item => item.PkidDependiente" NameSelector="item => item.Nombre"
                                 ExportMapper="MapDependienteExport" CanCreate="@CanCreate" CanUpdate="@CanUpdate" CanDelete="@CanDelete" CanExport="@CanExport"
                                 OnChanged="OnChanged">

                <Columns>
                    <TemplateColumn T="NominaRhDependienteResponse" Title="Nombre" Identifier="Nombre" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@cell.Item.Nombre</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhDependienteResponse" Title="Parentesco" Identifier="ParentescoDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.ParentescoDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhDependienteResponse" Title="Fecha de nacimiento" Identifier="FechaNacimiento" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.FechaNacimiento)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhDependienteResponse" Title="Creado" Identifier="FechaCreacion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDateTime(cell.Item.FechaCreacion)</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </NominaRhDetailTable>
            break;
        case 3:
            <NominaRhDetailTable TItem="NominaRhIncidenciaResponse"
                                 @key="@($"incidencias-{Employee.Id}")"
                                 PersonaId="@Employee.Id" EmpresaId="@Employee.EmpresaId" PersonaNombre="@Employee.ClaveNombre"
                                 Title="Incidencias" AddButtonText="Nueva incidencia" SearchPlaceholder="Buscar incidencia, comentario o justificacion..."
                                 DefaultSort="Fecha" DialogType="@typeof(NominaRhIncidenciaDialog)"
                                 IdSelector="item => item.PkidIncidencia" NameSelector="item => item.ClaveNombre"
                                 ExportMapper="MapIncidenciaExport" CanCreate="@CanCreate" CanUpdate="@CanUpdate" CanDelete="@CanDelete" CanExport="@CanExport"
                                 OnChanged="OnChanged">

                <Columns>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Fecha" Identifier="Fecha" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDate(cell.Item.Fecha)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Tipo" Identifier="TipoIncidenciaDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.TipoIncidenciaDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Comentario" Identifier="Comentario" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.Comentario)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Justificacion" Identifier="TipoJustificacionDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.TipoJustificacionDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Comentario de justificacion" Identifier="ComentarioJustificacion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.ComentarioJustificacion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Descuento" Identifier="AplicaDescuento" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@(cell.Item.AplicaDescuento == true ? "Si" : "No")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhIncidenciaResponse" Title="Periodo" Identifier="FkidPeriodoQuincenalSis" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@(cell.Item.FkidPeriodoQuincenalSis?.ToString() ?? "-")</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </NominaRhDetailTable>
            break;
        default:
            <NominaRhDetailTable TItem="NominaRhPensionResponse"
                                 @key="@($"pensiones-{Employee.Id}")"
                                 PersonaId="@Employee.Id" EmpresaId="@Employee.EmpresaId" PersonaNombre="@Employee.ClaveNombre"
                                 Title="Pensiones" AddButtonText="Nueva pension" SearchPlaceholder="Buscar beneficiario, documento o cuenta..."
                                 DefaultSort="FechaInicio" DialogType="@typeof(NominaRhPensionDialog)"
                                 IdSelector="item => item.PkidPension" NameSelector="item => item.NombreBeneficiario"
                                 ExportMapper="MapPensionExport" CanCreate="@CanCreate" CanUpdate="@CanUpdate" CanDelete="@CanDelete" CanExport="@CanExport"
                                 OnChanged="OnChanged">

                <Columns>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Beneficiario" Identifier="NombreBeneficiario" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@cell.Item.NombreBeneficiario</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Tipo" Identifier="TipoPensionDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.TipoPensionDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Porcentaje" Identifier="Porcentaje" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatPercent(cell.Item.Porcentaje)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Inicio" Identifier="FechaInicio" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDateTime(cell.Item.FechaInicio)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Fin" Identifier="FechaFin" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@FormatDateTime(cell.Item.FechaFin)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Documento" Identifier="Documento" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.Documento)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Cuenta contable" Identifier="CuentaContableDescripcion" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.CuentaContableDescripcion)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhPensionResponse" Title="Forma de pago" Identifier="FormaPago" Sortable="false" Filterable="false">
                        <CellTemplate Context="cell">@TextOrDash(cell.Item.FormaPago)</CellTemplate>
                    </TemplateColumn>
                </Columns>
            </NominaRhDetailTable>
            break;
    }
</section>

@code {
    [Parameter, EditorRequired] public NominaRhEmpleadoResponse Employee { get; set; } = null!;
    [Parameter] public bool CanCreate { get; set; }
    [Parameter] public bool CanUpdate { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanExport { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public EventCallback OnChanged { get; set; }

    private int activeDetailIndex;

    private static object MapContratoExport(NominaRhContratoResponse item) => new { item.NumeroContrato, item.PuestoNombre, item.TipoContratacionDescripcion, item.DepartamentoNombre, item.FechaInicio, item.FechaFin, item.SueldoMensual, item.Vigencia };
    private static object MapExpedienteExport(NominaRhExpedienteResponse item) => new { item.NombreDocumento, item.TipoExpedienteDescripcion, item.Descripcion, item.FechaExpedicion, item.NecesitaRenovacion, item.FechaRenovacion, item.Ruta };
    private static object MapDependienteExport(NominaRhDependienteResponse item) => new { item.Nombre, item.ParentescoDescripcion, item.FechaNacimiento, item.FechaCreacion };
    private static object MapIncidenciaExport(NominaRhIncidenciaResponse item) => new { item.Fecha, item.TipoIncidenciaDescripcion, item.Comentario, item.TipoJustificacionDescripcion, item.ComentarioJustificacion, item.AplicaDescuento, item.FkidPeriodoQuincenalSis };
    private static object MapPensionExport(NominaRhPensionResponse item) => new { item.NombreBeneficiario, item.TipoPensionDescripcion, item.Porcentaje, item.FechaInicio, item.FechaFin, item.Documento, item.CuentaContable, item.CuentaContableDescripcion, item.FormaPago };

    private static string FormatDate(DateOnly? value) => value?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string FormatDate(DateOnly value) => value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
    private static string FormatDateTime(DateTime? value) => value?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string FormatMoney(decimal? value) => value?.ToString("N2", CultureInfo.InvariantCulture) ?? "-";
    private static string FormatMoney(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);
    private static string FormatPercent(decimal? value) => value.HasValue ? value.Value.ToString("0.####", CultureInfo.InvariantCulture) + "%" : "-";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static bool HasLegacyReference(string? value)
        => Uri.TryCreate(value, UriKind.Absolute, out _);
}
