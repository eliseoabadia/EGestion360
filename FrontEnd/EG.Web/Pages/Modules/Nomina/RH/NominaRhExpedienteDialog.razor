@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental

@inject IGenericCrudService<NominaRhExpedienteResponse> Service
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="NominaRhExpedienteResponse"
                Title="@DialogTitle"
                MaxWidth="MaxWidth.Large"
                ActionText="@ActionText"
                ProcessingText="Guardando..."
                LoadingMessage="Cargando expediente..."
                OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="NominaRhExpedienteResponse" @ref="form" ShowHeader="false">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            <strong>Empleado:</strong> @PersonaNombre
        </MudAlert>

        <MudGrid GutterSize="2">
            <MudItem xs="12" md="4">
                <NominaRhLookupSelect Value="@item.FkidTipoExpedienteNom"
                                      ValueChanged="value => item.FkidTipoExpedienteNom = value"
                                      Catalogo="TipoExpediente"
                                      Label="Tipo de expediente"
                                      InitialText="@item.TipoExpedienteDescripcion"
                                      Required="true" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="item.NombreDocumento"
                              Label="Nombre del documento"
                              Variant="Variant.Outlined"
                              MaxLength="255"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="8">
                @if (Id.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        <div class="d-flex align-center gap-2">
                            <div>
                                <strong>Soporte documental</strong>
                                <div>Administra archivos, vista previa, descarga y anotaciones.</div>
                            </div>
                            <MudSpacer />
                            <DocumentSupportButton Modulo="Nomina"
                                                   SubModulo="Empleados"
                                                   Controlador="Expediente"
                                                   Servicio="NomRhExpediente"
                                                   EntidadId="@item.PkidExpediente"
                                                   FkidEmpresaSis="@EmpresaId"
                                                   RegistroTitulo="@item.NombreDocumento"
                                                   RegistroDescripcion="@item.Descripcion"
                                                   CanManage="true"
                                                   Size="Size.Medium" />
                        </div>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Al crear el expediente se abrirá el soporte documental para adjuntar sus archivos.
                    </MudAlert>
                }
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="FechaExpedicion"
                               Label="Fecha de expedicion"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripcion"
                              Variant="Variant.Outlined"
                              MaxLength="1000"
                              Lines="2" />
            </MudItem>
            @if (HasLegacyReference)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Este expediente conserva una referencia del sistema anterior:
                        <MudLink Href="@item.Ruta" Target="_blank">abrir documento heredado</MudLink>.
                        Los archivos nuevos deben agregarse desde soporte documental.
                    </MudAlert>
                </MudItem>
            }
            <MudItem xs="12" md="4">
                <MudSwitch T="bool" Value="@(item.NecesitaRenovacion ?? false)"
                           ValueChanged="value => item.NecesitaRenovacion = value"
                           Color="Color.Primary">
                    Requiere renovacion
                </MudSwitch>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="FechaRenovacion"
                               Label="Fecha de renovacion"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@(item.NecesitaRenovacion != true)"
                               Required="@(item.NecesitaRenovacion == true)" />
            </MudItem>
            <MudItem xs="12">
                <NominaRhAuditInfo UsuarioCreacion="@item.UsuarioCreacion"
                                   FechaCreacion="@item.FechaCreacion"
                                   UsuarioModificacion="@item.UsuarioModificacion"
                                   FechaModificacion="@item.FechaModificacion" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int PersonaId { get; set; }
    [Parameter] public int? EmpresaId { get; set; }
    [Parameter] public string PersonaNombre { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<NominaRhExpedienteResponse> form = null!;
    private NominaRhExpedienteResponse item = new() { Activo = true };
    private string DialogTitle => Id.HasValue ? "Editar expediente" : "Nuevo expediente";
    private string ActionText => Id.HasValue ? "Actualizar" : "Crear y adjuntar";
    private bool HasLegacyReference => Uri.TryCreate(item.Ruta, UriKind.Absolute, out _);

    private DateTime? FechaExpedicion
    {
        get => item.FechaExpedicion?.ToDateTime(TimeOnly.MinValue);
        set => item.FechaExpedicion = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private DateTime? FechaRenovacion
    {
        get => item.FechaRenovacion?.ToDateTime(TimeOnly.MinValue);
        set => item.FechaRenovacion = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No fue posible cargar el expediente.", Severity.Error);
            }
        }

        item.FkidPersonaNom = PersonaId;
    }

    private async Task SaveAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        item.FkidPersonaNom = PersonaId;
        if (item.NecesitaRenovacion != true)
        {
            item.FechaRenovacion = null;
        }

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Expediente guardado correctamente.", Severity.Success);

                if (!Id.HasValue && response.Data?.PkidExpediente > 0)
                {
                    item = response.Data;
                    Id = item.PkidExpediente;
                    await OpenDocumentSupportAsync();
                }

                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "No fue posible guardar el expediente.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("No fue posible guardar el expediente. El departamento de TI revisara el incidente.", Severity.Error);
        }
    }

    private async Task OpenDocumentSupportAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(DocumentSupportDialog.Modulo)] = "Nomina",
            [nameof(DocumentSupportDialog.SubModulo)] = "Empleados",
            [nameof(DocumentSupportDialog.Controlador)] = "Expediente",
            [nameof(DocumentSupportDialog.Servicio)] = "NomRhExpediente",
            [nameof(DocumentSupportDialog.EntidadId)] = item.PkidExpediente,
            [nameof(DocumentSupportDialog.FkidEmpresaSis)] = EmpresaId,
            [nameof(DocumentSupportDialog.RegistroTitulo)] = item.NombreDocumento,
            [nameof(DocumentSupportDialog.RegistroDescripcion)] = item.Descripcion,
            [nameof(DocumentSupportDialog.CanManage)] = true
        };

        var dialog = await DialogService.ShowAsync<DocumentSupportDialog>(
            "Soporte documental",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        await dialog.Result;
    }
}
