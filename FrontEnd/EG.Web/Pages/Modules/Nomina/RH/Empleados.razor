@page "/nomina/empleados"
@page "/rh/persona"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@inherits BaseCrudPage<NominaRhEmpleadoResponse, NominaRhEmpleadoResponse>

@inject SucursalStateService SucursalStateService
@inject AuthenticationProviderJWT PageAuthProvider

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column rh-empleados-page" MaxWidth="MaxWidth.False">
        @if (selectedEmployee is null)
        {
            <PageHeader Title="Recursos Humanos"
                        Subtitle="Expediente integral de empleados de nomina"
                        Icon="@Icons.Material.Filled.Badge"
                        CanCreate="@CanCreate"
                        OnCreate="CreateItem"
                        OnRefresh="ReloadAllAsync" />

            <GenericDataGrid TItem="NominaRhEmpleadoResponse"
                          @ref="table"
                          Title="Empleados activos"
                          SearchPlaceholder="Buscar empleado, nombre, RFC, CURP o puesto..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="value => SearchString = value"
                          OnSearch="OnSearch"
                          PageSize="10"
                          FixedHeader="true"
                          TableHeight="max(320px, calc(100dvh - 350px))">
                <Columns>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false" CellClass="rh-main-actions" HeaderClass="rh-main-actions">
                        <CellTemplate Context="cell">
                        <div class="rh-action-buttons" @onclick:stopPropagation="true">
                            <MudTooltip Text="Ver detalle del empleado">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEmployeeDetails(cell.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Editar empleado">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Visible="@CanUpdate"
                                               Disabled="@IsBusy"
                                               OnClick="@(() => EditItem(cell.Item.Id))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar empleado">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Visible="@CanDelete"
                                               Disabled="@IsBusy"
                                               OnClick="@(() => DeleteItem(cell.Item.Id))" />
                            </MudTooltip>
                        </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Empleado" Identifier="Empleado" PropertyName="Empleado" SortBy="x => x.Empleado"><CellTemplate Context="cell"><strong @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@cell.Item.Empleado</strong></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Nombre" Identifier="NombreCompleto" PropertyName="NombreCompleto" SortBy="x => x.NombreCompleto"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@cell.Item.NombreCompleto</span></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="RFC" Identifier="Rfc" PropertyName="Rfc" SortBy="x => x.Rfc"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@cell.Item.Rfc</span></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="CURP" Identifier="Curp" PropertyName="Curp" SortBy="x => x.Curp"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@cell.Item.Curp</span></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Contratacion" Identifier="TipoContratacion" PropertyName="TipoContratacion" SortBy="x => x.TipoContratacion"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@TextOrDash(cell.Item.TipoContratacion)</span></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Puesto" Identifier="Puesto" PropertyName="Puesto" SortBy="x => x.Puesto"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@TextOrDash(cell.Item.Puesto)</span></CellTemplate></TemplateColumn>
                    <TemplateColumn T="NominaRhEmpleadoResponse" Title="Sueldo" Identifier="SueldoMensual" PropertyName="SueldoMensual" SortBy="x => x.SueldoMensual"><CellTemplate Context="cell"><span @ondblclick="@(() => OpenEmployeeDetails(cell.Item))">@FormatMoney(cell.Item.SueldoMensual)</span></CellTemplate></TemplateColumn>
                </Columns>
            </GenericDataGrid>
        }
        else
        {
            <section class="rh-detail-shell" @key="selectedEmployee.Id">
                <EntityDetailHeader Title="@TextOrDash(selectedEmployee.ClaveNombre)"
                                    Subtitle="@BuildEmployeeSubtitle(selectedEmployee)"
                                    StatusText="Activo"
                                    BackTooltip="Regresar a empleados"
                                    EditTooltip="Editar empleado"
                                    DeleteTooltip="Eliminar empleado"
                                    CanUpdate="@CanUpdate"
                                    CanDelete="@CanDelete"
                                    IsBusy="@IsBusy"
                                    OnBack="BackToTable"
                                    OnEdit="@(() => EditItem(selectedEmployee.Id))"
                                    OnDelete="@(() => DeleteItem(selectedEmployee.Id))">
                    <Metrics>
                        <div>
                            <span>Entidad</span>
                            <strong>@TextOrDash(SucursalStateService.EmpresaNombre ?? selectedEmployee.Empresa)</strong>
                        </div>
                        <div>
                            <span>Contrato</span>
                            <strong>@TextOrDash(selectedEmployee.Contrato)</strong>
                        </div>
                        <div>
                            <span>Puesto</span>
                            <strong>@TextOrDash(selectedEmployee.Puesto)</strong>
                        </div>
                        <div>
                            <span>Expedientes</span>
                            <strong>@selectedEmployee.TotalExpedientes.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        </div>
                        <div>
                            <span>Incidencias</span>
                            <strong>@selectedEmployee.TotalIncidencias.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        </div>
                    </Metrics>
                </EntityDetailHeader>

                <NominaRhEmployeeDetails Employee="@selectedEmployee"
                                         CanCreate="@CanCreate"
                                         CanUpdate="@CanUpdate"
                                         CanDelete="@CanDelete"
                                         CanExport="@CanExport"
                                         ShowHeader="false"
                                         OnChanged="ReloadEmployeeAsync" />
            </section>
        }
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<NominaRhEmpleadoResponse>? table;
    private NominaRhEmpleadoResponse? selectedEmployee;

    protected override string ModuleName => "Nomina";
    protected override string SubModuleName => "Empleados";
    protected override Type CreateDialogType => typeof(NominaRhEmpleadoDialog);
    protected override Type EditDialogType => typeof(NominaRhEmpleadoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NominaRhEmpleadoResponse>);
    protected override int ExportPageSize => 2000;

    protected override async Task VerifyAccess()
    {
        IsInitialized = true;

        CanView = HasAnyPermission("view") || HasAnyPermission("view-menu");
        CanCreate = HasAnyPermission("new");
        CanUpdate = HasAnyPermission("update");
        CanDelete = HasAnyPermission("delete");
        CanExport = HasAnyPermission("CanExportToExcel");
        CanAuthorize = HasAnyPermission("authorize");

        if (!CanView)
        {
            HasAccess = false;
            StateHasChanged();
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        HasAccess = true;
        Loading = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SucursalStateService.InitializeAsync();
    }

    protected override async Task<TableData<NominaRhEmpleadoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection);
            if (response?.Success == true)
            {
                Elements = response.Items?.ToList() ?? [];
                TotalCount = response.TotalCount;
                return new TableData<NominaRhEmpleadoResponse> { Items = Elements, TotalItems = TotalCount };
            }

            Snackbar.Add(response?.Message ?? "No fue posible cargar los empleados.", Severity.Error);
            return new TableData<NominaRhEmpleadoResponse>();
        }
        catch
        {
            Snackbar.Add("No fue posible cargar los empleados. El departamento de TI revisara el incidente.", Severity.Error);
            return new TableData<NominaRhEmpleadoResponse>();
        }
    }

    private void OpenEmployeeDetails(NominaRhEmpleadoResponse item)
        => selectedEmployee = item;

    private async Task BackToTable()
    {
        selectedEmployee = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadEmployeeAsync()
    {
        if (selectedEmployee is null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(selectedEmployee.Id);
        if (response?.Success == true && response.Data != null)
        {
            selectedEmployee = response.Data;
        }
    }

    private async Task ReloadAllAsync()
    {
        if (table is not null)
        {
            await table.ReloadData();
        }

        await ReloadEmployeeAsync();
    }

    protected override Task ReloadData() => ReloadAllAsync();
    protected override string GetDefaultSortLabel() => "NombreCompleto";
    protected override Task<string> GetItemNameForDelete(int id) => Task.FromResult(Elements.FirstOrDefault(item => item.Id == id)?.ClaveNombre ?? selectedEmployee?.ClaveNombre ?? "el empleado");

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NominaRhEmpleadoResponse> items) => items.Select(item => new
    {
        item.Empleado,
        item.NombreCompleto,
        item.Rfc,
        item.Curp,
        item.Sexo,
        Nacimiento = FormatDateTime(item.FechaNacimiento),
        Ingreso = FormatDateTime(item.FechaIngreso),
        item.TipoContratacion,
        item.Puesto,
        item.Departamento,
        item.Contrato,
        Sueldo = item.SueldoMensual,
        item.Email,
        item.Celular,
        item.EstadoCivil,
        item.RegImss
    });

    private static string FormatDateTime(DateTime? value) => value?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string FormatMoney(decimal? value) => value?.ToString("N2", CultureInfo.InvariantCulture) ?? "-";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private bool HasAnyPermission(string action)
        => PageAuthProvider.HasPermission("Nomina", "Empleados", action)
           || PageAuthProvider.HasPermission("Nomina_Recursos_Humanos", "Empleados", action)
           || PageAuthProvider.HasPermission("Recursos_Humanos", "Empleados", action);

    private static string BuildEmployeeSubtitle(NominaRhEmpleadoResponse employee)
        => $"{TextOrDash(employee.Empresa)} | {TextOrDash(employee.Puesto)} | {TextOrDash(employee.TipoContratacion)}";
}
