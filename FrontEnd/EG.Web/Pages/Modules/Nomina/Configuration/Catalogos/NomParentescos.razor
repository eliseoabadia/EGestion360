@page "/rh/configuracion/parentesco"
@page "/sis/tipoparentesco"
@page "/sis/parentesco"
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomParentescoResponse, NomParentescoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipo de Parentesco"
                    Subtitle="Catalogo directo SIS.Parentesco"
                    Icon="@Icons.Material.Filled.Groups"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="NomParentescoResponse"
                      @ref="table"
                      Title="Lista de Parentescos"
                      SearchPlaceholder="Buscar parentesco..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                @foreach (var column in VisibleColumns)
                {
                    <MudTh><MudTableSortLabel SortLabel="@column.Name" T="NomParentescoResponse">@NominaCatalogUi.GetLabel(column)</MudTableSortLabel></MudTh>
                }
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(item.PkidParentesco))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(item.PkidParentesco))" />
                    </MudTooltip>
                </MudTd>
                @foreach (var column in VisibleColumns)
                {
                    <MudTd>@NominaCatalogUi.FormatValue(column.GetValue(item))</MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<NomParentescoResponse> table = null!;
    private static readonly string[] Columns =
    [
        nameof(NomParentescoResponse.PkidParentesco),
        nameof(NomParentescoResponse.Descripcion),
        nameof(NomParentescoResponse.Activo)
    ];

    protected override string ModuleName => "Tipo_Parentesco";
    protected override string SubModuleName => "Tipo_Parentesco";
    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomParentescoResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomParentescoResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomParentescoResponse>);
    protected override string GetDefaultSortLabel() => nameof(NomParentescoResponse.PkidParentesco);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomParentescoResponse), Columns);

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomParentescoResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el parentesco";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
