            ["/sis/isrquincenal"] = new("ISR Quincenal", "Tabla_ISR_Quincenal", "Nomina_Tablas_ISR"),
            ["/nomina/configuracion/isr/mensual"] = new("ISR Mensual", "Tabla_ISR_Mensual", "Nomina_Tablas_ISR"),
            ["/sis/isrmensual"] = new("ISR Mensual", "Tabla_ISR_Mensual", "Nomina_Tablas_ISR"),
            ["/nomina/configuracion/tablas-isr/semanal"] = new("ISR Semanal", "ISR_Semanal", "Nomina_Tablas_ISR"),
            ["/nomina/configuracion/tablas-isr/quincenal"] = new("ISR Quincenal", "ISR_Quincenal", "Nomina_Tablas_ISR"),
            ["/nomina/configuracion/tablas-isr/mensual"] = new("ISR Mensual", "ISR_Mensual", "Nomina_Tablas_ISR"),
            ["/nomina/configuracion/subsidios/semanal"] = new("Subsidio ISR Semanal", "Subsidio_ISR_Semanal", "Nomina_Subsidios_ISR"),
            ["/sis/subsidiosemanal"] = new("Subsidio ISR Semanal", "Subsidio_ISR_Semanal", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/subsidios/quincenal"] = new("Subsidio ISR Quincenal", "Subsidio_ISR_Quincenal", "Nomina_Subsidios_ISR"),
            ["/sis/subsidioquincenal"] = new("Subsidio ISR Quincenal", "Subsidio_ISR_Quincenal", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/subsidios/mensual"] = new("Subsidio ISR Mensual", "Subsidio_ISR_Mensual", "Nomina_Subsidios_ISR"),
            ["/sis/subsidiomensual"] = new("Subsidio ISR Mensual", "Subsidio_ISR_Mensual", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/subsidios-isr/semanal"] = new("Subsidio ISR Semanal", "Subsidio_ISR_Semanal", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/subsidios-isr/quincenal"] = new("Subsidio ISR Quincenal", "Subsidio_ISR_Quincenal", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/subsidios-isr/mensual"] = new("Subsidio ISR Mensual", "Subsidio_ISR_Mensual", "Nomina_Subsidios_ISR"),
            ["/nomina/configuracion/impuestos/base-gravable"] = new("Base Gravable", "Base_Gravable", "Nomina_Impuestos"),
            ["/sis/basegravable"] = new("Base Gravable", "Base_Gravable", "Nomina_Impuestos"),
            ["/nomina/configuracion/impuestos/locales"] = new("Impuestos Locales", "Impuestos_Locales", "Nomina_Impuestos"),
