            ["/nomina/configuracion/imss/clase-imss"] = new("Clase IMSS", "Clase_IMSS", "Nomina_IMSS"),
            ["/nomina/configuracion/imss/fraccion"] = new("Fraccion IMSS", "Fraccion_IMSS", "Nomina_IMSS"),
