            ["/sis/basegravableimss"] = new("Base Gravable IMSS", "Base_Gravable_IMSS", "Nomina_IMSS")
        };

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

    private PendingCatalogItem CurrentItem =>
        ItemsByPath.TryGetValue(CurrentPath, out var item)
            ? item
            : new PendingCatalogItem("Catalogo de Nomina", "Pendiente", "Nomina");

    private static Task Refresh() => Task.CompletedTask;

    private sealed record PendingCatalogItem(string Title, string LegacyName, string GroupName);
}
