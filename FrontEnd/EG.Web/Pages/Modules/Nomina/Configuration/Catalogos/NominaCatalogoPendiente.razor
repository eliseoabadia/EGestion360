@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <PageHeader Title="@CurrentItem.Title"
                Subtitle="Pendiente de migracion"
                Icon="@Icons.Material.Filled.PendingActions"
                CanCreate="false"
                OnRefresh="Refresh" />

    <MudPaper Class="pa-6 mt-4" Elevation="1">
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Esta pantalla existe en el menu legado, pero aun no tiene entidad, API y pagina CRUD migradas en EGestion360.
            </MudAlert>

            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    <tr>
                        <td><strong>Ruta</strong></td>
                        <td>@CurrentPath</td>
                    </tr>
                    <tr>
                        <td><strong>Clave legacy</strong></td>
                        <td>@CurrentItem.LegacyName</td>
                    </tr>
                    <tr>
                        <td><strong>Modulo sugerido</strong></td>
                        <td>@CurrentItem.GroupName</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudStack>
    </MudPaper>
</MudContainer>

