    private async Task<ComboLookupResult> LoadInfonavitsPageAsync(int page, int pageSize, string filter)
    {
        var response = await InfonavitService.GetAllPaginadoAsync(page, pageSize, filter, "MotivoInfonavit");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPuestosPageAsync(int page, int pageSize, string filter)
    {
        var response = await PuestoService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadNivelesPageAsync(int page, int pageSize, string filter)
    {
        var response = await NivelService.GetAllPaginadoAsync(page, pageSize, filter, "Clave");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadUniversosPageAsync(int page, int pageSize, string filter)
    {
        var response = await UniversoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadClasesPuestoPageAsync(int page, int pageSize, string filter)
    {
        var response = await ClasePuestoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadNombramientosPageAsync(int page, int pageSize, string filter)
    {
        var response = await NombramientoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPeriodosPageAsync(int page, int pageSize, string filter)
    {
        var response = await PeriodoActivoService.GetAllPaginadoAsync(page, pageSize, filter, "IdPeriodo", SortDirection.Descending, GetEmpresaFilter());
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadContratosPageAsync(int page, int pageSize, string filter)
    {
        var response = await ContratoService.GetAllPaginadoAsync(page, pageSize, filter, "NumeroContrato");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private Dictionary<string, object>? GetEmpresaFilter()
    {
        var empresaProperty = typeof(TItem).GetProperty("FkidEmpresaSis");
        var empresaId = empresaProperty == null ? null : GetIntValue(empresaProperty);
        return empresaId.HasValue && empresaId.Value > 0
            ? new Dictionary<string, object> { ["FkidEmpresaSis"] = empresaId.Value }
            : null;
    }

    private static ComboLookupResult LoadNumericLookupPage(LookupConfig lookup, string filter)
    {
        var items = new List<LookupItem>();
        if (int.TryParse(filter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) && id > 0)
        {
            items.Add(new LookupItem { Id = id, Text = $"{GetFallbackLookupLabel(lookup.PropertyName)} ID {id}" });
        }

        return new ComboLookupResult { Items = items, TotalCount = items.Count };
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem?>? items, int? totalCount)
    {
        var list = items?
            .Where(item => item is not null && item.Id > 0 && !string.IsNullOrWhiteSpace(item.Text))
            .Select(item => item!)
            .GroupBy(item => item.Id)
            .Select(group => group.First())
            .ToList() ?? new List<LookupItem>();

        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        try
        {
            TrimStringValues();

            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Registro guardado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar el registro.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private static bool IsIgnoredProperty(PropertyInfo property)
    {
        if (property.Name.StartsWith("Pkid", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return property.Name is "ClaveNombre"
            or "EmpresaNominaNombre"
            or "ConceptoClaveNombre"
            or "PuestoNombre"
            or "PuestoClaveNombre"
            or "PuestoPadreNombre"
            or "NivelClave"
            or "UniversoDescripcion"
            or "ClasePuestoDescripcion"
            or "PersonaClaveNombre"
            or "NombramientoDescripcion"
            or "FechaCreacion"
            or "UsuarioCreacion"
            or "FechaModificacion"
            or "UsuarioModificacion";
    }

    private static bool IsBoolean(PropertyInfo property)
    {
        var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        return type == typeof(bool);
    }

    private static bool IsNullable(PropertyInfo property)
        => Nullable.GetUnderlyingType(property.PropertyType) != null || !property.PropertyType.IsValueType;

    private static bool IsRequired(PropertyInfo property)
        => !IsNullable(property);

    private static bool IsLongText(PropertyInfo property)
        => property.Name.Contains("Descripcion", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Observaciones", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Referencia", StringComparison.OrdinalIgnoreCase);

    private static InputType GetInputType(PropertyInfo property)
    {
        var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (type == typeof(int) || type == typeof(decimal) || type == typeof(double) || type == typeof(float))
        {
            return InputType.Number;
        }

        if (type == typeof(DateTime) || type == typeof(DateOnly))
        {
            return InputType.Date;
        }

        return InputType.Text;
    }

    private string GetTextValue(PropertyInfo property)
    {
        var value = property.GetValue(item);
        return value switch
        {
            null => string.Empty,
            DateTime date => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            DateOnly date => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            decimal number => number.ToString("0.####", CultureInfo.InvariantCulture),
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? string.Empty
        };
    }

    private void SetTextValue(PropertyInfo property, string value)
    {
        var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;

        try
        {
            object? converted;
            if (string.IsNullOrWhiteSpace(value))
            {
                converted = Nullable.GetUnderlyingType(property.PropertyType) != null || targetType == typeof(string)
                    ? null
                    : targetType == typeof(decimal) ? 0m
                    : targetType == typeof(int) ? 0
                    : targetType == typeof(bool) ? false
                    : Activator.CreateInstance(targetType);
            }
            else if (targetType == typeof(string))
            {
                converted = value;
            }
            else if (targetType == typeof(int))
            {
                converted = int.Parse(value, CultureInfo.InvariantCulture);
            }
            else if (targetType == typeof(decimal))
            {
                converted = decimal.Parse(value, NumberStyles.Any, CultureInfo.InvariantCulture);
            }
            else if (targetType == typeof(DateTime))
            {
                converted = DateTime.Parse(value, CultureInfo.InvariantCulture);
            }
            else if (targetType == typeof(DateOnly))
            {
                converted = DateOnly.Parse(value, CultureInfo.InvariantCulture);
            }
            else
            {
                converted = Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);
            }

            property.SetValue(item, converted);
        }
        catch
        {
            Snackbar.Add($"El valor de {GetLabel(property)} no es valido.", Severity.Warning);
        }
    }

    private bool GetBoolValue(PropertyInfo property)
        => property.GetValue(item) as bool? ?? false;

    private void SetBoolValue(PropertyInfo property, bool value)
        => property.SetValue(item, value);

    private bool GetActivoValue()
    {
        var property = typeof(TItem).GetProperty("Activo");
        return property?.GetValue(item) as bool? ?? true;
    }

    private void SetActivoValue(bool value)
    {
        var property = typeof(TItem).GetProperty("Activo");
        property?.SetValue(item, value);
    }

    private void TrimStringValues()
    {
        foreach (var property in typeof(TItem).GetProperties(BindingFlags.Instance | BindingFlags.Public)
            .Where(p => p.CanRead && p.CanWrite && p.PropertyType == typeof(string)))
        {
            var value = property.GetValue(item) as string;
            property.SetValue(item, value?.Trim() ?? string.Empty);
        }
    }

    private static LookupItem? ToLookupItem(EmpresaResponse? value)
        => value == null ? null : new LookupItem { Id = value.PkidEmpresa, Text = value.EmpresaNombre ?? value.RazonSocial ?? $"Empresa {value.PkidEmpresa}" };

    private static LookupItem? ToLookupItem(NomEmpresaNominaResponse? value)
        => value == null ? null : new LookupItem { Id = value.PkidEmpresaNomina, Text = value.ClaveNombre };

    private static LookupItem? ToLookupItem(PersonaResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidPersona,
                Text = $"{value.Clave} - {value.Nombre} {value.Paterno} {value.Materno}".Trim(' ', '-')
            };

    private static LookupItem? ToLookupItem(NomConceptoResponse? value)
        => value == null ? null : new LookupItem { Id = value.PkidConcepto, Text = value.ClaveNombre };

    private static LookupItem? ToLookupItem(NomConceptoProporcionalResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidConceptoProporcional,
                Text = $"Concepto proporcional {value.PkidConceptoProporcional} - Concepto {value.FkidConceptoNom}"
            };

    private static LookupItem? ToLookupItem(NomContratoTercerosResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidContratoTercero,
                Text = $"{value.NombreContrato} - {value.Descripcion}".Trim(' ', '-')
            };

    private static LookupItem? ToLookupItem(NomCreditoResponse? value)
