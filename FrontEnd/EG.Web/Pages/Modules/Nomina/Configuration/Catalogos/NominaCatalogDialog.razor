            };

    private static LookupItem? ToLookupItem(NomClasePuestoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidClasePuesto,
                Text = value.ClaveNombre
            };

    private static LookupItem? ToLookupItem(NomNombramientoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidNombramiento,
                Text = value.ClaveNombre
            };

    private static LookupItem? ToLookupItem(NomPeriodoActivoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.IdPeriodo,
                Text = $"Periodo {value.IdPeriodo} - Empresa {value.FkidEmpresaSis}"
            };

    private static LookupItem? ToLookupItem(ContratoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidContrato,
                Text = $"{value.NumeroContrato} - {value.Descripcion}".Trim(' ', '-')
            };

