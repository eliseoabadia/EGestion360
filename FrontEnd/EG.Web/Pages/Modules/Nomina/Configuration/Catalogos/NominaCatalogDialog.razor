    private async Task<ComboLookupResult> LoadCreditosPageAsync(int page, int pageSize, string filter)
    {
        var response = await CreditoService.GetAllPaginadoAsync(page, pageSize, filter, "MotivoCredito");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
