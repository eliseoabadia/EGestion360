            };

    private static LookupItem? ToLookupItem(NomInfonavitResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidInfonavit,
                Text = $"{value.MotivoInfonavit} - {value.ImporteInfonavit.ToString("0.00", CultureInfo.InvariantCulture)}".Trim(' ', '-')
            };

    private static LookupItem? ToLookupItem(NomPuestoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidPuesto,
                Text = value.ClaveNombre
            };

    private static LookupItem? ToLookupItem(NomNivelResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidNivel,
                Text = value.ClaveNombre
            };

    private static LookupItem? ToLookupItem(NomUniversoResponse? value)
        => value == null
            ? null
            : new LookupItem
            {
                Id = value.PkidUniverso,
