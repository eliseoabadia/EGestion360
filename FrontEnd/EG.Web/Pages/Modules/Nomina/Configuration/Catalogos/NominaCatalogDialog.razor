    private async Task<ComboLookupResult> LoadContratosTercerosPageAsync(int page, int pageSize, string filter)
    {
        var response = await ContratoTerceroService.GetAllPaginadoAsync(page, pageSize, filter, "NombreContrato");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
