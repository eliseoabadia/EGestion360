@typeparam TItem where TItem : class, new()
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Domain.DTOs.Responses.Patrimonio
@using System.Globalization
@using System.Reflection
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<TItem> Service
@inject IGenericCrudService<EmpresaResponse> EmpresaService
@inject IGenericCrudService<NomEmpresaNominaResponse> EmpresaNominaService
@inject IGenericCrudService<PersonaResponse> PersonaService
@inject IGenericCrudService<NomConceptoResponse> ConceptoService
@inject IGenericCrudService<NomConceptoProporcionalResponse> ConceptoProporcionalService
@inject IGenericCrudService<NomContratoTercerosResponse> ContratoTerceroService
@inject IGenericCrudService<NomCreditoResponse> CreditoService
@inject IGenericCrudService<NomInfonavitResponse> InfonavitService
@inject IGenericCrudService<NomPeriodoActivoResponse> PeriodoActivoService
@inject IGenericCrudService<NomPuestoResponse> PuestoService
@inject IGenericCrudService<NomNivelResponse> NivelService
@inject IGenericCrudService<NomUniversoResponse> UniversoService
@inject IGenericCrudService<NomClasePuestoResponse> ClasePuestoService
@inject IGenericCrudService<NomNombramientoResponse> NombramientoService
@inject IGenericCrudService<ContratoResponse> ContratoService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TItem"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando catalogo..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="TItem"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            @foreach (var property in EditableProperties)
            {
                var lookup = GetLookupConfig(property);
                <MudItem xs="12" sm="6">
                    @if (lookup is not null)
                    {
                        <PagedAutocomplete Value="@GetLookupValue(property)"
                                           ValueChanged="@((LookupItem? value) => SetLookupValue(property, value))"
                                           Label="@GetLabel(property)"
                                           Required="@IsRequired(property)"
                                           RequiredError="@($"{GetLabel(property)} es requerido")"
                                           Clearable="@IsNullable(property)"
                                           LoadPage="@((page, pageSize, filter, ct) => LoadLookupPageAsync(lookup, page, pageSize, filter, ct))" />
                    }
                    else if (IsBoolean(property))
                    {
                        <MudPaper Class="pa-3" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                            <MudSwitch T="bool"
                                       Value="@GetBoolValue(property)"
                                       ValueChanged="@((bool value) => SetBoolValue(property, value))"
                                       Color="Color.Primary">
                                <MudText>@GetLabel(property)</MudText>
                            </MudSwitch>
                        </MudPaper>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Value="@GetTextValue(property)"
                                      ValueChanged="@((string value) => SetTextValue(property, value))"
                                      Label="@GetLabel(property)"
                                      Variant="Variant.Outlined"
                                      InputType="@GetInputType(property)"
                                      Lines="@(IsLongText(property) ? 3 : 1)"
                                      Immediate="false" />
                    }
                </MudItem>
            }

            @if (Id.HasValue && HasActivo)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                        <MudSwitch T="bool"
                                   Value="@GetActivoValue()"
                                   ValueChanged="@((bool value) => SetActivoValue(value))"
                                   Color="Color.Primary">
                            <MudText>@(GetActivoValue() ? "Activo" : "Inactivo")</MudText>
                        </MudSwitch>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<TItem> form = null!;
    private TItem item = new();
    private readonly Dictionary<string, LookupItem?> lookupValues = new(StringComparer.OrdinalIgnoreCase);

    private string dialogTitle => Id.HasValue ? "Editar registro" : "Nuevo registro";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private IEnumerable<PropertyInfo> EditableProperties => typeof(TItem).GetProperties(BindingFlags.Instance | BindingFlags.Public)
        .Where(p => p.CanRead && p.CanWrite && !IsIgnoredProperty(p) && !(p.Name.Equals("Activo", StringComparison.OrdinalIgnoreCase) && Id.HasValue))
        .Take(18);

    private bool HasActivo => typeof(TItem).GetProperty("Activo") is not null;

    private sealed record LookupConfig(string PropertyName);

    private static LookupConfig? GetLookupConfig(PropertyInfo property)
    {
        var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (type != typeof(int))
        {
            return null;
        }

        return property.Name.StartsWith("Fkid", StringComparison.OrdinalIgnoreCase)
            ? new LookupConfig(property.Name)
            : null;
    }

    protected override async Task OnInitializedAsync()
    {
        SetActivoValue(true);

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }

        await LoadSelectedLookupsAsync();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSelectedLookupsAsync()
    {
        foreach (var property in EditableProperties)
        {
            var lookup = GetLookupConfig(property);
            if (lookup is null)
            {
                continue;
            }

            var id = GetIntValue(property);
            lookupValues[property.Name] = id.HasValue && id.Value > 0
                ? await LoadLookupByIdAsync(lookup, id.Value)
                : null;
        }
    }

    private LookupItem? GetLookupValue(PropertyInfo property)
    {
        if (lookupValues.TryGetValue(property.Name, out var value))
        {
            return value;
        }

        var id = GetIntValue(property);
        if (!id.HasValue || id.Value <= 0)
        {
            return null;
        }

        value = new LookupItem { Id = id.Value, Text = $"{GetLabel(property)} ID {id.Value}" };
        lookupValues[property.Name] = value;
        return value;
    }

    private void SetLookupValue(PropertyInfo property, LookupItem? value)
    {
        lookupValues[property.Name] = value;
        SetIntValue(property, value?.Id);
    }

    private int? GetIntValue(PropertyInfo property)
    {
        var value = property.GetValue(item);
        return value switch
        {
            null => null,
            int number => number,
            _ => int.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed)
                ? parsed
                : null
        };
    }

    private void SetIntValue(PropertyInfo property, int? value)
    {
        if (Nullable.GetUnderlyingType(property.PropertyType) != null)
        {
            property.SetValue(item, value);
            return;
        }

        property.SetValue(item, value ?? 0);
    }

    private async Task<LookupItem?> LoadLookupByIdAsync(LookupConfig lookup, int id)
    {
        try
        {
            return lookup.PropertyName switch
            {
                "FkidEmpresaSis" or "FkidEmpresaNominaNom" => ToLookupItem((await EmpresaNominaService.GetByIdAsync(id)).Data),
                "FkidPersonaNom" => ToLookupItem((await PersonaService.GetByIdAsync(id)).Data),
                "FkidConceptoNom" => ToLookupItem((await ConceptoService.GetByIdAsync(id)).Data),
                "FkidConceptoProporcionalNom" => ToLookupItem((await ConceptoProporcionalService.GetByIdAsync(id)).Data),
                "FkidContratoTerceroNom" => ToLookupItem((await ContratoTerceroService.GetByIdAsync(id)).Data),
                "FkidCreditoNom" => ToLookupItem((await CreditoService.GetByIdAsync(id)).Data),
                "FkidInfonavitNom" => ToLookupItem((await InfonavitService.GetByIdAsync(id)).Data),
                "FkidPuestoNom" or "FkidPuestoPadreNom" => ToLookupItem((await PuestoService.GetByIdAsync(id)).Data),
                "FkidNivelNom" => ToLookupItem((await NivelService.GetByIdAsync(id)).Data),
                "FkidUniversoNom" => ToLookupItem((await UniversoService.GetByIdAsync(id)).Data),
                "FkidClasePuestoNom" => ToLookupItem((await ClasePuestoService.GetByIdAsync(id)).Data),
                "FkidNombramientoNom" => ToLookupItem((await NombramientoService.GetByIdAsync(id)).Data),
                "FkidContratoPres" => ToLookupItem((await ContratoService.GetByIdAsync(id)).Data),
                _ => new LookupItem { Id = id, Text = $"{GetFallbackLookupLabel(lookup.PropertyName)} ID {id}" }
            };
        }
        catch
        {
            return new LookupItem { Id = id, Text = $"{GetFallbackLookupLabel(lookup.PropertyName)} ID {id}" };
        }
    }

    private async Task<ComboLookupResult> LoadLookupPageAsync(LookupConfig lookup, int page, int pageSize, string filter, CancellationToken ct)
    {
        if (ct.IsCancellationRequested)
        {
            return new ComboLookupResult();
        }

        return lookup.PropertyName switch
        {
            "FkidEmpresaSis" or "FkidEmpresaNominaNom" => await LoadEmpresasNominaPageAsync(page, pageSize, filter),
            "FkidPersonaNom" => await LoadPersonasPageAsync(page, pageSize, filter),
            "FkidConceptoNom" => await LoadConceptosPageAsync(page, pageSize, filter),
            "FkidConceptoProporcionalNom" => await LoadConceptosProporcionalesPageAsync(page, pageSize, filter),
            "FkidContratoTerceroNom" => await LoadContratosTercerosPageAsync(page, pageSize, filter),
            "FkidCreditoNom" => await LoadCreditosPageAsync(page, pageSize, filter),
            "FkidInfonavitNom" => await LoadInfonavitsPageAsync(page, pageSize, filter),
            "FkidPuestoNom" or "FkidPuestoPadreNom" => await LoadPuestosPageAsync(page, pageSize, filter),
            "FkidNivelNom" => await LoadNivelesPageAsync(page, pageSize, filter),
            "FkidUniversoNom" => await LoadUniversosPageAsync(page, pageSize, filter),
            "FkidClasePuestoNom" => await LoadClasesPuestoPageAsync(page, pageSize, filter),
            "FkidNombramientoNom" => await LoadNombramientosPageAsync(page, pageSize, filter),
            "FkidPeriodo" or "FkidPeriodoInicial" or "FkidPeriodoFinal" or "FkidPeriodoMensualNom" or "FkidPeriodoQuincenalNom" or "FkidPeriodoSemanalNom" or "FkidNominaEspecialNom"
                => await LoadPeriodosPageAsync(page, pageSize, filter),
            "FkidContratoPres" => await LoadContratosPageAsync(page, pageSize, filter),
            _ => LoadNumericLookupPage(lookup, filter)
        };
    }

    private async Task<ComboLookupResult> LoadEmpresasPageAsync(int page, int pageSize, string filter)
    {
        var response = await EmpresaService.GetAllPaginadoAsync(page, pageSize, filter, "EmpresaNombre");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadEmpresasNominaPageAsync(int page, int pageSize, string filter)
    {
        var response = await EmpresaNominaService.GetAllPaginadoAsync(page, pageSize, filter, "RazonSocial");
        return ToComboResult(response.Items?.Select(ToLookupItem), response.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter)
    {
        var response = await PersonaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre");
