    private GenericTable<NomCatalogoSimpleResponse> table = null!;

    protected override string ModuleName => CurrentItem.ModuleName;
    protected override string SubModuleName => CurrentItem.SubModuleName;
    protected override Type CreateDialogType => typeof(NomCatalogoSimpleDialog);
    protected override Type EditDialogType => typeof(NomCatalogoSimpleDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomCatalogoSimpleResponse>);

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

    private CatalogPageItem CurrentItem =>
        ItemsByPath.TryGetValue(CurrentPath, out var item)
            ? item
            : Nom("Catalogo de Nomina", "Catalogo_Nomina", KeyDescriptionFields, DefaultColumns, Icons.Material.Filled.Category);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomCatalogoSimpleResponse), CurrentItem.Columns);

    protected override string GetDefaultSortLabel() => CurrentItem.DefaultSortLabel;

    protected override async Task<TableData<NomCatalogoSimpleResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                BuildCatalogFilters());

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add(response?.Message ?? "No fue posible obtener el catalogo.", Severity.Error);
            }

            return new TableData<NomCatalogoSimpleResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
            return new TableData<NomCatalogoSimpleResponse>();
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task CreateItem()
    {
        await RunExclusiveAsync(async () =>
        {
            if (!CanCreate)
            {
                Snackbar.Add("No tienes permisos para crear", Severity.Warning);
                return;
            }

            var dialog = await DialogService.ShowAsync<NomCatalogoSimpleDialog>(
                $"Crear {CurrentItem.Title}",
                BuildDialogParameters(),
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadData();
            }
        }, "Operacion en proceso...");
    }

    protected override async Task EditItem(int id)
    {
        await RunExclusiveAsync(async () =>
        {
            if (!CanUpdate)
            {
                Snackbar.Add("No tienes permisos para editar", Severity.Warning);
                return;
            }

            var parameters = BuildDialogParameters();
            parameters["Id"] = id;

            var dialog = await DialogService.ShowAsync<NomCatalogoSimpleDialog>(
                $"Editar {CurrentItem.Title}",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadData();
            }
        }, "Operacion en proceso...");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomCatalogoSimpleResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el catalogo";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private DialogParameters BuildDialogParameters() => new()
    {
        ["Catalogo"] = CurrentItem.Catalogo,
        ["Title"] = CurrentItem.Title,
        ["Fields"] = CurrentItem.Fields,
        ["ParentCatalogo"] = CurrentItem.ParentCatalogo,
        ["ParentLabel"] = CurrentItem.ParentLabel
    };

    private Dictionary<string, object> BuildCatalogFilters()
        => new() { [nameof(NomCatalogoSimpleResponse.Catalogo)] = CurrentItem.Catalogo };

    private static CatalogPageItem Rh(
        string title,
        string catalogo,
        string[] fields,
        string[] columns,
        string icon,
        string moduleName = "",
        string parentCatalogo = "",
        string parentLabel = "Catalogo padre")
        => new(
            title,
            "Catalogo RH migrado desde BD_GRP_INVEA",
            icon,
            string.IsNullOrWhiteSpace(moduleName) ? catalogo : moduleName,
            catalogo,
            catalogo,
            parentCatalogo,
            parentLabel,
            fields,
            columns,
            fields.Contains(nameof(NomCatalogoSimpleResponse.Clave)) ? nameof(NomCatalogoSimpleResponse.Clave) : nameof(NomCatalogoSimpleResponse.Descripcion));

    private static CatalogPageItem Nom(
        string title,
        string catalogo,
        string[] fields,
        string[] columns,
        string icon)
