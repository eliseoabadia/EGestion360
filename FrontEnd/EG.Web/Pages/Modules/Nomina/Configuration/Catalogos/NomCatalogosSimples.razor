<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="@CurrentItem.Title"
                    Subtitle="@CurrentItem.Subtitle"
                    Icon="@CurrentItem.Icon"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="NomCatalogoSimpleResponse"
                      @ref="table"
                      Title="@($"Lista de {CurrentItem.Title}")"
                      SearchPlaceholder="@($"Buscar {CurrentItem.Title.ToLowerInvariant()}...")"
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                @foreach (var column in VisibleColumns)
                {
                    <MudTh><MudTableSortLabel SortLabel="@column.Name" T="NomCatalogoSimpleResponse">@NominaCatalogUi.GetLabel(column)</MudTableSortLabel></MudTh>
                }
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(item.PkidCatalogoSimple))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(item.PkidCatalogoSimple))" />
                    </MudTooltip>
                </MudTd>
                @foreach (var column in VisibleColumns)
                {
                    <MudTd>@NominaCatalogUi.FormatValue(column.GetValue(item))</MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

