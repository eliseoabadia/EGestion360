            title,
            "Catalogo de nomina migrado desde BD_GRP_INVEA",
            icon,
            EG.Web.Pages.Modules.Nomina.NominaClaimGroups.Catalogos,
            catalogo,
            catalogo,
            string.Empty,
            "Catalogo padre",
            fields,
            columns,
            fields.Contains(nameof(NomCatalogoSimpleResponse.Clave)) ? nameof(NomCatalogoSimpleResponse.Clave) : nameof(NomCatalogoSimpleResponse.Descripcion));

    private sealed record CatalogPageItem(
        string Title,
        string Subtitle,
        string Icon,
        string ModuleName,
        string SubModuleName,
        string Catalogo,
        string ParentCatalogo,
        string ParentLabel,
        string[] Fields,
        string[] Columns,
        string DefaultSortLabel);
