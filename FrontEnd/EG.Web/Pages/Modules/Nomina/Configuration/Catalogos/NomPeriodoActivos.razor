@page "/nomina/configuracion/catalogos/periodos-activos"
@page "/nomina/configuracion/periodos/semanal"
@page "/sis/periodosemanal"
@page "/nomina/configuracion/periodos/quincenal"
@page "/sis/periodoquincenal"
@page "/nomina/configuracion/periodos/mensual"
@page "/sis/periodomensual"
@page "/nomina/configuracion/periodos/bimestral"
@page "/sis/periodobimestral"
@using Microsoft.AspNetCore.Components.Routing
@using System.Globalization
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomPeriodoActivoResponse, NomPeriodoActivoResponse>
@implements IDisposable

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Periodos activos"
                    Subtitle="Catálogo NOM.PeriodoActivo"
                    Icon="@Icons.Material.Filled.EventAvailable"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="ReloadData" />

        <GenericDataGrid TItem="NomPeriodoActivoResponse"
                      @ref="table"
                      @key="TableKey"
                      Title="Lista de Periodos activos"
                      SearchPlaceholder="Buscar..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch"
                      ReflectedColumns="@VisibleColumns"
                      ColumnTitleFunc="@(column => GetLabel(column))"
                      CellValueFunc="@((item, column) => FormatValue(column.GetValue(item)))">

            <RowActions Context="item">
                <MudTooltip Text="Editar">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                Visible="@CanUpdate"
                Color="Color.Primary"
                Size="Size.Small"
                Disabled="@IsBusy"
                OnClick="@(() => EditItem(GetItemId(item)))" />
                </MudTooltip>
                <MudTooltip Text="Eliminar">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                Visible="@CanDelete"
                Color="Color.Error"
                Size="Size.Small"
                Disabled="@IsBusy"
                OnClick="@(() => DeleteItem(GetItemId(item)))" />
                </MudTooltip>
            </RowActions>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<NomPeriodoActivoResponse> table = null!;
    private string loadedPath = string.Empty;
    private bool pendingRouteReload;
    private bool disposed;

    protected override string ModuleName => "Periodos";
    protected override string SubModuleName => CurrentPath switch
    {
        "/nomina/configuracion/periodos/semanal" => "Periodo_Semanal",
        "/nomina/configuracion/periodos/quincenal" => "Periodo_Quincenal",
        "/nomina/configuracion/periodos/mensual" => "Periodo_Mensual",
        "/nomina/configuracion/periodos/bimestral" => "Periodo_Bimestral",
        _ => "Periodo_Semanal"
    };

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');
    private string TableKey => $"nom-periodo-activo-table:{CurrentPath}";

    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomPeriodoActivoResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomPeriodoActivoResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomPeriodoActivoResponse>);

    protected override string GetDefaultSortLabel() => "IdPeriodo";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await PrepareRouteChangeAsync(CurrentPath, verifyAccess: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (pendingRouteReload && table != null && HasAccess)
        {
            pendingRouteReload = false;
            await table.ReloadData();
        }
    }

    private IEnumerable<PropertyInfo> VisibleColumns => typeof(NomPeriodoActivoResponse).GetProperties(BindingFlags.Instance | BindingFlags.Public)
        .Where(p => p.CanRead && !IsHiddenColumn(p))
        .Take(7);

    private static bool IsHiddenColumn(PropertyInfo property)
        => property.Name is "ClaveNombre" or "FechaCreacion" or "UsuarioCreacion" or "FechaModificacion" or "UsuarioModificacion";

    private static int GetItemId(NomPeriodoActivoResponse item)
    {
        var property = typeof(NomPeriodoActivoResponse).GetProperties().FirstOrDefault(p => p.Name.StartsWith("Pkid") && p.PropertyType == typeof(int));
        return property?.GetValue(item) as int? ?? 0;
    }

    private static string FormatValue(object? value)
    {
        return value switch
        {
            null => string.Empty,
            DateTime date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            DateOnly date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            decimal number => FormatDecimal(number),
            bool flag => flag ? "Si" : "No",
            _ => value.ToString() ?? string.Empty
        };
    }

    private static string FormatDecimal(decimal value)
        => value.ToString("0.00", CultureInfo.InvariantCulture);

    private static string GetLabel(PropertyInfo property)
    {
        return property.Name switch
        {
            "PkidConcepto" => "ID",
            "FkidEmpresaSis" => "Empresa",
            "FkidPersonaNom" => "Persona",
            "FkidConceptoNom" => "Concepto",
            "FkidPuestoNom" => "Puesto",
            "FkidPeriodo" => "Periodo",
            "FkidPeriodoInicial" => "Periodo inicial",
            "FkidPeriodoFinal" => "Periodo final",
            "FkidContratoTerceroNom" => "Contrato de tercero",
            "FkidConceptoProporcionalNom" => "Concepto proporcional",
            "FkidFormaCalculoNom" => "Forma de cálculo",
            "FkidUnidadInfonavitNom" => "Unidad Infonavit",
            "FkidNominaEspecialNom" => "Nómina especial",
            "FkidContratoPres" => "Contrato",
            "FechaIni" => "Fecha inicial",
            "FechaFin" => "Fecha final",
            "PerDed" => "Percepción/Deducción",
            "TasaInteres" => "Tasa de interés",
            "NumeroPagos" => "Número de pagos",
            "ImporteMensualFijo" => "Importe mensual fijo",
            "EstaCerrado" => "Cerrado",
            "EstaComprometido" => "Comprometido",
            "EstaDevengado" => "Devengado",
            "EstaEjercido" => "Ejercido",
            "EstaDescontado" => "Descontado",
            "ZonaEconomica" => "Zona económica",
            "QuincenaInicio" => "Quincena inicio",
            "QuincenaFin" => "Quincena fin",
            "TotalPeriodos" => "Total de periodos",
            _ => Humanize(property.Name)
        };
    }

    private static string Humanize(string value)
    {
        var text = value
            .Replace("Fkid", string.Empty, StringComparison.Ordinal)
            .Replace("Pkid", "ID", StringComparison.Ordinal)
            .Replace("Nom", string.Empty, StringComparison.Ordinal)
            .Replace("Sis", string.Empty, StringComparison.Ordinal)
            .Replace("Pres", string.Empty, StringComparison.Ordinal);

        return System.Text.RegularExpressions.Regex
            .Replace(text, "([a-z])([A-Z])", "$1 $2")
            .Trim();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomPeriodoActivoResponse> items)
    {
        return items.Select(item => VisibleColumns.ToDictionary(column => GetLabel(column), column => FormatValue(column.GetValue(item))));
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClaveNombre ?? "el registro";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (disposed)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            var path = "/" + NavigationManager.ToBaseRelativePath(e.Location).Split('?', '#')[0].Trim('/');
            if (await PrepareRouteChangeAsync(path, verifyAccess: true))
            {
                StateHasChanged();
            }
        });
    }

    private async Task<bool> PrepareRouteChangeAsync(string path, bool verifyAccess)
    {
        if (string.Equals(loadedPath, path, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var isRouteChange = !string.IsNullOrWhiteSpace(loadedPath);
        loadedPath = path;

        if (isRouteChange)
        {
            SearchString = string.Empty;
            CurrentPage = 1;
            SortLabel = GetDefaultSortLabel();
            SortDirection = SortDirection.None;
            Elements.Clear();
            TotalCount = 0;
            pendingRouteReload = true;
        }

        IsInitialized = false;
        HasAccess = false;

        if (verifyAccess)
        {
            await VerifyAccess();
        }

        return true;
    }

    public void Dispose()
    {
        disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
