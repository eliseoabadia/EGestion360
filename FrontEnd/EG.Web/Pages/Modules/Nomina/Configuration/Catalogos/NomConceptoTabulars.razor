@page "/nomina/configuracion/catalogos/conceptos-tabulares"
@page "/nomina/configuracion/catalogos/tabulador"
@page "/nom/conceptotabular"
@using System.Globalization
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomConceptoTabularResponse, NomConceptoTabularResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Conceptos tabulares"
                    Subtitle="Catálogo NOM.ConceptoTabular"
                    Icon="@Icons.Material.Filled.TableRows"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="NomConceptoTabularResponse"
                      @ref="table"
                      Title="Lista de Conceptos tabulares"
                      SearchPlaceholder="Buscar..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                @foreach (var column in VisibleColumns)
                {
                    <MudTh><MudTableSortLabel SortLabel="@column.Name" T="NomConceptoTabularResponse">@NominaCatalogUi.GetLabel(column)</MudTableSortLabel></MudTh>
                }
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@IsBusy"
                                       OnClick="@(() => EditItem(GetItemId(item)))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="@IsBusy"
                                       OnClick="@(() => DeleteItem(GetItemId(item)))" />
                    </MudTooltip>
                </MudTd>
                @foreach (var column in VisibleColumns)
                {
                    <MudTd>@NominaCatalogUi.FormatValue(column.GetValue(item))</MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<NomConceptoTabularResponse> table = null!;

    protected override string ModuleName => EG.Web.Pages.Modules.Nomina.NominaClaimGroups.Catalogos;
    protected override string SubModuleName => "Tabulador";

    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomConceptoTabularResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomConceptoTabularResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomConceptoTabularResponse>);

    protected override string GetDefaultSortLabel() => "PkidConceptoTabulador";

    private static readonly string[] Columns =
    [
        nameof(NomConceptoTabularResponse.PkidConceptoTabulador),
        nameof(NomConceptoTabularResponse.EmpresaNominaNombre),
        nameof(NomConceptoTabularResponse.ConceptoClaveNombre),
        nameof(NomConceptoTabularResponse.PuestoNombre),
        nameof(NomConceptoTabularResponse.NivelClave),
        nameof(NomConceptoTabularResponse.ImporteMensual),
        nameof(NomConceptoTabularResponse.FechaInicio),
        nameof(NomConceptoTabularResponse.FechaFin)
    ];

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomConceptoTabularResponse), Columns);

    private static bool IsHiddenColumn(PropertyInfo property)
        => property.Name is "ClaveNombre" or "FechaCreacion" or "UsuarioCreacion" or "FechaModificacion" or "UsuarioModificacion";

    private static int GetItemId(NomConceptoTabularResponse item)
    {
        var property = typeof(NomConceptoTabularResponse).GetProperties().FirstOrDefault(p => p.Name.StartsWith("Pkid") && p.PropertyType == typeof(int));
        return property?.GetValue(item) as int? ?? 0;
    }

    private static string FormatValue(object? value)
    {
        return value switch
        {
            null => string.Empty,
            DateTime date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            DateOnly date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            decimal number => FormatDecimal(number),
            bool flag => flag ? "Si" : "No",
            _ => value.ToString() ?? string.Empty
        };
    }

    private static string FormatDecimal(decimal value)
        => value.ToString("0.00", CultureInfo.InvariantCulture);

    private static string GetLabel(PropertyInfo property)
    {
        return property.Name switch
        {
            "PkidConcepto" => "ID",
            "FkidEmpresaSis" => "Empresa",
            "FkidPersonaNom" => "Persona",
            "FkidConceptoNom" => "Concepto",
            "FkidPuestoNom" => "Puesto",
            "FkidPeriodo" => "Periodo",
            "FkidPeriodoInicial" => "Periodo inicial",
            "FkidPeriodoFinal" => "Periodo final",
            "FkidContratoTerceroNom" => "Contrato de tercero",
            "FkidConceptoProporcionalNom" => "Concepto proporcional",
            "FkidFormaCalculoNom" => "Forma de cálculo",
            "FkidUnidadInfonavitNom" => "Unidad Infonavit",
            "FkidNominaEspecialNom" => "Nómina especial",
            "FkidContratoPres" => "Contrato",
            "FechaIni" => "Fecha inicial",
            "FechaFin" => "Fecha final",
            "PerDed" => "Percepción/Deducción",
            "TasaInteres" => "Tasa de interés",
            "NumeroPagos" => "Número de pagos",
            "ImporteMensualFijo" => "Importe mensual fijo",
            "EstaCerrado" => "Cerrado",
            "EstaComprometido" => "Comprometido",
            "EstaDevengado" => "Devengado",
            "EstaEjercido" => "Ejercido",
            "EstaDescontado" => "Descontado",
            "ZonaEconomica" => "Zona económica",
            "QuincenaInicio" => "Quincena inicio",
            "QuincenaFin" => "Quincena fin",
            "TotalPeriodos" => "Total de periodos",
            _ => Humanize(property.Name)
        };
    }

    private static string Humanize(string value)
    {
        var text = value
            .Replace("Fkid", string.Empty, StringComparison.Ordinal)
            .Replace("Pkid", "ID", StringComparison.Ordinal)
            .Replace("Nom", string.Empty, StringComparison.Ordinal)
            .Replace("Sis", string.Empty, StringComparison.Ordinal)
            .Replace("Pres", string.Empty, StringComparison.Ordinal);

        return System.Text.RegularExpressions.Regex
            .Replace(text, "([a-z])([A-Z])", "$1 $2")
            .Trim();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomConceptoTabularResponse> items)
    {
        return items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClaveNombre ?? "el registro";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
