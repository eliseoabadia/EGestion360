@page "/rh/configuracion/nivel"
@page "/rh/nivel"
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomNivelResponse, NomNivelResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Niveles"
                    Subtitle="Catalogo NOM.Nivel"
                    Icon="@Icons.Material.Filled.Layers"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="NomNivelResponse"
                      @ref="table"
                      Title="Lista de niveles"
                      SearchPlaceholder="Buscar nivel o universo..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="NomNivelResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(context.Item.PkidNivel))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(context.Item.PkidNivel))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="NomNivelResponse" TProperty="int" Property="x => x.PkidNivel" Title="ID" Identifier="PkidNivel" />
                <PropertyColumn T="NomNivelResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="NomNivelResponse" TProperty="string" Property="x => x.UniversoDescripcion" Title="Universo" Identifier="UniversoDescripcion" />
                <PropertyColumn T="NomNivelResponse" TProperty="bool" Property="x => x.Activo" Title="Activo" Identifier="Activo" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<NomNivelResponse> table = null!;
    private static readonly string[] Columns =
    [
        nameof(NomNivelResponse.PkidNivel),
        nameof(NomNivelResponse.Clave),
        nameof(NomNivelResponse.UniversoDescripcion),
        nameof(NomNivelResponse.Activo)
    ];

    protected override string ModuleName => "Nivel";
    protected override string SubModuleName => "Nivel";
    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomNivelResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomNivelResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomNivelResponse>);
    protected override string GetDefaultSortLabel() => nameof(NomNivelResponse.Clave);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomNivelResponse), Columns);

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomNivelResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el nivel";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
