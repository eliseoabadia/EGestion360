@page "/nomina/configuracion/catalogos/niveles"
@page "/rh/configuracion/nivel"
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomNivelResponse, NomNivelResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Niveles"
                    Subtitle="Catalogo NOM.Nivel"
                    Icon="@Icons.Material.Filled.Layers"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="NomNivelResponse"
                      @ref="table"
                      Title="Lista de niveles"
                      SearchPlaceholder="Buscar nivel o universo..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                @foreach (var column in VisibleColumns)
                {
                    <MudTh><MudTableSortLabel SortLabel="@column.Name" T="NomNivelResponse">@NominaCatalogUi.GetLabel(column)</MudTableSortLabel></MudTh>
                }
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(NominaCatalogUi.GetItemId(item)))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(NominaCatalogUi.GetItemId(item)))" />
                    </MudTooltip>
                </MudTd>
                @foreach (var column in VisibleColumns)
                {
                    <MudTd>@NominaCatalogUi.FormatValue(column.GetValue(item))</MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<NomNivelResponse> table = null!;
    private static readonly string[] Columns =
    [
        nameof(NomNivelResponse.PkidNivel),
        nameof(NomNivelResponse.Clave),
        nameof(NomNivelResponse.UniversoDescripcion),
        nameof(NomNivelResponse.Activo)
    ];

    protected override string ModuleName => EG.Web.Pages.Modules.Nomina.NominaClaimGroups.Catalogos;
    protected override string SubModuleName => "Nivel";
    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomNivelResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomNivelResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomNivelResponse>);
    protected override string GetDefaultSortLabel() => nameof(NomNivelResponse.Clave);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomNivelResponse), Columns);

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomNivelResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el nivel";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
