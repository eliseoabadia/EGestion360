@page "/nomina/configuracion/catalogos/nombramientos"
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomNombramientoResponse, NomNombramientoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Nombramientos"
                    Subtitle="Catalogo NOM.Nombramiento"
                    Icon="@Icons.Material.Filled.AssignmentInd"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="NomNombramientoResponse"
                      @ref="table"
                      Title="Lista de nombramientos"
                      SearchPlaceholder="Buscar nombramiento..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch"
                      ReflectedColumns="@VisibleColumns"
                      ColumnTitleFunc="@(column => NominaCatalogUi.GetLabel(column))"
                      CellValueFunc="@((item, column) => NominaCatalogUi.FormatValue(column.GetValue(item)))">
            <RowActions Context="item">
                <MudTooltip Text="Editar">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(NominaCatalogUi.GetItemId(item)))" />
                </MudTooltip>
                <MudTooltip Text="Eliminar">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(NominaCatalogUi.GetItemId(item)))" />
                </MudTooltip>
            </RowActions>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<NomNombramientoResponse> table = null!;
    private static readonly string[] Columns =
    [
        nameof(NomNombramientoResponse.PkidNombramiento),
        nameof(NomNombramientoResponse.Descripcion),
        nameof(NomNombramientoResponse.Activo)
    ];

    protected override string ModuleName => EG.Web.Pages.Modules.Nomina.NominaClaimGroups.Catalogos;
    protected override string SubModuleName => "Nombramiento";
    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomNombramientoResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomNombramientoResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomNombramientoResponse>);
    protected override string GetDefaultSortLabel() => nameof(NomNombramientoResponse.Descripcion);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomNombramientoResponse), Columns);

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomNombramientoResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el nombramiento";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
