@page "/rh/configuracion/estado-civil"
@page "/sis/estadocivil"
@using System.Reflection
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Modules.Nomina.Configuration.Catalogos
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<NomEstadoCivilResponse, NomEstadoCivilResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Estado Civil"
                    Subtitle="Catalogo directo dbo.SIS_EstadoCivil"
                    Icon="@Icons.Material.Filled.FamilyRestroom"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="NomEstadoCivilResponse"
                      @ref="table"
                      Title="Lista de Estado Civil"
                      SearchPlaceholder="Buscar estado civil..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="NomEstadoCivilResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditItem(context.Item.PkidEstadoCivil))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteItem(context.Item.PkidEstadoCivil))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="NomEstadoCivilResponse" TProperty="int" Property="x => x.PkidEstadoCivil" Title="ID" Identifier="PkidEstadoCivil" />
                <PropertyColumn T="NomEstadoCivilResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                <PropertyColumn T="NomEstadoCivilResponse" TProperty="bool" Property="x => x.Activo" Title="Activo" Identifier="Activo" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<NomEstadoCivilResponse> table = null!;
    private static readonly string[] Columns =
    [
        nameof(NomEstadoCivilResponse.PkidEstadoCivil),
        nameof(NomEstadoCivilResponse.Descripcion),
        nameof(NomEstadoCivilResponse.Activo)
    ];

    protected override string ModuleName => "Estado_Civil";
    protected override string SubModuleName => "Estado_Civil";
    protected override Type CreateDialogType => typeof(NominaCatalogDialog<NomEstadoCivilResponse>);
    protected override Type EditDialogType => typeof(NominaCatalogDialog<NomEstadoCivilResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomEstadoCivilResponse>);
    protected override string GetDefaultSortLabel() => nameof(NomEstadoCivilResponse.Descripcion);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomEstadoCivilResponse), Columns);

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomEstadoCivilResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(column => NominaCatalogUi.GetLabel(column), column => NominaCatalogUi.FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "el estado civil";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
