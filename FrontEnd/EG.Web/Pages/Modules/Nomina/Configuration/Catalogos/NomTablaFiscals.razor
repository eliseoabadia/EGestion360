    private GenericTable<NomTablaFiscalResponse> table = null!;
    private string loadedPath = string.Empty;
    private bool pendingRouteReload;

    protected override string ModuleName => CurrentItem.ModuleName;
    protected override string SubModuleName => CurrentItem.SubModuleName;
    protected override Type CreateDialogType => typeof(NomTablaFiscalDialog);
    protected override Type EditDialogType => typeof(NomTablaFiscalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NomTablaFiscalResponse>);

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

    private FiscalPageItem CurrentItem =>
        ItemsByPath.TryGetValue(CurrentPath, out var item)
            ? item
            : Fiscal("Tabla Fiscal", "Tabla_Fiscal", "Tabla_Fiscal", IsrLabels);

    private IEnumerable<PropertyInfo> VisibleColumns => NominaCatalogUi.VisibleColumns(typeof(NomTablaFiscalResponse), CurrentItem.Columns);

    protected override string GetDefaultSortLabel() => nameof(NomTablaFiscalResponse.Clave);

    protected override async Task OnParametersSetAsync()
    {
        var path = CurrentPath;
        if (string.Equals(loadedPath, path, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var isRouteChange = !string.IsNullOrWhiteSpace(loadedPath);
        loadedPath = path;

        if (!isRouteChange)
        {
            return;
        }

        SearchString = string.Empty;
        CurrentPage = 1;
        SortLabel = GetDefaultSortLabel();
        SortDirection = SortDirection.None;
        Elements.Clear();
        TotalCount = 0;
        pendingRouteReload = true;

        IsInitialized = false;
        HasAccess = false;
        await VerifyAccess();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (pendingRouteReload && table != null && HasAccess)
        {
            pendingRouteReload = false;
            await table.ReloadData();
        }
    }

    protected override async Task<TableData<NomTablaFiscalResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                BuildCatalogFilters());

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add(response?.Message ?? "No fue posible obtener la tabla fiscal.", Severity.Error);
            }

            return new TableData<NomTablaFiscalResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task CreateItem()
    {
        await RunExclusiveAsync(async () =>
        {
            if (!CanCreate)
            {
                Snackbar.Add("No tienes permisos para crear", Severity.Warning);
                return;
            }

            var dialog = await DialogService.ShowAsync<NomTablaFiscalDialog>(
                $"Crear {CurrentItem.Title}",
                BuildDialogParameters(),
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadData();
            }
        }, "Operacion en proceso...");
    }

    protected override async Task EditItem(int id)
    {
        await RunExclusiveAsync(async () =>
        {
            if (!CanUpdate)
            {
                Snackbar.Add("No tienes permisos para editar", Severity.Warning);
                return;
            }

            var parameters = BuildDialogParameters();
            parameters["Id"] = id;

            var dialog = await DialogService.ShowAsync<NomTablaFiscalDialog>(
                $"Editar {CurrentItem.Title}",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadData();
            }
        }, "Operacion en proceso...");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NomTablaFiscalResponse> items)
        => items.Select(item => VisibleColumns.ToDictionary(GetColumnLabel, column => FormatValue(column.GetValue(item))));

    protected override async Task<string> GetItemNameForDelete(int id)
        => (await Service.GetByIdAsync(id))?.Data?.ClaveNombre ?? "la tabla fiscal";

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private DialogParameters BuildDialogParameters() => new()
    {
        ["Catalogo"] = CurrentItem.Catalogo,
        ["Title"] = CurrentItem.Title,
        ["Fields"] = CurrentItem.Fields,
        ["ParentCatalogo"] = CurrentItem.ParentCatalogo,
        ["ParentLabel"] = CurrentItem.ParentLabel,
        ["LabelOverrides"] = CurrentItem.LabelOverrides
    };

    private Dictionary<string, object> BuildCatalogFilters()
        => new() { [nameof(NomTablaFiscalResponse.Catalogo)] = CurrentItem.Catalogo };

    private string GetColumnLabel(PropertyInfo column)
        => CurrentItem.LabelOverrides.TryGetValue(column.Name, out var label)
            ? label
            : NominaCatalogUi.GetLabel(column);

    private static string FormatValue(object? value)
        => value switch
        {
            null => string.Empty,
            DateTime date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            decimal number => number.ToString("0.####", CultureInfo.InvariantCulture),
            bool flag => flag ? "Si" : "No",
            _ => value.ToString() ?? string.Empty
        };

    private static FiscalPageItem Fiscal(
        string title,
        string subModuleName,
        string catalogo,
        IReadOnlyDictionary<string, string> labelOverrides,
        string[]? fields = null,
        string[]? columns = null,
        string parentCatalogo = "",
        string parentLabel = "Catalogo padre")
        => new(
            title,
            "Tabla fiscal migrada desde BD_GRP_INVEA",
            Icons.Material.Filled.Percent,
            title.StartsWith("ISR", StringComparison.OrdinalIgnoreCase) ? "Tablas_ISR" :
                title.StartsWith("Subsidio", StringComparison.OrdinalIgnoreCase) ? "Subsidios_ISR" :
                title.Contains("IMSS", StringComparison.OrdinalIgnoreCase) ? "IMSS" : "Impuestos",
            subModuleName,
            catalogo,
            parentCatalogo,
            parentLabel,
            fields ?? FiscalFields,
            columns ?? FiscalColumns,
            labelOverrides);

    private sealed record FiscalPageItem(
        string Title,
        string Subtitle,
        string Icon,
        string ModuleName,
        string SubModuleName,
        string Catalogo,
        string ParentCatalogo,
        string ParentLabel,
        string[] Fields,
        string[] Columns,
        IReadOnlyDictionary<string, string> LabelOverrides);
}
