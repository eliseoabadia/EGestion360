<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column nomina-operaciones-page" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="@CurrentItem.Title"
                    Subtitle="@CurrentItem.Subtitle"
                    Icon="@CurrentItem.Icon"
                    CanCreate="false"
                    OnRefresh="() => table.ReloadData()" />

        @if (!string.IsNullOrWhiteSpace(CurrentItem.Note))
        {
            <MudAlert Severity="@CurrentItem.Severity" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                @CurrentItem.Note
            </MudAlert>
        }

        @if (CurrentItem.IsVacation)
        {
            <div class="vacation-flow-strip">
                <div>
                    <span>Solicitudes visibles</span>
                    <strong>@VisibleVacationCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                </div>
                <div>
                    <span>En autorizacion</span>
                    <strong>@PendingVacationCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                </div>
                <div>
                    <span>Autorizadas</span>
                    <strong>@AuthorizedVacationCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                </div>
            </div>
        }

        <GenericTable TItem="NominaOperacionResponse"
                      @ref="table"
                      @key="TableKey"
                      Title="@($"Lista de {CurrentItem.Title}")"
                      SearchPlaceholder="@($"Buscar {CurrentItem.Title.ToLowerInvariant()}...")"
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                @if (CurrentItem.IsVacation)
                {
                    <MudTh>Flujo</MudTh>
                }
                @foreach (var column in CurrentItem.Columns)
                {
                    <MudTh>
                        <MudTableSortLabel SortLabel="@column.Property" T="NominaOperacionResponse">
                            @column.Label
                        </MudTableSortLabel>
                    </MudTh>
                }
            </Header>
            <Row Context="item">
                @if (CurrentItem.IsVacation)
                {
                    <MudTd Class="vacation-actions">
                        <DocumentSupportButton Modulo="Vacaciones"
                                               SubModulo="@CurrentItem.SubModuleName"
                                               Controlador="NomOperacion"
                                               Servicio="Vacaciones"
                                               EntidadId="@item.Id"
                                               FkidEmpresaSis="@TryParseInt(item.Empresa)"
                                               RegistroTitulo="@BuildVacationTitle(item)"
                                               RegistroDescripcion="@BuildVacationDescription(item)"
                                               CanManage="@CanUpdate"
                                               Disabled="@IsBusy" />

                        @if (IsVacationRequestRoute)
                        {
                            <MudTooltip Text="Enviar a autorizar">
                                <MudIconButton Icon="@Icons.Material.Filled.Send"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="@(!CanSendVacation(item) || IsBusy)"
                                               OnClick="@(() => SendVacationToAuthorize(item))" />
                            </MudTooltip>
                        }

                        @if (IsVacationAuthorizationRoute)
                        {
                            <MudTooltip Text="Autorizar">
                                <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Disabled="@(!CanAuthorizeVacation(item) || IsBusy)"
                                               OnClick="@(() => AuthorizeVacation(item))" />
                            </MudTooltip>
                        }
                    </MudTd>
                }
                @foreach (var column in CurrentItem.Columns)
                {
                    <MudTd>
                        @if (CurrentItem.IsVacation && column.Property == nameof(NominaOperacionResponse.Estatus))
                        {
                            <span class="@GetVacationStatusClass(item.Estatus)">@FormatValue(GetValue(item, column.Property), column.Kind)</span>
                        }
                        else
                        {
                            @FormatValue(GetValue(item, column.Property), column.Kind)
                        }
                    </MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<NominaOperacionResponse> table = null!;
    private string loadedPath = string.Empty;
    private bool pendingRouteReload;
    private bool disposed;

    protected override string ModuleName => CurrentItem.ModuleName;
    protected override string SubModuleName => CurrentItem.SubModuleName;
    protected override Type CreateDialogType => typeof(DeleteDialog<NominaOperacionResponse>);
    protected override Type EditDialogType => typeof(DeleteDialog<NominaOperacionResponse>);
    protected override Type DeleteDialogType => typeof(DeleteDialog<NominaOperacionResponse>);
    protected override int ExportPageSize => 2500;

    private string CurrentPath => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');
    private string TableKey => $"nomina-operacion-table:{CurrentPath}";
    private bool IsVacationRequestRoute => CurrentItem.IsVacation && !IsVacationAuthorizationRoute;
    private bool IsVacationAuthorizationRoute => CurrentItem.IsVacation &&
        string.Equals(CurrentItem.SubModuleName, "Autorizacion_Vacaciones", StringComparison.OrdinalIgnoreCase);
    private int VisibleVacationCount => Elements.Count;
    private int PendingVacationCount => Elements.Count(item => IsVacationPendingAuthorization(item));
    private int AuthorizedVacationCount => Elements.Count(item => IsVacationAuthorized(item));

    private OperacionPageItem CurrentItem
    {
        get
        {
            if (ItemsByPath.TryGetValue(CurrentPath, out var item))
            {
                return item;
            }

            return Productos(
                "Nomina",
                "Operacion de nomina",
                "Nomina",
                "Operacion",
                "Ruta operativa conectada al visor de operaciones NOM.");
        }
    }

    protected override void OnInitialized()
    {
        loadedPath = CurrentPath;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (await PrepareRouteChangeAsync(CurrentPath, verifyAccess: true))
        {
            return;
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (disposed)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            var path = "/" + NavigationManager.ToBaseRelativePath(e.Location).Split('?', '#')[0].Trim('/');
            if (await PrepareRouteChangeAsync(path, verifyAccess: true))
            {
                StateHasChanged();
            }
        });
    }

    private async Task<bool> PrepareRouteChangeAsync(string path, bool verifyAccess)
    {
        if (string.Equals(loadedPath, path, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        loadedPath = path;
        SearchString = string.Empty;
        CurrentPage = 1;
        SortLabel = GetDefaultSortLabel();
        SortDirection = SortDirection.None;
        Elements.Clear();
        TotalCount = 0;
        pendingRouteReload = true;

        IsInitialized = false;
        HasAccess = false;

        if (verifyAccess)
        {
            await VerifyAccess();
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (pendingRouteReload && table != null && HasAccess)
        {
            pendingRouteReload = false;
            await table.ReloadData();
        }
    }

