    protected override async Task<TableData<NominaOperacionResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                BuildFilters());

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add(response?.Message ?? "No fue posible obtener la operacion de nomina.", Severity.Error);
            }

            return new TableData<NominaOperacionResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task<List<NominaOperacionResponse>> LoadExportItemsAsync()
    {
        var items = new List<NominaOperacionResponse>();
        var page = 1;
        var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;

        while (items.Count < MaxExportRows)
        {
            var response = await Service.GetAllPaginadoAsync(page, ExportPageSize, SearchString, sortLabel, SortDirection, BuildFilters());
            if (response?.Success != true)
            {
                throw new InvalidOperationException(response?.Message ?? "No fue posible obtener los datos para exportar.");
            }

            var pageItems = response.Items?.ToList() ?? new List<NominaOperacionResponse>();
            if (pageItems.Count == 0)
            {
                break;
            }

            items.AddRange(pageItems);

            if (items.Count >= response.TotalCount || pageItems.Count < ExportPageSize)
            {
                break;
            }

            page++;
        }

        return items;
    }

    protected override string GetDefaultSortLabel() => CurrentItem.DefaultSortLabel;

    protected override IEnumerable<object> MapToExcelData(IEnumerable<NominaOperacionResponse> items)
        => items.Select(item => CurrentItem.Columns.ToDictionary(column => column.Label, column => FormatValue(GetValue(item, column.Property), column.Kind)));

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    public void Dispose()
    {
        disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task SendVacationToAuthorize(NominaOperacionResponse item)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para enviar solicitudes.", Severity.Warning);
            return;
        }

        await RunExclusiveAsync(async () =>
        {
            var response = await Service.PostActionAsync($"{item.Id}/vacaciones/enviar-autorizar");
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Solicitud enviada a autorizacion.", Severity.Success);
                await ReloadData();
                return;
            }

            Snackbar.Add(response?.Message ?? "No fue posible enviar la solicitud.", Severity.Error);
        }, "Ya hay una operacion de vacaciones en proceso...");
    }

    private async Task AuthorizeVacation(NominaOperacionResponse item)
    {
        if (!CanUpdate && !CanAuthorize)
        {
            Snackbar.Add("No tienes permisos para autorizar solicitudes.", Severity.Warning);
            return;
        }

        await RunExclusiveAsync(async () =>
        {
            var response = await Service.PostActionAsync($"{item.Id}/vacaciones/autorizar");
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Solicitud autorizada correctamente.", Severity.Success);
                await ReloadData();
                return;
            }

            Snackbar.Add(response?.Message ?? "No fue posible autorizar la solicitud.", Severity.Error);
        }, "Ya hay una autorizacion en proceso...");
    }

    private bool CanSendVacation(NominaOperacionResponse item)
        => CanUpdate && item.Id > 0 && !IsVacationAuthorized(item) && !IsVacationPendingAuthorization(item);

    private bool CanAuthorizeVacation(NominaOperacionResponse item)
        => (CanUpdate || CanAuthorize) && item.Id > 0 && !IsVacationAuthorized(item);

    private static bool IsVacationAuthorized(NominaOperacionResponse item)
        => ContainsStatus(item.Estatus, "Autorizada");

    private static bool IsVacationPendingAuthorization(NominaOperacionResponse item)
        => ContainsStatus(item.Estatus, "autorizar") || ContainsStatus(item.Estatus, "Pendiente");

    private static bool ContainsStatus(string value, string expected)
        => (value ?? string.Empty).Contains(expected, StringComparison.OrdinalIgnoreCase);

    private static string GetVacationStatusClass(string status)
    {
        if (ContainsStatus(status, "Autorizada"))
        {
            return "vacation-status vacation-status-authorized";
        }

        if (ContainsStatus(status, "autorizar") || ContainsStatus(status, "Pendiente"))
        {
            return "vacation-status vacation-status-pending";
        }

        return "vacation-status vacation-status-draft";
    }

    private static string BuildVacationTitle(NominaOperacionResponse item)
        => string.IsNullOrWhiteSpace(item.Persona)
            ? $"Vacacion #{item.Id}"
            : $"{item.Empleado} - {item.Persona}".Trim(' ', '-');

    private static string BuildVacationDescription(NominaOperacionResponse item)
        => $"{FormatDate(item.FechaInicio)} al {FormatDate(item.FechaFin)} | {FormatValue(item.Importe, ColumnKind.Number)} dias | {item.Estatus}";

    private static int? TryParseInt(string value)
        => int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var result) ? result : null;

    private Dictionary<string, object> BuildFilters()
        => new() { ["Operacion"] = CurrentItem.Operation };

    private static object? GetValue(NominaOperacionResponse item, string property)
        => property switch
        {
            nameof(NominaOperacionResponse.Operacion) => item.Operacion,
            nameof(NominaOperacionResponse.Id) => item.Id,
            nameof(NominaOperacionResponse.Clave) => item.Clave,
            nameof(NominaOperacionResponse.Persona) => item.Persona,
            nameof(NominaOperacionResponse.Empleado) => item.Empleado,
            nameof(NominaOperacionResponse.Empresa) => item.Empresa,
            nameof(NominaOperacionResponse.Periodo) => item.Periodo,
            nameof(NominaOperacionResponse.Tipo) => item.Tipo,
            nameof(NominaOperacionResponse.Estatus) => item.Estatus,
            nameof(NominaOperacionResponse.Fecha) => item.Fecha,
            nameof(NominaOperacionResponse.FechaInicio) => item.FechaInicio,
            nameof(NominaOperacionResponse.FechaFin) => item.FechaFin,
            nameof(NominaOperacionResponse.Importe) => item.Importe,
            nameof(NominaOperacionResponse.Percepcion) => item.Percepcion,
            nameof(NominaOperacionResponse.Deduccion) => item.Deduccion,
            nameof(NominaOperacionResponse.Neto) => item.Neto,
            nameof(NominaOperacionResponse.Documento) => item.Documento,
            nameof(NominaOperacionResponse.Descripcion) => item.Descripcion,
            nameof(NominaOperacionResponse.Comentario) => item.Comentario,
            nameof(NominaOperacionResponse.Observaciones) => item.Observaciones,
            nameof(NominaOperacionResponse.Activo) => item.Activo,
            _ => string.Empty
        };

    private static string FormatValue(object? value, ColumnKind kind)
    {
        if (value == null)
        {
            return string.Empty;
        }

        return kind switch
        {
            ColumnKind.Date when value is DateTime date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            ColumnKind.Money when value is decimal money => money.ToString("N2", CultureInfo.InvariantCulture),
            ColumnKind.Number when value is decimal number => number.ToString("N2", CultureInfo.InvariantCulture),
            ColumnKind.Number when value is int number => number.ToString("N0", CultureInfo.InvariantCulture),
            _ when value is bool flag => flag ? "Si" : "No",
            _ => value.ToString() ?? string.Empty
        };
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) : "-";

