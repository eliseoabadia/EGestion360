@page "/rh/incidencia"
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<VwRhIncidenciaResponse, VwRhIncidenciaResponse>
@inject SucursalStateService SucursalStateService

<AccessVerification IsInitialized="@IsInitialized"
					HasAccess="@HasAccess"
					NavigateToHome="NavigateToHome">
	<MudContainer Class="px-3 d-flex flex-column incidencias-page eg-operation-page" MaxWidth="MaxWidth.False">
		<PageHeader Title="Captura de Incidencias"
					Subtitle="Gestión de incidencias de nómina por empleado"
					Icon="@Icons.Material.Filled.Assignment"
					CanCreate="@CanCreate"
					OnCreate="CreateItem"
					OnRefresh="() => table.ReloadData()" />

		<div class="eg-summary-strip">
			<div>
				<span class="eg-summary-label">Total de incidencias</span>
				<strong>@TotalCount.ToString("N0")</strong>
			</div>
			<div>
				<span class="eg-summary-label">Activas</span>
				<strong>@Elements.Count(x => x.Activo == true).ToString("N0")</strong>
			</div>
			<div>
				<span class="eg-summary-label">Inactivas</span>
				<strong>@Elements.Count(x => x.Activo != true).ToString("N0")</strong>
			</div>
		</div>

		<div class="eg-table-shell">
			<GenericDataGrid TItem="VwRhIncidenciaResponse"
						  @ref="table"
						  Title="Incidencias de nómina"
						  SearchPlaceholder="Buscar empleado, tipo de incidencia, periodo..."
						  ShowExportButton="@CanExport"
						  ServerDataFunc="LoadServerData"
						  ExportFunc="ExportToExcel"
						  SearchString="@SearchString"
						  SearchStringChanged="(s) => SearchString = s"
						  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="@(cell.Item.Activo == true ? "Ver incidencia" : "Editar")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="@(cell.Item.Activo == true ? Color.Info : Color.Primary)"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidIncidencia))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Incidencias"
                        SubModulo="Captura_Incidencias"
                        Controlador="Incidencia"
                        EntidadId="@cell.Item.PkidIncidencia"
                        RegistroTitulo="@TextOrDash(cell.Item.NombreCompleto)"
                        RegistroDescripcion="@TextOrDash(cell.Item.TipoIncidenciaDescripcion)" />
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@(CanDelete && cell.Item.Activo != true)"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidIncidencia))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Empleado" Identifier="NombreCompleto" PropertyName="NombreCompleto" SortBy="x => x.NombreCompleto">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        <div class="eg-main-cell">@TextOrDash(cell.Item.NombreCompleto)</div>
                        <span>@TextOrDash(cell.Item.ClavePersona)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Tipo" Identifier="TipoIncidenciaDescripcion" PropertyName="TipoIncidenciaDescripcion" SortBy="x => x.TipoIncidenciaDescripcion">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        @TextOrDash(cell.Item.TipoIncidenciaDescripcion)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Fecha" Identifier="Fecha" PropertyName="Fecha" SortBy="x => x.Fecha">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        @(cell.Item.Fecha?.ToString("dd/MM/yyyy") ?? "-")
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Periodo" Identifier="FechaFin" PropertyName="FechaFin" SortBy="x => x.FechaFin">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        @if (cell.Item.FechaInicio.HasValue && cell.Item.FechaFin.HasValue)
                        {
                        <span>@cell.Item.FechaInicio.Value.ToString("dd/MM/yyyy") - @cell.Item.FechaFin.Value.ToString("dd/MM/yyyy")</span>
                        }
                        else
                        {
                        <span>-</span>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Comentario" Identifier="Comentario" PropertyName="Comentario" SortBy="x => x.Comentario">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        @TextOrDash(cell.Item.Comentario)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Aplica Descuento" Identifier="AplicaDescuento" PropertyName="AplicaDescuento" SortBy="x => x.AplicaDescuento">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        <!-- FIX: Se agregó T="string" -->
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(cell.Item.AplicaDescuento == true ? Color.Warning : Color.Default)"
                        Icon="@(cell.Item.AplicaDescuento == true ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                        @(cell.Item.AplicaDescuento == true ? "Aplica" : "No aplica")
                        </MudChip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Estado" Identifier="Activo" PropertyName="Activo" SortBy="x => x.Activo">
                    <CellTemplate Context="cell">
                        <div @ondblclick="@(() => EditItem(cell.Item.PkidIncidencia))">
                        <!-- FIX: Se agregó T="string" -->
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(cell.Item.Activo == true ? Color.Success : Color.Error)"
                        Variant="Variant.Text">
                        @(cell.Item.Activo == true ? "Activa" : "Inactiva")
                        </MudChip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
		</div>
	</MudContainer>
</AccessVerification>

@code {
	private GenericDataGrid<VwRhIncidenciaResponse> table = null!;

	protected override string ModuleName => "Incidencias";
	protected override string SubModuleName => "Captura_Incidencias";

	protected override Type CreateDialogType => typeof(IncidenciasDialog);
	protected override Type EditDialogType => typeof(IncidenciasDialog);
	protected override Type DeleteDialogType => typeof(DeleteDialog<VwRhIncidenciaResponse>);
	protected override string GetDefaultSortLabel() => "PkidIncidencia";
	protected override IEnumerable<object> MapToExcelData(IEnumerable<VwRhIncidenciaResponse> items) => items;
	protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;

	protected override async Task CreateItem()
	{
		try
		{
			var parameters = new DialogParameters<IncidenciasDialog>
			{
				{ x => x.EmpresaId, SucursalStateService.EmpresaId },
			};

			var dialog = await DialogService.ShowAsync<IncidenciasDialog>(
				"Nueva incidencia",
				parameters,
				new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

			var result = await dialog.Result;
			if (!result.Canceled)
			{
				await table.ReloadData();
			}
		}
		catch
		{
			Snackbar.Add("Error al crear la incidencia", Severity.Error);
		}
	}

	protected override async Task EditItem(int itemId)
	{
		try
		{
			var response = await Service.GetByIdAsync(itemId);
			if (response?.Success != true || response.Data == null)
			{
				Snackbar.Add("No fue posible cargar la incidencia", Severity.Error);
				return;
			}

			var item = response.Data;
			var isReadOnly = item.Activo == true; // Si está activa, es de solo lectura

			var parameters = new DialogParameters<IncidenciasDialog>
			{
				{ x => x.Id, itemId },
				{ x => x.PersonaId, item.FkidPersonaNom },
				{ x => x.PersonaNombre, item.NombreCompleto },
				{ x => x.EmpresaId, SucursalStateService.EmpresaId },
				{ x => x.IsReadOnly, isReadOnly }
			};

			var dialog = await DialogService.ShowAsync<IncidenciasDialog>(
				isReadOnly ? "Ver incidencia" : "Editar incidencia",
				parameters,
				new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

			var result = await dialog.Result;
			if (!result.Canceled)
			{
				await table.ReloadData();
			}
		}
		catch
		{
			Snackbar.Add("Error al editar la incidencia", Severity.Error);
		}
	}

	protected override async Task DeleteItem(int itemId)
	{
		try
		{
			var parameters = new DialogParameters<DeleteDialog<VwRhIncidenciaResponse>>
			{
				{ x => x.Id, itemId },
				{ x => x.ItemName, "la incidencia" },
				{ x => x.DeleteFunc, async deleteId =>
					{
						var response = await Service.DeleteAsync(deleteId);
						if (response?.Success == true)
						{
							Snackbar.Add(response.Message ?? "Incidencia eliminada correctamente", Severity.Success);
							return true;
						}

						Snackbar.Add(response?.Message ?? "Error al eliminar la incidencia", Severity.Error);
						return false;
					}
				}
			};

			var dialog = await DialogService.ShowAsync<DeleteDialog<VwRhIncidenciaResponse>>(
				"Eliminar incidencia",
				parameters,
				new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

			var result = await dialog.Result;
			if (!result.Canceled)
			{
				await table.ReloadData();
			}
		}
		catch
		{
			Snackbar.Add("Error al eliminar la incidencia", Severity.Error);
		}
	}

	protected override async Task ExportToExcel()
	{
		try
		{
			var allData = await Service.GetAllPaginadoAsync(
				1,
				int.MaxValue,
				string.Empty,
				nameof(VwRhIncidenciaResponse.PkidIncidencia),
				SortDirection.Descending);

			var data = allData?.Items?.Select(x => (object)new
			{
				Empleado = x.NombreCompleto,
				Clave = x.ClavePersona,
				TipoIncidencia = x.TipoIncidenciaDescripcion,
				Fecha = x.Fecha?.ToString("dd/MM/yyyy"),
				PeriodoInicio = x.FechaInicio?.ToString("dd/MM/yyyy"),
				PeriodoFin = x.FechaFin?.ToString("dd/MM/yyyy"),
				Comentario = x.Comentario,
				AplicaDescuento = x.AplicaDescuento == true ? "Sí" : "No",
				Estado = x.Activo == true ? "Activa" : "Inactiva"
			}).ToList() ?? new List<object>();

			using var stream = new MemoryStream();
			await stream.SaveAsAsync(data);
			var base64 = Convert.ToBase64String(stream.ToArray());

			await JsRuntime.InvokeVoidAsync("downloadFile", base64,
				$"{SubModuleName}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
				"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
		}
		catch
		{
			Snackbar.Add("Error al exportar los datos", Severity.Error);
		}
	}

	private static string TextOrDash(string? value)
		=> string.IsNullOrWhiteSpace(value) ? "-" : value;

	public void Dispose()
	{
		SearchCts?.Cancel();
		SearchCts?.Dispose();
	}
}
