@namespace EG.Web.Pages.Modules.Nomina.Nomina.Incidencias
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Shared
@using MudBlazor

<BaseCrudDialog TItem="VwRhIncidenciaResponse" Title="Detalle de incidencia"
                Subtitle="Empleado, periodo, justificación y datos de registro."
                TitleIcon="@Icons.Material.Filled.EventNote" MaxWidth="MaxWidth.Large"
                ShowConfirmButton="false" CancelText="Cerrar">
    @if (Item is not null)
    {
        <div class="crud-form-layout">
            <CrudFormSection Title="Empleado" Icon="@Icons.Material.Filled.Person">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@Item.NombreCompleto" Label="Nombre completo" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@Item.ClavePersona" Label="Clave" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@Item.Rfc" Label="RFC" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@Item.Curp" Label="CURP" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
            </CrudFormSection>
            <CrudFormSection Title="Incidencia" Icon="@Icons.Material.Filled.Event">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@Item.TipoIncidenciaDescripcion" Label="Tipo de incidencia" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@FormatDate(Item.Fecha)" Label="Fecha" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12"><MudTextField Margin="Margin.Dense" Value="@Item.Comentario" Label="Comentario" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
            </CrudFormSection>
            <CrudFormSection Title="Periodo" Icon="@Icons.Material.Filled.DateRange">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@FormatDate(Item.FechaInicio)" Label="Fecha de inicio" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@FormatDate(Item.FechaFin)" Label="Fecha final" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
            </CrudFormSection>
            <CrudFormSection Title="Justificación" Icon="@Icons.Material.Filled.FactCheck">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@(Item.TipoJustificacionDescripcion ?? "Pendiente")" Label="Tipo de justificación" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" Value="@(Item.AplicaDescuento == true ? "Sí" : "No")" Label="Aplica descuento" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12"><MudTextField Margin="Margin.Dense" Value="@Item.ComentarioJustificacion" Label="Comentario de justificación" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
            </CrudFormSection>
            <CrudFormSection Title="Estado y auditoría" Icon="@Icons.Material.Filled.History">
                <MudChip T="string" Color="@(Item.Activo == true ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                    @(Item.Activo == true ? "Autorizada" : "Pendiente")
                </MudChip>
                <NominaRhAuditInfo UsuarioCreacion="@Item.UsuarioCreacion" FechaCreacion="@Item.FechaCreacion"
                                  UsuarioModificacion="@Item.UsuarioModificacion" FechaModificacion="@Item.FechaModificacion" />
            </CrudFormSection>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info">No hay una incidencia seleccionada para consultar.</MudAlert>
    }
</BaseCrudDialog>
