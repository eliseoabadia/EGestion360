@namespace EG.Web.Pages.Modules.Nomina.Nomina.Incidencias
@using System.Globalization
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Pages.Shared
@using MudBlazor

<MudDialog>
	<DialogContent>
		@if (Item != null)
		{
			<MudGrid GutterSize="2">
				<!-- Empleado -->
				<MudItem xs="12">
					<MudText Typo="Typo.subtitle2" Color="Color.Primary">Empleado</MudText>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@Item.NombreCompleto" Label="Nombre Completo" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@Item.ClavePersona" Label="Clave" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@Item.Rfc" Label="RFC" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@Item.Curp" Label="CURP" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>

				<!-- Incidencia -->
				<MudItem xs="12">
					<MudDivider Class="my-3" />
					<MudText Typo="Typo.subtitle2" Color="Color.Primary">Incidencia</MudText>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@Item.TipoIncidenciaDescripcion" Label="Tipo de Incidencia" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@(Item.Fecha?.ToString("dd/MM/yyyy") ?? "-")" Label="Fecha" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12">
					<MudTextField Value="@Item.Comentario" Label="Comentario" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>

				<!-- Periodo -->
				<MudItem xs="12">
					<MudDivider Class="my-3" />
					<MudText Typo="Typo.subtitle2" Color="Color.Primary">Periodo</MudText>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@(Item.FechaInicio?.ToString("dd/MM/yyyy") ?? "-")" Label="Fecha Inicio" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@(Item.FechaFin?.ToString("dd/MM/yyyy") ?? "-")" Label="Fecha Fin" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>

				<!-- Justificación -->
				<MudItem xs="12">
					<MudDivider Class="my-3" />
					<MudText Typo="Typo.subtitle2" Color="Color.Primary">Justificación</MudText>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@(Item.TipoJustificacionDescripcion ?? "Pendiente")" Label="Tipo de Justificación" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Value="@(Item.AplicaDescuento == true ? "Sí" : "No")" Label="Aplica Descuento" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>
				<MudItem xs="12">
					<MudTextField Value="@Item.ComentarioJustificacion" Label="Comentario de Justificación" ReadOnly="true" Variant="Variant.Outlined" />
				</MudItem>

				<!-- Estado -->
				<MudItem xs="12">
					<MudDivider Class="my-3" />
					<MudText Typo="Typo.subtitle2" Color="Color.Primary">Estado</MudText>
				</MudItem>
				<MudItem xs="12" md="6">
					<!-- FIX: Added T="string" -->
					<MudChip T="string"
							 Color="@(Item.Activo == true ? Color.Success : Color.Warning)" 
							 Icon="@(Item.Activo == true ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
							 Variant="Variant.Text">
						@(Item.Activo == true ? "Autorizada" : "Pendiente")
					</MudChip>
				</MudItem>

				<!-- Auditoria -->
				<MudItem xs="12">
					<MudDivider Class="my-3" />
					<NominaRhAuditInfo UsuarioCreacion="@Item.UsuarioCreacion"
									   FechaCreacion="@Item.FechaCreacion"
									   UsuarioModificacion="@Item.UsuarioModificacion"
									   FechaModificacion="@Item.FechaModificacion" />
				</MudItem>
			</MudGrid>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Cerrar</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter] public VwRhIncidenciaResponse? Item { get; set; }
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

	void Cancel() => MudDialog.Cancel();
}