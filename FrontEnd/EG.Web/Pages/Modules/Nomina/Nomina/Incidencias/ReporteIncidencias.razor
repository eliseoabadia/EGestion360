@page "/rh/incidenciareport"
@using EG.Domain.DTOs.Responses.Nomina
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<VwRhIncidenciaResponse, VwRhIncidenciaResponse>

<AccessVerification IsInitialized="@IsInitialized"
					HasAccess="@HasAccess"
					NavigateToHome="NavigateToHome">
	<MudContainer Class="px-3 d-flex flex-column reporte-page eg-operation-page" MaxWidth="MaxWidth.False">
		<PageHeader Title="Reporte de Incidencias"
					Subtitle="Consulta y análisis de incidencias procesadas"
					Icon="@Icons.Material.Filled.BarChart"
					CanCreate="false"
					OnRefresh="() => table.ReloadData()" />

		<div class="eg-summary-strip">
			<div>
				<span class="eg-summary-label">Total de incidencias</span>
				<strong>@TotalCount.ToString("N0")</strong>
			</div>
			<div>
				<span class="eg-summary-label">Con descuento</span>
				<strong>@Elements.Count(x => x.AplicaDescuento == true).ToString("N0")</strong>
			</div>
			<div>
				<span class="eg-summary-label">Autorizadas</span>
				<strong>@Elements.Count(x => x.Activo == true).ToString("N0")</strong>
			</div>
		</div>

		<div class="eg-table-shell">
			<GenericDataGrid TItem="VwRhIncidenciaResponse"
						  @ref="table"
						  Title="Reporte de incidencias"
						  SearchPlaceholder="Buscar empleado, tipo de incidencia, justificación..."
						  ShowExportButton="@CanExport"
						  ServerDataFunc="LoadServerData"
						  ExportFunc="ExportToExcel"
						  SearchString="@SearchString"
						  SearchStringChanged="(s) => SearchString = s"
						  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Ver detalles">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => ViewDetails(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Empleado" Identifier="NombreCompleto" PropertyName="NombreCompleto" SortBy="x => x.NombreCompleto">
                    <CellTemplate Context="cell">
                        <div class="eg-main-cell">@TextOrDash(cell.Item.NombreCompleto)</div>
                        <span>@TextOrDash(cell.Item.Rfc)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Clave" Identifier="ClavePersona" PropertyName="ClavePersona" SortBy="x => x.ClavePersona">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.ClavePersona)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Tipo Incidencia" Identifier="TipoIncidenciaDescripcion" PropertyName="TipoIncidenciaDescripcion" SortBy="x => x.TipoIncidenciaDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoIncidenciaDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Fecha Incidencia" Identifier="Fecha" PropertyName="Fecha" SortBy="x => x.Fecha">
                    <CellTemplate Context="cell">
                        @(cell.Item.Fecha?.ToString("dd/MM/yyyy") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Periodo Fin" Identifier="FechaFin" PropertyName="FechaFin" SortBy="x => x.FechaFin">
                    <CellTemplate Context="cell">
                        @(cell.Item.FechaFin?.ToString("dd/MM/yyyy") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Tipo Justificación" Identifier="TipoJustificacionDescripcion" PropertyName="TipoJustificacionDescripcion" SortBy="x => x.TipoJustificacionDescripcion">
                    <CellTemplate Context="cell">
                        @if (string.IsNullOrWhiteSpace(cell.Item.TipoJustificacionDescripcion))
                        {
                        <!-- FIX: Added T="string" -->
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pendiente</MudChip>
                        }
                        else
                        {
                        <span>@cell.Item.TipoJustificacionDescripcion</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Aplica Descuento" Identifier="__column_7" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <!-- FIX: Added T="string" -->
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(cell.Item.AplicaDescuento == true ? Color.Warning : Color.Default)">
                        @(cell.Item.AplicaDescuento == true ? "Aplica" : "No aplica")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="VwRhIncidenciaResponse" Title="Estado" Identifier="Activo" PropertyName="Activo" SortBy="x => x.Activo">
                    <CellTemplate Context="cell">
                        <!-- FIX: Added T="string" -->
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(cell.Item.Activo == true ? Color.Success : Color.Info)"
                        Variant="Variant.Text">
                        @(cell.Item.Activo == true ? "Autorizada" : "Pendiente")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
		</div>
	</MudContainer>
</AccessVerification>

@code {
	private GenericDataGrid<VwRhIncidenciaResponse> table = null!;

	protected override string ModuleName => "Incidencias";
	protected override string SubModuleName => "Reporte_Incidencias";

	protected override Type CreateDialogType => typeof(object);
	protected override Type EditDialogType => typeof(object);
	protected override Type DeleteDialogType => typeof(object);
	protected override string GetDefaultSortLabel() => "PkidIncidencia";
	protected override IEnumerable<object> MapToExcelData(IEnumerable<VwRhIncidenciaResponse> items) => items;
	protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;

	private async Task ViewDetails(VwRhIncidenciaResponse item)
	{
		try
		{
			var response = await Service.GetByIdAsync(item.PkidIncidencia);
			if (response?.Success != true || response.Data == null)
			{
				Snackbar.Add("No fue posible cargar los detalles", Severity.Error);
				return;
			}

			var fullItem = response.Data;

			var parameters = new DialogParameters<ReporteIncidenciasDetalleDialog>
			{
				{ x => x.Item, fullItem }
			};

			await DialogService.ShowAsync<ReporteIncidenciasDetalleDialog>(
				"Detalles de la incidencia",
				parameters,
				new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
		}
		catch
		{
			Snackbar.Add("Error al cargar los detalles", Severity.Error);
		}
	}

	protected override async Task ExportToExcel()
	{
		try
		{
			var allData = await Service.GetAllPaginadoAsync(
				1,
				int.MaxValue,
				string.Empty,
				nameof(VwRhIncidenciaResponse.PkidIncidencia),
				SortDirection.Descending);

			var data = allData?.Items?.Select(x => (object)new
			{
				Empleado = x.NombreCompleto,
				Clave = x.ClavePersona,
				RFC = x.Rfc,
				TipoIncidencia = x.TipoIncidenciaDescripcion,
				FechaIncidencia = x.Fecha?.ToString("dd/MM/yyyy"),
				Periodo = x.FechaFin?.ToString("dd/MM/yyyy"),
				Comentario = x.Comentario,
				TipoJustificacion = x.TipoJustificacionDescripcion ?? "Pendiente",
				AplicaDescuento = x.AplicaDescuento == true ? "Sí" : "No",
				ComentarioJustificacion = x.ComentarioJustificacion,
				Estado = x.Activo == true ? "Autorizada" : "Pendiente",
				FechaCreacion = x.FechaCreacion?.ToString("dd/MM/yyyy HH:mm"),
				FechaModificacion = x.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")
			}).ToList() ?? new List<object>();

			using var stream = new MemoryStream();
			await stream.SaveAsAsync(data);
			var base64 = Convert.ToBase64String(stream.ToArray());

			await JsRuntime.InvokeVoidAsync("downloadFile", base64,
				$"{SubModuleName}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
				"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
		}
		catch
		{
			Snackbar.Add("Error al exportar los datos", Severity.Error);
		}
	}

	private static string TextOrDash(string? value)
		=> string.IsNullOrWhiteSpace(value) ? "-" : value;

	public void Dispose()
	{
		SearchCts?.Cancel();
		SearchCts?.Dispose();
	}
}
