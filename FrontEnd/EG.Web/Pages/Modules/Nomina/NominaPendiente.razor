            nameof(NominaOperacionResponse.Fecha) => item.Fecha,
            nameof(NominaOperacionResponse.FechaInicio) => item.FechaInicio,
            nameof(NominaOperacionResponse.FechaFin) => item.FechaFin,
            nameof(NominaOperacionResponse.Importe) => item.Importe,
            nameof(NominaOperacionResponse.Percepcion) => item.Percepcion,
            nameof(NominaOperacionResponse.Deduccion) => item.Deduccion,
            nameof(NominaOperacionResponse.Neto) => item.Neto,
            nameof(NominaOperacionResponse.Documento) => item.Documento,
            nameof(NominaOperacionResponse.Descripcion) => item.Descripcion,
            nameof(NominaOperacionResponse.Comentario) => item.Comentario,
            nameof(NominaOperacionResponse.Observaciones) => item.Observaciones,
            nameof(NominaOperacionResponse.Activo) => item.Activo,
            _ => string.Empty
        };

    private static string FormatValue(object? value, ColumnKind kind)
    {
        if (value == null)
        {
            return string.Empty;
        }

        return kind switch
        {
            ColumnKind.Date when value is DateTime date => date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            ColumnKind.Money when value is decimal money => money.ToString("N2", CultureInfo.InvariantCulture),
            ColumnKind.Number when value is decimal number => number.ToString("N2", CultureInfo.InvariantCulture),
            ColumnKind.Number when value is int number => number.ToString("N0", CultureInfo.InvariantCulture),
            _ when value is bool flag => flag ? "Si" : "No",
            _ => value.ToString() ?? string.Empty
        };
    }

