@page "/PBR/MatrizIndicadores"
@page "/Presupuesto/Egreso/Planeacion/Catalogos_Planeacion/Indicadores"
@page "/Presupuesto/Egreso/Planeacion/Catalogos_Planeacion/Resumen_Narrativo"
@using EG.Domain.DTOs.Responses.PBR
@using EG.Web.Contracts
@using EG.Web.Pages.Modules.PBR.Shared
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using Microsoft.JSInterop
@using MudBlazor

@inject IGenericCrudService<PbrMirNivelResponse> Service
@inject IGenericCrudService<PbrIndicadorResponse> IndicadorService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudContainer MaxWidth="MaxWidth.False" Class="px-3 d-flex flex-column" Style="height: 100vh; overflow: hidden;">
    @if (selected == null)
    {
        <PageHeader Title="MIR PBR"
                    Subtitle="Niveles de matriz e indicadores"
                    Icon="@Icons.Material.Filled.AccountTree"
                    CanCreate="true"
                    OnCreate="() => OpenMirDialog(null)"
                    OnRefresh="() => table.ReloadData()" />

        <PbrTopNavigation />

        <div style="flex-grow: 1; overflow: hidden; min-height: 0;">
            <GenericDataGrid TItem="PbrMirNivelResponse"
                          @ref="table"
                          Title="Niveles MIR"
                          SearchPlaceholder="Buscar por nivel, objetivo o programa..."
                          ShowExportButton="false"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportAsync"
                          SearchString="@search"
                          SearchStringChanged="(s) => search = s"
                          OnSearch="() => table.ReloadData()">
            <Columns>
                <TemplateColumn T="PbrMirNivelResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <div Style="width: 140px; white-space: nowrap;">
                        <DocumentSupportButton Modulo="PBR"
                        SubModulo="MIR"
                        Controlador="PbrMirNivel"
                        EntidadId="@cell.Item.PkidMirNivel"
                        RegistroTitulo="@TextOrDash(cell.Item.Nivel)"
                        RegistroDescripcion="@TextOrDash(cell.Item.Objetivo)" />
                        <MudTooltip Text="Ver indicadores">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Color="Color.Info" Size="Size.Small" OnClick="@(() => SelectMir(cell.Item))" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenMirDialog(cell.Item.PkidMirNivel))" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrMirNivelResponse" Title="Programa" Identifier="ProgramaDescripcion" PropertyName="ProgramaDescripcion" SortBy="x => x.ProgramaDescripcion">
                    <CellTemplate Context="cell">
                        <div Style="min-width: 260px;">
                        @TextOrDash(cell.Item.ProgramaDescripcion)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrMirNivelResponse" Title="Nivel" Identifier="Nivel" PropertyName="Nivel" SortBy="x => x.Nivel">
                    <CellTemplate Context="cell">
                        <div Style="width: 140px;">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">@TextOrDash(cell.Item.Nivel)</MudChip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrMirNivelResponse" Title="Objetivo" Identifier="Objetivo" PropertyName="Objetivo" SortBy="x => x.Objetivo">
                    <CellTemplate Context="cell">
                        <div Style="min-width: 560px;">
                        @TextOrDash(cell.Item.Objetivo)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrMirNivelResponse" Title="Orden" Identifier="Orden" PropertyName="Orden" SortBy="x => x.Orden">
                    <CellTemplate Context="cell">
                        <div Style="width: 90px;">
                        @cell.Item.Orden
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    }
    else
    {
        <PbrTopNavigation OnBack="BackToTable" />

        <MudPaper Elevation="0" Class="pa-0 d-flex align-center mb-2" Style="background: transparent;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="BackToTable" />
            <div class="ml-2">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">@TextOrDash(selected.Nivel)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@TextOrDash(selected.Objetivo)</MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Color="Color.Success" Size="Size.Small" OnClick="() => OpenIndicadorDialog(null)" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small" OnClick="() => indicadorTable.ReloadData()" />
        </MudPaper>

        <div style="flex-grow: 1; overflow: hidden; min-height: 0;">
            <GenericDataGrid TItem="PbrIndicadorResponse"
                          @ref="indicadorTable"
                          Title="Indicadores"
                          SearchPlaceholder="Buscar por indicador, meta o frecuencia..."
                          ShowExportButton="false"
                          ServerDataFunc="LoadIndicadoresServerData"
                          SearchString="@indicadorSearch"
                          SearchStringChanged="(s) => indicadorSearch = s"
                          OnSearch="() => indicadorTable.ReloadData()">
            <Columns>
                <TemplateColumn T="PbrIndicadorResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenIndicadorDialog(cell.Item.PkidIndicador))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIndicadorAsync(cell.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Programa" Identifier="ProgramaDescripcion" PropertyName="ProgramaDescripcion" SortBy="x => x.ProgramaDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.ProgramaDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Indicador" Identifier="Nombre" PropertyName="Nombre" SortBy="x => x.Nombre">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Nombre)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Tipo" Identifier="Tipo" PropertyName="Tipo" SortBy="x => x.Tipo">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Tipo)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Dimension" Identifier="Dimension" PropertyName="Dimension" SortBy="x => x.Dimension">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Dimension)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Frecuencia" Identifier="Frecuencia" PropertyName="Frecuencia" SortBy="x => x.Frecuencia">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Frecuencia)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Meta" Identifier="Meta" PropertyName="Meta" SortBy="x => x.Meta">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Meta)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrIndicadorResponse" Title="Sentido" Identifier="Sentido" PropertyName="Sentido" SortBy="x => x.Sentido">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Sentido)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    }
</MudContainer>

@code {
    private GenericDataGrid<PbrMirNivelResponse> table = null!;
    private GenericDataGrid<PbrIndicadorResponse> indicadorTable = null!;
    private PbrMirNivelResponse? selected;
    private string search = string.Empty;
    private string indicadorSearch = string.Empty;

    private async Task<TableData<PbrMirNivelResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await Service.GetAllPaginadoAsync(Math.Max(1, state.Page + 1), state.PageSize, search, state.SortLabel ?? "ProgramaDescripcion", state.SortDirection);
        return new TableData<PbrMirNivelResponse> { Items = response?.Items ?? new List<PbrMirNivelResponse>(), TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task<TableData<PbrIndicadorResponse>> LoadIndicadoresServerData(TableState state, CancellationToken cancellationToken)
    {
        if (selected == null)
        {
            return new TableData<PbrIndicadorResponse> { Items = new List<PbrIndicadorResponse>(), TotalItems = 0 };
        }

        var response = await IndicadorService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            indicadorSearch,
            state.SortLabel ?? "ProgramaDescripcion",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidMirNivelPbr"] = selected.PkidMirNivel });

        return new TableData<PbrIndicadorResponse> { Items = response?.Items ?? new List<PbrIndicadorResponse>(), TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task OpenMirDialog(int? id)
    {
        var parameters = new DialogParameters { ["Id"] = id };
        var dialog = await DialogService.ShowAsync<PbrCrudDialog<PbrMirNivelResponse>>(id.HasValue ? "Editar nivel MIR" : "Nuevo nivel MIR", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await table.ReloadData();
        }
    }

    private async Task OpenIndicadorDialog(int? id)
    {
        if (selected == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["InitialValues"] = new Dictionary<string, object?> { ["FkidMirNivelPbr"] = selected.PkidMirNivel }
        };

        var dialog = await DialogService.ShowAsync<PbrCrudDialog<PbrIndicadorResponse>>(id.HasValue ? "Editar indicador" : "Nuevo indicador", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await indicadorTable.ReloadData();
        }
    }

    private void SelectMir(PbrMirNivelResponse item)
    {
        selected = item;
        indicadorSearch = string.Empty;
    }

    private async Task BackToTable()
    {
        selected = null;
        await table.ReloadData();
    }

    private async Task DeleteIndicadorAsync(PbrIndicadorResponse item)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Eliminar indicador {item.Nombre}?"))
        {
            return;
        }

        var response = await IndicadorService.DeleteAsync(item.PkidIndicador);
        if (response?.Success == true)
        {
            Snackbar.Add("Indicador eliminado correctamente.", Severity.Success);
            await indicadorTable.ReloadData();
            return;
        }

        Snackbar.Add(response?.Message ?? "No fue posible eliminar.", Severity.Error);
    }

    private Task ExportAsync() => Task.CompletedTask;
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
