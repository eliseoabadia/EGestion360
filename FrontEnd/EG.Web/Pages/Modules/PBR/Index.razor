@page "/PBR"
@using System.Globalization
@using EG.Domain.DTOs.Responses.PBR
@using EG.Web.Contracts
@using EG.Web.Pages.Modules.PBR.Shared
@using EG.Web.Services
@using MudBlazor
@implements IDisposable

@inject IPbrDashboardService DashboardService
@inject AnioPresupuestalStateService AnioState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="px-3 d-flex flex-column" Style="height: 100vh; overflow: hidden;">
    <PageHeader Title="PBR"
                Subtitle="@($"Tablero ejecutivo de planeación basada en resultados - {anio}")"
                Icon="@Icons.Material.Filled.InsertChart"
                ShowCreateButton="false"
                OnRefresh="LoadDashboardAsync" />

    <PbrTopNavigation />

    <div class="pbr-dashboard-scroll">
        @if (loading)
        {
            <MudPaper Elevation="0" Class="pa-8 text-center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-3" Color="Color.Secondary">Cargando tablero...</MudText>
            </MudPaper>
        }
        else if (dashboard is null)
        {
            <MudPaper Elevation="0" Class="pa-6">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No hay datos para mostrar en el ejercicio @anio.
                </MudAlert>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Programas</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Resumen.TotalProgramas.ToString(NumberCulture)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Color="Color.Info" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Indicadores</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Resumen.TotalIndicadores.ToString(NumberCulture)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cumplimiento</MudText>
                        <MudText Typo="Typo.h5">@Pct(dashboard.Resumen.CumplimientoPromedio)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Warning" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Evaluaciones</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Resumen.TotalEvaluaciones.ToString(NumberCulture)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Error" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ASM activos</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Resumen.AsmActivos.ToString(NumberCulture)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="2">
                    <MudPaper Elevation="1" Class="pa-3 pbr-kpi">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Secondary" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Presupuesto</MudText>
                        <MudText Typo="Typo.h5">@MoneyCompact(dashboard.Resumen.PresupuestoModificado)</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="2">
                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="1" Class="pa-4 pbr-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Semáforo de indicadores</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Último avance registrado del ejercicio</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @dashboard.Semaforo.Count indicadores visibles
                            </MudChip>
                        </MudStack>

                        <MudGrid Spacing="2" Class="mb-3">
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-3 pbr-semaforo-box">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.h5">@dashboard.SemaforoConteo.Verde</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Verde</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-3 pbr-semaforo-box">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Warning" Size="Size.Small" />
                                    <MudText Typo="Typo.h5">@dashboard.SemaforoConteo.Amarillo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Amarillo</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-3 pbr-semaforo-box">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Error" Size="Size.Small" />
                                    <MudText Typo="Typo.h5">@dashboard.SemaforoConteo.Rojo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rojo</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-3 pbr-semaforo-box">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" />
                                    <MudText Typo="Typo.h5">@dashboard.SemaforoConteo.SinDatos</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sin datos</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <div class="pbr-table-wrap pbr-sticky-table">
                            <GenericDataGrid TItem="PbrSemaforoIndicadorResponse"
                                             @key="dashboard.Semaforo"
                                             Items="@dashboard.Semaforo"
                                             ShowToolbar="false"
                                             EnableColumnOptions="false"
                                             FixedHeader="false"
                                             TableHeight="auto"
                                             PageSize="30">
                                <Columns>
                                    <TemplateColumn T="PbrSemaforoIndicadorResponse" Title="Programa" Identifier="Programa" PropertyName="Programa" SortBy="x => x.Programa"><CellTemplate Context="cell">@TextOrDash(cell.Item.Programa)</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrSemaforoIndicadorResponse" Title="Indicador" Identifier="Nombre" PropertyName="Nombre" SortBy="x => x.Nombre"><CellTemplate Context="cell">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@TextOrDash(cell.Item.Nombre)</MudText>
                                    </CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrSemaforoIndicadorResponse" Title="Nivel" Identifier="Nivel" PropertyName="Nivel" SortBy="x => x.Nivel"><CellTemplate Context="cell">@TextOrDash(cell.Item.Nivel)</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrSemaforoIndicadorResponse" Title="%" Identifier="Porcentaje" PropertyName="Porcentaje" SortBy="x => x.Porcentaje" HeaderClass="text-end" CellClass="text-end"><CellTemplate Context="cell">@PctOrDash(cell.Item.Porcentaje)</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrSemaforoIndicadorResponse" Title="Estado" Identifier="Estado" PropertyName="Estado" SortBy="x => x.Estado"><CellTemplate Context="cell">
                                        <MudChip T="string" Size="Size.Small" Color="@EstadoColor(cell.Item.Estado)">
                                            @EstadoLabel(cell.Item.Estado)
                                        </MudChip>
                                    </CellTemplate></TemplateColumn>
                                </Columns>
                            </GenericDataGrid>
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="5">
                    <MudPaper Elevation="1" Class="pa-4 pbr-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Ranking de programas</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Cumplimiento físico y cobertura de avances</MudText>
                            </div>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="OpenMatriz">
                                Ver MIR
                            </MudButton>
                        </MudStack>

                        <MudStack Spacing="2">
                            @foreach (var item in dashboard.RankingProgramas.Take(8))
                            {
                                <div class="pbr-ranking-row">
                                    <div class="pbr-ranking-header">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@($"{item.Clave} - {item.Nombre}")</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@Pct(item.Cumplimiento)</MudText>
                                    </div>
                                    <MudProgressLinear Value="@ToDouble(item.Cumplimiento)" Color="@ProgressColor(item.Cumplimiento)" Rounded="true" Size="Size.Small" />
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.IndicadoresConAvance/@item.TotalIndicadores con avance</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@MoneyCompact(item.Presupuesto)</MudText>
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="1" Class="pa-4 pbr-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Presupuesto por programa</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Top por presupuesto modificado</MudText>
                            </div>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="OpenPresupuestos">
                                Ver presupuestos
                            </MudButton>
                        </MudStack>

                        <div class="pbr-table-wrap pbr-sticky-table">
                            <GenericDataGrid TItem="PbrTopPresupuestoResponse"
                                             @key="dashboard.TopPresupuestos"
                                             Items="@dashboard.TopPresupuestos"
                                             ShowToolbar="false"
                                             EnableColumnOptions="false"
                                             FixedHeader="false"
                                             TableHeight="auto"
                                             PageSize="10">
                                <Columns>
                                    <TemplateColumn T="PbrTopPresupuestoResponse" Title="Programa" Identifier="ProgramaClave" PropertyName="ProgramaClave" SortBy="x => x.ProgramaClave"><CellTemplate Context="cell">@($"{cell.Item.ProgramaClave} {cell.Item.Programa}")</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrTopPresupuestoResponse" Title="Anual" Identifier="PresupuestoAnual" PropertyName="PresupuestoAnual" SortBy="x => x.PresupuestoAnual" HeaderClass="text-end" CellClass="text-end"><CellTemplate Context="cell">@Money(cell.Item.PresupuestoAnual)</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="PbrTopPresupuestoResponse" Title="Modificado" Identifier="PresupuestoModificado" PropertyName="PresupuestoModificado" SortBy="x => x.PresupuestoModificado" HeaderClass="text-end" CellClass="text-end"><CellTemplate Context="cell">@Money(cell.Item.PresupuestoModificado)</CellTemplate></TemplateColumn>
                                </Columns>
                            </GenericDataGrid>
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="5">
                    <MudPaper Elevation="1" Class="pa-4 pbr-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Cobertura MIR</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @dashboard.Resumen.ProgramasConMirCompleta programas completos (@Pct(dashboard.Resumen.CoberturaMirPorcentaje))
                                </MudText>
                            </div>
                            <MudProgressCircular Value="@ToDouble(dashboard.Resumen.CoberturaMirPorcentaje)" Color="Color.Primary" Size="Size.Medium" />
                        </MudStack>

                        <MudStack Spacing="1">
                            @foreach (var item in dashboard.CoberturaMir.Take(10))
                            {
                                <div class="pbr-coverage-row">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@($"{item.Clave} - {item.Nombre}")</MudText>
                                    <MudStack Row="true" Spacing="1" Class="mt-1">
                                        <MudChip T="string" Size="Size.Small" Color="@(item.TieneFin ? Color.Success : Color.Default)">Fin</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@(item.TieneProposito ? Color.Success : Color.Default)">Propósito</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@(item.TieneComponente ? Color.Success : Color.Default)">Componente</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@(item.TieneActividad ? Color.Success : Color.Default)">Actividad</MudChip>
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

            </MudGrid>
        }
    </div>
</MudContainer>

@code {
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private PbrDashboardResponse? dashboard;
    private bool loading;
    private int anio = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await AnioState.InitializeAsync();
        anio = AnioState.AnioClave ?? DateTime.Now.Year;
        AnioState.OnAnioChanged += OnAnioChanged;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        loading = true;
        try
        {
            dashboard = await DashboardService.GetAsync(anio);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No fue posible cargar el tablero PBR: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async void OnAnioChanged(int? _)
    {
        anio = AnioState.AnioClave ?? DateTime.Now.Year;
        await LoadDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void GoTo(string route) => NavigationManager.NavigateTo(route);
    private void OpenPresupuestos() => GoTo("/PBR/Presupuestos");
    private void OpenMatriz() => GoTo("/PBR/MatrizIndicadores");

    private static string TextOrDash(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Trim()
            .Replace("ÑIndice", "Índice", StringComparison.Ordinal)
            .Replace("Ñíndice", "Índice", StringComparison.Ordinal)
            .Replace("Ñindice", "Índice", StringComparison.Ordinal);
    }
    private static string Pct(decimal value) => $"{value.ToString("0.00", NumberCulture)}%";
    private static string PctOrDash(decimal? value) => value.HasValue ? Pct(value.Value) : "-";
    private static double ToDouble(decimal value) => (double)Math.Clamp(value, 0, 100);
    private static string Money(decimal value) => "$" + value.ToString("0.00", NumberCulture);

    private static string MoneyCompact(decimal value)
    {
        if (value >= 1000000)
        {
            return "$" + (value / 1000000m).ToString("0.00", NumberCulture) + "M";
        }

        if (value >= 1000)
        {
            return "$" + (value / 1000m).ToString("0.00", NumberCulture) + "K";
        }

        return Money(value);
    }

    private static Color EstadoColor(string estado) => estado switch
    {
        "verde" => Color.Success,
        "amarillo" => Color.Warning,
        "rojo" => Color.Error,
        _ => Color.Default
    };

    private static Color ProgressColor(decimal value)
    {
        if (value >= 90)
        {
            return Color.Success;
        }

        return value >= 70 ? Color.Warning : Color.Error;
    }

    private static string EstadoLabel(string estado) => estado switch
    {
        "verde" => "Verde",
        "amarillo" => "Amarillo",
        "rojo" => "Rojo",
        _ => "Sin datos"
    };

    public void Dispose()
    {
        AnioState.OnAnioChanged -= OnAnioChanged;
    }
}

<style>
    .pbr-dashboard-scroll {
        flex-grow: 1;
        overflow: auto;
        min-height: 0;
        padding: 8px 0 18px;
    }

    .pbr-panel {
        border-radius: 8px;
        height: 100%;
    }

    .pbr-kpi {
        border-radius: 8px;
        min-height: 112px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .pbr-semaforo-box {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        text-align: center;
    }

    .pbr-table-wrap {
        max-height: 430px;
        overflow: auto;
    }

    .pbr-sticky-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--mud-palette-surface);
        box-shadow: inset 0 -1px 0 var(--mud-palette-lines-default);
    }

    .pbr-ranking-row,
    .pbr-coverage-row {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px 12px;
    }

    .pbr-ranking-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 6px;
    }

</style>
