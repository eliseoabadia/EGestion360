@typeparam TItem where TItem : class, new()
@using System.Globalization
@using System.Reflection
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<TItem> Service
@inject ISnackbar Snackbar
@inject AnioPresupuestalStateService AnioStateService

<BaseCrudDialog TItem="TItem"
                Title="@DialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@ActionText"
                ProcessingText="@ProcessingText"
                LoadingMessage="Cargando registro..."
                OnConfirm="GuardarAsync">
    <MudForm @ref="form">
        <MudGrid GutterSize="2">
            @foreach (var property in EditableProperties)
            {
                <MudItem xs="12" sm="@GetColumnSpan(property)">
                    @if (IsBoolean(property))
                    {
                        <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                            <MudSwitch T="bool"
                                       Value="@GetBoolValue(property)"
                                       ValueChanged="@((bool value) => SetBoolValue(property, value))"
                                       Color="Color.Primary">
                                <MudText>@GetLabel(property)</MudText>
                            </MudSwitch>
                        </MudPaper>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Value="@GetTextValue(property)"
                                      ValueChanged="@((string value) => SetTextValue(property, value))"
                                      Label="@GetLabel(property)"
                                      Variant="Variant.Outlined"
                                      InputType="@GetInputType(property)"
                                      Lines="@(IsLongText(property) ? 3 : 1)"
                                      Required="@IsRequired(property)"
                                      RequiredError="@($"{GetLabel(property)} es requerido")"
                                      Immediate="false" />
                    }
                </MudItem>
            }
        </MudGrid>
    </MudForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public Dictionary<string, object?>? InitialValues { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;
    private TItem item = new();

    private string DialogTitle => Id.HasValue ? "Editar registro PBR" : "Nuevo registro PBR";
    private string ActionText => Id.HasValue ? "Actualizar" : "Crear";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private IEnumerable<PropertyInfo> EditableProperties => typeof(TItem)
        .GetProperties(BindingFlags.Instance | BindingFlags.Public)
        .Where(p => p.CanRead && p.CanWrite && !IsIgnoredProperty(p))
        .Take(18);

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();
        SetDefaultValues();
        ApplyInitialValues();
        ApplyHeaderAnio(overwrite: false);

        if (Id.HasValue)
        {
            await CargarAsync();
        }
    }

    private async Task CargarAsync()
    {
        var response = await Service.GetByIdAsync(Id!.Value);
        if (response?.Success == true && response.Data != null)
        {
            item = response.Data;
            ApplyHeaderAnio(overwrite: true);
        }
    }

    private async Task GuardarAsync(bool _)
    {
        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        ApplyHeaderAnio(overwrite: true);
        TrimStrings();

        var response = Id.HasValue
            ? await Service.UpdateAsync(item, Id.Value)
            : await Service.CreateAsync(item);

        if (response?.Success == true)
        {
            Snackbar.Add(response.Message ?? "Registro guardado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        Snackbar.Add(response?.Message ?? "No fue posible guardar el registro.", Severity.Error);
    }

    private void SetDefaultValues()
    {
        SetIfExists("Activo", true);
        SetIfExists("Estatus", "BORRADOR");
        SetIfExists("Sentido", "Ascendente");
        SetIfExists("FechaCreacion", DateTime.Now);
        SetIfExists("Anio", AnioStateService.AnioClave ?? DateTime.Today.Year);
    }

    private void ApplyInitialValues()
    {
        if (InitialValues == null)
        {
            return;
        }

        foreach (var (propertyName, value) in InitialValues)
        {
            var property = typeof(TItem).GetProperty(propertyName);
            if (property == null || !property.CanWrite || value == null)
            {
                continue;
            }

            var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
            var converted = targetType.IsInstanceOfType(value)
                ? value
                : Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);

            property.SetValue(item, converted);
        }
    }

    private void SetIfExists(string propertyName, object value)
    {
        var property = typeof(TItem).GetProperty(propertyName);
        if (property == null || !property.CanWrite)
        {
            return;
        }

        var current = property.GetValue(item);
        if (current == null || IsDefaultValue(property.PropertyType, current))
        {
            property.SetValue(item, value);
        }
    }

    private void SetPropertyValueIfExists(string propertyName, object value, bool overwrite)
    {
        var property = typeof(TItem).GetProperty(propertyName);
        if (property == null || !property.CanWrite)
        {
            return;
        }

        var current = property.GetValue(item);
        if (!overwrite && current != null && !IsDefaultValue(property.PropertyType, current))
        {
            return;
        }

        var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        var converted = targetType.IsInstanceOfType(value)
            ? value
            : Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);

        property.SetValue(item, converted);
    }

    private void ApplyHeaderAnio(bool overwrite)
    {
        SetPropertyValueIfExists("Anio", AnioStateService.AnioClave ?? DateTime.Today.Year, overwrite);

        if (AnioStateService.AnioId is > 0)
        {
            SetPropertyValueIfExists("FkidAnioSis", AnioStateService.AnioId.Value, overwrite);
        }
    }

    private static bool IsDefaultValue(Type propertyType, object current)
    {
        if (propertyType == typeof(string))
        {
            return string.IsNullOrWhiteSpace(current as string);
        }

        var targetType = Nullable.GetUnderlyingType(propertyType) ?? propertyType;
        return current.Equals(Activator.CreateInstance(targetType));
    }

    private static bool IsIgnoredProperty(PropertyInfo property)
    {
        if (property.Name.StartsWith("Pkid", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (typeof(TItem).Name == "PbrIndicadorResponse" && property.Name == "Nivel")
        {
            return true;
        }

        return property.Name is
            "Activo" or
            "FechaCreacion" or
            "UsuarioCreacion" or
            "FechaModificacion" or
            "UsuarioModificacion" or
            "Anio" or
            "FkidAnioSis" or
            "ProgramaClave" or
            "ProgramaDescripcion" or
            "EntidadNombre" or
            "UnidadResponsableDescripcion" or
            "FuenteFinanciamientoDescripcion" or
            "ProyectoInversionDescripcion" or
            "RegionNombre" or
            "CapituloDescripcion" or
            "ConceptoDescripcion" or
            "PartidaDescripcion" or
            "TipoGastoDescripcion" or
            "PresupuestoAnio" or
            "MirVersion" or
            "MirObjetivo";
    }

    private static bool IsBoolean(PropertyInfo property)
        => (Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType) == typeof(bool);

    private static bool IsRequired(PropertyInfo property)
        => Nullable.GetUnderlyingType(property.PropertyType) == null
           && property.PropertyType.IsValueType == false
           && property.PropertyType == typeof(string);

    private static bool IsLongText(PropertyInfo property)
        => property.Name.Contains("Descripcion", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Observaciones", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Justificacion", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Definicion", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Formula", StringComparison.OrdinalIgnoreCase)
           || property.Name.Contains("Supuesto", StringComparison.OrdinalIgnoreCase);

    private static int GetColumnSpan(PropertyInfo property)
        => IsLongText(property) ? 12 : 6;

    private static InputType GetInputType(PropertyInfo property)
    {
        var type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (type == typeof(int) || type == typeof(decimal) || type == typeof(double) || type == typeof(float))
        {
            return InputType.Number;
        }

        return type == typeof(DateTime) ? InputType.Date : InputType.Text;
    }

    private string GetTextValue(PropertyInfo property)
    {
        var value = property.GetValue(item);
        return value switch
        {
            null => string.Empty,
            DateTime date => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            decimal number => number.ToString("0.####", CultureInfo.InvariantCulture),
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? string.Empty
        };
    }

    private void SetTextValue(PropertyInfo property, string value)
    {
        try
        {
            var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
            object? converted;

            if (string.IsNullOrWhiteSpace(value))
            {
                converted = Nullable.GetUnderlyingType(property.PropertyType) != null || targetType == typeof(string)
                    ? null
                    : Activator.CreateInstance(targetType);
            }
            else if (targetType == typeof(string))
            {
                converted = value;
            }
            else if (targetType == typeof(int))
            {
                converted = int.Parse(value, CultureInfo.InvariantCulture);
            }
            else if (targetType == typeof(decimal))
            {
                converted = decimal.Parse(value, NumberStyles.Number, CultureInfo.InvariantCulture);
            }
            else if (targetType == typeof(DateTime))
            {
                converted = DateTime.Parse(value, CultureInfo.InvariantCulture);
            }
            else
            {
                converted = Convert.ChangeType(value, targetType, CultureInfo.InvariantCulture);
            }

            property.SetValue(item, converted);
        }
        catch
        {
            Snackbar.Add($"El valor de {GetLabel(property)} no es valido.", Severity.Warning);
        }
    }

    private bool GetBoolValue(PropertyInfo property)
        => property.GetValue(item) as bool? ?? false;

    private void SetBoolValue(PropertyInfo property, bool value)
        => property.SetValue(item, value);

    private void TrimStrings()
    {
        foreach (var property in typeof(TItem).GetProperties(BindingFlags.Instance | BindingFlags.Public)
            .Where(p => p.CanRead && p.CanWrite && p.PropertyType == typeof(string)))
        {
            property.SetValue(item, (property.GetValue(item) as string)?.Trim() ?? string.Empty);
        }
    }

    private static string GetLabel(PropertyInfo property)
        => property.Name switch
        {
            "FkidProgramaPresupuestarioPbr" => "Programa presupuestario",
            "FkidPresupuestoProgramaPbr" => "Presupuesto programa",
            "FkidMirVersionPbr" => "Version MIR",
            "FkidMirNivelPbr" => "Nivel MIR",
            "FkidUsuarioPbr" => "Usuario",
            "FkidEntidadPbr" => "Entidad",
            "FkidUnidadResponsablePres" => "Unidad responsable",
            "FkidFuenteFinanciamientoPres" => "Fuente financiamiento",
            "FkidActividadInstitucionalSis" => "Actividad institucional",
            "FkidProyectoInversionPres" => "Proyecto inversion",
            "FkidRegionPbr" => "Region",
            "FkidCapituloSis" => "Capitulo",
            "FkidConceptoSis" => "Concepto",
            "FkidPartidaSis" => "Partida",
            "FkidTipoGastoPres" => "Tipo de gasto",
            "MontoSolicitado" => "Monto solicitado",
            "MontoAutorizado" => "Monto autorizado",
            "PresupuestoAnual" => "Presupuesto anual",
            "PresupuestoModificado" => "Presupuesto modificado",
            "MontoAnual" => "Monto anual",
            "MontoModificado" => "Monto modificado",
            _ => Humanize(property.Name)
        };

    private static string Humanize(string value)
    {
        var text = value
            .Replace("Fkid", string.Empty, StringComparison.Ordinal)
            .Replace("Pkid", "ID", StringComparison.Ordinal)
            .Replace("Pbr", string.Empty, StringComparison.Ordinal)
            .Replace("PBR", string.Empty, StringComparison.Ordinal)
            .Replace("Sis", string.Empty, StringComparison.Ordinal)
            .Replace("Pres", string.Empty, StringComparison.Ordinal);

        return System.Text.RegularExpressions.Regex
            .Replace(text, "([a-z])([A-Z])", "$1 $2")
            .Trim();
    }
}
