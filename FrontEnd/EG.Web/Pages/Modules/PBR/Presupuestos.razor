@page "/PBR/Presupuestos"
@using System.Globalization
@using EG.Domain.DTOs.Responses.PBR
@using EG.Dommain.DTOs.Responses
@using EG.Web.Contracts
@using EG.Web.Pages.Modules.PBR.Shared
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using Microsoft.JSInterop
@using MudBlazor

@inject IGenericCrudService<PbrPresupuestoProgramaResponse> Service
@inject IGenericCrudService<PbrPartidaGastoResponse> PartidaService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudContainer MaxWidth="MaxWidth.False" Class="px-3 d-flex flex-column" Style="height: 100%; min-height: 0; overflow: auto;">
    @if (selected == null)
    {
        <PageHeader Title="Presupuestos PBR"
                    Subtitle="Programas presupuestarios y distribucion por partidas"
                    Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    CanCreate="true"
                    OnCreate="() => OpenPresupuestoDialog(null)"
                    OnRefresh="() => table.ReloadData()" />

        <PbrTopNavigation />

        <div style="flex-grow: 1; overflow: hidden; min-height: 0;">
            <GenericDataGrid TItem="PbrPresupuestoProgramaResponse"
                          @ref="table"
                          Title="Presupuesto por programa"
                          SearchPlaceholder="Buscar por programa, entidad, UR o fuente..."
                          ShowExportButton="false"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportAsync"
                          SearchString="@search"
                          SearchStringChanged="(s) => search = s"
                          OnSearch="() => table.ReloadData()">
            <Columns>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <DocumentSupportButton Modulo="PBR"
                        SubModulo="Presupuestos"
                        Controlador="PbrPresupuestoPrograma"
                        EntidadId="@cell.Item.PkidPresupuestoPrograma"
                        RegistroTitulo="@($"Presupuesto {cell.Item.PkidPresupuestoPrograma}")"
                        RegistroDescripcion="@TextOrDash(cell.Item.ProgramaDescripcion)" />
                        <MudTooltip Text="Ver partidas">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => SelectPresupuesto(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => OpenPresupuestoDialog(cell.Item.PkidPresupuestoPrograma))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="Programa" Identifier="ProgramaDescripcion" PropertyName="ProgramaDescripcion" SortBy="x => x.ProgramaDescripcion">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@TextOrDash(cell.Item.ProgramaDescripcion)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.ProgramaClave)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="ID" Identifier="PkidPresupuestoPrograma" PropertyName="PkidPresupuestoPrograma" SortBy="x => x.PkidPresupuestoPrograma">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidPresupuestoPrograma
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="Año" Identifier="Anio" PropertyName="Anio" SortBy="x => x.Anio">
                    <CellTemplate Context="cell">
                        @cell.Item.Anio
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="Anual" Identifier="PresupuestoAnual" PropertyName="PresupuestoAnual" SortBy="x => x.PresupuestoAnual">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.PresupuestoAnual)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="Modificado" Identifier="PresupuestoModificado" PropertyName="PresupuestoModificado" SortBy="x => x.PresupuestoModificado">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.PresupuestoModificado ?? cell.Item.PresupuestoAnual)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPresupuestoProgramaResponse" Title="UR" Identifier="UnidadResponsableDescripcion" PropertyName="UnidadResponsableDescripcion" SortBy="x => x.UnidadResponsableDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.UnidadResponsableDescripcion)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    }
    else
    {
        <PbrTopNavigation OnBack="BackToTable" />

        <MudPaper Elevation="0" Class="pa-0 d-flex align-center mb-2" Style="background: transparent;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="BackToTable" />
            <div class="ml-2">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">@TextOrDash(selected.ProgramaDescripcion)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@selected.Anio | @Money(selected.PresupuestoAnual)</MudText>
            </div>
            <MudSpacer />
            <MudTooltip Text="Agregar partida">
                <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="() => OpenPartidaDialog(null)" />
            </MudTooltip>
            <MudTooltip Text="Actualizar">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="() => partidaTable.ReloadData()" />
            </MudTooltip>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-3 mb-2" Style="border-radius: 8px;">
            <MudGrid Spacing="2">
                <MudItem xs="6" md="2"><MudText Typo="Typo.caption">Anual</MudText><MudText Typo="Typo.body2" Style="font-weight: 700;">@Money(selected.PresupuestoAnual)</MudText></MudItem>
                <MudItem xs="6" md="2"><MudText Typo="Typo.caption">Modificado</MudText><MudText Typo="Typo.body2" Style="font-weight: 700;">@Money(selected.PresupuestoModificado ?? selected.PresupuestoAnual)</MudText></MudItem>
                <MudItem xs="12" md="4"><MudText Typo="Typo.caption">Fuente</MudText><MudText Typo="Typo.body2">@TextOrDash(selected.FuenteFinanciamientoDescripcion)</MudText></MudItem>
                <MudItem xs="12" md="4"><MudText Typo="Typo.caption">Proyecto</MudText><MudText Typo="Typo.body2">@TextOrDash(selected.ProyectoInversionDescripcion)</MudText></MudItem>
            </MudGrid>
        </MudPaper>

        <div style="flex-grow: 1; overflow: hidden; min-height: 0;">
            <GenericDataGrid TItem="PbrPartidaGastoResponse"
                          @ref="partidaTable"
                          Title="Partidas del presupuesto"
                          SearchPlaceholder="Buscar por partida, concepto o descripcion..."
                          ShowExportButton="false"
                          ServerDataFunc="LoadPartidasServerData"
                          SearchString="@partidaSearch"
                          SearchStringChanged="(s) => partidaSearch = s"
                          OnSearch="() => partidaTable.ReloadData()">
            <Columns>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenPartidaDialog(cell.Item.PkidPartidaGasto))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePartidaAsync(cell.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Programa" Identifier="ProgramaDescripcion" PropertyName="ProgramaDescripcion" SortBy="x => x.ProgramaDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.ProgramaDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="ID" Identifier="PkidPartidaGasto" PropertyName="PkidPartidaGasto" SortBy="x => x.PkidPartidaGasto">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidPartidaGasto
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Partida" Identifier="PartidaDescripcion" PropertyName="PartidaDescripcion" SortBy="x => x.PartidaDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.PartidaDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Descripcion" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Descripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Anual" Identifier="MontoAnual" PropertyName="MontoAnual" SortBy="x => x.MontoAnual">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.MontoAnual)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Modificado" Identifier="MontoModificado" PropertyName="MontoModificado" SortBy="x => x.MontoModificado">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.MontoModificado ?? cell.Item.MontoAnual)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PbrPartidaGastoResponse" Title="Tipo" Identifier="TipoGastoDescripcion" PropertyName="TipoGastoDescripcion" SortBy="x => x.TipoGastoDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoGastoDescripcion)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    }
</MudContainer>

@code {
    private GenericDataGrid<PbrPresupuestoProgramaResponse> table = null!;
    private GenericDataGrid<PbrPartidaGastoResponse> partidaTable = null!;
    private PbrPresupuestoProgramaResponse? selected;
    private string search = string.Empty;
    private string partidaSearch = string.Empty;
    private string currencySymbol = "$";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override async Task OnInitializedAsync() => await LoadCurrencyAsync();

    private async Task<TableData<PbrPresupuestoProgramaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await Service.GetAllPaginadoAsync(Math.Max(1, state.Page + 1), state.PageSize, search, state.SortLabel ?? "ProgramaDescripcion", state.SortDirection);
        return new TableData<PbrPresupuestoProgramaResponse> { Items = response?.Items ?? new List<PbrPresupuestoProgramaResponse>(), TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task<TableData<PbrPartidaGastoResponse>> LoadPartidasServerData(TableState state, CancellationToken cancellationToken)
    {
        if (selected == null)
        {
            return new TableData<PbrPartidaGastoResponse> { Items = new List<PbrPartidaGastoResponse>(), TotalItems = 0 };
        }

        var response = await PartidaService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            partidaSearch,
            state.SortLabel ?? "ProgramaDescripcion",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidPresupuestoProgramaPbr"] = selected.PkidPresupuestoPrograma });

        return new TableData<PbrPartidaGastoResponse> { Items = response?.Items ?? new List<PbrPartidaGastoResponse>(), TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task OpenPresupuestoDialog(int? id)
    {
        var parameters = new DialogParameters { ["Id"] = id };
        var dialog = await DialogService.ShowAsync<PbrCrudDialog<PbrPresupuestoProgramaResponse>>(id.HasValue ? "Editar presupuesto" : "Nuevo presupuesto", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await table.ReloadData();
        }
    }

    private async Task OpenPartidaDialog(int? id)
    {
        if (selected == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["InitialValues"] = new Dictionary<string, object?> { ["FkidPresupuestoProgramaPbr"] = selected.PkidPresupuestoPrograma }
        };

        var dialog = await DialogService.ShowAsync<PbrCrudDialog<PbrPartidaGastoResponse>>(id.HasValue ? "Editar partida" : "Nueva partida", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await partidaTable.ReloadData();
        }
    }

    private void SelectPresupuesto(PbrPresupuestoProgramaResponse item)
    {
        selected = item;
        partidaSearch = string.Empty;
    }

    private async Task BackToTable()
    {
        selected = null;
        await table.ReloadData();
    }

    private async Task DeletePartidaAsync(PbrPartidaGastoResponse item)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Eliminar partida {item.PkidPartidaGasto}?"))
        {
            return;
        }

        var response = await PartidaService.DeleteAsync(item.PkidPartidaGasto);
        if (response?.Success == true)
        {
            Snackbar.Add("Partida eliminada correctamente.", Severity.Success);
            await partidaTable.ReloadData();
            return;
        }

        Snackbar.Add(response?.Message ?? "No fue posible eliminar.", Severity.Error);
    }

    private Task ExportAsync() => Task.CompletedTask;
    private string Money(decimal value) => $"{currencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                currencySymbol = string.IsNullOrWhiteSpace(response?.Data?.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("PbrPresupuestos")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para presupuestos PBR.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }
}
