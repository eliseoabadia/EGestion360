@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Esta acción regresará el cheque <strong>@NumeroCheque</strong> hasta su requisición.
                Se cancelarán lógicamente cheque, CLC, facturas, contratos, orden, suficiencia y cotizaciones, y se crearán
                pólizas de reversión por cada póliza contable de la cadena.
            </MudAlert>

            <MudText Typo="Typo.body2">
                La requisición quedará disponible como punto de reinicio. Si existen entradas cerradas,
                contabilizadas o ya consumidas, el sistema bloqueará la operación y solicitará una devolución de almacén.
                El historial original se conservará para auditoría.
            </MudText>

            <MudTextField @bind-Value="motivo"
                          Label="Motivo del regreso"
                          Placeholder="Describa por qué debe corregirse la solicitud..."
                          Variant="Variant.Outlined"
                          Lines="4"
                          Immediate="true"
                          Counter="1000"
                          MaxLength="1000"
                          Required="true"
                          HelperText="Capture al menos 10 caracteres." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Confirm"
                   Disabled="@(!CanConfirm)"
                   Color="Color.Warning"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Undo">
            Regresar a requisición
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string NumeroCheque { get; set; } = string.Empty;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string motivo = string.Empty;
    private bool CanConfirm => motivo.Trim().Length >= 10;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(motivo.Trim()));
    private void Cancel() => MudDialog.Cancel();
}
