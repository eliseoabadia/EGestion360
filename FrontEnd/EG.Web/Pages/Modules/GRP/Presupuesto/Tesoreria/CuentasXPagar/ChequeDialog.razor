@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<ChequeResponse> Service
@inject IGenericCrudService<ChequePartidaResponse> PartidaService
@inject IGenericCrudService<CuentaBancariaResponse> CuentaBancariaService
@inject IGenericCrudService<CLCResponse> ClcService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="ChequeResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="ChequeResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3"><MudTextField T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><PagedAutocomplete Value="@clc" ValueChanged="value => clc = value" Label="CLC" Required="true" RequiredError="La CLC es requerida" LoadPage="LoadClcsPageAsync" /></MudItem>
            <MudItem xs="12" md="3"><PagedAutocomplete Value="@cuentaBancaria" ValueChanged="value => cuentaBancaria = value" Label="Cuenta bancaria" Required="true" LoadPage="LoadCuentasBancariasPageAsync" /></MudItem>
            <MudItem xs="12" md="3"><MudAlert Severity="Severity.Info" Dense="true">Póliza de pagado automática</MudAlert></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="fechaEmision" Label="Fecha emision" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="item.NumeroCheque" Label="Cheque / transferencia" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="item.Concepto" Label="Concepto" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudNumericField T="decimal" @bind-Value="item.ImporteTotal" Label="Importe total" Required="true" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="item.Estatus" Label="Estatus" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">Registrado</MudSelectItem>
                    <MudSelectItem Value="2">Entregado</MudSelectItem>
                    <MudSelectItem Value="3">Cobrado</MudSelectItem>
                    <MudSelectItem Value="4">Cancelado</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        @if (!Id.HasValue && partidaItems.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700">Partidas pagadas que se generaran</MudText>
            <GenericDataGrid TItem="ChequePartidaResponse" @key="partidaItems"
                                 Items="@partidaItems"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="ChequePartidaResponse" Title="Partida" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.PartidaClaveNombre)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ChequePartidaResponse" Title="Monto" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <strong>@Money(cell.Item.MontoPagado)</strong>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="ChequePartidaResponse" Title="Observaciones" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.Observaciones)
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
        }
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public ChequeResponse? PrefillItem { get; set; }
    [Parameter] public IReadOnlyList<ChequePartidaResponse>? PrefillPartidas { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;
    private BaseEntityForm<ChequeResponse> form = null!;
    private ChequeResponse item = new() { Activo = true, Estatus = 1 };
    private List<ChequePartidaResponse> partidaItems = new();
    private LookupItem? cuentaBancaria;
    private LookupItem? clc;
    private DateTime? fechaEmision = DateTime.Today;
    private string Title => Id.HasValue ? "Editar cheque o transferencia" : "Nuevo cheque o transferencia";
    private string ActionText => Id.HasValue ? "Actualizar" : "Guardar pago";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Guardando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        if (!Id.HasValue)
        {
            if (PrefillItem != null)
            {
                item = CloneHeader(PrefillItem);
                fechaEmision = item.FechaEmision.ToDateTime(TimeOnly.MinValue);
                SetCuentaBancariaLookup();
                SetEntityLookups();
            }

            partidaItems = PrefillPartidas?.Select(ClonePartida).ToList() ?? new List<ChequePartidaResponse>();
            return;
        }

        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Data != null)
        {
            item = response.Data;
            fechaEmision = item.FechaEmision.ToDateTime(TimeOnly.MinValue);
            SetCuentaBancariaLookup();
            SetEntityLookups();
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        if (cuentaBancaria == null || clc == null)
        {
            Snackbar.Add("Selecciona CLC y cuenta bancaria.", Severity.Warning);
            return;
        }

        item.FkidClcPres = clc.Id;
        item.FkidCuentaBancariaTes = cuentaBancaria.Id;
        item.FechaEmision = DateOnly.FromDateTime(fechaEmision ?? DateTime.Today);
        if (item.ImporteTotal <= 0 && partidaItems.Count > 0)
        {
            item.ImporteTotal = partidaItems.Sum(x => x.MontoPagado);
        }

        item.Partidas = partidaItems.Where(x => x.MontoPagado > 0).Select(ClonePartida).ToList();
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add(Id.HasValue ? "Pago actualizado correctamente." : "Pago y partidas guardados correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data ?? item));
            return;
        }

        Snackbar.Add(result?.Message ?? "No fue posible guardar.", Severity.Error);
    }

    private static ChequeResponse CloneHeader(ChequeResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidClcPres = source.FkidClcPres,
        FkidContratoPres = source.FkidContratoPres,
        FkidCuentaBancariaTes = source.FkidCuentaBancariaTes,
        FkidPolizaConta = source.FkidPolizaConta,
        FechaEmision = source.FechaEmision,
        NumeroCheque = source.NumeroCheque,
        Concepto = source.Concepto,
        ImporteTotal = source.ImporteTotal,
        Observaciones = source.Observaciones,
        Estatus = source.Estatus,
        Activo = source.Activo
    };

    private static ChequePartidaResponse ClonePartida(ChequePartidaResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidClcdetallePres = source.FkidClcdetallePres,
        FkidClcPres = source.FkidClcPres,
        NumClc = source.NumClc,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        PartidaClaveNombre = source.PartidaClaveNombre,
        MontoPagado = source.MontoPagado,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private void SetCuentaBancariaLookup()
    {
        cuentaBancaria = item.FkidCuentaBancariaTes > 0
            ? new LookupItem { Id = item.FkidCuentaBancariaTes, Text = item.FkidCuentaBancariaTes.ToString() }
            : null;
    }

    private async Task<ComboLookupResult> LoadCuentasBancariasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await CuentaBancariaService.GetAllPaginadoAsync(page, pageSize, filter, "NumeroCuenta", SortDirection.Ascending);
        var list = response?.Items?.Select(x => new LookupItem
        {
            Id = x.PkidCuentaBancaria,
            Text = $"{x.NumeroCuenta} - {x.BancoNombre}"
        }).ToList() ?? new List<LookupItem>();

        return new ComboLookupResult { Items = list, TotalCount = response?.TotalCount ?? list.Count };
    }

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal value) => $"${value.ToString("0.00", Culture)}";
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? item.FkidEmpresaSis.ToString()
            : $"{SucursalStateService.EmpresaNombre} ({item.FkidEmpresaSis})"
        : "Sin empresa seleccionada";

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }
    private void SetEntityLookups()
    {
        clc = item.FkidClcPres > 0 ? new LookupItem { Id = item.FkidClcPres, Text = TextOrDash(item.NumClc) } : null;
    }
    private async Task<ComboLookupResult> LoadClcsPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ClcService.GetAllPaginadoAsync(page, pageSize, filter, "NumClc", SortDirection.Descending, CompanyFilter());
        var list = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem { Id = x.PkidClc, Text = $"{x.NumClc} - {x.ProveedorNombre}" }).ToList() ?? new();
        return new ComboLookupResult { Items = list, TotalCount = response?.TotalCount ?? list.Count };
    }
    private Dictionary<string, object>? CompanyFilter() => item.FkidEmpresaSis > 0 ? new() { ["FkidEmpresaSis"] = item.FkidEmpresaSis } : null;

}
