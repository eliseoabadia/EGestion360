@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<FacturaResponse> Service
@inject IGenericCrudService<FacturaDetalleResponse> DetalleService
@inject IGenericCrudService<ContratoResponse> ContratoService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="FacturaResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="FacturaResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4"><MudTextField T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><PagedAutocomplete Value="@contrato" ValueChanged="value => contrato = value" Label="Contrato" Required="true" RequiredError="El contrato es requerido" LoadPage="LoadContratosPageAsync" /></MudItem>
            <MudItem xs="12" md="4"><MudAlert Severity="Severity.Info" Dense="true">Póliza de devengado automática</MudAlert></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="item.NumFactura" Label="Numero de factura" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="item.SerieFactura" Label="Serie" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="fechaEmision" Label="Fecha emision" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="fechaRecepcion" Label="Fecha recepcion" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal?" @bind-Value="item.Subtotal" Label="Subtotal" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal?" @bind-Value="item.Iva" Label="IVA" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal?" @bind-Value="item.Retencion" Label="Retencion" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal" @bind-Value="item.Total" Label="Total" Required="true" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="item.Uuid" Label="UUID" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="item.Estatus" Label="Estatus" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">Registrada</MudSelectItem>
                    <MudSelectItem Value="2">Validada</MudSelectItem>
                    <MudSelectItem Value="3">Devengada</MudSelectItem>
                    <MudSelectItem Value="4">Rechazada</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        @if (!Id.HasValue && detalleItems.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700">Partidas de factura</MudText>
            <GenericDataGrid TItem="FacturaDetalleResponse" @key="detalleItems"
                                 Items="@detalleItems"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="FacturaDetalleResponse" Title="Partida" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.PartidaClaveNombre)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="FacturaDetalleResponse" Title="Monto aplicado" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <MudNumericField T="decimal" @bind-Value="cell.Item.MontoAplicado" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="FacturaDetalleResponse" Title="Observaciones" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.Observaciones)
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
        }
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public FacturaResponse? PrefillItem { get; set; }
    [Parameter] public IReadOnlyList<FacturaDetalleResponse>? PrefillDetalles { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;
    private BaseEntityForm<FacturaResponse> form = null!;
    private FacturaResponse item = new() { Activo = true, Estatus = 1 };
    private List<FacturaDetalleResponse> detalleItems = new();
    private DateTime? fechaEmision = DateTime.Today;
    private DateTime? fechaRecepcion = DateTime.Today;
    private LookupItem? contrato;
    private string Title => Id.HasValue ? "Editar factura" : "Nueva factura";
    private string ActionText => Id.HasValue ? "Actualizar" : "Guardar factura";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Guardando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        if (!Id.HasValue)
        {
            if (PrefillItem != null)
            {
                item = CloneHeader(PrefillItem);
                SetLookups();
                fechaEmision = item.FechaEmision.ToDateTime(TimeOnly.MinValue);
                fechaRecepcion = item.FechaRecepcion?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
            }

            detalleItems = PrefillDetalles?.Select(CloneDetail).ToList() ?? new List<FacturaDetalleResponse>();
            return;
        }

        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Data != null)
        {
            item = response.Data;
            SetLookups();
            fechaEmision = item.FechaEmision.ToDateTime(TimeOnly.MinValue);
            fechaRecepcion = item.FechaRecepcion?.ToDateTime(TimeOnly.MinValue);
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }
        if (contrato == null)
        {
            Snackbar.Add("Selecciona contrato.", Severity.Warning);
            return;
        }

        item.FkidContratoPres = contrato.Id;
        item.FechaEmision = DateOnly.FromDateTime(fechaEmision ?? DateTime.Today);
        item.FechaRecepcion = fechaRecepcion.HasValue ? DateOnly.FromDateTime(fechaRecepcion.Value) : null;
        if (item.Total <= 0)
        {
            item.Total = detalleItems.Count > 0
                ? detalleItems.Sum(x => x.MontoAplicado)
                : (item.Subtotal ?? 0m) + (item.Iva ?? 0m) - (item.Retencion ?? 0m);
        }

        item.Detalles = detalleItems.Where(x => x.MontoAplicado > 0).Select(CloneDetail).ToList();
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add(Id.HasValue ? "Factura actualizada correctamente." : "Factura y detalle guardados correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data ?? item));
            return;
        }

        Snackbar.Add(result?.Message ?? "No fue posible guardar la factura.", Severity.Error);
    }

    private static FacturaResponse CloneHeader(FacturaResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidContratoPres = source.FkidContratoPres,
        FkidPolizaConta = source.FkidPolizaConta,
        NumFactura = source.NumFactura,
        SerieFactura = source.SerieFactura,
        FechaEmision = source.FechaEmision,
        FechaRecepcion = source.FechaRecepcion,
        Subtotal = source.Subtotal,
        Iva = source.Iva,
        Retencion = source.Retencion,
        Total = source.Total,
        Uuid = source.Uuid,
        FlDocto = source.FlDocto,
        Observaciones = source.Observaciones,
        Estatus = source.Estatus,
        Activo = source.Activo
    };

    private static FacturaDetalleResponse CloneDetail(FacturaDetalleResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidContratoDetallePres = source.FkidContratoDetallePres,
        FkidContratoPres = source.FkidContratoPres,
        NumeroContrato = source.NumeroContrato,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        PartidaClaveNombre = source.PartidaClaveNombre,
        MontoAplicado = source.MontoAplicado,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private void SetLookups()
    {
        contrato = item.FkidContratoPres > 0 ? new LookupItem { Id = item.FkidContratoPres, Text = TextOrDash(item.NumeroContrato) } : null;
    }
    private async Task<ComboLookupResult> LoadContratosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ContratoService.GetAllPaginadoAsync(page, pageSize, filter, "NumeroContrato", SortDirection.Ascending, CompanyFilter());
        var list = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem { Id = x.PkidContrato, Text = $"{x.NumeroContrato} - {x.ProveedorNombre}" }).ToList() ?? new();
        return new ComboLookupResult { Items = list, TotalCount = response?.TotalCount ?? list.Count };
    }
    private Dictionary<string, object>? CompanyFilter() => item.FkidEmpresaSis > 0 ? new() { ["FkidEmpresaSis"] = item.FkidEmpresaSis } : null;
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? item.FkidEmpresaSis.ToString()
            : $"{SucursalStateService.EmpresaNombre} ({item.FkidEmpresaSis})"
        : "Sin empresa seleccionada";

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
