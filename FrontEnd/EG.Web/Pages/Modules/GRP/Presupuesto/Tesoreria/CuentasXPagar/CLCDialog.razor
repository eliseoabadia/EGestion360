@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<CLCResponse> Service
@inject IGenericCrudService<CLCDetalleResponse> DetalleService
@inject IGenericCrudService<CLCFacturaResponse> FacturaService
@inject IGenericCrudService<ContratoResponse> ContratoService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="CLCResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="CLCResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3"><MudTextField T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><PagedAutocomplete Value="@contrato" ValueChanged="value => contrato = value" Label="Contrato" Required="true" RequiredError="El contrato es requerido" LoadPage="LoadContratosPageAsync" /></MudItem>
            <MudItem xs="12" md="3"><MudAlert Severity="Severity.Info" Dense="true">Póliza de ejercido automática</MudAlert></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="item.NumClc" Label="Numero CLC" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="fechaSolicitud" Label="Fecha solicitud" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="fechaAutorizacion" Label="Fecha autorizacion" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal" @bind-Value="item.ImporteTotal" Label="Importe total" Required="true" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="item.Estatus" Label="Estatus" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">Borrador</MudSelectItem>
                    <MudSelectItem Value="2">Solicitada</MudSelectItem>
                    <MudSelectItem Value="3">Autorizada</MudSelectItem>
                    <MudSelectItem Value="4">Pagada</MudSelectItem>
                    <MudSelectItem Value="5">Cancelada</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        @if (!Id.HasValue && detalleItems.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700">Detalle presupuestal y facturas asociadas</MudText>
            <GenericDataGrid TItem="CLCDetalleResponse" @key="detalleItems"
                                 Items="@detalleItems"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="CLCDetalleResponse" Title="Partida" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.PartidaClaveNombre)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="CLCDetalleResponse" Title="Total" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <strong>@Money(DetailTotal(cell.Item))</strong>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="CLCDetalleResponse" Title="Observaciones" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.Observaciones)
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
        }
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public CLCResponse? PrefillItem { get; set; }
    [Parameter] public IReadOnlyList<CLCDetalleResponse>? PrefillDetalles { get; set; }
    [Parameter] public IReadOnlyList<CLCFacturaResponse>? PrefillFacturas { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;
    private BaseEntityForm<CLCResponse> form = null!;
    private CLCResponse item = new() { Activo = true, Estatus = 1 };
    private List<CLCDetalleResponse> detalleItems = new();
    private List<CLCFacturaResponse> facturaItems = new();
    private DateTime? fechaSolicitud = DateTime.Today;
    private DateTime? fechaAutorizacion;
    private LookupItem? contrato;
    private string Title => Id.HasValue ? "Editar CLC" : "Nueva CLC";
    private string ActionText => Id.HasValue ? "Actualizar" : "Guardar CLC";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Guardando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        if (!Id.HasValue)
        {
            if (PrefillItem != null)
            {
                item = CloneHeader(PrefillItem);
                SetLookups();
                fechaSolicitud = item.FechaSolicitud.ToDateTime(TimeOnly.MinValue);
                fechaAutorizacion = item.FechaAutorizacion?.ToDateTime(TimeOnly.MinValue);
            }

            detalleItems = PrefillDetalles?.Select(CloneDetail).ToList() ?? new List<CLCDetalleResponse>();
            facturaItems = PrefillFacturas?.Select(CloneFactura).ToList() ?? new List<CLCFacturaResponse>();
            return;
        }

        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Data != null)
        {
            item = response.Data;
            SetLookups();
            fechaSolicitud = item.FechaSolicitud.ToDateTime(TimeOnly.MinValue);
            fechaAutorizacion = item.FechaAutorizacion?.ToDateTime(TimeOnly.MinValue);
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }
        if (contrato == null)
        {
            Snackbar.Add("Selecciona contrato.", Severity.Warning);
            return;
        }

        item.FkidContratoPres = contrato.Id;
        item.FechaSolicitud = DateOnly.FromDateTime(fechaSolicitud ?? DateTime.Today);
        item.FechaAutorizacion = fechaAutorizacion.HasValue ? DateOnly.FromDateTime(fechaAutorizacion.Value) : null;
        if (item.ImporteTotal <= 0 && detalleItems.Count > 0)
        {
            item.ImporteTotal = detalleItems.Sum(DetailTotal);
        }

        item.Detalles = detalleItems.Select(CloneDetail).ToList();
        item.Facturas = facturaItems.Where(x => x.MontoAplicado > 0).Select(CloneFactura).ToList();
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add(Id.HasValue ? "CLC actualizada correctamente." : "CLC, detalle y facturas guardados correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data ?? item));
            return;
        }

        Snackbar.Add(result?.Message ?? "No fue posible guardar la CLC.", Severity.Error);
    }

    private static CLCResponse CloneHeader(CLCResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidContratoPres = source.FkidContratoPres,
        FkidPolizaConta = source.FkidPolizaConta,
        NumClc = source.NumClc,
        FechaSolicitud = source.FechaSolicitud,
        FechaAutorizacion = source.FechaAutorizacion,
        ImporteTotal = source.ImporteTotal,
        Observaciones = source.Observaciones,
        Estatus = source.Estatus,
        Activo = source.Activo
    };

    private static CLCDetalleResponse CloneDetail(CLCDetalleResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidContratoDetallePres = source.FkidContratoDetallePres,
        FkidContratoPres = source.FkidContratoPres,
        NumeroContrato = source.NumeroContrato,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        PartidaClaveNombre = source.PartidaClaveNombre,
        Enero = source.Enero,
        Febrero = source.Febrero,
        Marzo = source.Marzo,
        Abril = source.Abril,
        Mayo = source.Mayo,
        Junio = source.Junio,
        Julio = source.Julio,
        Agosto = source.Agosto,
        Septiembre = source.Septiembre,
        Octubre = source.Octubre,
        Noviembre = source.Noviembre,
        Diciembre = source.Diciembre,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private static CLCFacturaResponse CloneFactura(CLCFacturaResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidFacturaPres = source.FkidFacturaPres,
        NumFactura = source.NumFactura,
        FkidFacturaDetallePres = source.FkidFacturaDetallePres,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        MontoAplicado = source.MontoAplicado,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal value) => $"${value.ToString("0.00", Culture)}";
    private static decimal DetailTotal(CLCDetalleResponse item) =>
        item.Total ?? item.Enero.GetValueOrDefault() + item.Febrero.GetValueOrDefault() +
        item.Marzo.GetValueOrDefault() + item.Abril.GetValueOrDefault() +
        item.Mayo.GetValueOrDefault() + item.Junio.GetValueOrDefault() +
        item.Julio.GetValueOrDefault() + item.Agosto.GetValueOrDefault() +
        item.Septiembre.GetValueOrDefault() + item.Octubre.GetValueOrDefault() +
        item.Noviembre.GetValueOrDefault() + item.Diciembre.GetValueOrDefault();
    private void SetLookups()
    {
        contrato = item.FkidContratoPres > 0 ? new LookupItem { Id = item.FkidContratoPres, Text = TextOrDash(item.NumeroContrato) } : null;
    }
    private async Task<ComboLookupResult> LoadContratosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ContratoService.GetAllPaginadoAsync(page, pageSize, filter, "NumeroContrato", SortDirection.Ascending, CompanyFilter());
        var list = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem { Id = x.PkidContrato, Text = $"{x.NumeroContrato} - {x.ProveedorNombre}" }).ToList() ?? new();
        return new ComboLookupResult { Items = list, TotalCount = response?.TotalCount ?? list.Count };
    }
    private Dictionary<string, object>? CompanyFilter() => item.FkidEmpresaSis > 0 ? new() { ["FkidEmpresaSis"] = item.FkidEmpresaSis } : null;
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? item.FkidEmpresaSis.ToString()
            : $"{SucursalStateService.EmpresaNombre} ({item.FkidEmpresaSis})"
        : "Sin empresa seleccionada";

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
