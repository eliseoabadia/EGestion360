@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<CLCFacturaResponse> Service
@inject IGenericCrudService<FacturaResponse> FacturaService
@inject IGenericCrudService<FacturaDetalleResponse> FacturaDetalleService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="CLCFacturaResponse" Title="@Title" MaxWidth="MaxWidth.Small" ActionText="@ActionText" ProcessingText="@ProcessingText" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="CLCFacturaResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title">
        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <CrudFormSection Title="Factura de origen">
                    <MudGrid Spacing="2">
<MudItem xs="12"><MudText Typo="Typo.subtitle2" Color="Color.Primary">@ClcNombre</MudText></MudItem>
            <MudItem xs="12" md="6"><MudTextField Margin="Margin.Dense" T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6">
                <RelatedRecordSelect TResponse="FacturaResponse"
                                     Label="Factura"
                                     SelectedId="@SelectedFacturaId"
                                     SelectedIdChanged="OnFacturaIdChanged"
                                     SelectedRecordChanged="OnFacturaSelected"
                                     SelectedText="@FacturaText"
                                     IdSelector="record => record.PkidFactura"
                                     TextSelector="FacturaLabel"
                                     SortProperty="NumFactura"
                                     AdditionalFilters="@FacturaFilters"
                                     Required="true"
                                     RequiredError="Selecciona una factura." />
            </MudItem>
            <MudItem xs="12" md="6">
                <RelatedRecordSelect @key="item.FkidFacturaPres"
                                     TResponse="FacturaDetalleResponse"
                                     Label="Detalle de la factura"
                                     SelectedId="@SelectedFacturaDetalleId"
                                     SelectedIdChanged="OnFacturaDetalleIdChanged"
                                     SelectedRecordChanged="OnFacturaDetalleSelected"
                                     SelectedText="@FacturaDetalleText"
                                     IdSelector="record => record.PkidFacturaDetalle"
                                     TextSelector="FacturaDetalleLabel"
                                     SortProperty="PartidaClave"
                                     AdditionalFilters="@FacturaDetalleFilters"
                                     Required="true"
                                     RequiredError="Selecciona el detalle de la factura."
                                     Disabled="@(item.FkidFacturaPres <= 0)" />
            </MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>

            <MudItem xs="12">
                <CrudFormSection Title="Aplicación">
                    <MudGrid Spacing="2">
<MudItem xs="12" md="6"><MudNumericField Margin="Margin.Dense" T="decimal" @bind-Value="item.MontoAplicado" Label="Monto aplicado" Required="true" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>
</MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int ClcId { get; set; }
    [Parameter] public string ClcNombre { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private BaseEntityForm<CLCFacturaResponse> form = null!;
    private CLCFacturaResponse item = new() { Activo = true };
    private string Title => Id.HasValue ? "Editar factura CLC" : "Nueva factura CLC";
    private string ActionText => Id.HasValue ? "Actualizar" : "Crear";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private int? SelectedFacturaId
    {
        get => item.FkidFacturaPres > 0 ? item.FkidFacturaPres : null;
        set => item.FkidFacturaPres = value.GetValueOrDefault();
    }
    private int? SelectedFacturaDetalleId
    {
        get => item.FkidFacturaDetallePres > 0 ? item.FkidFacturaDetallePres : null;
        set => item.FkidFacturaDetallePres = value.GetValueOrDefault();
    }
    private string FacturaText => string.IsNullOrWhiteSpace(item.NumFactura) ? string.Empty : item.NumFactura;
    private string FacturaDetalleText => string.Join(" - ", new[] { item.PartidaClave, item.PartidaDescripcion }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
    private Dictionary<string, object>? FacturaFilters => item.FkidEmpresaSis > 0
        ? new Dictionary<string, object> { ["FkidEmpresaSis"] = item.FkidEmpresaSis, ["Activo"] = true }
        : new Dictionary<string, object> { ["Activo"] = true };
    private Dictionary<string, object>? FacturaDetalleFilters => item.FkidFacturaPres > 0
        ? new Dictionary<string, object> { ["FkidFacturaPres"] = item.FkidFacturaPres, ["Activo"] = true }
        : null;

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        if (!Id.HasValue)
        {
            item.FkidClcPres = ClcId;
            return;
        }
        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Data != null)
        {
            item = response.Data;
            ClcId = item.FkidClcPres;
            ClcNombre = item.NumClc ?? ClcNombre;
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        if (item.FkidFacturaPres <= 0 || item.FkidFacturaDetallePres <= 0 || item.FkidPartidaConta <= 0)
        {
            Snackbar.Add("Selecciona la factura y un detalle asociado.", Severity.Warning);
            return;
        }

        item.FkidClcPres = ClcId;
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add("Factura CLC guardada correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Snackbar.Add(result?.Message ?? "No fue posible guardar la factura CLC.", Severity.Error);
    }
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? (string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre) ? "Empresa seleccionada" : SucursalStateService.EmpresaNombre)
        : "Sin empresa seleccionada";

    private Task OnFacturaIdChanged(int? value)
    {
        if (item.FkidFacturaPres != value.GetValueOrDefault())
        {
            item.FkidFacturaDetallePres = 0;
            item.FkidPartidaConta = 0;
            item.PartidaClave = null;
            item.PartidaDescripcion = null;
        }
        SelectedFacturaId = value;
        return Task.CompletedTask;
    }

    private Task OnFacturaSelected(FacturaResponse? record)
    {
        item.NumFactura = record?.NumFactura;
        return Task.CompletedTask;
    }

    private Task OnFacturaDetalleIdChanged(int? value)
    {
        SelectedFacturaDetalleId = value;
        return Task.CompletedTask;
    }

    private Task OnFacturaDetalleSelected(FacturaDetalleResponse? record)
    {
        if (record is null)
        {
            item.FkidPartidaConta = 0;
            item.PartidaClave = null;
            item.PartidaDescripcion = null;
            return Task.CompletedTask;
        }

        item.FkidPartidaConta = record.FkidPartidaConta;
        item.PartidaClave = record.PartidaClave;
        item.PartidaDescripcion = record.PartidaDescripcion;
        return Task.CompletedTask;
    }

    private static string FacturaLabel(FacturaResponse record)
    {
        var text = string.Join(" - ", new[] { record.NumFactura, record.NumeroContrato, record.ProveedorNombre }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "Factura sin descripción" : text;
    }

    private static string FacturaDetalleLabel(FacturaDetalleResponse record)
    {
        var text = string.Join(" - ", new[] { record.PartidaClave, record.PartidaDescripcion }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? record.NumFactura ?? "Detalle de factura" : text;
    }

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
