@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<CLCDetalleResponse> Service
@inject IGenericCrudService<CLCResponse> ClcHeaderService
@inject IGenericCrudService<ContratoDetalleResponse> ContratoDetalleService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="CLCDetalleResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="CLCDetalleResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title">
        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <CrudFormSection Title="Origen presupuestal">
                    <MudGrid Spacing="2">
<MudItem xs="12"><MudText Typo="Typo.subtitle2" Color="Color.Primary">@ClcNombre</MudText></MudItem>
            <MudItem xs="12" md="4"><MudTextField Margin="Margin.Dense" T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8">
                <RelatedRecordSelect TResponse="ContratoDetalleResponse"
                                     Label="Renglón del contrato"
                                     SelectedId="@SelectedContratoDetalleId"
                                     SelectedIdChanged="OnContratoDetalleIdChanged"
                                     SelectedRecordChanged="OnContratoDetalleSelected"
                                     SelectedText="@ContratoDetalleText"
                                     IdSelector="record => record.PkidContratoDetalle"
                                     TextSelector="ContratoDetalleLabel"
                                     SortProperty="PartidaClave"
                                     AdditionalFilters="@ContratoDetalleFilters"
                                     Required="true"
                                     RequiredError="Selecciona el renglón del contrato." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Margin="Margin.Dense" T="string" Value="@PartidaText" Label="Partida" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12"><CrudFormSection Title="Distribución mensual"><MudGrid Spacing="2">
@foreach (var month in MonthFields)
            {
                <MudItem xs="6" md="3">
                    <MudNumericField Margin="Margin.Dense" T="decimal?" Value="GetMonth(month.Key)" ValueChanged="v => SetMonth(month.Key, v)" Label="@month.Value" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" />
                </MudItem>
            }
</MudGrid></CrudFormSection></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>
</MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int ClcId { get; set; }
    [Parameter] public string ClcNombre { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly IReadOnlyList<KeyValuePair<int, string>> MonthFields =
    [
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    ];
    private BaseEntityForm<CLCDetalleResponse> form = null!;
    private CLCDetalleResponse item = new() { Activo = true };
    private string Title => Id.HasValue ? "Editar detalle CLC" : "Nuevo detalle CLC";
    private string ActionText => Id.HasValue ? "Actualizar" : "Crear";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        if (!Id.HasValue)
        {
            item.FkidClcPres = ClcId;
            var clc = await ClcHeaderService.GetByIdAsync(ClcId);
            if (clc?.Data != null)
            {
                item.FkidContratoPres = clc.Data.FkidContratoPres;
                item.NumeroContrato = clc.Data.NumeroContrato;
            }
            return;
        }
        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Data != null)
        {
            item = response.Data;
            ClcId = item.FkidClcPres;
            ClcNombre = item.NumClc ?? ClcNombre;
        }
    }

    private decimal? GetMonth(int month) => month switch { 1 => item.Enero, 2 => item.Febrero, 3 => item.Marzo, 4 => item.Abril, 5 => item.Mayo, 6 => item.Junio, 7 => item.Julio, 8 => item.Agosto, 9 => item.Septiembre, 10 => item.Octubre, 11 => item.Noviembre, _ => item.Diciembre };
    private void SetMonth(int month, decimal? value) { switch (month) { case 1: item.Enero = value; break; case 2: item.Febrero = value; break; case 3: item.Marzo = value; break; case 4: item.Abril = value; break; case 5: item.Mayo = value; break; case 6: item.Junio = value; break; case 7: item.Julio = value; break; case 8: item.Agosto = value; break; case 9: item.Septiembre = value; break; case 10: item.Octubre = value; break; case 11: item.Noviembre = value; break; default: item.Diciembre = value; break; } }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }
        item.FkidClcPres = ClcId;
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add("Detalle CLC guardado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Snackbar.Add(result?.Message ?? "No fue posible guardar el detalle.", Severity.Error);
    }
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? (string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre) ? "Empresa seleccionada" : SucursalStateService.EmpresaNombre)
        : "Sin empresa seleccionada";

    private int? SelectedContratoDetalleId
    {
        get => item.FkidContratoDetallePres > 0 ? item.FkidContratoDetallePres : null;
        set => item.FkidContratoDetallePres = value.GetValueOrDefault();
    }
    private string ContratoDetalleText => ContratoDetalleLabel(new ContratoDetalleResponse
    {
        NumeroContrato = item.NumeroContrato,
        PartidaClave = item.PartidaClave,
        PartidaClaveNombre = item.PartidaClaveNombre
    });
    private string PartidaText => string.IsNullOrWhiteSpace(item.PartidaClaveNombre)
        ? "La partida se toma del renglón seleccionado"
        : item.PartidaClaveNombre;
    private Dictionary<string, object>? ContratoDetalleFilters => item.FkidContratoPres > 0
        ? new Dictionary<string, object>
        {
            ["FkidContratoPres"] = item.FkidContratoPres,
            ["FkidEmpresaSis"] = item.FkidEmpresaSis,
            ["Activo"] = true
        }
        : null;

    private Task OnContratoDetalleIdChanged(int? value)
    {
        SelectedContratoDetalleId = value;
        return Task.CompletedTask;
    }

    private Task OnContratoDetalleSelected(ContratoDetalleResponse? record)
    {
        if (record is null)
        {
            item.FkidPartidaConta = 0;
            item.PartidaClave = null;
            item.PartidaDescripcion = null;
            item.PartidaClaveNombre = null;
            return Task.CompletedTask;
        }

        item.FkidContratoPres = record.FkidContratoPres;
        item.NumeroContrato = record.NumeroContrato;
        item.FkidPartidaConta = record.FkidPartidaConta;
        item.PartidaClave = record.PartidaClave;
        item.PartidaDescripcion = record.PartidaDescripcion;
        item.PartidaClaveNombre = record.PartidaClaveNombre;
        return Task.CompletedTask;
    }

    private static string ContratoDetalleLabel(ContratoDetalleResponse record)
    {
        var text = string.Join(" · ", new[] { record.NumeroContrato, record.PartidaClaveNombre ?? record.PartidaClave }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "Renglón de contrato" : text;
    }

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
