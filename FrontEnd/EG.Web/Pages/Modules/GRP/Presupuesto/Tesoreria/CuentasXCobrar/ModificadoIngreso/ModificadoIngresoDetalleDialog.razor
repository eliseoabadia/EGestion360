@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Models.PresupuestoModificado
@inject IGenericCrudService<IngreAdecuacionDetalleResponse> Service
@inject IGenericCrudService<IngresoDisponibleResponse> DisponibleService
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="IngreAdecuacionDetalleResponse" @ref="dialog" Title="@dialogTitle"
                ActionText="@actionText" ProcessingText="@processingText" CanConfirm="@CanSave" OnConfirm="SaveAsync">
    @if (load.Error != null)
    {
        <EditorLoadError Message="@load.Error" OnRetry="LoadAsync" />
    }
    else
    {
        <BaseEntityForm TEntity="IngreAdecuacionDetalleResponse" @ref="form" ShowHeader="false"
                        Loading="@load.IsLoading" LoadingMessage="Preparando movimiento..." LoadingSkeletonRows="10">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <CrudFormSection Title="Origen y movimiento">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <PagedAutocomplete Value="@_ingreso" ValueChanged="OnIngresoChanged"
                                                   Label="Ingreso autorizado disponible" Required="true"
                                                   RequiredError="Selecciona un ingreso autorizado." Margin="Margin.Dense"
                                                   Disabled="@saving" LoadPage="LoadIngresosPageAsync" />
                            </MudItem>
                            @if (availableLoad.IsLoading)
                            {
                                <MudItem xs="12"><MudProgressLinear Indeterminate="true" aria-label="Consultando disponibilidad" /></MudItem>
                            }
                            else if (availableLoad.Error != null)
                            {
                                <MudItem xs="12"><EditorLoadError Message="@availableLoad.Error" OnRetry="RetryAvailableAsync" /></MudItem>
                            }
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Date="@_fecha" DateChanged="value => _fecha = value" Label="Fecha"
                                               Margin="Margin.Dense" Variant="Variant.Outlined" Required="true"
                                               RequiredError="Captura una fecha válida." Clearable="true" Disabled="@saving"
                                               Validation="@(new Func<DateTime?, string?>(ValidateDate))"
                                               DateFormat="dd/MM/yyyy" Culture="@BudgetCaptureUi.DateCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Value="@TipoTexto" Label="Tipo de movimiento" Margin="Margin.Dense"
                                              Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="item.Justificacion" Label="Justificación del movimiento" Margin="Margin.Dense"
                                              Variant="Variant.Outlined" Lines="3" MaxLength="1000" Disabled="@saving" />
                            </MudItem>
                        </MudGrid>
                    </CrudFormSection>
                </MudItem>
                <MudItem xs="12">
                    <CrudFormSection Title="Distribución mensual">
                        <BudgetMonthlyGrid GetAmount="index => GetMonth(index)" OnAmountChanged="OnMonthChanged" Disabled="@saving" />
                    </CrudFormSection>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">Importe capturado</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary">@Money(CapturedTotal)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">Disponible seleccionado</MudText>
                                <MudText Typo="Typo.h6">@(availableLoad.IsReady ? Money(_selectedDisponible?.Total ?? 0m) : "Por consultar")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">Resultado estimado</MudText>
                                <MudText Typo="Typo.h6" Color="@(TipoMovimientoId == 3 ? Color.Success : Color.Warning)">
                                    @(availableLoad.IsReady ? Money(ResultadoEstimado) : "Por consultar")
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </BaseEntityForm>
    }
</BaseCrudDialog>
