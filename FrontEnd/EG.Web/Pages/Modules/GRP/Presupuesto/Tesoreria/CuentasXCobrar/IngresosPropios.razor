@page "/Presupuesto/Tesoreria/Cuentas_Cobrar/Ingresos_Devengados/Ingresos_Propios"
@using System.Globalization
@using EG.Common.GenericModel
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@inherits BaseCrudPage<IngreXEjerResponse, IngreXEjerResponse>
@implements IDisposable

@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column otros-ingresos-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Ingresos Propios"
                    Subtitle="Consulta del ingreso por ejercer por area funcional y origen"
                    Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    ShowCreateButton="false"
                    OnRefresh="ReloadData" />

        <section class="otros-ingresos-summary">
            <div><span>Total visible</span><strong>@Money(Elements.Sum(x => x.Total ?? 0m))</strong></div>
            <div><span>Registros</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
            <div><span>Anio presupuestal</span><strong>@BudgetYear</strong></div>
            <div><span>Moneda base</span><strong>@_currencyName (@_currencySymbol)</strong></div>
        </section>

        <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericDataGrid TItem="IngreXEjerResponse"
                          @ref="table"
                          Title="Ingresos propios"
                          SearchPlaceholder="Buscar area funcional, origen o descripcion..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="value => SearchString = value"
                          OnSearch="OnSearch"
                          >
                <Columns>
                    <PropertyColumn T="IngreXEjerResponse" TProperty="int" Property="x => x.PkIdIngresoAutorizado" Title="ID" Identifier="PkIdIngresoAutorizado" />
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Área funcional" Identifier="AreaFuncional"><CellTemplate><div class="main-cell">@TextOrDash(context.Item.AreaFuncional)</div><span>Programa @context.Item.FkIdProgramaPres</span></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Origen" Identifier="Origen"><CellTemplate><div class="main-cell">@TextOrDash(context.Item.Origen)</div><span>Origen @context.Item.FkIdOrigenPres</span></CellTemplate></TemplateColumn>
                    <PropertyColumn T="IngreXEjerResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Vista anual" Sortable="false"><CellTemplate><div class="month-spark">@foreach (var month in GetMonths(context.Item)) { <span title="@($"{month.Label}: {Money(month.Amount)}")" style="height:@GetMonthHeight(month.Amount, context.Item.Total ?? 0m)%"></span> }</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Ene" Identifier="Ene"><CellTemplate>@Money(context.Item.Ene ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Feb" Identifier="Feb"><CellTemplate>@Money(context.Item.Feb ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Mar" Identifier="Mar"><CellTemplate>@Money(context.Item.Mar ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Abr" Identifier="Abr"><CellTemplate>@Money(context.Item.Abr ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="May" Identifier="May"><CellTemplate>@Money(context.Item.May ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Jun" Identifier="Jun"><CellTemplate>@Money(context.Item.Jun ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Jul" Identifier="Jul"><CellTemplate>@Money(context.Item.Jul ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Ago" Identifier="Ago"><CellTemplate>@Money(context.Item.Ago ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Sep" Identifier="Sep"><CellTemplate>@Money(context.Item.Sep ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Oct" Identifier="Oct"><CellTemplate>@Money(context.Item.Oct ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Nov" Identifier="Nov"><CellTemplate>@Money(context.Item.Nov ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Dic" Identifier="Dic"><CellTemplate>@Money(context.Item.Dic ?? 0m)</CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="IngreXEjerResponse" Title="Total" Identifier="Total"><CellTemplate><strong>@Money(context.Item.Total ?? 0m)</strong></CellTemplate></TemplateColumn>
                </Columns>
            </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .otros-ingresos-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 8px 0 12px; }
    .otros-ingresos-summary > div { border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; padding: 9px 11px; background: var(--mud-palette-surface); }
    .otros-ingresos-summary span { display: block; color: var(--mud-palette-text-secondary); font-size: .72rem; text-transform: uppercase; }
    .otros-ingresos-summary strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.02rem; }
    .otros-ingresos-page .main-cell { font-weight: 700; line-height: 1.15; }
    .otros-ingresos-page td span { color: var(--mud-palette-text-secondary); font-size: .78rem; }
    .month-spark { display: grid; grid-template-columns: repeat(12, 6px); align-items: end; gap: 3px; height: 32px; min-width: 105px; }
    .month-spark span { display: block; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--eg-primary); }
    .text-right { text-align: right; }
    @@media (max-width: 900px) { .otros-ingresos-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 560px) { .otros-ingresos-summary { grid-template-columns: 1fr; } }
</style>

@code {
    private GenericDataGrid<IngreXEjerResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override string ModuleName => "Ingresos_Devengados";
    protected override string SubModuleName => "Ingresos";
    protected override Type CreateDialogType => typeof(IngresosPropios);
    protected override Type EditDialogType => typeof(IngresosPropios);
    protected override Type DeleteDialogType => typeof(IngresosPropios);
    protected override string GetDefaultSortLabel() => "PkIdIngresoAutorizado";
    private string BudgetYear => AnioStateService.AnioClave?.ToString() ?? AnioStateService.AnioId?.ToString() ?? "-";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<IngreXEjerResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!AnioStateService.AnioId.HasValue)
                return new TableData<IngreXEjerResponse>();

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                new Dictionary<string, object> { ["FkIdAnioSis"] = AnioStateService.AnioId.Value });

            Elements = response?.Success == true ? response.Items?.ToList() ?? [] : [];
            TotalCount = response?.Success == true ? response.TotalCount : 0;

            if (response?.Success == false && !string.IsNullOrWhiteSpace(response.Message))
                Snackbar.Add(response.Message, Severity.Error);

            return new TableData<IngreXEjerResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    protected override async Task<List<IngreXEjerResponse>> LoadExportItemsAsync()
    {
        if (!AnioStateService.AnioId.HasValue)
            return [];

        var items = new List<IngreXEjerResponse>();
        var page = 1;
        var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
        var filters = new Dictionary<string, object> { ["FkIdAnioSis"] = AnioStateService.AnioId.Value };

        while (items.Count < MaxExportRows)
        {
            var response = await Service.GetAllPaginadoAsync(page, ExportPageSize, SearchString, sortLabel, SortDirection, filters);
            if (response?.Success != true)
                throw new InvalidOperationException(response?.Message ?? "No fue posible obtener los datos para exportar.");

            var pageItems = response.Items?.ToList() ?? [];
            if (pageItems.Count == 0)
                break;

            items.AddRange(pageItems);
            if (items.Count >= response.TotalCount || pageItems.Count < ExportPageSize)
                break;

            page++;
        }

        return items;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<IngreXEjerResponse> items) => items.Select(x => new
    {
        ID = x.PkIdIngresoAutorizado,
        Anio = x.FkIdAnioSis,
        Programa = x.FkIdProgramaPres,
        OrigenId = x.FkIdOrigenPres,
        x.AreaFuncional,
        x.Origen,
        x.Descripcion,
        Enero = x.Ene,
        Febrero = x.Feb,
        Marzo = x.Mar,
        Abril = x.Abr,
        Mayo = x.May,
        Junio = x.Jun,
        Julio = x.Jul,
        Agosto = x.Ago,
        Septiembre = x.Sep,
        Octubre = x.Oct,
        Noviembre = x.Nov,
        Diciembre = x.Dic,
        x.Total
    });

    protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;
    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);
    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static int GetMonthHeight(decimal amount, decimal total) => amount <= 0 || total <= 0 ? 10 : Math.Clamp((int)Math.Round(amount / total * 300m), 12, 100);

    private static IEnumerable<(string Label, decimal Amount)> GetMonths(IngreXEjerResponse item)
    {
        yield return ("Ene", item.Ene ?? 0m); yield return ("Feb", item.Feb ?? 0m); yield return ("Mar", item.Mar ?? 0m);
        yield return ("Abr", item.Abr ?? 0m); yield return ("May", item.May ?? 0m); yield return ("Jun", item.Jun ?? 0m);
        yield return ("Jul", item.Jul ?? 0m); yield return ("Ago", item.Ago ?? 0m); yield return ("Sep", item.Sep ?? 0m);
        yield return ("Oct", item.Oct ?? 0m); yield return ("Nov", item.Nov ?? 0m); yield return ("Dic", item.Dic ?? 0m);
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdText = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdText, out var userId))
                return;

            var response = await UsuarioService.GetByIdAsync(userId);
            if (response?.Success != true || response.Data == null)
                return;

            _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
            _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("IngresosPropios")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para ingresos propios.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }

    public void Dispose() => AnioStateService.OnAnioChanged -= OnAnioChanged;
}
