@using System.Globalization
@using System.Net.Http.Json
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<IngresoAutorizadoResponse> Service
@inject AnioPresupuestalStateService AnioStateService
@inject HttpClient Http
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="IngresoAutorizadoResponse"
                Title="@DialogTitle"
                MaxWidth="MaxWidth.ExtraExtraLarge"
                ActionColor="@ActionColor"
                ActionIcon="@ActionIcon"
                ActionText="@ActionText"
                ProcessingText="@ProcessingText"
                LoadingMessage="Cargando ingreso estimado..."
                CanConfirm="@(!item.EstaAutorizado)"
                OnConfirm="GuardarAsync">
    <BaseEntityForm TEntity="IngresoAutorizadoResponse" @ref="form" ShowHeader="false">
        <MudGrid GutterSize="1" Class="ingreso-dialog">
            <MudItem xs="12">
                <div class="income-ribbon">
                    <div>
                        <span>Anio presupuestal</span>
                        <strong>@BudgetYear</strong>
                    </div>
                    <div>
                        <span>Total @CurrencyName</span>
                        <strong>@Money(TotalMeses)</strong>
                    </div>
                    <div>
                        <span>Poliza presupuestal</span>
                        <strong>@PolicyStatus</strong>
                    </div>
                </div>
            </MudItem>

            @if (item.EstaAutorizado)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Este ingreso fue autorizado y se conserva en modo de consulta.
                    </MudAlert>
                </MudItem>
            }
            else if (IsAuthorizationFlow)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined"
                              Icon="@Icons.Material.Filled.VerifiedUser">
                        Revisa la distribución mensual y la póliza presupuestal. Al autorizar, el ingreso y su póliza quedarán bloqueados para edición.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <PagedAutocomplete Value="@_programa"
                                   ValueChanged="value => _programa = value"
                                   Label="Programa / area funcional"
                                   Required="true"
                                   RequiredError="El programa es requerido"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadProgramasAsync" />
            </MudItem>
            <MudItem xs="12" md="3">
                <PagedAutocomplete Value="@_origen"
                                   ValueChanged="value => _origen = value"
                                   Label="Origen"
                                   Required="true"
                                   RequiredError="El origen es requerido"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadOrigenesAsync" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Date="@_fecha"
                               DateChanged="value => _fecha = value"
                               Label="Fecha"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Culture="@DateCulture"
                               Required="true"
                               RequiredError="La fecha es requerida"
                               Disabled="@FieldsLocked" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripcion"
                              Variant="Variant.Outlined"
                              Lines="2"
                              MaxLength="500"
                              Counter="500"
                              Required="true"
                              RequiredError="La descripcion es requerida"
                              Disabled="@FieldsLocked" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <PagedAutocomplete Value="@_fuente"
                                   ValueChanged="value => _fuente = value"
                                   Label="Fuente de financiamiento"
                                   Clearable="true"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadFuentesAsync" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <PagedAutocomplete Value="@_tipoGasto"
                                   ValueChanged="value => _tipoGasto = value"
                                   Label="Tipo de gasto"
                                   Clearable="true"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadTiposGastoAsync" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <PagedAutocomplete Value="@_digito"
                                   ValueChanged="value => _digito = value"
                                   Label="Digito identificador"
                                   Clearable="true"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadDigitosAsync" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <PagedAutocomplete Value="@_destino"
                                   ValueChanged="value => _destino = value"
                                   Label="Destino de gasto"
                                   Clearable="true"
                                   Disabled="@FieldsLocked"
                                   LoadPage="LoadDestinosAsync" />
            </MudItem>

            <MudItem xs="12">
                <section class="months-panel">
                    <div class="months-header">
                        <div>
                            <MudText Typo="Typo.subtitle1">Distribucion mensual</MudText>
                            <MudText Typo="Typo.caption">Los importes se capturan con punto decimal y la poliza se actualiza con el total.</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@Money(TotalMeses)</MudChip>
                    </div>
                    <MudGrid GutterSize="1">
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Enero" Label="Enero" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Febrero" Label="Febrero" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Marzo" Label="Marzo" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Abril" Label="Abril" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Mayo" Label="Mayo" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Junio" Label="Junio" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Julio" Label="Julio" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Agosto" Label="Agosto" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Septiembre" Label="Septiembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Octubre" Label="Octubre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Noviembre" Label="Noviembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Diciembre" Label="Diciembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@FieldsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                    </MudGrid>
                </section>
            </MudItem>

            @if (Id.HasValue)
            {
                <MudItem xs="12">
                    <div class="audit-strip">
                        <span>Creado: <strong>@Audit(item.UsuarioCreacion, item.FechaCreacion)</strong></span>
                        <span>Modificado: <strong>@Audit(item.UsuarioModificacion, item.FechaModificacion)</strong></span>
                        <span>Autorizado: <strong>@Audit(item.UsuarioAutorizacion, item.FechaAutorizacion)</strong></span>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

<style>
    .ingreso-dialog .income-ribbon { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .ingreso-dialog .income-ribbon > div { border: 1px solid color-mix(in srgb, var(--eg-primary) 36%, var(--mud-palette-lines-default)); border-radius: 8px; padding: 8px 10px; background: color-mix(in srgb, var(--eg-primary) 7%, var(--mud-palette-surface)); }
    .ingreso-dialog .income-ribbon span { display: block; color: var(--mud-palette-text-secondary); font-size: .72rem; text-transform: uppercase; }
    .ingreso-dialog .income-ribbon strong { font-size: 1.04rem; }
    .ingreso-dialog .months-panel { display: block; border: 1px solid color-mix(in srgb, var(--eg-primary) 28%, var(--mud-palette-lines-default)); border-radius: 8px; padding: 10px; background: color-mix(in srgb, var(--eg-primary) 7%, var(--mud-palette-surface)); }
    .ingreso-dialog .months-header { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px; }
    .ingreso-dialog .audit-strip { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 1px solid var(--mud-palette-lines-default); padding-top: 9px; color: var(--mud-palette-text-secondary); font-size: .78rem; }
    @@media (max-width: 760px) { .ingreso-dialog .income-ribbon { grid-template-columns: 1fr; } .ingreso-dialog .months-header { align-items: flex-start; flex-direction: column; } }
</style>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int AnioId { get; set; }
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public string CurrencyName { get; set; } = "Peso Mexicano";
    [Parameter] public bool IsAuthorizationFlow { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<IngresoAutorizadoResponse> form = null!;
    private IngresoAutorizadoResponse item = new() { Activo = true, Fecha = DateOnly.FromDateTime(DateTime.Today) };
    private DateTime? _fecha = DateTime.Today;
    private LookupItem? _programa;
    private LookupItem? _origen;
    private LookupItem? _fuente;
    private LookupItem? _tipoGasto;
    private LookupItem? _digito;
    private LookupItem? _destino;
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    private bool FieldsLocked => item.EstaAutorizado || IsAuthorizationFlow;
    private string DialogTitle => item.EstaAutorizado
        ? "Consultar ingreso autorizado"
        : IsAuthorizationFlow
            ? "Autorizar ingreso estimado"
            : Id.HasValue ? "Editar ingreso estimado" : "Nuevo ingreso estimado";
    private Color ActionColor => IsAuthorizationFlow ? Color.Success : Color.Primary;
    private string ActionIcon => IsAuthorizationFlow ? Icons.Material.Filled.Verified : Icons.Material.Filled.Save;
    private string ActionText => IsAuthorizationFlow ? "Autorizar ingreso" : Id.HasValue ? "Actualizar" : "Crear ingreso";
    private string ProcessingText => IsAuthorizationFlow ? "Autorizando..." : Id.HasValue ? "Actualizando..." : "Creando...";
    private string BudgetYear => AnioStateService.AnioClave?.ToString() ?? AnioId.ToString();
    private string PolicyStatus => item.FkidPolizaConta.HasValue ? $"#{item.FkidPolizaConta}" : "Se genera al guardar";
    private decimal TotalMeses => item.Enero + item.Febrero + item.Marzo + item.Abril + item.Mayo + item.Junio + item.Julio + item.Agosto + item.Septiembre + item.Octubre + item.Noviembre + item.Diciembre;

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();
        if (Id.HasValue) await LoadItemAsync();
    }

    private async Task LoadItemAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success != true || response.Data == null)
            {
                Snackbar.Add(response?.Message ?? "No fue posible cargar el ingreso.", Severity.Error);
                return;
            }

            item = response.Data;
            _fecha = item.Fecha.ToDateTime(TimeOnly.MinValue);
            _programa = RequiredLookup(item.FkidProgramaPres, item.ProgramaClaveNombre);
            _origen = RequiredLookup(item.FkidOrigenPres, item.OrigenClaveNombre);
            _fuente = OptionalLookup(item.FkidFuenteFinanciamientoPres, item.FuenteFinanciamientoClaveNombre);
            _tipoGasto = OptionalLookup(item.FkidTipoGastoPres, item.TipoGastoClaveNombre);
            _digito = OptionalLookup(item.FkidDigitoIdentificadorPres, item.DigitoIdentificadorClaveNombre);
            _destino = OptionalLookup(item.FkidDestinoGastoPres, item.DestinoGastoClaveNombre);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el ingreso: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarAsync()
    {
        if (item.EstaAutorizado) return;
        if (IsAuthorizationFlow)
        {
            await AutorizarAsync();
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }
        if (_programa == null || _origen == null || !_fecha.HasValue)
        {
            Snackbar.Add("Selecciona programa, origen y fecha.", Severity.Warning);
            return;
        }
        if (TotalMeses <= 0m)
        {
            Snackbar.Add("El total mensual debe ser mayor que cero.", Severity.Warning);
            return;
        }

        item.FkidProgramaPres = _programa.Id;
        item.FkidOrigenPres = _origen.Id;
        item.FkidFuenteFinanciamientoPres = _fuente?.Id;
        item.FkidTipoGastoPres = _tipoGasto?.Id;
        item.FkidDigitoIdentificadorPres = _digito?.Id;
        item.FkidDestinoGastoPres = _destino?.Id;
        item.FkidAnioSis = AnioId > 0 ? AnioId : AnioStateService.AnioId;
        item.Fecha = DateOnly.FromDateTime(_fecha.Value);
        item.Total = TotalMeses;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);
            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? "Ingreso guardado correctamente.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }
            Snackbar.Add(response?.Message ?? "No fue posible guardar el ingreso.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private async Task AutorizarAsync()
    {
        if (!Id.HasValue)
        {
            Snackbar.Add("No se encontró el ingreso que se desea autorizar.", Severity.Error);
            return;
        }

        try
        {
            var response = await Http.PostAsync($"api/IngresoAutorizado/{Id.Value}/autorizar", null);
            var result = await response.Content.ReadFromJsonAsync<EG.Common.GenericModel.PagedResult<IngresoAutorizadoResponse>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add(result.Message ?? "Ingreso autorizado correctamente.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(result?.Message ?? "No fue posible autorizar el ingreso.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al autorizar el ingreso: {ex.Message}", Severity.Error);
        }
    }

    private Task<ComboLookupResult> LoadProgramasAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetProgramaLookupPaginado", page, size, filter, ct, $"&idAnio={AnioId}");
    private Task<ComboLookupResult> LoadOrigenesAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetOrigenLookupPaginado", page, size, filter, ct);
    private Task<ComboLookupResult> LoadFuentesAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetFuenteFinanciamientoLookupPaginado", page, size, filter, ct);
    private Task<ComboLookupResult> LoadTiposGastoAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetTipoGastoLookupPaginado", page, size, filter, ct);
    private Task<ComboLookupResult> LoadDigitosAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetDigitoIdentificadorLookupPaginado", page, size, filter, ct);
    private Task<ComboLookupResult> LoadDestinosAsync(int page, int size, string filter, CancellationToken ct)
        => LoadLookupAsync("GetDestinoGastoLookupPaginado", page, size, filter, ct);

    private async Task<ComboLookupResult> LoadLookupAsync(string endpoint, int page, int size, string filter, CancellationToken ct, string suffix = "")
    {
        var url = $"api/IngresoAutorizado/{endpoint}?page={page}&pageSize={size}&filter={Uri.EscapeDataString(filter ?? string.Empty)}{suffix}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(url, ct) ?? new ComboLookupResult();
    }

    private string Money(decimal value) => $"{CurrencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static LookupItem RequiredLookup(int id, string? text) => new() { Id = id, Text = string.IsNullOrWhiteSpace(text) ? id.ToString() : text };
    private static LookupItem? OptionalLookup(int? id, string? text) => id.HasValue ? RequiredLookup(id.Value, text) : null;
    private static string Audit(int? userId, DateTime? date) => !date.HasValue ? "-" : $"usuario {userId?.ToString() ?? "-"}, {date:dd/MM/yyyy HH:mm}";
}
