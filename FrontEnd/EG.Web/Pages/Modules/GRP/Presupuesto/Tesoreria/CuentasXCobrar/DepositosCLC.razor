@page "/Presupuesto/Tesoreria/Cuentas_Cobrar/Depositos_CLC"
@page "/Tesoreria/Cuentas_Cobrar/Depositos_CLC"
@using System.Globalization
@using EG.Common.GenericModel
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Domain.DTOs.Responses.General
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@inherits BaseCrudPage<DepositoResponse, DepositoResponse>
@implements IDisposable

@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column depositos-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Depositos CLC"
                    Subtitle="Registro, poliza y autorizacion de depositos"
                    Icon="@Icons.Material.Filled.Payments"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="ReloadData" />

        <section class="depositos-summary">
            <div><span>Total visible</span><strong>@Money(Elements.Sum(x => x.Total ?? x.Importe))</strong></div>
            <div><span>Registros</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
            <div><span>Pendientes visibles</span><strong>@Elements.Count(x => !x.EstaAutorizado).ToString("N0", NumberCulture)</strong></div>
            <div><span>Moneda base</span><strong>@_currencyName (@_currencySymbol)</strong></div>
        </section>

        <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericTable TItem="DepositoResponse"
                          @ref="table"
                          Title="Depositos CLC"
                          SearchPlaceholder="Buscar referencia, aportante, programa, origen o poliza..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="value => SearchString = value"
                          OnSearch="OnSearch"
                          Loading="@Loading">
                <Header>
                    <MudTh>Acciones</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FechaEmision" T="DepositoResponse">Fecha</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="NumeroReferencia" T="DepositoResponse">Referencia</MudTableSortLabel></MudTh>
                    <MudTh>Ingreso</MudTh>
                    <MudTh>Aportante</MudTh>
                    <MudTh>Cuenta cargo</MudTh>
                    <MudTh>Cuenta abono</MudTh>
                    <MudTh>Meses</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Importe" T="DepositoResponse">Importe</MudTableSortLabel></MudTh>
                    <MudTh>Poliza</MudTh>
                    <MudTh>Estatus</MudTh>
                </Header>
                <Row Context="item">
                    <MudTd Class="depositos-actions">
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Visible="@(CanUpdate && !item.EstaAutorizado)"
                                           Disabled="@IsBusy"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditItem(item.PkidDeposito))" />
                        </MudTooltip>
                        <MudTooltip Text="Autorizar deposito y poliza">
                            <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                           Visible="@(CanAuthorize && !item.EstaAutorizado)"
                                           Disabled="@IsBusy"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           OnClick="@(() => AutorizarAsync(item))" />
                        </MudTooltip>
                        <MudTooltip Text="Ver poliza">
                            <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                                           Disabled="@(item.FkidPolizaConta <= 0 || IsBusy)"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenPolizaAsync(item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="CuentasXCobrar"
                                               SubModulo="Depositos_CLC"
                                               Controlador="Deposito"
                                               EntidadId="@item.PkidDeposito"
                                               RegistroTitulo="@TextOrDash(item.NumeroReferencia)"
                                               RegistroDescripcion="@TextOrDash(item.ConceptoCheque)" />
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Visible="@(CanDelete && !item.EstaAutorizado)"
                                           Disabled="@IsBusy"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteDepositoAsync(item))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd>@item.FechaEmision.ToString("dd/MM/yyyy", DateCulture)</MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.NumeroReferencia)</div>
                        <span>@TextOrDash(item.TipoDoctoPagoDescripcion)</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.ProgramaClave)</div>
                        <span>@TextOrDash(item.IngresoAutorizadoDescripcion)</span>
                    </MudTd>
                    <MudTd>@TextOrDash(item.NombreAportante)</MudTd>
                    <MudTd><strong>@TextOrDash(item.CuentaCargoClave)</strong><br /><span>@TextOrDash(item.CuentaCargoDescripcion)</span></MudTd>
                    <MudTd><strong>@TextOrDash(item.CuentaAbonoClave)</strong><br /><span>@TextOrDash(item.CuentaAbonoDescripcion)</span></MudTd>
                    <MudTd>
                        <div class="month-spark">
                            @foreach (var month in GetMonths(item))
                            {
                                <span title="@($"{month.Label}: {Money(month.Amount)}")"
                                      style="height:@GetMonthHeight(month.Amount, item.Total ?? item.Importe)%"></span>
                            }
                        </div>
                    </MudTd>
                    <MudTd><strong>@Money(item.Total ?? item.Importe)</strong></MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   Disabled="@(item.FkidPolizaConta <= 0)"
                                   OnClick="@(() => OpenPolizaAsync(item))">
                            @TextOrDash(item.ClavePoliza ?? item.FkidPolizaConta.ToString())
                        </MudButton>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(item.EstaAutorizado ? Color.Success : Color.Warning)">
                            @(item.EstaAutorizado ? "Autorizado" : "Pendiente")
                        </MudChip>
                    </MudTd>
                </Row>
            </GenericTable>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .depositos-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 8px 0 12px; }
    .depositos-summary > div { border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; padding: 9px 11px; background: var(--mud-palette-surface); }
    .depositos-summary span { display: block; color: var(--mud-palette-text-secondary); font-size: .72rem; text-transform: uppercase; }
    .depositos-summary strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.02rem; }
    .depositos-actions { min-width: 190px; white-space: nowrap; }
    .depositos-page .main-cell { font-weight: 700; line-height: 1.15; }
    .depositos-page td span { color: var(--mud-palette-text-secondary); font-size: .78rem; }
    .month-spark { display: grid; grid-template-columns: repeat(12, 6px); align-items: end; gap: 3px; height: 32px; min-width: 105px; }
    .month-spark span { display: block; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--eg-primary); }
    @@media (max-width: 900px) { .depositos-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 560px) { .depositos-summary { grid-template-columns: 1fr; } }
</style>

@code {
    private GenericTable<DepositoResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    protected override string ModuleName => "CuentasXCobrar";
    protected override string SubModuleName => "Depositos_CLC";
    protected override Type CreateDialogType => typeof(DepositoDialog);
    protected override Type EditDialogType => typeof(DepositoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<DepositoResponse>);
    protected override string GetDefaultSortLabel() => "PkidDeposito";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<DepositoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection);
            Elements = response?.Success == true ? response.Items?.ToList() ?? [] : [];
            TotalCount = response?.Success == true ? response.TotalCount : 0;
            if (response?.Success == false && !string.IsNullOrWhiteSpace(response.Message))
                Snackbar.Add(response.Message, Severity.Error);

            return new TableData<DepositoResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("Verifica tus permisos para crear depositos.", Severity.Warning);
            return;
        }
        if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
        {
            Snackbar.Add("Selecciona un anio presupuestal.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync(CreateDialogType, "Nuevo deposito CLC", DialogParameters(null),
            new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await ReloadData();
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate) return;
        var dialog = await DialogService.ShowAsync(EditDialogType, "Editar deposito CLC", DialogParameters(id),
            new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await ReloadData();
    }

    private DialogParameters DialogParameters(int? id) => new()
    {
        ["Id"] = id,
        ["AnioId"] = AnioStateService.AnioId ?? 0,
        ["CurrencySymbol"] = _currencySymbol,
        ["CurrencyName"] = _currencyName
    };

    private async Task AutorizarAsync(DepositoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
            if (!CanAuthorize || item.EstaAutorizado) return;

            if (!await ConfirmWorkflowAsync(
                    "Autorizar deposito CLC",
                    $"¿Seguro que deseas autorizar el depósito {TextOrDash(item.NumeroReferencia)}? Se bloqueará para cambios posteriores.",
                    "Autorizar",
                    Severity.Success,
                    item.PkidDeposito))
            {
                return;
            }

            var parameters = DialogParameters(item.PkidDeposito);
            parameters["IsAuthorizationFlow"] = true;

            var dialog = await DialogService.ShowAsync<DepositoDialog>(
                "Autorizar deposito CLC",
                parameters,
                new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraExtraLarge,
                    FullWidth = true,
                    CloseButton = false,
                    CloseOnEscapeKey = false
                });

            if ((await dialog.Result) is { Canceled: false })
                await ReloadData();
        });
    }

    private async Task DeleteDepositoAsync(DepositoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
            var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar el deposito '{TextOrDash(item.NumeroReferencia)}'?");
            if (!confirm) return;
            var response = await Service.DeleteAsync(item.PkidDeposito);
            Snackbar.Add(response?.Message ?? "No fue posible eliminar.", response?.Success == true ? Severity.Success : Severity.Error);
            if (response?.Success == true) await ReloadData();
        });
    }

    private async Task OpenPolizaAsync(DepositoResponse item)
    {
        if (item.FkidPolizaConta <= 0) return;
        var parameters = new DialogParameters
        {
            ["DepositoId"] = item.PkidDeposito,
            ["CurrencySymbol"] = _currencySymbol
        };
        var dialog = await DialogService.ShowAsync<DepositoPolizaDialog>("Poliza del deposito", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true });
        await dialog.Result;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<DepositoResponse> items) => items.Select(x => new
    {
        ID = x.PkidDeposito,
        Referencia = x.NumeroReferencia,
        Fecha = x.FechaEmision.ToString("dd/MM/yyyy", DateCulture),
        Aportante = x.NombreAportante,
        Ingreso = x.IngresoAutorizadoDescripcion,
        Programa = x.ProgramaClaveNombre,
        Origen = x.OrigenClaveNombre,
        TipoDocumento = x.TipoDoctoPagoDescripcion,
        CuentaCargo = x.CuentaCargoClave,
        CuentaAbono = x.CuentaAbonoClave,
        x.Enero, x.Febrero, x.Marzo, x.Abril, x.Mayo, x.Junio,
        x.Julio, x.Agosto, x.Septiembre, x.Octubre, x.Noviembre, x.Diciembre,
        x.Total,
        Poliza = x.ClavePoliza,
        Autorizado = x.EstaAutorizado,
        x.FechaCreacion,
        x.UsuarioCreacion,
        x.FechaModificacion,
        x.UsuarioModificacion
    });

    protected override Task<string> GetItemNameForDelete(int id)
        => Task.FromResult(Elements.FirstOrDefault(x => x.PkidDeposito == id)?.NumeroReferencia ?? "el deposito");

    protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;
    private async void OnAnioChanged(int? anioId)
    {
        await InvokeAsync(async () =>
        {
            await ReloadData();
            StateHasChanged();
        });
    }

    public void Dispose() => AnioStateService.OnAnioChanged -= OnAnioChanged;

    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static int GetMonthHeight(decimal amount, decimal total) => amount <= 0 || total <= 0 ? 10 : Math.Clamp((int)Math.Round(amount / total * 300m), 12, 100);

    private static IEnumerable<(string Label, decimal Amount)> GetMonths(DepositoResponse item)
    {
        yield return ("Ene", item.Enero); yield return ("Feb", item.Febrero); yield return ("Mar", item.Marzo);
        yield return ("Abr", item.Abril); yield return ("May", item.Mayo); yield return ("Jun", item.Junio);
        yield return ("Jul", item.Julio); yield return ("Ago", item.Agosto); yield return ("Sep", item.Septiembre);
        yield return ("Oct", item.Octubre); yield return ("Nov", item.Noviembre); yield return ("Dic", item.Diciembre);
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdText = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdText, out var userId)) return;
            var response = await UsuarioService.GetByIdAsync(userId);
            if (response?.Success != true || response.Data == null) return;
            _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
            _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
        }
        catch { }
    }
}
