@page "/Presupuesto/Tesoreria/Cuentas_Cobrar/Ingresos_Devengados/Ingresos"
@using System.Globalization
@using EG.Common.GenericModel
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@inherits BaseCrudPage<IngresoCLCFacturaResponse, IngresoCLCFacturaResponse>
@implements IDisposable

@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column ingresos-clc-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Ingresos (CLCs)"
                    Subtitle="Consulta de CLCs de ingreso, poliza, documento y calendario mensual"
                    Icon="@Icons.Material.Filled.Scale"
                    ShowCreateButton="false"
                    OnRefresh="ReloadData" />

        <section class="ingresos-clc-summary">
            <div><span>Total visible</span><strong>@Money(Elements.Sum(GetAmount))</strong></div>
            <div><span>Registros</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
            <div><span>Anio presupuestal</span><strong>@BudgetYear</strong></div>
            <div><span>Polizas visibles</span><strong>@Elements.Where(x => x.FkIdPolizaConta.HasValue).Select(x => x.FkIdPolizaConta).Distinct().Count().ToString("N0", NumberCulture)</strong></div>
        </section>

        <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericTable TItem="IngresoCLCFacturaResponse"
                          @ref="table"
                          Title="Ingresos (CLCs)"
                          SearchPlaceholder="Buscar CLC, factura, referencia, concepto o RFC..."
                          ShowExportButton="@CanExport"
                          ShowAddButton="false"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="value => SearchString = value"
                          OnSearch="OnSearch"
                          Loading="@Loading">
                <Header>
                    <MudTh><MudTableSortLabel SortLabel="PkidClcfactura" T="IngresoCLCFacturaResponse">Num CLC</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FkIdIngresoAutorizado" T="IngresoCLCFacturaResponse">Origen</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="NumFactura" T="IngresoCLCFacturaResponse">Documento</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Fecha" T="IngresoCLCFacturaResponse">Fecha</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FkIdPolizaConta" T="IngresoCLCFacturaResponse">Poliza</MudTableSortLabel></MudTh>
                    <MudTh>Concepto</MudTh>
                    <MudTh>Meses</MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Ene" T="IngresoCLCFacturaResponse">Ene</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Feb" T="IngresoCLCFacturaResponse">Feb</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Mar" T="IngresoCLCFacturaResponse">Mar</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Abr" T="IngresoCLCFacturaResponse">Abr</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="May" T="IngresoCLCFacturaResponse">May</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Jun" T="IngresoCLCFacturaResponse">Jun</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Jul" T="IngresoCLCFacturaResponse">Jul</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Ago" T="IngresoCLCFacturaResponse">Ago</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Sep" T="IngresoCLCFacturaResponse">Sep</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Oct" T="IngresoCLCFacturaResponse">Oct</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Nov" T="IngresoCLCFacturaResponse">Nov</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Dic" T="IngresoCLCFacturaResponse">Dic</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Total" T="IngresoCLCFacturaResponse">Total</MudTableSortLabel></MudTh>
                    <MudTh>Control</MudTh>
                </Header>
                <Row Context="item">
                    <MudTd>
                        <div class="main-cell">@item.PkidClcfactura</div>
                        <span>@(item.Activo ? "Activo" : "Inactivo")</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.FkIdIngresoAutorizado?.ToString(NumberCulture))</div>
                        <span>Anio @TextOrDash(item.FkIdAnioSis?.ToString(NumberCulture))</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(DocumentNumber(item))</div>
                        <span>@TextOrDash(item.NumReferenciaDocto)</span>
                    </MudTd>
                    <MudTd>@FormatDate(item.Fecha)</MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.FkIdPolizaConta?.ToString(NumberCulture))</div>
                        <span>Tipo @TextOrDash(item.FkIdTipoPoliza?.ToString(NumberCulture))</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.Concepto)</div>
                        <span>@TextOrDash(item.Rfc) @TextOrDash(item.Nombre)</span>
                    </MudTd>
                    <MudTd>
                        <div class="month-spark">
                            @foreach (var month in GetMonths(item))
                            {
                                <span title="@($"{month.Label}: {Money(month.Amount)}")"
                                      style="height:@GetMonthHeight(month.Amount, GetAmount(item))%"></span>
                            }
                        </div>
                    </MudTd>
                    <MudTd Class="text-right">@Money(item.Ene ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Feb ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Mar ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Abr ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.May ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Jun ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Jul ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Ago ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Sep ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Oct ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Nov ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Dic ?? 0m)</MudTd>
                    <MudTd Class="text-right"><strong>@Money(GetAmount(item))</strong></MudTd>
                    <MudTd>
                        <div class="main-cell">@FormatDate(item.FechaCreacion)</div>
                        <span>Usuario @item.UsuarioCreacion</span>
                    </MudTd>
                </Row>
            </GenericTable>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .ingresos-clc-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 8px 0 12px; }
    .ingresos-clc-summary > div { border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; padding: 9px 11px; background: var(--mud-palette-surface); }
    .ingresos-clc-summary span { display: block; color: var(--mud-palette-text-secondary); font-size: .72rem; text-transform: uppercase; }
    .ingresos-clc-summary strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.02rem; }
    .ingresos-clc-page .main-cell { font-weight: 700; line-height: 1.15; }
    .ingresos-clc-page td span { color: var(--mud-palette-text-secondary); font-size: .78rem; }
    .month-spark { display: grid; grid-template-columns: repeat(12, 6px); align-items: end; gap: 3px; height: 32px; min-width: 105px; }
    .month-spark span { display: block; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--eg-primary); }
    .text-right { text-align: right; }
    @@media (max-width: 900px) { .ingresos-clc-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 560px) { .ingresos-clc-summary { grid-template-columns: 1fr; } }
</style>

@code {
    private GenericTable<IngresoCLCFacturaResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override string ModuleName => "Ingresos_Devengados";
    protected override string SubModuleName => "Ingresos_Propios";
    protected override Type CreateDialogType => typeof(IngresosClc);
    protected override Type EditDialogType => typeof(IngresosClc);
    protected override Type DeleteDialogType => typeof(IngresosClc);
    protected override string GetDefaultSortLabel() => "PkidClcfactura";
    private string BudgetYear => AnioStateService.AnioClave?.ToString() ?? AnioStateService.AnioId?.ToString() ?? "-";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<IngresoCLCFacturaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!AnioStateService.AnioId.HasValue)
                return new TableData<IngresoCLCFacturaResponse>();

            var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection, BuildFilters());
            Elements = response?.Success == true ? response.Items?.ToList() ?? [] : [];
            TotalCount = response?.Success == true ? response.TotalCount : 0;

            if (response?.Success == false && !string.IsNullOrWhiteSpace(response.Message))
                Snackbar.Add(response.Message, Severity.Error);

            return new TableData<IngresoCLCFacturaResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    protected override async Task<List<IngresoCLCFacturaResponse>> LoadExportItemsAsync()
    {
        if (!AnioStateService.AnioId.HasValue)
            return [];

        var items = new List<IngresoCLCFacturaResponse>();
        var page = 1;
        var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;

        while (items.Count < MaxExportRows)
        {
            var response = await Service.GetAllPaginadoAsync(page, ExportPageSize, SearchString, sortLabel, SortDirection, BuildFilters());
            if (response?.Success != true)
                throw new InvalidOperationException(response?.Message ?? "No fue posible obtener los datos para exportar.");

            var pageItems = response.Items?.ToList() ?? [];
            if (pageItems.Count == 0)
                break;

            items.AddRange(pageItems);
            if (items.Count >= response.TotalCount || pageItems.Count < ExportPageSize)
                break;

            page++;
        }

        return items;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<IngresoCLCFacturaResponse> items) => items.Select(x => new
    {
        ID = x.PkidClcfactura,
        Anio = x.FkIdAnioSis,
        Origen = x.FkIdIngresoAutorizado,
        Documento = DocumentNumber(x),
        x.NumReferenciaDocto,
        x.Fecha,
        Poliza = x.FkIdPolizaConta,
        TipoDocumento = x.FkIdTipoDoctoClcSis,
        TipoClc = x.FkIdTipoClcfacturaPres,
        CuentaCargo = x.FkIdCuentaCargo,
        CuentaAbono = x.FkIdCuentaAbono,
        x.Concepto,
        x.Rfc,
        x.Nombre,
        Enero = x.Ene,
        Febrero = x.Feb,
        Marzo = x.Mar,
        Abril = x.Abr,
        Mayo = x.May,
        Junio = x.Jun,
        Julio = x.Jul,
        Agosto = x.Ago,
        Septiembre = x.Sep,
        Octubre = x.Oct,
        Noviembre = x.Nov,
        Diciembre = x.Dic,
        Total = GetAmount(x),
        x.Activo,
        x.FechaCreacion,
        x.UsuarioCreacion,
        x.FechaModificacion,
        x.UsuarioModificacion
    });

    protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;

    private Dictionary<string, object> BuildFilters() => new()
    {
        ["FkIdAnioSis"] = AnioStateService.AnioId!.Value
    };

    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);
    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd", NumberCulture) ?? "-";
    private static string FormatDate(DateOnly? value) => value?.ToString("yyyy-MM-dd", NumberCulture) ?? "-";
    private static string? DocumentNumber(IngresoCLCFacturaResponse item) => !string.IsNullOrWhiteSpace(item.NumClc) ? item.NumClc : item.NumFactura;

    private static decimal GetAmount(IngresoCLCFacturaResponse item)
    {
        if ((item.Total ?? 0m) != 0m) return item.Total!.Value;
        if (item.MontoAplicado != 0m) return item.MontoAplicado;
        if ((item.Importe ?? 0m) != 0m) return item.Importe!.Value;

        return (item.Ene ?? 0m) + (item.Feb ?? 0m) + (item.Mar ?? 0m) + (item.Abr ?? 0m) +
               (item.May ?? 0m) + (item.Jun ?? 0m) + (item.Jul ?? 0m) + (item.Ago ?? 0m) +
               (item.Sep ?? 0m) + (item.Oct ?? 0m) + (item.Nov ?? 0m) + (item.Dic ?? 0m);
    }

    private static int GetMonthHeight(decimal amount, decimal total) => amount <= 0 || total <= 0 ? 10 : Math.Clamp((int)Math.Round(amount / total * 300m), 12, 100);

    private static IEnumerable<(string Label, decimal Amount)> GetMonths(IngresoCLCFacturaResponse item)
    {
        yield return ("Ene", item.Ene ?? 0m); yield return ("Feb", item.Feb ?? 0m); yield return ("Mar", item.Mar ?? 0m);
        yield return ("Abr", item.Abr ?? 0m); yield return ("May", item.May ?? 0m); yield return ("Jun", item.Jun ?? 0m);
        yield return ("Jul", item.Jul ?? 0m); yield return ("Ago", item.Ago ?? 0m); yield return ("Sep", item.Sep ?? 0m);
        yield return ("Oct", item.Oct ?? 0m); yield return ("Nov", item.Nov ?? 0m); yield return ("Dic", item.Dic ?? 0m);
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdText = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdText, out var userId))
                return;

            var response = await UsuarioService.GetByIdAsync(userId);
            if (response?.Success != true || response.Data == null)
                return;

            _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
            _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("IngresosClc")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para ingresos CLC.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }

    public void Dispose() => AnioStateService.OnAnioChanged -= OnAnioChanged;
}
