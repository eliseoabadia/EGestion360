@page "/Presupuesto/Tesoreria/Cuentas_Cobrar/Ingresos_Recaudar"
@using System.Globalization
@using EG.Common.GenericModel
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@inherits BaseCrudPage<IngreXEjerResponse, IngreXEjerResponse>
@implements IDisposable

@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column ingresos-recaudar-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Ingresos por Recaudar"
                    Subtitle="Consulta del ingreso disponible por programa y origen"
                    Icon="@Icons.Material.Filled.RequestQuote"
                    ShowCreateButton="false"
                    OnRefresh="ReloadData" />

        <section class="recaudar-summary">
            <div><span>Total visible</span><strong>@Money(Elements.Sum(x => x.Total ?? 0m))</strong></div>
            <div><span>Registros</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
            <div><span>Anio presupuestal</span><strong>@BudgetYear</strong></div>
            <div><span>Moneda base</span><strong>@_currencyName (@_currencySymbol)</strong></div>
        </section>

        <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericTable TItem="IngreXEjerResponse"
                          @ref="table"
                          Title="Ingresos por recaudar"
                          SearchPlaceholder="Buscar origen, programa, area funcional o descripcion..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="value => SearchString = value"
                          OnSearch="OnSearch"
                          Loading="@Loading">
                <Header>
                    <MudTh><MudTableSortLabel SortLabel="PkIdIngresoAutorizado" T="IngreXEjerResponse">ID</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="AreaFuncional" T="IngreXEjerResponse">Area funcional</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Origen" T="IngreXEjerResponse">Origen</MudTableSortLabel></MudTh>
                    <MudTh>Descripcion</MudTh>
                    <MudTh>Meses</MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Ene" T="IngreXEjerResponse">Enero</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Feb" T="IngreXEjerResponse">Febrero</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Mar" T="IngreXEjerResponse">Marzo</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Abr" T="IngreXEjerResponse">Abril</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="May" T="IngreXEjerResponse">Mayo</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Jun" T="IngreXEjerResponse">Junio</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Jul" T="IngreXEjerResponse">Julio</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Ago" T="IngreXEjerResponse">Agosto</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Sep" T="IngreXEjerResponse">Septiembre</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Oct" T="IngreXEjerResponse">Octubre</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Nov" T="IngreXEjerResponse">Noviembre</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Dic" T="IngreXEjerResponse">Diciembre</MudTableSortLabel></MudTh>
                    <MudTh Class="text-right"><MudTableSortLabel SortLabel="Total" T="IngreXEjerResponse">Total</MudTableSortLabel></MudTh>
                </Header>
                <Row Context="item">
                    <MudTd>@item.PkIdIngresoAutorizado</MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.AreaFuncional)</div>
                        <span>Programa @item.FkIdProgramaPres</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.Origen)</div>
                        <span>Origen @item.FkIdOrigenPres</span>
                    </MudTd>
                    <MudTd>@TextOrDash(item.Descripcion)</MudTd>
                    <MudTd>
                        <div class="month-spark">
                            @foreach (var month in GetMonths(item))
                            {
                                <span title="@($"{month.Label}: {Money(month.Amount)}")"
                                      style="height:@GetMonthHeight(month.Amount, item.Total ?? 0m)%"></span>
                            }
                        </div>
                    </MudTd>
                    <MudTd Class="text-right">@Money(item.Ene ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Feb ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Mar ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Abr ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.May ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Jun ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Jul ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Ago ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Sep ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Oct ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Nov ?? 0m)</MudTd>
                    <MudTd Class="text-right">@Money(item.Dic ?? 0m)</MudTd>
                    <MudTd Class="text-right"><strong>@Money(item.Total ?? 0m)</strong></MudTd>
                </Row>
            </GenericTable>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .recaudar-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 8px 0 12px; }
    .recaudar-summary > div { border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; padding: 9px 11px; background: var(--mud-palette-surface); }
    .recaudar-summary span { display: block; color: var(--mud-palette-text-secondary); font-size: .72rem; text-transform: uppercase; }
    .recaudar-summary strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.02rem; }
    .ingresos-recaudar-page .main-cell { font-weight: 700; line-height: 1.15; }
    .ingresos-recaudar-page td span { color: var(--mud-palette-text-secondary); font-size: .78rem; }
    .month-spark { display: grid; grid-template-columns: repeat(12, 6px); align-items: end; gap: 3px; height: 32px; min-width: 105px; }
    .month-spark span { display: block; min-height: 4px; border-radius: 3px 3px 0 0; background: var(--eg-primary); }
    .text-right { text-align: right; }
    @@media (max-width: 900px) { .recaudar-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 560px) { .recaudar-summary { grid-template-columns: 1fr; } }
</style>

@code {
    private GenericTable<IngreXEjerResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override string ModuleName => "CuentasXCobrar";
    protected override string SubModuleName => "Ingresos_Recaudar";
    protected override Type CreateDialogType => typeof(IngresosRecaudar);
    protected override Type EditDialogType => typeof(IngresosRecaudar);
    protected override Type DeleteDialogType => typeof(IngresosRecaudar);
    protected override string GetDefaultSortLabel() => "PkIdIngresoAutorizado";
    private string BudgetYear => AnioStateService.AnioClave?.ToString() ?? AnioStateService.AnioId?.ToString() ?? "-";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<IngreXEjerResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!AnioStateService.AnioId.HasValue)
                return new TableData<IngreXEjerResponse>();

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                new Dictionary<string, object> { ["FkIdAnioSis"] = AnioStateService.AnioId.Value });

            Elements = response?.Success == true ? response.Items?.ToList() ?? [] : [];
            TotalCount = response?.Success == true ? response.TotalCount : 0;
            if (response?.Success == false && !string.IsNullOrWhiteSpace(response.Message))
                Snackbar.Add(response.Message, Severity.Error);

            return new TableData<IngreXEjerResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    protected override async Task<List<IngreXEjerResponse>> LoadExportItemsAsync()
    {
        if (!AnioStateService.AnioId.HasValue)
            return [];

        var items = new List<IngreXEjerResponse>();
        var page = 1;
        var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
        var filters = new Dictionary<string, object> { ["FkIdAnioSis"] = AnioStateService.AnioId.Value };

        while (items.Count < MaxExportRows)
        {
            var response = await Service.GetAllPaginadoAsync(page, ExportPageSize, SearchString, sortLabel, SortDirection, filters);
            if (response?.Success != true)
                throw new InvalidOperationException(response?.Message ?? "No fue posible obtener los datos para exportar.");

            var pageItems = response.Items?.ToList() ?? [];
            if (pageItems.Count == 0)
                break;

            items.AddRange(pageItems);
            if (items.Count >= response.TotalCount || pageItems.Count < ExportPageSize)
                break;

            page++;
        }

        return items;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<IngreXEjerResponse> items) => items.Select(x => new
    {
        ID = x.PkIdIngresoAutorizado,
        Anio = x.FkIdAnioSis,
        Programa = x.FkIdProgramaPres,
        OrigenId = x.FkIdOrigenPres,
        x.AreaFuncional,
        x.Origen,
        x.Descripcion,
        Enero = x.Ene,
        Febrero = x.Feb,
        Marzo = x.Mar,
        Abril = x.Abr,
        Mayo = x.May,
        Junio = x.Jun,
        Julio = x.Jul,
        Agosto = x.Ago,
        Septiembre = x.Sep,
        Octubre = x.Oct,
        Noviembre = x.Nov,
        Diciembre = x.Dic,
        x.Total
    });

    protected override Task ReloadData() => table?.ReloadData() ?? Task.CompletedTask;
    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);
    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static int GetMonthHeight(decimal amount, decimal total) => amount <= 0 || total <= 0 ? 10 : Math.Clamp((int)Math.Round(amount / total * 300m), 12, 100);

    private static IEnumerable<(string Label, decimal Amount)> GetMonths(IngreXEjerResponse item)
    {
        yield return ("Ene", item.Ene ?? 0m); yield return ("Feb", item.Feb ?? 0m); yield return ("Mar", item.Mar ?? 0m);
        yield return ("Abr", item.Abr ?? 0m); yield return ("May", item.May ?? 0m); yield return ("Jun", item.Jun ?? 0m);
        yield return ("Jul", item.Jul ?? 0m); yield return ("Ago", item.Ago ?? 0m); yield return ("Sep", item.Sep ?? 0m);
        yield return ("Oct", item.Oct ?? 0m); yield return ("Nov", item.Nov ?? 0m); yield return ("Dic", item.Dic ?? 0m);
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdText = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdText, out var userId)) return;
            var response = await UsuarioService.GetByIdAsync(userId);
            if (response?.Success != true || response.Data == null) return;
            _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
            _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
        }
        catch { }
    }

    public void Dispose() => AnioStateService.OnAnioChanged -= OnAnioChanged;
}
