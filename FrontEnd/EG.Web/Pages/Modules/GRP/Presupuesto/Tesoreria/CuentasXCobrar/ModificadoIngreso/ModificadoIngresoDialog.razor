@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor
@using EG.Web.Models.PresupuestoModificado

@inject IGenericCrudService<IngreAdecuacionResponse> Service
@inject ISnackbar Snackbar
@inject AnioPresupuestalStateService AnioStateService

<BaseCrudDialog TItem="IngreAdecuacionResponse"
                @ref="dialog"
                Title="@DialogTitle"
                ActionText="@ActionText"
                ProcessingText="@ProcessingText"
                CanConfirm="@(load.IsReady && !saving)"
                OnConfirm="SaveAsync">
    @if (load.Error != null)
    {
        <EditorLoadError Message="@load.Error" OnRetry="LoadAsync" />
    }
    else
    {
    <BaseEntityForm TEntity="IngreAdecuacionResponse" @ref="form" ShowHeader="false" Loading="@load.IsLoading" LoadingMessage="Preparando modificación de ingresos...">
        <MudGrid GutterSize="2">
            <MudItem xs="12" md="6">
                <MudDatePicker Margin="Margin.Dense" Date="@_fecha"
                               DateChanged="value => _fecha = value"
                               Label="Fecha de la adecuacion"
                               Variant="Variant.Outlined"
                               Required="true" RequiredError="Captura una fecha válida." Clearable="true" Disabled="@saving"
                               Validation="@(new Func<DateTime?, string?>(ValidateDate))" DateFormat="dd/MM/yyyy" Culture="@BudgetCaptureUi.DateCulture" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Margin="Margin.Dense" T="string"
                              Value="@TipoTexto"
                              Label="Tipo de adecuacion"
                              Variant="Variant.Outlined"
                              ReadOnly="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Margin="Margin.Dense" T="string"
                              @bind-Value="item.Justificacion"
                              Label="Justificacion"
                              Variant="Variant.Outlined"
                              Lines="6"
                              Required="true"
                              RequiredError="Captura la justificacion."
                              Counter="1000"
                              MaxLength="1000"
                              Disabled="@saving"
                              HelperText="Describe el fundamento y el resultado esperado de la modificacion." />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
    }
</BaseCrudDialog>
