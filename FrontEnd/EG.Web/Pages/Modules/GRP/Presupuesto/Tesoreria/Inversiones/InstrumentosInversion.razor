@page "/Presupuesto/Tesoreria/Inversiones/Instrumentos_Inversion"
@page "/Presupuesto/Tesoreria/Instrumentos_Inversion"
@page "/Presupuesto/Tesorería/Inversiones/Instrumentos_Inversion"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<InstrumentoResponse, InstrumentoResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Instrumentos de Inversion"
                    Subtitle="Definicion de instrumentos financieros de inversion"
                    Icon="@Icons.Material.Filled.PieChart"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="InstrumentoResponse"
                      @ref="table"
                      Title="Instrumentos"
                      SearchPlaceholder="Buscar por nombre, tipo o intermediario..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="InstrumentoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(context.Item.PkidInstrumento))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Item.PkidInstrumento))" /></CellTemplate></TemplateColumn>
                <PropertyColumn T="InstrumentoResponse" TProperty="int" Property="x => x.PkidInstrumento" Title="ID" Identifier="PkidInstrumento" />
                <PropertyColumn T="InstrumentoResponse" TProperty="string" Property="x => x.Nombre" Title="Nombre" Identifier="Nombre" />
                <PropertyColumn T="InstrumentoResponse" TProperty="string" Property="x => x.TipoInversionDescripcion" Title="Tipo inversión" Identifier="TipoInversionDescripcion" />
                <PropertyColumn T="InstrumentoResponse" TProperty="string" Property="x => x.IntermediarioNombre" Title="Intermediario" Identifier="IntermediarioNombre" />
                <TemplateColumn Resizable="true" T="InstrumentoResponse" Title="Moneda" Identifier="TipoMonedaCodigo"><CellTemplate>@($"{context.Item.TipoMonedaSimbolo} {context.Item.TipoMonedaCodigo}")</CellTemplate></TemplateColumn>
                <TemplateColumn Resizable="true" T="InstrumentoResponse" Title="Tasa" Identifier="TasaInteres"><CellTemplate>@($"{(context.Item.TasaInteres ?? 0m).ToString("0.0000", NumberCulture)}%")</CellTemplate></TemplateColumn>
                <TemplateColumn Resizable="true" T="InstrumentoResponse" Title="Monto mínimo" Identifier="MontoMinimo"><CellTemplate>@Money(context.Item.MontoMinimo ?? 0m, context.Item.TipoMonedaSimbolo)</CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<InstrumentoResponse> table = null!;
    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Instrumentos_Inversion";
    protected override Type CreateDialogType => typeof(InstrumentoInversionDialog);
    protected override Type EditDialogType => typeof(InstrumentoInversionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<InstrumentoResponse>);
    protected override string GetDefaultSortLabel() => "Nombre";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override IEnumerable<object> MapToExcelData(IEnumerable<InstrumentoResponse> items) =>
        items.Select(x => new
        {
            x.PkidInstrumento,
            x.Nombre,
            x.TipoInversionDescripcion,
            x.IntermediarioNombre,
            Moneda = $"{x.TipoMonedaSimbolo} {x.TipoMonedaCodigo}",
            Tasa = (x.TasaInteres ?? 0m).ToString("0.0000", NumberCulture),
            MontoMinimo = (x.MontoMinimo ?? 0m).ToString("0.0000", NumberCulture),
        });

    protected override async Task ReloadData()
    {
        if (table != null) await table.ReloadData();
    }

    private static string Money(decimal amount, string symbol) => $"{(string.IsNullOrWhiteSpace(symbol) ? "$" : symbol)}{amount.ToString("0.0000", NumberCulture)}";
}
