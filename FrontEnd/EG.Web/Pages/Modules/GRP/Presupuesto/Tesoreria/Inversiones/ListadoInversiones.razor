@page "/Presupuesto/Tesoreria/Inversiones/Listado_Inversiones"
@page "/Presupuesto/Tesorería/Inversiones/Listado_Inversiones"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Dommain.DTOs.Responses
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@inherits BaseCrudPage<InversionResponse, InversionResponse>
@using EG.Web.Models.Forms
@using EG.Web.Models.PresupuestoModificado
@implements IDisposable

@inject IGenericCrudService<InteresResponse> InteresService
@inject IGenericCrudService<RetiroResponse> RetiroService
@inject IGenericCrudService<PolizaDetalleResponse> PolizaDetalleService
@inject IGenericCrudService<PolizaResponse> PolizaService
@inject IGenericCrudService<UsuarioResponse> UsuarioService

<AccessVerification IsInitialized="@(IsInitialized && contextReady)" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="operation-page finance-operation-page px-3 d-flex flex-column investment-page-container" MaxWidth="MaxWidth.False">
        @if (SelectedInversion == null)
        {
            <div Style="display:flex;flex-direction:column;flex:0 0 auto;overflow:visible;min-height:0;">
                <PageHeader Title="Listado de Inversiones"
                            Subtitle="Control integral de inversiones y su detalle contable (debe / haber)"
                            Icon="@Icons.Material.Filled.AssuredWorkload"
                            CanCreate="@CanCreate" CreateText="Nueva inversión"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex:0 0 auto;overflow:visible;min-height:0;">
                    <GenericDataGrid TItem="InversionResponse" FillAvailableHeight="false"
                                  @ref="table"
                                  Title="Inversiones"
                                  SearchPlaceholder="Buscar por cuenta, instrumento o monto..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
                        <Columns>
                            <TemplateColumn Resizable="false" T="InversionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Ver detalle"><MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Info" OnClick="@(() => SelectInversion(context.Item))" >Abrir inversión</MudButton></MudTooltip><DocumentSupportButton Modulo="Inversiones" SubModulo="Listado_Inversiones" Controlador="Inversion" EntidadId="@context.Item.PkidInversion" RegistroTitulo="@TextOrDash(context.Item.Instrumento)" RegistroDescripcion="@TextOrDash(context.Item.CuentaBan)" /><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Disabled="@IsLocked(context.Item.PkidInversion)" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(context.Item.PkidInversion))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Disabled="@IsLocked(context.Item.PkidInversion)" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Item.PkidInversion))" /></MudTooltip></CellTemplate></TemplateColumn>
                            
                            <PropertyColumn T="InversionResponse" TProperty="string" Property="x => x.CuentaBan" Title="Cuenta bancaria" Identifier="CuentaBan" />
                            <PropertyColumn T="InversionResponse" TProperty="string" Property="x => x.Instrumento" Title="Instrumento" Identifier="Instrumento" />
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Monto" Identifier="Monto"><CellTemplate>@Money(context.Item.Monto)</CellTemplate></TemplateColumn>
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Intereses" Identifier="Intereses"><CellTemplate>@Money(context.Item.Intereses)</CellTemplate></TemplateColumn>
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Retiros" Identifier="Retiros"><CellTemplate>@Money(context.Item.Retiros)</CellTemplate></TemplateColumn>
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Saldo" Identifier="Saldo"><CellTemplate>@Money(context.Item.Saldo ?? context.Item.Monto)</CellTemplate></TemplateColumn>
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Fecha inversión" Identifier="FechaInversion"><CellTemplate>@context.Item.FechaInversion.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                            <TemplateColumn Resizable="true" T="InversionResponse" Title="Estado" Sortable="false"><CellTemplate>@if (IsLocked(context.Item.PkidInversion)) { <MudChip T="string" Size="Size.Small" Color="Color.Success">Autorizada</MudChip> } else { <MudChip T="string" Size="Size.Small" Color="Color.Warning">En captura</MudChip> }</CellTemplate></TemplateColumn>
                        </Columns>
                    </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div class="finance-detail-flow">
                <div class="operation-record-header d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="BackToTable" aria-label="Volver a inversiones" />
                    <div class="selected-title"><MudText Typo="Typo.h6">@TextOrDash(SelectedInversion.Instrumento)</MudText><MudText Typo="Typo.body2">@TextOrDash(SelectedInversion.CuentaBan)</MudText></div>
                    <MudSpacer />
                    <MudChip T="string" Color="@(SelectedLocked ? Color.Success : Color.Warning)" Size="Size.Small">@(SelectedLocked ? "Bloqueada por póliza autorizada" : "En revisión")</MudChip>
                    <DocumentSupportButton Modulo="Inversiones" SubModulo="Listado_Inversiones" Controlador="Inversion" EntidadId="@SelectedInversion.PkidInversion" RegistroTitulo="@TextOrDash(SelectedInversion.Instrumento)" RegistroDescripcion="@TextOrDash(SelectedInversion.CuentaBan)" />
                </div>
                <OperationActionPanel Title="Movimientos de la inversión" Description="Intereses, retiros y contabilidad se consultan juntos. Los totales utilizan todos los movimientos consultados." Icon="@Icons.Material.Filled.AssuredWorkload">
                    <Actions>
                        @if (CanCreate) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RemoveCircleOutline" Disabled="@(SelectedLocked || !boardLoad.IsReady)" OnClick="AddRetiro">Registrar retiro</MudButton> }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@boardLoad.IsLoading" OnClick="RefreshSelectedAndChildren">Actualizar</MudButton>
                        <ModuleShortcut Module="Contabilidad" SubModule="Polizas" Href="/Contabilidad/Polizas" Text="Consultar pólizas" />
                    </Actions>
                    <HelpContent><ol><li>Comprueba la cuenta, el monto inicial y los movimientos antes de registrar un retiro.</li><li>Los intereses se calculan mediante el proceso existente al guardar el encabezado. Puedes buscar y paginar los movimientos.</li><li>Una póliza autorizada mantiene la inversión bloqueada para cambios. Actualizar vuelve a consultar su estado.</li></ol></HelpContent>
                </OperationActionPanel>
                @if (boardLoad.IsLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Cargando movimientos de inversión" />
                    <MudText>Cargando movimientos y estado contable…</MudText>
                }
                else if (!boardLoad.IsReady)
                {
                    <EditorLoadError Message="@(boardLoad.Error ?? string.Empty)" OnRetry="RefreshSelectedAndChildren" />
                }
                else
                {
                    <section class="finance-metrics" aria-label="Totales de la inversión">
                        <article><span>Monto inicial</span><strong>@Money(MontoInicialSeleccionado)</strong></article>
                        <article><span>Intereses</span><strong>@Money(InteresesBoardTotal)</strong></article>
                        <article><span>Retiros</span><strong>@Money(RetirosBoardTotal)</strong></article>
                        <article><span>Monto + intereses − retiros</span><strong>@Money(TotalMenosRetiros)</strong></article>
                    </section>
                    <MudGrid Spacing="2" Class="operation-related-grid">
                        <MudItem xs="12" lg="5">
                            <GenericDataGrid TItem="InteresResponse" @key="SelectedInversion.PkidInversion" Items="@_interesesBoard" Title="Intereses calculados" FillAvailableHeight="false" PageSize="5" ShowDetailHint="false" ShowExportButton="false" SearchPlaceholder="Buscar interés..." EmptyTitle="Sin intereses calculados" EmptyMessage="Los intereses se generan mediante el proceso del encabezado." SearchTextFunc="x => Money(x.Monto)">
                                <Columns>
                                    <TemplateColumn T="InteresResponse" Title="Fecha" SortBy="x => x.FechaGeneracion"><CellTemplate>@context.Item.FechaGeneracion.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="InteresResponse" Title="Monto" SortBy="x => x.Monto"><CellTemplate>@Money(context.Item.Monto)</CellTemplate></TemplateColumn>
                                </Columns>
                            </GenericDataGrid>
                        </MudItem>
                        <MudItem xs="12" lg="7">
                            <GenericDataGrid TItem="RetiroResponse" @ref="retiroTable" @key="SelectedInversion.PkidInversion" Items="@_retirosBoard" Title="Retiros registrados" FillAvailableHeight="false" PageSize="5" ShowDetailHint="false" ShowExportButton="false" SearchPlaceholder="Buscar retiro..." EmptyTitle="Sin retiros registrados" EmptyMessage="Usa Registrar retiro cuando el estado y tus permisos lo permitan." SearchTextFunc="x => x.TipoRetiroDescripcion">
                                <Columns>
                                    <TemplateColumn T="RetiroResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false" Resizable="false"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditRetiro(context.Item.PkidRetiro))" aria-label="Editar retiro" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Disabled="@SelectedLocked" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRetiro(context.Item.PkidRetiro))" aria-label="Eliminar retiro" /></CellTemplate></TemplateColumn>
                                    <PropertyColumn T="RetiroResponse" TProperty="string" Property="x => x.TipoRetiroDescripcion" Title="Tipo" />
                                    <TemplateColumn T="RetiroResponse" Title="Fecha" SortBy="x => x.FechaRetiro"><CellTemplate>@context.Item.FechaRetiro.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                                    <TemplateColumn T="RetiroResponse" Title="Monto" SortBy="x => x.Monto"><CellTemplate>@Money(context.Item.Monto)</CellTemplate></TemplateColumn>
                                </Columns>
                            </GenericDataGrid>
                        </MudItem>
                    </MudGrid>
                    <GenericDataGrid TItem="PolizaDetalleResponse" @ref="contaTable" @key="SelectedInversion.PkidInversion" Items="@_contaBoard" Title="Movimientos contables de la inversión" FillAvailableHeight="false" PageSize="5" ShowDetailHint="false" ShowExportButton="false" SearchPlaceholder="Buscar cuenta o concepto..." SearchTextFunc="x => x.CuentaClaveNombre + x.Descripcion" EmptyTitle="Sin movimientos contables" EmptyMessage="La inversión aún no tiene movimientos contables asociados.">
                        <Columns>
                            <PropertyColumn T="PolizaDetalleResponse" TProperty="string" Property="x => x.ClavePoliza" Title="Póliza" />
                            <PropertyColumn T="PolizaDetalleResponse" TProperty="string" Property="x => x.CuentaClaveNombre" Title="Cuenta" />
                            <PropertyColumn T="PolizaDetalleResponse" TProperty="string" Property="x => x.Descripcion" Title="Concepto" />
                            <TemplateColumn T="PolizaDetalleResponse" Title="Debe" SortBy="x => x.ImporteDebe"><CellTemplate>@Money(context.Item.ImporteDebe ?? 0m)</CellTemplate></TemplateColumn>
                            <TemplateColumn T="PolizaDetalleResponse" Title="Haber" SortBy="x => x.ImporteHaber"><CellTemplate>@Money(context.Item.ImporteHaber ?? 0m)</CellTemplate></TemplateColumn>
                        </Columns>
                    </GenericDataGrid>
                }
            </div>
        }
    </MudContainer>
</AccessVerification>



@code {
    private readonly EditorRequestState boardLoad = new();
    private bool disposed;
    private bool contextReady;
    private GenericDataGrid<InversionResponse> table = null!;
    private GenericDataGrid<RetiroResponse> retiroTable = null!;
    private GenericDataGrid<PolizaDetalleResponse> contaTable = null!;
    private InversionResponse? SelectedInversion;

    private string interesSearch = string.Empty;
    private string retiroSearch = string.Empty;
    private string contaSearch = string.Empty;
    private string _currencySymbol = "$";
    private bool SelectedLocked;
    private List<InteresResponse> _interesesBoard = new();
    private List<RetiroResponse> _retirosBoard = new();
    private List<PolizaDetalleResponse> _contaBoard = new();
    private readonly Dictionary<int, bool> _lockByInversionId = new();
    private readonly Dictionary<int, bool> _autorizacionPoliza = new();
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private decimal BoardDebeTotal => _contaBoard.Sum(x => x.ImporteDebe ?? 0m);
    private decimal BoardHaberTotal => _contaBoard.Sum(x => x.ImporteHaber ?? 0m);
    private decimal InteresesBoardTotal => _interesesBoard.Sum(x => x.Monto);
    private decimal RetirosBoardTotal => _retirosBoard.Sum(x => x.Monto);
    private decimal MontoInicialSeleccionado => SelectedInversion?.Monto ?? 0m;
    private decimal TotalConIntereses => MontoInicialSeleccionado + InteresesBoardTotal;
    private decimal TotalMenosRetiros => TotalConIntereses - RetirosBoardTotal;

    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Listado_Inversiones";
    protected override Type CreateDialogType => typeof(InversionDialog);
    protected override Type EditDialogType => typeof(InversionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<InversionResponse>);
    protected override string GetDefaultSortLabel() => "FechaInversion";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadCurrencyAsync();
        contextReady = true;
    }

    protected override async Task<TableData<InversionResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var data = await base.LoadServerData(state, cancellationToken);
        await BuildLockStatusAsync(data.Items ?? []);
        return data;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<InversionResponse> items) =>
        items.Select(x => new
        {
            x.CuentaBan,
            x.Instrumento,
            Monto = x.Monto.ToString("0.00", NumberCulture),
            Intereses = x.Intereses.ToString("0.00", NumberCulture),
            Retiros = x.Retiros.ToString("0.00", NumberCulture),
            Saldo = (x.Saldo ?? x.Monto).ToString("0.00", NumberCulture),
            FechaInversion = x.FechaInversion.ToString("dd/MM/yyyy")
        });

    protected override async Task ReloadData()
    {
        if (table != null) await table.ReloadData();
    }

    private async Task SelectInversion(InversionResponse item)
    {
        SelectedInversion = item;
        interesSearch = string.Empty;
        retiroSearch = string.Empty;
        contaSearch = string.Empty;
        await RefreshSelectedAndChildren();
        await InvokeAsync(StateHasChanged);
    }

    private async Task BackToTable()
    {
        boardLoad.Invalidate();
        SelectedInversion = null;
        if (table != null) await table.ReloadData();
    }

    private async Task RefreshSelectedAndChildren()
    {
        if (SelectedInversion == null || disposed) return;
        var id = SelectedInversion.PkidInversion;
        var version = boardLoad.Begin();
        SelectedLocked = true;
        _interesesBoard = []; _retirosBoard = []; _contaBoard = [];
        await InvokeAsync(StateHasChanged);
        try
        {
            await RefreshSelectedInversion();
            if (!boardLoad.IsCurrent(version) || SelectedInversion?.PkidInversion != id) return;
            await LoadBoardDataAsync(version);
            if (!boardLoad.Complete(version)) return;
            SelectedLocked = _contaBoard.Any(row => IsPolizaAutorizada(row.FkidPolizaConta));
            _lockByInversionId[id] = SelectedLocked;
        }
        catch (OperationCanceledException) when (!boardLoad.IsCurrent(version)) { }
        catch (Exception ex)
        {
            if (boardLoad.Fail(version, "No se pudo cargar el detalle completo. Intenta nuevamente."))
                NotifyUnexpectedError(ex, "consultar movimientos de inversión");
        }
        finally { if (boardLoad.IsCurrent(version)) await InvokeAsync(StateHasChanged); }
    }

    private async Task RefreshSelectedInversion()
    {
        if (SelectedInversion == null) return;
        var selectedId = SelectedInversion.PkidInversion;
        var response = await Service.GetByIdAsync(selectedId);
        if (SelectedInversion?.PkidInversion != selectedId) return;
        if (response?.Success != true || response.Data is null) throw new InvalidOperationException("No se pudo actualizar la inversión.");
        if (response?.Success == true && response.Data != null)
        {
            SelectedInversion = response.Data;
        }
    }

    private async Task<TableData<RetiroResponse>> LoadRetirosData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedInversion == null) return new TableData<RetiroResponse> { Items = [], TotalItems = 0 };
        var response = await RetiroService.GetAllPaginadoAsync(Math.Max(1, state.Page + 1), state.PageSize, retiroSearch, state.SortLabel ?? "FechaRetiro", state.SortDirection, new() { ["FkidInversion"] = SelectedInversion.PkidInversion });
        return new TableData<RetiroResponse> { Items = response?.Items ?? [], TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task<TableData<PolizaDetalleResponse>> LoadContaData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedInversion == null) return new TableData<PolizaDetalleResponse> { Items = [], TotalItems = 0 };

        var response = await PolizaDetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            contaSearch,
            state.SortLabel ?? "PkidPolizaDetalle",
            state.SortDirection,
            new() { ["FkidReferencia"] = SelectedInversion.PkidInversion });

        var items = response?.Items?.ToList() ?? new List<PolizaDetalleResponse>();
        await LoadPolizasStateAsync(items);
        return new TableData<PolizaDetalleResponse> { Items = items, TotalItems = response?.TotalCount ?? 0 };
    }

    private async Task LoadBoardDataAsync(int version)
    {
        if (SelectedInversion is null) return;
        var id = SelectedInversion.PkidInversion;
        bool IsCurrent() => boardLoad.IsCurrent(version) && SelectedInversion?.PkidInversion == id;
        var interestsTask = BudgetPageReader.ReadAllAsync(
            (page, size) => InteresService.GetAllPaginadoAsync(page, size, string.Empty, "PkidInteres", SortDirection.Ascending, new() { ["FkidInversion"] = id }),
            row => row.PkidInteres, IsCurrent);
        var withdrawalsTask = BudgetPageReader.ReadAllAsync(
            (page, size) => RetiroService.GetAllPaginadoAsync(page, size, string.Empty, "PkidRetiro", SortDirection.Ascending, new() { ["FkidInversion"] = id }),
            row => row.PkidRetiro, IsCurrent);
        var accountingTask = BudgetPageReader.ReadAllAsync(
            (page, size) => PolizaDetalleService.GetAllPaginadoAsync(page, size, string.Empty, "PkidPolizaDetalle", SortDirection.Ascending, new() { ["FkidReferencia"] = id }),
            row => row.PkidPolizaDetalle, IsCurrent);
        await Task.WhenAll(interestsTask, withdrawalsTask, accountingTask);
        if (!IsCurrent()) return;
        var accounting = await accountingTask;
        foreach (var policyId in accounting.Select(row => row.FkidPolizaConta).Distinct()) _autorizacionPoliza.Remove(policyId);
        await LoadPolizasStateAsync(accounting);
        if (!IsCurrent()) return;
        _interesesBoard = await interestsTask;
        _retirosBoard = await withdrawalsTask;
        _contaBoard = accounting;
    }

    private async Task LoadPolizasStateAsync(IEnumerable<PolizaDetalleResponse> details)
    {
        var polizaIds = details.Select(x => x.FkidPolizaConta).Distinct().ToList();
        foreach (var polizaId in polizaIds)
        {
            if (_autorizacionPoliza.ContainsKey(polizaId)) continue;
            var polizaResponse = await PolizaService.GetByIdAsync(polizaId);
            if (polizaResponse?.Success != true || polizaResponse.Data is null) throw new InvalidOperationException("No se pudo verificar el estado contable de la inversión.");
            _autorizacionPoliza[polizaId] = polizaResponse.Data.Autorizado == true;
        }
    }

    private async Task BuildLockStatusAsync(IEnumerable<InversionResponse> inversiones)
    {
        foreach (var inversion in inversiones)
        {
            if (_lockByInversionId.ContainsKey(inversion.PkidInversion)) continue;
            var locked = await IsInversionLockedAsync(inversion.PkidInversion);
            _lockByInversionId[inversion.PkidInversion] = locked;
        }
    }

    private async Task EvaluateSelectedLockAsync()
    {
        if (SelectedInversion == null)
        {
            SelectedLocked = false;
            return;
        }

        SelectedLocked = await IsInversionLockedAsync(SelectedInversion.PkidInversion);
        _lockByInversionId[SelectedInversion.PkidInversion] = SelectedLocked;
        StateHasChanged();
    }

    private async Task<bool> IsInversionLockedAsync(int inversionId)
    {
        var detalles = await BudgetPageReader.ReadAllAsync(
            (page, size) => PolizaDetalleService.GetAllPaginadoAsync(page, size, string.Empty, "PkidPolizaDetalle", SortDirection.Ascending, new() { ["FkidReferencia"] = inversionId }),
            row => row.PkidPolizaDetalle, () => !disposed);
        if (detalles.Count == 0) return false;

        await LoadPolizasStateAsync(detalles);
        return detalles.Any(d => IsPolizaAutorizada(d.FkidPolizaConta));
    }

    private bool IsPolizaAutorizada(int polizaId) =>
        _autorizacionPoliza.TryGetValue(polizaId, out var autorizado) && autorizado;

    private bool IsLocked(int inversionId) =>
        _lockByInversionId.TryGetValue(inversionId, out var locked) && locked;

    private async Task ReloadRetiros() { if (retiroTable != null) await retiroTable.ReloadData(); }
    private async Task ReloadConta() { if (contaTable != null) await contaTable.ReloadData(); }

    private async Task AddRetiro() => await OpenRetiroDialog(null);
    private async Task EditRetiro(int id) => await OpenRetiroDialog(id);
    private async Task AddContabilidad() => await OpenContabilidadDialog(null);
    private async Task EditContabilidad(int id) => await OpenContabilidadDialog(id);

    private async Task OpenRetiroDialog(int? id)
    {
        if (SelectedInversion == null || SelectedLocked) return;
        var parameters = new DialogParameters { ["Id"] = id, ["InversionId"] = SelectedInversion.PkidInversion };
        var dialog = await DialogService.ShowAsync<InversionRetiroDialog>(id.HasValue ? "Editar retiro" : "Nuevo retiro", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await RefreshSelectedAndChildren();
    }

    private async Task OpenContabilidadDialog(int? id)
    {
        if (SelectedInversion == null || SelectedLocked) return;
        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["InversionId"] = SelectedInversion.PkidInversion,
            ["CurrencySymbol"] = _currencySymbol
        };
        var dialog = await DialogService.ShowAsync<InversionContabilidadDialog>(id.HasValue ? "Editar movimiento contable" : "Nuevo movimiento contable", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false }) await RefreshSelectedAndChildren();
    }

    private async Task DeleteRetiro(int id)
    {
        if (SelectedLocked) return;
        await RetiroService.DeleteAsync(id);
        await RefreshSelectedAndChildren();
    }

    private async Task DeleteContabilidad(int id)
    {
        if (SelectedLocked) return;
        await PolizaDetalleService.DeleteAsync(id);
        await RefreshSelectedAndChildren();
    }

    private async Task AutorizarPoliza(int polizaId)
    {
        if (SelectedLocked) return;
        var polizaResponse = await PolizaService.GetByIdAsync(polizaId);
        if (polizaResponse?.Success != true || polizaResponse.Data == null)
        {
            Snackbar.Add("No se pudo cargar la poliza.", Severity.Error);
            return;
        }

        var poliza = polizaResponse.Data;
        if (poliza.Autorizado == true)
        {
            await EvaluateSelectedLockAsync();
            return;
        }

        if (!await ConfirmWorkflowAsync(
                "Autorizar poliza",
                $"¿Seguro que deseas autorizar la poliza {polizaId}? La inversion quedara bloqueada para edicion.",
                "Autorizar",
                Severity.Success,
                polizaId))
        {
            return;
        }

        poliza.Autorizado = true;
        poliza.PermitirModificar = false;
        poliza.FechaAutorizacion = DateTime.Now;
        var update = await PolizaService.UpdateAsync(poliza, polizaId);
        if (update?.Success == true)
        {
            _autorizacionPoliza[polizaId] = true;
            Snackbar.Add("Poliza autorizada. La inversion queda bloqueada para edicion.", Severity.Success);
            await RefreshSelectedAndChildren();
            return;
        }

        Snackbar.Add(update?.Message ?? "No se pudo autorizar la poliza.", Severity.Error);
    }

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string Money(decimal amount) => $"{_currencySymbol}{amount.ToString("0.00", NumberCulture)}";

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                }
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("ListadoInversiones")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para inversiones.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }
    public void Dispose() { disposed = true; boardLoad.Dispose(); }

}
