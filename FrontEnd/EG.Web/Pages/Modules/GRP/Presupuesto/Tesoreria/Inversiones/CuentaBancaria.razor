@page "/Presupuesto/Tesoreria/Inversiones/Cuenta_Bancaria"
@page "/Presupuesto/Tesorería/Inversiones/Cuenta_Bancaria"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<CuentaBancariaResponse, CuentaBancariaResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Cuenta Bancaria"
                    Subtitle="Cuentas bancarias para operacion de inversiones"
                    Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="CuentaBancariaResponse"
                      @ref="table"
                      Title="Cuentas bancarias"
                      SearchPlaceholder="Buscar cuenta, banco o titular..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="CuentaBancariaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(context.Item.PkidCuentaBancaria))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Item.PkidCuentaBancaria))" /></CellTemplate></TemplateColumn>
                <PropertyColumn T="CuentaBancariaResponse" TProperty="int" Property="x => x.PkidCuentaBancaria" Title="ID" Identifier="PkidCuentaBancaria" />
                <PropertyColumn T="CuentaBancariaResponse" TProperty="string" Property="x => x.NumeroCuenta" Title="Cuenta" Identifier="NumeroCuenta" />
                <PropertyColumn T="CuentaBancariaResponse" TProperty="string" Property="x => x.BancoNombre" Title="Banco" Identifier="BancoNombre" />
                <TemplateColumn Resizable="true" T="CuentaBancariaResponse" Title="Cuenta contable" Identifier="CuentaContable"><CellTemplate>@(string.IsNullOrWhiteSpace(context.Item.CuentaContable) ? "-" : $"{context.Item.CuentaContable} - {context.Item.CuentaContableDescripcion}")</CellTemplate></TemplateColumn>
                <PropertyColumn T="CuentaBancariaResponse" TProperty="string" Property="x => x.Titular" Title="Titular" Identifier="Titular" />
                <TemplateColumn Resizable="true" T="CuentaBancariaResponse" Title="Moneda" Identifier="MonedaDescripcion"><CellTemplate>@($"{context.Item.MonedaSimbolo} {context.Item.MonedaDescripcion}")</CellTemplate></TemplateColumn>
                <TemplateColumn Resizable="true" T="CuentaBancariaResponse" Title="Saldo actual" Identifier="SaldoActual"><CellTemplate>@Money(context.Item.SaldoActual, context.Item.MonedaSimbolo)</CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<CuentaBancariaResponse> table = null!;
    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Cuenta_Bancaria";
    protected override Type CreateDialogType => typeof(CuentaBancariaDialog);
    protected override Type EditDialogType => typeof(CuentaBancariaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<CuentaBancariaResponse>);
    protected override string GetDefaultSortLabel() => "NumeroCuenta";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    protected override IEnumerable<object> MapToExcelData(IEnumerable<CuentaBancariaResponse> items) =>
        items.Select(x => new
        {
            x.PkidCuentaBancaria,
            x.NumeroCuenta,
            x.BancoNombre,
            CuentaContable = string.IsNullOrWhiteSpace(x.CuentaContable) ? string.Empty : $"{x.CuentaContable} - {x.CuentaContableDescripcion}",
            x.Titular,
            Moneda = $"{x.MonedaSimbolo} {x.MonedaDescripcion}",
            SaldoInicial = x.SaldoInicial.ToString("0.00", NumberCulture),
            SaldoActual = x.SaldoActual.ToString("0.00", NumberCulture),
        });

    protected override async Task ReloadData()
    {
        if (table != null) await table.ReloadData();
    }

    private static string Money(decimal amount, string symbol) => $"{(string.IsNullOrWhiteSpace(symbol) ? "$" : symbol)}{amount.ToString("0.00", NumberCulture)}";
}
