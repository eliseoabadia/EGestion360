@page "/Presupuesto/Tesoreria/Inversiones/Banco"
@page "/Presupuesto/Tesorería/Inversiones/Banco"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<BancoResponse, BancoResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Banco"
                    Subtitle="Catalogo de bancos para inversiones"
                    Icon="@Icons.Material.Filled.AccountBalance"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="BancoResponse"
                      @ref="table"
                      Title="Bancos"
                      SearchPlaceholder="Buscar por clave o nombre..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="BancoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(context.Item.PkidBanco))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Item.PkidBanco))" /></CellTemplate></TemplateColumn>
                <PropertyColumn T="BancoResponse" TProperty="int" Property="x => x.PkidBanco" Title="ID" Identifier="PkidBanco" />
                <PropertyColumn T="BancoResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="BancoResponse" TProperty="string" Property="x => x.Nombre" Title="Nombre" Identifier="Nombre" />
                <PropertyColumn T="BancoResponse" TProperty="string" Property="x => x.NombreCorto" Title="Nombre corto" Identifier="NombreCorto" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<BancoResponse> table = null!;
    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Banco";
    protected override Type CreateDialogType => typeof(BancoDialog);
    protected override Type EditDialogType => typeof(BancoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<BancoResponse>);
    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<BancoResponse> items) =>
        items.Select(x => new { x.PkidBanco, x.Clave, x.Nombre, x.NombreCorto});

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
