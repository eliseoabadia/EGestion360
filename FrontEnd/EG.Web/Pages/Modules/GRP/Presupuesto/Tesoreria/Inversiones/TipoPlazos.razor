@page "/Presupuesto/Tesoreria/Inversiones/Tipo_Plazos"
@page "/Presupuesto/Tesorería/Inversiones/Tipo_Plazos"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoPlazoResponse, TipoPlazoResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipo de Plazos" Subtitle="Catalogo de plazos para instrumentos de inversion"
                    Icon="@Icons.Material.Filled.Schedule" CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="TipoPlazoResponse" @ref="table" Title="Tipos de plazo"
                      SearchPlaceholder="Buscar descripcion..." ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData" ExportFunc="ExportToExcel"
                      SearchString="@SearchString" SearchStringChanged="(s) => SearchString = s" OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoPlazoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(context.Item.PkidTipoPlazo))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Item.PkidTipoPlazo))" /></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoPlazoResponse" TProperty="int" Property="x => x.PkidTipoPlazo" Title="ID" Identifier="PkidTipoPlazo" />
                <PropertyColumn T="TipoPlazoResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                <PropertyColumn T="TipoPlazoResponse" TProperty="int" Property="x => x.Dias" Title="Días" Identifier="Dias" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoPlazoResponse> table = null!;
    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Tipo_Plazos";
    protected override Type CreateDialogType => typeof(TipoPlazoDialog);
    protected override Type EditDialogType => typeof(TipoPlazoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoPlazoResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoPlazoResponse> items) =>
        items.Select(x => new { x.PkidTipoPlazo, x.Descripcion, x.Dias});
    protected override async Task ReloadData() { if (table != null) await table.ReloadData(); }
}
