@page "/Presupuesto/Tesorería/Inversiones/Tipo_Retiro"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoRetiroResponse, TipoRetiroResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipo de Retiro" Subtitle="Catalogo de tipos de retiro para inversiones"
                    Icon="@Icons.Material.Filled.LockOpen" CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericTable TItem="TipoRetiroResponse" @ref="table" Title="Tipos de retiro"
                      SearchPlaceholder="Buscar descripcion..." ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData" ExportFunc="ExportToExcel"
                      SearchString="@SearchString" SearchStringChanged="(s) => SearchString = s" OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoRetiro" T="TipoRetiroResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoRetiroResponse">Descripcion</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditItem(item.PkidTipoRetiro))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(item.PkidTipoRetiro))" />
                </MudTd>
                <MudTd>@item.PkidTipoRetiro</MudTd>
                <MudTd>@item.Descripcion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoRetiroResponse> table = null!;
    protected override string ModuleName => "Inversiones";
    protected override string SubModuleName => "Tipo_Retiro";
    protected override Type CreateDialogType => typeof(TipoRetiroDialog);
    protected override Type EditDialogType => typeof(TipoRetiroDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoRetiroResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoRetiroResponse> items) =>
        items.Select(x => new { x.PkidTipoRetiro, x.Descripcion});
    protected override async Task ReloadData() { if (table != null) await table.ReloadData(); }
}
