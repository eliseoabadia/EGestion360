@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<BancoResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="BancoResponse" Title="@dialogTitle" ActionText="@actionText" ProcessingText="@processingText" CanConfirm="@(!_formLoading)" OnConfirm="GuardarCambiosAsync">
    <BaseEntityForm TEntity="BancoResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle" Loading="@_formLoading" LoadingMessage="Preparando banco..." LoadingSkeletonRows="4">
        <MudTextField @bind-Value="item.Clave" Label="Clave" Variant="Variant.Outlined" FullWidth="true" Required="true" />
        <MudTextField @bind-Value="item.Nombre" Label="Nombre" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mt-2" />
        <MudTextField @bind-Value="item.NombreCorto" Label="Nombre corto" Variant="Variant.Outlined" FullWidth="true" Class="mt-2" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<BancoResponse> form = null!;
    private BancoResponse item = new() { Activo = true };
    private bool _formLoading = true;
    private string dialogTitle => Id.HasValue ? "Editar banco" : "Nuevo banco";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!Id.HasValue)
            {
                return;
            }

            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            return;
        }

        var response = Id.HasValue
            ? await Service.UpdateAsync(item, Id.Value)
            : await Service.CreateAsync(item);

        if (response?.Success == true)
        {
            Snackbar.Add("Registro guardado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        Snackbar.Add(response?.Message ?? "No fue posible guardar el registro.", Severity.Error);
    }
}
