@page "/Presupuesto/Egreso/Investigacion_Mercado"
@page "/Planeacion/Investigacion_Mercado"
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using EG.Web.Services
@using MudBlazor
@using System.Globalization
@implements IDisposable
@inject IGenericCrudService<EstudioMercadoDetalleResponse> DetalleService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject HttpClient Http
@inject IJSRuntime JS
@inherits BaseCrudPage<EstudioMercadoResponse, EstudioMercadoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column investigacion-page" MaxWidth="MaxWidth.False" Style="height: 100%; min-height: 0; overflow: auto;">
        @if (SelectedEstudio == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Investigacion de Mercado"
                            Subtitle="Estudios de precios y bienes a investigar desde PAAAS"
                            Icon="@Icons.Material.Filled.LocalOffer"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div class="summary-strip">
                    <div>
                        <span class="summary-label">Estudios</span>
                        <strong>@TotalCount.ToString("N0")</strong>
                    </div>
                    <div>
                        <span class="summary-label">En proceso</span>
                        <strong>@Elements.Count(x => x.Estatus is 1 or 2 or 3).ToString("N0")</strong>
                    </div>
                </div>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="EstudioMercadoResponse"
                                  @ref="table"
                                  Title="Estudios registrados"
                                  SearchPlaceholder="Buscar por nombre, descripcion o responsable..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="EstudioMercadoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Ver detalle">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => SelectEstudio(cell.Item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Planeacion"
                        SubModulo="Investigacion_Mercado"
                        Controlador="EstudioMercado"
                        EntidadId="@cell.Item.PkidEstudioMercado"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@TextOrDash(cell.Item.Nombre)"
                        RegistroDescripcion="@TextOrDash(cell.Item.Descripcion)" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidEstudioMercado))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidEstudioMercado))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="ID" Identifier="PkidEstudioMercado" PropertyName="PkidEstudioMercado" SortBy="x => x.PkidEstudioMercado">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="Color.Tertiary" Size="Size.Small">@cell.Item.PkidEstudioMercado</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="Estudio" Identifier="Nombre" PropertyName="Nombre" SortBy="x => x.Nombre">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Class="main-cell">@TextOrDash(cell.Item.Nombre)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.Descripcion)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="Responsable" Identifier="ResponsableNombre" PropertyName="ResponsableNombre" SortBy="x => x.ResponsableNombre">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.ResponsableNombre)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="Solicitud" Identifier="FechaSolicitud" PropertyName="FechaSolicitud" SortBy="x => x.FechaSolicitud">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaSolicitud.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="Cierre" Identifier="FechaCierre" PropertyName="FechaCierre" SortBy="x => x.FechaCierre">
                    <CellTemplate Context="cell">
                        @DateOrDash(cell.Item.FechaCierre)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoResponse" Title="Estatus" Identifier="Estatus" PropertyName="Estatus" SortBy="x => x.Estatus">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="@StatusColor(cell.Item.Estatus)" Size="Size.Small">
                        @StatusText(cell.Item.Estatus)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column detail-layout" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="selected-header">
                    <div class="selected-title">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                       OnClick="BackToTable"
                                       Tooltip="Volver al listado" />
                        <div class="selected-copy">
                            <MudText Typo="Typo.h6" Class="selected-name">@TextOrDash(SelectedEstudio.Nombre)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(SelectedEstudio.Descripcion)</MudText>
                        </div>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Color="@StatusColor(SelectedEstudio.Estatus)" Size="Size.Small">
                        @StatusText(SelectedEstudio.Estatus)
                    </MudChip>
                    <MudTooltip Text="Editar estudio">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="@(() => EditItem(SelectedEstudio.PkidEstudioMercado))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <DocumentSupportButton Modulo="Planeacion"
                                           SubModulo="Investigacion_Mercado"
                                           Controlador="EstudioMercado"
                                           EntidadId="@SelectedEstudio.PkidEstudioMercado"
                                           FkidEmpresaSis="@SelectedEstudio.FkidEmpresaSis"
                                           RegistroTitulo="@TextOrDash(SelectedEstudio.Nombre)"
                                           RegistroDescripcion="@TextOrDash(SelectedEstudio.Descripcion)" />
                    <MudTooltip Text="Agregar bienes desde PAAAS">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="AddDetalle"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Recibir cotizaciones">
                        <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="OpenRecepcionCotizaciones"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Actualizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="RefreshSelectedAndDetails"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudPaper Elevation="1" Class="summary-panel">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Solicitud</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@SelectedEstudio.FechaSolicitud.ToString("dd/MM/yyyy")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Cierre</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@DateOrDash(SelectedEstudio.FechaCierre)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Responsable</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@TextOrDash(SelectedEstudio.ResponsableNombre)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="1">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Bienes</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@_detalleCount.ToString("N0")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Creacion</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@DateTimeOrDash(SelectedEstudio.FechaCreacion)</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="EstudioMercadoDetalleResponse"
                                  @ref="detalleTable"
                                  Title="Bienes a cotizar"
                                  SearchPlaceholder="Buscar por bien u observaciones..."
                                  ShowExportButton="false"
                                  ShowAddButton="@CanCreate"
                                  PageSize="10"
                                  ServerDataFunc="LoadDetallesServerData"
                                  SearchString="@detalleSearchString"
                                  SearchStringChanged="(s) => detalleSearchString = s"
                                  OnSearch="ReloadDetalles"
                                  OnAdd="AddDetalle">
            <Columns>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <div class="detail-actions">
                        <MudTooltip Text="Editar bien">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditDetalle(cell.Item.PkidEstudioMercadoDetalle))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar bien">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteDetalle(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Imprimir solicitud">
                        <MudIconButton Icon="@Icons.Material.Filled.Print"
                        Color="Color.Default"
                        Size="Size.Small"
                        OnClick="@(() => PrintDetallePending(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="@SendSolicitudTooltip(cell.Item)">
                        <MudIconButton Icon="@Icons.Material.Filled.Email"
                        Color="Color.Primary"
                        Size="Size.Small"
                        Disabled="@(_emailingDetalleId == cell.Item.PkidEstudioMercadoDetalle || cell.Item.SolicitudesCotizacion <= 0 || !cell.Item.PuedeEnviarCotizacion)"
                        OnClick="@(() => SendSolicitudCorreo(cell.Item))" />
                        </MudTooltip>
                        @if (cell.Item.PuedeRechazarCotizacion)
                        {
                        <MudTooltip Text="Rechazar envío y habilitar un nuevo intento">
                        <MudIconButton Icon="@Icons.Material.Filled.Undo"
                        Color="Color.Warning"
                        Size="Size.Small"
                        Disabled="@(_emailingDetalleId == cell.Item.PkidEstudioMercadoDetalle)"
                        OnClick="@(() => RejectSolicitudCorreo(cell.Item))" />
                        </MudTooltip>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="ID" Identifier="PkidEstudioMercadoDetalle" PropertyName="PkidEstudioMercadoDetalle" SortBy="x => x.PkidEstudioMercadoDetalle">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidEstudioMercadoDetalle
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Clave" Identifier="TipoBienClave" PropertyName="TipoBienClave" SortBy="x => x.TipoBienClave">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">@TextOrDash(cell.Item.TipoBienClave)</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Bien / Servicio" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Cantidad" Identifier="Cantidad" PropertyName="Cantidad" SortBy="x => x.Cantidad">
                    <CellTemplate Context="cell">
                        @Quantity(cell.Item.Cantidad)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Proveedores" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @if (cell.Item.ProveedoresCotizacion.Any())
                        {
                        <div class="provider-chip-list">
                        @foreach (var proveedor in cell.Item.ProveedoresCotizacion)
                        {
                        <MudChip T="string"
                        Color="Color.Primary"
                        Variant="Variant.Outlined"
                        Size="Size.Small">
                        @ProviderText(proveedor)
                        </MudChip>
                        }
                        </div>
                        }
                        else
                        {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Solicitudes" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                        @cell.Item.SolicitudesCotizacion.ToString("N0")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Envío" Identifier="EstadoEnvioCotizacion" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="@WorkflowStatusColor(cell.Item.EstadoEnvioCotizacion)" Size="Size.Small">
                        @WorkflowStatusText(cell.Item.EstadoEnvioCotizacion)
                        </MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @cell.Item.SolicitudesEnviadas.ToString("N0") / @cell.Item.SolicitudesCotizacion.ToString("N0")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Cotizaciones" Identifier="__column_7" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="@QuoteProgressColor(cell.Item)" Size="Size.Small">
                        @cell.Item.CotizacionesRecibidas.ToString("N0") / @cell.Item.SolicitudesCotizacion.ToString("N0")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Mejor precio" Identifier="__column_8" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Class="main-cell">@MoneyOrDash(cell.Item.MenorPrecioUnitario)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@MoneyOrDash(cell.Item.ImporteMenorCotizacion)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstudioMercadoDetalleResponse" Title="Observaciones" Identifier="Observaciones" PropertyName="Observaciones" SortBy="x => x.Observaciones">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Observaciones)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
    </MudContainer>
</AccessVerification>

<style>
    .investigacion-page .summary-strip {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .investigacion-page .summary-strip > div,
    .investigacion-page .summary-panel {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
    }

    .investigacion-page .summary-strip > div {
        min-width: 0;
        padding: 10px 12px;
        box-shadow: var(--mud-elevation-1);
    }

    .investigacion-page .summary-label {
        display: block;
        font-size: .72rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

    .investigacion-page .summary-strip strong,
    .investigacion-page .metric {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--mud-palette-text-primary);
        font-weight: 700;
    }

    .investigacion-page .main-cell {
        font-weight: 700;
        line-height: 1.1;
    }

    .investigacion-page .detail-actions {
        min-width: 132px;
        white-space: nowrap;
    }

    .investigacion-page .provider-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        min-width: 180px;
        max-width: 340px;
    }

    .investigacion-page .selected-header {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        gap: 8px;
        padding: 8px 10px;
        border: 1px solid color-mix(in srgb, var(--eg-primary) 24%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .investigacion-page .selected-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .investigacion-page .selected-copy {
        min-width: 0;
    }

    .investigacion-page .selected-name {
        font-weight: 700;
        line-height: 1.15;
    }

    .investigacion-page .summary-panel {
        flex-shrink: 0;
        padding: 12px;
    }

    @@media (max-width: 760px) {
        .investigacion-page .summary-strip {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private GenericDataGrid<EstudioMercadoResponse> table = null!;
    private GenericDataGrid<EstudioMercadoDetalleResponse> detalleTable = null!;
    private EstudioMercadoResponse? SelectedEstudio;
    private string detalleSearchString = string.Empty;
    private int _empresaId;
    private int _detalleCount;
    private int? _emailingDetalleId;
    private string _currencySymbol = "$";

    protected override string ModuleName => "Planeacion";
    protected override string SubModuleName => "Investigacion_Mercado";
    protected override Type CreateDialogType => typeof(InvestigacionMercadoDialog);
    protected override Type EditDialogType => typeof(InvestigacionMercadoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EstudioMercadoResponse>);

    protected override string GetDefaultSortLabel() => "FechaSolicitud";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadEmpresaId();
        await LoadCurrencyAsync();
    }

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }

    protected override async Task<TableData<EstudioMercadoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                return new TableData<EstudioMercadoResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            if (_empresaId > 0)
            {
                filters["FkidEmpresaSis"] = _empresaId;
            }

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrWhiteSpace(response?.Message))
                {
                    Snackbar.Add(response.Message, Severity.Error);
                }
            }

            return new TableData<EstudioMercadoResponse> { Items = Elements, TotalItems = TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar estudios: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<EstudioMercadoResponse>
            {
                Items = new List<EstudioMercadoResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EstudioMercadoResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidEstudioMercado,
            Anio = item.AnioClave ?? item.FkidAnioSis,
            Estudio = item.Nombre,
            Descripcion = item.Descripcion,
            Responsable = item.ResponsableNombre,
            FechaSolicitud = item.FechaSolicitud.ToString("dd/MM/yyyy"),
            FechaCierre = item.FechaCierre?.ToString("dd/MM/yyyy") ?? string.Empty,
            Estatus = StatusText(item.Estatus),
            UsuarioCreacion = item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioModificacion = item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Nombre ?? "el estudio de mercado";
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear.", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = _empresaId,
            ["AnioId"] = AnioStateService.AnioId!.Value
        };

        var dialog = await DialogService.ShowAsync<InvestigacionMercadoDialog>(
            "Crear Investigacion de Mercado",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = _empresaId,
            ["AnioId"] = AnioStateService.AnioId
        };

        var dialog = await DialogService.ShowAsync<InvestigacionMercadoDialog>(
            "Editar Investigacion de Mercado",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (SelectedEstudio?.PkidEstudioMercado == id)
            {
                await RefreshSelectedAndDetails();
            }
            else
            {
                await ReloadData();
            }
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["ItemName"] = await GetItemNameForDelete(id),
            ["DeleteFunc"] = new Func<int, Task<bool>>(DeleteEstudioAsync)
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog<EstudioMercadoResponse>>(
            "Eliminar Investigacion de Mercado",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task ReloadData()
    {
        if (SelectedEstudio != null)
        {
            await RefreshSelectedAndDetails();
            return;
        }

        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async Task<TableData<EstudioMercadoDetalleResponse>> LoadDetallesServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedEstudio == null)
        {
            _detalleCount = 0;
            return new TableData<EstudioMercadoDetalleResponse> { Items = new List<EstudioMercadoDetalleResponse>(), TotalItems = 0 };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "TipoBienClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidEstudioMercadoOrco"] = SelectedEstudio.PkidEstudioMercado });

        _detalleCount = response?.TotalCount ?? 0;

        return new TableData<EstudioMercadoDetalleResponse>
        {
            Items = response?.Items ?? new List<EstudioMercadoDetalleResponse>(),
            TotalItems = _detalleCount
        };
    }

    private async Task SelectEstudio(EstudioMercadoResponse estudio)
