    }

    private async Task SendSolicitudCorreo(EstudioMercadoDetalleResponse detalle)
    {
        if (SelectedEstudio == null)
        {
            Snackbar.Add("Selecciona un estudio de mercado primero.", Severity.Warning);
            return;
        }

        if (detalle.SolicitudesCotizacion <= 0)
        {
            Snackbar.Add("Primero genera solicitudes de cotizacion para este bien.", Severity.Warning);
            return;
        }

        try
        {
            _emailingDetalleId = detalle.PkidEstudioMercadoDetalle;
            var url = $"api/EstudioMercadoDetalle/cotizaciones/solicitudes/{SelectedEstudio.PkidEstudioMercado}/enviar-correo?estudioMercadoDetalleId={detalle.PkidEstudioMercadoDetalle}";
            var response = await Http.PostAsync(url, null);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<EstudioMercadoCotizacionSolicitudResponse>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add(result.Message ?? "Solicitudes enviadas por correo.", Severity.Success);
                await ReloadDetalles();
                return;
            }

            Snackbar.Add(result?.Message ?? "No se pudieron enviar las solicitudes por correo.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al enviar correo: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _emailingDetalleId = null;
        }
    }

    private async Task RejectSolicitudCorreo(EstudioMercadoDetalleResponse detalle)
    {
        if (SelectedEstudio == null)
        {
            return;
        }

        var confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Rechazar las solicitudes enviadas de este bien? Se habilitará un nuevo envío.");
        if (!confirm)
        {
            return;
        }

        try
        {
            _emailingDetalleId = detalle.PkidEstudioMercadoDetalle;
            var url =
                $"api/EstudioMercadoDetalle/cotizaciones/solicitudes/{SelectedEstudio.PkidEstudioMercado}/rechazar-envio?estudioMercadoDetalleId={detalle.PkidEstudioMercadoDetalle}";
            var response = await Http.PostAsJsonAsync(
                url,
                "Rechazado desde investigación de mercado");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<EstudioMercadoCotizacionSolicitudResponse>>();
            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add(result.Message ?? "Solicitudes rechazadas.", Severity.Success);
                await ReloadDetalles();
                return;
            }

            Snackbar.Add(result?.Message ?? "No se pudieron rechazar las solicitudes.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al rechazar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _emailingDetalleId = null;
        }
    }

    private async Task<bool> DeleteEstudioAsync(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/EstudioMercado/{id}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Estudio de mercado eliminado correctamente.", Severity.Success);
                return true;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el estudio.", Severity.Error);
            return false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return false;
        }
    }

    private async Task RefreshSelectedAndDetails()
    {
        await RefreshSelectedEstudio();
        await ReloadDetalles();
    }

    private async Task RefreshSelectedEstudio()
    {
        if (SelectedEstudio == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedEstudio.PkidEstudioMercado);
        if (response?.Success == true && response.Data != null)
        {
            SelectedEstudio = response.Data;
            StateHasChanged();
        }
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private async Task LoadEmpresaId()
    {
        try
        {
            await SucursalStateService.InitializeAsync();
            if (SucursalStateService.EmpresaId.HasValue)
            {
                _empresaId = SucursalStateService.EmpresaId.Value;
                return;
            }

            var empresaIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "empresa_seleccionada");
            if (!string.IsNullOrWhiteSpace(empresaIdStr) && int.TryParse(empresaIdStr, out var empresaId))
            {
                _empresaId = empresaId;
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("InvestigacionMercado")
                .LogWarning(ex, "No se pudo recuperar la empresa seleccionada.");
            AppSnackbar.Add("No se pudo identificar la empresa seleccionada. Verifica el contexto antes de continuar.", Severity.Warning);
        }
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                }
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("InvestigacionMercado")
                .LogWarning(ex, "No se pudo cargar la moneda configurada.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }

