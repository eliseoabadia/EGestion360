    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DateOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string DateTimeOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private static string Quantity(decimal value) => value.ToString("0.00", NumberCulture);

    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";

    private string MoneyOrDash(decimal? value) =>
        value.HasValue ? Money(value.Value) : "-";

    private static string ProviderText(EstudioMercadoDetalleProveedorResponse proveedor)
    {
        var text = $"{proveedor.ProveedorClave} - {proveedor.ProveedorNombre}".Trim(' ', '-');
        return string.IsNullOrWhiteSpace(text) ? proveedor.PkidProveedor.ToString() : text;
    }

    private static Color QuoteProgressColor(EstudioMercadoDetalleResponse detalle)
    {
        if (detalle.SolicitudesCotizacion <= 0)
        {
            return Color.Default;
        }

        if (detalle.CotizacionesRecibidas <= 0)
        {
            return Color.Warning;
        }

        return detalle.CotizacionesRecibidas >= detalle.SolicitudesCotizacion
            ? Color.Success
            : Color.Info;
    }

    private static string SendSolicitudTooltip(EstudioMercadoDetalleResponse item) =>
        item.PuedeEnviarCotizacion
            ? "Enviar solicitudes pendientes o rechazadas"
            : $"Envío bloqueado: estado {WorkflowStatusText(item.EstadoEnvioCotizacion)}";

    private static string WorkflowStatusText(string? status) => status?.ToUpperInvariant() switch
    {
        "PROCESANDO" => "Procesando",
        "ENVIADO" => "Enviado",
        "RECHAZADO" => "Rechazado",
        "PARCIAL" => "Parcial",
        _ => "Pendiente"
    };

    private static Color WorkflowStatusColor(string? status) => status?.ToUpperInvariant() switch
    {
        "PROCESANDO" => Color.Info,
        "ENVIADO" => Color.Success,
        "RECHAZADO" => Color.Warning,
        "PARCIAL" => Color.Info,
        _ => Color.Default
    };

    private static string StatusText(int estatus) => estatus switch
    {
        1 => "Preparacion",
        2 => "Precios mercado",
        3 => "Analisis",
        4 => "Cerrado",
        5 => "Cancelado",
        _ => "Sin estatus"
    };

    private static Color StatusColor(int estatus) => estatus switch
    {
        1 => Color.Info,
        2 => Color.Primary,
        3 => Color.Warning,
        4 => Color.Success,
        5 => Color.Error,
        _ => Color.Default
    };
}
