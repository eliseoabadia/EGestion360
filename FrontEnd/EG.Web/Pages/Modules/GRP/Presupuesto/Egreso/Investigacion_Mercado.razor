    private async Task DeleteDetalle(EstudioMercadoDetalleResponse detalle)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar el bien {TextOrDash(detalle.TipoBienDescripcion)}?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/EstudioMercadoDetalle/{detalle.PkidEstudioMercadoDetalle}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Bien eliminado correctamente.", Severity.Success);
                await ReloadDetalles();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el bien.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

