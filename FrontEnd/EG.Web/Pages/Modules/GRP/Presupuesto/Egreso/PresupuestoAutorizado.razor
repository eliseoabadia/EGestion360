@page "/Presupuesto/Egreso/Presupuesto_Autorizado"
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MiniExcelLibs
@using MudBlazor
@using System.Globalization
@implements IDisposable
@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS
@inject HttpClient Http
@inherits BaseCrudPage<EgresoAutorizadoResponse, EgresoAutorizadoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column presupuesto-autorizado-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Presupuesto Autorizado"
                    Subtitle="Egresos autorizados por programa, partida y area"
                    Icon="@Icons.Material.Filled.Verified"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <section class="dashboard-strip">
            <div class="hero-panel">
                <div>
                    <span class="metric-label">Total autorizado visible</span>
                    <strong>@Money(VisibleTotal)</strong>
                    <small>@TotalCount.ToString("N0", NumberCulture) partidas del ejercicio @TextOrDash(AnioStateService.AnioTexto)</small>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AssuredWorkload" Size="Size.Large" />
            </div>
            <div class="metric-panel">
                <span class="metric-label">Con poliza</span>
                <strong>@WithPolizaCount.ToString("N0", NumberCulture)</strong>
                <small>@WithPolizaPercent.ToString("0.#", NumberCulture)% de lo visible</small>
                <MudProgressLinear Color="Color.Success" Value="@WithPolizaPercent" Rounded="true" Size="Size.Small" />
            </div>
            <div class="metric-panel">
                <span class="metric-label">Desde anteproyecto</span>
                <strong>@FromAnteproyectoCount.ToString("N0", NumberCulture)</strong>
                <small>Bloqueado al flujo de origen</small>
                <MudProgressLinear Color="Color.Info" Value="@FromAnteproyectoPercent" Rounded="true" Size="Size.Small" />
            </div>
            <div class="metric-panel">
                <span class="metric-label">Moneda base</span>
                <strong>@_currencyName</strong>
                <small>@_currencySymbol con separador decimal de punto</small>
            </div>
        </section>

        <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericTable TItem="EgresoAutorizadoResponse"
                          @ref="table"
                          Title="Partidas autorizadas"
                          SearchPlaceholder="Buscar programa, partida, area, fuente, destino, PY o descripcion..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="(s) => SearchString = s"
                          OnSearch="OnSearch">

                <Header>
                    <MudTh>Acciones</MudTh>
                    <MudTh><MudTableSortLabel SortLabel="ProgramaClave" T="EgresoAutorizadoResponse">Programa</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="PartidaClave" T="EgresoAutorizadoResponse">Partida</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="AreaNombre" T="EgresoAutorizadoResponse">Area</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FuenteFinanciamientoClave" T="EgresoAutorizadoResponse">Clasificacion</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FkidPolizaConta" T="EgresoAutorizadoResponse">Poliza</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Descripcion" T="EgresoAutorizadoResponse">Descripcion</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FechaAutorizacion" T="EgresoAutorizadoResponse">Autorizacion</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Total" T="EgresoAutorizadoResponse">Total</MudTableSortLabel></MudTh>
                </Header>

                <Row Context="item">
                    <MudTd>
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Visible="@CanUpdate"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditItem(item.PkidEgresoAutorizado))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Egreso"
                                               SubModulo="Presupuesto_Autorizado"
                                               Controlador="EgresoAutorizado"
                                               EntidadId="@item.PkidEgresoAutorizado"
                                               RegistroTitulo="@TextOrDash(item.ProgramaClaveNombre ?? item.ProgramaClave)"
                                               RegistroDescripcion="@TextOrDash(item.Descripcion)" />
                        <MudTooltip Text="@(item.FkidEgresoProyectadoPres.HasValue ? "Regresar a proyectado" : "Eliminar")">
                            <MudIconButton Icon="@(item.FkidEgresoProyectadoPres.HasValue ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Delete)"
                                           Visible="@CanDelete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteAutorizado(item))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.ProgramaClave)</div>
                        <span>@TextOrDash(item.ProgramaDescripcion)</span>
                    </MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.PartidaClave)</div>
                        <span>@TextOrDash(item.PartidaDescripcion)</span>
                    </MudTd>
                    <MudTd>@TextOrDash(item.AreaNombre)</MudTd>
                    <MudTd>
                        <div class="main-cell">@TextOrDash(item.FuenteFinanciamientoClaveNombre)</div>
                        <span>TG: @TextOrDash(item.TipoGastoClaveNombre)</span><br />
                        <span>DI: @TextOrDash(item.DigitoIdentificadorClaveNombre)</span><br />
                        <span>DG: @TextOrDash(item.DestinoGastoClaveNombre)</span><br />
                        <span>PY: @TextOrDash(item.PyClaveNombre)</span>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(item.FkidPolizaConta.HasValue ? Color.Success : Color.Default)" Variant="Variant.Filled">
                            @(item.FkidPolizaConta.HasValue ? $"Poliza {item.FkidPolizaConta}" : "Sin poliza")
                        </MudChip>
                    </MudTd>
                    <MudTd>@TextOrDash(item.Descripcion)</MudTd>
                    <MudTd>@(item.FechaAutorizacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudTd>
                    <MudTd><strong>@Money(item.Total ?? 0m)</strong></MudTd>
                </Row>
            </GenericTable>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .presupuesto-autorizado-page .dashboard-strip {
        display: grid;
        grid-template-columns: minmax(280px, 1.35fr) repeat(3, minmax(180px, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .presupuesto-autorizado-page .hero-panel,
    .presupuesto-autorizado-page .metric-panel {
        min-width: 0;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 12px 14px;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        box-shadow: var(--mud-elevation-1);
    }

    .presupuesto-autorizado-page .hero-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-left: 4px solid var(--mud-palette-success);
    }

    .presupuesto-autorizado-page .metric-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .presupuesto-autorizado-page .metric-label {
        display: block;
        font-size: .72rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

    .presupuesto-autorizado-page .dashboard-strip strong {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--mud-palette-text-primary);
        font-size: 1.15rem;
        line-height: 1.35;
    }

    .presupuesto-autorizado-page .hero-panel strong {
        font-size: 1.55rem;
    }

    .presupuesto-autorizado-page .dashboard-strip small {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .presupuesto-autorizado-page .main-cell {
        font-weight: 700;
        line-height: 1.1;
    }

    .presupuesto-autorizado-page td span {
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
    }

    @@media (max-width: 1100px) {
        .presupuesto-autorizado-page .dashboard-strip {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 720px) {
        .presupuesto-autorizado-page .dashboard-strip {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private GenericTable<EgresoAutorizadoResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";
    private decimal VisibleTotal => Elements.Sum(x => x.Total ?? 0m);
    private int WithPolizaCount => Elements.Count(x => x.FkidPolizaConta.HasValue);
    private int FromAnteproyectoCount => Elements.Count(x => x.FkidEgresoProyectadoPres.HasValue);
    private double WithPolizaPercent => Percent(WithPolizaCount);
    private double FromAnteproyectoPercent => Percent(FromAnteproyectoCount);

    protected override string ModuleName => "Egreso";
    protected override string SubModuleName => "Presupuesto_Autorizado";
    protected override Type CreateDialogType => typeof(PresupuestoAutorizadoDialog);
    protected override Type EditDialogType => typeof(PresupuestoAutorizadoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EgresoAutorizadoResponse>);

    protected override string GetDefaultSortLabel() => "ProgramaClave";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<EgresoAutorizadoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
                return new TableData<EgresoAutorizadoResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId!.Value });

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrWhiteSpace(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<EgresoAutorizadoResponse> { Items = Elements, TotalItems = TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
            return new TableData<EgresoAutorizadoResponse> { Items = new List<EgresoAutorizadoResponse>(), TotalItems = 0 };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AnioId"] = AnioStateService.AnioId!.Value,
            ["CurrencySymbol"] = _currencySymbol,
            ["CurrencyName"] = _currencyName
        };

        var dialog = await DialogService.ShowAsync(CreateDialogType, "Crear presupuesto autorizado", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["AnioId"] = AnioStateService.AnioId ?? 0,
            ["CurrencySymbol"] = _currencySymbol,
            ["CurrencyName"] = _currencyName
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, "Editar presupuesto autorizado", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EgresoAutorizadoResponse> items)
    {
        return items.Select(x => new
        {
            ID = x.PkidEgresoAutorizado,
            Anteproyecto = x.FkidEgresoProyectadoPres,
            Anio = x.AnioClave,
            Programa = x.ProgramaClaveNombre,
            Partida = x.PartidaClaveNombre,
            Area = x.AreaNombre,
            FuenteFinanciamiento = x.FuenteFinanciamientoClaveNombre,
            TipoGasto = x.TipoGastoClaveNombre,
            DigitoIdentificador = x.DigitoIdentificadorClaveNombre,
            DestinoGasto = x.DestinoGastoClaveNombre,
            PY = x.PyClaveNombre,
            x.Descripcion,
            Fecha = x.Fecha.ToString("dd/MM/yyyy"),
            FechaAutorizacion = x.FechaAutorizacion?.ToString("dd/MM/yyyy HH:mm"),
            x.Enero,
            x.Febrero,
            x.Marzo,
            x.Abril,
            x.Mayo,
            x.Junio,
            x.Julio,
            x.Agosto,
            x.Septiembre,
            x.Octubre,
            x.Noviembre,
            x.Diciembre,
            x.Total,
            x.Activo,
            x.UsuarioAutorizacion,
            x.UsuarioCreacion,
            x.FechaCreacion,
            x.UsuarioModificacion,
            x.FechaModificacion
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.PartidaClaveNombre ?? "el presupuesto autorizado";
    }

    protected override async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var response = await Service.GetAllPaginadoAsync(
                1,
                int.MaxValue,
                SearchString,
                string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel,
                SortDirection,
                new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId!.Value });

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add(response?.Message ?? "No hay datos para exportar", Severity.Warning);
                return;
            }

            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(MapToExcelData(response.Items));

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{AnioStateService.AnioClave}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportacion exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }

    private async Task DeleteAutorizado(EgresoAutorizadoResponse item)
    {
        var isLinkedToProyectado = item.FkidEgresoProyectadoPres.HasValue;
        if (isLinkedToProyectado)
        {
            await ShowRegresarAProyectadoDialog(item);
            return;
        }

        var confirmText = isLinkedToProyectado
            ? $"Regresar a proyectado el presupuesto de {TextOrDash(item.PartidaClaveNombre)}?"
            : $"Eliminar presupuesto autorizado de {TextOrDash(item.PartidaClaveNombre)}?";
        var confirm = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirm)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/EgresoAutorizado/{item.PkidEgresoAutorizado}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Presupuesto autorizado eliminado correctamente", Severity.Success);
                await ReloadData();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el presupuesto autorizado", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowRegresarAProyectadoDialog(EgresoAutorizadoResponse item)
    {
        var parameters = new DialogParameters
        {
            ["EgresoAutorizadoId"] = item.PkidEgresoAutorizado,
            ["Programa"] = item.ProgramaClaveNombre,
            ["Partida"] = item.PartidaClaveNombre,
            ["Area"] = item.AreaNombre,
            ["FuenteFinanciamiento"] = item.FuenteFinanciamientoClaveNombre,
            ["Descripcion"] = item.Descripcion,
            ["Total"] = Money(item.Total ?? 0m),
            ["FechaAutorizacion"] = item.FechaAutorizacion?.ToString("dd/MM/yyyy HH:mm")
        };

        var dialog = await DialogService.ShowAsync(typeof(RegresarAProyectadoDialog), "Regresar a proyectado", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                    _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
                }
            }
        }
        catch
        {
        }
    }

    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);

    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private string Money(decimal amount) => $"{_currencySymbol}{amount.ToString("0.00", NumberCulture)}";

    private double Percent(int value) =>
        Elements.Count == 0 ? 0d : (double)Math.Round((decimal)value / Elements.Count * 100m, 2);

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }
}
