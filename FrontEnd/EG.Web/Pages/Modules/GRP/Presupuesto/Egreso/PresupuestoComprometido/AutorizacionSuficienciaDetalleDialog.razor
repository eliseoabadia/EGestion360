@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.PresupuestoComprometido
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<AutorizacionSuficienciaDetalleResponse> Service
@inject IGenericCrudService<AutorizacionSuficienciaResponse> AutorizacionService
@inject IGenericCrudService<SolicitudSuficienciaDetalleResponse> SolicitudDetalleService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="AutorizacionSuficienciaDetalleResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" CanConfirm="@(!_formLoading)" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="AutorizacionSuficienciaDetalleResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title" Loading="@_formLoading" LoadingMessage="Preparando detalle..." LoadingSkeletonRows="7">
        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <CrudFormSection Title="Origen presupuestal">
                    <MudGrid Spacing="2">
<MudItem xs="12"><MudText Typo="Typo.subtitle2" Color="Color.Primary">@AutorizacionNombre</MudText></MudItem>
            <MudItem xs="12" md="4"><MudTextField Margin="Margin.Dense" T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8">
                <RelatedRecordSelect TResponse="SolicitudSuficienciaDetalleResponse"
                                     Label="Renglón solicitado"
                                     SelectedId="@SelectedSolicitudDetalleId"
                                     SelectedIdChanged="OnSolicitudDetalleIdChanged"
                                     SelectedRecordChanged="OnSolicitudDetalleSelected"
                                     SelectedText="@SolicitudDetalleText"
                                     IdSelector="record => record.PkidSolicitudSuficienciaDetalle"
                                     TextSelector="SolicitudDetalleLabel"
                                     SortProperty="PartidaClave"
                                     AdditionalFilters="@SolicitudDetalleFilters"
                                     Required="true"
                                     RequiredError="Selecciona el renglón solicitado." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Margin="Margin.Dense" T="string" Value="@PartidaText" Label="Partida" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12"><CrudFormSection Title="Distribución mensual"><MudGrid Spacing="2">
@foreach (var month in MonthFields)
            {
                <MudItem xs="6" md="3"><MudNumericField Margin="Margin.Dense" T="decimal?" Value="GetMonth(month.Key)" ValueChanged="v => SetMonth(month.Key, v)" Label="@month.Value" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            }
</MudGrid></CrudFormSection></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>
</MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int AutorizacionId { get; set; }
    [Parameter] public string AutorizacionNombre { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly IReadOnlyList<KeyValuePair<int, string>> MonthFields =
    [
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    ];
    private BaseEntityForm<AutorizacionSuficienciaDetalleResponse> form = null!;
    private AutorizacionSuficienciaDetalleResponse item = new() { Activo = true };
    private bool _formLoading = true;
    private int? SelectedSolicitudDetalleId
    {
        get => item.FkidSolicitudSuficienciaDetallePres > 0 ? item.FkidSolicitudSuficienciaDetallePres : null;
        set => item.FkidSolicitudSuficienciaDetallePres = value.GetValueOrDefault();
    }
    private string SolicitudDetalleText => SolicitudDetalleLabel(new SolicitudSuficienciaDetalleResponse
    {
        RequisicionDescripcion = item.RequisicionDescripcion ?? string.Empty,
        PartidaClaveNombre = item.PartidaClaveNombre ?? string.Empty,
        TipoBienDescripcion = item.TipoBienDescripcion ?? string.Empty
    });
    private string PartidaText => string.IsNullOrWhiteSpace(item.PartidaClaveNombre)
        ? "La partida se toma del renglón seleccionado"
        : item.PartidaClaveNombre;
    private Dictionary<string, object>? SolicitudDetalleFilters => item.FkidSolicitudSuficienciaPres > 0
        ? new Dictionary<string, object>
        {
            ["FkidSolicitudSuficienciaPres"] = item.FkidSolicitudSuficienciaPres,
            ["FkidEmpresaSis"] = item.FkidEmpresaSis,
            ["Activo"] = true
        }
        : null;
    private string Title => Id.HasValue ? "Editar detalle autorizado" : "Nuevo detalle autorizado";
    private string ActionText => Id.HasValue ? "Actualizar" : "Crear";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        try
        {
            if (!Id.HasValue)
            {
                item.FkidAutorizacionSuficienciaPres = AutorizacionId;
                var autorizacion = await AutorizacionService.GetByIdAsync(AutorizacionId);
                if (autorizacion?.Data != null)
                {
                    item.FkidSolicitudSuficienciaPres = autorizacion.Data.FkidSolicitudSuficienciaPres;
                    item.FkidRequisicionOrco = autorizacion.Data.FkidRequisicionOrco;
                    item.RequisicionDescripcion = autorizacion.Data.RequisicionDescripcion;
                    item.FkidEmpresaSis = autorizacion.Data.FkidEmpresaSis;
                }
                return;
            }

            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Data != null)
            {
                item = response.Data;
                AutorizacionId = item.FkidAutorizacionSuficienciaPres;
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private decimal? GetMonth(int month) => month switch { 1 => item.Enero, 2 => item.Febrero, 3 => item.Marzo, 4 => item.Abril, 5 => item.Mayo, 6 => item.Junio, 7 => item.Julio, 8 => item.Agosto, 9 => item.Septiembre, 10 => item.Octubre, 11 => item.Noviembre, _ => item.Diciembre };
    private void SetMonth(int month, decimal? value) { switch (month) { case 1: item.Enero = value; break; case 2: item.Febrero = value; break; case 3: item.Marzo = value; break; case 4: item.Abril = value; break; case 5: item.Mayo = value; break; case 6: item.Junio = value; break; case 7: item.Julio = value; break; case 8: item.Agosto = value; break; case 9: item.Septiembre = value; break; case 10: item.Octubre = value; break; case 11: item.Noviembre = value; break; default: item.Diciembre = value; break; } }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }
        if (item.FkidSolicitudSuficienciaDetallePres <= 0 || item.FkidPartidaConta <= 0)
        {
            Snackbar.Add("Selecciona un renglón solicitado para asignar su partida.", Severity.Warning);
            return;
        }
        item.FkidAutorizacionSuficienciaPres = AutorizacionId;
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add("Detalle guardado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Snackbar.Add(result?.Message ?? "No fue posible guardar el detalle.", Severity.Error);
    }
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? "Empresa seleccionada"
            : SucursalStateService.EmpresaNombre
        : "Sin empresa seleccionada";

    private Task OnSolicitudDetalleIdChanged(int? value)
    {
        SelectedSolicitudDetalleId = value;
        return Task.CompletedTask;
    }

    private Task OnSolicitudDetalleSelected(SolicitudSuficienciaDetalleResponse? record)
    {
        if (record is null)
        {
            item.FkidPartidaConta = 0;
            item.PartidaClave = null;
            item.PartidaDescripcion = null;
            item.PartidaClaveNombre = null;
            item.FkidRequisicionDetalleOrco = null;
            item.FkidTipoBienAlma = null;
            item.TipoBienClave = null;
            item.TipoBienDescripcion = null;
            item.FkidUnidadesAlma = null;
            item.UnidadMedida = null;
            item.Cantidad = null;
            return Task.CompletedTask;
        }

        item.FkidSolicitudSuficienciaPres = record.FkidSolicitudSuficienciaPres;
        item.FkidRequisicionOrco = record.FkidRequisicionOrco;
        item.RequisicionDescripcion = record.RequisicionDescripcion;
        item.FkidRequisicionDetalleOrco = record.FkidRequisicionDetalleOrco;
        item.FkidTipoBienAlma = record.FkidTipoBienAlma;
        item.TipoBienClave = record.TipoBienClave;
        item.TipoBienDescripcion = record.TipoBienDescripcion;
        item.FkidUnidadesAlma = record.FkidUnidadesAlma;
        item.UnidadMedida = record.UnidadMedida;
        item.Cantidad = record.Cantidad;
        item.FkidPartidaConta = record.FkidPartidaConta;
        item.PartidaClave = record.PartidaClave;
        item.PartidaDescripcion = record.PartidaDescripcion;
        item.PartidaClaveNombre = record.PartidaClaveNombre;
        return Task.CompletedTask;
    }

    private static string SolicitudDetalleLabel(SolicitudSuficienciaDetalleResponse record)
    {
        var text = string.Join(" · ", new[] { record.RequisicionDescripcion, record.PartidaClaveNombre, record.TipoBienDescripcion }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "Renglón solicitado" : text;
    }

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
