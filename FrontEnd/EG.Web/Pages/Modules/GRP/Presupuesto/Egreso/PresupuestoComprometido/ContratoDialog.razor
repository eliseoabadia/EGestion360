@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Domain.DTOs.Responses.PresupuestoComprometido
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<ContratoResponse> Service
@inject IGenericCrudService<ContratoDetalleResponse> DetalleService
@inject IGenericCrudService<ProveedorResponse> ProveedorService
@inject IGenericCrudService<AutorizacionSuficienciaResponse> AutorizacionService
@inject IGenericCrudService<PolizaResponse> PolizaService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="ContratoResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" CanConfirm="@(!_formLoading)" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="ContratoResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title" Loading="@_formLoading" LoadingMessage="Preparando contrato..." LoadingSkeletonRows="9">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3"><MudTextField T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3">
                <PagedAutocomplete Value="@_selectedAutorizacion"
                                   ValueChanged="value => _selectedAutorizacion = value"
                                   Label="Autorización"
                                   Required="true"
                                   RequiredError="La autorización es requerida"
                                   LoadPage="LoadAutorizacionesPageAsync" />
            </MudItem>
            <MudItem xs="12" md="3">
                <PagedAutocomplete Value="@_selectedProveedor"
                                   ValueChanged="value => _selectedProveedor = value"
                                   Label="Proveedor"
                                   Required="true"
                                   RequiredError="El proveedor es requerido"
                                   LoadPage="LoadProveedoresPageAsync" />
            </MudItem>
            <MudItem xs="12" md="3">
                <PagedAutocomplete Value="@_selectedPoliza"
                                   ValueChanged="value => _selectedPoliza = value"
                                   Label="Póliza"
                                   Clearable="true"
                                   LoadPage="LoadPolizasPageAsync" />
            </MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="item.NumeroContrato" Label="Numero contrato" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="item.Descripcion" Label="Descripcion" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="fechaContrato" Label="Fecha contrato" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="fechaInicio" Label="Inicio vigencia" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="fechaFin" Label="Fin vigencia" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="decimal" @bind-Value="item.MontoTotal" Label="Monto total" Required="true" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="item.PlazoEjecucion" Label="Plazo ejecucion" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="item.Estatus" Label="Estatus" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">Borrador</MudSelectItem>
                    <MudSelectItem Value="2">Vigente</MudSelectItem>
                    <MudSelectItem Value="3">Concluido</MudSelectItem>
                    <MudSelectItem Value="4">Cancelado</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>

        @if (!Id.HasValue && detalleItems.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700">Calendario por partida que se generara</MudText>
            <MudTable Items="@detalleItems" Dense="true" Hover="true" Elevation="0" Class="mt-2">
                <HeaderContent>
                    <MudTh>Partida</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Observaciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@TextOrDash(context.PartidaClaveNombre)</MudTd>
                    <MudTd><strong>@Money(DetailTotal(context))</strong></MudTd>
                    <MudTd>@TextOrDash(context.Observaciones)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public ContratoResponse? PrefillItem { get; set; }
    [Parameter] public IReadOnlyList<ContratoDetalleResponse>? PrefillDetalles { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;
    private BaseEntityForm<ContratoResponse> form = null!;
    private ContratoResponse item = new() { Activo = true, Estatus = 1 };
    private List<ContratoDetalleResponse> detalleItems = new();
    private DateTime? fechaContrato = DateTime.Today;
    private DateTime? fechaInicio;
    private DateTime? fechaFin;
    private LookupItem? _selectedProveedor;
    private LookupItem? _selectedAutorizacion;
    private LookupItem? _selectedPoliza;
    private bool _formLoading = true;
    private string Title => Id.HasValue ? "Editar contrato" : "Nuevo contrato";
    private string ActionText => Id.HasValue ? "Actualizar" : "Guardar contrato";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Guardando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        try
        {
            if (!Id.HasValue)
            {
                if (PrefillItem != null)
                {
                    item = CloneHeader(PrefillItem);
                    SetSelectedRelations();
                    fechaContrato = item.FechaContrato.ToDateTime(TimeOnly.MinValue);
                    fechaInicio = item.FechaInicioVigencia?.ToDateTime(TimeOnly.MinValue);
                    fechaFin = item.FechaFinVigencia?.ToDateTime(TimeOnly.MinValue);
                }

                detalleItems = PrefillDetalles?.Select(CloneDetail).ToList() ?? new List<ContratoDetalleResponse>();
                return;
            }

            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Data != null)
            {
                item = response.Data;
                SetSelectedRelations();
                fechaContrato = item.FechaContrato.ToDateTime(TimeOnly.MinValue);
                fechaInicio = item.FechaInicioVigencia?.ToDateTime(TimeOnly.MinValue);
                fechaFin = item.FechaFinVigencia?.ToDateTime(TimeOnly.MinValue);
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        if (_selectedAutorizacion == null || _selectedProveedor == null)
        {
            Snackbar.Add("Selecciona la autorización y el proveedor.", Severity.Warning);
            return;
        }

        item.FkidAutorizacionSuficienciaPres = _selectedAutorizacion.Id;
        item.FkidProveedorSis = _selectedProveedor.Id;
        item.FkidPolizaConta = _selectedPoliza?.Id;
        item.FechaContrato = DateOnly.FromDateTime(fechaContrato ?? DateTime.Today);
        item.FechaInicioVigencia = fechaInicio.HasValue ? DateOnly.FromDateTime(fechaInicio.Value) : null;
        item.FechaFinVigencia = fechaFin.HasValue ? DateOnly.FromDateTime(fechaFin.Value) : null;
        if (item.MontoTotal <= 0 && detalleItems.Count > 0)
        {
            item.MontoTotal = detalleItems.Sum(DetailTotal);
        }

        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            if (!Id.HasValue && detalleItems.Count > 0)
            {
                var contratoId = await ResolveCreatedId(result);
                if (contratoId <= 0)
                {
                    Snackbar.Add("El contrato se creo, pero no se pudo recuperar su identificador para generar el detalle.", Severity.Error);
                    return;
                }

                foreach (var detail in detalleItems)
                {
                    detail.FkidContratoPres = contratoId;
                    if (detail.FkidEmpresaSis == 0)
                    {
                        detail.FkidEmpresaSis = item.FkidEmpresaSis;
                    }

                    var detailResult = await DetalleService.CreateAsync(detail);
                    if (detailResult?.Success != true)
                    {
                        Snackbar.Add(detailResult?.Message ?? "El contrato se creo, pero fallo al generar un detalle.", Severity.Error);
                        return;
                    }
                }
            }

            Snackbar.Add(Id.HasValue ? "Contrato actualizado correctamente." : "Contrato y detalle guardados correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data ?? item));
            return;
        }

        Snackbar.Add(result?.Message ?? "No fue posible guardar el contrato.", Severity.Error);
    }

    private async Task<int> ResolveCreatedId(EG.Web.Models.ApiResponse<ContratoResponse> result)
    {
        var createdId = result.Data?.PkidContrato ?? result.Items?.FirstOrDefault()?.PkidContrato ?? 0;
        if (createdId > 0 || item.FkidAutorizacionSuficienciaPres <= 0)
        {
            return createdId;
        }

        var created = await Service.GetAllPaginadoAsync(
            1,
            1,
            string.Empty,
            "PkidContrato",
            SortDirection.Descending,
            new Dictionary<string, object> { ["FkidAutorizacionSuficienciaPres"] = item.FkidAutorizacionSuficienciaPres });

        return created?.Items?.FirstOrDefault()?.PkidContrato ?? 0;
    }

    private static ContratoResponse CloneHeader(ContratoResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidAutorizacionSuficienciaPres = source.FkidAutorizacionSuficienciaPres,
        FkidSolicitudSuficienciaPres = source.FkidSolicitudSuficienciaPres,
        FkidRequisicionOrco = source.FkidRequisicionOrco,
        FkidProveedorSis = source.FkidProveedorSis,
        FkidPolizaConta = source.FkidPolizaConta,
        NumeroContrato = source.NumeroContrato,
        Descripcion = source.Descripcion,
        FechaContrato = source.FechaContrato,
        FechaInicioVigencia = source.FechaInicioVigencia,
        FechaFinVigencia = source.FechaFinVigencia,
        MontoTotal = source.MontoTotal,
        PlazoEjecucion = source.PlazoEjecucion,
        Observaciones = source.Observaciones,
        Estatus = source.Estatus,
        Activo = source.Activo
    };

    private static ContratoDetalleResponse CloneDetail(ContratoDetalleResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidAutorizacionSuficienciaDetallePres = source.FkidAutorizacionSuficienciaDetallePres,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        PartidaClaveNombre = source.PartidaClaveNombre,
        Enero = source.Enero,
        Febrero = source.Febrero,
        Marzo = source.Marzo,
        Abril = source.Abril,
        Mayo = source.Mayo,
        Junio = source.Junio,
        Julio = source.Julio,
        Agosto = source.Agosto,
        Septiembre = source.Septiembre,
        Octubre = source.Octubre,
        Noviembre = source.Noviembre,
        Diciembre = source.Diciembre,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal value) => $"${value.ToString("0.00", Culture)}";
    private static decimal DetailTotal(ContratoDetalleResponse item) =>
        item.Total ?? item.Enero.GetValueOrDefault() + item.Febrero.GetValueOrDefault() +
        item.Marzo.GetValueOrDefault() + item.Abril.GetValueOrDefault() +
        item.Mayo.GetValueOrDefault() + item.Junio.GetValueOrDefault() +
        item.Julio.GetValueOrDefault() + item.Agosto.GetValueOrDefault() +
        item.Septiembre.GetValueOrDefault() + item.Octubre.GetValueOrDefault() +
        item.Noviembre.GetValueOrDefault() + item.Diciembre.GetValueOrDefault();

    private void SetSelectedRelations()
    {
        _selectedAutorizacion = item.FkidAutorizacionSuficienciaPres > 0
            ? new LookupItem
            {
                Id = item.FkidAutorizacionSuficienciaPres,
                Text = $"Autorización {item.FkidAutorizacionSuficienciaPres}"
            }
            : null;
        _selectedProveedor = item.FkidProveedorSis > 0
            ? new LookupItem
            {
                Id = item.FkidProveedorSis,
                Text = BuildProveedorText(item.ProveedorClave, item.ProveedorNombre, item.FkidProveedorSis)
            }
            : null;
        _selectedPoliza = item.FkidPolizaConta is > 0
            ? new LookupItem
            {
                Id = item.FkidPolizaConta.Value,
                Text = string.IsNullOrWhiteSpace(item.ClavePoliza) ? $"Póliza {item.FkidPolizaConta.Value}" : item.ClavePoliza
            }
            : null;
    }

    private async Task<ComboLookupResult> LoadAutorizacionesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var additional = new Dictionary<string, object> { ["Estatus"] = 2 };
        if (item.FkidEmpresaSis > 0)
        {
            additional["FkidEmpresaSis"] = item.FkidEmpresaSis;
        }
        var response = await AutorizacionService.GetAllPaginadoAsync(page, pageSize, filter, "FechaAutorizacion", SortDirection.Descending, additional);
        return new ComboLookupResult
        {
            Items = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem
            {
                Id = x.PkidAutorizacionSuficiencia,
                Text = $"AUT-{x.PkidAutorizacionSuficiencia} - {TextOrDash(x.RequisicionDescripcion)}"
            }).ToList() ?? new List<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private async Task<ComboLookupResult> LoadProveedoresPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ProveedorService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem
            {
                Id = x.PkidProveedor,
                Text = BuildProveedorText(x.Clave, x.Nombre, x.PkidProveedor)
            }).ToList() ?? new List<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private async Task<ComboLookupResult> LoadPolizasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await PolizaService.GetAllPaginadoAsync(page, pageSize, filter, "ClavePoliza", SortDirection.Descending);
        return new ComboLookupResult
        {
            Items = response?.Items?.Where(x => x.Activo).Select(x => new LookupItem
            {
                Id = x.PkidPoliza,
                Text = string.Join(" - ", new[] { x.ClavePoliza, x.NombrePoliza }.Where(v => !string.IsNullOrWhiteSpace(v)))
            }).ToList() ?? new List<LookupItem>(),
            TotalCount = response?.TotalCount ?? 0
        };
    }

    private static string BuildProveedorText(string? clave, string? nombre, int id)
    {
        var text = string.Join(" - ", new[] { clave, nombre }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(text) ? id.ToString(CultureInfo.InvariantCulture) : text;
    }

    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? item.FkidEmpresaSis.ToString()
            : $"{SucursalStateService.EmpresaNombre} ({item.FkidEmpresaSis})"
        : "Sin empresa seleccionada";

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
