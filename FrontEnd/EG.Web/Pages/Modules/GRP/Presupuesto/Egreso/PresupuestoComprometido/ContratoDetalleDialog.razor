@using EG.Domain.DTOs.Responses.CuentasXPagar
@using EG.Domain.DTOs.Responses.PresupuestoComprometido
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<ContratoDetalleResponse> Service
@inject IGenericCrudService<ContratoResponse> ContratoHeaderService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="ContratoDetalleResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" CanConfirm="@(!_formLoading)" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="ContratoDetalleResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title" Loading="@_formLoading" LoadingMessage="Preparando partida..." LoadingSkeletonRows="7">
        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <CrudFormSection Title="Origen presupuestal">
                    <MudGrid Spacing="2">
<MudItem xs="12"><MudText Typo="Typo.subtitle2" Color="Color.Primary">@ContratoNombre</MudText></MudItem>
            <MudItem xs="12" md="4"><MudTextField Margin="Margin.Dense" T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8">
                <RelatedRecordSelect TResponse="AutorizacionSuficienciaDetalleResponse"
                                     Label="Renglón autorizado"
                                     SelectedId="@SelectedAutorizacionDetalleId"
                                     SelectedIdChanged="OnAutorizacionDetalleIdChanged"
                                     SelectedRecordChanged="OnAutorizacionDetalleSelected"
                                     SelectedText="@AutorizacionDetalleText"
                                     IdSelector="record => record.PkidAutorizacionSuficienciaDetalle"
                                     TextSelector="AutorizacionDetalleLabel"
                                     SortProperty="PartidaClave"
                                     AdditionalFilters="@AutorizacionDetalleFilters"
                                     Required="true"
                                     RequiredError="Selecciona un renglón autorizado." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Margin="Margin.Dense" T="string" Value="@PartidaText" Label="Partida" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12"><CrudFormSection Title="Distribución mensual"><MudGrid Spacing="2">
@foreach (var month in MonthFields)
            {
                <MudItem xs="6" md="3"><MudNumericField Margin="Margin.Dense" T="decimal?" Value="GetMonth(month.Key)" ValueChanged="v => SetMonth(month.Key, v)" Label="@month.Value" Culture="@Culture" Format="0.00" Variant="Variant.Outlined" /></MudItem>
            }
</MudGrid></CrudFormSection></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>
</MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int ContratoId { get; set; }
    [Parameter] public string ContratoNombre { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly IReadOnlyList<KeyValuePair<int, string>> MonthFields =
    [
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    ];
    private BaseEntityForm<ContratoDetalleResponse> form = null!;
    private ContratoDetalleResponse item = new() { Activo = true };
    private int _autorizacionId;
    private bool _formLoading = true;
    private int? SelectedAutorizacionDetalleId
    {
        get => item.FkidAutorizacionSuficienciaDetallePres > 0 ? item.FkidAutorizacionSuficienciaDetallePres : null;
        set => item.FkidAutorizacionSuficienciaDetallePres = value.GetValueOrDefault();
    }
    private string AutorizacionDetalleText => AutorizacionDetalleLabel(new AutorizacionSuficienciaDetalleResponse
    {
        RequisicionDescripcion = item.NumeroContrato ?? string.Empty,
        PartidaClaveNombre = item.PartidaClaveNombre ?? string.Empty,
        PartidaClave = item.PartidaClave ?? string.Empty,
        PartidaDescripcion = item.PartidaDescripcion ?? string.Empty
    });
    private string PartidaText => string.IsNullOrWhiteSpace(item.PartidaClaveNombre)
        ? "La partida se toma del renglón autorizado"
        : item.PartidaClaveNombre;
    private Dictionary<string, object>? AutorizacionDetalleFilters => _autorizacionId > 0
        ? new Dictionary<string, object>
        {
            ["FkidAutorizacionSuficienciaPres"] = _autorizacionId,
            ["FkidEmpresaSis"] = item.FkidEmpresaSis,
            [EG.Common.Constants.EntityFields.Active] = true
        }
        : null;
    private string Title => Id.HasValue ? "Editar partida de contrato" : "Nueva partida de contrato";
    private string ActionText => Id.HasValue ? EG.Common.ApplicationText.Actions.Update : EG.Common.ApplicationText.Actions.Create;
    private string ProcessingText => Id.HasValue ? EG.Common.ApplicationText.Status.Updating : EG.Common.ApplicationText.Status.Creating;

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        try
        {
            if (!Id.HasValue)
            {
                item.FkidContratoPres = ContratoId;
                var contrato = await ContratoHeaderService.GetByIdAsync(ContratoId);
                if (contrato?.Data != null)
                {
                    item.NumeroContrato = contrato.Data.NumeroContrato;
                    _autorizacionId = contrato.Data.FkidAutorizacionSuficienciaPres;
                }
                return;
            }

            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Data != null)
            {
                item = response.Data;
                ContratoId = item.FkidContratoPres;
                ContratoNombre = item.NumeroContrato ?? ContratoNombre;
                var contrato = await ContratoHeaderService.GetByIdAsync(ContratoId);
                _autorizacionId = contrato?.Data?.FkidAutorizacionSuficienciaPres ?? 0;
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private decimal? GetMonth(int month) => month switch { 1 => item.Enero, 2 => item.Febrero, 3 => item.Marzo, 4 => item.Abril, 5 => item.Mayo, 6 => item.Junio, 7 => item.Julio, 8 => item.Agosto, 9 => item.Septiembre, 10 => item.Octubre, 11 => item.Noviembre, _ => item.Diciembre };
    private void SetMonth(int month, decimal? value) { switch (month) { case 1: item.Enero = value; break; case 2: item.Febrero = value; break; case 3: item.Marzo = value; break; case 4: item.Abril = value; break; case 5: item.Mayo = value; break; case 6: item.Junio = value; break; case 7: item.Julio = value; break; case 8: item.Agosto = value; break; case 9: item.Septiembre = value; break; case 10: item.Octubre = value; break; case 11: item.Noviembre = value; break; default: item.Diciembre = value; break; } }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add(EG.Common.ApplicationText.Validation.RequiredFields, Severity.Warning);
            return;
        }
        if (item.FkidAutorizacionSuficienciaDetallePres <= 0 || item.FkidPartidaConta <= 0)
        {
            Snackbar.Add("Selecciona un renglón autorizado para asignar su partida.", Severity.Warning);
            return;
        }
        item.FkidContratoPres = ContratoId;
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add("Partida de contrato guardada correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Snackbar.Add(result?.Message ?? "No fue posible guardar la partida.", Severity.Error);
    }
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? "Empresa seleccionada"
            : SucursalStateService.EmpresaNombre
        : "Sin empresa seleccionada";

    private Task OnAutorizacionDetalleIdChanged(int? value)
    {
        SelectedAutorizacionDetalleId = value;
        return Task.CompletedTask;
    }

    private Task OnAutorizacionDetalleSelected(AutorizacionSuficienciaDetalleResponse? record)
    {
        if (record is null)
        {
            item.FkidPartidaConta = 0;
            item.PartidaClave = null;
            item.PartidaDescripcion = null;
            item.PartidaClaveNombre = null;
            return Task.CompletedTask;
        }

        _autorizacionId = record.FkidAutorizacionSuficienciaPres;
        item.FkidPartidaConta = record.FkidPartidaConta;
        item.PartidaClave = record.PartidaClave;
        item.PartidaDescripcion = record.PartidaDescripcion;
        item.PartidaClaveNombre = record.PartidaClaveNombre;
        return Task.CompletedTask;
    }

    private static string AutorizacionDetalleLabel(AutorizacionSuficienciaDetalleResponse record)
    {
        var text = string.Join(" · ", new[]
        {
            record.RequisicionDescripcion,
            record.PartidaClaveNombre ?? record.PartidaClave,
            record.TipoBienDescripcion
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "Renglón autorizado" : text;
    }

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
