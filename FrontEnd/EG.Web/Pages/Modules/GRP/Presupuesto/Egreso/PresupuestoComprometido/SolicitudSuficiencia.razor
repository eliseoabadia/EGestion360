@page "/Presupuesto/Egreso/Presupuesto_Comprometido/Solicitud_Suficiencia"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.PresupuestoComprometido
@using EG.Dommain.DTOs.Responses
@using EG.Web.Auth
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<SolicitudSuficienciaResponse, SolicitudSuficienciaResponse>

@inject IGenericCrudService<SolicitudSuficienciaDetalleResponse> DetalleService
@inject IGenericCrudService<AutorizacionSuficienciaResponse> AutorizacionService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject AuthenticationProviderJWT PageAuthProvider
@inject EG.Web.Services.AuthService AuthService

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column solicitud-suficiencia-page" MaxWidth="MaxWidth.False" Style="height:100vh;overflow:hidden;">
        @if (SelectedSolicitud == null)
        {
            <div Style="display:flex;flex-direction:column;flex-grow:1;overflow:hidden;min-height:0;">
                <PageHeader Title="Solicitud Suficiencia"
                            Subtitle="Solicitudes listas para autorizar presupuesto comprometido"
                            Icon="@Icons.Material.Filled.RuleFolder"
                            CanCreate="false"
                            OnRefresh="() => table.ReloadData()" />

                <div class="summary-strip">
                    <div><span>Solicitudes</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
                    <div><span>Activas en página</span><strong>@Elements.Count(x => x.Activo).ToString("N0", NumberCulture)</strong></div>
                    <div><span>Pendientes</span><strong>@Elements.Count(x => x.Estatus != 3).ToString("N0", NumberCulture)</strong></div>
                </div>

                <div Style="flex-grow:1;overflow:hidden;min-height:0;">
                    <GenericTable TItem="SolicitudSuficienciaResponse"
                                  @ref="table"
                                  Title="Solicitudes de suficiencia"
                                  SearchPlaceholder="Buscar requisición, justificación o estatus..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
                        <Header>
                            <MudTh>Acciones</MudTh>
                            <MudTh><MudTableSortLabel SortLabel="PkidSolicitudSuficiencia" T="SolicitudSuficienciaResponse">ID</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="RequisicionDescripcion" T="SolicitudSuficienciaResponse">Requisición</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="FechaSolicitud" T="SolicitudSuficienciaResponse">Solicitud</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="FechaRequisicion" T="SolicitudSuficienciaResponse">Requisición fecha</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Estatus" T="SolicitudSuficienciaResponse">Estatus</MudTableSortLabel></MudTh>
                        </Header>
                        <Row Context="item">
                            <MudTd>
                                <MudTooltip Text="Ver detalle">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => SelectSolicitud(item))" />
                                </MudTooltip>
                                <DocumentSupportButton Modulo="Presupuesto_Comprometido"
                                                       SubModulo="Solicitud_Suficiencia"
                                                       Controlador="SolicitudSuficiencia"
                                                       EntidadId="@item.PkidSolicitudSuficiencia"
                                                       FkidEmpresaSis="@item.FkidEmpresaSis"
                                                       RegistroTitulo="@($"Solicitud {item.PkidSolicitudSuficiencia}")"
                                                       RegistroDescripcion="@TextOrDash(item.RequisicionDescripcion)" />
                                <MudTooltip Text="Autorizar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                                   Visible="@CanAuthorize"
                                                   Disabled="@IsAuthorized(item)"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="@(() => AuthorizeSolicitud(item))" />
                                </MudTooltip>
                            </MudTd>
                            <MudTd><MudChip T="string" Color="Color.Tertiary" Size="Size.Small">@item.PkidSolicitudSuficiencia</MudChip></MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="main-cell">@TextOrDash(item.RequisicionDescripcion)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(item.EmpresaNombre)</MudText>
                            </MudTd>
                            <MudTd>@item.FechaSolicitud.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>@DateOrDash(item.FechaRequisicion)</MudTd>
                            <MudTd><MudChip T="string" Color="@EstatusColor(item.Estatus)" Size="Size.Small">@TextOrDash(item.EstatusDescripcion)</MudChip></MudTd>
                        </Row>
                    </GenericTable>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column detail-layout" Style="flex-grow:1;overflow:hidden;min-height:0;gap:8px;">
                <MudPaper Elevation="0" Class="selected-header">
                    <div class="selected-title">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Size="Size.Medium" OnClick="BackToTable" />
                        <div>
                            <MudText Typo="Typo.h6" Class="selected-name">@TextOrDash(SelectedSolicitud.RequisicionDescripcion)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Solicitud @SelectedSolicitud.PkidSolicitudSuficiencia | @SelectedSolicitud.FechaSolicitud.ToString("dd/MM/yyyy")</MudText>
                        </div>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Color="@EstatusColor(SelectedSolicitud.Estatus)" Size="Size.Small">@TextOrDash(SelectedSolicitud.EstatusDescripcion)</MudChip>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">@Money(TotalSeleccionado)</MudChip>
                    <DocumentSupportButton Modulo="Presupuesto_Comprometido"
                                           SubModulo="Solicitud_Suficiencia"
                                           Controlador="SolicitudSuficiencia"
                                           EntidadId="@SelectedSolicitud.PkidSolicitudSuficiencia"
                                           FkidEmpresaSis="@SelectedSolicitud.FkidEmpresaSis"
                                           RegistroTitulo="@($"Solicitud {SelectedSolicitud.PkidSolicitudSuficiencia}")"
                                           RegistroDescripcion="@TextOrDash(SelectedSolicitud.RequisicionDescripcion)" />
                    <MudTooltip Text="Autorizar solicitud">
                        <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanAuthorize"
                                       Disabled="@IsAuthorized(SelectedSolicitud)"
                                       OnClick="@(() => AuthorizeSolicitud(SelectedSolicitud))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <MudTooltip Text="Actualizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small" OnClick="RefreshSelectedAndDetails" Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudPaper Elevation="1" Class="summary-panel">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha requisición</MudText><MudText Typo="Typo.body2" Class="metric">@DateOrDash(SelectedSolicitud.FechaRequisicion)</MudText></MudItem>
                        <MudItem xs="6" sm="3" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Mes aplicado</MudText><MudText Typo="Typo.body2" Class="metric">@MesAplicado</MudText></MudItem>
                        <MudItem xs="6" sm="3" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Bienes</MudText><MudText Typo="Typo.body2" Class="metric">@SelectedDetalles.Count.ToString("N0", NumberCulture)</MudText></MudItem>
                        <MudItem xs="6" sm="3" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Partidas</MudText><MudText Typo="Typo.body2" Class="metric">@PartidaResumenes.Count().ToString("N0", NumberCulture)</MudText></MudItem>
                        <MudItem xs="6" sm="3" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Total solicitado</MudText><MudText Typo="Typo.body2" Class="metric">@Money(TotalSeleccionado)</MudText></MudItem>
                        <MudItem xs="12" sm="9" md="2"><MudText Typo="Typo.caption" Color="Color.Tertiary">Creación</MudText><MudText Typo="Typo.body2" Class="metric">@DateTimeOrDash(SelectedSolicitud.FechaCreacion)</MudText></MudItem>
                    </MudGrid>
                </MudPaper>

                @if (PartidaResumenes.Any())
                {
                    <div class="partida-strip">
                        @foreach (var partida in PartidaResumenes)
                        {
                            <div>
                                <span>@TextOrDash(partida.Partida)</span>
                                <strong>@Money(partida.Total)</strong>
                                <small>@partida.Bienes.ToString("N0", NumberCulture) bienes</small>
                            </div>
                        }
                    </div>
                }

                <div Style="flex-grow:1;overflow:hidden;min-height:0;">
                    <GenericTable TItem="SolicitudSuficienciaDetalleResponse"
                                  @ref="detalleTable"
                                  Title="Detalle por bien y partida"
                                  SearchPlaceholder="Buscar partida o bien..."
                                  ShowExportButton="false"
                                  PageSize="10"
                                  ServerDataFunc="LoadDetallesServerData"
                                  SearchString="@detalleSearchString"
                                  SearchStringChanged="(s) => detalleSearchString = s"
                                  OnSearch="ReloadDetalles">
                        <Header>
                            <MudTh><MudTableSortLabel SortLabel="PartidaClave" T="SolicitudSuficienciaDetalleResponse">Partida</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="TipoBienClave" T="SolicitudSuficienciaDetalleResponse">Clave</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="TipoBienDescripcion" T="SolicitudSuficienciaDetalleResponse">Bien</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Cantidad" T="SolicitudSuficienciaDetalleResponse">Cantidad</MudTableSortLabel></MudTh>
                            <MudTh>Mes</MudTh>
                            <MudTh><MudTableSortLabel SortLabel="Total" T="SolicitudSuficienciaDetalleResponse">Total</MudTableSortLabel></MudTh>
                        </Header>
                        <Row Context="detalle">
                            <MudTd>@TextOrDash(detalle.PartidaClaveNombre)</MudTd>
                            <MudTd>@TextOrDash(detalle.TipoBienClave)</MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="main-cell">@TextOrDash(detalle.TipoBienDescripcion)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(detalle.Observaciones)</MudText>
                            </MudTd>
                            <MudTd>@Quantity(detalle.Cantidad)</MudTd>
                            <MudTd>@MesConMonto(detalle)</MudTd>
                            <MudTd><strong>@Money(DetalleTotal(detalle))</strong></MudTd>
                        </Row>
                    </GenericTable>
                </div>
            </div>
        }
    </MudContainer>
</AccessVerification>

<style>
    .solicitud-suficiencia-page .summary-strip,
    .solicitud-suficiencia-page .partida-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 10px;
        flex-shrink: 0;
    }

    .solicitud-suficiencia-page .summary-strip > div,
    .solicitud-suficiencia-page .partida-strip > div,
    .solicitud-suficiencia-page .summary-panel {
        border: 1px solid color-mix(in srgb, var(--eg-primary) 30%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--eg-primary) 7%, var(--mud-palette-surface));
    }

    .solicitud-suficiencia-page .summary-strip > div,
    .solicitud-suficiencia-page .partida-strip > div {
        padding: 8px 10px;
    }

    .solicitud-suficiencia-page .summary-strip span,
    .solicitud-suficiencia-page .partida-strip span,
    .solicitud-suficiencia-page .partida-strip small {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .72rem;
        text-transform: uppercase;
    }

    .solicitud-suficiencia-page .summary-strip strong,
    .solicitud-suficiencia-page .partida-strip strong,
    .solicitud-suficiencia-page .metric,
    .solicitud-suficiencia-page .main-cell,
    .solicitud-suficiencia-page .selected-name {
        font-weight: 700;
    }

    .solicitud-suficiencia-page .selected-header {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        flex-shrink: 0;
    }

    .solicitud-suficiencia-page .selected-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .solicitud-suficiencia-page .summary-panel {
        padding: 12px;
        flex-shrink: 0;
    }

    @@media (max-width: 760px) {
        .solicitud-suficiencia-page .summary-strip,
        .solicitud-suficiencia-page .partida-strip {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private GenericTable<SolicitudSuficienciaResponse> table = null!;
    private GenericTable<SolicitudSuficienciaDetalleResponse>? detalleTable;
    private SolicitudSuficienciaResponse? SelectedSolicitud;
    private List<SolicitudSuficienciaDetalleResponse> SelectedDetalles { get; set; } = new();
    private string detalleSearchString = string.Empty;
    protected override string ModuleName => "Presupuesto_Comprometido";
    protected override string SubModuleName => "Solicitud_Suficiencia";
    protected override Type CreateDialogType => typeof(object);
    protected override Type EditDialogType => typeof(object);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SolicitudSuficienciaResponse>);
    protected override string GetDefaultSortLabel() => "FechaSolicitud";

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    private decimal TotalSeleccionado => SelectedDetalles.Sum(DetalleTotal);
    private string MesAplicado => SelectedSolicitud?.FechaRequisicion.HasValue == true
        ? DateCulture.DateTimeFormat.GetMonthName(SelectedSolicitud.FechaRequisicion.Value.Month)
        : "-";

    private IEnumerable<PartidaResumen> PartidaResumenes => SelectedDetalles
        .GroupBy(x => new { x.FkidPartidaConta, x.PartidaClaveNombre })
        .Select(x => new PartidaResumen { Partida = x.Key.PartidaClaveNombre, Bienes = x.Count(), Total = x.Sum(DetalleTotal) })
        .OrderBy(x => x.Partida);

    protected override async Task VerifyAccess()
    {
        IsInitialized = true;
        CanExport = PageAuthProvider.HasPermission(ModuleName, SubModuleName, "CanExportToExcel");
        CanAuthorize = PageAuthProvider.HasPermission(ModuleName, SubModuleName, "authorize");
        CanView = PageAuthProvider.HasPermission(ModuleName, SubModuleName, "view") || CanExport || CanAuthorize;
        HasAccess = CanView;
        CanCreate = false;
        CanUpdate = false;
        CanDelete = false;

        if (!HasAccess)
        {
            Snackbar.Add("No tienes permisos para consultar solicitudes de suficiencia.", Severity.Warning);
            await Task.Delay(1200);
            NavigationManager.NavigateTo("/", replace: true);
        }

        Loading = false;
        StateHasChanged();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SolicitudSuficienciaResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidSolicitudSuficiencia,
            Requisicion = item.RequisicionDescripcion,
            FechaSolicitud = item.FechaSolicitud.ToString("dd/MM/yyyy"),
            FechaRequisicion = item.FechaRequisicion?.ToString("dd/MM/yyyy") ?? string.Empty,
            item.Justificacion,
            Estatus = item.EstatusDescripcion,
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override Task<string> GetItemNameForDelete(int id) => Task.FromResult("la solicitud de suficiencia");
    protected override async Task ReloadData()
    {
        if (SelectedSolicitud == null && table != null)
        {
            await table.ReloadData();
            return;
        }

        await RefreshSelectedAndDetails();
    }

    protected override Task CreateItem() => Task.CompletedTask;
    protected override Task EditItem(int id) => Task.CompletedTask;
    protected override Task DeleteItem(int id) => Task.CompletedTask;

    private async Task SelectSolicitud(SolicitudSuficienciaResponse item)
    {
        SelectedSolicitud = item;
        detalleSearchString = string.Empty;
        await LoadSelectedDetallesSummary();
        StateHasChanged();
    }

    private async Task RefreshSelectedAndDetails()
    {
        if (SelectedSolicitud == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedSolicitud.PkidSolicitudSuficiencia);
        if (response?.Success == true && response.Data != null)
        {
            SelectedSolicitud = response.Data;
        }

        await LoadSelectedDetallesSummary();
        await ReloadDetalles();
    }

    private void BackToTable()
    {
        SelectedSolicitud = null;
        SelectedDetalles.Clear();
        detalleSearchString = string.Empty;
        StateHasChanged();
    }

    private async Task AuthorizeSolicitud(SolicitudSuficienciaResponse solicitud)
    {
        if (!CanAuthorize)
        {
            Snackbar.Add("No tienes permiso para autorizar.", Severity.Warning);
            return;
        }

        if (IsAuthorized(solicitud))
        {
            Snackbar.Add("La solicitud ya se encuentra autorizada.", Severity.Info);
            return;
        }

        var details = await GetDetallesForSolicitud(solicitud.PkidSolicitudSuficiencia);
        if (details.Count == 0)
        {
            Snackbar.Add("La solicitud no tiene detalle para autorizar.", Severity.Warning);
            return;
        }

        var existing = await AutorizacionService.GetAllPaginadoAsync(
            1, 1, string.Empty, "PkidAutorizacionSuficiencia", SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = solicitud.PkidSolicitudSuficiencia });

        if (existing?.Items?.Any() == true)
        {
            Snackbar.Add("Ya existe una autorización para esta solicitud.", Severity.Warning);
            return;
        }

        var personaId = await GetCurrentPersonaId();
        if (!personaId.HasValue)
        {
            Snackbar.Add("No fue posible identificar la persona autorizadora del usuario actual.", Severity.Error);
            return;
        }

        if (!await ConfirmWorkflowAsync(
                "Autorizar solicitud de suficiencia",
                $"¿Seguro que deseas autorizar la solicitud {solicitud.PkidSolicitudSuficiencia}? Se generara la autorizacion con su detalle.",
                "Autorizar",
                Severity.Success,
                solicitud.PkidSolicitudSuficiencia))
        {
            return;
        }

        var authorization = new AutorizacionSuficienciaResponse
        {
            FkidEmpresaSis = solicitud.FkidEmpresaSis,
            FkidSolicitudSuficienciaPres = solicitud.PkidSolicitudSuficiencia,
            FechaSolicitud = solicitud.FechaSolicitud,
            FechaAutorizacion = DateOnly.FromDateTime(DateTime.Today),
            Justificacion = solicitud.Justificacion,
            GastoNoProgramable = solicitud.GastoNoProgramable,
            IdGastoNoProgramable = solicitud.IdGastoNoProgramable,
            IdCompromisoNomina = solicitud.IdCompromisoNomina,
            AutorizadoPorNom = personaId.Value,
            Observaciones = $"Autorizada desde solicitud {solicitud.PkidSolicitudSuficiencia}",
            Estatus = 2,
        };

        var authorizationDetails = details.Select(detail => new AutorizacionSuficienciaDetalleResponse
            {
                FkidEmpresaSis = detail.FkidEmpresaSis,
                FkidSolicitudSuficienciaPres = solicitud.PkidSolicitudSuficiencia,
                FkidRequisicionOrco = solicitud.FkidRequisicionOrco,
                RequisicionDescripcion = solicitud.RequisicionDescripcion,
                FkidSolicitudSuficienciaDetallePres = detail.PkidSolicitudSuficienciaDetalle,
                FkidRequisicionDetalleOrco = detail.FkidRequisicionDetalleOrco,
                FkidTipoBienAlma = detail.FkidTipoBienAlma,
                TipoBienClave = detail.TipoBienClave,
                TipoBienDescripcion = detail.TipoBienDescripcion,
                FkidUnidadesAlma = detail.FkidUnidadesAlma,
                UnidadMedida = detail.UnidadMedida,
                Cantidad = detail.Cantidad,
                FkidPartidaConta = detail.FkidPartidaConta,
                PartidaClave = detail.PartidaClave,
                PartidaDescripcion = detail.PartidaDescripcion,
                PartidaClaveNombre = detail.PartidaClaveNombre,
                Enero = detail.Enero,
                Febrero = detail.Febrero,
                Marzo = detail.Marzo,
                Abril = detail.Abril,
                Mayo = detail.Mayo,
                Junio = detail.Junio,
                Julio = detail.Julio,
                Agosto = detail.Agosto,
                Septiembre = detail.Septiembre,
                Octubre = detail.Octubre,
                Noviembre = detail.Noviembre,
                Diciembre = detail.Diciembre,
                Observaciones = detail.Observaciones,
            })
            .ToList();

        var parameters = new DialogParameters
        {
            ["PrefillItem"] = authorization,
            ["PrefillDetalles"] = authorizationDetails
        };

        var dialog = await DialogService.ShowAsync<AutorizacionSuficienciaDialog>(
            "Autorizar solicitud de suficiencia",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        if ((await dialog.Result) is not { Canceled: false })
        {
            return;
        }

        solicitud.Estatus = 3;
        await Service.UpdateAsync(solicitud, solicitud.PkidSolicitudSuficiencia);
        Snackbar.Add("Solicitud autorizada correctamente.", Severity.Success);
        await ReloadData();
    }

    private async Task<int?> GetCurrentPersonaId()
    {
        var authState = await PageAuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)
            ?? user.FindFirst("id")
            ?? user.FindFirst("Id");
        var userId = idClaim != null && int.TryParse(idClaim.Value, out var parsedUserId)
            ? parsedUserId
            : (int?)null;

        if (!userId.HasValue)
        {
            var fallbackUserId = await AuthService.GetUserIdAsync();
            userId = fallbackUserId > 0 ? fallbackUserId : null;
        }

        if (!userId.HasValue)
        {
            return null;
        }

        var usuario = await UsuarioService.GetByIdAsync(userId.Value);
        return usuario?.Data?.IdPersona ?? userId.Value;
    }

    private async Task<List<SolicitudSuficienciaDetalleResponse>> GetDetallesForSolicitud(int solicitudId)
    {
        var response = await DetalleService.GetAllPaginadoAsync(
            1,
            int.MaxValue,
            string.Empty,
            "PartidaClave",
            SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = solicitudId });

        return response?.Items?.ToList() ?? new List<SolicitudSuficienciaDetalleResponse>();
    }

    private async Task<TableData<SolicitudSuficienciaDetalleResponse>> LoadDetallesServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedSolicitud == null)
        {
            return new TableData<SolicitudSuficienciaDetalleResponse> { Items = new List<SolicitudSuficienciaDetalleResponse>(), TotalItems = 0 };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "PartidaClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = SelectedSolicitud.PkidSolicitudSuficiencia });

        return new TableData<SolicitudSuficienciaDetalleResponse>
        {
            Items = response?.Items ?? new List<SolicitudSuficienciaDetalleResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task LoadSelectedDetallesSummary()
    {
        if (SelectedSolicitud == null)
        {
            SelectedDetalles.Clear();
            return;
        }

        SelectedDetalles = await GetDetallesForSolicitud(SelectedSolicitud.PkidSolicitudSuficiencia);
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private static bool IsAuthorized(SolicitudSuficienciaResponse item) => item.Estatus == 3;
    private static Color EstatusColor(int estatus) => estatus switch { 1 => Color.Info, 2 => Color.Warning, 3 => Color.Success, 4 => Color.Error, _ => Color.Default };
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DateOrDash(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
    private static string DateTimeOrDash(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    private static string Money(decimal? value) => $"${(value ?? 0m).ToString("0.00", NumberCulture)}";
    private static string Quantity(decimal? value) => (value ?? 0m).ToString("0.00", NumberCulture);
    private static decimal DetalleTotal(SolicitudSuficienciaDetalleResponse item) =>
        item.Total ?? item.Enero.GetValueOrDefault() + item.Febrero.GetValueOrDefault() +
        item.Marzo.GetValueOrDefault() + item.Abril.GetValueOrDefault() +
        item.Mayo.GetValueOrDefault() + item.Junio.GetValueOrDefault() +
        item.Julio.GetValueOrDefault() + item.Agosto.GetValueOrDefault() +
        item.Septiembre.GetValueOrDefault() + item.Octubre.GetValueOrDefault() +
        item.Noviembre.GetValueOrDefault() + item.Diciembre.GetValueOrDefault();

    private static string MesConMonto(SolicitudSuficienciaDetalleResponse item)
    {
        var months = new[]
        {
            ("Ene", item.Enero), ("Feb", item.Febrero), ("Mar", item.Marzo), ("Abr", item.Abril),
            ("May", item.Mayo), ("Jun", item.Junio), ("Jul", item.Julio), ("Ago", item.Agosto),
            ("Sep", item.Septiembre), ("Oct", item.Octubre), ("Nov", item.Noviembre), ("Dic", item.Diciembre)
        };

        var month = months.FirstOrDefault(x => x.Item2.GetValueOrDefault() > 0m);
        return month.Item1 == null ? "-" : $"{month.Item1} {Money(month.Item2)}";
    }

    private sealed class PartidaResumen
    {
        public string Partida { get; set; } = string.Empty;
        public int Bienes { get; set; }
        public decimal Total { get; set; }
    }
}
