@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.PresupuestoComprometido
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<AutorizacionSuficienciaResponse> Service
@inject IGenericCrudService<AutorizacionSuficienciaDetalleResponse> DetalleService
@inject IGenericCrudService<SolicitudSuficienciaResponse> SolicitudService
@inject IGenericCrudService<PersonaResponse> PersonaService
@inject ISnackbar Snackbar
@inject SucursalStateService SucursalStateService

<BaseCrudDialog TItem="AutorizacionSuficienciaResponse" Title="@Title" MaxWidth="MaxWidth.Medium" ActionText="@ActionText" ProcessingText="@ProcessingText" CanConfirm="@(!_formLoading)" OnConfirm="SaveAsync">
    <BaseEntityForm TEntity="AutorizacionSuficienciaResponse" @ref="form" ShowHeader="true" HeaderTitle="@Title" Loading="@_formLoading" LoadingMessage="Preparando autorización..." LoadingSkeletonRows="8">
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <CrudFormSection Title="Origen y autorización">
                    <MudGrid Spacing="2">
<MudItem xs="12" md="4"><MudTextField Margin="Margin.Dense" T="string" Value="@EmpresaText" Label="Empresa" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <RelatedRecordSelect TResponse="SolicitudSuficienciaResponse"
                                     Label="Solicitud de suficiencia"
                                     SelectedId="@SelectedSolicitudId"
                                     SelectedIdChanged="OnSolicitudIdChanged"
                                     SelectedRecordChanged="OnSolicitudSelected"
                                     SelectedText="@SolicitudText"
                                     IdSelector="record => record.PkidSolicitudSuficiencia"
                                     TextSelector="SolicitudLabel"
                                     SortProperty="FechaSolicitud"
                                     AdditionalFilters="@SolicitudFilters"
                                     Required="true"
                                     RequiredError="Selecciona una solicitud." />
            </MudItem>
            <MudItem xs="12" md="4">
                <RelatedRecordSelect TResponse="PersonaResponse"
                                     Label="Autorizó"
                                     SelectedId="@SelectedAutorizadorId"
                                     SelectedIdChanged="OnAutorizadorIdChanged"
                                     SelectedRecordChanged="OnAutorizadorSelected"
                                     SelectedText="@AutorizadorText"
                                     IdSelector="record => record.PkidPersona"
                                     TextSelector="PersonaLabel"
                                     SortProperty="Nombre"
                                     AdditionalFilters="@AutorizadorFilters"
                                     Required="true"
                                     RequiredError="Selecciona a la persona que autorizó." />
            </MudItem>
            <MudItem xs="12" md="4"><MudDatePicker Margin="Margin.Dense" @bind-Date="fechaAutorizacion" Label="Fecha autorizacion" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect Margin="Margin.Dense" T="int" @bind-Value="item.Estatus" Label="Estatus" Variant="Variant.Outlined">
                    <MudSelectItem Value="1">Borrador</MudSelectItem>
                    <MudSelectItem Value="2">Autorizada</MudSelectItem>
                    <MudSelectItem Value="3">Cancelada</MudSelectItem>
                </MudSelect>
            </MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>

            <MudItem xs="12">
                <CrudFormSection Title="Clasificación y observaciones">
                    <MudGrid Spacing="2">
<MudItem xs="12" md="4"><MudTextField Margin="Margin.Dense" @bind-Value="item.GastoNoProgramable" Label="Gasto no programable" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Justificacion" Label="Justificacion" Required="true" Immediate="true" Lines="3" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField Margin="Margin.Dense" @bind-Value="item.Observaciones" Label="Observaciones" Lines="3" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </CrudFormSection>
            </MudItem>
</MudGrid>

        @if (!Id.HasValue && detalleItems.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700">Detalle que se generara al guardar</MudText>
            <GenericDataGrid TItem="AutorizacionSuficienciaDetalleResponse" @key="detalleItems"
                                 Items="@detalleItems"
                                 ShowToolbar="false"
                                 EnableColumnOptions="false"
                                 FixedHeader="false"
                                 TableHeight="auto"
                                 PageSize="50">
                    <Columns>
                        <TemplateColumn T="AutorizacionSuficienciaDetalleResponse" Title="Partida" Identifier="__local_0" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.PartidaClaveNombre)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="AutorizacionSuficienciaDetalleResponse" Title="Bien" Identifier="__local_1" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @TextOrDash(cell.Item.TipoBienDescripcion)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="AutorizacionSuficienciaDetalleResponse" Title="Cantidad" Identifier="__local_2" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                @Quantity(cell.Item.Cantidad)
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="AutorizacionSuficienciaDetalleResponse" Title="Total" Identifier="__local_3" Sortable="false" Filterable="false">
                            <CellTemplate Context="cell">
                                <strong>@Money(DetailTotal(cell.Item))</strong>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </GenericDataGrid>
        }
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public AutorizacionSuficienciaResponse? PrefillItem { get; set; }
    [Parameter] public IReadOnlyList<AutorizacionSuficienciaDetalleResponse>? PrefillDetalles { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<AutorizacionSuficienciaResponse> form = null!;
    private AutorizacionSuficienciaResponse item = new() { Activo = true, Estatus = 1 };
    private List<AutorizacionSuficienciaDetalleResponse> detalleItems = new();
    private DateTime? fechaAutorizacion = DateTime.Today;
    private bool _formLoading = true;
    private int? SelectedSolicitudId
    {
        get => item.FkidSolicitudSuficienciaPres > 0 ? item.FkidSolicitudSuficienciaPres : null;
        set => item.FkidSolicitudSuficienciaPres = value.GetValueOrDefault();
    }
    private int? SelectedAutorizadorId
    {
        get => item.AutorizadoPorNom > 0 ? item.AutorizadoPorNom : null;
        set => item.AutorizadoPorNom = value.GetValueOrDefault();
    }
    private string SolicitudText => string.IsNullOrWhiteSpace(item.RequisicionDescripcion) ? string.Empty : item.RequisicionDescripcion;
    private string AutorizadorText => string.IsNullOrWhiteSpace(item.AutorizadoPorNombre) ? string.Empty : item.AutorizadoPorNombre;
    private Dictionary<string, object> SolicitudFilters => item.FkidEmpresaSis > 0
        ? new Dictionary<string, object> { ["FkidEmpresaSis"] = item.FkidEmpresaSis, ["Activo"] = true }
        : new Dictionary<string, object> { ["Activo"] = true };
    private Dictionary<string, object> AutorizadorFilters => item.FkidEmpresaSis > 0
        ? new Dictionary<string, object> { ["FkidEmpresaSis"] = item.FkidEmpresaSis, ["Activo"] = true }
        : new Dictionary<string, object> { ["Activo"] = true };

    private static readonly CultureInfo Culture = CultureInfo.InvariantCulture;
    private string Title => Id.HasValue ? "Editar autorizacion" : "Nueva autorizacion";
    private string ActionText => Id.HasValue ? "Actualizar" : "Guardar autorizacion";
    private string ProcessingText => Id.HasValue ? "Actualizando..." : "Guardando...";

    protected override async Task OnInitializedAsync()
    {
        await EnsureEmpresaAsync();

        try
        {
            if (!Id.HasValue)
            {
                if (PrefillItem != null)
                {
                    item = CloneHeader(PrefillItem);
                    fechaAutorizacion = item.FechaAutorizacion.ToDateTime(TimeOnly.MinValue);
                }

                detalleItems = PrefillDetalles?.Select(CloneDetail).ToList() ?? new List<AutorizacionSuficienciaDetalleResponse>();
                return;
            }

            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Data != null)
            {
                item = response.Data;
                fechaAutorizacion = item.FechaAutorizacion.ToDateTime(TimeOnly.MinValue);
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        await EnsureEmpresaAsync();

        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        if (item.FkidSolicitudSuficienciaPres <= 0 || item.AutorizadoPorNom <= 0)
        {
            Snackbar.Add("Selecciona la solicitud y la persona que autorizó.", Severity.Warning);
            return;
        }

        item.FechaAutorizacion = DateOnly.FromDateTime(fechaAutorizacion ?? DateTime.Today);
        var result = Id.HasValue ? await Service.UpdateAsync(item, Id.Value) : await Service.CreateAsync(item);
        if (result?.Success == true)
        {
            Snackbar.Add(Id.HasValue ? "Autorizacion actualizada correctamente." : "Autorizacion y detalle guardados correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Data ?? item));
            return;
        }

        Snackbar.Add(result?.Message ?? "No fue posible guardar la autorizacion.", Severity.Error);
    }

    private async Task<int> ResolveCreatedId(EG.Web.Models.ApiResponse<AutorizacionSuficienciaResponse> result)
    {
        var createdId = result.Data?.PkidAutorizacionSuficiencia
            ?? result.Items?.FirstOrDefault()?.PkidAutorizacionSuficiencia
            ?? 0;

        if (createdId > 0 || item.FkidSolicitudSuficienciaPres <= 0)
        {
            return createdId;
        }

        var created = await Service.GetAllPaginadoAsync(
            1,
            1,
            string.Empty,
            "PkidAutorizacionSuficiencia",
            SortDirection.Descending,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = item.FkidSolicitudSuficienciaPres });

        return created?.Items?.FirstOrDefault()?.PkidAutorizacionSuficiencia ?? 0;
    }

    private static AutorizacionSuficienciaResponse CloneHeader(AutorizacionSuficienciaResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidSolicitudSuficienciaPres = source.FkidSolicitudSuficienciaPres,
        FkidRequisicionOrco = source.FkidRequisicionOrco,
        FechaSolicitud = source.FechaSolicitud,
        FechaAutorizacion = source.FechaAutorizacion,
        Justificacion = source.Justificacion,
        GastoNoProgramable = source.GastoNoProgramable,
        IdGastoNoProgramable = source.IdGastoNoProgramable,
        IdCompromisoNomina = source.IdCompromisoNomina,
        AutorizadoPorNom = source.AutorizadoPorNom,
        Observaciones = source.Observaciones,
        Estatus = source.Estatus,
        Activo = source.Activo
    };

    private static AutorizacionSuficienciaDetalleResponse CloneDetail(AutorizacionSuficienciaDetalleResponse source) => new()
    {
        FkidEmpresaSis = source.FkidEmpresaSis,
        FkidSolicitudSuficienciaPres = source.FkidSolicitudSuficienciaPres,
        FkidRequisicionOrco = source.FkidRequisicionOrco,
        RequisicionDescripcion = source.RequisicionDescripcion,
        FkidSolicitudSuficienciaDetallePres = source.FkidSolicitudSuficienciaDetallePres,
        FkidRequisicionDetalleOrco = source.FkidRequisicionDetalleOrco,
        FkidTipoBienAlma = source.FkidTipoBienAlma,
        TipoBienClave = source.TipoBienClave,
        TipoBienDescripcion = source.TipoBienDescripcion,
        FkidUnidadesAlma = source.FkidUnidadesAlma,
        UnidadMedida = source.UnidadMedida,
        Cantidad = source.Cantidad,
        FkidPartidaConta = source.FkidPartidaConta,
        PartidaClave = source.PartidaClave,
        PartidaDescripcion = source.PartidaDescripcion,
        PartidaClaveNombre = source.PartidaClaveNombre,
        Enero = source.Enero,
        Febrero = source.Febrero,
        Marzo = source.Marzo,
        Abril = source.Abril,
        Mayo = source.Mayo,
        Junio = source.Junio,
        Julio = source.Julio,
        Agosto = source.Agosto,
        Septiembre = source.Septiembre,
        Octubre = source.Octubre,
        Noviembre = source.Noviembre,
        Diciembre = source.Diciembre,
        Observaciones = source.Observaciones,
        Activo = source.Activo
    };

    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal value) => $"${value.ToString("0.00", Culture)}";
    private static string Quantity(decimal? value) => (value ?? 0m).ToString("0.00", Culture);
    private static decimal DetailTotal(AutorizacionSuficienciaDetalleResponse item) =>
        item.Total ?? item.Enero.GetValueOrDefault() + item.Febrero.GetValueOrDefault() +
        item.Marzo.GetValueOrDefault() + item.Abril.GetValueOrDefault() +
        item.Mayo.GetValueOrDefault() + item.Junio.GetValueOrDefault() +
        item.Julio.GetValueOrDefault() + item.Agosto.GetValueOrDefault() +
        item.Septiembre.GetValueOrDefault() + item.Octubre.GetValueOrDefault() +
        item.Noviembre.GetValueOrDefault() + item.Diciembre.GetValueOrDefault();
    private string EmpresaText => item.FkidEmpresaSis > 0
        ? string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
            ? "Empresa seleccionada"
            : SucursalStateService.EmpresaNombre
        : "Sin empresa seleccionada";

    private Task OnSolicitudIdChanged(int? value)
    {
        SelectedSolicitudId = value;
        return Task.CompletedTask;
    }

    private Task OnSolicitudSelected(SolicitudSuficienciaResponse? record)
    {
        if (record is null)
        {
            item.RequisicionDescripcion = null;
            item.FkidRequisicionOrco = 0;
            item.FkidAnioSis = null;
            return Task.CompletedTask;
        }

        item.FkidEmpresaSis = record.FkidEmpresaSis;
        item.FkidRequisicionOrco = record.FkidRequisicionOrco;
        item.FkidAnioSis = record.FkidAnioSis;
        item.RequisicionDescripcion = record.RequisicionDescripcion;
        return Task.CompletedTask;
    }

    private Task OnAutorizadorIdChanged(int? value)
    {
        SelectedAutorizadorId = value;
        return Task.CompletedTask;
    }

    private Task OnAutorizadorSelected(PersonaResponse? record)
    {
        item.AutorizadoPorNombre = record is null ? null : PersonaLabel(record);
        return Task.CompletedTask;
    }

    private static string SolicitudLabel(SolicitudSuficienciaResponse record)
    {
        var text = string.Join(" · ", new[]
        {
            record.RequisicionDescripcion,
            record.FechaSolicitud.ToString("dd/MM/yyyy"),
            record.EstatusDescripcion
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "Solicitud de suficiencia" : text;
    }

    private static string PersonaLabel(PersonaResponse record)
    {
        var name = string.Join(" ", new[] { record.Nombre, record.Paterno, record.Materno }
            .Where(value => !string.IsNullOrWhiteSpace(value))).Trim();
        return string.IsNullOrWhiteSpace(name)
            ? (string.IsNullOrWhiteSpace(record.Clave) ? "Persona sin nombre" : record.Clave)
            : string.IsNullOrWhiteSpace(record.Clave) ? name : $"{record.Clave} - {name}";
    }

    private async Task EnsureEmpresaAsync()
    {
        await SucursalStateService.InitializeAsync();
        if (item.FkidEmpresaSis > 0)
        {
            return;
        }

        var empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();
        if (empresaId is > 0)
        {
            item.FkidEmpresaSis = empresaId.Value;
        }
    }

}
