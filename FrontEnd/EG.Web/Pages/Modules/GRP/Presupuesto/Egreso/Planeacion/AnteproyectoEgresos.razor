@page "/Presupuesto/Egreso/Planeacion/Anteproyecto_Egresos"
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MiniExcelLibs
@using MudBlazor
@using System.Globalization
@implements IDisposable
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject IJSRuntime JS
@inject HttpClient Http
@inherits BaseCrudPage<EgresoProyectadoResponse, EgresoProyectadoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column anteproyecto-page" MaxWidth="MaxWidth.False" Style="min-height: 100%;">
        <PageHeader Title="Anteproyecto de Egresos"
                    Subtitle="Planeacion mensual por programa, partida y area"
                    Icon="@Icons.Material.Filled.StackedLineChart"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()">
            <AdditionalButtons>
                <MudTooltip Text="Alta desde Excel">
                    <MudButton StartIcon="@Icons.Material.Filled.AutoAwesome"
                               Visible="@CanCreate"
                               OnClick="OpenAiImport"
                               Disabled="@IsBusy"
                               Size="Size.Small" />
                </MudTooltip>
            </AdditionalButtons>
        </PageHeader>

        <div class="summary-strip">
            <div>
                <span class="summary-label">Total proyectado</span>
                <strong>@Money(Elements.Sum(x => x.Total ?? 0m))</strong>
            </div>
            <div>
                <span class="summary-label">Registros</span>
                <strong>@TotalCount.ToString("N0")</strong>
            </div>
            <div>
                <span class="summary-label">Moneda base</span>
                <strong>@_currencyName (@_currencySymbol)</strong>
            </div>
        </div>

        <div Style="flex: 1 1 auto; min-height: 420px; overflow: visible;">
            <GenericDataGrid TItem="EgresoProyectadoResponse"
                          @ref="table"
                          Title="Partidas del anteproyecto"
                          SearchPlaceholder="Buscar programa, partida, area, fuente, destino, PY o descripcion..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="(s) => SearchString = s"
                          OnSearch="OnSearch"
                          OnRowDoubleClick="OpenDetail">
            <Columns>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <div>
                        <MudTooltip Text="Autorizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Verified"
                        Visible="@(CanUpdate && !cell.Item.EstaAutorizado)"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="@(() => AutorizarEgreso(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Quitar autorizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.LockOpen"
                        Visible="@(CanUpdate && cell.Item.EstaAutorizado && cell.Item.PkidEgresoAutorizado.HasValue)"
                        Color="Color.Warning"
                        Size="Size.Small"
                        OnClick="@(() => DesautorizarEgreso(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="@(cell.Item.EstaAutorizado ? "Ver anteproyecto" : "Editar")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="@(cell.Item.EstaAutorizado ? Color.Info : Color.Primary)"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidEgresoProyectado))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Planeacion"
                        SubModulo="Anteproyecto_Egresos"
                        Controlador="EgresoProyectado"
                        EntidadId="@cell.Item.PkidEgresoProyectado"
                        RegistroTitulo="@TextOrDash(cell.Item.ProgramaClaveNombre ?? cell.Item.ProgramaClave)"
                        RegistroDescripcion="@TextOrDash(cell.Item.Descripcion)" />
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@(CanDelete && !cell.Item.EstaAutorizado)"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteEgreso(cell.Item))" />
                        </MudTooltip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Programa" Identifier="ProgramaClave" PropertyName="ProgramaClave" SortBy="x => x.ProgramaClave">
                    <CellTemplate Context="cell">
                        <div>
                        <div class="main-cell">@TextOrDash(cell.Item.ProgramaClave)</div>
                        <span>@TextOrDash(cell.Item.ProgramaDescripcion)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Partida" Identifier="PartidaClave" PropertyName="PartidaClave" SortBy="x => x.PartidaClave">
                    <CellTemplate Context="cell">
                        <div>
                        <div class="main-cell">@TextOrDash(cell.Item.PartidaClave)</div>
                        <span>@TextOrDash(cell.Item.PartidaDescripcion)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Area" Identifier="AreaNombre" PropertyName="AreaNombre" SortBy="x => x.AreaNombre">
                    <CellTemplate Context="cell">
                        <div>
                        @TextOrDash(cell.Item.AreaNombre)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Clasificacion" Identifier="FuenteFinanciamientoClave" PropertyName="FuenteFinanciamientoClave" SortBy="x => x.FuenteFinanciamientoClave">
                    <CellTemplate Context="cell">
                        <div>
                        <div class="main-cell">@TextOrDash(cell.Item.FuenteFinanciamientoClaveNombre)</div>
                        <span>TG: @TextOrDash(cell.Item.TipoGastoClaveNombre)</span><br />
                        <span>DI: @TextOrDash(cell.Item.DigitoIdentificadorClaveNombre)</span><br />
                        <span>DG: @TextOrDash(cell.Item.DestinoGastoClaveNombre)</span><br />
                        <span>PY: @TextOrDash(cell.Item.PyClaveNombre)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Descripcion" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        <div>
                        @TextOrDash(cell.Item.Descripcion)
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Meses" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div>
                        <div class="month-spark">
                        @foreach (var month in GetMonths(cell.Item))
                        {
                        <span title="@($"{month.Label}: {Money(month.Amount)}")"
                        style="height:@GetMonthHeight(month.Amount, cell.Item.Total ?? 0m)%"></span>
                        }
                        </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EgresoProyectadoResponse" Title="Total" Identifier="Total" PropertyName="Total" SortBy="x => x.Total">
                    <CellTemplate Context="cell">
                        <div>
                        <strong>@Money(cell.Item.Total ?? 0m)</strong>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .anteproyecto-page .summary-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .anteproyecto-page .summary-strip > div {
        min-width: 0;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px 12px;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        box-shadow: var(--mud-elevation-1);
    }

    .anteproyecto-page .summary-label {
        display: block;
        font-size: .72rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

    .anteproyecto-page .summary-strip strong {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--mud-palette-text-primary);
        font-size: 1.05rem;
        line-height: 1.35;
    }

    .anteproyecto-page .main-cell {
        font-weight: 700;
        line-height: 1.1;
    }

    .anteproyecto-page .mud-table-row {
        cursor: pointer;
    }

    .anteproyecto-page td span {
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
    }

    .month-spark {
        display: grid;
        grid-template-columns: repeat(12, 6px);
        align-items: end;
        gap: 3px;
        height: 34px;
        min-width: 105px;
    }

    .month-spark span {
        display: block;
        min-height: 4px;
        border-radius: 4px 4px 0 0;
        background: var(--eg-primary);
    }
</style>

@code {
    private GenericDataGrid<EgresoProyectadoResponse> table = null!;
    private string _currencySymbol = "$";
    private string _currencyName = "Peso Mexicano";

    protected override string ModuleName => "Planeacion";
    protected override string SubModuleName => "Anteproyecto_Egresos";
    protected override Type CreateDialogType => typeof(AnteproyectoEgresosDialog);
    protected override Type EditDialogType => typeof(AnteproyectoEgresosDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EgresoProyectadoResponse>);

    protected override string GetDefaultSortLabel() => "ProgramaClave";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        await SucursalStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await LoadCurrencyAsync();
    }

    protected override async Task<TableData<EgresoProyectadoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var page = Math.Max(1, state.Page + 1);
            CurrentPage = page;
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
                return new TableData<EgresoProyectadoResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId!.Value });

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrWhiteSpace(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<EgresoProyectadoResponse> { Items = Elements, TotalItems = TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<EgresoProyectadoResponse> { Items = new List<EgresoProyectadoResponse>(), TotalItems = 0 };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task CreateItem()
    {
        await RunExclusiveAsync(async () =>
        {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AnioId"] = AnioStateService.AnioId!.Value,
            ["CurrencySymbol"] = _currencySymbol,
            ["CurrencyName"] = _currencyName
        };

        var dialog = await DialogService.ShowAsync(CreateDialogType, "Crear anteproyecto", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
        }, "Operacion en proceso...");
    }

    protected override async Task EditItem(int id)
    {
        await RunExclusiveAsync(async () =>
        {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var isAuthorized = Elements.FirstOrDefault(x => x.PkidEgresoProyectado == id)?.EstaAutorizado == true;

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["AnioId"] = AnioStateService.AnioId ?? 0,
            ["CurrencySymbol"] = _currencySymbol,
            ["CurrencyName"] = _currencyName,
            ["IsReadOnly"] = isAuthorized
        };

        var dialogTitle = isAuthorized ? "Ver anteproyecto autorizado" : "Editar anteproyecto";
        var dialog = await DialogService.ShowAsync(EditDialogType, dialogTitle, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
        }, "Operacion en proceso...");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EgresoProyectadoResponse> items)
    {
        return items.Select(x => new
        {
            ID = x.PkidEgresoProyectado,
            Anio = x.AnioClave,
            Programa = x.ProgramaClaveNombre,
            Partida = x.PartidaClaveNombre,
            Area = x.AreaNombre,
            FuenteFinanciamiento = x.FuenteFinanciamientoClaveNombre,
            TipoGasto = x.TipoGastoClaveNombre,
            DigitoIdentificador = x.DigitoIdentificadorClaveNombre,
            DestinoGasto = x.DestinoGastoClaveNombre,
            PY = x.PyClaveNombre,
            x.Descripcion,
            Fecha = x.Fecha.ToString("dd/MM/yyyy"),
            x.Enero,
            x.Febrero,
            x.Marzo,
            x.Abril,
            x.Mayo,
            x.Junio,
            x.Julio,
            x.Agosto,
            x.Septiembre,
            x.Octubre,
            x.Noviembre,
            x.Diciembre,
            x.Total,
            x.Activo,
            x.UsuarioCreacion,
            x.FechaCreacion,
            x.UsuarioModificacion,
            x.FechaModificacion
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.PartidaClaveNombre ?? "el anteproyecto";
    }

    private async Task<List<EgresoProyectadoResponse>> LoadAnteproyectoExportItemsAsync()
    {
        var items = new List<EgresoProyectadoResponse>();
        var page = 1;
        var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
        var filters = new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId!.Value };

        while (items.Count < MaxExportRows)
        {
            var response = await Service.GetAllPaginadoAsync(
                page,
                ExportPageSize,
                SearchString,
                sortLabel,
                SortDirection,
                filters);

            if (response?.Success != true)
            {
                throw new InvalidOperationException(response?.Message ?? "No fue posible obtener los datos para exportar.");
            }

            var pageItems = response.Items?.ToList() ?? new List<EgresoProyectadoResponse>();
            if (pageItems.Count == 0)
            {
                break;
            }

            items.AddRange(pageItems);

            if (items.Count >= response.TotalCount || pageItems.Count < ExportPageSize)
            {
                break;
            }

            page++;
        }

        if (items.Count >= MaxExportRows)
        {
            Snackbar.Add($"La exportacion se limito a {MaxExportRows:N0} registros. Ajusta filtros para exportar menos datos.", Severity.Warning);
        }

        return items;
    }

    protected override async Task ExportToExcel()
    {
        await RunExclusiveAsync(async () =>
        {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var exportItems = await LoadAnteproyectoExportItemsAsync();

            if (!exportItems.Any())
            {
                Snackbar.Add("No hay datos para exportar", Severity.Warning);
                return;
            }

            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(MapToExcelData(exportItems));

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{AnioStateService.AnioClave}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportacion exitosa: {exportItems.Count} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
        }, "Operacion en proceso...");
    }

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }

    private async Task DeleteEgreso(EgresoProyectadoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
        if (item.EstaAutorizado)
        {
            Snackbar.Add("El anteproyecto ya fue autorizado y no puede eliminarse.", Severity.Warning);
            return;
        }

        var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar anteproyecto de {TextOrDash(item.PartidaClaveNombre)}?");
        if (!confirm)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/EgresoProyectado/{item.PkidEgresoProyectado}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Anteproyecto eliminado correctamente", Severity.Success);
                await ReloadData();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el anteproyecto", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        }, "Operacion en proceso...");
    }

    private async Task AutorizarEgreso(EgresoProyectadoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
        if (item.EstaAutorizado)
        {
            Snackbar.Add("El anteproyecto ya esta autorizado.", Severity.Info);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (!await ConfirmWorkflowAsync(
                "Autorizar anteproyecto de egresos",
                $"¿Seguro que deseas autorizar el anteproyecto {TextOrDash(item.Descripcion)}? Esto generara el presupuesto autorizado.",
                "Autorizar",
                Severity.Success,
                item.PkidEgresoProyectado))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["AnioId"] = AnioStateService.AnioId!.Value,
            ["CurrencySymbol"] = _currencySymbol,
            ["CurrencyName"] = _currencyName,
            ["IsAuthorizationFlow"] = true,
            ["PrefillItem"] = MapToAutorizado(item)
        };

        var dialog = await DialogService.ShowAsync(typeof(PresupuestoAutorizadoDialog), "Autorizar presupuesto", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
        }, "Operacion en proceso...");
    }

    private async Task DesautorizarEgreso(EgresoProyectadoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
        if (!item.EstaAutorizado || !item.PkidEgresoAutorizado.HasValue)
        {
            Snackbar.Add("El anteproyecto no tiene un presupuesto autorizado activo.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EgresoAutorizadoId"] = item.PkidEgresoAutorizado.Value,
            ["Programa"] = item.ProgramaClaveNombre,
            ["Partida"] = item.PartidaClaveNombre,
            ["Area"] = item.AreaNombre,
            ["FuenteFinanciamiento"] = item.FuenteFinanciamientoClaveNombre,
            ["Descripcion"] = item.Descripcion,
            ["Total"] = Money(item.Total ?? 0m),
            ["FechaAutorizacion"] = item.FechaAutorizacion?.ToString("dd/MM/yyyy HH:mm"),
            ["DialogTitle"] = "Quitar autorizacion",
            ["DialogSubtitle"] = "El anteproyecto dejara de estar autorizado.",
            ["DialogIcon"] = Icons.Material.Filled.LockOpen,
            ["WarningText"] = "Esta accion quitara la autorizacion vigente del anteproyecto.",
            ["EffectText"] = "El autorizado se conservara como registro inactivo para trazabilidad. El anteproyecto podra editarse o autorizarse nuevamente.",
            ["ConfirmCheckText"] = "Entiendo que se quitara la autorizacion vigente",
            ["ConfirmText"] = "Quitar autorizacion",
            ["SuccessFallbackMessage"] = "Autorizacion quitada correctamente.",
            ["ErrorFallbackMessage"] = "No fue posible quitar la autorizacion.",
            ["ErrorPrefix"] = "Error al quitar la autorizacion"
        };

        var dialog = await DialogService.ShowAsync(typeof(RegresarAProyectadoDialog), "Quitar autorizacion", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
        }, "Operacion en proceso...");
    }

    private async Task OpenDetail(EgresoProyectadoResponse item)
    {
        await RunExclusiveAsync(async () =>
        {
            var parameters = new DialogParameters
            {
                ["Record"] = CinematicRecordFactory.ForAnteproyecto(item, _currencySymbol, _currencyName)
            };

            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = false };
            var dialog = await DialogService.ShowAsync<CinematicRecordDialog>(string.Empty, parameters, options);
            await dialog.Result;
        }, "Operacion en proceso...");
    }

    private async Task OpenAiImport()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear anteproyecto.", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        await SucursalStateService.InitializeAsync();
        if (!HasSelectedEmpresa())
        {
            Snackbar.Add("Selecciona una empresa en el encabezado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["CurrencySymbol"] = _currencySymbol,
            ["EmpresaId"] = SucursalStateService.EmpresaId,
            ["EmpresaNombre"] = SucursalStateService.EmpresaNombreCorto ?? SucursalStateService.EmpresaNombre
        };

        var dialog = await DialogService.ShowAsync<AnteproyectoEgresosAiImportDialog>(
            "Alta desde Excel",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadData();
    }

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                    _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa) ? "Peso Mexicano" : response.Data.MonedaBaseEmpresa;
                }
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("AnteproyectoEgresos")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para el anteproyecto.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }

    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);

    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private bool HasSelectedEmpresa() =>
        SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private string Money(decimal amount) => $"{_currencySymbol}{amount.ToString("0.00", NumberCulture)}";

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static int GetMonthHeight(decimal amount, decimal total)
    {
        if (amount <= 0 || total <= 0)
            return 10;

        return Math.Clamp((int)Math.Round((amount / total) * 100m * 3m), 12, 100);
    }

    private static IEnumerable<(string Label, decimal Amount)> GetMonths(EgresoProyectadoResponse item)
    {
        yield return ("Ene", item.Enero);
        yield return ("Feb", item.Febrero);
        yield return ("Mar", item.Marzo);
        yield return ("Abr", item.Abril);
        yield return ("May", item.Mayo);
        yield return ("Jun", item.Junio);
        yield return ("Jul", item.Julio);
        yield return ("Ago", item.Agosto);
        yield return ("Sep", item.Septiembre);
        yield return ("Oct", item.Octubre);
        yield return ("Nov", item.Noviembre);
        yield return ("Dic", item.Diciembre);
    }

