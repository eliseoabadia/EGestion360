@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor
@using System.Globalization

@inject IGenericCrudService<EgresoAutorizadoResponse> Service
@inject IGenericCrudService<ProgramaResponse> ProgramaService
@inject IGenericCrudService<PartidaResponse> PartidaService
@inject IGenericCrudService<UsuarioAreaResponse> AreaService
@inject HttpClient Http
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="EgresoAutorizadoResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.ExtraExtraLarge"
                ActionColor="@actionColor"
                ActionIcon="@actionIcon"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando presupuesto autorizado..."
                CanConfirm="@(!_formLoading)"
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="EgresoAutorizadoResponse"
                    @ref="form"
                    ShowHeader="false"
                    Loading="@_formLoading"
                    LoadingMessage="Preparando presupuesto autorizado..."
                    LoadingSkeletonRows="14">

        <MudGrid GutterSize="1" Class="presupuesto-autorizado-dialog">
            <MudItem xs="12">
                <div class="budget-ribbon">
                    <div>
                        <span>Anio presupuestal</span>
                        <strong>@BudgetYearText</strong>
                    </div>
                    <div>
                        <span>Total autorizado @CurrencyDisplay</span>
                        <strong>@Money(TotalMeses)</strong>
                    </div>
                    <div>
                        <span>Promedio @CurrencyDisplay</span>
                        <strong>@Money(TotalMeses / 12m)</strong>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedPrograma"
                                   ValueChanged="value => _selectedPrograma = value"
                                   Label="Programa"
                                   Required="true"
                                   RequiredError="El programa es requerido"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadProgramasPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedPartida"
                                   ValueChanged="value => _selectedPartida = value"
                                   Label="Partida"
                                   Required="true"
                                   RequiredError="La partida es requerida"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadPartidasPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedArea"
                                   ValueChanged="value => _selectedArea = value"
                                   Label="Area"
                                   Required="true"
                                   RequiredError="El area es requerida"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadAreasPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_fecha"
                               Label="Fecha"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Culture="@DateCulture"
                               Required="true"
                               RequiredError="La fecha es requerida"
                               Disabled="@SourceFieldsLocked" />
            </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripcion"
                              Variant="Variant.Outlined"
                              MaxLength="250"
                              Disabled="@SourceFieldsLocked" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedFuenteFinanciamiento"
                                   ValueChanged="value => _selectedFuenteFinanciamiento = value"
                                   Label="Fuente de financiamiento"
                                   Clearable="true"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadFuentesFinanciamientoPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedTipoGasto"
                                   ValueChanged="value => _selectedTipoGasto = value"
                                   Label="Tipo de gasto"
                                   Clearable="true"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadTiposGastoPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedDigitoIdentificador"
                                   ValueChanged="value => _selectedDigitoIdentificador = value"
                                   Label="Digito identificador"
                                   Clearable="true"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadDigitosIdentificadorPageAsync" />
            </MudItem>

            <MudItem xs="12" md="4">
                <PagedAutocomplete Value="@_selectedDestinoGasto"
                                   ValueChanged="value => _selectedDestinoGasto = value"
                                   Label="Destino de gasto"
                                   Clearable="true"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadDestinosGastoPageAsync" />
            </MudItem>

            <MudItem xs="12" md="8">
                <PagedAutocomplete Value="@_selectedPy"
                                   ValueChanged="value => _selectedPy = value"
                                   Label="PY"
                                   Clearable="true"
                                   Disabled="@SourceFieldsLocked"
                                   LoadPage="LoadPyPageAsync" />
            </MudItem>

            <MudItem xs="12">
                <div class="months-panel">
                    <div class="months-header">
                        <div>
                            <MudText Typo="Typo.subtitle1">Distribucion mensual</MudText>
                            <MudText Typo="Typo.caption">Captura el monto autorizado por mes.</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@Money(TotalMeses)</MudChip>
                    </div>

                    <MudGrid GutterSize="1">
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Enero" Label="Enero" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Febrero" Label="Febrero" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Marzo" Label="Marzo" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Abril" Label="Abril" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Mayo" Label="Mayo" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Junio" Label="Junio" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Julio" Label="Julio" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Agosto" Label="Agosto" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Septiembre" Label="Septiembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Octubre" Label="Octubre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Noviembre" Label="Noviembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                        <MudItem xs="12" sm="6" md="2"><MudNumericField @bind-Value="item.Diciembre" Label="Diciembre" Variant="Variant.Outlined" Format="0.00" Culture="@NumberCulture" Min="0m" Disabled="@AmountsLocked" Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" /></MudItem>
                    </MudGrid>
                </div>
            </MudItem>

            @if (Id.HasValue)
            {
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="item.Activo" Label="Registro activo" Color="Color.Success" Disabled="@SourceFieldsLocked" />
                </MudItem>
            }
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

<style>
    .presupuesto-autorizado-dialog .budget-ribbon {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 2px;
    }

    .presupuesto-autorizado-dialog .budget-ribbon > div,
    .presupuesto-autorizado-dialog .months-panel {
        border: 1px solid color-mix(in srgb, var(--eg-primary) 38%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--eg-primary) 8%, var(--mud-palette-surface));
        box-shadow: inset 0 1px 0 color-mix(in srgb, var(--mud-palette-white) 5%, transparent);
    }

    .presupuesto-autorizado-dialog .budget-ribbon > div {
        padding: 8px 10px;
    }

    .presupuesto-autorizado-dialog .budget-ribbon span {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .72rem;
        text-transform: uppercase;
    }

    .presupuesto-autorizado-dialog .budget-ribbon strong,
    .presupuesto-autorizado-dialog .months-header .mud-typography {
        color: var(--mud-palette-text-primary);
    }

    .presupuesto-autorizado-dialog .months-panel {
        padding: 10px;
        color: var(--mud-palette-text-primary);
    }

    .presupuesto-autorizado-dialog .months-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .presupuesto-autorizado-dialog .months-header .mud-typography-caption {
        color: var(--mud-palette-text-secondary);
    }

    .presupuesto-autorizado-dialog .months-panel .mud-input,
    .presupuesto-autorizado-dialog .months-panel .mud-input input,
    .presupuesto-autorizado-dialog .months-panel .mud-input-adornment,
    .presupuesto-autorizado-dialog .months-panel .mud-input-label {
        color: var(--mud-palette-text-primary);
    }

    .presupuesto-autorizado-dialog .months-panel .mud-input-outlined-border {
        border-color: color-mix(in srgb, var(--mud-palette-text-secondary) 50%, transparent);
    }

    .presupuesto-autorizado-dialog .months-panel input::selection {
        color: var(--eg-on-primary);
        background: var(--eg-primary);
    }

    @@media (max-width: 760px) {
        .presupuesto-autorizado-dialog .budget-ribbon {
            grid-template-columns: 1fr;
        }

        .presupuesto-autorizado-dialog .months-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int AnioId { get; set; }
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public string CurrencyName { get; set; } = "Peso Mexicano";
    [Parameter] public EgresoAutorizadoResponse? PrefillItem { get; set; }
    [Parameter] public bool IsAuthorizationFlow { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<EgresoAutorizadoResponse> form = null!;
    private EgresoAutorizadoResponse item = new()
    {
        Activo = true,
        Fecha = DateOnly.FromDateTime(DateTime.Today),
        FechaAutorizacion = DateTime.Now
    };

    private DateTime? _fecha = DateTime.Today;
    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedPartida;
    private LookupItem? _selectedArea;
    private LookupItem? _selectedFuenteFinanciamiento;
    private LookupItem? _selectedTipoGasto;
    private LookupItem? _selectedDigitoIdentificador;
    private LookupItem? _selectedDestinoGasto;
    private LookupItem? _selectedPy;
    private bool _formLoading = true;

    private string dialogTitle => IsAuthorizationFlow ? "Autorizar Presupuesto de Egresos" : Id.HasValue ? "Editar Presupuesto Autorizado" : "Nuevo Presupuesto Autorizado";
    private string actionText => IsAuthorizationFlow ? "Firmar y guardar" : Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => IsAuthorizationFlow ? "Autorizando..." : Id.HasValue ? "Actualizando..." : "Creando...";
    private Color actionColor => IsAuthorizationFlow ? Color.Success : Color.Primary;
    private string actionIcon => IsAuthorizationFlow ? Icons.Material.Filled.Verified : Icons.Material.Filled.Save;
    private string BudgetYearText => AnioStateService.AnioClave?.ToString() ?? AnioId.ToString();
    private string CurrencyDisplay => $"({CurrencyName} {CurrencySymbol})";
    private bool AmountsLocked => IsAuthorizationFlow || Id.HasValue;
    private bool SourceFieldsLocked => IsAuthorizationFlow || (Id.HasValue && item.FkidEgresoProyectadoPres.HasValue);
    private decimal TotalMeses => item.Enero + item.Febrero + item.Marzo + item.Abril + item.Mayo + item.Junio + item.Julio + item.Agosto + item.Septiembre + item.Octubre + item.Noviembre + item.Diciembre;
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AnioStateService.InitializeAsync();

            if (Id.HasValue)
            {
                await CargarDatosAsync();
            }
            else if (PrefillItem != null)
            {
                CargarPrellenado(PrefillItem);
            }
        }
        finally
        {
            _formLoading = false;
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _fecha = item.Fecha.ToDateTime(TimeOnly.MinValue);
                SetSelectedLookups();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private void CargarPrellenado(EgresoAutorizadoResponse source)
    {
        item = new EgresoAutorizadoResponse
        {
            Activo = true,
            FkidEgresoProyectadoPres = source.FkidEgresoProyectadoPres,
            FkidAnioSis = source.FkidAnioSis,
            AnioClave = source.AnioClave,
            FkidProgramaPres = source.FkidProgramaPres,
            ProgramaClave = source.ProgramaClave,
            ProgramaDescripcion = source.ProgramaDescripcion,
            ProgramaClaveNombre = source.ProgramaClaveNombre,
            FkidPartidaConta = source.FkidPartidaConta,
            PartidaClave = source.PartidaClave,
            PartidaDescripcion = source.PartidaDescripcion,
            PartidaClaveNombre = source.PartidaClaveNombre,
            FkidAreaSis = source.FkidAreaSis,
            AreaClave = source.AreaClave,
            AreaNombre = source.AreaNombre,
            FkidFuenteFinanciamientoPres = source.FkidFuenteFinanciamientoPres,
            FuenteFinanciamientoClave = source.FuenteFinanciamientoClave,
            FuenteFinanciamientoDescripcion = source.FuenteFinanciamientoDescripcion,
            FuenteFinanciamientoClaveNombre = source.FuenteFinanciamientoClaveNombre,
            FkidTipoGastoPres = source.FkidTipoGastoPres,
            TipoGastoClave = source.TipoGastoClave,
            TipoGastoDescripcion = source.TipoGastoDescripcion,
            TipoGastoClaveNombre = source.TipoGastoClaveNombre,
            FkidDigitoIdentificadorPres = source.FkidDigitoIdentificadorPres,
            DigitoIdentificadorClave = source.DigitoIdentificadorClave,
            DigitoIdentificadorDescripcion = source.DigitoIdentificadorDescripcion,
            DigitoIdentificadorClaveNombre = source.DigitoIdentificadorClaveNombre,
            FkidDestinoGastoPres = source.FkidDestinoGastoPres,
            DestinoGastoClave = source.DestinoGastoClave,
            DestinoGastoDescripcion = source.DestinoGastoDescripcion,
            DestinoGastoClaveNombre = source.DestinoGastoClaveNombre,
            FkidPyPres = source.FkidPyPres,
            PyClave = source.PyClave,
            PyDescripcion = source.PyDescripcion,
            PyClaveNombre = source.PyClaveNombre,
            Descripcion = source.Descripcion,
            Fecha = source.Fecha == default ? DateOnly.FromDateTime(DateTime.Today) : source.Fecha,
            FkidPolizaConta = source.FkidPolizaConta,
            Enero = source.Enero,
            Febrero = source.Febrero,
            Marzo = source.Marzo,
            Abril = source.Abril,
            Mayo = source.Mayo,
            Junio = source.Junio,
            Julio = source.Julio,
            Agosto = source.Agosto,
            Septiembre = source.Septiembre,
            Octubre = source.Octubre,
            Noviembre = source.Noviembre,
            Diciembre = source.Diciembre,
            Total = source.Total,
            FechaAutorizacion = DateTime.Now
        };

        _fecha = item.Fecha.ToDateTime(TimeOnly.MinValue);
        SetSelectedLookups();
    }

    private void SetSelectedLookups()
    {
        _selectedPrograma = item.FkidProgramaPres > 0
            ? new LookupItem { Id = item.FkidProgramaPres, Text = TextOrDefault(item.ProgramaClaveNombre, item.FkidProgramaPres) }
            : null;
        _selectedPartida = item.FkidPartidaConta > 0
            ? new LookupItem { Id = item.FkidPartidaConta, Text = TextOrDefault(item.PartidaClaveNombre, item.FkidPartidaConta) }
            : null;
        _selectedArea = item.FkidAreaSis > 0
            ? new LookupItem { Id = item.FkidAreaSis, Text = TextOrDefault(item.AreaNombre, item.FkidAreaSis) }
            : null;
        _selectedFuenteFinanciamiento = BuildLookup(item.FkidFuenteFinanciamientoPres, item.FuenteFinanciamientoClaveNombre);
        _selectedTipoGasto = BuildLookup(item.FkidTipoGastoPres, item.TipoGastoClaveNombre);
        _selectedDigitoIdentificador = BuildLookup(item.FkidDigitoIdentificadorPres, item.DigitoIdentificadorClaveNombre);
        _selectedDestinoGasto = BuildLookup(item.FkidDestinoGastoPres, item.DestinoGastoClaveNombre);
        _selectedPy = BuildLookup(item.FkidPyPres, item.PyClaveNombre);
    }

    private async Task GuardarCambiosAsync()
    {
        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        var selectedAnioId = AnioStateService.AnioId ?? (AnioId > 0 ? AnioId : null);

        if (!selectedAnioId.HasValue || selectedAnioId.Value <= 0)
        {
            Snackbar.Add("Debe seleccionar un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (_selectedPrograma == null || _selectedPartida == null || _selectedArea == null)
        {
            Snackbar.Add("Debe seleccionar programa, partida y area.", Severity.Warning);
            return;
        }

        item.FkidAnioSis = selectedAnioId.Value;
        item.FkidProgramaPres = _selectedPrograma.Id;
        item.FkidPartidaConta = _selectedPartida.Id;
        item.FkidAreaSis = _selectedArea.Id;
        item.FkidFuenteFinanciamientoPres = _selectedFuenteFinanciamiento?.Id;
        item.FkidTipoGastoPres = _selectedTipoGasto?.Id;
        item.FkidDigitoIdentificadorPres = _selectedDigitoIdentificador?.Id;
        item.FkidDestinoGastoPres = _selectedDestinoGasto?.Id;
        item.FkidPyPres = _selectedPy?.Id;
        item.Fecha = DateOnly.FromDateTime(_fecha ?? DateTime.Today);
        item.Total = TotalMeses;
        if (IsAuthorizationFlow || !item.FechaAutorizacion.HasValue)
        {
            item.FechaAutorizacion = DateTime.Now;
        }

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                var message = IsAuthorizationFlow
                    ? "Presupuesto autorizado firmado correctamente"
                    : Id.HasValue ? "Presupuesto autorizado actualizado correctamente" : "Presupuesto autorizado creado correctamente";

                Snackbar.Add(message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar el presupuesto autorizado", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var anioFilter = GetAnioFilter();
        if (anioFilter == null)
            return new ComboLookupResult();

        var response = await ProgramaService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending, anioFilter);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPrograma, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPartidasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await PartidaService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPartida, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadAreasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await AreaService.GetAllAsync();
        var items = FilterUsuarioAreas(response?.Items, filter)
            .Select(x => new LookupItem { Id = x.PkidArea, Text = x.UsuarioAreaDescripcion });

        return ToPagedComboResult(items, page, pageSize);
    }

    private Task<ComboLookupResult> LoadFuentesFinanciamientoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/EgresoProyectado/GetFuenteFinanciamientoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadTiposGastoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/EgresoProyectado/GetTipoGastoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadDigitosIdentificadorPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/EgresoProyectado/GetDigitoIdentificadorLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadDestinosGastoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/EgresoProyectado/GetDestinoGastoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPyPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/EgresoProyectado/GetPyLookupPaginado", page, pageSize, filter, ct);

    private async Task<ComboLookupResult> LoadLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private Dictionary<string, object>? GetAnioFilter()
    {
        var anioId = AnioId > 0 ? AnioId : AnioStateService.AnioId;
        return anioId.HasValue && anioId.Value > 0
            ? new Dictionary<string, object> { ["FkidAnioSis"] = anioId.Value }
            : null;
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private static IEnumerable<UsuarioAreaResponse> FilterUsuarioAreas(IEnumerable<UsuarioAreaResponse>? items, string filter)
    {
        var query = (items ?? Enumerable.Empty<UsuarioAreaResponse>())
            .Where(x => x.PkidArea > 0);

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x => x.UsuarioAreaDescripcion.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(x => x.UsuarioAreaDescripcion);
    }

    private static ComboLookupResult ToPagedComboResult(IEnumerable<LookupItem> items, int page, int pageSize)
    {
        var list = items.ToList();
        var currentPage = Math.Max(1, page);
        var currentPageSize = pageSize <= 0 ? 10 : pageSize;

        return new ComboLookupResult
        {
            Items = list.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize).ToList(),
            TotalCount = list.Count
        };
    }

    private string Money(decimal amount) => $"{CurrencySymbol}{amount.ToString("0.00", NumberCulture)}";

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) ? id.ToString() : text;

    private static LookupItem? BuildLookup(int? id, string? text) =>
        id.HasValue && id.Value > 0
            ? new LookupItem { Id = id.Value, Text = TextOrDefault(text, id.Value) }
            : null;
}
