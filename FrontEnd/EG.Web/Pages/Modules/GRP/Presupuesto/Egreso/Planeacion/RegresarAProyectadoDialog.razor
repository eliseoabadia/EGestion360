@using EG.Web.Models
@using MudBlazor
@using System.Net.Http.Json

@inject HttpClient Http

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" CloseOnEscapeKey="@(!_processing)" Class="return-projected-dialog">
    <TitleContent>
        <div class="return-title">
            <div class="return-title-icon">
                <MudIcon Icon="@DialogIcon" Size="Size.Medium" />
            </div>
            <div>
                <MudText Typo="Typo.h6">@DialogTitle</MudText>
                <MudText Typo="Typo.caption">@DialogSubtitle</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Disabled="@_processing"
                           OnClick="Cancel"
                           Class="ml-auto" />
        </div>
    </TitleContent>

    <DialogContent>
        <div class="return-shell">
            @if (_completed)
            {
                <div class="return-status success">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle1">Proceso completado</MudText>
                        <MudText Typo="Typo.body2">@_message</MudText>
                    </div>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @WarningText
                </MudAlert>

                <MudGrid GutterSize="2" Class="return-summary">
                    <MudItem xs="12" sm="6">
                        <span>Programa</span>
                        <strong>@TextOrDash(Programa)</strong>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <span>Partida</span>
                        <strong>@TextOrDash(Partida)</strong>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <span>Area</span>
                        <strong>@TextOrDash(Area)</strong>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <span>Total autorizado</span>
                        <strong>@TextOrDash(Total)</strong>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <span>Fuente</span>
                        <strong>@TextOrDash(FuenteFinanciamiento)</strong>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <span>Fecha de autorizacion</span>
                        <strong>@TextOrDash(FechaAutorizacion)</strong>
                    </MudItem>
                    <MudItem xs="12">
                        <span>Descripcion</span>
                        <strong>@TextOrDash(Descripcion)</strong>
                    </MudItem>
                </MudGrid>

                <div class="return-question">
                    <MudText Typo="Typo.subtitle2">Confirmacion requerida</MudText>
                    <MudText Typo="Typo.body2">
                        @EffectText
                    </MudText>
                    <MudCheckBox T="bool"
                                 @bind-Value="_accepted"
                                 Disabled="@_processing"
                                 Color="Color.Warning"
                                 Label="@ConfirmCheckText" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <MudAlert Severity="@_messageSeverity" Variant="Variant.Filled" Dense="true" Class="mt-3">
                        @_message
                    </MudAlert>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        @if (_completed)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Done"
                       OnClick="CloseSuccess">
                Cerrar
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Disabled="@_processing"
                       OnClick="Cancel">
                @CancelText
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@DialogIcon"
                       Disabled="@(!_accepted || _processing)"
                       OnClick="ConfirmAsync">
                @if (_processing)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Default" Indeterminate="true" Class="mr-2" />
                    <span>Procesando...</span>
                }
                else
                {
                    <span>@ConfirmText</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .return-title {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .return-title-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        color: var(--mud-palette-warning-darken);
        background: color-mix(in srgb, var(--mud-palette-warning) 16%, var(--mud-palette-surface));
        border: 1px solid color-mix(in srgb, var(--mud-palette-warning) 35%, var(--mud-palette-lines-default));
    }

    .return-shell {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 14px;
        background: var(--mud-palette-surface);
    }

    .return-summary {
        margin-top: 2px;
    }

    .return-summary .mud-grid-item > span {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .72rem;
        text-transform: uppercase;
    }

    .return-summary .mud-grid-item > strong {
        display: block;
        min-height: 24px;
        color: var(--mud-palette-text-primary);
        font-size: .92rem;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }

    .return-question {
        margin-top: 14px;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid color-mix(in srgb, var(--mud-palette-warning) 32%, var(--mud-palette-lines-default));
        background: color-mix(in srgb, var(--mud-palette-warning) 7%, var(--mud-palette-surface));
    }

    .return-status {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
    }

    .return-status.success {
        color: var(--mud-palette-success-darken);
        background: color-mix(in srgb, var(--mud-palette-success) 10%, var(--mud-palette-surface));
        border: 1px solid color-mix(in srgb, var(--mud-palette-success) 35%, var(--mud-palette-lines-default));
    }
</style>

@code {
    [Parameter] public int EgresoAutorizadoId { get; set; }
    [Parameter] public string? Programa { get; set; }
    [Parameter] public string? Partida { get; set; }
    [Parameter] public string? Area { get; set; }
    [Parameter] public string? FuenteFinanciamiento { get; set; }
    [Parameter] public string? Descripcion { get; set; }
    [Parameter] public string? Total { get; set; }
    [Parameter] public string? FechaAutorizacion { get; set; }
    [Parameter] public string DialogTitle { get; set; } = "Regresar a proyectado";
    [Parameter] public string DialogSubtitle { get; set; } = "El presupuesto autorizado quedara sin efecto.";
    [Parameter] public string DialogIcon { get; set; } = Icons.Material.Filled.AssignmentReturn;
    [Parameter] public string WarningText { get; set; } = "Esta accion quitara la autorizacion vigente y el registro volvera a estar disponible en el anteproyecto.";
    [Parameter] public string EffectText { get; set; } = "El autorizado se conservara como registro inactivo para trazabilidad. El proyectado podra editarse o autorizarse nuevamente.";
    [Parameter] public string ConfirmCheckText { get; set; } = "Entiendo el efecto del regreso a proyectado";
    [Parameter] public string ConfirmText { get; set; } = "Regresar a proyectado";
    [Parameter] public string CancelText { get; set; } = "Mantener autorizado";
    [Parameter] public string SuccessFallbackMessage { get; set; } = "Presupuesto regresado a proyectado correctamente.";
    [Parameter] public string ErrorFallbackMessage { get; set; } = "No fue posible regresar el presupuesto a proyectado.";
    [Parameter] public string ErrorPrefix { get; set; } = "Error al regresar a proyectado";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _accepted;
    private bool _processing;
    private bool _completed;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;

    private async Task ConfirmAsync()
    {
        if (!_accepted || _processing)
        {
            return;
        }

        _processing = true;
        _message = null;

        try
        {
            var response = await Http.PostAsync($"api/EgresoAutorizado/regresar-a-proyectado/{EgresoAutorizadoId}", null);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                _completed = true;
                _message = string.IsNullOrWhiteSpace(result.Message)
                    ? SuccessFallbackMessage
                    : result.Message;
                _messageSeverity = Severity.Success;
                return;
            }

            _message = result?.Message ?? ErrorFallbackMessage;
            _messageSeverity = Severity.Error;
        }
        catch (Exception ex)
        {
            _message = UserFacingExceptionMessages.ForDisplay(
                AppLoggerFactory,
                ex,
                $"{ErrorPrefix}. Revisa la informacion e intenta nuevamente.");
            _messageSeverity = Severity.Error;
        }
        finally
        {
            _processing = false;
        }
    }

    private void CloseSuccess() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;
}
