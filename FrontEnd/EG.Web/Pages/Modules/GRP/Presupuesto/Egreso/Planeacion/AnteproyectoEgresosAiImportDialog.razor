    private string Money(decimal value) => $"{CurrencySymbol}{value.ToString("0.00", NumberCulture)}";

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatMessage(EgresoProyectadoAiImportValidationMessage message)
    {
        var location = message.RowNumber.HasValue ? $"Fila {message.RowNumber}: " : string.Empty;
        return $"{location}{message.Message}";
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private static IEnumerable<UsuarioAreaResponse> FilterUsuarioAreas(IEnumerable<UsuarioAreaResponse>? items, string filter)
    {
        var query = (items ?? Enumerable.Empty<UsuarioAreaResponse>())
            .Where(x => x.PkidArea > 0);

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x => x.UsuarioAreaDescripcion.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(x => x.UsuarioAreaDescripcion);
    }

    private static ComboLookupResult ToPagedComboResult(IEnumerable<LookupItem> items, int page, int pageSize)
    {
        var list = items.ToList();
        var currentPage = Math.Max(1, page);
        var currentPageSize = pageSize <= 0 ? 10 : pageSize;

        return new ComboLookupResult
        {
            Items = list.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize).ToList(),
            TotalCount = list.Count
        };
    }

    private static bool NeedsHelp(int? id, string? text) =>
        id.GetValueOrDefault() <= 0 || string.IsNullOrWhiteSpace(text);

    private static bool IsError(EgresoProyectadoAiImportValidationMessage message)
        => message.Severity.Equals("Error", StringComparison.OrdinalIgnoreCase);

    private static LookupItem? ToLookup(
        EgresoProyectadoAiImportRowRequest? row,
        Func<EgresoProyectadoAiImportRowRequest, int?> idSelector,
        Func<EgresoProyectadoAiImportRowRequest, string> textSelector)
    {
        if (row == null)
            return null;

        var id = idSelector(row);
        if (id.GetValueOrDefault() <= 0)
            return null;

        var text = textSelector(row);
        return new LookupItem
        {
            Id = id!.Value,
            Text = string.IsNullOrWhiteSpace(text) ? id.Value.ToString(CultureInfo.InvariantCulture) : text
        };
    }

    private static string BuildText(string? key, string? description)
    {
        if (string.IsNullOrWhiteSpace(key))
            return description ?? string.Empty;

        return string.IsNullOrWhiteSpace(description)
            ? key
            : $"{key} - {description}";
    }

