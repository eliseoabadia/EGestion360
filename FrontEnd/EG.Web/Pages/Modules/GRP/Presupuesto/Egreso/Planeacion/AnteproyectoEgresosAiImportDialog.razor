    private Task AskAssistant() => AskAssistant(forcePreviewAnswer: false);

    private async Task AskAssistant(bool forcePreviewAnswer)
    {
        if (!CanAskAssistant)
            return;

        _ragBusy = true;
        _ragAnswer = null;
        try
        {
            var questionText = _ragQuestion.Trim();
            var previewAnswer = TryBuildPreviewAnswer(questionText, forcePreviewAnswer);
            if (!string.IsNullOrWhiteSpace(previewAnswer))
            {
                SetLocalAssistantAnswer(questionText, previewAnswer);
                return;
            }

            if (_ragSession?.IndexedChunkCount <= 0)
            {
                SetLocalAssistantAnswer(questionText, "Primero analiza un archivo para que pueda revisar sus validaciones y su contenido indexado.");
                return;
            }

            RefreshAssistantContext();
            var question = $"{questionText}\n\nContexto operativo de la pagina:\n{_assistantContext}";
            var response = await RagService.AskAsync(new DocumentRagAskRequest
            {
                SessionId = _ragSession!.SessionId,
                Question = question,
                TopK = 6
            });

            if (response.Success && response.Data != null)
            {
                _ragAnswer = response.Data;
                if (!response.Data.AnsweredFromDocuments)
                {
                    var fallback = TryBuildPreviewAnswer(questionText, force: true);
                    if (!string.IsNullOrWhiteSpace(fallback))
                    {
                        SetLocalAssistantAnswer(questionText, fallback);
                        return;
                    }

                    Snackbar.Add("El RAG no encontro esa informacion en el archivo.", Severity.Warning);
                }

                return;
            }

            Snackbar.Add(response.Message ?? "No se pudo procesar la pregunta RAG.", Severity.Error);
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private string? TryBuildPreviewAnswer(string question, bool force)
    {
        if (_preview == null)
            return null;

        var normalized = NormalizeQuestion(question);
        var wantsLoadAnalysis = force || ContainsAny(normalized,
            "falta", "faltan", "completar", "carga", "cargar", "importar", "errores", "error",
            "validacion", "validar", "campo", "campos", "columna", "columnas", "mapeo", "resolver",
            "fila", "area", "programa", "partida", "meses", "importe");

        if (!wantsLoadAnalysis)
            return null;

        var errors = _preview.Messages.Where(IsError).ToList();
        var warnings = _preview.Messages.Where(message => !IsError(message)).ToList();
        var sb = new StringBuilder();

        sb.AppendLine($"Contexto de carga: anio {BudgetYearText}, empresa {EmpresaText}.");
        sb.AppendLine($"El archivo tiene {_preview.Rows.Count} fila(s), {_preview.DetectedColumns.Count} columna(s) detectada(s) y total {Money(_preview.Total)}.");

        if (_preview.CanImport)
        {
            sb.AppendLine("La carga ya esta lista. Puedes presionar Importar altas.");
        }
        else if (errors.Count > 0)
        {
            sb.AppendLine("Para completar la carga necesitas resolver estos bloqueos:");
            foreach (var message in errors.Take(8))
            {
                sb.AppendLine($"- {FormatMessage(message)}");
            }

            if (errors.Count > 8)
                sb.AppendLine($"- Hay {errors.Count - 8} error(es) adicional(es).");
        }
        else
        {
            sb.AppendLine("No hay errores bloqueantes, pero revisa los avisos antes de importar.");
        }

        AppendHelpAction(sb, "PROGRAMA_REQUIRED", _selectedPrograma, "Programa de ayuda");
        AppendHelpAction(sb, "PARTIDA_REQUIRED", _selectedPartida, "Partida de ayuda");
        AppendHelpAction(sb, "AREA_REQUIRED", _selectedArea, "Area de ayuda");
        AppendHelpAction(sb, "FUENTE_NOT_FOUND", _selectedFuenteFinanciamiento, "Fuente de ayuda");
        AppendHelpAction(sb, "TIPO_GASTO_NOT_FOUND", _selectedTipoGasto, "Tipo de gasto de ayuda");
        AppendHelpAction(sb, "DIGITO_NOT_FOUND", _selectedDigitoIdentificador, "Digito de ayuda");
        AppendHelpAction(sb, "DESTINO_NOT_FOUND", _selectedDestinoGasto, "Destino de ayuda");
        AppendHelpAction(sb, "PY_NOT_FOUND", _selectedPy, "PY de ayuda");

        if (warnings.Count > 0)
        {
            var monthWarnings = warnings.Count(message => message.Code.Equals("MONTH_CLEARED", StringComparison.OrdinalIgnoreCase));
            if (monthWarnings > 0)
            {
                sb.AppendLine($"Aviso: {monthWarnings} importe(s) mensual(es) se limpiaron porque quedan antes de la fecha inicial {_fecha:dd/MM/yyyy}. Esto no bloquea la importacion.");
            }

            foreach (var message in warnings.Where(message => !message.Code.Equals("MONTH_CLEARED", StringComparison.OrdinalIgnoreCase)).Take(4))
            {
                sb.AppendLine($"Aviso: {FormatMessage(message)}");
            }
        }

        if (ContainsAny(normalized, "campo", "campos", "columna", "columnas", "mapeo"))
        {
            sb.AppendLine("Columnas detectadas:");
            sb.AppendLine(_preview.DetectedColumns.Count == 0
                ? "- No se detectaron columnas."
                : $"- {string.Join(", ", _preview.DetectedColumns.Take(24))}");
            sb.AppendLine("Campos clave esperados: Programa, Partida, Area, Descripcion, Fecha, Enero-Diciembre y clasificacion opcional FF/TG/DI/DG/PY.");
        }

        sb.AppendLine("Despues de corregir los campos de ayuda o el archivo, presiona Analizar archivo otra vez. Importar altas se habilita cuando el estado quede Listo.");
        return sb.ToString().Trim();
    }

    private void SetLocalAssistantAnswer(string question, string answer)
