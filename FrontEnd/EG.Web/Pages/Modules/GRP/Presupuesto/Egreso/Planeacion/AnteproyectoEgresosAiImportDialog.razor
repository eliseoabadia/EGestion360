    private string HelpLabel(string label, string code)
        => IsHelpFieldRequired(code) ? $"{label} *" : label;

    private bool IsHelpFieldRequired(string code)
        => _baseMessages.Any(message => message.Code.Equals(code, StringComparison.OrdinalIgnoreCase) && IsError(message));

    private IReadOnlyList<string> BuildMissingHelpFields()
    {
        var missing = new List<string>();
        AddMissingHelpField(missing, "PROGRAMA_REQUIRED", _selectedPrograma, "Programa de ayuda");
        AddMissingHelpField(missing, "PARTIDA_REQUIRED", _selectedPartida, "Partida de ayuda");
        AddMissingHelpField(missing, "AREA_REQUIRED", _selectedArea, "Area de ayuda");
        AddMissingHelpField(missing, "FUENTE_NOT_FOUND", _selectedFuenteFinanciamiento, "Fuente de ayuda");
        AddMissingHelpField(missing, "TIPO_GASTO_NOT_FOUND", _selectedTipoGasto, "Tipo de gasto de ayuda");
        AddMissingHelpField(missing, "DIGITO_NOT_FOUND", _selectedDigitoIdentificador, "Digito de ayuda");
        AddMissingHelpField(missing, "DESTINO_NOT_FOUND", _selectedDestinoGasto, "Destino de ayuda");
        AddMissingHelpField(missing, "PY_NOT_FOUND", _selectedPy, "PY de ayuda");
        return missing;
    }

    private void AddMissingHelpField(List<string> missing, string code, LookupItem? selected, string label)
    {
        if (selected == null && IsHelpFieldRequired(code))
            missing.Add(label);
    }

    private bool CanResolveWithHelpField(EgresoProyectadoAiImportValidationMessage message)
    {
        if (!message.RowNumber.HasValue)
            return false;

        return message.Code switch
        {
            "PROGRAMA_REQUIRED" => _selectedPrograma != null,
            "PARTIDA_REQUIRED" => _selectedPartida != null,
            "AREA_REQUIRED" => _selectedArea != null,
            "FUENTE_NOT_FOUND" => _selectedFuenteFinanciamiento != null,
            "TIPO_GASTO_NOT_FOUND" => _selectedTipoGasto != null,
            "DIGITO_NOT_FOUND" => _selectedDigitoIdentificador != null,
            "DESTINO_NOT_FOUND" => _selectedDestinoGasto != null,
            "PY_NOT_FOUND" => _selectedPy != null,
            _ => false
        };
    }

