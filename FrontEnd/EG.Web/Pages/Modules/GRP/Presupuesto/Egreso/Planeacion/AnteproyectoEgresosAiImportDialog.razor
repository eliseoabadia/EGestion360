    private string BuildAssistantContext()
    {
        var sb = new StringBuilder();
        sb.AppendLine($"Ruta: /Presupuesto/Egreso/Planeacion/Anteproyecto_Egresos.");
        sb.AppendLine($"Modulo/Submodulo: Planeacion / Anteproyecto_Egresos.");
        sb.AppendLine($"Anio presupuestal seleccionado: {BudgetYearText}.");
        sb.AppendLine($"Empresa seleccionada: {EmpresaText}.");
        sb.AppendLine($"Fecha inicial por defecto: {(_fecha ?? DateTime.Today):dd/MM/yyyy}.");
        sb.AppendLine("Reglas de carga:");
        sb.AppendLine("- El archivo debe contener filas de anteproyecto de egresos.");
        sb.AppendLine("- Campos clave: Programa, Partida, Area, Descripcion, Fecha, Enero, Febrero, Marzo, Abril, Mayo, Junio, Julio, Agosto, Septiembre, Octubre, Noviembre y Diciembre.");
        sb.AppendLine("- Programa, Partida y Area son obligatorios; si el archivo no los resuelve, se pueden completar con los campos de ayuda.");
        sb.AppendLine("- Fuente, Tipo de gasto, Digito, Destino y PY son clasificaciones opcionales; si vienen en archivo y no se encuentran, pueden corregirse con los campos de ayuda.");
        sb.AppendLine("- Los importes mensuales no pueden ser negativos y cada fila debe tener al menos un importe mayor a cero.");
        sb.AppendLine("- Los meses anteriores a la fecha inicial se limpian automaticamente y generan avisos, no necesariamente bloqueos.");
        sb.AppendLine("- Importar altas solo se habilita cuando no quedan mensajes de severidad Error.");
        sb.AppendLine("Campos de ayuda seleccionados:");
        AppendSelectedHelp(sb, "Programa", _selectedPrograma);
        AppendSelectedHelp(sb, "Partida", _selectedPartida);
        AppendSelectedHelp(sb, "Area", _selectedArea);
        AppendSelectedHelp(sb, "Fuente", _selectedFuenteFinanciamiento);
        AppendSelectedHelp(sb, "Tipo de gasto", _selectedTipoGasto);
        AppendSelectedHelp(sb, "Digito", _selectedDigitoIdentificador);
        AppendSelectedHelp(sb, "Destino", _selectedDestinoGasto);
        AppendSelectedHelp(sb, "PY", _selectedPy);

        if (_preview != null)
        {
            var errors = _preview.Messages.Count(IsError);
            var warnings = _preview.Messages.Count - errors;
            sb.AppendLine("Estado del analisis:");
            sb.AppendLine($"- Filas: {_preview.Rows.Count}.");
            sb.AppendLine($"- Columnas detectadas: {_preview.DetectedColumns.Count}.");
            sb.AppendLine($"- Total: {Money(_preview.Total)}.");
            sb.AppendLine($"- Errores: {errors}; avisos: {warnings}; puede importar: {(_preview.CanImport ? "si" : "no")}.");

            foreach (var message in _preview.Messages.Take(12))
            {
                sb.AppendLine($"- {message.Severity}: {FormatMessage(message)}");
            }
        }

        return sb.ToString().Trim();
    }

    private static void AppendSelectedHelp(StringBuilder sb, string label, LookupItem? value)
    {
        sb.AppendLine(value == null
            ? $"- {label}: sin seleccionar."
            : $"- {label}: {value.Text} (Id {value.Id}).");
    }

    private void AppendHelpAction(StringBuilder sb, string code, LookupItem? selected, string label)
    {
        var affectedRows = _baseMessages
            .Where(message => message.Code.Equals(code, StringComparison.OrdinalIgnoreCase))
            .Select(message => message.RowNumber)
            .Where(row => row.HasValue)
            .Select(row => row!.Value)
            .Distinct()
            .OrderBy(row => row)
            .ToList();

        if (affectedRows.Count == 0)
            return;

        var rowsText = string.Join(", ", affectedRows.Take(8));
        if (affectedRows.Count > 8)
            rowsText += $" y {affectedRows.Count - 8} mas";

        if (selected == null)
        {
            sb.AppendLine($"Accion: selecciona {label} para cubrir fila(s) {rowsText}.");
        }
        else
        {
            sb.AppendLine($"Cubierto: {label} usa {selected.Text} para fila(s) {rowsText}.");
        }
    }

    private static bool ContainsAny(string value, params string[] terms)
        => terms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));

    private static string NormalizeQuestion(string value)
    {
        return (value ?? string.Empty)
            .Trim()
            .ToLowerInvariant()
            .Replace("á", "a")
            .Replace("é", "e")
            .Replace("í", "i")
            .Replace("ó", "o")
            .Replace("ú", "u")
            .Replace("ü", "u")
            .Replace("ñ", "n");
    }

