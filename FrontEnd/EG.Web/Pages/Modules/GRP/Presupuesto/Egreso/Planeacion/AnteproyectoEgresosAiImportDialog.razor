@using EG.Common.GenericModel
@using EG.Domain.DTOs.Requests.Presupuestales
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Contracts.Modules.GRP.Presupuestales
@using EG.Web.Contracts.Platform.DocumentRag
@using EG.Web.Models
@using EG.Web.Models.Platform.DocumentRag
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using System.Globalization
@using System.Text
@implements IAsyncDisposable

@inject IEgresoProyectadoAiImportService ImportService
@inject IDocumentRagService RagService
@inject IGenericCrudService<ProgramaResponse> ProgramaService
@inject IGenericCrudService<PartidaResponse> PartidaService
@inject IGenericCrudService<UsuarioAreaResponse> AreaService
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog Class="anteproyecto-ai-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Alta desde Excel</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" Disabled="@_busy" />
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField Value="@BudgetYearText"
                              Label="Anio presupuestal"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Selecciona un anio presupuestal"
                              ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Value="@EmpresaText"
                              Label="Empresa seleccionada"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Selecciona una empresa"
                              ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_fecha"
                               Label="Fecha inicial por defecto"
                               DateFormat="dd/MM/yyyy"
                               Culture="@DateCulture"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Selecciona una fecha inicial" />
            </MudItem>
        </MudGrid>

        <InputFile id="@_inputId"
                   OnChange="OnFileSelected"
                   accept=".xlsx,.csv,.txt"
                   class="anteproyecto-ai-file-input" />
        <label for="@_inputId" class="anteproyecto-ai-dropzone">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" />
            <span>@(_file?.Name ?? "Seleccionar Excel, CSV o TXT *")</span>
            <small>Columnas: Partida, Area, Descripcion, Fecha, Enero-Diciembre. Programa puede ir en ayuda.</small>
        </label>

        <MudExpansionPanels Elevation="0" Class="mt-3">
            <MudExpansionPanel Text="Campos de ayuda" Expanded="@(_preview?.CanImport == false)">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedPrograma"
                                           ValueChanged="OnProgramaChanged"
                                           Label="@(HelpLabel("Programa de ayuda", "PROGRAMA_REQUIRED"))"
                                           Required="@(IsHelpFieldRequired("PROGRAMA_REQUIRED"))"
                                           RequiredError="Selecciona programa de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadProgramasPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedPartida"
                                           ValueChanged="OnPartidaChanged"
                                           Label="@(HelpLabel("Partida de ayuda", "PARTIDA_REQUIRED"))"
                                           Required="@(IsHelpFieldRequired("PARTIDA_REQUIRED"))"
                                           RequiredError="Selecciona partida de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadPartidasPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedArea"
                                           ValueChanged="OnAreaChanged"
                                           Label="@(HelpLabel("Area de ayuda", "AREA_REQUIRED"))"
                                           Required="@(IsHelpFieldRequired("AREA_REQUIRED"))"
                                           RequiredError="Selecciona area de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadAreasPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedFuenteFinanciamiento"
                                           ValueChanged="OnFuenteFinanciamientoChanged"
                                           Label="@(HelpLabel("Fuente de ayuda", "FUENTE_NOT_FOUND"))"
                                           Required="@(IsHelpFieldRequired("FUENTE_NOT_FOUND"))"
                                           RequiredError="Selecciona fuente de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadFuentesFinanciamientoPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedTipoGasto"
                                           ValueChanged="OnTipoGastoChanged"
                                           Label="@(HelpLabel("Tipo de gasto de ayuda", "TIPO_GASTO_NOT_FOUND"))"
                                           Required="@(IsHelpFieldRequired("TIPO_GASTO_NOT_FOUND"))"
                                           RequiredError="Selecciona tipo de gasto de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadTiposGastoPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedDigitoIdentificador"
                                           ValueChanged="OnDigitoIdentificadorChanged"
                                           Label="@(HelpLabel("Digito de ayuda", "DIGITO_NOT_FOUND"))"
                                           Required="@(IsHelpFieldRequired("DIGITO_NOT_FOUND"))"
                                           RequiredError="Selecciona digito de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadDigitosIdentificadorPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <PagedAutocomplete Value="@_selectedDestinoGasto"
                                           ValueChanged="OnDestinoGastoChanged"
                                           Label="@(HelpLabel("Destino de ayuda", "DESTINO_NOT_FOUND"))"
                                           Required="@(IsHelpFieldRequired("DESTINO_NOT_FOUND"))"
                                           RequiredError="Selecciona destino de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadDestinosGastoPageAsync" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <PagedAutocomplete Value="@_selectedPy"
                                           ValueChanged="OnPyChanged"
                                           Label="@(HelpLabel("PY de ayuda", "PY_NOT_FOUND"))"
                                           Required="@(IsHelpFieldRequired("PY_NOT_FOUND"))"
                                           RequiredError="Selecciona PY de ayuda"
                                           Clearable="true"
                                           LoadPage="LoadPyPageAsync" />
                    </MudItem>
                </MudGrid>
                @if (_preview != null)
                {
                    @if (MissingHelpFields.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                            <strong>Falta para importar:</strong> @string.Join(", ", MissingHelpFields)
                        </MudAlert>
                    }
                    else if (_preview.Messages.Any(IsError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                            <strong>Corrige para importar:</strong> @FirstBlockingError
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                            Campos obligatorios completos.
                        </MudAlert>
                    }
                }
            </MudExpansionPanel>
        </MudExpansionPanels>

        <div class="d-flex flex-wrap align-center gap-2 mt-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PsychologyAlt"
                       Disabled="@(_file == null || _busy || !HasSelectedAnio || !HasSelectedEmpresa)"
                       OnClick="Analyze">
                Analizar archivo
            </MudButton>
            <MudTooltip Text="@ImportBlockReason" Disabled="@CanImport">
                <span>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PostAdd"
                               Disabled="@(!CanImport)"
                               OnClick="Import">
                        Importar altas
                    </MudButton>
                </span>
            </MudTooltip>
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </div>

        <MudExpansionPanels Elevation="0" Class="mt-3">
            <MudExpansionPanel Text="Asistente de carga y RAG" Expanded="@(_ragSession != null || _ragAnswer != null)">
                <div class="anteproyecto-rag-context">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Anio @BudgetYearText</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@EmpresaText</MudChip>
                    @if (_ragSession != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(_ragSession.IndexedChunkCount > 0 ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                            @_ragSession.IndexedChunkCount chunk(s)
                        </MudChip>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_ragNotice))
                {
                    <MudAlert Severity="@_ragNoticeSeverity" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        @_ragNotice
                    </MudAlert>
                }

                <div class="anteproyecto-rag-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Schema"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantFields">
                        Campos
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Rule"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantValidation">
                        Validacion
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Troubleshoot"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantMapping">
                        Mapeo
                    </MudButton>
                </div>

                <div class="anteproyecto-rag-question">
                    <MudTextField @bind-Value="_ragQuestion"
                                  Placeholder="Pregunta sobre el archivo cargado..."
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Disabled="@(_ragBusy || _busy)"
                                  Immediate="true" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistant">
                        Preguntar
                    </MudButton>
                    @if (_ragBusy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                </div>

                @if (_ragAnswer != null)
                {
                    <div class="anteproyecto-rag-answer">
                        <strong>Respuesta</strong>
                        <p>@_ragAnswer.Answer</p>
                        @if (_ragAnswer.Citations.Count > 0)
                        {
                            <div class="anteproyecto-rag-citations">
                                @foreach (var citation in _ragAnswer.Citations.Take(3))
                                {
                                    <div>
                                        <span>@citation.DocumentName - chunk @citation.ChunkIndex</span>
                                        <small>@citation.Snippet</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (_preview != null)
        {
            <MudDivider Class="my-3" />
            <div class="anteproyecto-ai-summary">
                <div><span>Filas</span><strong>@_preview.Rows.Count</strong></div>
                <div><span>Total</span><strong>@Money(_preview.Total)</strong></div>
                <div><span>Columnas</span><strong>@_preview.DetectedColumns.Count</strong></div>
                <div><span>Estado</span><strong class="@(_preview.CanImport ? "ok" : "warn")">@(_preview.CanImport ? "Listo" : "Con errores")</strong></div>
            </div>

            @if (_preview.Messages.Count > 0)
            {
                <MudAlert Severity="@(_preview.CanImport ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var message in _preview.Messages.Take(20))
                    {
                        <div>@FormatMessage(message)</div>
                    }
                    @if (_preview.Messages.Count > 20)
                    {
                        <div>... @(_preview.Messages.Count - 20) mensajes adicionales.</div>
                    }
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Validaciones correctas. El archivo esta listo para importar.
                </MudAlert>
            }

            <MudTable Items="@_preview.Rows" Dense="true" Hover="true" Class="mt-3" Height="360px" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Fila</MudTh>
                    <MudTh>Programa</MudTh>
                    <MudTh>Partida</MudTh>
                    <MudTh>Area</MudTh>
                    <MudTh>Descripcion</MudTh>
                    <MudTh>Clasificacion</MudTh>
                    <MudTh>Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RowNumber</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@TextOrDash(context.Programa)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(context.ProgramaDescripcion)</MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@TextOrDash(context.Partida)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(context.PartidaDescripcion)</MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@TextOrDash(context.Area)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(context.AreaDescripcion)</MudText>
                    </MudTd>
                    <MudTd>@TextOrDash(context.Descripcion)</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption">FF: @TextOrDash(context.FuenteFinanciamiento)</MudText><br />
                        <MudText Typo="Typo.caption">TG: @TextOrDash(context.TipoGasto)</MudText><br />
                        <MudText Typo="Typo.caption">DI: @TextOrDash(context.DigitoIdentificador)</MudText><br />
                        <MudText Typo="Typo.caption">DG: @TextOrDash(context.DestinoGasto)</MudText><br />
                        <MudText Typo="Typo.caption">PY: @TextOrDash(context.Py)</MudText>
                    </MudTd>
                    <MudTd><strong>@Money(context.Total)</strong></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
</MudDialog>

<style>
    .anteproyecto-ai-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .anteproyecto-ai-dropzone {
        display: grid;
        place-items: center;
        gap: 4px;
        min-height: 104px;
        margin-top: 12px;
        border: 1px dashed var(--mud-palette-lines-inputs);
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        text-align: center;
    }

    .anteproyecto-ai-dropzone span {
        font-weight: 650;
    }

    .anteproyecto-ai-dropzone small {
        color: var(--mud-palette-text-secondary);
    }

    .anteproyecto-ai-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(120px, 1fr));
        gap: 8px;
    }

    .anteproyecto-ai-summary div {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 8px;
        background: var(--mud-palette-surface);
    }

    .anteproyecto-ai-summary span,
    .anteproyecto-ai-summary strong {
        display: block;
    }

    .anteproyecto-ai-summary span {
        color: var(--mud-palette-text-secondary);
        font-size: 0.76rem;
    }

    .anteproyecto-ai-summary .ok {
        color: #28745b;
    }

    .anteproyecto-ai-summary .warn {
        color: #a35200;
    }

    .anteproyecto-rag-context,
    .anteproyecto-rag-actions,
    .anteproyecto-rag-question {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .anteproyecto-rag-actions {
        margin-top: 12px;
    }

    .anteproyecto-rag-question {
        margin-top: 10px;
    }

    .anteproyecto-rag-question .mud-input-control {
        flex: 1 1 320px;
    }

    .anteproyecto-rag-answer {
        margin-top: 10px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px;
        background: var(--mud-palette-surface);
    }

    .anteproyecto-rag-answer p {
        margin: 6px 0 0;
        white-space: pre-wrap;
    }

    .anteproyecto-rag-citations {
        display: grid;
        gap: 6px;
        margin-top: 10px;
    }

    .anteproyecto-rag-citations div {
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-top: 6px;
    }

    .anteproyecto-rag-citations span,
    .anteproyecto-rag-citations small {
        display: block;
        color: var(--mud-palette-text-secondary);
    }
</style>

@code {
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public int? EmpresaId { get; set; }
    [Parameter] public string? EmpresaNombre { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly string _inputId = $"anteproyecto-ai-upload-{Guid.NewGuid():N}";
    private IBrowserFile? _file;
    private EgresoProyectadoAiImportPreviewResponse? _preview;
    private List<EgresoProyectadoAiImportRowRequest> _baseRows = [];
    private List<EgresoProyectadoAiImportValidationMessage> _baseMessages = [];
    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedPartida;
    private LookupItem? _selectedArea;
    private LookupItem? _selectedFuenteFinanciamiento;
    private LookupItem? _selectedTipoGasto;
    private LookupItem? _selectedDigitoIdentificador;
    private LookupItem? _selectedDestinoGasto;
    private LookupItem? _selectedPy;
    private DateTime? _fecha = DateTime.Today;
    private DocumentRagSessionResponse? _ragSession;
    private DocumentRagAskResponse? _ragAnswer;
    private string _ragQuestion = string.Empty;
    private string _assistantContext = string.Empty;
    private string _ragNotice = string.Empty;
    private Severity _ragNoticeSeverity = Severity.Info;
    private bool _busy;
    private bool _ragBusy;
    private bool _ragReleased;

    private bool HasSelectedAnio => AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;
    private bool HasSelectedEmpresa => SelectedEmpresaId.HasValue && SelectedEmpresaId.Value > 0;
    private bool CanImport => _preview?.CanImport == true
        && !_busy
        && _file != null
        && HasSelectedAnio
        && HasSelectedEmpresa
        && _fecha.HasValue;
    private IReadOnlyList<string> MissingHelpFields => BuildMissingHelpFields();
    private string FirstBlockingError => _preview?.Messages.FirstOrDefault(IsError) is { } message
        ? FormatMessage(message)
        : "No hay errores pendientes.";
    private string ImportBlockReason
    {
        get
        {
            if (_busy)
                return "Proceso en curso.";
            if (!HasSelectedAnio)
                return "Selecciona un anio presupuestal.";
            if (!HasSelectedEmpresa)
                return "Selecciona una empresa.";
            if (_fecha == null)
                return "Selecciona una fecha inicial.";
            if (_file == null)
                return "Selecciona un archivo.";
            if (_preview == null)
                return "Analiza el archivo primero.";

            var missing = MissingHelpFields;
            if (missing.Count > 0)
                return $"Falta: {string.Join(", ", missing)}.";

            return _preview.Messages.Any(IsError)
                ? $"Corrige: {FirstBlockingError}"
                : string.Empty;
        }
    }
    private bool CanAskAssistant => (_preview != null || _ragSession?.IndexedChunkCount > 0)
        && !_busy
        && !_ragBusy
        && !string.IsNullOrWhiteSpace(_ragQuestion);
    private string BudgetYearText => AnioStateService.AnioClave?.ToString() ?? AnioStateService.AnioId?.ToString() ?? "Sin anio";
    private int? SelectedEmpresaId => EmpresaId.GetValueOrDefault() > 0 ? EmpresaId : SucursalStateService.EmpresaId;
    private string EmpresaText => !string.IsNullOrWhiteSpace(EmpresaNombre)
        ? EmpresaNombre!
        : !string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombreCorto)
            ? SucursalStateService.EmpresaNombreCorto!
            : SucursalStateService.EmpresaNombre ?? "Sin empresa";
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();
        await SucursalStateService.InitializeAsync();
        EmpresaId ??= SucursalStateService.EmpresaId;
        EmpresaNombre ??= SucursalStateService.EmpresaNombreCorto ?? SucursalStateService.EmpresaNombre;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        if (_ragSession != null)
            await ReleaseRagSessionAsync(showSnackbar: false);

        _file = args.GetMultipleFiles(1).FirstOrDefault();
        _preview = null;
        _baseRows = [];
        _baseMessages = [];
        _ragAnswer = null;
        _ragNotice = string.Empty;
        _ragQuestion = string.Empty;
        _assistantContext = string.Empty;
        ClearHelpFields();
    }

    private async Task Analyze()
    {
        if (_file == null)
            return;

        if (!HasSelectedAnio)
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (!HasSelectedEmpresa)
        {
            Snackbar.Add("Selecciona una empresa en el encabezado.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var response = await ImportService.PreviewAsync(BuildHeader(), _file);
            _preview = response.Data;
            if (_preview != null)
            {
                _baseRows = _preview.Rows.Select(CloneRow).ToList();
                _baseMessages = _preview.Messages.ToList();
                SelectHelpFieldsFromPreview();
                ApplyHelpFieldsToPreview();
                RefreshAssistantContext();
            }

            if (_preview != null)
                await IndexFileForRagAsync();

            Snackbar.Add(response.Message, response.Data?.CanImport == true ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Import()
    {
        if (_preview == null || !CanImport)
            return;

        _busy = true;
        try
        {
            var response = await ImportService.ConfirmAsync(new EgresoProyectadoAiImportConfirmRequest
            {
                SourceFileName = _preview.SourceFileName,
                Header = _preview.Header,
                Rows = BuildRowsForImport()
            });

            if (response.Success)
            {
                Snackbar.Add(response.Message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            _preview = response.Data ?? _preview;
            Snackbar.Add(response.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private EgresoProyectadoAiImportHeaderRequest BuildHeader() => new()
    {
        FkidAnioSis = AnioStateService.AnioId,
        Anio = AnioStateService.AnioClave,
        FkidEmpresaSis = SelectedEmpresaId,
        EmpresaNombre = EmpresaText,
        Fecha = _fecha ?? DateTime.Today
    };

    private async Task IndexFileForRagAsync()
    {
        if (_file == null)
            return;

        _ragBusy = true;
        _ragNotice = "Indexando archivo para RAG...";
        _ragNoticeSeverity = Severity.Info;
        try
        {
            if (!await EnsureRagSessionAsync())
                return;

            var response = await RagService.UploadAsync(BuildRagSessionRequest(), _ragSession!.SessionId, _file);
            if (response.Success && response.Data != null)
            {
                await RefreshRagSessionAsync();
                _ragNoticeSeverity = response.Data.ChunkCount > 0 ? Severity.Success : Severity.Warning;
                _ragNotice = response.Data.ChunkCount > 0
                    ? "Archivo indexado para consultas RAG."
                    : response.Data.Message;
                _ragQuestion = string.IsNullOrWhiteSpace(_ragQuestion)
                    ? "Que campos del anteproyecto se detectan en el archivo?"
                    : _ragQuestion;
            }
            else
            {
                _ragNoticeSeverity = Severity.Warning;
                _ragNotice = response.Message ?? "No fue posible indexar el archivo para RAG.";
            }
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private async Task<bool> EnsureRagSessionAsync()
    {
        if (_ragSession != null)
            return true;

        var response = await RagService.CreateSessionAsync(BuildRagSessionRequest());
        if (response.Success && response.Data != null)
        {
            _ragSession = response.Data;
            _ragReleased = false;
            return true;
        }

        _ragNoticeSeverity = Severity.Error;
        _ragNotice = response.Message ?? "No fue posible crear la sesion RAG.";
        return false;
    }

    private async Task RefreshRagSessionAsync()
    {
        if (_ragSession == null)
            return;

        var response = await RagService.GetSessionAsync(_ragSession.SessionId);
        if (response.Success && response.Data != null)
            _ragSession = response.Data;
    }

