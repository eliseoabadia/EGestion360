    private void ApplyHelpFieldsAndRefreshAssistant()
    {
        ApplyHelpFieldsToPreview();
        RefreshAssistantContext();

        if (_ragAnswer != null && !string.IsNullOrWhiteSpace(_ragQuestion))
        {
            var answer = TryBuildPreviewAnswer(_ragQuestion, force: true);
            if (!string.IsNullOrWhiteSpace(answer))
                SetLocalAssistantAnswer(_ragQuestion, answer);
        }
    }

    private void ApplyHelpFieldsToPreview()
    {
        if (_preview == null)
            return;

        _preview.Rows = _baseRows.Select(CloneRow).ToList();
        foreach (var row in _preview.Rows)
        {
            if (NeedsHelp(row.FkidProgramaPres, row.Programa))
                AssignPrograma(row, _selectedPrograma);
            if (NeedsHelp(row.FkidPartidaConta, row.Partida))
                AssignPartida(row, _selectedPartida);
            if (NeedsHelp(row.FkidAreaSis, row.Area))
                AssignArea(row, _selectedArea);
            if (NeedsHelp(row.FkidFuenteFinanciamientoPres, row.FuenteFinanciamiento))
                AssignFuente(row, _selectedFuenteFinanciamiento);
            if (NeedsHelp(row.FkidTipoGastoPres, row.TipoGasto))
                AssignTipoGasto(row, _selectedTipoGasto);
            if (NeedsHelp(row.FkidDigitoIdentificadorPres, row.DigitoIdentificador))
                AssignDigito(row, _selectedDigitoIdentificador);
            if (NeedsHelp(row.FkidDestinoGastoPres, row.DestinoGasto))
                AssignDestino(row, _selectedDestinoGasto);
            if (NeedsHelp(row.FkidPyPres, row.Py))
                AssignPy(row, _selectedPy);
        }

        _preview.Messages = _baseMessages
            .Where(message => !CanResolveWithHelpField(message))
            .ToList();
        _preview.CanImport = _preview.Rows.Count > 0
            && !_preview.Messages.Any(IsError);
    }

    private List<EgresoProyectadoAiImportRowRequest> BuildRowsForImport()
    {
        ApplyHelpFieldsToPreview();
        return _preview?.Rows.Select(CloneRow).ToList() ?? [];
    }

