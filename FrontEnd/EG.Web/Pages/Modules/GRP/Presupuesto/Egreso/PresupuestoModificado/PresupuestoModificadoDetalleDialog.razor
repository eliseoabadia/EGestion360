@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Models.PresupuestoModificado
@inject IGenericCrudService<EgreAdecuacionDetalleResponse> Service
@inject IGenericCrudService<EgresoDisponibleResponse> DisponibleService
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="EgreAdecuacionDetalleResponse" @ref="dialog" Title="@dialogTitle"
                ActionText="@actionText" ProcessingText="@processingText" CanConfirm="@CanSave" OnConfirm="SaveAsync">
    @if (load.Error != null)
    {
        <EditorLoadError Message="@load.Error" OnRetry="LoadAsync" />
    }
    else
    {
        <BaseEntityForm TEntity="EgreAdecuacionDetalleResponse" @ref="form" ShowHeader="false"
                        Loading="@load.IsLoading" LoadingMessage="Preparando movimiento..." LoadingSkeletonRows="10">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <CrudFormSection Title="Origen y movimiento">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <PagedAutocomplete Value="@_egreso" ValueChanged="OnEgresoChanged"
                                                   Label="Egreso autorizado disponible" Required="true"
                                                   RequiredError="Selecciona un egreso autorizado." Margin="Margin.Dense"
                                                   Disabled="@saving" LoadPage="LoadEgresosPageAsync" />
                            </MudItem>
                            @if (availableLoad.IsLoading)
                            {
                                <MudItem xs="12"><MudProgressLinear Indeterminate="true" aria-label="Consultando disponibilidad" /></MudItem>
                            }
                            else if (availableLoad.Error != null)
                            {
                                <MudItem xs="12"><EditorLoadError Message="@availableLoad.Error" OnRetry="RetryAvailableAsync" /></MudItem>
                            }
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Date="@_fecha" DateChanged="value => _fecha = value" Label="Fecha"
                                               Margin="Margin.Dense" Variant="Variant.Outlined" Required="true"
                                               RequiredError="Captura una fecha válida." Clearable="true" Disabled="@saving"
                                               Validation="@(new Func<DateTime?, string?>(ValidateDate))"
                                               DateFormat="dd/MM/yyyy" Culture="@BudgetCaptureUi.DateCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Value="@TipoTexto" Label="Tipo de movimiento" Margin="Margin.Dense"
                                              Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="item.Justificacion" Label="Justificación" Margin="Margin.Dense"
                                              Variant="Variant.Outlined" Lines="4" Disabled="@saving"
                                              HelperText="Acepta texto largo y saltos de línea." />
                            </MudItem>
                        </MudGrid>
                    </CrudFormSection>
                </MudItem>
                <MudItem xs="12">
                    <CrudFormSection Title="Distribución mensual">
                        <BudgetMonthlyGrid GetAmount="GetMonth" OnAmountChanged="OnMonthChanged" Disabled="@saving" />
                    </CrudFormSection>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Total capturado: <strong>@Money(CapturedTotal)</strong>.
                        Disponible seleccionado: <strong>@(availableLoad.IsReady ? Money(_selectedDisponible?.Total ?? 0m) : "Por consultar")</strong>.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        </BaseEntityForm>
    }
</BaseCrudDialog>
