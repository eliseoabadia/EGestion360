@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor
@using EG.Web.Models.PresupuestoModificado

@inject IGenericCrudService<EgreAdecuacionResponse> Service
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="EgreAdecuacionResponse" @ref="dialog" Title="@dialogTitle" ActionText="@actionText" ProcessingText="@processingText" CanConfirm="@(load.IsReady && !saving)" OnConfirm="SaveAsync">
    @if (load.Error != null)
    {
        <EditorLoadError Message="@load.Error" OnRetry="LoadAsync" />
    }
    else
    {
    <BaseEntityForm TEntity="EgreAdecuacionResponse" @ref="form" ShowHeader="false" Loading="@load.IsLoading" LoadingMessage="Preparando presupuesto modificado..." LoadingSkeletonRows="5">
        <MudGrid GutterSize="2">
            <MudItem xs="12" md="6">
                <MudDatePicker Margin="Margin.Dense" Date="@_fecha" DateChanged="value => _fecha = value" Label="Fecha" Variant="Variant.Outlined"
                               Required="true" RequiredError="Captura una fecha válida." Clearable="true" Disabled="@saving"
                               Validation="@(new Func<DateTime?, string?>(ValidateDate))" DateFormat="dd/MM/yyyy" Culture="@BudgetCaptureUi.DateCulture" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Margin="Margin.Dense" T="string" Value="@TipoTexto" Label="Tipo de adecuacion" Variant="Variant.Outlined" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12">
                <div class="format-toolbar">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Formato rapido</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" Color="Color.Primary" Title="Negritas" aria-label="Añadir negritas" Disabled="@saving" OnClick="ApplyBold" />
                    <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" Color="Color.Primary" Title="Lista" aria-label="Añadir lista" Disabled="@saving" OnClick="ApplyBulletList" />
                    <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" Color="Color.Primary" Title="Lista numerada" aria-label="Añadir lista numerada" Disabled="@saving" OnClick="ApplyNumberedList" />
                    <MudIconButton Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Color="Color.Primary" Title="Párrafo" aria-label="Añadir párrafo" Disabled="@saving" OnClick="ApplyParagraph" />
                </div>
                <MudTextField Margin="Margin.Dense" T="string"
                              @bind-Value="item.Justificacion"
                              Label="Justificacion"
                              Variant="Variant.Outlined"
                              Lines="8"
                              Required="true"
                              RequiredError="Captura la justificacion."
                              Disabled="@saving"
                              HelperText="Puedes usar saltos de linea, listas y marcas simples como **texto importante**." />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
    }
</BaseCrudDialog>
