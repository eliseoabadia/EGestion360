@page "/configuracion/Patrimonio/Personas"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<PersonaResponse, PersonaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Personas"
                    Subtitle="Catálogo de personas"
                    Icon="@Icons.Material.Filled.People"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="PersonaResponse"
                  @ref="table"
                  Title="Lista de Personas"
                  SearchPlaceholder="Buscar por nombre, RFC o CURP..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="PersonaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidPersona))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidPersona))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="PersonaResponse" TProperty="int" Property="x => x.PkidPersona" Title="ID" Identifier="PkidPersona" />
                <PropertyColumn T="PersonaResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="PersonaResponse" TProperty="string" Property="x => x.Nombre" Title="Nombre" Identifier="Nombre" />
                <PropertyColumn T="PersonaResponse" TProperty="string" Property="x => x.Paterno" Title="Paterno" Identifier="Paterno" />
                <PropertyColumn T="PersonaResponse" TProperty="string" Property="x => x.Materno" Title="Materno" Identifier="Materno" />
                <PropertyColumn T="PersonaResponse" TProperty="string" Property="x => x.Rfc" Title="RFC" Identifier="Rfc" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<PersonaResponse> table = null!;

    protected override string ModuleName => "Patrimonio";
    protected override string SubModuleName => "Personas";

    protected override Type CreateDialogType => typeof(PersonaDialog);
    protected override Type EditDialogType => typeof(PersonaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<PersonaResponse>);

    protected override string GetDefaultSortLabel() => "Nombre";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<PersonaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidPersona,
            Clave = u.Clave,
            Nombre = u.Nombre,
            Paterno = u.Paterno,
            Materno = u.Materno,
            RFC = u.Rfc,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Nombre ?? "la persona";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
