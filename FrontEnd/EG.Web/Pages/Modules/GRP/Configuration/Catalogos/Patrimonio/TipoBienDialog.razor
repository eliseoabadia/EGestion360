@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Services
@using System.Net.Http.Json
@using EG.Common.GenericModel

@inject IGenericCrudService<TipoBienResponse> Service
@inject HttpClient Http
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoBienResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.ExtraExtraLarge"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando catálogos..."
                 OnConfirm="GuardarCambiosAsync">

    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-8">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-3">Cargando catálogos...</MudText>
        </div>
    }
    else
    {
        <MudContainer Class="py-2">
            <MudGrid GutterSize="2" Spacing="2">

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Información General</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedGrupo"
                                       ValueChanged="value => _selectedGrupo = value"
                                       Label="Clave CUCOP (SICOP)"
                                       Required="true"
                                       LoadPage="LoadGruposPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedNivel"
                                       ValueChanged="value => _selectedNivel = value"
                                       Label="Nivel"
                                       LoadPage="LoadNivelesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CodigoClave"
                                  Label="Código o Clave"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  RequiredError="El código es requerido" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.Identificador"
                                  Label="Identificador de Almacén"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="item.TipoBienDescripcion"
                                  Label="Descripción"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Required="true"
                                  RequiredError="La descripción es requerida" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPartida"
                                       ValueChanged="value => _selectedPartida = value"
                                       Label="Partida"
                                       LoadPage="LoadPartidasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedCuenta"
                                       ValueChanged="value => _selectedCuenta = value"
                                       Label="Cuenta Contable"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Unidades y Medidas</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedUnidad"
                                       ValueChanged="value => _selectedUnidad = value"
                                       Label="Unidades"
                                       LoadPage="LoadUnidadesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedUnidadEq"
                                       ValueChanged="value => _selectedUnidadEq = value"
                                       Label="Unidades Equivalente"
                                       LoadPage="LoadUnidadesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CantidadEquivalente"
                                  Label="Cantidad Equivalente"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.Consecutivo"
                                  Label="Consecutivo"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Financiero y Control</MudText>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.DepreciacionAnual"
                                  Label="Depreciación Anual"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.TiempoVida"
                                  Label="Tiempo de Vida (Días)"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.Cuota"
                                  Label="Cuota"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.ExistenciaMinima"
                                  Label="Existencia Mínima"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.ExistenciaMaxima"
                                  Label="Existencia Máxima"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.Cabms"
                                  Label="CABMS"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.CucopPlus"
                                  Label="Cucop Plus"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCheckBox @bind-Value="item.ProveeduriaNac" Label="Proveeduría Nacional" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCheckBox @bind-Value="item.CatalogoBasico" Label="Catálogo Básico" />
                </MudItem>


            </MudGrid>
        </MudContainer>
    }
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private TipoBienResponse item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Tipo de Bien" : "Nuevo Tipo de Bien";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private bool _loading = true;

    private LookupItem? _selectedGrupo;
    private LookupItem? _selectedNivel;
    private LookupItem? _selectedPartida;
    private LookupItem? _selectedCuenta;
    private LookupItem? _selectedUnidad;
    private LookupItem? _selectedUnidadEq;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
        _loading = false;
    }

    private Task<ComboLookupResult> LoadGruposPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/GrupoBien/GetLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadNivelesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Nivel/GetLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPartidasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Partida/GetLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadCuentasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/CuentaContable/GetLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadUnidadesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Unidades/GetLookupPaginado", page, pageSize, filter, ct);

    private async Task<ComboLookupResult> LoadLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true)
            {
                var d = response.Data ?? response.Items?.FirstOrDefault();
                if (d != null)
                {
                    item = d;

                    if (d.FkidGrupoBienAlma.HasValue)
                        _selectedGrupo = new LookupItem { Id = d.FkidGrupoBienAlma.Value, Text = $"{d.GrupoBienClave} - {d.GrupoBienDescripcion}" };

                    if (d.FkidNivelAlma.HasValue)
                        _selectedNivel = new LookupItem { Id = d.FkidNivelAlma.Value, Text = d.NivelDescripcion };

                    if (d.FkidPartidaConta.HasValue)
                        _selectedPartida = new LookupItem { Id = d.FkidPartidaConta.Value, Text = $"{d.PartidaClave} - {d.PartidaDescripcion}" };

                    if (d.FkidCuentaContableConta.HasValue)
                        _selectedCuenta = new LookupItem { Id = d.FkidCuentaContableConta.Value, Text = $"{d.CtaCoi} - {d.CuentaDescripcion}" };

                    if (d.FkidUnidadesAlma.HasValue)
                        _selectedUnidad = new LookupItem { Id = d.FkidUnidadesAlma.Value, Text = d.UnidadMedida };

                    if (d.FkidUnidadesEquivalente.HasValue)
                        _selectedUnidadEq = new LookupItem { Id = d.FkidUnidadesEquivalente.Value, Text = d.UnidadEquivalenteMedida };
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            item.FkidGrupoBienAlma = _selectedGrupo?.Id;
            item.FkidNivelAlma = _selectedNivel?.Id;
            item.FkidPartidaConta = _selectedPartida?.Id;
            item.FkidCuentaContableConta = _selectedCuenta?.Id;
            item.FkidUnidadesAlma = _selectedUnidad?.Id;
            item.FkidUnidadesEquivalente = _selectedUnidadEq?.Id;

            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Tipo de bien actualizado correctamente" : "Tipo de bien creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
