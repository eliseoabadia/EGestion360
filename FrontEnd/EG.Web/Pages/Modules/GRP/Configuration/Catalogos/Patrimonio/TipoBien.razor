@page "/configuracion/Patrimonio/Bienes_Servicios"
@page "/configuracion/almacen/Tipo_Bien"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoBienResponse, TipoBienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Bien"
                    Subtitle="Catálogo de tipos de bien"
                    Icon="@Icons.Material.Filled.Category"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="TipoBienResponse"
                      @ref="table"
                      Title="Lista de Tipos de Bien"
                      SearchPlaceholder="Buscar por descripción, grupo o clave..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <ToolbarActions>
                <MudTooltip Text="Mostrar u ocultar columnas">
                    <MudMenu Icon="@Icons.Material.Filled.ViewColumn"
                             Color="Color.Primary"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Class="mr-2">
                        <div class="tipo-bien-column-menu" @onclick:stopPropagation="true">
                            <MudText Typo="Typo.subtitle2" Class="column-menu-title">Columnas visibles</MudText>
                            @foreach (var column in ColumnOptions)
                            {
                                <MudCheckBox T="bool"
                                             Dense="true"
                                             Label="@column.Label"
                                             Value="@IsColumnVisible(column.Key)"
                                             ValueChanged="@((bool visible) => SetColumnVisibility(column.Key, visible))" />
                            }
                            <MudDivider Class="my-1" />
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="ResetVisibleColumns">
                                Restablecer
                            </MudButton>
                        </div>
                    </MudMenu>
                </MudTooltip>
            </ToolbarActions>

            <Header>
                <MudTh>Acciones</MudTh>
                @if (IsColumnVisible(ColumnId))
                {
                    <MudTh><MudTableSortLabel SortLabel="PkidTipoBien" T="TipoBienResponse">Id</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnGrupo))
                {
                    <MudTh Style="min-width: 180px;"><MudTableSortLabel SortLabel="GrupoBienDescripcion" T="TipoBienResponse">Clave CUCOP</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnCodigo))
                {
                    <MudTh><MudTableSortLabel SortLabel="CodigoClave" T="TipoBienResponse">Código o Clave</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnPartida))
                {
                    <MudTh><MudTableSortLabel SortLabel="PartidaDescripcion" T="TipoBienResponse">Partida</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnDescripcion))
                {
                    <MudTh Style="min-width: 220px;"><MudTableSortLabel SortLabel="TipoBienDescripcion" T="TipoBienResponse">Descripción</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnDepreciacion))
                {
                    <MudTh><MudTableSortLabel SortLabel="DepreciacionAnual" T="TipoBienResponse">Depreciación Anual</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnConsecutivo))
                {
                    <MudTh><MudTableSortLabel SortLabel="Consecutivo" T="TipoBienResponse">Consecutivo</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnIdentificador))
                {
                    <MudTh><MudTableSortLabel SortLabel="Identificador" T="TipoBienResponse">Identificador de Almacén</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnExistenciaMinima))
                {
                    <MudTh><MudTableSortLabel SortLabel="ExistenciaMinima" T="TipoBienResponse">Existencia Mínima</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnExistenciaMaxima))
                {
                    <MudTh><MudTableSortLabel SortLabel="ExistenciaMaxima" T="TipoBienResponse">Existencia Máxima</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnTiempoVida))
                {
                    <MudTh><MudTableSortLabel SortLabel="TiempoVida" T="TipoBienResponse">Tiempo de Vida</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnUnidades))
                {
                    <MudTh><MudTableSortLabel SortLabel="UnidadMedida" T="TipoBienResponse">Unidades</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnCatalogoBasico))
                {
                    <MudTh><MudTableSortLabel SortLabel="CatalogoBasico" T="TipoBienResponse">Catálogo Básico</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnCucopPlus))
                {
                    <MudTh><MudTableSortLabel SortLabel="CucopPlus" T="TipoBienResponse">Cucop Plus</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnCantidadEquivalente))
                {
                    <MudTh><MudTableSortLabel SortLabel="CantidadEquivalente" T="TipoBienResponse">Cantidad Equivalente</MudTableSortLabel></MudTh>
                }
                @if (IsColumnVisible(ColumnUnidadEquivalente))
                {
                    <MudTh><MudTableSortLabel SortLabel="UnidadEquivalenteMedida" T="TipoBienResponse">Unidades Equivalente</MudTableSortLabel></MudTh>
                }
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidTipoBien))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidTipoBien))" />
                    </MudTooltip>
                </MudTd>
                @if (IsColumnVisible(ColumnId))
                {
                    <MudTd>@item.PkidTipoBien</MudTd>
                }
                @if (IsColumnVisible(ColumnGrupo))
                {
                    <MudTd>@item.GrupoBienDescripcion</MudTd>
                }
                @if (IsColumnVisible(ColumnCodigo))
                {
                    <MudTd>@item.CodigoClave</MudTd>
                }
                @if (IsColumnVisible(ColumnPartida))
                {
                    <MudTd>@item.PartidaDescripcion</MudTd>
                }
                @if (IsColumnVisible(ColumnDescripcion))
                {
                    <MudTd>@item.TipoBienDescripcion</MudTd>
                }
                @if (IsColumnVisible(ColumnDepreciacion))
                {
                    <MudTd>@item.DepreciacionAnual</MudTd>
                }
                @if (IsColumnVisible(ColumnConsecutivo))
                {
                    <MudTd>@item.Consecutivo</MudTd>
                }
                @if (IsColumnVisible(ColumnIdentificador))
                {
                    <MudTd>@item.Identificador</MudTd>
                }
                @if (IsColumnVisible(ColumnExistenciaMinima))
                {
                    <MudTd>@item.ExistenciaMinima</MudTd>
                }
                @if (IsColumnVisible(ColumnExistenciaMaxima))
                {
                    <MudTd>@item.ExistenciaMaxima</MudTd>
                }
                @if (IsColumnVisible(ColumnTiempoVida))
                {
                    <MudTd>@item.TiempoVida</MudTd>
                }
                @if (IsColumnVisible(ColumnUnidades))
                {
                    <MudTd>@item.UnidadMedida</MudTd>
                }
                @if (IsColumnVisible(ColumnCatalogoBasico))
                {
                    <MudTd>
                        <MudChip T="string" Color="@(item.CatalogoBasico == true ? Color.Success : Color.Error)" Size="Size.Small">
                            @(item.CatalogoBasico == true ? "Sí" : "No")
                        </MudChip>
                    </MudTd>
                }
                @if (IsColumnVisible(ColumnCucopPlus))
                {
                    <MudTd>@item.CucopPlus</MudTd>
                }
                @if (IsColumnVisible(ColumnCantidadEquivalente))
                {
                    <MudTd>@item.CantidadEquivalente</MudTd>
                }
                @if (IsColumnVisible(ColumnUnidadEquivalente))
                {
                    <MudTd>@item.UnidadEquivalenteMedida</MudTd>
                }
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

<style>
    .tipo-bien-column-menu {
        display: grid;
        gap: 2px;
        min-width: 250px;
        max-height: 440px;
        overflow: auto;
        padding: 10px 12px;
    }

    .tipo-bien-column-menu .column-menu-title {
        font-weight: 800;
        margin-bottom: 4px;
    }

    .tipo-bien-column-menu .mud-checkbox {
        margin: 0;
    }
</style>

@code {
    private GenericTable<TipoBienResponse> table = null!;

    private const string ColumnId = "Id";
    private const string ColumnGrupo = "Grupo";
    private const string ColumnCodigo = "Codigo";
    private const string ColumnPartida = "Partida";
    private const string ColumnDescripcion = "Descripcion";
    private const string ColumnDepreciacion = "Depreciacion";
    private const string ColumnConsecutivo = "Consecutivo";
    private const string ColumnIdentificador = "Identificador";
    private const string ColumnExistenciaMinima = "ExistenciaMinima";
    private const string ColumnExistenciaMaxima = "ExistenciaMaxima";
    private const string ColumnTiempoVida = "TiempoVida";
    private const string ColumnUnidades = "Unidades";
    private const string ColumnCatalogoBasico = "CatalogoBasico";
    private const string ColumnCucopPlus = "CucopPlus";
    private const string ColumnCantidadEquivalente = "CantidadEquivalente";
    private const string ColumnUnidadEquivalente = "UnidadEquivalente";

    private static readonly string[] DefaultVisibleColumns =
    {
        ColumnId,
        ColumnGrupo,
        ColumnCodigo,
        ColumnPartida,
        ColumnDescripcion,
        ColumnExistenciaMinima,
        ColumnExistenciaMaxima
    };

    private static readonly ColumnOption[] ColumnOptions =
    {
        new(ColumnId, "Id"),
        new(ColumnGrupo, "Clave CUCOP"),
        new(ColumnCodigo, "Código o Clave"),
        new(ColumnPartida, "Partida"),
        new(ColumnDescripcion, "Descripción"),
        new(ColumnDepreciacion, "Depreciación Anual"),
        new(ColumnConsecutivo, "Consecutivo"),
        new(ColumnIdentificador, "Identificador de Almacén"),
        new(ColumnExistenciaMinima, "Existencia Mínima"),
        new(ColumnExistenciaMaxima, "Existencia Máxima"),
        new(ColumnTiempoVida, "Tiempo de Vida"),
        new(ColumnUnidades, "Unidades"),
        new(ColumnCatalogoBasico, "Catálogo Básico"),
        new(ColumnCucopPlus, "Cucop Plus"),
        new(ColumnCantidadEquivalente, "Cantidad Equivalente"),
        new(ColumnUnidadEquivalente, "Unidades Equivalente")
    };

    private readonly HashSet<string> visibleColumns = new(DefaultVisibleColumns);

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Tipo_Bien";

    protected override Type CreateDialogType => typeof(TipoBienDialog);
    protected override Type EditDialogType => typeof(TipoBienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoBienResponse>);

    protected override string GetDefaultSortLabel() => "TipoBienDescripcion";

    private bool IsColumnVisible(string column) => visibleColumns.Contains(column);

    private void SetColumnVisibility(string column, bool visible)
    {
        if (visible)
        {
            visibleColumns.Add(column);
        }
        else
        {
            visibleColumns.Remove(column);
        }
    }

    private void ResetVisibleColumns()
    {
        visibleColumns.Clear();

        foreach (var column in DefaultVisibleColumns)
        {
            visibleColumns.Add(column);
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoBienResponse> items)
    {
        return items.Select(u => new
        {
            Id = u.PkidTipoBien,
            ClaveCUCOP = u.GrupoBienDescripcion ?? string.Empty,
            CodigoClave = u.CodigoClave ?? string.Empty,
            Partida = u.PartidaDescripcion ?? string.Empty,
            Descripcion = u.TipoBienDescripcion ?? string.Empty,
            DepreciacionAnual = u.DepreciacionAnual,
            Consecutivo = u.Consecutivo,
            Identificador = u.Identificador ?? string.Empty,
            ExistenciaMinima = u.ExistenciaMinima,
            ExistenciaMaxima = u.ExistenciaMaxima,
            TiempoVida = u.TiempoVida,
            Unidades = u.UnidadMedida ?? string.Empty,
            CatalogoBasico = u.CatalogoBasico == true ? "Sí" : "No",
            CucopPlus = u.CucopPlus ?? string.Empty,
            CantidadEquivalente = u.CantidadEquivalente,
            UnidadesEquivalente = u.UnidadEquivalenteMedida ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.TipoBienDescripcion ?? response?.Items?.FirstOrDefault()?.TipoBienDescripcion ?? "el tipo de bien";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private sealed record ColumnOption(string Key, string Label);
}
