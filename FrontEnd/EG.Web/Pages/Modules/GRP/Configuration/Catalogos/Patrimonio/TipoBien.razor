@page "/configuracion/Patrimonio/Bienes_Servicios"
@page "/configuracion/almacen/Tipo_Bien"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoBienResponse, TipoBienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Bien"
                    Subtitle="Catálogo de tipos de bien"
                    Icon="@Icons.Material.Filled.Category"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="TipoBienResponse"
                      @ref="table"
                      Title="Lista de Tipos de Bien"
                      SearchPlaceholder="Buscar por descripción, grupo o clave..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="TipoBienResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoBien))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoBien))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoBienResponse" TProperty="int" Property="x => x.PkidTipoBien" Title="ID" Identifier="PkidTipoBien" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.GrupoBienDescripcion" Title="Clave CUCOP" Identifier="GrupoBienDescripcion" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.CodigoClave" Title="Código o Clave" Identifier="CodigoClave" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.PartidaDescripcion" Title="Partida" Identifier="PartidaDescripcion" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.TipoBienDescripcion" Title="Descripción" Identifier="TipoBienDescripcion" />
                <PropertyColumn T="TipoBienResponse" TProperty="decimal?" Property="x => x.DepreciacionAnual" Title="Depreciación Anual" Identifier="DepreciacionAnual" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="int?" Property="x => x.Consecutivo" Title="Consecutivo" Identifier="Consecutivo" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.Identificador" Title="Identificador de Almacén" Identifier="Identificador" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="decimal?" Property="x => x.ExistenciaMinima" Title="Existencia Mínima" Identifier="ExistenciaMinima" />
                <PropertyColumn T="TipoBienResponse" TProperty="decimal?" Property="x => x.ExistenciaMaxima" Title="Existencia Máxima" Identifier="ExistenciaMaxima" />
                <PropertyColumn T="TipoBienResponse" TProperty="int?" Property="x => x.TiempoVida" Title="Tiempo de Vida" Identifier="TiempoVida" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.UnidadMedida" Title="Unidades" Identifier="UnidadMedida" Hidden="true" />
                <TemplateColumn Resizable="true" T="TipoBienResponse" Title="Catálogo Básico" Identifier="CatalogoBasico" Hidden="true"><CellTemplate><MudChip T="string" Color="@(context.Item.CatalogoBasico == true ? Color.Success : Color.Error)" Size="Size.Small">@(context.Item.CatalogoBasico == true ? "Sí" : "No")</MudChip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.CucopPlus" Title="CUCOP Plus" Identifier="CucopPlus" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="int?" Property="x => x.CantidadEquivalente" Title="Cantidad Equivalente" Identifier="CantidadEquivalente" Hidden="true" />
                <PropertyColumn T="TipoBienResponse" TProperty="string" Property="x => x.UnidadEquivalenteMedida" Title="Unidades Equivalente" Identifier="UnidadEquivalenteMedida" Hidden="true" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

<style>
    .tipo-bien-column-menu {
        display: grid;
        gap: 2px;
        min-width: 250px;
        max-height: 440px;
        overflow: auto;
        padding: 10px 12px;
    }

    .tipo-bien-column-menu .column-menu-title {
        font-weight: 800;
        margin-bottom: 4px;
    }

    .tipo-bien-column-menu .mud-checkbox {
        margin: 0;
    }
</style>

@code {
    private GenericDataGrid<TipoBienResponse> table = null!;

    private const string ColumnId = "Id";
    private const string ColumnGrupo = "Grupo";
    private const string ColumnCodigo = "Codigo";
    private const string ColumnPartida = "Partida";
    private const string ColumnDescripcion = "Descripcion";
    private const string ColumnDepreciacion = "Depreciacion";
    private const string ColumnConsecutivo = "Consecutivo";
    private const string ColumnIdentificador = "Identificador";
    private const string ColumnExistenciaMinima = "ExistenciaMinima";
    private const string ColumnExistenciaMaxima = "ExistenciaMaxima";
    private const string ColumnTiempoVida = "TiempoVida";
    private const string ColumnUnidades = "Unidades";
    private const string ColumnCatalogoBasico = "CatalogoBasico";
    private const string ColumnCucopPlus = "CucopPlus";
    private const string ColumnCantidadEquivalente = "CantidadEquivalente";
    private const string ColumnUnidadEquivalente = "UnidadEquivalente";

    private static readonly string[] DefaultVisibleColumns =
    {
        ColumnId,
        ColumnGrupo,
        ColumnCodigo,
        ColumnPartida,
        ColumnDescripcion,
        ColumnExistenciaMinima,
        ColumnExistenciaMaxima
    };

    private static readonly ColumnOption[] ColumnOptions =
    {
        new(ColumnId, "Id"),
        new(ColumnGrupo, "Clave CUCOP"),
        new(ColumnCodigo, "Código o Clave"),
        new(ColumnPartida, "Partida"),
        new(ColumnDescripcion, "Descripción"),
        new(ColumnDepreciacion, "Depreciación Anual"),
        new(ColumnConsecutivo, "Consecutivo"),
        new(ColumnIdentificador, "Identificador de Almacén"),
        new(ColumnExistenciaMinima, "Existencia Mínima"),
        new(ColumnExistenciaMaxima, "Existencia Máxima"),
        new(ColumnTiempoVida, "Tiempo de Vida"),
        new(ColumnUnidades, "Unidades"),
        new(ColumnCatalogoBasico, "Catálogo Básico"),
        new(ColumnCucopPlus, "Cucop Plus"),
        new(ColumnCantidadEquivalente, "Cantidad Equivalente"),
        new(ColumnUnidadEquivalente, "Unidades Equivalente")
    };

    private readonly HashSet<string> visibleColumns = new(DefaultVisibleColumns);

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Tipo_Bien";

    protected override Type CreateDialogType => typeof(TipoBienDialog);
    protected override Type EditDialogType => typeof(TipoBienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoBienResponse>);

    protected override string GetDefaultSortLabel() => "TipoBienDescripcion";

    private bool IsColumnVisible(string column) => visibleColumns.Contains(column);

    private void SetColumnVisibility(string column, bool visible)
    {
        if (visible)
        {
            visibleColumns.Add(column);
        }
        else
        {
            visibleColumns.Remove(column);
        }
    }

    private void ResetVisibleColumns()
    {
        visibleColumns.Clear();

        foreach (var column in DefaultVisibleColumns)
        {
            visibleColumns.Add(column);
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoBienResponse> items)
    {
        return items.Select(u => new
        {
            Id = u.PkidTipoBien,
            ClaveCUCOP = u.GrupoBienDescripcion ?? string.Empty,
            CodigoClave = u.CodigoClave ?? string.Empty,
            Partida = u.PartidaDescripcion ?? string.Empty,
            Descripcion = u.TipoBienDescripcion ?? string.Empty,
            DepreciacionAnual = u.DepreciacionAnual,
            Consecutivo = u.Consecutivo,
            Identificador = u.Identificador ?? string.Empty,
            ExistenciaMinima = u.ExistenciaMinima,
            ExistenciaMaxima = u.ExistenciaMaxima,
            TiempoVida = u.TiempoVida,
            Unidades = u.UnidadMedida ?? string.Empty,
            CatalogoBasico = u.CatalogoBasico == true ? "Sí" : "No",
            CucopPlus = u.CucopPlus ?? string.Empty,
            CantidadEquivalente = u.CantidadEquivalente,
            UnidadesEquivalente = u.UnidadEquivalenteMedida ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.TipoBienDescripcion ?? response?.Items?.FirstOrDefault()?.TipoBienDescripcion ?? "el tipo de bien";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private sealed record ColumnOption(string Key, string Label);
}
