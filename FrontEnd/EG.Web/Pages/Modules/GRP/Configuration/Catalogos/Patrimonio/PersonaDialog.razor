@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Patrimonio

@inject IGenericCrudService<PersonaResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="PersonaResponse"
    Title="@dialogTitle"
    MaxWidth="MaxWidth.Medium"
    ActionText="@actionText"
    ProcessingText="@processingText"
    LoadingMessage="@EG.Common.ApplicationText.Status.LoadingData"
    OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="PersonaResponse"
        @ref="form"
        ShowHeader="true"
        HeaderTitle="@dialogTitle">
        <CrudFormSection Title="Datos personales">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Clave"
            Label="Clave"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.Clave)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Nombre"
            Label="Nombre"
            Variant="Variant.Outlined"
            FullWidth="true"

            Required="true"
            For="@(() => item.Nombre)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Paterno"
            Label="Apellido Paterno"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.Paterno)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Materno"
            Label="Apellido Materno"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.Materno)" />
                </MudItem>
            </MudGrid>
        </CrudFormSection>

        <CrudFormSection Title="Identificadores y contacto">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Rfc"
            Label="RFC"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.Rfc)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.Curp"
            Label="CURP"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.Curp)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" @bind-Value="item.TelefonoMovil"
            Label="Teléfono Móvil"
            Variant="Variant.Outlined"
            FullWidth="true"

            For="@(() => item.TelefonoMovil)" />
                </MudItem>
            </MudGrid>
        </CrudFormSection>
</BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PersonaResponse> form = null!;
    private PersonaResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Persona" : "Nueva Persona";
    private string actionText => Id.HasValue ? EG.Common.ApplicationText.Actions.Update : EG.Common.ApplicationText.Actions.Create;
    private string processingText => Id.HasValue ? EG.Common.ApplicationText.Status.Updating : EG.Common.ApplicationText.Status.Creating;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(dialogTitle.Contains(EG.Common.ApplicationText.Actions.Edit) ? "Persona actualizada correctamente" : "Persona creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}

