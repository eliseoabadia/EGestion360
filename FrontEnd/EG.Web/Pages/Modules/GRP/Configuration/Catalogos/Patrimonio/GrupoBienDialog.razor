@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Services

@inject IGenericCrudService<GrupoBienResponse> Service
@inject IGenericCrudService<FamiliaResponse> FamiliaService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="GrupoBienResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Medium"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="GrupoBienResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudSelect T="int" Label="Familia"
                           @bind-Value="item.FkidFamiliaAlma"
                           Required="true"
                           RequiredError="La familia es requerida"
                           Disabled="@(familiaList.Count == 0)">
                    @foreach (var fam in familiaList)
                    {
                        <MudSelectItem Value="@fam.PkidFamilia">@fam.Clave - @fam.Descripcion</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.GrupoBienClave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.GrupoBienDescripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              RequiredError="La descripción es requerida" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.ClaveAn"
                              Label="Clave AN"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.CabmAct"
                              Label="CABM ACT"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.ClaveCucop"
                              Label="Clave CUCOP"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Medida"
                              Label="Medida"
                              Variant="Variant.Outlined"
                              FullWidth="true" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<GrupoBienResponse> form = null!;
    private GrupoBienResponse item = new() { Activo = true };
    private List<FamiliaResponse> familiaList = new();

    private string dialogTitle => Id.HasValue ? "Editar Grupo de Bien" : "Nuevo Grupo de Bien";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await CargarFamilias();
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarFamilias()
    {
        try
        {
            var response = await FamiliaService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                familiaList = response.Items.OfType<FamiliaResponse>().Where(f => f.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar familias: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Grupo de bien actualizado correctamente" : "Grupo de bien creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
