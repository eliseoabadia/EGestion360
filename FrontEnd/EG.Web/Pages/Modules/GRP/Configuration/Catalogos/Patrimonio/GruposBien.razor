@page "/configuracion/Patrimonio/Grupo_Bien"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<GrupoBienResponse, GrupoBienResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Grupos de Bien"
                    Subtitle="Catálogo de grupos de bien"
                    Icon="@Icons.Material.Filled.ViewModule"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="GrupoBienResponse"
                      @ref="table"
                      Title="Lista de Grupos de Bien"
                      SearchPlaceholder="Buscar por descripción, familia o clave..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="GrupoBienResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidGrupoBien))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidGrupoBien))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="GrupoBienResponse" TProperty="string" Property="x => x.FamiliaClave" Title="Clave Familia" Identifier="FamiliaClave" />
                <PropertyColumn T="GrupoBienResponse" TProperty="string" Property="x => x.FamiliaDescripcion" Title="Familia" Identifier="FamiliaDescripcion" />
                <PropertyColumn T="GrupoBienResponse" TProperty="int?" Property="x => x.GrupoBienClave" Title="Clave Grupo" Identifier="GrupoBienClave" />
                <PropertyColumn T="GrupoBienResponse" TProperty="string" Property="x => x.GrupoBienDescripcion" Title="Descripción" Identifier="GrupoBienDescripcion" />
                <PropertyColumn T="GrupoBienResponse" TProperty="string" Property="x => x.ClaveCucop" Title="CUCOP" Identifier="ClaveCucop" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<GrupoBienResponse> table = null!;

    protected override string ModuleName => "Patrimonio";
    protected override string SubModuleName => "Grupo_Bien";

    protected override Type CreateDialogType => typeof(GrupoBienDialog);
    protected override Type EditDialogType => typeof(GrupoBienDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<GrupoBienResponse>);

    protected override string GetDefaultSortLabel() => "GrupoBienDescripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<GrupoBienResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidGrupoBien,
            ClaveFamilia = u.FamiliaClave,
            Familia = u.FamiliaDescripcion ?? string.Empty,
            ClaveGrupo = u.GrupoBienClave,
            GrupoBien = u.GrupoBienDescripcion ?? string.Empty,
            CUCOP = u.ClaveCucop ?? string.Empty,
            Medida = u.Medida ?? string.Empty,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.GrupoBienDescripcion ?? "el grupo de bien";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
