@page "/configuracion/presupuestales/clave-programa/pg"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<PgResponse, PgResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="PGs"
                    Subtitle="Catálogo de PGs"
                    Icon="@Icons.Material.Filled.Description"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="PgResponse"
                      @ref="table"
                      Title="Lista de PGs"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="PgResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidPg))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidPg))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="PgResponse" TProperty="int" Property="x => x.PkidPg" Title="ID" Identifier="PkidPg" />
                <PropertyColumn T="PgResponse" TProperty="int" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="PgResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<PgResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "PG";

    protected override Type CreateDialogType => typeof(PgDialog);
    protected override Type EditDialogType => typeof(PgDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<PgResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<PgResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidPg,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el PG";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
