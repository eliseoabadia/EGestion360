@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using MudBlazor

@inject IGenericCrudService<ProgramaPresupuestalResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="ProgramaPresupuestalResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Small"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando programa presupuestal..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ProgramaPresupuestalResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La clave es requerida"
                              MaxLength="20" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripcion"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La descripcion es requerida"
                              Lines="3"
                              MaxLength="500" />
            </MudItem>

            @if (Id.HasValue)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                        <MudSwitch T="bool"
                                   @bind-Value="item.Activo"
                                   Color="Color.Primary"
                                   ThumbIcon="@(item.Activo ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                            <MudText>@(item.Activo ? "Activo" : "Inactivo")</MudText>
                        </MudSwitch>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ProgramaPresupuestalResponse> form = null!;
    private ProgramaPresupuestalResponse item = new()
    {
        Activo = true,
        Clave = string.Empty,
        Descripcion = string.Empty
    };

    private string dialogTitle => Id.HasValue ? "Editar Programa Presupuestal" : "Nuevo Programa Presupuestal";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        item.Clave = item.Clave?.Trim() ?? string.Empty;
        item.Descripcion = item.Descripcion?.Trim() ?? string.Empty;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(
                    response.Message ?? (Id.HasValue
                        ? "Programa Presupuestal actualizado correctamente"
                        : "Programa Presupuestal creado correctamente"),
                    Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar el programa presupuestal.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
