@page "/configuracion/presupuestales/clave-programa/programa-presupuestal"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ProgramaPresupuestalResponse, ProgramaPresupuestalResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Programa Presupuestal"
                    Subtitle="Catalogo PRES.PP para clasificar la clave del programa"
                    Icon="@Icons.Material.Filled.Article"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="ProgramaPresupuestalResponse"
                      @ref="table"
                      Title="Lista de Programas Presupuestales"
                      SearchPlaceholder="Buscar por clave o descripcion..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="ProgramaPresupuestalResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar programa presupuestal"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidPp))" /></MudTooltip><MudTooltip Text="Eliminar programa presupuestal"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidPp))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ProgramaPresupuestalResponse" TProperty="int" Property="x => x.PkidPp" Title="ID" Identifier="PkidPp" />
                <TemplateColumn Resizable="true" T="ProgramaPresupuestalResponse" Title="Clave" Identifier="Clave"><CellTemplate><MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@context.Item.Clave</MudChip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ProgramaPresupuestalResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ProgramaPresupuestalResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Programa_Presupuestal";

    protected override Type CreateDialogType => typeof(ProgramaPresupuestalDialog);
    protected override Type EditDialogType => typeof(ProgramaPresupuestalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ProgramaPresupuestalResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ProgramaPresupuestalResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidPp,
            item.Clave,
            item.Descripcion,
            Estatus = item.Activo ? "Activo" : "Inactivo",
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClaveNombre ?? "el programa presupuestal";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private static string DateOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
}
