@page "/configuracion/presupuestales/programas-presupuesta"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using EG.Web.Services
@using MiniExcelLibs
@using MudBlazor
@implements IDisposable
@inject AnioPresupuestalStateService AnioStateService
@inherits BaseCrudPage<ProgramaResponse, ProgramaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Programas Presupuestales"
                    Subtitle="Catalogo de programas presupuestales"
                    Icon="@Icons.Material.Filled.Key"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="ProgramaResponse"
                      @ref="table"
                      Title="Lista de Programas Presupuestales"
                      SearchPlaceholder="Buscar por clave, descripcion o catalogos..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidPrograma" T="ProgramaResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="ProgramaResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="ProgramaResponse">Descripcion</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="UrclaveNombre" T="ProgramaResponse">UR</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GfclaveNombre" T="ProgramaResponse">GF</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FnclaveNombre" T="ProgramaResponse">FN</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SfclaveNombre" T="ProgramaResponse">SF</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="ActividadInstitucionalClaveNombre" T="ProgramaResponse">Actividad</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="AnioClave" T="ProgramaResponse">Anio</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidPrograma))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidPrograma))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidPrograma</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@TextOrDash(item.UrclaveNombre)</MudTd>
                <MudTd>@TextOrDash(item.GfclaveNombre)</MudTd>
                <MudTd>@TextOrDash(item.FnclaveNombre)</MudTd>
                <MudTd>@TextOrDash(item.SfclaveNombre)</MudTd>
                <MudTd>@TextOrDash(item.ActividadInstitucionalClaveNombre)</MudTd>
                <MudTd>@(item.AnioClave?.ToString() ?? "-")</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<ProgramaResponse> table = null!;

    protected override string ModuleName => "Catalogos_presupuestales";
    protected override string SubModuleName => "Programas_Presupuestales";

    protected override Type CreateDialogType => typeof(ProgramaDialog);
    protected override Type EditDialogType => typeof(ProgramaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ProgramaResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
    }

    protected override async Task<TableData<ProgramaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var page = Math.Max(1, state.Page + 1);
            CurrentPage = page;
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
                return new TableData<ProgramaResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrEmpty(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<ProgramaResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<ProgramaResponse>
            {
                Items = new List<ProgramaResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ProgramaResponse> items)
    {
        return items.Select(p => new
        {
            ID = p.PkidPrograma,
            p.Clave,
            p.Descripcion,
            p.Objetivo,
            UR = p.UrclaveNombre,
            GF = p.GfclaveNombre,
            FN = p.FnclaveNombre,
            SF = p.SfclaveNombre,
            ActividadInstitucional = p.ActividadInstitucionalClaveNombre,
            Anio = p.AnioClave,
            Sector = p.SectorClaveNombre,
            TipoRecurso = p.TipoRecursoClaveNombre,
            FuenteFinanciamiento = p.FuenteFinanciamientoClaveNombre,
            ProgramaPresupuestal = p.PpclaveNombre,
            p.Activo,
            p.FechaCreacion,
            p.UsuarioCreacion,
            p.FechaModificacion,
            p.UsuarioModificacion
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClaveNombre ?? "el programa presupuestal";
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync(
            CreateDialogType,
            "Crear Programa Presupuestal",
            new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true });

        if ((await dialog.Result) is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Id"] = id };
        var dialog = await DialogService.ShowAsync(
            EditDialogType,
            "Editar Programa Presupuestal",
            parameters,
            new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true });

        if ((await dialog.Result) is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            var response = await Service.GetAllPaginadoAsync(1, int.MaxValue, SearchString, sortLabel, SortDirection, filters);

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add(response?.Message ?? "No hay datos para exportar", Severity.Warning);
                return;
            }

            var excelData = MapToExcelData(response.Items);
            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(excelData);

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{AnioStateService.AnioClave}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportacion exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(ReloadData);
    }

    private bool HasSelectedAnio() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0;

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }
}
