@page "/configuracion/presupuestales/clave-programa/proyecto"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ProyectoResponse, ProyectoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Proyecto"
                    Subtitle="Catalogo PRES.PY para clasificar la clave del programa"
                    Icon="@Icons.Material.Filled.AccountTree"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="ProyectoResponse"
                      @ref="table"
                      Title="Lista de Proyectos"
                      SearchPlaceholder="Buscar por clave o descripcion..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="ProyectoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar proyecto"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidPy))" /></MudTooltip><MudTooltip Text="Eliminar proyecto"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidPy))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ProyectoResponse" TProperty="int" Property="x => x.PkidPy" Title="ID" Identifier="PkidPy" />
                <TemplateColumn Resizable="true" T="ProyectoResponse" Title="Clave" Identifier="Clave"><CellTemplate><MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@context.Item.Clave</MudChip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ProyectoResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ProyectoResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Proyecto";

    protected override Type CreateDialogType => typeof(ProyectoDialog);
    protected override Type EditDialogType => typeof(ProyectoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ProyectoResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ProyectoResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidPy,
            item.Clave,
            item.Descripcion,
            Estatus = item.Activo ? "Activo" : "Inactivo",
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClaveNombre ?? "el proyecto";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
