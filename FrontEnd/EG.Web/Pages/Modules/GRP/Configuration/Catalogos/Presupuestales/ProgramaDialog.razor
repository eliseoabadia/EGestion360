@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<ProgramaResponse> Service
@inject IGenericCrudService<UrResponse> UrService
@inject IGenericCrudService<GfResponse> GfService
@inject IGenericCrudService<FnResponse> FnService
@inject IGenericCrudService<SubFuncionResponse> SubFuncionService
@inject IGenericCrudService<ActividadInstitucionalResponse> ActividadInstitucionalService
@inject IGenericCrudService<SectorResponse> SectorService
@inject IGenericCrudService<TipoRecursoResponse> TipoRecursoService
@inject IGenericCrudService<FuenteFinanciamientoResponse> FuenteFinanciamientoService
@inject IGenericCrudService<ProgramaPresupuestalResponse> ProgramaPresupuestalService
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="ProgramaResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.ExtraExtraLarge"
                DialogClass="crud-dialog-wide-xl"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                CanConfirm="@(!_formLoading)"
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ProgramaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle"
                    Loading="@_formLoading"
                    LoadingMessage="Preparando formulario..."
                    LoadingSkeletonRows="10">

            <MudGrid GutterSize="2">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="item.Clave"
                                  Label="Clave"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  MaxLength="50"
                                  RequiredError="La clave es requerida" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="item.Descripcion"
                                  Label="Descripcion"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  MaxLength="50"
                                  RequiredError="La descripcion es requerida" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="item.Objetivo"
                                  Label="Objetivo"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  MaxLength="500" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedUr"
                                       ValueChanged="value => _selectedUr = value"
                                       Label="Unidad responsable"
                                       Required="true"
                                       RequiredError="La unidad responsable es requerida"
                                       PageSize="100"
                                       LoadPage="LoadUnidadesResponsablesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedActividadInstitucional"
                                       ValueChanged="value => _selectedActividadInstitucional = value"
                                       Label="Actividad institucional"
                                       Required="true"
                                       RequiredError="La actividad institucional es requerida"
                                       PageSize="100"
                                       LoadPage="LoadActividadesInstitucionalesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <PagedAutocomplete Value="@_selectedGf"
                                       ValueChanged="value => _selectedGf = value"
                                       Label="Grupo funcional"
                                       Required="true"
                                       RequiredError="El grupo funcional es requerido"
                                       PageSize="100"
                                       LoadPage="LoadGruposFuncionalesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <PagedAutocomplete Value="@_selectedFn"
                                       ValueChanged="value => _selectedFn = value"
                                       Label="Funcion"
                                       Required="true"
                                       RequiredError="La funcion es requerida"
                                       PageSize="100"
                                       LoadPage="LoadFuncionesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <PagedAutocomplete Value="@_selectedSf"
                                       ValueChanged="value => _selectedSf = value"
                                       Label="Subfuncion"
                                       Required="true"
                                       RequiredError="La subfuncion es requerida"
                                       PageSize="100"
                                       LoadPage="LoadSubFuncionesPageAsync" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <PagedAutocomplete Value="@_selectedSector"
                                       ValueChanged="value => _selectedSector = value"
                                       Label="Sector"
                                       Clearable="true"
                                       PageSize="100"
                                       LoadPage="LoadSectoresPageAsync" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <PagedAutocomplete Value="@_selectedTipoRecurso"
                                       ValueChanged="value => _selectedTipoRecurso = value"
                                       Label="Tipo recurso"
                                       Clearable="true"
                                       PageSize="100"
                                       LoadPage="LoadTiposRecursoPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedFuenteFinanciamiento"
                                       ValueChanged="value => _selectedFuenteFinanciamiento = value"
                                       Label="Fuente financiamiento"
                                       Clearable="true"
                                       PageSize="100"
                                       LoadPage="LoadFuentesFinanciamientoPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPp"
                                       ValueChanged="value => _selectedPp = value"
                                       Label="Programa presupuestal"
                                       Clearable="true"
                                       PageSize="100"
                                       LoadPage="LoadProgramasPresupuestalesPageAsync" />
                </MudItem>

            </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ProgramaResponse> form = null!;
    private ProgramaResponse item = new() { Activo = true };

    private LookupItem? _selectedUr;
    private LookupItem? _selectedGf;
    private LookupItem? _selectedFn;
    private LookupItem? _selectedSf;
    private LookupItem? _selectedActividadInstitucional;
    private LookupItem? _selectedSector;
    private LookupItem? _selectedTipoRecurso;
    private LookupItem? _selectedFuenteFinanciamiento;
    private LookupItem? _selectedPp;
    private bool _formLoading = true;

    private string dialogTitle => Id.HasValue ? "Editar Programa Presupuestal" : "Nuevo Programa Presupuestal";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SucursalStateService.InitializeAsync();
            await AnioStateService.InitializeAsync();

            if (Id.HasValue)
            {
                await CargarDatosAsync();
            }

            ApplyHeaderAnio();
        }
        finally
        {
            _formLoading = false;
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _selectedUr = new LookupItem { Id = item.FkidUrPres, Text = TextOrDefault(item.UrclaveNombre, item.FkidUrPres) };
                _selectedGf = new LookupItem { Id = item.FkidGfPres, Text = TextOrDefault(item.GfclaveNombre, item.FkidGfPres) };
                _selectedFn = new LookupItem { Id = item.FkidFnPres, Text = TextOrDefault(item.FnclaveNombre, item.FkidFnPres) };
                _selectedSf = new LookupItem { Id = item.FkidSfPres, Text = TextOrDefault(item.SfclaveNombre, item.FkidSfPres) };
                _selectedActividadInstitucional = new LookupItem { Id = item.FkidActividadInstitucionalSis, Text = TextOrDefault(item.ActividadInstitucionalClaveNombre, item.FkidActividadInstitucionalSis) };
                _selectedSector = item.FkidSectorPres.HasValue ? new LookupItem { Id = item.FkidSectorPres.Value, Text = TextOrDefault(item.SectorClaveNombre, item.FkidSectorPres.Value) } : null;
                _selectedTipoRecurso = item.FkidTipoRecursoPres.HasValue ? new LookupItem { Id = item.FkidTipoRecursoPres.Value, Text = TextOrDefault(item.TipoRecursoClaveNombre, item.FkidTipoRecursoPres.Value) } : null;
                _selectedFuenteFinanciamiento = item.FkidFuenteFinanciamientoPres.HasValue ? new LookupItem { Id = item.FkidFuenteFinanciamientoPres.Value, Text = TextOrDefault(item.FuenteFinanciamientoClaveNombre, item.FkidFuenteFinanciamientoPres.Value) } : null;
                _selectedPp = item.FkidPpPres.HasValue ? new LookupItem { Id = item.FkidPpPres.Value, Text = TextOrDefault(item.PpclaveNombre, item.FkidPpPres.Value) } : null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (_formLoading || form == null)
        {
            return;
        }

        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        if (_selectedUr == null || _selectedGf == null || _selectedFn == null || _selectedSf == null || _selectedActividadInstitucional == null)
        {
            Snackbar.Add("Completa los catalogos requeridos.", Severity.Warning);
            return;
        }

        if (!ApplyHeaderAnio())
        {
            Snackbar.Add("Selecciona el anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        item.FkidUrPres = _selectedUr.Id;
        item.FkidGfPres = _selectedGf.Id;
        item.FkidFnPres = _selectedFn.Id;
        item.FkidSfPres = _selectedSf.Id;
        item.FkidActividadInstitucionalSis = _selectedActividadInstitucional.Id;
        item.FkidSectorPres = _selectedSector?.Id;
        item.FkidTipoRecursoPres = _selectedTipoRecurso?.Id;
        item.FkidFuenteFinanciamientoPres = _selectedFuenteFinanciamiento?.Id;
        item.FkidPpPres = _selectedPp?.Id;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(Id.HasValue ? "Programa Presupuestal actualizado correctamente" : "Programa Presupuestal creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar el programa presupuestal", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadUnidadesResponsablesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await UrService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidUr, Text = TextOrDefault(x.ClaveNombre, x.PkidUr) }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadGruposFuncionalesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await GfService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidGf, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadFuncionesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await FnService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidFn, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadSubFuncionesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await SubFuncionService.GetAllPaginadoAsync(page, pageSize, filter, "SubFuncionClave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidSf, Text = TextOrDefault(x.SubFuncionClaveNombre, x.PkidSf) }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadActividadesInstitucionalesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ActividadInstitucionalService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidActividadInstitucional, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadSectoresPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await SectorService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidSector, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadTiposRecursoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await TipoRecursoService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidTipoRecurso, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadFuentesFinanciamientoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await FuenteFinanciamientoService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidFuenteFinanciamiento, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadProgramasPresupuestalesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ProgramaPresupuestalService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPp, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private bool ApplyHeaderAnio()
    {
        if (AnioStateService.AnioId is not > 0)
        {
            return false;
        }

        item.FkidAnioSis = AnioStateService.AnioId.Value;
        return true;
    }

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) ? id.ToString() : text;
}
