@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Presupuestales
@inject IGenericCrudService<FuenteFinanciamientoResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="FuenteFinanciamientoResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Small"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="FuenteFinanciamientoResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La clave es requerida" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La descripción es requerida" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<FuenteFinanciamientoResponse> form = null!;
    private FuenteFinanciamientoResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Fuente de Financiamiento" : "Nueva Fuente de Financiamiento";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (dialogTitle.Contains("Editar") ? "Fuente de Financiamiento actualizada correctamente" : "Fuente de Financiamiento creada correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}

