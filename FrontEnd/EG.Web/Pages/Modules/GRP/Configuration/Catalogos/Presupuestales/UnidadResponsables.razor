@page "/configuracion/presupuestales/clave-programa/unidad-responsable"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<UnidadResponsableResponse, UnidadResponsableResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Unidades Responsables"
                    Subtitle="Catálogo de unidades responsables"
                    Icon="@Icons.Material.Filled.Groups"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericTable TItem="UnidadResponsableResponse"
                      @ref="table"
                      Title="Lista de Unidades Responsables"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidUnidadResponsable" T="UnidadResponsableResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Clave" T="UnidadResponsableResponse">Clave</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="UnidadResponsableResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="AreaPadreNombre" T="UnidadResponsableResponse">Área Padre</MudTableSortLabel></MudTh>
            </Header>

            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Agregar hijo">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="@(() => CrearHijoArea(item.PkidUnidadResponsable, item.Descripcion))" />
                    </MudTooltip>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidUnidadResponsable))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidUnidadResponsable))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidUnidadResponsable</MudTd>
                <MudTd>@item.Clave</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@(item.AreaPadreNombre ?? "-")</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<UnidadResponsableResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "UnidadResponsable";

    protected override Type CreateDialogType => typeof(UnidadResponsableDialog);
    protected override Type EditDialogType => typeof(UnidadResponsableDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<UnidadResponsableResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<UnidadResponsableResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidUnidadResponsable,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            AreaPadre = u.AreaPadreNombre ?? "-",
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la unidad responsable";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async Task CrearHijoArea(int padreId, string nombrePadre)
    {
        try
        {
            if (!CanCreate)
            {
                Snackbar.Add("No tienes permisos para crear", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["PadreId"] = padreId,
                ["NombrePadre"] = nombrePadre
            };
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                Position = DialogPosition.Center
            };

            var dialog = await DialogService.ShowAsync<UnidadResponsableDialog>(
                "Crear Unidad Responsable", parameters, options);
            var result = await dialog.Result;

            if (!result!.Canceled)
            {
                await ReloadData();
                Snackbar.Add("Unidad Responsable creada exitosamente", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al crear: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
