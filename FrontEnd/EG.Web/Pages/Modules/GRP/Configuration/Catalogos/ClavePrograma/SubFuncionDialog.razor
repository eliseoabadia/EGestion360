@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Services
@inject IGenericCrudService<SubFuncionResponse> Service
@inject IGenericCrudService<FnResponse> FnService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="SubFuncionResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Small"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="SubFuncionResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudSelect T="int" Label="Función"
                           @bind-Value="item.FkidFnPres"
                           Required="true"
                           RequiredError="La función es requerida"
                           Disabled="@(fnList.Count == 0)">
                    @foreach (var fn in fnList)
                    {
                        <MudSelectItem Value="@fn.PkidFn">@fn.Clave - @fn.Descripcion</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.SubFuncionClave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La clave es requerida" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.SubFuncionDescripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La descripción es requerida" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<SubFuncionResponse> form = null!;
    private SubFuncionResponse item = new() { Activo = true };
    private List<FnResponse> fnList = new();

    private string dialogTitle => Id.HasValue ? "Editar Subfunción" : "Nueva Subfunción";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await CargarFunciones();
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarFunciones()
    {
        try
        {
            var response = await FnService.GetAllAsync();
            if (response?.Success == true && response.Items != null)
            {
                fnList = response.Items.OfType<FnResponse>().Where(f => f.Activo).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar funciones: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Subfunción actualizada correctamente" : "Subfunción creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
