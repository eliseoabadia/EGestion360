@page "/configuracion/presupuestales/clave-programa/finalidad"
@using EG.Web.Shared
@using EG.Domain.DTOs.Responses.Presupuestales
@inherits BaseCrudPage<GfResponse, GfResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Gestión de Grupos Funcionales"
                    Subtitle="Administra y mantén los Grupos Funcionales (GF)"
                    Icon="@Icons.Material.Filled.Domain"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="GfResponse"
                      @ref="table"
                      Title="Lista de Grupos Funcionales"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns><TemplateColumn Resizable="false" T="GfResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar grupo funcional"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidGf))" /></MudTooltip><MudTooltip Text="Eliminar grupo funcional"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidGf))" /></MudTooltip></CellTemplate></TemplateColumn><PropertyColumn T="GfResponse" TProperty="int" Property="x => x.PkidGf" Title="ID" Identifier="PkidGf" /><PropertyColumn T="GfResponse" TProperty="int" Property="x => x.Clave" Title="Clave" Identifier="Clave" /><PropertyColumn T="GfResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" /></Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<GfResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "Finalidad";

    protected override Type CreateDialogType => typeof(GrupoFuncionalDialog);
    protected override Type EditDialogType => typeof(GrupoFuncionalDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<GfResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<GfResponse> items)
    {
        return items.Select(d => new
        {
            ID = d.PkidGf,
            Clave = d.Clave,
            Descripción = d.Descripcion ?? "",
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Clave.ToString() ?? "el grupo funcional";

        }
        catch
        {
            return "el grupo funcional";
        }
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
            StateHasChanged();
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        var response = await Service.GetByIdAsync(id);
        var clave = response?.Data?.Clave.ToString() ?? "el grupo funcional";

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["ItemName"] = clave,
            ["DeleteFunc"] = new Func<int, Task<bool>>(async (deleteId) =>
            {
                var deleteResponse = await Service.DeleteAsync(deleteId);
                if (deleteResponse?.Success == true)
                {
                    Snackbar.Add(deleteResponse.Message ?? "Grupo funcional eliminado correctamente", Severity.Success);
                    await table.ReloadData();
                    return true;
                }
                else
                {
                    Snackbar.Add(deleteResponse?.Message ?? "Error al eliminar el grupo funcional", Severity.Error);
                    return false;
                }
            })
        };

        var dialog = await DialogService.ShowAsync(DeleteDialogType, $"Eliminar {SubModuleName}", parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        await dialog.Result;
    }
}
