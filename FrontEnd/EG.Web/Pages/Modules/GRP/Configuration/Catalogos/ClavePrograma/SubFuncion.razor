@page "/configuracion/presupuestales/clave-programa/subfuncion"
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<SubFuncionResponse, SubFuncionResponse>

<AccessVerification IsInitialized="@IsInitialized"
    HasAccess="@HasAccess"
    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Subfunciones"
                    Subtitle="Catálogo de subfunciones (SF)"
                    Icon="@Icons.Material.Filled.AccountTree"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="SubFuncionResponse"
                      @ref="table"
                      Title="Lista de Subfunciones"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns><TemplateColumn T="SubFuncionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidSf))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidSf))" /></MudTooltip></CellTemplate></TemplateColumn><PropertyColumn T="SubFuncionResponse" TProperty="int" Property="x => x.PkidSf" Title="ID" Identifier="PkidSf" /><PropertyColumn T="SubFuncionResponse" TProperty="string" Property="x => x.FuncionClave" Title="Clave Función" Identifier="FuncionClave" /><PropertyColumn T="SubFuncionResponse" TProperty="string" Property="x => x.FuncionDescripcion" Title="Función" Identifier="FuncionDescripcion" /><PropertyColumn T="SubFuncionResponse" TProperty="string" Property="x => x.SubFuncionClave" Title="Clave SubFunción" Identifier="SubFuncionClave" /><PropertyColumn T="SubFuncionResponse" TProperty="string" Property="x => x.SubFuncionDescripcion" Title="Descripción" Identifier="SubFuncionDescripcion" /></Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<SubFuncionResponse> table = null!;

    protected override string ModuleName => "ClavePrograma";
    protected override string SubModuleName => "SubFuncion";

    protected override Type CreateDialogType => typeof(SubFuncionDialog);
    protected override Type EditDialogType => typeof(SubFuncionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SubFuncionResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SubFuncionResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidSf,
            ClaveFuncion = u.FuncionClave,
            Funcion = u.FuncionDescripcion ?? string.Empty,
            ClaveSubFuncion = u.SubFuncionClave,
            SubFuncion = u.SubFuncionDescripcion ?? string.Empty,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.SubFuncionDescripcion ?? "la subfunción";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
