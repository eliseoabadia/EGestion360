@using EG.Domain.DTOs.Responses.Contabilidad
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using EG.Web.Services
@using EG.Common.GenericModel
@inject IGenericCrudService<MatrizIngresoResponse> Service
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject AnioPresupuestalStateService AnioStateService

<BaseCrudDialog TItem="MatrizIngresoResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.ExtraExtraLarge"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando catálogos..."
                OnConfirm="GuardarCambiosAsync">

    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-8">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-3">Cargando datos...</MudText>
        </div>
    }
    else
    {
        <MudContainer Class="py-2">
            <MudGrid GutterSize="2" Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="section-title">Referencia Principal</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPrograma"
                                       ValueChanged="value => _selectedPrograma = value"
                                       Label="Programa"
                                       Required="true"
                                       LoadPage="LoadProgramasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedOrigen"
                                       ValueChanged="value => _selectedOrigen = value"
                                       Label="Origen de Recursos"
                                       Required="true"
                                       LoadPage="LoadOrigenesPageAsync" />
                </MudItem>

                <MudItem xs="12" class="mt-2">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="section-title">Cuentas Contables</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedAutorizado"
                                       ValueChanged="value => _selectedAutorizado = value"
                                       Label="Cta. Presupuesto Autorizado"
                                       Required="true"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedPorEjercer"
                                       ValueChanged="value => _selectedPorEjercer = value"
                                       Label="Cuenta Presupuesto por Ejecutar"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedModificado"
                                       ValueChanged="value => _selectedModificado = value"
                                       Label="Cuenta Presupuesto Modificado"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedDevengado"
                                       ValueChanged="value => _selectedDevengado = value"
                                       Label="Cuenta Presupuesto Devengado"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedRecaudado"
                                       ValueChanged="value => _selectedRecaudado = value"
                                       Label="Cuenta Presupuesto Recaudado"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <PagedAutocomplete Value="@_selectedDeposito"
                                       ValueChanged="value => _selectedDeposito = value"
                                       Label="Cuenta de Depósito"
                                       LoadPage="LoadCuentasPageAsync" />
                </MudItem>

            </MudGrid>
        </MudContainer>
    }
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MatrizIngresoResponse _item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Matriz de Ingresos" : "Nueva Matriz de Ingresos";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private bool _loading = true;

    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedOrigen;
    private LookupItem? _selectedAutorizado;
    private LookupItem? _selectedPorEjercer;
    private LookupItem? _selectedModificado;
    private LookupItem? _selectedDevengado;
    private LookupItem? _selectedRecaudado;
    private LookupItem? _selectedDeposito;

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }

        _loading = false;
    }

    private Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadAnioLookupPageAsync("api/MatrizIngreso/GetProgramaLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadOrigenesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizIngreso/GetOrigenLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadCuentasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizIngreso/GetCuentaContableLookupPaginado", page, pageSize, filter, ct);

    private async Task<ComboLookupResult> LoadLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private async Task<ComboLookupResult> LoadAnioLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
        {
            return new ComboLookupResult();
        }

        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}&idAnio={AnioStateService.AnioId.Value}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                _item = response.Data;
                _selectedPrograma = CreateLookup(_item.FkIdPrograma, $"{_item.ProgramaClave} - {_item.ProgramaDescripcion}");
                _selectedOrigen = CreateLookup(_item.FkIdOrigen, _item.OrigenDescripcion);
                _selectedAutorizado = CreateLookup(_item.FkIdCuentaContableAutorizado, _item.CuentaAutorizadoNombre);
                _selectedPorEjercer = CreateLookup(_item.FkIdCuentaContablePorEjercer, _item.CuentaPorEjecutarNombre);
                _selectedModificado = CreateLookup(_item.FkIdCuentaContableModificado, _item.CuentaModificadoNombre);
                _selectedDevengado = CreateLookup(_item.FkIdCuentaContableDevengado, _item.CuentaDevengadoNombre);
                _selectedRecaudado = CreateLookup(_item.FkIdCuentaContableRecaudado, _item.CuentaRecaudadoNombre);
                _selectedDeposito = CreateLookup(_item.FkIdCuentaContableDeposito, _item.CuentaDepositoNombre);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            _item.FkIdPrograma = _selectedPrograma?.Id;
            _item.FkIdOrigen = _selectedOrigen?.Id;
            _item.FkIdCuentaContableAutorizado = _selectedAutorizado?.Id;
            _item.FkIdCuentaContablePorEjercer = _selectedPorEjercer?.Id;
            _item.FkIdCuentaContableModificado = _selectedModificado?.Id;
            _item.FkIdCuentaContableDevengado = _selectedDevengado?.Id;
            _item.FkIdCuentaContableRecaudado = _selectedRecaudado?.Id;
            _item.FkIdCuentaContableDeposito = _selectedDeposito?.Id;

            if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
            {
                Snackbar.Add("Debe seleccionar un anio presupuestal en el encabezado.", Severity.Warning);
                return;
            }

            _item.FkIdAnioSis = AnioStateService.AnioId.Value;

            var response = Id.HasValue
                ? await Service.UpdateAsync(_item, Id.Value)
                : await Service.CreateAsync(_item);

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (dialogTitle.Contains("Editar") ? "Matriz de ingresos actualizada correctamente" : "Matriz de ingresos creada correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private static LookupItem? CreateLookup(int? id, string? text)
    {
        if (!id.HasValue)
        {
            return null;
        }

        return new LookupItem
        {
            Id = id.Value,
            Text = text?.Trim() ?? string.Empty
        };
    }

}

<style>
    .section-title {
        font-weight: 600;
        padding-bottom: 4px;
        border-bottom: 2px solid var(--mud-palette-primary);
        margin-bottom: 8px;
    }
</style>
