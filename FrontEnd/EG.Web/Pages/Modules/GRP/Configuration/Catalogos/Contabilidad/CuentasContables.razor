@page "/configuracion/contabilidad/cuentas-contables"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<CuentaContableResponse, CuentaContableResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Cuentas Contables"
                    Subtitle="Catálogo de cuentas contables"
                    Icon="@Icons.Material.Filled.Book"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="CuentaContableResponse"
                  @ref="table"
                  Title="Lista de Cuentas Contables"
                  SearchPlaceholder="Buscar por cuenta o descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="CuentaContableResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidCuentaContable))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidCuentaContable))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="CuentaContableResponse" TProperty="int" Property="x => x.PkidCuentaContable" Title="ID" Identifier="PkidCuentaContable" />
                <PropertyColumn T="CuentaContableResponse" TProperty="string" Property="x => x.Cuenta" Title="Cuenta" Identifier="Cuenta" />
                <PropertyColumn T="CuentaContableResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<CuentaContableResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Cuentas_Contables";

    protected override Type CreateDialogType => typeof(CuentaContableDialog);
    protected override Type EditDialogType => typeof(CuentaContableDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<CuentaContableResponse>);

    protected override string GetDefaultSortLabel() => "Cuenta";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<CuentaContableResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidCuentaContable,
            Cuenta = u.Cuenta,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la cuenta contable";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
