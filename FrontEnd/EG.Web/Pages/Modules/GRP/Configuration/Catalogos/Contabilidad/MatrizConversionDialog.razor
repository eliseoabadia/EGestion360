@using EG.Domain.DTOs.Responses.Contabilidad
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using EG.Web.Services
@using EG.Common.GenericModel
@inject IGenericCrudService<MatrizConversionResponse> Service
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject AnioPresupuestalStateService AnioStateService

<BaseCrudDialog TItem="MatrizConversionResponse"
                Title="@dialogTitle"
                Subtitle="Relaciona la estructura presupuestal con las cuentas de cada momento contable."
                TitleIcon="@Icons.Material.Filled.AccountTree"
                MaxWidth="MaxWidth.ExtraExtraLarge"
                DialogClass="matriz-conversion-dialog crud-dialog-wide-xl"
                CatalogMode="false"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-8">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-3">Cargando datos...</MudText>
        </div>
    }
    else
    {
        <div class="matriz-form">
            <section class="matriz-section matriz-section-reference">
                <div class="matriz-section-heading">
                    <span class="matriz-section-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" /></span>
                    <div><MudText Typo="Typo.subtitle2" Class="matriz-section-title">Referencia principal</MudText><MudText Typo="Typo.caption" Class="matriz-section-subtitle">Programa, partida y tipo de gasto que originan la conversión.</MudText></div>
                </div>
                <div class="matriz-reference-grid matriz-reference-grid-three">
                    <div class="matriz-reference-field matriz-reference-field-code">
                    <PagedAutocomplete Value="@_selectedPrograma"
                                       ValueChanged="value => _selectedPrograma = value"
                                       Label="Programa"
                                       Required="true"
                                       LoadPage="LoadProgramasPageAsync" />
                    </div>

                    <div class="matriz-reference-field matriz-reference-field-wide">
                    <PagedAutocomplete Value="@_selectedPartida"
                                       ValueChanged="value => _selectedPartida = value"
                                       Label="Partida SIS"
                                       Required="true"
                                       LoadPage="LoadPartidasPageAsync" />
                    </div>

                    <div class="matriz-reference-field matriz-reference-field-medium">
                    <PagedAutocomplete Value="@_selectedTipoGasto"
                                       ValueChanged="value => _selectedTipoGasto = value"
                                       Label="Tipo de gasto (TG)"
                                       Required="true"
                                       LoadPage="LoadTiposGastoPageAsync" />
                    </div>
                </div>
            </section>

            <section class="matriz-section matriz-section-mapping">
                <div class="matriz-section-heading">
                    <span class="matriz-section-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" /></span>
                    <div><MudText Typo="Typo.subtitle2" Class="matriz-section-title">Mapeo contable</MudText><MudText Typo="Typo.caption" Class="matriz-section-subtitle">Asigna una cuenta a cada momento del ejercicio presupuestal.</MudText></div>
                </div>
                <div class="matriz-mapping-list">
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Aprobado</span><small>Asignación inicial</small></div>
                        <PagedAutocomplete Value="@_selectedAprobado" ValueChanged="value => _selectedAprobado = value" Label="Cuenta de aprobado" Required="true" LoadPage="LoadAprobadoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Por ejercer</span><small>Saldo disponible</small></div>
                        <PagedAutocomplete Value="@_selectedPorEjercer" ValueChanged="value => _selectedPorEjercer = value" Label="Cuenta por ejercer" Required="true" LoadPage="LoadPorEjercerPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Modificado</span><small>Adecuaciones presupuestales</small></div>
                        <PagedAutocomplete Value="@_selectedModificado" ValueChanged="value => _selectedModificado = value" Label="Cuenta de modificado" Required="true" LoadPage="LoadModificadoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Comprometido</span><small>Compromisos registrados</small></div>
                        <PagedAutocomplete Value="@_selectedComprometido" ValueChanged="value => _selectedComprometido = value" Label="Cuenta de comprometido" Required="true" LoadPage="LoadComprometidoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Devengado</span><small>Obligaciones reconocidas</small></div>
                        <PagedAutocomplete Value="@_selectedDevengado" ValueChanged="value => _selectedDevengado = value" Label="Cuenta de devengado" Required="true" LoadPage="LoadDevengadoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Ejercido</span><small>Presupuesto ejercido</small></div>
                        <PagedAutocomplete Value="@_selectedEjercido" ValueChanged="value => _selectedEjercido = value" Label="Cuenta de ejercido" Required="true" LoadPage="LoadEjercidoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Pagado</span><small>Salida de recursos</small></div>
                        <PagedAutocomplete Value="@_selectedPagado" ValueChanged="value => _selectedPagado = value" Label="Cuenta de pagado" Required="true" LoadPage="LoadPagadoPageAsync" />
                    </div>
                    <div class="matriz-map-row">
                        <div class="matriz-map-label"><span>Gasto</span><small>Cuenta final del gasto</small></div>
                        <PagedAutocomplete Value="@_selectedGasto" ValueChanged="value => _selectedGasto = value" Label="Cuenta de gasto" Required="true" LoadPage="LoadGastoPageAsync" />
                    </div>
                </div>
            </section>
        </div>
    }
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MatrizConversionResponse _item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Matriz de Conversión" : "Nueva Matriz de Conversión";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private bool _loading = true;

    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedPartida;
    private LookupItem? _selectedTipoGasto;
    private LookupItem? _selectedAprobado;
    private LookupItem? _selectedPorEjercer;
    private LookupItem? _selectedModificado;
    private LookupItem? _selectedComprometido;
    private LookupItem? _selectedDevengado;
    private LookupItem? _selectedEjercido;
    private LookupItem? _selectedPagado;
    private LookupItem? _selectedGasto;

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }

        _loading = false;
    }

    private Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadAnioLookupPageAsync("api/MatrizConversion/GetAllProgramasLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPartidasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetPartidaLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadTiposGastoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetTipoGastoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadAprobadoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableAprobadoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPorEjercerPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContablePorEjercerLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadModificadoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableModificadoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadComprometidoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableComprometidoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadDevengadoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableDevengadoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadEjercidoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableEjercidoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPagadoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContablePagadoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadGastoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/MatrizConversion/GetCuentaContableGastoLookupPaginado", page, pageSize, filter, ct);

    private async Task<ComboLookupResult> LoadLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private async Task<ComboLookupResult> LoadAnioLookupPageAsync(string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
        {
            return new ComboLookupResult();
        }

        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}&idAnio={AnioStateService.AnioId.Value}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                _item = response.Data;
                _selectedPrograma = CreateLookup(_item.FkidProgramaPres, _item.ProgramaClave);
                _selectedPartida = CreateLookup(_item.FkidPartidaSis, _item.PartidaDescripcion);
                _selectedTipoGasto = CreateLookup(_item.FkidTipoGastoPres, $"{_item.TipoGastoClave} - {_item.TipoGastoDescripcion}");
                _selectedAprobado = CreateLookup(_item.FkidCuentaContableAprobado, _item.CuentaAprobadoNombre);
                _selectedPorEjercer = CreateLookup(_item.FkidCuentaContablePorEjercer, _item.CuentaPorEjercerNombre);
                _selectedModificado = CreateLookup(_item.FkidCuentaContableModificado, _item.CuentaModificadoNombre);
                _selectedComprometido = CreateLookup(_item.FkidCuentaContableComprometido, _item.CuentaComprometidoNombre);
                _selectedDevengado = CreateLookup(_item.FkidCuentaContableDevengado, _item.CuentaDevengadoNombre);
                _selectedEjercido = CreateLookup(_item.FkidCuentaContableEjercido, _item.CuentaEjercidoNombre);
                _selectedPagado = CreateLookup(_item.FkidCuentaContablePagado, _item.CuentaPagadoNombre);
                _selectedGasto = CreateLookup(_item.FkidCuentaContableGasto, _item.CuentaGastoNombre);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            if (!ValidateRequiredSelections())
            {
                return;
            }

            if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
            {
                Snackbar.Add("Debe seleccionar un anio presupuestal en el encabezado.", Severity.Warning);
                return;
            }

            _item.FkidAnioSis = AnioStateService.AnioId.Value;
            _item.FkidProgramaPres = _selectedPrograma!.Id;
            _item.FkidPartidaSis = _selectedPartida!.Id;
            _item.FkidTipoGastoPres = _selectedTipoGasto!.Id;
            _item.FkidCuentaContableAprobado = _selectedAprobado!.Id;
            _item.FkidCuentaContablePorEjercer = _selectedPorEjercer!.Id;
            _item.FkidCuentaContableModificado = _selectedModificado!.Id;
            _item.FkidCuentaContableComprometido = _selectedComprometido!.Id;
            _item.FkidCuentaContableDevengado = _selectedDevengado!.Id;
            _item.FkidCuentaContableEjercido = _selectedEjercido!.Id;
            _item.FkidCuentaContablePagado = _selectedPagado!.Id;
            _item.FkidCuentaContableGasto = _selectedGasto!.Id;

            var response = Id.HasValue
                ? await Service.UpdateAsync(_item, Id.Value)
                : await Service.CreateAsync(_item);

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (dialogTitle.Contains("Editar") ? "Matriz actualizada correctamente" : "Matriz creada correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private bool ValidateRequiredSelections()
    {
        if (_selectedPrograma == null || _selectedPartida == null || _selectedTipoGasto == null || _selectedAprobado == null ||
            _selectedPorEjercer == null || _selectedModificado == null || _selectedComprometido == null ||
            _selectedDevengado == null || _selectedEjercido == null || _selectedPagado == null ||
            _selectedGasto == null)
        {
            Snackbar.Add("Debe seleccionar todos los campos requeridos", Severity.Warning);
            return false;
        }

        return true;
    }

    private static LookupItem? CreateLookup(int id, string? text)
    {
        if (id <= 0)
        {
            return null;
        }

        return new LookupItem
        {
            Id = id,
            Text = text?.Trim() ?? string.Empty
        };
    }

}
