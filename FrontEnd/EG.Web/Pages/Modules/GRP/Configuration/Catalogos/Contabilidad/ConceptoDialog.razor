@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Services

@inject IGenericCrudService<ConceptoResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="ConceptoResponse"
             Title="@dialogTitle"
             MaxWidth="MaxWidth.Small"
             ActionText="@actionText"
             ProcessingText="@processingText"
             LoadingMessage="@EG.Common.ApplicationText.Status.LoadingData"
             OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ConceptoResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">
        <MudTextField Margin="Margin.Dense" @bind-Value="item.Clave"
                      Label="Clave"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Numbers"
                      FullWidth="true"
                      Class="mb-3"
                      Required="true"
                      For="@(() => item.Clave)" />

        <MudTextField Margin="Margin.Dense" @bind-Value="item.Descripcion"
                      Label="Descripción"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Description"
                      FullWidth="true"
                      Class="mb-3"
                      Required="true"
                      For="@(() => item.Descripcion)" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ConceptoResponse> form = null!;
    private ConceptoResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Partida Presupuestal" : "Nueva Partida Presupuestal";
    private string actionText => Id.HasValue ? EG.Common.ApplicationText.Actions.Update : EG.Common.ApplicationText.Actions.Create;
    private string processingText => Id.HasValue ? EG.Common.ApplicationText.Status.Updating : EG.Common.ApplicationText.Status.Creating;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(dialogTitle.Contains(EG.Common.ApplicationText.Actions.Edit) ? "Partida presupuestal actualizada correctamente" : "Partida presupuestal creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}

