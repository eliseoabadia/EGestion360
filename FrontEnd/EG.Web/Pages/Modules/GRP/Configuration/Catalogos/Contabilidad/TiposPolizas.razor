@page "/configuracion/contabilidad/tipo-polizas"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoPolizaResponse, TipoPolizaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Pólizas"
                    Subtitle="Catálogo de tipos de pólizas"
                    Icon="@Icons.Material.Filled.Description"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="TipoPolizaResponse"
                      @ref="table"
                      Title="Lista de Tipos de Pólizas"
                      SearchPlaceholder="Buscar por descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="TipoPolizaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoPoliza))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoPoliza))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoPolizaResponse" TProperty="int" Property="x => x.PkidTipoPoliza" Title="ID" Identifier="PkidTipoPoliza" />
                <PropertyColumn T="TipoPolizaResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoPolizaResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Tipo_Polizas";

    protected override Type CreateDialogType => typeof(TipoPolizaDialog);
    protected override Type EditDialogType => typeof(TipoPolizaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoPolizaResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoPolizaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoPoliza,
            Descripcion = u.Descripcion,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el tipo de póliza";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
