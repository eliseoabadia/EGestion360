@page "/configuracion/contabilidad/tipo-detalles-polizas"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoDetallePolizaResponse, TipoDetallePolizaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Detalles Pólizas"
                    Subtitle="Catálogo de detalles de pólizas"
                    Icon="@Icons.Material.Filled.List"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="TipoDetallePolizaResponse"
                  @ref="table"
                  Title="Lista de Tipos de Detalles Pólizas"
                  SearchPlaceholder="Buscar por clave o descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="TipoDetallePolizaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoDetallePoliza))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoDetallePoliza))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoDetallePolizaResponse" TProperty="int" Property="x => x.PkidTipoDetallePoliza" Title="ID" Identifier="PkidTipoDetallePoliza" />
                <PropertyColumn T="TipoDetallePolizaResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoDetallePolizaResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Tipo_detalles_Polizas";

    protected override Type CreateDialogType => typeof(TipoDetallePolizaDialog);
    protected override Type EditDialogType => typeof(TipoDetallePolizaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoDetallePolizaResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoDetallePolizaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoDetallePoliza,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el tipo de detalle de póliza";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
