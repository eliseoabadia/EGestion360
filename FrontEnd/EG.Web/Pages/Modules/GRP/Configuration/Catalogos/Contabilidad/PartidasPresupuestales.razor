@page "/configuracion/contabilidad/partidas-presupuestales"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ConceptoResponse, ConceptoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Partidas Presupuestales"
                    Subtitle="Catálogo de partidas presupuestales"
                    Icon="@Icons.Material.Filled.AttachMoney"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="ConceptoResponse"
                  @ref="table"
                  Title="Lista de Partidas Presupuestales"
                  SearchPlaceholder="Buscar por clave o descripción..."
                  ShowExportButton="@CanExport"
                  ServerDataFunc="LoadServerData"
                  ExportFunc="ExportToExcel"
                  SearchString="@SearchString"
                  SearchStringChanged="(s) => SearchString = s"
                  OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="ConceptoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidConcepto))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidConcepto))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ConceptoResponse" TProperty="int" Property="x => x.PkidConcepto" Title="ID" Identifier="PkidConcepto" />
                <PropertyColumn T="ConceptoResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="ConceptoResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ConceptoResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Partidas_Presupuestales";

    protected override Type CreateDialogType => typeof(ConceptoDialog);
    protected override Type EditDialogType => typeof(ConceptoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ConceptoResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ConceptoResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidConcepto,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la partida presupuestal";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
