@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Services
@inject IGenericCrudService<TipoPolizaResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoPolizaResponse"
Title="@dialogTitle"
MaxWidth="MaxWidth.Small"
ActionText="@actionText"
ProcessingText="@processingText"
LoadingMessage="Cargando datos..."
OnConfirm="GuardarCambiosAsync">

<BaseEntityForm TEntity="TipoPolizaResponse"
@ref="form"
ShowHeader="true"
HeaderTitle="@dialogTitle">

<MudGrid GutterSize="2">
<MudItem xs="12">
<MudTextField @bind-Value="item.Descripcion"
Label="Descripción"
Variant="Variant.Outlined"
Required="true"
RequiredError="La descripción es requerida" />
</MudItem>

</MudGrid>
</BaseEntityForm>
</BaseCrudDialog>

@code {
[Parameter] public int? Id { get; set; }

[CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

private BaseEntityForm<TipoPolizaResponse> form = null!;
private TipoPolizaResponse item = new() { Activo = true };

private string dialogTitle => Id.HasValue ? "Editar Tipo de Póliza" : "Nuevo Tipo de Póliza";
private string actionText => Id.HasValue ? "Actualizar" : "Crear";
private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

protected override async Task OnInitializedAsync()
{
    if (Id.HasValue)
    {
        await CargarDatos();
    }
}

private async Task CargarDatos()
{
    try
    {
        var response = await Service.GetByIdAsync(Id.Value);
        if (response?.Success == true && response.Data != null)
        {
            item = response.Data;
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
    }
}

private async Task GuardarCambiosAsync()
{
    try
    {
        bool success;
        if (Id.HasValue)
        {
            var response = await Service.UpdateAsync(item, Id.Value);
            success = response?.Success == true;
        }
        else
        {
            var response = await Service.CreateAsync(item);
            success = response?.Success == true;
        }

        if (success)
        {
            Snackbar.Add(dialogTitle.Contains("Editar") ? "Tipo de póliza actualizado correctamente" : "Tipo de póliza creado correctamente", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Error al guardar los cambios", Severity.Error);
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Error: {ex.Message}", Severity.Error);
    }
}
}
