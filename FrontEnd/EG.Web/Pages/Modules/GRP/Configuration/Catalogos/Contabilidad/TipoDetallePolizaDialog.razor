@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Services

@inject IGenericCrudService<TipoDetallePolizaResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoDetallePolizaResponse"
             Title="@dialogTitle"
             MaxWidth="MaxWidth.Small"
             ActionText="@actionText"
             ProcessingText="@processingText"
             LoadingMessage="Cargando datos..."
             OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="TipoDetallePolizaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">
        <MudTextField @bind-Value="item.Descripcion"
                      Label="Descripción"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Description"
                      FullWidth="true"
                      Class="mb-3"
                      Required="true"
                      For="@(() => item.Descripcion)" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<TipoDetallePolizaResponse> form = null!;
    private TipoDetallePolizaResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Tipo de Detalle Póliza" : "Nuevo Tipo de Detalle Póliza";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Tipo de detalle póliza actualizado correctamente" : "Tipo de detalle póliza creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}

