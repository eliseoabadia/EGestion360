@page "/configuracion/contabilidad/matriz-conversion"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MatrizConversionResponse, MatrizConversionResponse>

<AccessVerification IsInitialized="@IsInitialized"
    HasAccess="@HasAccess"
    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100%;">
        <PageHeader Title="Matriz de Conversión"
            Subtitle="Relación entre programas, partidas y cuentas contables"
            Icon="@Icons.Material.Filled.SwapHoriz"
            CanCreate="@CanCreate"
            OnCreate="CreateItem"
            OnRefresh="() => table.ReloadData()" />

        <div class="custom-matriz-table">
            <GenericDataGrid TItem="MatrizConversionResponse"
                @ref="table"
                Title="Lista de Matriz de Conversión"
                SearchPlaceholder="Buscar por programa o partida..."
                ShowExportButton="@CanExport"
                ServerDataFunc="LoadServerData"
                ExportFunc="ExportToExcel"
                SearchString="@SearchString"
                SearchStringChanged="(s) => SearchString = s"
                OnSearch="OnSearch">

                <Columns>
                    <TemplateColumn Resizable="false" T="MatrizConversionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))"><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidMatrizConversion))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidMatrizConversion))" /></MudTooltip></div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="ID" Identifier="PkidMatrizConversion"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.PkidMatrizConversion</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Programa" Identifier="ProgramaClave"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.ProgramaClave</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Partida" Identifier="PartidaDescripcion"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.PartidaDescripcion</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Aprobado" Identifier="CuentaAprobadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaAprobadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Por Ejercer" Identifier="CuentaPorEjercerNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaPorEjercerNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Modificado" Identifier="CuentaModificadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaModificadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Comprometido" Identifier="CuentaComprometidoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaComprometidoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Devengado" Identifier="CuentaDevengadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaDevengadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Ejercido" Identifier="CuentaEjercidoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaEjercidoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Pagado" Identifier="CuentaPagadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaPagadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizConversionResponse" Title="Gasto" Identifier="CuentaGastoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaGastoNombre</div></CellTemplate></TemplateColumn>
                </Columns>
            </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<MatrizConversionResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Matriz_Conversion";

    protected override Type CreateDialogType => typeof(MatrizConversionDialog);
    protected override Type EditDialogType => typeof(MatrizConversionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MatrizConversionResponse>);

    protected override string GetDefaultSortLabel() => "ProgramaClave";

    private async Task OpenDetail(MatrizConversionResponse item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<MatrizConversionPersonalizado>(string.Empty, parameters, options);
        await dialog.Result;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MatrizConversionResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMatrizConversion,
            Programa = u.ProgramaClave,
            Partida = u.PartidaDescripcion,
            CuentaAprobado = u.CuentaAprobadoNombre,
            CuentaPorEjercer = u.CuentaPorEjercerNombre,
            CuentaModificado = u.CuentaModificadoNombre,
            CuentaComprometido = u.CuentaComprometidoNombre,
            CuentaDevengado = u.CuentaDevengadoNombre,
            CuentaEjercido = u.CuentaEjercidoNombre,
            CuentaPagado = u.CuentaPagadoNombre,
            CuentaGasto = u.CuentaGastoNombre,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }
}

<style>
    .custom-matriz-table {
        flex: 1 1 auto;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .custom-matriz-table .eg-generic-table,
    .custom-matriz-table .mud-table {
        min-width: 0;
        width: 100%;
        max-width: 100%;
    }

    .custom-matriz-table .mud-table-container {
        min-width: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    .custom-matriz-table table.mud-table-root {
        width: 100% !important;
        max-width: 100% !important;
        table-layout: fixed;
    }

    .custom-matriz-table .mud-table-cell {
        box-sizing: border-box;
        min-width: 0 !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding-left: 8px;
        padding-right: 8px;
    }

    .custom-matriz-table .mud-table-sort-label {
        min-width: 0;
    }

    .custom-matriz-table .col-acciones {
        width: 76px;
        text-align: center;
    }

    .custom-matriz-table .col-id {
        width: 54px;
        text-align: center;
    }

    .custom-matriz-table .col-programa {
        width: 7%;
    }

    .custom-matriz-table .col-partida {
        width: 13%;
    }

    .mud-table-row {
        cursor: pointer;
    }
</style>
