@page "/configuracion/contabilidad/formas-pago"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ContaTipoDoctoPagoResponse, ContaTipoDoctoPagoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False">
        <PageHeader Title="Formas de Pago"
                    Subtitle="Catálogo de formas de pago"
                    Icon="@Icons.Material.Filled.CreditCard"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="ContaTipoDoctoPagoResponse"
                      @ref="table"
                      Title="Lista de Formas de Pago"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="ContaTipoDoctoPagoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoDoctoPago))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoDoctoPago))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ContaTipoDoctoPagoResponse" TProperty="int" Property="x => x.PkidTipoDoctoPago" Title="ID" Identifier="PkidTipoDoctoPago" />
                <PropertyColumn T="ContaTipoDoctoPagoResponse" TProperty="string" Property="x => x.Descripcion" Title="Forma de pago" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ContaTipoDoctoPagoResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Formas_Pago";

    protected override Type CreateDialogType => typeof(FormaPagoDialog);
    protected override Type EditDialogType => typeof(FormaPagoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ContaTipoDoctoPagoResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ContaTipoDoctoPagoResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoDoctoPago,
            Forma_de_pago = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la forma de pago";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
