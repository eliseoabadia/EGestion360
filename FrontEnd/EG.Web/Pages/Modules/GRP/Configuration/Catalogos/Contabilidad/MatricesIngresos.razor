@page "/configuracion/contabilidad/matriz-conversion-ingresos"
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MatrizIngresoResponse, MatrizIngresoResponse>

<AccessVerification IsInitialized="@IsInitialized"
    HasAccess="@HasAccess"
    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100%;">
        <PageHeader Title="Matriz de Ingresos"
            Subtitle="Relación entre programas, orígenes y cuentas contables"
            Icon="@Icons.Material.Filled.SwapHoriz"
            CanCreate="@CanCreate"
            OnCreate="CreateItem"
            OnRefresh="() => table.ReloadData()" />

        <div style="overflow-x: auto; flex: 1;" class="custom-matriz-table">
            <GenericDataGrid TItem="MatrizIngresoResponse"
                @ref="table"
                Title="Lista de Matriz de Ingresos"
                SearchPlaceholder="Buscar por programa u origen..."
                ShowExportButton="@CanExport"
                ServerDataFunc="LoadServerData"
                ExportFunc="ExportToExcel"
                SearchString="@SearchString"
                SearchStringChanged="(s) => SearchString = s"
                OnSearch="OnSearch">

                <Columns>
                    <TemplateColumn Resizable="false" T="MatrizIngresoResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))"><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidMatrizIngreso))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidMatrizIngreso))" /></MudTooltip></div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="PK" Identifier="PkidMatrizIngreso"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.PkidMatrizIngreso</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Programa" Identifier="ProgramaClave"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.ProgramaClave</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Origen de Recursos" Identifier="OrigenDescripcion"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.OrigenDescripcion</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cta. Presupuesto Autorizado" Identifier="CuentaAutorizadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaAutorizadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cuenta Presupuesto por Ejecutar" Identifier="CuentaPorEjecutarNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaPorEjecutarNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cuenta Presupuesto Modificado" Identifier="CuentaModificadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaModificadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cuenta Presupuesto Devengado" Identifier="CuentaDevengadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaDevengadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cuenta Presupuesto Recaudado" Identifier="CuentaRecaudadoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaRecaudadoNombre</div></CellTemplate></TemplateColumn>
                    <TemplateColumn Resizable="true" T="MatrizIngresoResponse" Title="Cuenta de Depósito" Identifier="CuentaDepositoNombre"><CellTemplate><div @ondblclick="@(() => OpenDetail(context.Item))">@context.Item.CuentaDepositoNombre</div></CellTemplate></TemplateColumn>
                </Columns>
            </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<MatrizIngresoResponse> table = null!;

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Matriz_Conversion_Ingresos";

    protected override Type CreateDialogType => typeof(MatrizIngresoDialog);
    protected override Type EditDialogType => typeof(MatrizIngresoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MatrizIngresoResponse>);

    protected override string GetDefaultSortLabel() => "ProgramaClave";

    private async Task OpenDetail(MatrizIngresoResponse item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<MatrizIngresoPersonalizado>(string.Empty, parameters, options);
        await dialog.Result;
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MatrizIngresoResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMatrizIngreso,
            Programa = u.ProgramaClave,
            OrigenRecursos = u.OrigenDescripcion,
            CtaAutorizado = u.CuentaAutorizadoNombre,
            CtaPorEjecutar = u.CuentaPorEjecutarNombre,
            CtaModificado = u.CuentaModificadoNombre,
            CtaDevengado = u.CuentaDevengadoNombre,
            CtaRecaudado = u.CuentaRecaudadoNombre,
            CtaDeposito = u.CuentaDepositoNombre,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ProgramaClave ?? "la matriz de ingreso";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}

<style>
    .custom-matriz-table .col-acciones {
        min-width: 120px;
        max-width: 120px;
        text-align: center;
    }

    .custom-matriz-table .col-id {
        min-width: 60px;
        max-width: 60px;
        text-align: center;
    }

    .custom-matriz-table .col-programa {
        min-width: 120px;
        max-width: 150px;
    }

    .custom-matriz-table .col-origen {
        min-width: 150px;
        max-width: 200px;
    }

    .custom-matriz-table .col-cuenta {
        min-width: 150px;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .custom-matriz-table .mud-table-container {
        min-width: 2000px;
    }

    .mud-table-row {
        cursor: pointer;
    }
</style>
