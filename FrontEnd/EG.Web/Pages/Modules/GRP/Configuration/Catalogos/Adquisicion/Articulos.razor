@page "/configuracion/adquisiciones/articulo"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ArticuloResponse, ArticuloResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Artículos"
                    Subtitle="Catálogo de artículos"
                    Icon="@Icons.Material.Filled.Inventory2"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="ArticuloResponse"
                      @ref="table"
                      Title="Lista de Artículos"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="ArticuloResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidArticulo))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidArticulo))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="ArticuloResponse" TProperty="int" Property="x => x.PkidArticulo" Title="ID" Identifier="PkidArticulo" />
                <PropertyColumn T="ArticuloResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="ArticuloResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ArticuloResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Articulo";

    protected override Type CreateDialogType => typeof(ArticuloDialog);
    protected override Type EditDialogType => typeof(ArticuloDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ArticuloResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ArticuloResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidArticulo,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el artículo";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
