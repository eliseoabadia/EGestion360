@page "/configuracion/adquisiciones/proveedores"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<ProveedorResponse, ProveedorResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Proveedores"
                    Subtitle="Catálogo de proveedores"
                    Icon="@Icons.Material.Filled.LocalShipping"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <div class="proveedores-data-grid" Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
            <GenericDataGrid TItem="ProveedorResponse"
                             @ref="table"
                             Title="Lista de proveedores"
                             SearchPlaceholder="Buscar por nombre, RFC o clave..."
                             ShowExportButton="@CanExport"
                             ColumnResizeMode="ResizeMode.Container"
                             ServerDataFunc="LoadServerData"
                             ExportFunc="ExportToExcel"
                             SearchString="@SearchString"
                             SearchStringChanged="(s) => SearchString = s"
                             OnSearch="OnSearch">
                <Columns>
                    <TemplateColumn Resizable="false" T="ProveedorResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false">
                        <CellTemplate>
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Visible="@CanUpdate"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => EditItem(context.Item.PkidProveedor))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Visible="@CanDelete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteItem(context.Item.PkidProveedor))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn T="ProveedorResponse" TProperty="int" Property="x => x.PkidProveedor" Title="ID" Identifier="PkidProveedor" />
                    <PropertyColumn T="ProveedorResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                    <PropertyColumn T="ProveedorResponse" TProperty="string" Property="x => x.Nombre" Title="Nombre" Identifier="Nombre">
                        <CellTemplate>
                            <div class="proveedores-nombre-cell" title="@context.Item.Nombre">@context.Item.Nombre</div>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ProveedorResponse" TProperty="string" Property="x => x.Rfc" Title="RFC" Identifier="Rfc" />
                    <PropertyColumn T="ProveedorResponse" TProperty="string" Property="x => x.Email" Title="Email" Identifier="Email" />
                    <PropertyColumn T="ProveedorResponse" TProperty="string" Property="x => x.MunicipioNombre" Title="Municipio" Identifier="MunicipioNombre" />
                </Columns>
            </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ProveedorResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Proveedores";

    protected override Type CreateDialogType => typeof(ProveedorDialog);
    protected override Type EditDialogType => typeof(ProveedorDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ProveedorResponse>);

    protected override string GetDefaultSortLabel() => "Nombre";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ProveedorResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidProveedor,
            Clave = u.Clave,
            Nombre = u.Nombre,
            RFC = u.Rfc,
            Calle = u.Calle,
            Numero = u.Numero,
            Colonia = u.Colonia,
            CP = u.Cp,
            Ciudad = u.Ciudad,
            Email = u.Email,
            Telefono = u.TelefonoInstitucional,
            PaginaWeb = u.PaginaWeb,
            Tipo = u.TipoProveedorNombre,
            Estatus = u.EstatusProveedorNombre,
            Municipio = u.MunicipioNombre,
            Estado = u.EstadoNombre,
            Pais = u.PaisNombre,
            Notas = u.Notas,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Nombre ?? "el proveedor";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
