@page "/configuracion/adquisiciones/tipo-garantia"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoGarantiaResponse, TipoGarantiaResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Garantía"
                    Subtitle="Catálogo de tipos de garantía"
                    Icon="@Icons.Material.Filled.Shield"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="TipoGarantiaResponse"
                      @ref="table"
                      Title="Lista de Tipos de Garantía"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="TipoGarantiaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoGarantia))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoGarantia))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoGarantiaResponse" TProperty="int" Property="x => x.PkidTipoGarantia" Title="ID" Identifier="PkidTipoGarantia" />
                <PropertyColumn T="TipoGarantiaResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoGarantiaResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Tipo_Garantia";

    protected override Type CreateDialogType => typeof(TipoGarantiaDialog);
    protected override Type EditDialogType => typeof(TipoGarantiaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoGarantiaResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoGarantiaResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoGarantia,
            Descripcion = u.Descripcion,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el tipo de garantía";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
