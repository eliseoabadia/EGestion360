@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Common.GenericModel
@inject IGenericCrudService<FraccionResponse> Service
@inject IGenericCrudService<ArticuloResponse> ArticuloService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="FraccionResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Small"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="@EG.Common.ApplicationText.Status.LoadingData"
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="FraccionResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudTextField Margin="Margin.Dense" @bind-Value="item.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La clave es requerida" />
            </MudItem>
            <MudItem xs="12">
                <PagedAutocomplete Margin="Margin.Dense"
                                   Value="@articuloSeleccionado"
                                   ValueChanged="OnArticuloChanged"
                                   Label="Artículo"
                                   Required="true"
                                   RequiredError="Selecciona un artículo"
                                   LoadPage="LoadArticulosPageAsync" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Margin="Margin.Dense" @bind-Value="item.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La descripción es requerida" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<FraccionResponse> form = null!;
    private FraccionResponse item = new() { Activo = true };
    private LookupItem? articuloSeleccionado;

    private string dialogTitle => Id.HasValue ? "Editar Fracción" : "Nueva Fracción";
    private string actionText => Id.HasValue ? EG.Common.ApplicationText.Actions.Update : EG.Common.ApplicationText.Actions.Create;
    private string processingText => Id.HasValue ? EG.Common.ApplicationText.Status.Updating : EG.Common.ApplicationText.Status.Creating;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                articuloSeleccionado = new LookupItem
                {
                    Id = item.FkidArticuloOrco,
                    Text = ArticuloText(item.ArticuloClave, item.ArticuloDescripcion, item.NombreArticulo)
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadArticulosPageAsync(int page, int pageSize, string filter, CancellationToken cancellationToken)
    {
        var response = await ArticuloService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        var articles = response?.Items?.Select(article => new LookupItem
        {
            Id = article.PkidArticulo,
            Text = ArticuloText(article.Clave, article.Descripcion, null)
        }).ToList() ?? [];

        return new ComboLookupResult { Items = articles, TotalCount = response?.TotalCount ?? articles.Count };
    }

    private void OnArticuloChanged(LookupItem? value)
    {
        articuloSeleccionado = value;
        item.FkidArticuloOrco = value?.Id ?? 0;
    }

    private static string ArticuloText(string? clave, string? descripcion, string? nombre)
    {
        var text = string.Join(" - ", new[] { clave, descripcion, nombre }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(text) ? "Artículo sin descripción" : text;
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains(EG.Common.ApplicationText.Actions.Edit) ? "Fracción actualizada correctamente" : "Fracción creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
