@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Adquisicion
@inject IGenericCrudService<ProcedimientoContratacionResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="ProcedimientoContratacionResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Small"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ProcedimientoContratacionResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La descripción es requerida" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.FundamentoJuridico"
                              Label="Fundamento Jurídico"
                              Variant="Variant.Outlined"
                              Lines="3" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ProcedimientoContratacionResponse> form = null!;
    private ProcedimientoContratacionResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Procedimiento de Contratación" : "Nuevo Procedimiento de Contratación";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(dialogTitle.Contains("Editar") ? "Procedimiento de Contratación actualizado correctamente" : "Procedimiento de Contratación creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
