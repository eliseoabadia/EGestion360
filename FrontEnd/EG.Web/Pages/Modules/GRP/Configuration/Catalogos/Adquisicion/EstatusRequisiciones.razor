@page "/configuracion/adquisiciones/estatus-requisicion"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<EstatusRequisicionResponse, EstatusRequisicionResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Estatus de Requisiciones"
                    Subtitle="Catálogo de estatus de requisiciones"
                    Icon="@Icons.Material.Filled.Flag"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="EstatusRequisicionResponse"
                      @ref="table"
                      Title="Lista de Estatus"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="EstatusRequisicionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidEstatusRequisicion))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidEstatusRequisicion))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="EstatusRequisicionResponse" TProperty="int" Property="x => x.PkidEstatusRequisicion" Title="ID" Identifier="PkidEstatusRequisicion" />
                <PropertyColumn T="EstatusRequisicionResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                <TemplateColumn Resizable="true" T="EstatusRequisicionResponse" Title="Color" Identifier="Color"><CellTemplate><MudChip T="string" Color="@Color.Primary" Style="@($"background-color: {context.Item.Color}; color: white;")" Size="Size.Small">@context.Item.Color</MudChip></CellTemplate></TemplateColumn>
                <PropertyColumn T="EstatusRequisicionResponse" TProperty="int" Property="x => x.Orden" Title="Orden" Identifier="Orden" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<EstatusRequisicionResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Estatus_Requisicion";

    protected override Type CreateDialogType => typeof(EstatusRequisicionDialog);
    protected override Type EditDialogType => typeof(EstatusRequisicionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EstatusRequisicionResponse>);

    protected override string GetDefaultSortLabel() => "Orden";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EstatusRequisicionResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidEstatusRequisicion,
            Descripcion = u.Descripcion,
            Color = u.Color,
            Orden = u.Orden,
            Icono = u.Icono,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "el estatus";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
