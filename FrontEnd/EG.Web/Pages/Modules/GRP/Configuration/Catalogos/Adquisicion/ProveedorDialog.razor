@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Common.GenericModel
@using EG.Web.Models
@inject IGenericCrudService<ProveedorResponse> Service
@inject ISnackbar Snackbar
@inject HttpClient Http

<BaseCrudDialog TItem="ProveedorResponse"
                Title="@dialogTitle"
                Subtitle="Identificacion fiscal, control contable, domicilio y contacto del proveedor."
                TitleIcon="@Icons.Material.Filled.Business"
                MaxWidth="MaxWidth.ExtraLarge"
                DialogId="proveedor-dialog"
                DialogClass="proveedor-dialog crud-dialog-wide"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ProveedorResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle"
                    CatalogMode="true">

        <div class="proveedor-form">
        <section class="proveedor-section proveedor-section-identity" aria-labelledby="proveedor-identidad-title">
            <div class="proveedor-section-heading">
                <span class="proveedor-section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                </span>
                <div>
                    <MudText Id="proveedor-identidad-title" Typo="Typo.subtitle2" Class="proveedor-section-title">Identificación fiscal</MudText>
                    <MudText Typo="Typo.caption" Class="proveedor-section-subtitle">Datos principales y clasificacion operativa.</MudText>
                </div>
            </div>

            <MudGrid GutterSize="2">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="item.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="La clave es requerida"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="item.Rfc"
                              Label="RFC"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="El RFC es requerido"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="7">
                <MudTextField @bind-Value="item.Nombre"
                              Label="Nombre"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="El nombre es requerido"
                              MaxLength="500" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <PagedAutocomplete Value="@_selectedTipo"
                                   ValueChanged="value => _selectedTipo = value"
                                   Label="Tipo de proveedor"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="El tipo de proveedor es requerido"
                                   LoadPage="LoadTiposPageAsync" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <PagedAutocomplete Value="@_selectedEstatus"
                                   ValueChanged="value => _selectedEstatus = value"
                                   Label="Estatus"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="El estatus es requerido"
                                   LoadPage="LoadEstatusPageAsync" />
            </MudItem>
            </MudGrid>
        </section>

        <section class="proveedor-section proveedor-section-accounting" aria-labelledby="proveedor-contabilidad-title">
            <div class="proveedor-section-heading">
                <span class="proveedor-section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                </span>
                <div>
                    <MudText Id="proveedor-contabilidad-title" Typo="Typo.subtitle2" Class="proveedor-section-title">Control contable</MudText>
                    <MudText Typo="Typo.caption" Class="proveedor-section-subtitle">Cuenta auxiliar utilizada para controlar el saldo del proveedor.</MudText>
                </div>
            </div>

            <MudGrid GutterSize="2">
            <MudItem xs="12">
                <PagedAutocomplete Value="@_selectedCuentaAuxiliar"
                                   ValueChanged="value => _selectedCuentaAuxiliar = value"
                                   Label="Auxiliar contable de proveedores por pagar (2.1.1.2)"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   LoadPage="LoadCuentasAuxiliaresPageAsync" />
                <MudText Typo="Typo.caption" Class="proveedor-field-help">
                    Esta cuenta controla el saldo por proveedor; la cuenta de gasto o activo se obtiene de la matriz COG + TG.
                </MudText>
            </MudItem>
            </MudGrid>
        </section>

        <section class="proveedor-section proveedor-section-address" aria-labelledby="proveedor-domicilio-title">
            <div class="proveedor-section-heading">
                <span class="proveedor-section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                </span>
                <div>
                    <MudText Id="proveedor-domicilio-title" Typo="Typo.subtitle2" Class="proveedor-section-title">Domicilio fiscal</MudText>
                    <MudText Typo="Typo.caption" Class="proveedor-section-subtitle">Ubicacion registrada para operaciones y documentos fiscales.</MudText>
                </div>
            </div>

            <MudGrid GutterSize="2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="item.Calle"
                              Label="Calle"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="item.Numero"
                              Label="Número"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="item.NumeroInt"
                              Label="Núm. interior"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="item.Colonia"
                              Label="Colonia"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="item.Cp"
                              Label="Código postal"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="item.Ciudad"
                              Label="Ciudad"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <PagedAutocomplete Value="@_selectedPais"
                                   ValueChanged="OnPaisChanged"
                                   Label="País"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   LoadPage="LoadPaisesPageAsync" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <PagedAutocomplete Value="@_selectedEstado"
                                   ValueChanged="OnEstadoChanged"
                                   Label="Estado"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   LoadPage="LoadEstadosPageAsync" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <PagedAutocomplete Value="@_selectedMunicipio"
                                   ValueChanged="value => _selectedMunicipio = value"
                                   Label="Municipio"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   LoadPage="LoadMunicipiosPageAsync" />
            </MudItem>
            </MudGrid>
        </section>

        <section class="proveedor-section proveedor-section-contact" aria-labelledby="proveedor-contacto-title">
            <div class="proveedor-section-heading">
                <span class="proveedor-section-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.ContactMail" Size="Size.Small" />
                </span>
                <div>
                    <MudText Id="proveedor-contacto-title" Typo="Typo.subtitle2" Class="proveedor-section-title">Contacto y notas</MudText>
                    <MudText Typo="Typo.caption" Class="proveedor-section-subtitle">Canales de comunicacion e informacion complementaria.</MudText>
                </div>
            </div>

            <MudGrid GutterSize="2">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="item.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="El email es requerido"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="item.TelefonoInstitucional"
                              Label="Teléfono"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="20" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="item.PaginaWeb"
                              Label="Página web"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Notas"
                              Label="Notas"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="500"
                              Lines="2" />
            </MudItem>
            </MudGrid>
        </section>
        </div>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ProveedorResponse> form = null!;
    private ProveedorResponse item = new() { Activo = true };
    private LookupItem? _selectedTipo;
    private LookupItem? _selectedEstatus;
    private LookupItem? _selectedCuentaAuxiliar;
    private LookupItem? _selectedPais;
    private LookupItem? _selectedEstado;
    private LookupItem? _selectedMunicipio;

    private string dialogTitle => Id.HasValue ? "Editar Proveedor" : "Nuevo Proveedor";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                item.Activo = true;
                _selectedTipo = BuildLookup(item.FkIdTipoProveedorSis, item.TipoProveedorNombre);
                _selectedEstatus = BuildLookup(item.FkidEstatusProveedorSis, item.EstatusProveedorNombre);
                _selectedCuentaAuxiliar = BuildLookup(item.FkidCuentaContableSis, item.CuentaContableNombre);
                _selectedPais = BuildLookup(item.FkidPaisSis, item.PaisNombre);
                _selectedEstado = BuildLookup(item.FkidEstadoSis, item.EstadoNombre);
                _selectedMunicipio = BuildLookup(item.FkidMunicipioSis, item.MunicipioNombre);
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No fue posible cargar el proveedor.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos obligatorios del proveedor.", Severity.Warning);
            return;
        }

        NormalizeItem();
        if (_selectedTipo == null || _selectedEstatus == null || _selectedPais == null ||
            _selectedEstado == null || _selectedMunicipio == null)
        {
            Snackbar.Add("Selecciona tipo, estatus, pais, estado y municipio.", Severity.Warning);
            return;
        }

        item.FkIdTipoProveedorSis = _selectedTipo.Id;
        item.FkidEstatusProveedorSis = _selectedEstatus.Id;
        item.FkidCuentaContableSis = _selectedCuentaAuxiliar?.Id;
        item.FkidPaisSis = _selectedPais.Id;
        item.FkidEstadoSis = _selectedEstado.Id;
        item.FkidMunicipioSis = _selectedMunicipio.Id;

        try
        {
            ApiResponse<ProveedorResponse>? response;
            if (Id.HasValue)
            {
                response = await Service.UpdateAsync(item, Id.Value);
            }
            else
            {
                response = await Service.CreateAsync(item);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (Id.HasValue ? "Proveedor actualizado correctamente" : "Proveedor creado correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No fue posible guardar el proveedor.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private void NormalizeItem()
    {
        item.Activo = true;
        item.Clave = Trim(item.Clave).ToUpperInvariant();
        item.Rfc = Trim(item.Rfc).ToUpperInvariant();
        item.Nombre = Trim(item.Nombre);
        item.Email = Trim(item.Email);
        item.Calle = Trim(item.Calle);
        item.Numero = Trim(item.Numero);
        item.NumeroInt = Trim(item.NumeroInt);
        item.Colonia = Trim(item.Colonia);
        item.Cp = Trim(item.Cp);
        item.Ciudad = Trim(item.Ciudad);
        item.TelefonoInstitucional = Trim(item.TelefonoInstitucional);
        item.PaginaWeb = Trim(item.PaginaWeb);
        item.Notas = Trim(item.Notas);
    }

    private static string Trim(string? value) => (value ?? string.Empty).Trim();

    private Task<ComboLookupResult> LoadTiposPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetTipoProveedorLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadEstatusPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetEstatusProveedorLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadCuentasAuxiliaresPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetCuentaAuxiliarLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadPaisesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetPaisLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadEstadosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetEstadoLookupPaginado", page, pageSize, filter, ct,
            _selectedPais == null ? null : $"paisId={_selectedPais.Id}");

    private Task<ComboLookupResult> LoadMunicipiosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadLookupPageAsync("api/Proveedor/GetMunicipioLookupPaginado", page, pageSize, filter, ct,
            _selectedEstado == null ? null : $"estadoId={_selectedEstado.Id}");

    private async Task<ComboLookupResult> LoadLookupPageAsync(
        string url, int page, int pageSize, string filter, CancellationToken ct, string? extra = null)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        if (!string.IsNullOrWhiteSpace(extra))
            requestUrl += $"&{extra}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private void OnPaisChanged(LookupItem? value)
    {
        if (_selectedPais?.Id == value?.Id)
            return;
        _selectedPais = value;
        _selectedEstado = null;
        _selectedMunicipio = null;
    }

    private void OnEstadoChanged(LookupItem? value)
    {
        if (_selectedEstado?.Id == value?.Id)
            return;
        _selectedEstado = value;
        _selectedMunicipio = null;
    }

    private static LookupItem? BuildLookup(int? id, string? text) =>
        id.GetValueOrDefault() > 0 ? new LookupItem { Id = id!.Value, Text = string.IsNullOrWhiteSpace(text) ? id.Value.ToString() : text } : null;
}
