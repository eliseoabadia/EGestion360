@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Adquisicion
@inject IGenericCrudService<ProveedorResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="ProveedorResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="ProveedorResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Clave"
                              Label="Clave"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="La clave es requerida"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Rfc"
                              Label="RFC"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El RFC es requerido"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Nombre"
                              Label="Nombre"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El nombre es requerido"
                              MaxLength="500" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Calle"
                              Label="Calle"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="item.Numero"
                              Label="Numero"
                              Variant="Variant.Outlined"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="item.NumeroInt"
                              Label="Numero interior"
                              Variant="Variant.Outlined"
                              MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Colonia"
                              Label="Colonia"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Cp"
                              Label="Codigo postal"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Ciudad"
                              Label="Ciudad"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="El email es requerido"
                              MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.TelefonoInstitucional"
                              Label="Telefono"
                              Variant="Variant.Outlined"
                              MaxLength="20" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="item.PaginaWeb"
                              Label="Pagina web"
                              Variant="Variant.Outlined"
                              MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="item.Notas"
                              Label="Notas"
                              Variant="Variant.Outlined"
                              MaxLength="500"
                              Lines="2" />
            </MudItem>
        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<ProveedorResponse> form = null!;
    private ProveedorResponse item = new() { Activo = true };

    private string dialogTitle => Id.HasValue ? "Editar Proveedor" : "Nuevo Proveedor";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                item.Activo = true;
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No fue posible cargar el proveedor.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync(bool _)
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos obligatorios del proveedor.", Severity.Warning);
            return;
        }

        NormalizeItem();

        try
        {
            ApiResponse<ProveedorResponse>? response;
            if (Id.HasValue)
            {
                response = await Service.UpdateAsync(item, Id.Value);
            }
            else
            {
                response = await Service.CreateAsync(item);
            }

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (Id.HasValue ? "Proveedor actualizado correctamente" : "Proveedor creado correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No fue posible guardar el proveedor.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private void NormalizeItem()
    {
        item.Activo = true;
        item.Clave = Trim(item.Clave).ToUpperInvariant();
        item.Rfc = Trim(item.Rfc).ToUpperInvariant();
        item.Nombre = Trim(item.Nombre);
        item.Email = Trim(item.Email);
        item.Calle = Trim(item.Calle);
        item.Numero = Trim(item.Numero);
        item.NumeroInt = Trim(item.NumeroInt);
        item.Colonia = Trim(item.Colonia);
        item.Cp = Trim(item.Cp);
        item.Ciudad = Trim(item.Ciudad);
        item.TelefonoInstitucional = Trim(item.TelefonoInstitucional);
        item.PaginaWeb = Trim(item.PaginaWeb);
        item.Notas = Trim(item.Notas);
    }

    private static string Trim(string? value) => (value ?? string.Empty).Trim();
}
