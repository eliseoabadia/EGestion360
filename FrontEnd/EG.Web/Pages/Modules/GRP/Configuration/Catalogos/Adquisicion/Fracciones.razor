@page "/configuracion/adquisiciones/fraccion"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<FraccionResponse, FraccionResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Fracciones"
                    Subtitle="Catálogo de fracciones"
                    Icon="@Icons.Material.Filled.Percent"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="FraccionResponse"
                      @ref="table"
                      Title="Lista de Fracciones"
                      SearchPlaceholder="Buscar por clave o descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">

            <Columns>
                <TemplateColumn Resizable="false" T="FraccionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidFraccion))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidFraccion))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="FraccionResponse" TProperty="int" Property="x => x.PkidFraccion" Title="ID" Identifier="PkidFraccion" />
                <PropertyColumn T="FraccionResponse" TProperty="string" Property="x => x.Clave" Title="Clave" Identifier="Clave" />
                <PropertyColumn T="FraccionResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                <PropertyColumn T="FraccionResponse" TProperty="string" Property="x => x.NombreArticulo" Title="Artículo" Identifier="NombreArticulo" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<FraccionResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Fraccion";

    protected override Type CreateDialogType => typeof(FraccionDialog);
    protected override Type EditDialogType => typeof(FraccionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<FraccionResponse>);

    protected override string GetDefaultSortLabel() => "Clave";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<FraccionResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidFraccion,
            Clave = u.Clave,
            Descripcion = u.Descripcion,
            Articulo = u.NombreArticulo,
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Descripcion ?? "la fracción";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
