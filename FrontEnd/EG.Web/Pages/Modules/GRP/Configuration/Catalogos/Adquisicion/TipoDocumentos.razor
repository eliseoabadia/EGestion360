@page "/configuracion/adquisiciones/tipo-documento"
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoDocumentoResponse, TipoDocumentoResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Documentos" Subtitle="Catálogo de tipos de documentos" Icon="@Icons.Material.Filled.Description" CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericTable TItem="TipoDocumentoResponse" @ref="table" Title="Lista de Tipos de Documentos" SearchPlaceholder="Buscar..." ShowExportButton="@CanExport" ServerDataFunc="LoadServerData" ExportFunc="ExportToExcel" SearchString="@SearchString" SearchStringChanged="(s) => SearchString = s" OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidTipoDocumento" T="TipoDocumentoResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="TipoDocumentoResponse">Descripción</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(item.PkidTipoDocumento))" /></MudTooltip>
                    <MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(item.PkidTipoDocumento))" /></MudTooltip>
                </MudTd>
                <MudTd>@item.PkidTipoDocumento</MudTd>
                <MudTd>@item.Descripcion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<TipoDocumentoResponse> table = null!;
    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "Tipo_Documentos";
    protected override Type CreateDialogType => typeof(TipoDocumentoDialog);
    protected override Type EditDialogType => typeof(TipoDocumentoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoDocumentoResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoDocumentoResponse> items) => items.Select(u => new { ID = u.PkidTipoDocumento, Descripcion = u.Descripcion});
    protected override async Task<string> GetItemNameForDelete(int id) { var response = await Service.GetByIdAsync(id); return response?.Data?.Descripcion ?? "el tipo de documento"; }
    protected override async Task ReloadData() { if (table != null) await table.ReloadData(); }
}