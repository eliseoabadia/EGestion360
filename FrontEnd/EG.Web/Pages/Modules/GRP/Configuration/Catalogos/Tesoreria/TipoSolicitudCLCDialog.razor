@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Tesoreria

@inject IGenericCrudService<TipoSolicitudCLCResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoSolicitudCLCResponse" Title="@dialogTitle" MaxWidth="MaxWidth.Medium" ActionText="@actionText"
    ProcessingText="@processingText" LoadingMessage="Cargando..." OnConfirm="GuardarCambiosAsync">
    <BaseEntityForm TEntity="TipoSolicitudCLCResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle">
        <MudTextField Margin="Margin.Dense" @bind-Value="item.Descripcion" Label="Descripción" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true" For="@(() => item.Descripcion)" />
    </BaseEntityForm>
</BaseCrudDialog>
@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private BaseEntityForm<TipoSolicitudCLCResponse> form = null!;
    private TipoSolicitudCLCResponse item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Solicitud CLC" : "Nueva Solicitud CLC";
    private string actionText => Id.HasValue ? EG.Common.ApplicationText.Actions.Update : EG.Common.ApplicationText.Actions.Create;
    private string processingText => Id.HasValue ? EG.Common.ApplicationText.Status.Updating : EG.Common.ApplicationText.Status.Creating;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
            await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
                item = response.Data;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(Id.HasValue ? "Solicitud CLC actualizada correctamente" : "Solicitud CLC creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
