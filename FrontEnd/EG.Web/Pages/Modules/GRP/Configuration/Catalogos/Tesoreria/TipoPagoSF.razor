@page "/configuracion/tesoreria/Tipo_PagoSF"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoPagoSFResponse, TipoPagoSFResponse>
<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Pago SF" Subtitle="Gestión del catálogo de tipos de pago SF" Icon="@Icons.Material.Filled.Receipt"
            CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="TipoPagoSFResponse"
                      @ref="table"
                      Title="Lista de Tipos de Pago SF"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoPagoSFResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoPagoSf))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoPagoSf))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoPagoSFResponse" TProperty="int" Property="x => x.PkidTipoPagoSf" Title="ID" Identifier="PkidTipoPagoSf" />
                <PropertyColumn T="TipoPagoSFResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>
@code {
    private GenericDataGrid<TipoPagoSFResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_PagoSF";
    protected override Type CreateDialogType => typeof(TipoPagoSFDialog);
    protected override Type EditDialogType => typeof(TipoPagoSFDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoPagoSFResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoPagoSFResponse> items) =>
        items.Select(u => new { ID = u.PkidTipoPagoSf, Descripcion = u.Descripcion});

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }
}
