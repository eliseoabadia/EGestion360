@page "/configuracion/tesoreria/Tipo_Inversion"
@page "/Presupuesto/Tesoreria/Inversiones/Tipo_Instrumentos"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoInversionResponse, TipoInversionResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Inversión"
                    Subtitle="Gestión del catálogo de tipos de inversión"
                    Icon="@Icons.Material.Filled.TrendingUp"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="TipoInversionResponse"
                      @ref="table"
                      Title="Lista de Tipos de Inversión"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoInversionResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoInversion))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoInversion))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoInversionResponse" TProperty="int" Property="x => x.PkidTipoInversion" Title="ID" Identifier="PkidTipoInversion" />
                <PropertyColumn T="TipoInversionResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoInversionResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Inversion";
    protected override Type CreateDialogType => typeof(TipoInversionDialog);
    protected override Type EditDialogType => typeof(TipoInversionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoInversionResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoInversionResponse> items) =>
        items.Select(u => new { ID = u.PkidTipoInversion, Descripcion = u.Descripcion});

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }
}
