@page "/configuracion/tesoreria/Tipo_Solicitud_CLC"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoSolicitudCLCResponse, TipoSolicitudCLCResponse>
<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Solicitud CLC" Subtitle="Gestión del catálogo de solicitudes CLC" Icon="@Icons.Material.Filled.Description"
            CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="TipoSolicitudCLCResponse"
                      @ref="table"
                      Title="Lista de Solicitudes CLC"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoSolicitudCLCResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoSolicitudClc))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoSolicitudClc))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoSolicitudCLCResponse" TProperty="int" Property="x => x.PkidTipoSolicitudClc" Title="ID" Identifier="PkidTipoSolicitudClc" />
                <PropertyColumn T="TipoSolicitudCLCResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>
@code {
    private GenericDataGrid<TipoSolicitudCLCResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_SolicitudCLC";
    protected override Type CreateDialogType => typeof(TipoSolicitudCLCDialog);
    protected override Type EditDialogType => typeof(TipoSolicitudCLCDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoSolicitudCLCResponse>);
    protected override string GetDefaultSortLabel() => "Descripcion";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoSolicitudCLCResponse> items) =>
        items.Select(u => new { ID = u.PkidTipoSolicitudClc, Descripcion = u.Descripcion});

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }
}
