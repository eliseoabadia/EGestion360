@using MudBlazor
@using EG.Common.GenericModel
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Domain.DTOs.Responses.Tesoreria

@inject IGenericCrudService<TipoCambioResponse> Service
@inject IGenericCrudService<TipoMonedaResponse> TipoMonedaService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoCambioResponse"
                 Title="@dialogTitle"
                 MaxWidth="MaxWidth.Medium"
                 ActionText="@actionText"
                 ProcessingText="@processingText"
                 LoadingMessage="Cargando datos..."
                 OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="TipoCambioResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle">

        <PagedAutocomplete Value="@selectedMoneda"
                           ValueChanged="value => selectedMoneda = value"
                           Label="Moneda"
                           Required="true"
                           RequiredError="La moneda es requerida"
                           PageSize="50"
                           LoadPage="LoadMonedasPageAsync" />

        <MudNumericField @bind-Value="item.Cantidad"
                          Label="Cantidad (Tipo de Cambio)"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-3"
                          DecimalDigits="4"
                          Required="true"
                          For="@(() => item.Cantidad)" />

        <MudDatePicker @bind-Date="selectedDate"
                        Label="Fecha"
                        Variant="Variant.Outlined"
                        FullWidth="true"
                        Class="mb-3"
                        Required="true" />

    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<TipoCambioResponse> form = null!;
    private TipoCambioResponse item = new() { Activo = true, Cantidad = 1.0m };
    private LookupItem? selectedMoneda;
    private DateTime? selectedDate = DateTime.Today;

    private string dialogTitle => Id.HasValue ? "Editar Tipo de Cambio" : "Nuevo Tipo de Cambio";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                selectedMoneda = new LookupItem
                {
                    Id = item.FkidTipoMonedaTes,
                    Text = TextOrDefault($"{item.MonedaCodigo} - {item.MonedaDescripcion}", item.FkidTipoMonedaTes)
                };
                selectedDate = item.Fecha;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            if (selectedMoneda == null)
            {
                Snackbar.Add("Selecciona una moneda.", Severity.Warning);
                return;
            }

            item.FkidTipoMonedaTes = selectedMoneda.Id;

            if (selectedDate.HasValue)
                item.Fecha = selectedDate.Value;

            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(Id.HasValue ? "Tipo de cambio actualizado correctamente" : "Tipo de cambio creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadMonedasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await TipoMonedaService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        var items = response?.Items?.Select(x => new LookupItem
        {
            Id = x.PkidTipoMoneda,
            Text = $"{x.CodigoIso4217} - {x.Descripcion}"
        });

        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = response?.TotalCount ?? list.Count };
    }

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) || text.Trim() == "-"
            ? id.ToString()
            : text.Trim();
}
