@using MudBlazor
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Requests.General
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared

@inject IGenericCrudService<TipoMonedaResponse> Service
@inject IGenericCrudService<PaiseDto> PaisService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoMonedaResponse" Title="@dialogTitle" MaxWidth="MaxWidth.Medium" ActionText="@actionText"
    ProcessingText="@processingText" LoadingMessage="Cargando..." OnConfirm="GuardarCambiosAsync">
    <BaseEntityForm TEntity="TipoMonedaResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle">
        <PagedAutocomplete Value="@_selectedPais" ValueChanged="value => _selectedPais = value" Label="Pais" Required="true" LoadItems="LoadPaisesAsync" />
        <MudTextField @bind-Value="item.CodigoIso4217" Label="Código ISO 4217" Variant="Variant.Outlined" FullWidth="true" Class="mt-3 mb-3" Required="true" MaxLength="3" Counter="3" Immediate="true" HelperText="Ejemplo: MXN, USD, EUR" For="@(() => item.CodigoIso4217)" />
        <MudTextField @bind-Value="item.Simbolo" Label="Símbolo" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" MaxLength="10" Counter="10" For="@(() => item.Simbolo)" />
        <MudTextField @bind-Value="item.Descripcion" Label="Descripción" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true" MaxLength="100" Counter="100" For="@(() => item.Descripcion)" />
        <MudNumericField @bind-Value="item.Decimales" Label="Decimales" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" For="@(() => item.Decimales)" />
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private BaseEntityForm<TipoMonedaResponse> form = null!;
    private TipoMonedaResponse item = new() { Activo = true, Decimales = 2 };
    private LookupItem? _selectedPais;
    private string dialogTitle => Id.HasValue ? "Editar Moneda" : "Nueva Moneda";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
            await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _selectedPais = new LookupItem
                {
                    Id = item.FkidPaisSis,
                    Text = string.IsNullOrWhiteSpace(item.PaisNombre) ? item.FkidPaisSis.ToString() : item.PaisNombre
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            if (!await form.ValidateAsync()) return;
            if (_selectedPais == null)
            {
                Snackbar.Add("Selecciona el país de la moneda.", Severity.Warning);
                return;
            }

            item.CodigoIso4217 = (item.CodigoIso4217 ?? string.Empty).Trim().ToUpperInvariant();
            item.Simbolo = (item.Simbolo ?? string.Empty).Trim();
            item.Descripcion = (item.Descripcion ?? string.Empty).Trim();

            if (item.CodigoIso4217.Length != 3)
            {
                Snackbar.Add("El código ISO 4217 debe tener exactamente 3 caracteres, por ejemplo MXN.", Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(item.Descripcion))
            {
                Snackbar.Add("La descripción de la moneda es obligatoria.", Severity.Warning);
                return;
            }

            item.FkidPaisSis = _selectedPais.Id;

            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(Id.HasValue ? "Moneda actualizada correctamente" : "Moneda creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<LookupItem>> LoadPaisesAsync(CancellationToken ct)
    {
        var response = await PaisService.GetAllAsync();
        return response?.Items?
            .Where(x => !string.IsNullOrWhiteSpace(x.Nombre))
            .OrderBy(x => x.Nombre)
            .Select(x => new LookupItem { Id = x.PkidPais, Text = x.Nombre })
            .ToList() ?? new List<LookupItem>();
    }
}
