@using MudBlazor
@using EG.Web.Pages.Shared
@using EG.Web.Contracts
@using EG.Domain.DTOs.Responses.Tesoreria

@inject IGenericCrudService<TipoDoctoClcResponse> Service
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="TipoDoctoClcResponse" Title="@dialogTitle" MaxWidth="MaxWidth.Medium" ActionText="@actionText"
    ProcessingText="@processingText" LoadingMessage="Cargando..." OnConfirm="GuardarCambiosAsync">
    <BaseEntityForm TEntity="TipoDoctoClcResponse" @ref="form" ShowHeader="true" HeaderTitle="@dialogTitle">
        <MudTextField @bind-Value="item.Clave" Label="Clave" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true" For="@(() => item.Clave)" />
        <MudTextField @bind-Value="item.Nombre" Label="Nombre" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true" For="@(() => item.Nombre)" />
        <MudTextField @bind-Value="item.TipoRecurso" Label="Tipo Recurso" Variant="Variant.Outlined" FullWidth="true" Class="mb-3" For="@(() => item.TipoRecurso)" />
    </BaseEntityForm>
</BaseCrudDialog>
@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private BaseEntityForm<TipoDoctoClcResponse> form = null!;
    private TipoDoctoClcResponse item = new() { Activo = true };
    private string dialogTitle => Id.HasValue ? "Editar Documento CLC" : "Nuevo Documento CLC";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
            await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id.Value);
            if (response?.Success == true && response.Data != null)
                item = response.Data;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            bool success;
            if (Id.HasValue)
            {
                var response = await Service.UpdateAsync(item, Id.Value);
                success = response?.Success == true;
            }
            else
            {
                var response = await Service.CreateAsync(item);
                success = response?.Success == true;
            }

            if (success)
            {
                Snackbar.Add(Id.HasValue ? "Documento CLC actualizado correctamente" : "Documento CLC creado correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Error al guardar los cambios", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }
}
