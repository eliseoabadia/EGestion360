@page "/configuracion/tesoreria/Tipo_Cambio"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoCambioResponse, TipoCambioResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Cambio"
                    Subtitle="Gestión del catálogo de tipos de cambio"
                    Icon="@Icons.Material.Filled.CurrencyExchange"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="TipoCambioResponse"
                      @ref="table"
                      Title="Lista de Tipos de Cambio"
                      SearchPlaceholder="Buscar por moneda..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoCambioResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoCambio))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoCambio))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoCambioResponse" TProperty="int" Property="x => x.PkidTipoCambio" Title="ID" Identifier="PkidTipoCambio" />
                <PropertyColumn T="TipoCambioResponse" TProperty="string" Property="x => x.MonedaCodigo" Title="Moneda" Identifier="MonedaCodigo" />
                <PropertyColumn T="TipoCambioResponse" TProperty="string" Property="x => x.MonedaDescripcion" Title="Descripción" Identifier="MonedaDescripcion" />
                <TemplateColumn Resizable="true" T="TipoCambioResponse" Title="Cantidad" Identifier="Cantidad"><CellTemplate>@context.Item.Cantidad.ToString("N4")</CellTemplate></TemplateColumn>
                <TemplateColumn Resizable="true" T="TipoCambioResponse" Title="Fecha" Identifier="Fecha"><CellTemplate>@context.Item.Fecha.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoCambioResponse> table = null!;

    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Cambio";

    protected override Type CreateDialogType => typeof(TipoCambioDialog);
    protected override Type EditDialogType => typeof(TipoCambioDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoCambioResponse>);

    protected override string GetDefaultSortLabel() => "Fecha";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoCambioResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidTipoCambio,
            Moneda = u.MonedaCodigo ?? string.Empty,
            Descripcion = u.MonedaDescripcion ?? string.Empty,
            Cantidad = u.Cantidad,
            Fecha = u.Fecha.ToString("dd/MM/yyyy"),
        });
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }
}
