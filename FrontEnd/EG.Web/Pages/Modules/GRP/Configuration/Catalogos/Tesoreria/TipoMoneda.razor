@page "/configuracion/tesoreria/Tipo_Moneda"
@using EG.Domain.DTOs.Responses.Tesoreria
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<TipoMonedaResponse, TipoMonedaResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Tipos de Moneda" Subtitle="Gestion del catalogo de monedas" Icon="@Icons.Material.Filled.AttachMoney"
            CanCreate="@CanCreate" OnCreate="CreateItem" OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="TipoMonedaResponse"
                      @ref="table"
                      Title="Lista de Monedas"
                      SearchPlaceholder="Buscar por codigo ISO, descripcion o pais..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn Resizable="false" T="TipoMonedaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidTipoMoneda))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidTipoMoneda))" /></MudTooltip></CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoMonedaResponse" TProperty="int" Property="x => x.PkidTipoMoneda" Title="ID" Identifier="PkidTipoMoneda" />
                <PropertyColumn T="TipoMonedaResponse" TProperty="string" Property="x => x.CodigoIso4217" Title="Código ISO" Identifier="CodigoIso4217" />
                <PropertyColumn T="TipoMonedaResponse" TProperty="string" Property="x => x.Simbolo" Title="Símbolo" Identifier="Simbolo" />
                <PropertyColumn T="TipoMonedaResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" />
                <TemplateColumn Resizable="true" T="TipoMonedaResponse" Title="País" Identifier="PaisNombre"><CellTemplate>@(string.IsNullOrWhiteSpace(context.Item.PaisNombre) ? "-" : context.Item.PaisNombre)</CellTemplate></TemplateColumn>
                <PropertyColumn T="TipoMonedaResponse" TProperty="int" Property="x => x.Decimales" Title="Decimales" Identifier="Decimales" />
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<TipoMonedaResponse> table = null!;
    protected override string ModuleName => "Tesoreria";
    protected override string SubModuleName => "Tipo_Moneda";
    protected override Type CreateDialogType => typeof(TipoMonedaDialog);
    protected override Type EditDialogType => typeof(TipoMonedaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<TipoMonedaResponse>);
    protected override string GetDefaultSortLabel() => "CodigoIso4217";
    protected override IEnumerable<object> MapToExcelData(IEnumerable<TipoMonedaResponse> items) =>
        items.Select(u => new
        {
            ID = u.PkidTipoMoneda,
            CodigoISO = u.CodigoIso4217,
            u.Simbolo,
            u.Descripcion,
            Pais = u.PaisNombre,
            u.Decimales,
        });

    protected override async Task ReloadData()
    {
        if (table != null)
            await table.ReloadData();
    }
}
