@page "/configuracion/almacen/motivo_entradas_salidas"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<MotivoEsResponse, MotivoEsResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Motivo de Entradas y Salidas"
                    Subtitle="Gestión del catálogo de motivos"
                    Icon="@Icons.Material.Filled.List"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericDataGrid TItem="MotivoEsResponse"
                      @ref="table"
                      Title="Lista de Motivos"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns><TemplateColumn Resizable="false" T="MotivoEsResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidMotivoEs))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidMotivoEs))" /></MudTooltip></CellTemplate></TemplateColumn><PropertyColumn T="MotivoEsResponse" TProperty="int" Property="x => x.PkidMotivoEs" Title="ID" Identifier="PkidMotivoEs" /><PropertyColumn T="MotivoEsResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" /><PropertyColumn T="MotivoEsResponse" TProperty="bool" Property="x => x.AplicaEntrada" Title="Aplica Entrada" Identifier="AplicaEntrada" /><PropertyColumn T="MotivoEsResponse" TProperty="bool" Property="x => x.AplicaSalida" Title="Aplica Salida" Identifier="AplicaSalida" /></Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<MotivoEsResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Movimiento_Entrada_Salida";

    protected override Type CreateDialogType => typeof(MotivoEsDialog);
    protected override Type EditDialogType => typeof(MotivoEsDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<MotivoEsResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<MotivoEsResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidMotivoEs,
            Descripcion = u.Descripcion ?? string.Empty,
            AplicaEntrada = u.AplicaEntrada ? "Sí" : "No",
            AplicaSalida = u.AplicaSalida ? "Sí" : "No",
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}




