@page "/configuracion/almacen/Estatus_Solicitud"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<EstatusSolicitudResponse, EstatusSolicitudResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Estatus de Solicitudes"
                    Subtitle="Gestión del catálogo de estatus"
                    Icon="@Icons.Material.Filled.Info"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericDataGrid TItem="EstatusSolicitudResponse"
                      @ref="table"
                      Title="Lista de Estatus"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns><TemplateColumn T="EstatusSolicitudResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidEstatusSolicitud))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidEstatusSolicitud))" /></MudTooltip></CellTemplate></TemplateColumn><PropertyColumn T="EstatusSolicitudResponse" TProperty="int" Property="x => x.PkidEstatusSolicitud" Title="ID" Identifier="PkidEstatusSolicitud" /><PropertyColumn T="EstatusSolicitudResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" /><PropertyColumn T="EstatusSolicitudResponse" TProperty="string" Property="x => x.Color" Title="Color" Identifier="Color" /></Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<EstatusSolicitudResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Estatus_Solicitud";

    protected override Type CreateDialogType => typeof(EstatusSolicitudDialog);
    protected override Type EditDialogType => typeof(EstatusSolicitudDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EstatusSolicitudResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EstatusSolicitudResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidEstatusSolicitud,
            Descripcion = u.Descripcion ?? string.Empty,
            Color = u.Color ?? string.Empty,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}










