@page "/configuracion/almacen/unidades"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<UnidadeResponse, UnidadeResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Unidades"
                    Subtitle="Gestión del catálogo de unidades"
                    Icon="@Icons.Material.Filled.Scale"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericDataGrid TItem="UnidadeResponse"
                      @ref="table"
                      Title="Lista de Unidades"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns><TemplateColumn Resizable="false" T="UnidadeResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Visible="@CanUpdate" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItem(context.Item.PkidUnidades))" /></MudTooltip><MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Visible="@CanDelete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item.PkidUnidades))" /></MudTooltip></CellTemplate></TemplateColumn><PropertyColumn T="UnidadeResponse" TProperty="int" Property="x => x.PkidUnidades" Title="ID" Identifier="PkidUnidades" /><PropertyColumn T="UnidadeResponse" TProperty="string" Property="x => x.Descripcion" Title="Descripción" Identifier="Descripcion" /></Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<UnidadeResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Unidades";

    protected override Type CreateDialogType => typeof(UnidadesDialog);
    protected override Type EditDialogType => typeof(UnidadesDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<UnidadeResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<UnidadeResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidUnidades,
            Descripcion = u.Descripcion ?? string.Empty,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}











