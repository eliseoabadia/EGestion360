@page "/configuracion/almacen/unidades"
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@inherits BaseCrudPage<UnidadeResponse, UnidadeResponse>

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Unidades"
                    Subtitle="Gestión del catálogo de unidades"
                    Icon="@Icons.Material.Filled.Scale"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                   
                    />

        <GenericTable TItem="UnidadeResponse"
                      @ref="table"
                      Title="Lista de Unidades"
                      SearchPlaceholder="Buscar por descripción..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Header>
                <MudTh>Acciones</MudTh>
                <MudTh><MudTableSortLabel SortLabel="PkidUnidades" T="UnidadeResponse">ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Descripcion" T="UnidadeResponse">Descripción</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="FechaCreacion" T="UnidadeResponse">Fecha Creación</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="UsuarioCreacion" T="UnidadeResponse">Usuario Creación</MudTableSortLabel></MudTh>
            </Header>
            <Row Context="item">
                <MudTd>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Visible="@CanUpdate"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(item.PkidUnidades))" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Visible="@CanDelete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item.PkidUnidades))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@item.PkidUnidades</MudTd>
                <MudTd>@item.Descripcion</MudTd>
                <MudTd>@(item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "")</MudTd>
                <MudTd>@item.UsuarioCreacion</MudTd>
            </Row>
        </GenericTable>
    </MudContainer>
</AccessVerification>

@code {
    private GenericTable<UnidadeResponse> table = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Unidades";

    protected override Type CreateDialogType => typeof(UnidadesDialog);
    protected override Type EditDialogType => typeof(UnidadesDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<UnidadeResponse>);

    protected override string GetDefaultSortLabel() => "Descripcion";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<UnidadeResponse> items)
    {
        return items.Select(u => new
        {
            ID = u.PkidUnidades,
            Descripcion = u.Descripcion ?? string.Empty,
            FechaCreacion = u.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioCreacion = u.UsuarioCreacion
        });
    }
}











