@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.PresupuestoModificado
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<RequisicionPartidaResponse> Service
@inject IGenericCrudService<RequisicionResponse> RequisicionService
@inject IGenericCrudService<EgresoDisponibleResponse> DisponibleService
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="RequisicionPartidaResponse"
                Title="@dialogTitle"
                MaxWidth="MaxWidth.Medium"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="RequisicionPartidaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <MudGrid GutterSize="2">
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">
                    @if (EsRequisicionPrincipal)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mr-1">Principal</MudChip>
                    }
                    <span>Requisicion</span>
                </MudText>
                <PagedAutocomplete Value="@_selectedRequisicion"
                                   ValueChanged="OnRequisicionChanged"
                                   Label="Requisicion"
                                   Required="true"
                                   RequiredError="La requisicion es requerida"
                                   Disabled="@EsRequisicionPrincipal"
                                   LoadPage="LoadRequisicionesPageAsync" />
            </MudItem>

            <MudItem xs="12">
                <PagedAutocomplete Value="@_selectedPartida"
                                   ValueChanged="OnPosicionChanged"
                                   Label="Posicion presupuestal / partida"
                                   Required="true"
                                   RequiredError="La posicion presupuestal es requerida"
                                   LoadPage="LoadPartidasPageAsync" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="item.Monto"
                                 Label="Monto"
                                 Variant="Variant.Outlined"
                                 Format="0.00"
                                 Culture="@NumberCulture"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 Min="0.01m"
                                 Required="true"
                                 RequiredError="El monto es requerido" />
            </MudItem>

            @if (_selectedDisponible != null)
            {
                <MudItem xs="12" md="6">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Disponible: <strong>@Money(_selectedDisponible.Total ?? 0m)</strong>
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="item.Observaciones"
                              Label="Observaciones"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="500" />
            </MudItem>

        </MudGrid>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int EmpresaId { get; set; }
    [Parameter] public int RequisicionId { get; set; }
    [Parameter] public string RequisicionDescripcion { get; set; } = string.Empty;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<RequisicionPartidaResponse> form = null!;
    private RequisicionPartidaResponse item = new() { Activo = true, Observaciones = string.Empty };
    private LookupItem? _selectedRequisicion;
    private LookupItem? _selectedPartida;
    private RequisicionResponse? _requisicion;
    private EgresoDisponibleResponse? _selectedDisponible;

    private string dialogTitle => Id.HasValue ? "Editar Partida de Requisicion" : "Nueva Partida de Requisicion";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";
    private bool EsRequisicionPrincipal => RequisicionId > 0;

    protected override async Task OnInitializedAsync()
    {
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
        else if (RequisicionId > 0)
        {
            item.FkidRequisicionOrco = RequisicionId;
            _selectedRequisicion = new LookupItem
            {
                Id = RequisicionId,
                Text = TextOrDefault(RequisicionDescripcion, RequisicionId)
            };
            await LoadRequisicionAsync(RequisicionId);
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _selectedRequisicion = new LookupItem
                {
                    Id = item.FkidRequisicionOrco,
                    Text = TextOrDefault(item.RequisicionDescripcion, item.FkidRequisicionOrco)
                };
                _selectedPartida = new LookupItem
                {
                    Id = item.FkidEgresoAutorizadoPres ?? 0,
                    Text = TextOrDefault(item.EgresoAutorizadoDescripcion, item.FkidEgresoAutorizadoPres ?? item.FkidPartidaConta)
                };
                await LoadRequisicionAsync(item.FkidRequisicionOrco);
                if (item.FkidEgresoAutorizadoPres.HasValue)
                    await LoadDisponibleAsync(item.FkidEgresoAutorizadoPres.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        var empresaId = EmpresaId > 0 ? EmpresaId : SucursalStateService.EmpresaId;
        if (!empresaId.HasValue || empresaId.Value <= 0)
        {
            Snackbar.Add("Debe existir una empresa seleccionada.", Severity.Warning);
            return;
        }

        if (_selectedRequisicion == null)
        {
            Snackbar.Add("Debe seleccionar una requisicion.", Severity.Warning);
            return;
        }

        if (_selectedPartida == null || _selectedDisponible == null)
        {
            Snackbar.Add("Debe seleccionar una posicion presupuestal disponible.", Severity.Warning);
            return;
        }
        if (!item.Monto.HasValue || item.Monto.Value <= 0)
        {
            Snackbar.Add("El monto debe ser mayor a cero.", Severity.Warning);
            return;
        }
        if (item.Monto.Value > (_selectedDisponible.Total ?? 0m))
        {
            Snackbar.Add("El monto no puede exceder el presupuesto disponible.", Severity.Warning);
            return;
        }

        item.FkidEmpresaSis = empresaId.Value;
        item.FkidRequisicionOrco = _selectedRequisicion.Id;
        item.FkidEgresoAutorizadoPres = _selectedDisponible.PkidEgresoAutorizado;
        item.FkidPartidaConta = _selectedDisponible.FkidPartidaConta;
        item.Observaciones ??= string.Empty;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(Id.HasValue ? "Partida actualizada correctamente" : "Partida creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar la partida", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadRequisicionesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var anioFilter = GetAnioFilter();
        if (anioFilter == null)
        {
            return new ComboLookupResult();
        }

        var response = await RequisicionService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending, anioFilter);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidRequisicion, Text = $"{x.PkidRequisicion} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadPartidasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        if (_requisicion == null)
            return new ComboLookupResult();

        var filters = new Dictionary<string, object>
        {
            ["FkidAnioSis"] = _requisicion.FkidAnioSis ?? 0,
            ["FkidAreaSis"] = _requisicion.FkidAreaSis,
            ["FkidProgramaPres"] = _requisicion.FkidProgramaPres ?? 0
        };
        if (_requisicion.FkidFuenteFinanciamientoPres.HasValue)
            filters["FkidFuenteFinanciamientoPres"] = _requisicion.FkidFuenteFinanciamientoPres.Value;
        if (_requisicion.FkidTipoGastoPres.HasValue)
            filters["FkidTipoGastoPres"] = _requisicion.FkidTipoGastoPres.Value;
        if (_requisicion.FkidDigitoIdentificadorPres.HasValue)
            filters["FkidDigitoIdentificadorPres"] = _requisicion.FkidDigitoIdentificadorPres.Value;
        if (_requisicion.FkidDestinoGastoPres.HasValue)
            filters["FkidDestinoGastoPres"] = _requisicion.FkidDestinoGastoPres.Value;
        if (_requisicion.FkidProyectoOrco.HasValue)
            filters["FkidPyPres"] = _requisicion.FkidProyectoOrco.Value;

        var response = await DisponibleService.GetAllPaginadoAsync(
            page, pageSize, filter, "PartidaClave", SortDirection.Ascending, filters);
        var partidas = response?.Items?
            .Where(x => (x.Total ?? 0m) > 0m)
            .Select(x => new LookupItem
            {
                Id = x.PkidEgresoAutorizado,
                Text = $"{x.PartidaClaveNombre} · disponible {Money(x.Total ?? 0m)}"
            });
        return ToComboResult(partidas, response?.TotalCount);
    }

    private async Task OnRequisicionChanged(LookupItem? value)
    {
        _selectedRequisicion = value;
        _selectedPartida = null;
        _selectedDisponible = null;
        _requisicion = null;
        if (value != null)
            await LoadRequisicionAsync(value.Id);
    }

    private async Task OnPosicionChanged(LookupItem? value)
    {
        _selectedPartida = value;
        _selectedDisponible = null;
        if (value != null)
            await LoadDisponibleAsync(value.Id);
    }

    private async Task LoadRequisicionAsync(int id)
    {
        var response = await RequisicionService.GetByIdAsync(id);
        if (response?.Success == true)
            _requisicion = response.Data;
    }

    private async Task LoadDisponibleAsync(int id)
    {
        var response = await DisponibleService.GetByIdAsync(id);
        if (response?.Success == true)
            _selectedDisponible = response.Data;
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private Dictionary<string, object>? GetAnioFilter() =>
        AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0
            ? new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId.Value }
            : null;

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) ? id.ToString() : text;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static string Money(decimal value) => value.ToString("C2", CultureInfo.GetCultureInfo("es-MX"));
}
