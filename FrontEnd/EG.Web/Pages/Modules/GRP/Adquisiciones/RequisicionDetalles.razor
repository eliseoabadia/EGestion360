@page "/Adquisiciones/RequisicionDetalle"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<RequisicionDetalleResponse, RequisicionDetalleResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">
        <PageHeader Title="Detalle de Requisicion"
                    Subtitle="Catalogo de bienes y servicios requisitados"
                    Icon="@Icons.Material.Filled.Inventory2"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <GenericDataGrid TItem="RequisicionDetalleResponse"
                      @ref="table"
                      Title="Lista de Detalles"
                      SearchPlaceholder="Buscar por requisicion, bien o unidad..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidRequisicionDetalle))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidRequisicionDetalle))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="ID" Identifier="PkidRequisicionDetalle" PropertyName="PkidRequisicionDetalle" SortBy="x => x.PkidRequisicionDetalle">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidRequisicionDetalle
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Requisicion" Identifier="RequisicionDescripcion" PropertyName="RequisicionDescripcion" SortBy="x => x.RequisicionDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.RequisicionDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Clave" Identifier="TipoBienCodigoClave" PropertyName="TipoBienCodigoClave" SortBy="x => x.TipoBienCodigoClave">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienCodigoClave)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Cantidad" Identifier="Cantidad" PropertyName="Cantidad" SortBy="x => x.Cantidad">
                    <CellTemplate Context="cell">
                        @Quantity(cell.Item.Cantidad)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Unidad" Identifier="UnidadMedida" PropertyName="UnidadMedida" SortBy="x => x.UnidadMedida">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.UnidadMedida)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<RequisicionDetalleResponse> table = null!;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "requisicion";

    protected override Type CreateDialogType => typeof(RequisicionDetalleDialog);
    protected override Type EditDialogType => typeof(RequisicionDetalleDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<RequisicionDetalleResponse>);

    protected override string GetDefaultSortLabel() => "PkidRequisicionDetalle";

    protected override IEnumerable<object> MapToExcelData(IEnumerable<RequisicionDetalleResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidRequisicionDetalle,
            Requisicion = item.RequisicionDescripcion,
            Clave = item.TipoBienCodigoClave,
            Bien = item.TipoBienDescripcion,
            item.Cantidad,
            Unidad = item.UnidadMedida,
            item.Observaciones,
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.TipoBienDescripcion ?? "el detalle";
    }

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private static string Quantity(decimal value) => value.ToString("0.00", NumberCulture);
}
