    private async Task OpenCotizacionFromRequisicion(RequisicionResponse? requisicion)
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear cotizaciones", Severity.Warning);
            return;
        }

        if (requisicion == null)
        {
            Snackbar.Add("Selecciona una requisicion primero.", Severity.Warning);
            return;
        }

        if (!HasCompleteBudgetClassification(requisicion))
        {
            var completedRequisicion = await CompleteBudgetClassificationAsync(requisicion);
            if (completedRequisicion == null)
            {
                return;
            }

            requisicion = completedRequisicion;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (!await RequisicionTieneBienesAsync(requisicion.PkidRequisicion))
        {
            Snackbar.Add("La requisicion debe tener al menos un bien para generar una cotizacion.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AnioId"] = AnioStateService.AnioId!.Value,
            ["RequisicionId"] = requisicion.PkidRequisicion,
            ["RequisicionNombre"] = requisicion.Descripcion
        };

        var dialog = await DialogService.ShowAsync<CotizacionDialog>(
            "Crear Cotizacion",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (SelectedRequisicion?.PkidRequisicion == requisicion.PkidRequisicion)
            {
                await RefreshSelectedRequisicion();
            }
            else if (table != null)
            {
                await table.ReloadData();
            }
        }
    }

    private async Task<RequisicionResponse?> CompleteBudgetClassificationAsync(RequisicionResponse requisicion)
    {
        if (!CanUpdate)
        {
            Snackbar.Add(
                $"No se puede generar la cotizacion. {BuildMissingBudgetClassificationMessage(requisicion)} " +
                "No tienes permisos para editarla.",
                Severity.Error);
            return null;
        }

        if (await IsRequisicionLockedAsync(requisicion.PkidRequisicion, "completar su clasificacion presupuestal"))
        {
            return null;
        }

        Snackbar.Add(
            $"{BuildMissingBudgetClassificationMessage(requisicion)} Se abrira el formulario para completarla.",
            Severity.Info);

        var parameters = new DialogParameters
        {
            ["Id"] = requisicion.PkidRequisicion,
            ["EmpresaId"] = requisicion.FkidEmpresaSis,
            ["AnioId"] = AnioStateService.AnioId ?? requisicion.FkidAnioSis
        };

        var dialog = await DialogService.ShowAsync<RequisicionDialog>(
            "Completar clasificacion presupuestal",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return null;
        }

        var refreshed = await Service.GetByIdAsync(requisicion.PkidRequisicion);
        var updated = refreshed?.Success == true ? refreshed.Data : null;
        if (updated == null)
        {
            Snackbar.Add("La requisicion se guardo, pero no fue posible recargarla.", Severity.Warning);
            return null;
        }

        if (!HasCompleteBudgetClassification(updated))
        {
            Snackbar.Add(
                $"La requisicion sigue incompleta. {BuildMissingBudgetClassificationMessage(updated)}",
                Severity.Warning);
            return null;
        }

        if (SelectedRequisicion?.PkidRequisicion == updated.PkidRequisicion)
        {
            SelectedRequisicion = updated;
        }

        await ReloadData();
        Snackbar.Add("Clasificacion completa. Continuando con la cotizacion.", Severity.Success);
        return updated;
    }

    private static bool HasCompleteBudgetClassification(RequisicionResponse item) =>
        item.FkidProgramaPres.HasValue && item.FkidProgramaPres.Value > 0 &&
        item.FkidFuenteFinanciamientoPres.HasValue && item.FkidFuenteFinanciamientoPres.Value > 0 &&
        item.FkidTipoGastoPres.HasValue && item.FkidTipoGastoPres.Value > 0 &&
        item.FkidDigitoIdentificadorPres.HasValue && item.FkidDigitoIdentificadorPres.Value > 0 &&
        item.FkidDestinoGastoPres.HasValue && item.FkidDestinoGastoPres.Value > 0;

    private static string BuildMissingBudgetClassificationMessage(RequisicionResponse item)
    {
        var missing = new List<string>();

        if (!item.FkidProgramaPres.HasValue || item.FkidProgramaPres.Value <= 0) missing.Add("programa");
        if (!item.FkidFuenteFinanciamientoPres.HasValue || item.FkidFuenteFinanciamientoPres.Value <= 0) missing.Add("fuente de financiamiento");
        if (!item.FkidTipoGastoPres.HasValue || item.FkidTipoGastoPres.Value <= 0) missing.Add("TG");
        if (!item.FkidDigitoIdentificadorPres.HasValue || item.FkidDigitoIdentificadorPres.Value <= 0) missing.Add("DI");
        if (!item.FkidDestinoGastoPres.HasValue || item.FkidDestinoGastoPres.Value <= 0) missing.Add("DG");

        return $"Completa {string.Join(", ", missing)} editando la requisicion.";
    }

    private static string ClassificationText(string? clave, string? descripcion)
    {
        if (string.IsNullOrWhiteSpace(clave) && string.IsNullOrWhiteSpace(descripcion)) return "FALTA";
        return string.IsNullOrWhiteSpace(descripcion) ? clave! : $"{clave} - {descripcion}".Trim(' ', '-');
    }

