    private static string? GetQuoteDisabledReason(RequisicionResponse requisicion)
    {
        if (!HasCompleteBudgetClassification(requisicion))
            return "Completa la clasificacion presupuestal.";
        if (requisicion.DetallesActivos <= 0)
            return "Agrega al menos un bien o servicio.";
        if (requisicion.CotizacionesActivas > 0)
            return "Ya existe una cotizacion activa.";

        return null;
    }

    private static string GetEditTooltip(RequisicionResponse requisicion) =>
        IsLocked(requisicion)
            ? "No se puede editar porque ya existe una cotizacion activa."
            : "Editar requisicion; disponible hasta generar la cotizacion.";

    private static string? GetSufficiencyDisabledReason(RequisicionResponse requisicion)
    {
        if (requisicion.CotizacionesActivas <= 0)
            return "Genera primero una cotizacion.";
        if (!requisicion.TodosLosDetallesCotizados)
            return "Captura el monto de todos los bienes cotizados.";
        if (requisicion.TodosLosDetallesEnSuficiencia)
            return "Todos los bienes ya fueron enviados a suficiencia.";

        return null;
    }

    private static string GetWorkflowLabel(RequisicionResponse requisicion)
    {
        if (!HasCompleteBudgetClassification(requisicion))
            return "Falta clasificacion";
        if (requisicion.PartidasActivas <= 0)
            return "Falta partida";
        if (requisicion.DetallesActivos <= 0)
            return "Faltan bienes";
        if (requisicion.CotizacionesActivas <= 0)
            return "Lista para cotizar";
        if (!requisicion.TodosLosDetallesCotizados)
            return "Cotizacion pendiente";
        if (!requisicion.TodosLosDetallesEnSuficiencia)
            return "Lista para suficiencia";

        return "En suficiencia";
    }

    private static Color GetWorkflowColor(RequisicionResponse requisicion)
    {
        if (!HasCompleteBudgetClassification(requisicion) ||
            requisicion.PartidasActivas <= 0 ||
            requisicion.DetallesActivos <= 0)
        {
            return Color.Warning;
        }

        if (requisicion.CotizacionesActivas <= 0 ||
            requisicion.TodosLosDetallesCotizados && !requisicion.TodosLosDetallesEnSuficiencia)
        {
            return Color.Success;
        }

        return requisicion.TodosLosDetallesEnSuficiencia ? Color.Info : Color.Primary;
    }

    private Task NavigateToCotizacionesAsync()
    {
        NavigationManager.NavigateTo("/Adquisiciones/Cotizacion");
        return Task.CompletedTask;
    }

    private async Task ReloadPartidas()
    {
        if (partidaTable != null)
        {
            await partidaTable.ReloadData();
        }
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private static string MoneyOrDash(decimal? value) =>
        value.HasValue ? $"${value.Value.ToString("0.00", NumberCulture)}" : "-";

    private static string Quantity(decimal value) => value.ToString("0.00", NumberCulture);

    private bool IsSelectedPartida(RequisicionPartidaResponse partida) =>
        SelectedPartida?.PkidRequisicionPartida == partida.PkidRequisicionPartida;

    private static bool IsLocked(RequisicionResponse? requisicion) =>
        requisicion?.BloqueadaPorCotizacion == true;

    private bool CanModifySelectedRequisicion(string action)
    {
        if (!IsSelectedLocked)
        {
            return true;
        }

        Snackbar.Add($"La requisicion esta en cotizacion. Liberala para {action}.", Severity.Warning);
        return false;
    }

    private async Task<bool> IsRequisicionLockedAsync(int id, string action)
    {
        var requisicion = await GetRequisicionForLockAsync(id);
        if (!IsLocked(requisicion))
        {
            return false;
        }

        Snackbar.Add($"La requisicion esta en cotizacion. Liberala para {action}.", Severity.Warning);
        return true;
    }

    private async Task<RequisicionResponse?> GetRequisicionForLockAsync(int id)
    {
        if (SelectedRequisicion?.PkidRequisicion == id)
        {
            return SelectedRequisicion;
        }

        var current = Elements.FirstOrDefault(x => x.PkidRequisicion == id);
        if (current != null)
        {
            return current;
        }

        var response = await Service.GetByIdAsync(id);
        return response?.Success == true ? response.Data : null;
    }

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }
