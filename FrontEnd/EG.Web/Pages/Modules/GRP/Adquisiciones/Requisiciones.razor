    private async Task LoadRequisicionFromRouteAsync(int id)
    {
        openingRequisicion = true;

        try
        {
            var response = await Service.GetByIdAsync(id);
            if (response?.Success == true && response.Data != null)
            {
                SelectedRequisicion = response.Data;
                SelectedPartida = null;
                loadedRequisicionId = id;
                return;
            }

            Snackbar.Add(response?.Message ?? "No fue posible cargar la requisición seleccionada.", Severity.Error);
            ResetRequisicionSelection();
            NavigationManager.NavigateTo("/Adquisiciones/Requisicion", replace: true);
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("Requisiciones")
                .LogError(ex, "No se pudo cargar la requisición {RequisicionId} desde la ruta.", id);
            Snackbar.Add("No fue posible cargar el detalle de la requisición.", Severity.Error);
            ResetRequisicionSelection();
            NavigationManager.NavigateTo("/Adquisiciones/Requisicion", replace: true);
        }
        finally
        {
            openingRequisicion = false;
        }
    }

