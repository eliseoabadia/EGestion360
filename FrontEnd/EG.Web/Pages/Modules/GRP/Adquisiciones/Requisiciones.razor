    private IReadOnlyCollection<ProgressiveAction> BuildRequisicionActions(RequisicionResponse requisicion)
    {
        var classificationComplete = HasCompleteBudgetClassification(requisicion);
        var hasPartidas = requisicion.PartidasActivas > 0;
        var hasDetalles = requisicion.DetallesActivos > 0;
        var hasCotizacion = requisicion.CotizacionesActivas > 0;
        var isLocked = IsLocked(requisicion);

        var primaryActionId = !classificationComplete
            ? "edit"
            : !hasPartidas || !hasDetalles
                ? "open"
                : !hasCotizacion
                    ? "quote"
                    : !requisicion.TodosLosDetallesCotizados
                        ? "cotizaciones"
                        : !requisicion.TodosLosDetallesEnSuficiencia
                            ? "sufficiency"
                            : "open";

        var openLabel = !classificationComplete
            ? "Consultar requisicion"
            : !hasPartidas
                ? "Agregar partida"
                : !hasDetalles
                    ? "Agregar bien o servicio"
                    : requisicion.TodosLosDetallesEnSuficiencia
                        ? "Consultar flujo"
                        : "Abrir requisicion";

        var openIcon = !hasPartidas
            ? Icons.Material.Filled.PlaylistAdd
            : !hasDetalles
                ? Icons.Material.Filled.AddShoppingCart
                : Icons.Material.Filled.OpenInFull;

        return new List<ProgressiveAction>
        {
            new()
            {
                Id = "open",
                Label = openLabel,
                Icon = openIcon,
                Color = Color.Info,
                Order = 10,
                IsPrimary = primaryActionId == "open",
                Enabled = !openingRequisicion,
                DisabledReason = openingRequisicion ? "La requisicion se esta abriendo." : null,
                ExecuteAsync = () =>
                {
                    OpenRequisicionDetail(requisicion);
                    return Task.CompletedTask;
                }
            },
            new()
            {
                Id = "edit",
                Label = classificationComplete ? "Editar requisicion" : "Completar clasificacion",
                Icon = Icons.Material.Filled.Edit,
                Color = classificationComplete ? Color.Primary : Color.Warning,
                Order = 20,
                IsPrimary = primaryActionId == "edit",
                Visible = CanUpdate && !classificationComplete,
                Enabled = !isLocked,
                DisabledReason = isLocked ? "Ya existe una cotizacion activa." : null,
                ExecuteAsync = () => EditItem(requisicion.PkidRequisicion)
            },
            new()
            {
                Id = "quote",
                Label = "Generar cotizacion",
                Icon = Icons.Material.Filled.RequestQuote,
                Color = Color.Success,
                Order = 30,
                IsPrimary = primaryActionId == "quote",
                Visible = CanCreate,
                Enabled = classificationComplete && hasDetalles && !hasCotizacion,
                DisabledReason = GetQuoteDisabledReason(requisicion),
                ExecuteAsync = () => OpenCotizacionFromRequisicion(requisicion)
            },
            new()
            {
                Id = "cotizaciones",
                Label = requisicion.TodosLosDetallesCotizados ? "Ver cotizaciones" : "Completar montos cotizados",
                Icon = Icons.Material.Filled.AttachMoney,
                Color = requisicion.TodosLosDetallesCotizados ? Color.Info : Color.Warning,
                Order = 40,
                IsPrimary = primaryActionId == "cotizaciones",
                Visible = hasCotizacion,
                Enabled = true,
                ExecuteAsync = NavigateToCotizacionesAsync
            },
            new()
            {
                Id = "sufficiency",
                Label = requisicion.TodosLosDetallesEnSuficiencia
                    ? "Suficiencia enviada"
                    : "Enviar a suficiencia",
                Icon = Icons.Material.Filled.RuleFolder,
                Color = Color.Primary,
                Order = 50,
                IsPrimary = primaryActionId == "sufficiency",
                Visible = CanCreate,
                Enabled = hasCotizacion &&
                          requisicion.TodosLosDetallesCotizados &&
                          !requisicion.TodosLosDetallesEnSuficiencia,
                DisabledReason = GetSufficiencyDisabledReason(requisicion),
                ExecuteAsync = () => OpenSolicitudSuficienciaFromRequisicion(requisicion)
            },
            new()
            {
                Id = "delete",
                Label = "Eliminar requisicion",
                Icon = Icons.Material.Filled.Delete,
                Color = Color.Error,
                Order = 90,
                Visible = CanDelete,
                Enabled = !isLocked,
                IsDestructive = true,
                DisabledReason = isLocked ? "No se puede eliminar mientras tenga una cotizacion activa." : null,
                ExecuteAsync = () => DeleteItem(requisicion.PkidRequisicion)
            }
        };
    }

    private IReadOnlyCollection<ProgressiveAction> BuildSelectedRequisicionActions()
    {
        if (SelectedRequisicion == null)
        {
            return Array.Empty<ProgressiveAction>();
        }

        var requisicion = SelectedRequisicion;
        var classificationComplete = HasCompleteBudgetClassification(requisicion);
        var hasPartidas = requisicion.PartidasActivas > 0;
        var hasDetalles = requisicion.DetallesActivos > 0;
        var hasCotizacion = requisicion.CotizacionesActivas > 0;

        var primaryActionId = !classificationComplete
            ? "edit"
            : !hasPartidas
                ? "add-partida"
                : !hasDetalles
                    ? SelectedPartida == null ? "select-partida" : "add-detail"
                    : !hasCotizacion
                        ? "quote"
                        : !requisicion.TodosLosDetallesCotizados
                            ? "cotizaciones"
                            : !requisicion.TodosLosDetallesEnSuficiencia
                                ? "sufficiency"
                                : CanExport ? "export" : "cotizaciones";

        return new List<ProgressiveAction>
        {
            new()
            {
                Id = "edit",
                Label = classificationComplete ? "Editar requisicion" : "Completar clasificacion",
                Icon = Icons.Material.Filled.Edit,
                Color = classificationComplete ? Color.Primary : Color.Warning,
                Order = 10,
                IsPrimary = primaryActionId == "edit",
                Visible = CanUpdate,
                Enabled = !IsSelectedLocked,
                DisabledReason = IsSelectedLocked ? "Ya existe una cotizacion activa." : null,
                ExecuteAsync = () => EditItem(requisicion.PkidRequisicion)
            },
            new()
            {
                Id = "add-partida",
                Label = "Agregar partida",
                Icon = Icons.Material.Filled.PlaylistAdd,
                Color = Color.Success,
                Order = 20,
                IsPrimary = primaryActionId == "add-partida",
                Visible = CanCreate,
                Enabled = classificationComplete && !IsSelectedLocked,
                DisabledReason = !classificationComplete
                    ? "Completa primero la clasificacion presupuestal."
                    : IsSelectedLocked ? "La requisicion esta en cotizacion." : null,
                ExecuteAsync = AddPartida
            },
            new()
            {
                Id = "select-partida",
                Label = "Selecciona una partida",
                Icon = Icons.Material.Filled.TouchApp,
                Color = Color.Warning,
                Order = 25,
                IsPrimary = primaryActionId == "select-partida",
                Visible = hasPartidas && !hasDetalles && SelectedPartida == null,
                Enabled = false,
                DisabledReason = "Selecciona una fila en la tabla Partidas para continuar."
            },
            new()
            {
                Id = "add-detail",
                Label = "Agregar bien o servicio",
                Icon = Icons.Material.Filled.AddShoppingCart,
                Color = Color.Success,
                Order = 30,
                IsPrimary = primaryActionId == "add-detail",
                Visible = CanCreate,
                Enabled = classificationComplete && SelectedPartida != null && !IsSelectedLocked,
                DisabledReason = SelectedPartida == null
                    ? "Selecciona primero una partida."
                    : IsSelectedLocked ? "La requisicion esta en cotizacion." : null,
                ExecuteAsync = AddDetalle
            },
            new()
            {
                Id = "quote",
                Label = "Generar cotizacion",
                Icon = Icons.Material.Filled.RequestQuote,
                Color = Color.Success,
                Order = 40,
                IsPrimary = primaryActionId == "quote",
                Visible = CanCreate,
                Enabled = classificationComplete && hasDetalles && !hasCotizacion,
                DisabledReason = GetQuoteDisabledReason(requisicion),
                ExecuteAsync = () => OpenCotizacionFromRequisicion(requisicion)
            },
            new()
            {
                Id = "cotizaciones",
                Label = requisicion.TodosLosDetallesCotizados ? "Ver cotizaciones" : "Completar montos cotizados",
                Icon = Icons.Material.Filled.AttachMoney,
                Color = requisicion.TodosLosDetallesCotizados ? Color.Info : Color.Warning,
                Order = 50,
                IsPrimary = primaryActionId == "cotizaciones",
                Visible = hasCotizacion,
                Enabled = true,
                ExecuteAsync = NavigateToCotizacionesAsync
            },
            new()
            {
                Id = "sufficiency",
                Label = requisicion.TodosLosDetallesEnSuficiencia
                    ? "Suficiencia enviada"
                    : "Enviar a suficiencia",
                Icon = Icons.Material.Filled.RuleFolder,
                Color = Color.Primary,
                Order = 60,
                IsPrimary = primaryActionId == "sufficiency",
                Visible = CanCreate,
                Enabled = hasCotizacion &&
                          requisicion.TodosLosDetallesCotizados &&
                          !requisicion.TodosLosDetallesEnSuficiencia,
                DisabledReason = GetSufficiencyDisabledReason(requisicion),
                ExecuteAsync = () => OpenSolicitudSuficienciaFromRequisicion(requisicion)
            },
            new()
            {
                Id = "export",
                Label = "Exportar requisicion",
                Icon = Icons.Material.Filled.FileDownload,
                Color = Color.Success,
                Order = 70,
                IsPrimary = primaryActionId == "export",
                Visible = CanExport,
                ExecuteAsync = () => ExportSelectedRequisicionToExcel(requisicion)
            }
        };
    }

