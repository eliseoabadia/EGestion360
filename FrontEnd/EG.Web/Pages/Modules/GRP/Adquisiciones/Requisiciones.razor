    private async Task OpenCotizacionFromRequisicion(RequisicionResponse? requisicion)
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear cotizaciones", Severity.Warning);
            return;
        }

        if (requisicion == null)
        {
            Snackbar.Add("Selecciona una requisicion primero.", Severity.Warning);
            return;
        }

        if (!HasCompleteBudgetClassification(requisicion))
        {
            Snackbar.Add("Completa programa, fuente de financiamiento, TG, DI y DG antes de generar la cotizacion.", Severity.Error);
            return;
        }

        if (!HasSelectedAnio())
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (!await RequisicionTieneBienesAsync(requisicion.PkidRequisicion))
        {
            Snackbar.Add("La requisicion debe tener al menos un bien para generar una cotizacion.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AnioId"] = AnioStateService.AnioId!.Value,
            ["RequisicionId"] = requisicion.PkidRequisicion,
            ["RequisicionNombre"] = requisicion.Descripcion
        };

        var dialog = await DialogService.ShowAsync<CotizacionDialog>(
            "Crear Cotizacion",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (SelectedRequisicion?.PkidRequisicion == requisicion.PkidRequisicion)
            {
                await RefreshSelectedRequisicion();
            }
            else if (table != null)
            {
                await table.ReloadData();
            }
        }
    }

    private static bool HasCompleteBudgetClassification(RequisicionResponse item) =>
        item.FkidProgramaPres.HasValue && item.FkidProgramaPres.Value > 0 &&
        item.FkidFuenteFinanciamientoPres.HasValue && item.FkidFuenteFinanciamientoPres.Value > 0 &&
        item.FkidTipoGastoPres.HasValue && item.FkidTipoGastoPres.Value > 0 &&
        item.FkidDigitoIdentificadorPres.HasValue && item.FkidDigitoIdentificadorPres.Value > 0 &&
        item.FkidDestinoGastoPres.HasValue && item.FkidDestinoGastoPres.Value > 0;

    private static string ClassificationText(string? clave, string? descripcion)
    {
        if (string.IsNullOrWhiteSpace(clave) && string.IsNullOrWhiteSpace(descripcion)) return "FALTA";
        return string.IsNullOrWhiteSpace(descripcion) ? clave! : $"{clave} - {descripcion}".Trim(' ', '-');
    }

    private async Task OpenSolicitudSuficienciaFromRequisicion(RequisicionResponse? requisicion)
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear solicitudes", Severity.Warning);
            return;
        }

        if (requisicion == null)
        {
            Snackbar.Add("Selecciona una requisicion primero.", Severity.Warning);
            return;
        }

        if (!HasCompleteBudgetClassification(requisicion))
        {
            Snackbar.Add("No se puede enviar a suficiencia: completa programa, fuente de financiamiento, TG, DI y DG.", Severity.Error);
            return;
        }

        if (!await RequisicionTieneTodosLosBienesCotizadosAsync(requisicion.PkidRequisicion))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["RequisicionId"] = requisicion.PkidRequisicion,
            ["RequisicionNombre"] = requisicion.Descripcion
        };

        var dialog = await DialogService.ShowAsync<SolicitudSuficienciaDialog>(
            "Generar Solicitud Suficiencia",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (SelectedRequisicion?.PkidRequisicion == requisicion.PkidRequisicion)
            {
                await RefreshSelectedRequisicion();
            }
            else if (table != null)
            {
                await table.ReloadData();
            }
        }
    }

    private async Task<bool> RequisicionTieneBienesAsync(int requisicionId)
    {
        var response = await DetalleService.GetAllPaginadoAsync(
            1,
            1,
            "",
            "PkidRequisicionDetalle",
            SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidRequisicionOrco"] = requisicionId });

        return response?.TotalCount > 0;
    }

    private async Task<bool> RequisicionTieneTodosLosBienesCotizadosAsync(int requisicionId)
    {
        var detallesResponse = await DetalleService.GetAllPaginadoAsync(
            1,
            int.MaxValue,
            string.Empty,
            "PkidRequisicionDetalle",
            SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidRequisicionOrco"] = requisicionId });

        var detalles = detallesResponse?.Items?.Where(x => x.Activo).ToList() ?? new List<RequisicionDetalleResponse>();
        if (!detalles.Any())
        {
            Snackbar.Add("La requisicion debe tener al menos un bien para generar la solicitud de suficiencia.", Severity.Warning);
            return false;
        }

        var cotizacionesResponse = await CotizacionDetalleService.GetAllPaginadoAsync(
            1,
            int.MaxValue,
            string.Empty,
            "FkidRequisicionDetalleOrco",
            SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidRequisicionOrco"] = requisicionId });

        var cotizados = cotizacionesResponse?.Items?
            .Where(x => x.Activo && x.PrecioUnitario.GetValueOrDefault() > 0m)
            .Select(x => x.FkidRequisicionDetalleOrco)
            .ToHashSet() ?? new HashSet<int>();

        var pendientes = detalles
            .Where(x => !cotizados.Contains(x.PkidRequisicionDetalle))
            .Select(x => TextOrDash(x.TipoBienDescripcion))
            .Take(4)
            .ToList();

        if (pendientes.Any())
        {
            Snackbar.Add($"Faltan bienes con monto cotizado: {string.Join(", ", pendientes)}.", Severity.Warning);
            return false;
        }

        return true;
    }

