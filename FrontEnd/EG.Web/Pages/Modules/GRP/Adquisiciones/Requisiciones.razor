@page "/Adquisiciones/Requisicion"
@page "/Adquisiciones/Requisicion/{RequisicionId:int}"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using EG.Web.Services
@using MiniExcelLibs
@using MudBlazor
@implements IDisposable
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject HttpClient Http
@inherits BaseCrudPage<RequisicionResponse, RequisicionResponse>

@inject IGenericCrudService<RequisicionPartidaResponse> PartidaService
@inject IGenericCrudService<RequisicionDetalleResponse> DetalleService
@inject IGenericCrudService<CotizacionDetalleResponse> CotizacionDetalleService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        @if (SelectedRequisicion == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Requisiciones"
                            Subtitle="Selecciona una requisicion para administrar sus partidas y detalles"
                            Icon="@Icons.Material.Filled.Assignment"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="RequisicionResponse"
                                  @ref="table"
                                  Title="Lista de Requisiciones"
                                  SearchPlaceholder="Buscar por descripcion, area o solicitante..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="RequisicionResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Ver detalle">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        aria-label="Ver detalle de la requisicion"
                        Color="Color.Info"
                        Size="Size.Small"
                        Disabled="@openingRequisicion"
                        OnClick="@(() => OpenRequisicionDetail(cell.Item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Adquisiciones"
                        SubModulo="Requisicion"
                        Controlador="Requisicion"
                        EntidadId="@cell.Item.PkidRequisicion"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@cell.Item.Descripcion"
                        RegistroDescripcion="@($"Requisicion {cell.Item.PkidRequisicion} | {TextOrDash(cell.Item.AreaNombre)}")" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        aria-label="Editar requisicion"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        Disabled="@IsLocked(cell.Item)"
                        OnClick="@(() => EditItem(cell.Item.PkidRequisicion))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        aria-label="Eliminar requisicion"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        Disabled="@IsLocked(cell.Item)"
                        OnClick="@(() => DeleteItem(cell.Item.PkidRequisicion))" />
                        </MudTooltip>
                        <MudTooltip Text="Generar cotizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                        aria-label="Generar cotizacion"
                        Visible="@CanCreate"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="@(() => OpenCotizacionFromRequisicion(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Enviar a suficiencia y autorizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.RuleFolder"
                        aria-label="Enviar a suficiencia y autorizacion"
                        Visible="@CanCreate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => OpenSolicitudSuficienciaFromRequisicion(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="ID" Identifier="PkidRequisicion" PropertyName="PkidRequisicion" SortBy="x => x.PkidRequisicion">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidRequisicion
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Descripcion" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        @cell.Item.Descripcion
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Area" Identifier="AreaNombre" PropertyName="AreaNombre" SortBy="x => x.AreaNombre">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.AreaNombre)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Solicitante" Identifier="SolicitanteCompleto" PropertyName="SolicitanteCompleto" SortBy="x => x.SolicitanteCompleto">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.SolicitanteCompleto)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Fecha" Identifier="FechaRequisicion" PropertyName="FechaRequisicion" SortBy="x => x.FechaRequisicion">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaRequisicion.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Importe" Identifier="Importe" PropertyName="Importe" SortBy="x => x.Importe">
                    <CellTemplate Context="cell">
                        @MoneyOrDash(cell.Item.Importe)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Tipo" Identifier="Servicio" PropertyName="Servicio" SortBy="x => x.Servicio">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="@(cell.Item.Servicio ? Color.Info : Color.Primary)" Size="Size.Small">
                        @(cell.Item.Servicio ? "Servicio" : "Bien")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Clasificacion" Identifier="__column_8" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div>FF: @ClassificationText(cell.Item.FuenteFinanciamientoClave, cell.Item.FuenteFinanciamientoDescripcion)</div>
                        <div>TG: @ClassificationText(cell.Item.TipoGastoClave?.ToString(), cell.Item.TipoGastoDescripcion)</div>
                        <div>DI: @ClassificationText(cell.Item.DigitoIdentificadorClave, cell.Item.DigitoIdentificadorDescripcion)</div>
                        <div>DG: @ClassificationText(cell.Item.DestinoGastoClave, cell.Item.DestinoGastoDescripcion)</div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionResponse" Title="Flujo" Identifier="__column_9" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string"
                        Color="@(IsLocked(cell.Item) ? Color.Warning : Color.Success)"
                        Variant="Variant.Outlined"
                        Size="Size.Small">
                        @(IsLocked(cell.Item) ? $"En cotizacion ({cell.Item.CotizacionesActivas})" : "Libre")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div @key="SelectedRequisicion.PkidRequisicion" Class="d-flex flex-column" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background: transparent; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="BackToTable"
                                   Tooltip="Volver al listado" />
                    <MudText Typo="Typo.h6" Style="font-weight: 600;" Class="ml-2">
                        @SelectedRequisicion.Descripcion
                    </MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedRequisicion.Activo ? Color.Success : Color.Error)">
                        @(SelectedRequisicion.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(IsSelectedLocked ? Color.Warning : Color.Success)"
                             Variant="Variant.Outlined"
                             Class="ml-1">
                        @(IsSelectedLocked ? $"En cotizacion ({SelectedRequisicion.CotizacionesActivas})" : "Libre")
                    </MudChip>
                    <MudTooltip Text="Editar requisicion">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       Disabled="@IsSelectedLocked"
                                       OnClick="@(() => EditItem(SelectedRequisicion.PkidRequisicion))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <DocumentSupportButton Modulo="Adquisiciones"
                                           SubModulo="Requisicion"
                                           Controlador="Requisicion"
                                           EntidadId="@SelectedRequisicion.PkidRequisicion"
                                           FkidEmpresaSis="@SelectedRequisicion.FkidEmpresaSis"
                                           RegistroTitulo="@SelectedRequisicion.Descripcion"
                                           RegistroDescripcion="@($"Requisicion {SelectedRequisicion.PkidRequisicion} | {TextOrDash(SelectedRequisicion.AreaNombre)}")" />
                    <MudTooltip Text="Agregar partida">
                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       Disabled="@IsSelectedLocked"
                                       OnClick="AddPartida"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar detalle">
                        <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       Disabled="@(SelectedPartida == null || IsSelectedLocked)"
                                       OnClick="AddDetalle"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Generar cotizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="@(() => OpenCotizacionFromRequisicion(SelectedRequisicion))"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Enviar a suficiencia y autorizacion">
                        <MudIconButton Icon="@Icons.Material.Filled.RuleFolder"
                                       aria-label="Enviar a suficiencia y autorizacion"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="@(() => OpenSolicitudSuficienciaFromRequisicion(SelectedRequisicion))"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudCard Elevation="1" Style="flex-shrink: 0;">
                    <MudCardContent Style="padding: 8px 12px;">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Area</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.AreaNombre)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Solicitante</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.SolicitanteCompleto)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@SelectedRequisicion.FechaRequisicion.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Importe</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@MoneyOrDash(SelectedRequisicion.Importe)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Tipo</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(SelectedRequisicion.Servicio ? Color.Info : Color.Primary)">
                                    @(SelectedRequisicion.Servicio ? "Servicio" : "Bien")
                                </MudChip>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Programa</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.ProgramaDescripcion)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fuente financiamiento</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.FuenteFinanciamientoDescripcion)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Clasificacion presupuestal</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                    TG @ClassificationText(SelectedRequisicion.TipoGastoClave?.ToString(), SelectedRequisicion.TipoGastoDescripcion) ·
                                    DI @ClassificationText(SelectedRequisicion.DigitoIdentificadorClave, SelectedRequisicion.DigitoIdentificadorDescripcion) ·
                                    DG @ClassificationText(SelectedRequisicion.DestinoGastoClave, SelectedRequisicion.DestinoGastoDescripcion)
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Oficio</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@TextOrDash(SelectedRequisicion.Oficio)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <MudGrid Spacing="2" Class="flex-grow-1" Style="overflow: hidden; min-height: 0;">
                    <MudItem xs="12" lg="5" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericDataGrid TItem="RequisicionPartidaResponse"
                                      @ref="partidaTable"
                                      Title="Partidas"
                                      SearchPlaceholder="Buscar partida..."
                                      ShowExportButton="false"
                                      ShowAddButton="@(CanCreate && !IsSelectedLocked)"
                                      PageSize="5"
                                      ServerDataFunc="LoadPartidasServerData"
                                      SearchString="@partidaSearchString"
                                      SearchStringChanged="(s) => partidaSearchString = s"
                                      OnSearch="ReloadPartidas"
                                      OnAdd="AddPartida">
            <Columns>
                <TemplateColumn T="RequisicionPartidaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Seleccionar cell.Item">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        Color="@(IsSelectedPartida(cell.Item) ? Color.Success : Color.Info)"
                        Size="Size.Small"
                        OnClick="@(() => SelectPartida(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar cell.Item">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        Disabled="@IsSelectedLocked"
                        OnClick="@(() => EditPartida(cell.Item.PkidRequisicionPartida))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar cell.Item">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        Disabled="@IsSelectedLocked"
                        OnClick="@(() => DeletePartida(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionPartidaResponse" Title="Clave" Identifier="PartidaClave" PropertyName="PartidaClave" SortBy="x => x.PartidaClave">
                    <CellTemplate Context="cell">
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(IsSelectedPartida(cell.Item) ? Color.Success : Color.Primary)">
                        @TextOrDash(cell.Item.PartidaClave)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionPartidaResponse" Title="Partida" Identifier="PartidaDescripcion" PropertyName="PartidaDescripcion" SortBy="x => x.PartidaDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.PartidaDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionPartidaResponse" Title="Monto" Identifier="Monto" PropertyName="Monto" SortBy="x => x.Monto">
                    <CellTemplate Context="cell">
                        @MoneyOrDash(cell.Item.Monto)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                    </MudItem>

                    <MudItem xs="12" lg="7" Class="d-flex flex-column" Style="min-height: 0;">
                        <GenericDataGrid TItem="RequisicionDetalleResponse"
                                      @ref="detalleTable"
                                      Title="@DetalleTableTitle"
                                      SearchPlaceholder="Buscar bien o servicio..."
                                      ShowExportButton="false"
                                      ShowAddButton="@(CanCreate && SelectedPartida != null && !IsSelectedLocked)"
                                      AddButtonTooltip="Agregar bien a la requisicion"
                                      AddButtonIcon="@Icons.Material.Filled.AddShoppingCart"
                                      PageSize="5"
                                      ServerDataFunc="LoadDetallesServerData"
                                      SearchString="@detalleSearchString"
                                      SearchStringChanged="(s) => detalleSearchString = s"
                                      OnSearch="ReloadDetalles"
                                      OnAdd="AddDetalle">
            <Columns>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Editar cell.Item">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        Disabled="@IsSelectedLocked"
                        OnClick="@(() => EditDetalle(cell.Item.PkidRequisicionDetalle))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar cell.Item">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        Disabled="@IsSelectedLocked"
                        OnClick="@(() => DeleteDetalle(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Clave" Identifier="TipoBienCodigoClave" PropertyName="TipoBienCodigoClave" SortBy="x => x.TipoBienCodigoClave">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienCodigoClave)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Bien / Servicio" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienDescripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Cantidad" Identifier="Cantidad" PropertyName="Cantidad" SortBy="x => x.Cantidad">
                    <CellTemplate Context="cell">
                        @Quantity(cell.Item.Cantidad)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="RequisicionDetalleResponse" Title="Unidad" Identifier="UnidadMedida" PropertyName="UnidadMedida" SortBy="x => x.UnidadMedida">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.UnidadMedida)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MudContainer>
</AccessVerification>

@code {
    [Parameter] public int? RequisicionId { get; set; }

    private GenericDataGrid<RequisicionResponse> table = null!;
    private GenericDataGrid<RequisicionPartidaResponse>? partidaTable;
    private GenericDataGrid<RequisicionDetalleResponse>? detalleTable;
    private RequisicionResponse? SelectedRequisicion;
    private RequisicionPartidaResponse? SelectedPartida;
    private string partidaSearchString = string.Empty;
    private string detalleSearchString = string.Empty;
    private bool openingRequisicion;
    private int? loadedRequisicionId;
    private string DetalleTableTitle => SelectedPartida == null
        ? "Detalle de Requisicion"
        : $"Detalle de Requisicion - {SelectedPartida.PartidaClave}";
    private bool IsSelectedLocked => IsLocked(SelectedRequisicion);

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "requisicion";

    protected override Type CreateDialogType => typeof(RequisicionDialog);
    protected override Type EditDialogType => typeof(RequisicionDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<RequisicionResponse>);

    protected override string GetDefaultSortLabel() => "PkidRequisicion";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!RequisicionId.HasValue || RequisicionId.Value <= 0)
        {
            ResetRequisicionSelection();
            return;
        }

        if (loadedRequisicionId == RequisicionId.Value &&
            SelectedRequisicion?.PkidRequisicion == RequisicionId.Value)
        {
            return;
        }

        await LoadRequisicionFromRouteAsync(RequisicionId.Value);
    }

    protected override async Task<TableData<RequisicionResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var page = Math.Max(1, state.Page + 1);
            CurrentPage = page;
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            if (!HasSelectedAnio())
            {
                Elements.Clear();
                TotalCount = 0;
                Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
                return new TableData<RequisicionResponse> { Items = Elements, TotalItems = TotalCount };
            }

            var filters = new Dictionary<string, object>
            {
                ["FkidAnioSis"] = AnioStateService.AnioId!.Value
            };

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrEmpty(response?.Message))
                    Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<RequisicionResponse>
            {
                Items = Elements,
                TotalItems = TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<RequisicionResponse>
            {
                Items = new List<RequisicionResponse>(),
                TotalItems = 0
            };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        if (await IsRequisicionLockedAsync(id, "editarla"))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0,
            ["AnioId"] = AnioStateService.AnioId ?? 0
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, $"Editar {SubModuleName}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }

        if (SelectedRequisicion?.PkidRequisicion == id)
        {
            await RefreshSelectedRequisicion();
        }
    }

    protected override async Task DeleteItem(int id)
    {
        if (!CanDelete)
        {
            Snackbar.Add("No tienes permisos para eliminar", Severity.Warning);
            return;
        }

        if (await IsRequisicionLockedAsync(id, "eliminarla"))
        {
            return;
        }

        await base.DeleteItem(id);
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<RequisicionResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidRequisicion,
            item.Descripcion,
            Area = item.AreaNombre,
            Solicitante = item.SolicitanteCompleto,
            Fecha = item.FechaRequisicion.ToString("dd/MM/yyyy"),
            item.Importe,
            Tipo = item.Servicio ? "Servicio" : "Bien",
            FuenteFinanciamiento = ClassificationText(item.FuenteFinanciamientoClave, item.FuenteFinanciamientoDescripcion),
            TipoGasto = ClassificationText(item.TipoGastoClave?.ToString(), item.TipoGastoDescripcion),
            DigitoIdentificador = ClassificationText(item.DigitoIdentificadorClave, item.DigitoIdentificadorDescripcion),
            DestinoGasto = ClassificationText(item.DestinoGastoClave, item.DestinoGastoDescripcion),
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
