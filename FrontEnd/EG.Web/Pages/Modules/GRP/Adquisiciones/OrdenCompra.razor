    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out var userId) || userId <= 0)
            {
                return;
            }

            var response = await UsuarioService.GetByIdAsync(userId);
            if (response?.Success != true || response.Data == null)
            {
                return;
            }

            _currencyId = response.Data.IdMonedaBaseEmpresa;
            _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase)
                ? "$"
                : response.Data.SimboloMonedaBase;
            _currencyName = string.IsNullOrWhiteSpace(response.Data.MonedaBaseEmpresa)
                ? "Peso Mexicano"
                : response.Data.MonedaBaseEmpresa;
        }
        catch
        {
        }
    }

    private static string GetStatusStyle(OrdenCompraResponse item)
    {
        var color = string.IsNullOrWhiteSpace(item.EstatusColor) ? "#E7F0FF" : item.EstatusColor;
        return $"background:{color}; color:#1f2937; font-weight:600;";
    }

    private string GetCurrencyText(OrdenCompraResponse item)
    {
        if (string.IsNullOrWhiteSpace(item.MonedaNombre) && string.IsNullOrWhiteSpace(item.MonedaSimbolo))
        {
            return $"{_currencyName} {_currencySymbol}".Trim();
        }

        return $"{TextOrDash(item.MonedaNombre)} {TextOrDash(item.MonedaSimbolo)}".Trim();
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string Money(decimal value) =>
        $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";

    private static string Quantity(decimal value) =>
        value.ToString("0.00", NumberCulture);

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    public void Dispose()
    {
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }
