    private bool CanAuthorizeItem(OrdenCompraResponse? orden) =>
        orden != null && orden.FkidEstatusOrdenCompraOrco == 1 && orden.TotalDetalles > 0;

    private static bool IsLocked(OrdenCompraResponse? orden) =>
        orden?.PuedeModificar == false;

    private bool CanModifySelectedOrden(string action)
    {
        if (SelectedOrden == null)
        {
            Snackbar.Add("Selecciona una orden de compra primero.", Severity.Warning);
            return false;
        }

        if (!IsSelectedLocked)
        {
            return true;
        }

        Snackbar.Add($"La orden de compra ya fue autorizada. No se puede {action}.", Severity.Warning);
        return false;
    }

    private async Task<bool> IsOrdenLockedAsync(int id, string action)
    {
        var orden = SelectedOrden?.PkidOrdenCompra == id
            ? SelectedOrden
            : Elements.FirstOrDefault(x => x.PkidOrdenCompra == id);

        if (orden == null)
        {
            var response = await Service.GetByIdAsync(id);
            orden = response?.Data;
        }

        if (!IsLocked(orden))
        {
            return false;
        }

        Snackbar.Add($"La orden de compra ya fue autorizada. No se puede {action}.", Severity.Warning);
        return true;
    }

