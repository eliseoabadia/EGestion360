    private async Task AutorizarOrden(OrdenCompraResponse orden)
    {
        if (!CanAuthorize)
        {
            Snackbar.Add("No tienes permisos para autorizar", Severity.Warning);
            return;
        }

        if (!CanAuthorizeItem(orden))
        {
            Snackbar.Add("La orden de compra no esta lista para autorizar.", Severity.Warning);
            return;
        }

        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Autorizar la orden {TextOrDash(orden.NumeroOrdenCompra)}? Ya no podra editarse.");
        if (!confirm)
        {
            return;
        }

        var response = await Http.PostAsync($"api/OrdenCompra/{orden.PkidOrdenCompra}/autorizar", null);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<OrdenCompraResponse>>();

        if (response.IsSuccessStatusCode && result?.Success == true)
        {
            Snackbar.Add("Orden de compra autorizada correctamente", Severity.Success);
            await ReloadData();
            return;
        }

        Snackbar.Add(result?.Message ?? "Error al autorizar la orden de compra", Severity.Error);
    }

