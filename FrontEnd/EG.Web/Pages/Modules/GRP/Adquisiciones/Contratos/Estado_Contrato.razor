@page "/Contratos/Estado_Contrato"
@page "/Adquisiciones/Contratos/Estado_Contrato"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Contratos
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<EstadoContratoResponse, EstadoContratoResponse>
@inject SucursalStateService SucursalStateService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer MaxWidth="MaxWidth.False" Class="contratos-dashboard">
        <PageHeader Title="Estado de Contrato"
                    Subtitle="Seguimiento operativo de contratos presupuestales"
                    Icon="@Icons.Material.Filled.FactCheck"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card metric-primary" Elevation="0">
                    <span>Monto visible</span>
                    <strong>@Money(Elements.Sum(x => x.MontoTotal))</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Contratos</span>
                    <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Bloqueados</span>
                    <strong>@Elements.Count(x => x.EstaAutorizado).ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Entidad</span>
                    <strong>@TextOrDash(SucursalStateService.EmpresaNombre)</strong>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <GenericDataGrid TItem="EstadoContratoResponse"
                      @ref="table"
                      Title="Estados de contrato"
                      SearchPlaceholder="Buscar por contrato, proveedor, requisicion o descripcion..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="EstadoContratoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <DocumentSupportButton Modulo="Contratos"
                        SubModulo="Estado_Contrato"
                        Controlador="EstadoContrato"
                        EntidadId="@cell.Item.PkidContrato"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@TextOrDash(cell.Item.NumeroContrato)"
                        RegistroDescripcion="@($"{TextOrDash(cell.Item.ProveedorNombre)} | {TextOrDash(cell.Item.Descripcion)}")"
                        CanManage="@(!IsLocked(cell.Item))" />
                        <MudTooltip Text="Autorizar contrato">
                        <MudIconButton Icon="@Icons.Material.Filled.Verified"
                        Visible="@CanAuthorize"
                        Disabled="@(!CanAuthorizeItem(cell.Item))"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="@(() => Autorizar(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Liberar remanente y cerrar">
                        <MudIconButton Icon="@Icons.Material.Filled.PriceCheck"
                        Visible="@CanAuthorize"
                        Disabled="@(!CanReleaseItem(cell.Item))"
                        Color="Color.Warning"
                        Size="Size.Small"
                        OnClick="@(() => LiberarRemanente(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar borrador">
                        <MudIconButton Icon="@Icons.Material.Filled.Rule"
                        Visible="@CanUpdate"
                        Disabled="@IsLocked(cell.Item)"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidContrato))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Disabled="@IsLocked(cell.Item)"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidContrato))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Contrato" Identifier="NumeroContrato" PropertyName="NumeroContrato" SortBy="x => x.NumeroContrato">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.NumeroContrato)</div>
                        <span>@TextOrDash(cell.Item.Descripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Proveedor" Identifier="ProveedorNombre" PropertyName="ProveedorNombre" SortBy="x => x.ProveedorNombre">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.ProveedorNombre)</div>
                        <span>@TextOrDash(cell.Item.ProveedorRfc)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Requisicion" Identifier="FkidRequisicionOrco" PropertyName="FkidRequisicionOrco" SortBy="x => x.FkidRequisicionOrco">
                    <CellTemplate Context="cell">
                        @(cell.Item.FkidRequisicionOrco?.ToString() ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Fecha" Identifier="FechaContrato" PropertyName="FechaContrato" SortBy="x => x.FechaContrato">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaContrato.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Monto" Identifier="MontoTotal" PropertyName="MontoTotal" SortBy="x => x.MontoTotal">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.MontoTotal)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="EstadoContratoResponse" Title="Estatus" Identifier="EstatusDescripcion" PropertyName="EstatusDescripcion" SortBy="x => x.EstatusDescripcion">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Style="@GetStatusStyle(cell.Item)" Variant="Variant.Filled">
                        @TextOrDash(cell.Item.EstatusDescripcion)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

<style>
    .contratos-dashboard { min-height: 100%; padding: 12px; display: flex; flex-direction: column; gap: 12px; overflow: visible; }
    .metric-card { min-height: 76px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; background: #ffffff; }
    .metric-card span { color: #64748b; font-size: .78rem; font-weight: 600; text-transform: uppercase; }
    .metric-card strong { color: #111827; font-size: 1.15rem; line-height: 1.4; overflow-wrap: anywhere; }
    .metric-primary { border-left: 4px solid #7c3aed; }
    .main-cell { font-weight: 700; color: #111827; }
    .main-cell + span, .mud-table-cell span { color: #6b7280; font-size: .78rem; }
</style>

@code {
    private GenericDataGrid<EstadoContratoResponse> table = null!;
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private const string CurrencySymbol = "$";

    protected override string ModuleName => "Contratos";
    protected override string SubModuleName => "Estado_Contrato";
    protected override Type CreateDialogType => typeof(EstadoContratoDialog);
    protected override Type EditDialogType => typeof(EstadoContratoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<EstadoContratoResponse>);
    protected override string GetDefaultSortLabel() => "FechaContrato";

    protected override async Task OnInitializedAsync()
    {
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        await SucursalStateService.InitializeAsync();
    }

    protected override async Task CreateItem()
    {
        var parameters = new DialogParameters { ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0 };
        var dialog = await DialogService.ShowAsync(CreateDialogType, "Crear Estado de Contrato", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadData();
    }

    protected override async Task EditItem(int id)
    {
        if (await IsItemLockedAsync(id))
        {
            return;
        }

        var parameters = new DialogParameters { ["Id"] = id, ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0 };
        var dialog = await DialogService.ShowAsync(EditDialogType, "Editar Estado de Contrato", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadData();
    }

    protected override async Task DeleteItem(int id)
    {
        if (await IsItemLockedAsync(id))
        {
            return;
        }

        await base.DeleteItem(id);
    }

    protected override Task<string> GetItemNameForDelete(int id)
    {
        var item = Elements.FirstOrDefault(x => x.PkidContrato == id);
        return Task.FromResult(item?.NumeroContrato ?? "el contrato");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<EstadoContratoResponse> items) => items.Select(x => new
    {
        x.PkidContrato,
        x.NumeroContrato,
        x.Descripcion,
        Proveedor = x.ProveedorNombre,
        Requisicion = x.FkidRequisicionOrco,
        Fecha = x.FechaContrato.ToString("dd/MM/yyyy"),
        x.MontoTotal,
        Estatus = x.EstatusDescripcion,
        x.Observaciones
    });

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async Task<bool> IsItemLockedAsync(int id)
    {
        var item = Elements.FirstOrDefault(x => x.PkidContrato == id);
        if (item == null)
        {
            var response = await Service.GetByIdAsync(id);
            item = response?.Data;
        }

        if (!IsLocked(item))
        {
            return false;
        }

        Snackbar.Add("El contrato ya fue autorizado. No se puede cambiar desde esta pantalla.", Severity.Warning);
        return true;
    }

    private async Task Autorizar(EstadoContratoResponse item)
    {
        if (!CanAuthorizeItem(item))
        {
            Snackbar.Add("El contrato no esta listo para autorizar.", Severity.Warning);
            return;
        }

        if (!await ConfirmWorkflowAsync(
                "Autorizar contrato",
                $"Seguro que deseas autorizar el contrato {TextOrDash(item.NumeroContrato)}? Quedara bloqueado para altas, cambios y bajas.",
                "Autorizar",
                Severity.Success,
                item.PkidContrato))
        {
            return;
        }

        var result = await Service.PostActionAsync($"{item.PkidContrato}/autorizar");
        Snackbar.Add(result?.Message ?? (result?.Success == true ? "Contrato autorizado." : "No fue posible autorizar."), result?.Success == true ? Severity.Success : Severity.Error);
        if (result?.Success == true)
        {
            await ReloadData();
        }
    }

    private async Task LiberarRemanente(EstadoContratoResponse item)
    {
        if (!CanReleaseItem(item))
        {
            Snackbar.Add("Solo se puede liberar remanente de contratos vigentes.", Severity.Warning);
            return;
        }

        if (!await ConfirmWorkflowAsync(
                "Liberar remanente",
                $"Seguro que deseas liberar el remanente y cerrar el contrato {TextOrDash(item.NumeroContrato)}? Se generara la poliza correspondiente.",
                "Liberar",
                Severity.Warning,
                item.PkidContrato))
        {
            return;
        }

        var result = await Service.PostActionAsync($"{item.PkidContrato}/liberar-remanente");
        Snackbar.Add(result?.Message ?? (result?.Success == true ? "Remanente liberado." : "No fue posible liberar el remanente."), result?.Success == true ? Severity.Success : Severity.Error);
        if (result?.Success == true)
        {
            await ReloadData();
        }
    }

    private bool CanAuthorizeItem(EstadoContratoResponse? item) => item != null && CanAuthorize && item.Estatus == 1;
    private bool CanReleaseItem(EstadoContratoResponse? item) => item != null && CanAuthorize && item.Estatus == 2;
    private static bool IsLocked(EstadoContratoResponse? item) => item?.PuedeModificar == false;
    private static string Money(decimal value) => $"{CurrencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string GetStatusStyle(EstadoContratoResponse item) => item.EstaAutorizado
        ? "background:#dcfce7; color:#166534; font-weight:700;"
        : "background:#e0f2fe; color:#075985; font-weight:700;";

    private void OnEmpresaChanged(int empresaId) => _ = InvokeAsync(ReloadData);
    public void Dispose() => SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
}
