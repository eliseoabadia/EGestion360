@page "/Contratos/Saldos_Contratos"
@page "/Adquisiciones/Contratos/Saldos_Contratos"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Contratos
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<SaldosContratoResponse, SaldosContratoResponse>
@inject SucursalStateService SucursalStateService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer MaxWidth="MaxWidth.False" Class="contratos-dashboard">
        <PageHeader Title="Saldos de Contratos"
                    Subtitle="Presupuesto disponible para generar contratos"
                    Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    CanCreate="false"
                    OnRefresh="() => table.ReloadData()" />

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card metric-primary" Elevation="0">
                    <span>Disponible visible</span>
                    <strong>@Money(Elements.Sum(x => x.Total ?? 0m))</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Programas</span>
                    <strong>@Elements.Select(x => x.FkidProgramaPres).Distinct().Count().ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Partidas</span>
                    <strong>@Elements.Select(x => x.FkidPartidaConta).Distinct().Count().ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Registros</span>
                    <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <GenericDataGrid TItem="SaldosContratoResponse"
                      @ref="table"
                      Title="Presupuesto disponible"
                      SearchPlaceholder="Buscar por programa, partida, area, PY o descripcion..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="SaldosContratoResponse" Title="Programa" Identifier="ProgramaClave" PropertyName="ProgramaClave" SortBy="x => x.ProgramaClave">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.ProgramaClave)</div>
                        <span>@TextOrDash(cell.Item.ProgramaDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Partida" Identifier="PartidaClave" PropertyName="PartidaClave" SortBy="x => x.PartidaClave">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.PartidaClave)</div>
                        <span>@TextOrDash(cell.Item.PartidaDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Area" Identifier="AreaNombre" PropertyName="AreaNombre" SortBy="x => x.AreaNombre">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.AreaNombre)</div>
                        <span>@TextOrDash(cell.Item.AreaClave)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Clasificacion" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="stacked-lines">
                        <span>FF: @TextOrDash(cell.Item.FuenteFinanciamientoClaveNombre)</span>
                        <span>TG: @TextOrDash(cell.Item.TipoGastoClaveNombre)</span>
                        <span>DI: @TextOrDash(cell.Item.DigitoIdentificadorClaveNombre)</span>
                        <span>DG: @TextOrDash(cell.Item.DestinoGastoClaveNombre)</span>
                        <span>PY: @TextOrDash(cell.Item.PyClaveNombre)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Descripcion" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Descripcion)</div>
                        <span>@TextOrDash(cell.Item.DescripcionRequisicion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Disponible" Identifier="Total" PropertyName="Total" SortBy="x => x.Total">
                    <CellTemplate Context="cell">
                        <strong>@Money(cell.Item.Total ?? 0m)</strong>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Meses" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="months-line">
                        <span>ENE @Money(cell.Item.Enero ?? 0m)</span>
                        <span>FEB @Money(cell.Item.Febrero ?? 0m)</span>
                        <span>MAR @Money(cell.Item.Marzo ?? 0m)</span>
                        <span>ABR @Money(cell.Item.Abril ?? 0m)</span>
                        <span>MAY @Money(cell.Item.Mayo ?? 0m)</span>
                        <span>JUN @Money(cell.Item.Junio ?? 0m)</span>
                        </div>
                        <div class="months-line">
                        <span>JUL @Money(cell.Item.Julio ?? 0m)</span>
                        <span>AGO @Money(cell.Item.Agosto ?? 0m)</span>
                        <span>SEP @Money(cell.Item.Septiembre ?? 0m)</span>
                        <span>OCT @Money(cell.Item.Octubre ?? 0m)</span>
                        <span>NOV @Money(cell.Item.Noviembre ?? 0m)</span>
                        <span>DIC @Money(cell.Item.Diciembre ?? 0m)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

<style>
    .contratos-dashboard { min-height: 100%; padding: 12px; display: flex; flex-direction: column; gap: 12px; overflow: visible; }
    .metric-card { min-height: 76px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; background: #ffffff; }
    .metric-card span { color: #64748b; font-size: .78rem; font-weight: 600; text-transform: uppercase; }
    .metric-card strong { color: #111827; font-size: 1.1rem; line-height: 1.4; overflow-wrap: anywhere; }
    .metric-primary { border-left: 4px solid #2563eb; }
    .main-cell { font-weight: 700; color: #111827; }
    .main-cell + span { color: #6b7280; font-size: .78rem; }
    .stacked-lines { display: flex; flex-direction: column; gap: 2px; min-width: 220px; }
    .stacked-lines span { color: #475569; font-size: .76rem; }
    .months-line { display: flex; flex-wrap: wrap; gap: 6px; }
    .months-line span { font-size: .72rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 2px 5px; color: #334155; }
</style>

@code {
    private GenericDataGrid<SaldosContratoResponse> table = null!;
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private const string CurrencySymbol = "$";

    protected override string ModuleName => "Contratos";
    protected override string SubModuleName => "Saldos_Contratos";
    protected override Type CreateDialogType => typeof(object);
    protected override Type EditDialogType => typeof(object);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SaldosContratoResponse>);
    protected override string GetDefaultSortLabel() => "ProgramaClave";

    protected override async Task OnInitializedAsync()
    {
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        await SucursalStateService.InitializeAsync();
    }

    protected override Task CreateItem() => Task.CompletedTask;
    protected override Task EditItem(int id) => Task.CompletedTask;
    protected override Task DeleteItem(int id) => Task.CompletedTask;

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SaldosContratoResponse> items) => items.Select(x => new
    {
        x.PkidEgresoAutorizado,
        Anio = x.AnioClave,
        Programa = x.ProgramaClaveNombre,
        Partida = x.PartidaClaveNombre,
        Area = x.AreaNombre,
        Fuente = x.FuenteFinanciamientoClaveNombre,
        TipoGasto = x.TipoGastoClaveNombre,
        Digito = x.DigitoIdentificadorClaveNombre,
        Destino = x.DestinoGastoClaveNombre,
        PY = x.PyClaveNombre,
        x.Descripcion,
        Fecha = x.Fecha.ToString("dd/MM/yyyy"),
        x.Enero,
        x.Febrero,
        x.Marzo,
        x.Abril,
        x.Mayo,
        x.Junio,
        x.Julio,
        x.Agosto,
        x.Septiembre,
        x.Octubre,
        x.Noviembre,
        x.Diciembre,
        Disponible = x.Total
    });

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private static string Money(decimal value) => $"{CurrencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private void OnEmpresaChanged(int empresaId) => _ = InvokeAsync(ReloadData);
    public void Dispose() => SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
}
