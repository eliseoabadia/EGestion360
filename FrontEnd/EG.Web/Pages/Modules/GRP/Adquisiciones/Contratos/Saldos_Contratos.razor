@page "/Contratos/Saldos_Contratos"
@page "/Adquisiciones/Contratos/Saldos_Contratos"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Contratos
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<SaldosContratoResponse, SaldosContratoResponse>
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer MaxWidth="MaxWidth.False" Class="contratos-dashboard">
        <PageHeader Title="Saldos de Contratos"
                    Subtitle="Comprometido no devengado por contrato y mes"
                    Icon="@Icons.Material.Filled.AccountBalanceWallet"
                    CanCreate="false"
                    OnRefresh="() => table.ReloadData()" />

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card metric-primary" Elevation="0">
                    <span>Saldo visible</span>
                    <strong>@Money(Elements.Sum(x => x.Total ?? 0m))</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Contratado</span>
                    <strong>@Money(Elements.Sum(x => x.TotalContratado))</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Devengado</span>
                    <strong>@Money(Elements.Sum(x => x.TotalDevengado))</strong>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="metric-card" Elevation="0">
                    <span>Registros</span>
                    <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <GenericDataGrid TItem="SaldosContratoResponse"
                      @ref="table"
                      Title="Contratos con saldo por devengar"
                      SearchPlaceholder="Buscar por contrato, requisicion, proveedor, poliza o descripcion..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="SaldosContratoResponse" Title="Contrato" Identifier="NumeroContrato" PropertyName="NumeroContrato" SortBy="x => x.NumeroContrato">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.NumeroContrato)</div>
                        <span>@TextOrDash(cell.Item.Descripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Requisicion" Identifier="FkidRequisicionOrco" PropertyName="FkidRequisicionOrco" SortBy="x => x.FkidRequisicionOrco">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@cell.Item.FkidRequisicionOrco</div>
                        <span>@TextOrDash(cell.Item.RequisicionDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Proveedor" Identifier="ProveedorNombre" PropertyName="ProveedorNombre" SortBy="x => x.ProveedorNombre">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.ProveedorNombre)</div>
                        <span>@TextOrDash(cell.Item.ProveedorRfc)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Programa / Poliza" Identifier="ProgramaClave" PropertyName="ProgramaClave" SortBy="x => x.ProgramaClave">
                    <CellTemplate Context="cell">
                        <div class="stacked-lines">
                        <span>Programa: @TextOrDash(cell.Item.ProgramaClave) - @TextOrDash(cell.Item.ProgramaDescripcion)</span>
                        <span>Poliza: @TextOrDash(cell.Item.ClavePoliza)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Importes" Identifier="Total" PropertyName="Total" SortBy="x => x.Total">
                    <CellTemplate Context="cell">
                        <div>Contratado: <strong>@Money(cell.Item.TotalContratado)</strong></div>
                        <div>Devengado: @Money(cell.Item.TotalDevengado)</div>
                        <div>Saldo: <strong>@Money(cell.Item.Total ?? 0m)</strong></div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SaldosContratoResponse" Title="Meses" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="months-line">
                        <span>ENE @Money(cell.Item.Ene)</span><span>FEB @Money(cell.Item.Feb)</span>
                        <span>MAR @Money(cell.Item.Mar)</span><span>ABR @Money(cell.Item.Abr)</span>
                        <span>MAY @Money(cell.Item.May)</span><span>JUN @Money(cell.Item.Jun)</span>
                        </div>
                        <div class="months-line">
                        <span>JUL @Money(cell.Item.Jul)</span><span>AGO @Money(cell.Item.Ago)</span>
                        <span>SEP @Money(cell.Item.Sep)</span><span>OCT @Money(cell.Item.Oct)</span>
                        <span>NOV @Money(cell.Item.Nov)</span><span>DIC @Money(cell.Item.Dic)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

<style>
    .contratos-dashboard { min-height: 100%; padding: 12px; display: flex; flex-direction: column; gap: 12px; overflow: visible; }
    .metric-card { min-height: 76px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; background: #ffffff; }
    .metric-card span { color: #64748b; font-size: .78rem; font-weight: 600; text-transform: uppercase; }
    .metric-card strong { color: #111827; font-size: 1.1rem; line-height: 1.4; overflow-wrap: anywhere; }
    .metric-primary { border-left: 4px solid #2563eb; }
    .main-cell { font-weight: 700; color: #111827; }
    .main-cell + span { color: #6b7280; font-size: .78rem; }
    .stacked-lines { display: flex; flex-direction: column; gap: 2px; min-width: 220px; }
    .stacked-lines span { color: #475569; font-size: .76rem; }
    .months-line { display: flex; flex-wrap: wrap; gap: 6px; }
    .months-line span { font-size: .72rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 2px 5px; color: #334155; }
</style>

@code {
    private GenericDataGrid<SaldosContratoResponse> table = null!;
    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private const string CurrencySymbol = "$";

    protected override string ModuleName => "Contratos";
    protected override string SubModuleName => "Saldos_Contratos";
    protected override Type CreateDialogType => typeof(object);
    protected override Type EditDialogType => typeof(object);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SaldosContratoResponse>);
    protected override string GetDefaultSortLabel() => "NumeroContrato";

    protected override async Task OnInitializedAsync()
    {
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        AnioStateService.OnAnioChanged += OnAnioChanged;
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();
    }

    protected override Task CreateItem() => Task.CompletedTask;
    protected override Task EditItem(int id) => Task.CompletedTask;
    protected override Task DeleteItem(int id) => Task.CompletedTask;

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SaldosContratoResponse> items) => items.Select(x => new
    {
        x.PkidContrato,
        Anio = x.AnioClave,
        x.NumeroContrato,
        x.Descripcion,
        Requisicion = x.FkidRequisicionOrco,
        x.RequisicionDescripcion,
        x.ProveedorNombre,
        x.ProveedorRfc,
        Programa = x.ProgramaClave,
        x.ClavePoliza,
        Fecha = x.FechaContrato.ToString("dd/MM/yyyy"),
        x.Ene, x.Feb, x.Mar, x.Abr, x.May, x.Jun,
        x.Jul, x.Ago, x.Sep, x.Oct, x.Nov, x.Dic,
        x.TotalContratado,
        x.TotalDevengado,
        Saldo = x.Total
    });

    protected override async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    protected override Dictionary<string, object>? GetAdditionalFilters() =>
        AnioStateService.AnioId is > 0
            ? new Dictionary<string, object> { ["FkidAnioSis"] = AnioStateService.AnioId.Value }
            : null;

    private static string Money(decimal value) => $"{CurrencySymbol}{value.ToString("0.00", NumberCulture)}";
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private void OnEmpresaChanged(int empresaId) => _ = InvokeAsync(ReloadData);
    private void OnAnioChanged(int? anioId) => _ = InvokeAsync(ReloadData);
    public void Dispose()
    {
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        AnioStateService.OnAnioChanged -= OnAnioChanged;
    }
}
