@using MudBlazor
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Common.GenericModel
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService

@inject IGenericCrudService<PaaaResponse> Service
@inject IGenericCrudService<OrcoProyectoResponse> proyectoService
@inject IGenericCrudService<FuenteFinanciamientoResponse> fuenteService
@inject IGenericCrudService<ProgramaResponse> programaService
@inject IGenericCrudService<UsuarioAreaResponse> areaService


@inject ISnackbar Snackbar
@inject HttpClient HttpClient

<BaseCrudDialog TItem="PaaaResponse"
Title="@dialogTitle"
MaxWidth="MaxWidth.Medium"
ActionText="@actionText"
ProcessingText="@processingText"
LoadingMessage="Cargando catálogos..."
OnConfirm="GuardarCambiosAsync">

@if (_loading)
{
<div class="d-flex justify-center align-center py-8">
<MudProgressCircular Indeterminate="true" />
<MudText Class="ml-3">Cargando catálogos...</MudText>
</div>
}
else
{
<BaseEntityForm TEntity="PaaaResponse"
@ref="form"
ShowHeader="true"
HeaderTitle="@dialogTitle">

<MudGrid GutterSize="2">
<MudItem xs="12">
<MudTextField @bind-Value="item.Descripcion"
Label="Descripción"
Variant="Variant.Outlined"
Required="true"
RequiredError="La descripción es requerida" />
</MudItem>

<MudItem xs="12" md="6">
<PagedAutocomplete Value="@_selectedArea"
ValueChanged="value => _selectedArea = value"
Label="Área"
Required="true"
RequiredError="El área es requerida"
LoadPage="LoadAreasPageAsync" />
</MudItem>

<MudItem xs="12" md="6">
<PagedAutocomplete Value="@_selectedPersona"
ValueChanged="value => _selectedPersona = value"
Label="Responsable"
Required="true"
LoadPage="LoadPersonasPageAsync" />
</MudItem>

<MudItem xs="12" md="6">
<MudDatePicker @bind-Date="_fecha"
Label="Fecha"
Variant="Variant.Outlined"
Required="true"
RequiredError="La fecha es requerida" />
</MudItem>

<MudItem xs="12" md="6">
<PagedAutocomplete Value="@_selectedProyecto"
ValueChanged="value => _selectedProyecto = value"
Label="Proyecto"
Clearable="true"
LoadPage="LoadProyectosPageAsync" />
</MudItem>

<MudItem xs="12" md="6">
<PagedAutocomplete Value="@_selectedPrograma"
ValueChanged="value => _selectedPrograma = value"
Label="Programa"
Clearable="true"
LoadPage="LoadProgramasPageAsync" />
</MudItem>

<MudItem xs="12">
<PagedAutocomplete Value="@_selectedFuente"
ValueChanged="value => _selectedFuente = value"
Label="Fuente de Financiamiento"
Clearable="true"
LoadPage="LoadFuentesPageAsync" />
</MudItem>

<MudItem xs="12">
<MudTextField @bind-Value="item.Observaciones"
Label="Observaciones"
Variant="Variant.Outlined"
Lines="3" />
</MudItem>

</MudGrid>
</BaseEntityForm>
}
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int FkidPersonaNom { get; set; }
    [Parameter] public int AnioId { get; set; }
    [Parameter] public int EmpresaId { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PaaaResponse> form = null!;
    private PaaaResponse item = new() { Activo = true, Fecha = DateTime.Today };
    private DateTime? _fecha = DateTime.Today;
    private bool _loading = true;

    private LookupItem? _selectedPersona;
    private LookupItem? _selectedProyecto;
    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedFuente;
    private LookupItem? _selectedArea;

    private string dialogTitle => Id.HasValue ? "Editar Programa Anual" : "Nuevo Programa Anual";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();
        if (AnioId <= 0 && AnioStateService.AnioId.HasValue)
            AnioId = AnioStateService.AnioId.Value;

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
        else
        {
            if (FkidPersonaNom > 0)
            {
                item.FkidPersonaNom = FkidPersonaNom;
            }
        }
        _loading = false;
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await areaService.GetAllAsync();
        var items = FilterSolicitantes(response?.Items, filter)
            .Select(x => new LookupItem { Id = x.PkidPersona, Text = GetPersonaText(x) });

        return ToPagedComboResult(items, page, pageSize);
    }

    private async Task<ComboLookupResult> LoadProyectosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await proyectoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidProyecto, Text = x.ClaveNombre }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var anioFilter = GetAnioFilter();
        if (anioFilter == null)
        {
            return new ComboLookupResult();
        }

        var response = await programaService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending, anioFilter);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPrograma, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadFuentesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        // var anioFilter = GetAnioFilter();
        // if (anioFilter == null)
        // {
        //     return new ComboLookupResult();
        // }

        var response = await fuenteService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending, null);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidFuenteFinanciamiento, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadAreasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await areaService.GetAllAsync();
        var items = FilterUsuarioAreas(response?.Items, filter)
            .Select(x => new LookupItem { Id = x.PkidArea, Text = x.UsuarioAreaDescripcion });

        return ToPagedComboResult(items, page, pageSize);
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private Dictionary<string, object>? GetAnioFilter()
    {
        var anioId = AnioId > 0 ? AnioId : AnioStateService.AnioId;
        return anioId.HasValue && anioId.Value > 0
            ? new Dictionary<string, object> { ["FkidAnioSis"] = anioId.Value }
            : null;
    }

    private static IEnumerable<UsuarioAreaResponse> FilterUsuarioAreas(IEnumerable<UsuarioAreaResponse>? items, string filter)
    {
        var query = (items ?? Enumerable.Empty<UsuarioAreaResponse>())
            .Where(x => x.PkidArea > 0);

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x => x.UsuarioAreaDescripcion.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(x => x.UsuarioAreaDescripcion);
    }

    private static IEnumerable<UsuarioAreaResponse> FilterSolicitantes(IEnumerable<UsuarioAreaResponse>? items, string filter)
    {
        var query = (items ?? Enumerable.Empty<UsuarioAreaResponse>())
            .Where(x => x.PkidPersona > 0 && x.EsSolicitante)
            .GroupBy(x => x.PkidPersona)
            .Select(x => x.First());

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x =>
                GetPersonaText(x).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                x.UsuarioAreaDescripcion.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(GetPersonaText);
    }

    private static string GetPersonaText(UsuarioAreaResponse item)
    {
        var nombreCompleto = $"{item.PersonaNombre} {item.PersonaPaterno} {item.PersonaMaterno}".Trim();
        return string.IsNullOrWhiteSpace(nombreCompleto)
            ? item.PkidPersona.ToString()
            : nombreCompleto;
    }

    private static ComboLookupResult ToPagedComboResult(IEnumerable<LookupItem> items, int page, int pageSize)
    {
        var list = items.ToList();
        var currentPage = Math.Max(1, page);
        var currentPageSize = pageSize <= 0 ? 10 : pageSize;

        return new ComboLookupResult
        {
            Items = list.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize).ToList(),
            TotalCount = list.Count
        };
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _fecha = item.Fecha;

                _selectedPersona = new LookupItem { Id = item.FkidPersonaNom, Text = item.ResponsableCompleto };
                _selectedArea = new LookupItem { Id = item.FkidAreaSis, Text = item.AreaNombre };

                if (item.FkidProyectoOrco.HasValue)
                    _selectedProyecto = new LookupItem { Id = item.FkidProyectoOrco.Value, Text = item.ProyectoDescripcion ?? string.Empty };

                if (item.FkidProgramaPres.HasValue)
                    _selectedPrograma = new LookupItem { Id = item.FkidProgramaPres.Value, Text = $"{item.ProgramaClave} - {item.ProgramaDescripcion}" };

                if (item.FkidFuenteFinanciamientoPres.HasValue)
                    _selectedFuente = new LookupItem { Id = item.FkidFuenteFinanciamientoPres.Value, Text = $"{item.FuenteFinanciamientoClave} - {item.FuenteFinanciamientoDescripcion}" };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Por favor, completa todos los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        var anioId = AnioId > 0 ? AnioId : AnioStateService.AnioId;
        if (!anioId.HasValue || anioId <= 0) { Snackbar.Add("Debe seleccionar un año presupuestal en el encabezado.", Severity.Warning); return; }
        item.FkidAnioSis = anioId.Value;

        if (_selectedPersona == null) { Snackbar.Add("Debe seleccionar un responsable válido", Severity.Warning); return; }
        item.FkidPersonaNom = _selectedPersona.Id;

        // Asignar FkidEmpresaSis desde el parámetro
        if (EmpresaId > 0)
        {
            item.FkidEmpresaSis = SucursalStateService.EmpresaId.Value;
        }

        item.FkidProyectoOrco = _selectedProyecto?.Id;

        item.FkidProgramaPres = _selectedPrograma?.Id;

        item.FkidFuenteFinanciamientoPres = _selectedFuente?.Id;

        if (_selectedArea == null) { Snackbar.Add("Debe seleccionar un área válido", Severity.Warning); return; }
        item.FkidAreaSis = _selectedArea.Id;

        if (_fecha.HasValue)
            item.Fecha = _fecha.Value;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(response.Message ?? (Id.HasValue ? "Programa actualizado correctamente" : "Programa creado correctamente"), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Error al guardar el programa", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
