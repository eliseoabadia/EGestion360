@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Domain.DTOs.Responses.Presupuestales
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<RequisicionResponse> Service
@inject IGenericCrudService<PersonaResponse> PersonaService
@inject IGenericCrudService<UsuarioAreaResponse> AreaService
@inject IGenericCrudService<OrcoProyectoResponse> ProyectoService
@inject IGenericCrudService<ProgramaResponse> ProgramaService
@inject IGenericCrudService<FuenteFinanciamientoResponse> FuenteService
@inject HttpClient Http
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="RequisicionResponse"
                Title="@dialogTitle"
                Subtitle="Datos operativos y clasificacion presupuestal de la solicitud."
                TitleIcon="@Icons.Material.Filled.AssignmentTurnedIn"
                MaxWidth="MaxWidth.Large"
                DialogClass="requisicion-dialog crud-dialog-wide-xl"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="RequisicionResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <div class="requisition-form">
            <section class="req-section req-section-main">
                <div class="req-section-heading">
                    <span class="req-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="req-section-title">Datos base</MudText>
                        <MudText Typo="Typo.caption" Class="req-section-subtitle">Identifica la solicitud, responsable y monto estimado.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="item.Descripcion"
                                      Label="Descripcion"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      MaxLength="100"
                                      RequiredError="La descripcion es requerida" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedArea"
                                           ValueChanged="value => _selectedArea = value"
                                           Label="Area"
                                           Required="true"
                                           RequiredError="El area es requerida"
                                           LoadPage="LoadAreasPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedPersona"
                                           ValueChanged="value => _selectedPersona = value"
                                           Label="Solicitante"
                                           Required="true"
                                           RequiredError="El solicitante es requerido"
                                           LoadPage="LoadPersonasPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker @bind-Date="_fechaRequisicion"
                                       Label="Fecha requisicion"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="La fecha es requerida" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="item.Importe"
                                         Label="Importe"
                                         Variant="Variant.Outlined"
                                         Format="0.00"
                                         Culture="@NumberCulture"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <div class="req-toggle-card">
                            <span class="req-toggle-icon" aria-hidden="true">
                                <MudIcon Icon="@(item.Servicio ? Icons.Material.Filled.DesignServices : Icons.Material.Filled.Inventory2)" Size="Size.Small" />
                            </span>
                            <div class="req-toggle-copy">
                                <span>Tipo</span>
                                <strong>@(item.Servicio ? "Servicio" : "Bien")</strong>
                            </div>
                            <MudSwitch T="bool" @bind-Value="item.Servicio" Label="Servicio" Color="Color.Primary" />
                        </div>
                    </MudItem>
                </MudGrid>
            </section>

            <section class="req-section req-section-budget">
                <div class="req-section-heading">
                    <span class="req-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="req-section-title">Clasificacion presupuestal</MudText>
                        <MudText Typo="Typo.caption" Class="req-section-subtitle">Programa, fuente y claves de gasto que completan el flujo.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedProyecto"
                                           ValueChanged="value => _selectedProyecto = value"
                                           Label="Proyecto"
                                           Clearable="true"
                                           LoadPage="LoadProyectosPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedPrograma"
                                           ValueChanged="value => _selectedPrograma = value"
                                           Label="Programa"
                                           Clearable="true"
                                           LoadPage="LoadProgramasPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedFuente"
                                           ValueChanged="value => _selectedFuente = value"
                                           Label="Fuente de financiamiento"
                                           Required="true"
                                           LoadPage="LoadFuentesPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedTipoGasto"
                                           ValueChanged="value => _selectedTipoGasto = value"
                                           Label="Tipo de gasto (TG)"
                                           Required="true"
                                           LoadPage="LoadTiposGastoPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedDigito"
                                           ValueChanged="value => _selectedDigito = value"
                                           Label="Digito identificador (DI)"
                                           Required="true"
                                           LoadPage="LoadDigitosPageAsync" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <PagedAutocomplete Value="@_selectedDestino"
                                           ValueChanged="value => _selectedDestino = value"
                                           Label="Destino del gasto (DG)"
                                           Required="true"
                                           LoadPage="LoadDestinosPageAsync" />
                    </MudItem>

                    @if (_selectedTipoGasto?.Text.StartsWith("1", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true" Class="req-alert">
                                TG 1 es gasto corriente y se atendera en la cola prioritaria. La prioridad no modifica su clasificacion contable.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </section>

            <section class="req-section req-section-notes">
                <div class="req-section-heading">
                    <span class="req-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="req-section-title">Oficio y notas</MudText>
                        <MudText Typo="Typo.caption" Class="req-section-subtitle">Referencia documental y observaciones internas.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="item.Oficio"
                                      Label="Oficio"
                                      Variant="Variant.Outlined"
                                      MaxLength="120" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="item.FechaOficio"
                                       Label="Fecha oficio"
                                       Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="item.Observaciones"
                                      Label="Observaciones"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      MaxLength="1000" />
                    </MudItem>
                </MudGrid>
            </section>
        </div>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public int EmpresaId { get; set; }
    [Parameter] public int AnioId { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<RequisicionResponse> form = null!;
    private RequisicionResponse item = new()
    {
        Activo = true,
        FechaRequisicion = DateTime.Today,
        FechaOficio = DateTime.Today,
        FlFoto = string.Empty,
        Observaciones = string.Empty,
        Oficio = string.Empty
    };
    private DateTime? _fechaRequisicion = DateTime.Today;

    private LookupItem? _selectedPersona;
    private LookupItem? _selectedArea;
    private LookupItem? _selectedProyecto;
    private LookupItem? _selectedPrograma;
    private LookupItem? _selectedFuente;
    private LookupItem? _selectedTipoGasto;
    private LookupItem? _selectedDigito;
    private LookupItem? _selectedDestino;

    private string dialogTitle => Id.HasValue ? "Editar Requisicion" : "Nueva Requisicion";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    protected override async Task OnInitializedAsync()
    {
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();

        if (Id.HasValue)
        {
            await CargarDatosAsync();
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _fechaRequisicion = item.FechaRequisicion;
                _selectedPersona = new LookupItem { Id = item.FkidPersonaNom, Text = TextOrDefault(item.SolicitanteCompleto, item.FkidPersonaNom) };
                _selectedArea = new LookupItem { Id = item.FkidAreaSis, Text = TextOrDefault(item.AreaNombre, item.FkidAreaSis) };

                if (item.FkidProyectoOrco.HasValue)
                {
                    _selectedProyecto = new LookupItem { Id = item.FkidProyectoOrco.Value, Text = item.ProyectoDescripcion ?? string.Empty };
                }

                if (item.FkidProgramaPres.HasValue)
                {
                    _selectedPrograma = new LookupItem { Id = item.FkidProgramaPres.Value, Text = $"{item.ProgramaClave} - {item.ProgramaDescripcion}".Trim(' ', '-') };
                }

                if (item.FkidFuenteFinanciamientoPres.HasValue)
                {
                    _selectedFuente = new LookupItem { Id = item.FkidFuenteFinanciamientoPres.Value, Text = $"{item.FuenteFinanciamientoClave} - {item.FuenteFinanciamientoDescripcion}".Trim(' ', '-') };
                }

                _selectedTipoGasto = BuildLookup(item.FkidTipoGastoPres, $"{item.TipoGastoClave} - {item.TipoGastoDescripcion}");
                _selectedDigito = BuildLookup(item.FkidDigitoIdentificadorPres, $"{item.DigitoIdentificadorClave} - {item.DigitoIdentificadorDescripcion}");
                _selectedDestino = BuildLookup(item.FkidDestinoGastoPres, $"{item.DestinoGastoClave} - {item.DestinoGastoDescripcion}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        var empresaId = EmpresaId > 0 ? EmpresaId : SucursalStateService.EmpresaId;
        if (!empresaId.HasValue || empresaId.Value <= 0)
        {
            Snackbar.Add("Debe existir una empresa seleccionada.", Severity.Warning);
            return;
        }

        if (_selectedArea == null)
        {
            Snackbar.Add("Debe seleccionar un area.", Severity.Warning);
            return;
        }

        if (_selectedPersona == null)
        {
            Snackbar.Add("Debe seleccionar un solicitante.", Severity.Warning);
            return;
        }

        if (_selectedPrograma == null || _selectedFuente == null || _selectedTipoGasto == null ||
            _selectedDigito == null || _selectedDestino == null)
        {
            Snackbar.Add("Selecciona la clasificacion presupuestaria completa: programa, FF, TG, DI y DG.", Severity.Warning);
            return;
        }

        item.FkidEmpresaSis = empresaId.Value;
        if (!AnioStateService.AnioId.HasValue || AnioStateService.AnioId.Value <= 0)
        {
            Snackbar.Add("Debe seleccionar un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        item.FkidAnioSis = AnioStateService.AnioId.Value;
        item.FkidAreaSis = _selectedArea.Id;
        item.FkidPersonaNom = _selectedPersona.Id;
        item.FkidProyectoOrco = _selectedProyecto?.Id;
        item.FkidProgramaPres = _selectedPrograma?.Id;
        item.FkidFuenteFinanciamientoPres = _selectedFuente?.Id;
        item.FkidTipoGastoPres = _selectedTipoGasto.Id;
        item.FkidDigitoIdentificadorPres = _selectedDigito.Id;
        item.FkidDestinoGastoPres = _selectedDestino.Id;
        item.FechaRequisicion = _fechaRequisicion ?? DateTime.Today;
        item.Observaciones ??= string.Empty;
        item.FlFoto ??= string.Empty;
        item.Oficio ??= string.Empty;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(Id.HasValue ? "Requisicion actualizada correctamente" : "Requisicion creada correctamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar la requisicion", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadPersonasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await PersonaService.GetAllPaginadoAsync(page, pageSize, filter, "Nombre", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPersona, Text = $"{x.Nombre} {x.Paterno} {x.Materno}".Trim() }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadAreasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await AreaService.GetAllAsync();
        var items = FilterUsuarioAreas(response?.Items, filter)
            .Select(x => new LookupItem { Id = x.PkidArea, Text = x.UsuarioAreaDescripcion });

        return ToPagedComboResult(items, page, pageSize);
    }

    private async Task<ComboLookupResult> LoadProyectosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await ProyectoService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidProyecto, Text = x.ClaveNombre }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadProgramasPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var anioFilter = GetAnioFilter();
        if (anioFilter == null)
        {
            return new ComboLookupResult();
        }

        var response = await ProgramaService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending, anioFilter);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidPrograma, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private async Task<ComboLookupResult> LoadFuentesPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await FuenteService.GetAllPaginadoAsync(page, pageSize, filter, "Clave", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidFuenteFinanciamiento, Text = $"{x.Clave} - {x.Descripcion}" }), response?.TotalCount);
    }

    private Task<ComboLookupResult> LoadTiposGastoPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadHttpLookupPageAsync("api/EgresoProyectado/GetTipoGastoLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadDigitosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadHttpLookupPageAsync("api/EgresoProyectado/GetDigitoIdentificadorLookupPaginado", page, pageSize, filter, ct);

    private Task<ComboLookupResult> LoadDestinosPageAsync(int page, int pageSize, string filter, CancellationToken ct)
        => LoadHttpLookupPageAsync("api/EgresoProyectado/GetDestinoGastoLookupPaginado", page, pageSize, filter, ct);

    private async Task<ComboLookupResult> LoadHttpLookupPageAsync(
        string url, int page, int pageSize, string filter, CancellationToken ct)
    {
        var requestUrl = $"{url}?page={page}&pageSize={pageSize}&filter={Uri.EscapeDataString(filter ?? string.Empty)}";
        return await Http.GetFromJsonAsync<ComboLookupResult>(requestUrl, ct) ?? new ComboLookupResult();
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private Dictionary<string, object>? GetAnioFilter()
    {
        var anioId = AnioId > 0 ? AnioId : AnioStateService.AnioId;
        return anioId.HasValue && anioId.Value > 0
            ? new Dictionary<string, object> { ["FkidAnioSis"] = anioId.Value }
            : null;
    }

    private static IEnumerable<UsuarioAreaResponse> FilterUsuarioAreas(IEnumerable<UsuarioAreaResponse>? items, string filter)
    {
        var query = (items ?? Enumerable.Empty<UsuarioAreaResponse>())
            .Where(x => x.PkidArea > 0);

        if (!string.IsNullOrWhiteSpace(filter))
        {
            query = query.Where(x => x.UsuarioAreaDescripcion.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(x => x.UsuarioAreaDescripcion);
    }

    private static ComboLookupResult ToPagedComboResult(IEnumerable<LookupItem> items, int page, int pageSize)
    {
        var list = items.ToList();
        var currentPage = Math.Max(1, page);
        var currentPageSize = pageSize <= 0 ? 10 : pageSize;

        return new ComboLookupResult
        {
            Items = list.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize).ToList(),
            TotalCount = list.Count
        };
    }

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) ? id.ToString() : text;

    private static LookupItem? BuildLookup(int? id, string? text)
    {
        if (!id.HasValue || id.Value <= 0)
            return null;

        var normalizedText = (text ?? string.Empty).Trim(' ', '-');
        return new LookupItem { Id = id.Value, Text = string.IsNullOrWhiteSpace(normalizedText) ? id.Value.ToString() : normalizedText };
    }

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
}
