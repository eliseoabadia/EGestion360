@page "/Adquisiciones/Solicitud_Suficiencia"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<SolicitudSuficienciaResponse, SolicitudSuficienciaResponse>

@inject IGenericCrudService<SolicitudSuficienciaDetalleResponse> DetalleService
@inject AnioPresupuestalStateService AnioStateService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column solicitud-suficiencia-page" MaxWidth="MaxWidth.False" Style="height: 100%; min-height: 0; overflow: auto;">
        @if (SelectedSolicitud == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Solicitud Suficiencia"
                            Subtitle="Generacion y seguimiento presupuestal desde requisiciones cotizadas"
                            Icon="@Icons.Material.Filled.RuleFolder"
                            CanCreate="@CanCreate"
                            CreateTooltip="Generar solicitud"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div class="summary-strip">
                    <div>
                        <span>Solicitudes</span>
                        <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
                    </div>
                    <div>
                        <span>Activas en pagina</span>
                        <strong>@Elements.Count(x => x.Activo).ToString("N0", NumberCulture)</strong>
                    </div>
                    <div>
                        <span>Borrador</span>
                        <strong>@Elements.Count(x => x.Estatus == 1).ToString("N0", NumberCulture)</strong>
                    </div>
                </div>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="SolicitudSuficienciaResponse"
                                  @ref="table"
                                  Title="Solicitudes de suficiencia"
                                  SearchPlaceholder="Buscar requisicion, justificacion o estatus..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Ver detalle">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => SelectSolicitud(cell.Item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Adquisiciones"
                        SubModulo="Solicitud_Suficiencia"
                        Controlador="SolicitudSuficiencia"
                        EntidadId="@cell.Item.PkidSolicitudSuficiencia"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@($"Solicitud {cell.Item.PkidSolicitudSuficiencia}")"
                        RegistroDescripcion="@TextOrDash(cell.Item.RequisicionDescripcion)" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@(CanUpdate && !cell.Item.BloqueadaPorAutorizacion)"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidSolicitudSuficiencia))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@(CanDelete && !cell.Item.BloqueadaPorAutorizacion)"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidSolicitudSuficiencia))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="ID" Identifier="PkidSolicitudSuficiencia" PropertyName="PkidSolicitudSuficiencia" SortBy="x => x.PkidSolicitudSuficiencia">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="Color.Tertiary" Size="Size.Small">@cell.Item.PkidSolicitudSuficiencia</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="Requisicion" Identifier="RequisicionDescripcion" PropertyName="RequisicionDescripcion" SortBy="x => x.RequisicionDescripcion">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Class="main-cell">@TextOrDash(cell.Item.RequisicionDescripcion)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.EmpresaNombre)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="Solicitud" Identifier="FechaSolicitud" PropertyName="FechaSolicitud" SortBy="x => x.FechaSolicitud">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaSolicitud.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="Requisicion fecha" Identifier="FechaRequisicion" PropertyName="FechaRequisicion" SortBy="x => x.FechaRequisicion">
                    <CellTemplate Context="cell">
                        @DateOrDash(cell.Item.FechaRequisicion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaResponse" Title="Estatus" Identifier="Estatus" PropertyName="Estatus" SortBy="x => x.Estatus">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="@EstatusColor(cell.Item.Estatus)" Size="Size.Small">
                        @TextOrDash(cell.Item.EstatusDescripcion)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column detail-layout" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="selected-header">
                    <div class="selected-title">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                       OnClick="BackToTable"
                                       Tooltip="Volver al listado" />
                        <div>
                            <MudText Typo="Typo.h6" Class="selected-name">@TextOrDash(SelectedSolicitud.RequisicionDescripcion)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Solicitud @SelectedSolicitud.PkidSolicitudSuficiencia | @SelectedSolicitud.FechaSolicitud.ToString("dd/MM/yyyy")</MudText>
                        </div>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Color="@EstatusColor(SelectedSolicitud.Estatus)" Size="Size.Small">
                        @TextOrDash(SelectedSolicitud.EstatusDescripcion)
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">
                        @Money(TotalSeleccionado)
                    </MudChip>
                    <MudTooltip Text="Editar solicitud">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="@(() => EditItem(SelectedSolicitud.PkidSolicitudSuficiencia))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <DocumentSupportButton Modulo="Adquisiciones"
                                           SubModulo="Solicitud_Suficiencia"
                                           Controlador="SolicitudSuficiencia"
                                           EntidadId="@SelectedSolicitud.PkidSolicitudSuficiencia"
                                           FkidEmpresaSis="@SelectedSolicitud.FkidEmpresaSis"
                                           RegistroTitulo="@($"Solicitud {SelectedSolicitud.PkidSolicitudSuficiencia}")"
                                           RegistroDescripcion="@TextOrDash(SelectedSolicitud.RequisicionDescripcion)" />
                    <MudTooltip Text="Actualizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="RefreshSelectedAndDetails"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudPaper Elevation="1" Class="summary-panel">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha requisicion</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@DateOrDash(SelectedSolicitud.FechaRequisicion)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Mes aplicado</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@MesAplicado</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Bienes</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@SelectedDetalles.Count.ToString("N0", NumberCulture)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Partidas</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@PartidaResumenes.Count().ToString("N0", NumberCulture)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Total solicitado</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@Money(TotalSeleccionado)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="9" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Creacion</MudText>
                            <MudText Typo="Typo.body2" Class="metric">@DateTimeOrDash(SelectedSolicitud.FechaCreacion)</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (PartidaResumenes.Any())
                {
                    <div class="partida-strip">
                        @foreach (var partida in PartidaResumenes)
                        {
                            <div>
                                <span>@TextOrDash(partida.Partida)</span>
                                <strong>@Money(partida.Total)</strong>
                                <small>@partida.Bienes.ToString("N0", NumberCulture) bienes</small>
                            </div>
                        }
                    </div>
                }

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="SolicitudSuficienciaDetalleResponse"
                                  @ref="detalleTable"
                                  Title="Detalle por bien y partida"
                                  SearchPlaceholder="Buscar partida o bien..."
                                  ShowExportButton="false"
                                  PageSize="10"
                                  ServerDataFunc="LoadDetallesServerData"
                                  SearchString="@detalleSearchString"
                                  SearchStringChanged="(s) => detalleSearchString = s"
                                  OnSearch="ReloadDetalles">
            <Columns>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Partida" Identifier="PartidaClave" PropertyName="PartidaClave" SortBy="x => x.PartidaClave">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.PartidaClaveNombre)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Clave" Identifier="TipoBienClave" PropertyName="TipoBienClave" SortBy="x => x.TipoBienClave">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoBienClave)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Class="main-cell">@TextOrDash(cell.Item.TipoBienDescripcion)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.Observaciones)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Cantidad" Identifier="Cantidad" PropertyName="Cantidad" SortBy="x => x.Cantidad">
                    <CellTemplate Context="cell">
                        @Quantity(cell.Item.Cantidad)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Mes" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @MesConMonto(cell.Item)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSuficienciaDetalleResponse" Title="Total" Identifier="Total" PropertyName="Total" SortBy="x => x.Total">
                    <CellTemplate Context="cell">
                        <strong>@Money(DetalleTotal(cell.Item))</strong>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
    </MudContainer>
</AccessVerification>

<style>
    .solicitud-suficiencia-page .summary-strip,
    .solicitud-suficiencia-page .partida-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 10px;
        flex-shrink: 0;
    }

    .solicitud-suficiencia-page .summary-strip > div,
    .solicitud-suficiencia-page .partida-strip > div,
    .solicitud-suficiencia-page .summary-panel {
        border: 1px solid color-mix(in srgb, var(--eg-primary) 30%, var(--mud-palette-lines-default));
        border-radius: 8px;
        background: color-mix(in srgb, var(--eg-primary) 7%, var(--mud-palette-surface));
    }

    .solicitud-suficiencia-page .summary-strip > div,
    .solicitud-suficiencia-page .partida-strip > div {
        padding: 8px 10px;
    }

    .solicitud-suficiencia-page .summary-strip span,
    .solicitud-suficiencia-page .partida-strip span,
    .solicitud-suficiencia-page .partida-strip small {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .72rem;
        text-transform: uppercase;
    }

    .solicitud-suficiencia-page .summary-strip strong,
    .solicitud-suficiencia-page .partida-strip strong,
    .solicitud-suficiencia-page .metric,
    .solicitud-suficiencia-page .main-cell,
    .solicitud-suficiencia-page .selected-name {
        font-weight: 700;
    }

    .solicitud-suficiencia-page .selected-header {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        flex-shrink: 0;
    }

    .solicitud-suficiencia-page .selected-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .solicitud-suficiencia-page .summary-panel {
        padding: 12px;
        flex-shrink: 0;
    }

    @@media (max-width: 760px) {
        .solicitud-suficiencia-page .summary-strip,
        .solicitud-suficiencia-page .partida-strip {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private GenericDataGrid<SolicitudSuficienciaResponse> table = null!;

    protected override Dictionary<string, object>? GetAdditionalFilters() => new()
    {
        ["FkidAnioSis"] = AnioStateService.AnioId ?? 0
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(async () =>
        {
            SelectedSolicitud = null;
            await ReloadData();
        });
    }

    public void Dispose() => AnioStateService.OnAnioChanged -= OnAnioChanged;
    private GenericDataGrid<SolicitudSuficienciaDetalleResponse>? detalleTable;
    private SolicitudSuficienciaResponse? SelectedSolicitud;
    private List<SolicitudSuficienciaDetalleResponse> SelectedDetalles { get; set; } = new();
    private string detalleSearchString = string.Empty;

    protected override string ModuleName => "Adquisiciones";
    protected override string SubModuleName => "SolicitudSuficiencia";

    protected override Type CreateDialogType => typeof(SolicitudSuficienciaDialog);
    protected override Type EditDialogType => typeof(SolicitudSuficienciaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SolicitudSuficienciaResponse>);

    protected override string GetDefaultSortLabel() => "FechaSolicitud";

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;
    private static readonly CultureInfo DateCulture = new("es-MX");

    private decimal TotalSeleccionado => SelectedDetalles.Sum(DetalleTotal);
    private string MesAplicado => SelectedSolicitud?.FechaRequisicion.HasValue == true
        ? DateCulture.DateTimeFormat.GetMonthName(SelectedSolicitud.FechaRequisicion.Value.Month)
        : "-";

    private IEnumerable<PartidaResumen> PartidaResumenes => SelectedDetalles
        .GroupBy(x => new { x.FkidPartidaConta, x.PartidaClaveNombre })
        .Select(x => new PartidaResumen
        {
            Partida = x.Key.PartidaClaveNombre,
            Bienes = x.Count(),
            Total = x.Sum(DetalleTotal)
        })
        .OrderBy(x => x.Partida);

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync(CreateDialogType, "Generar Solicitud Suficiencia",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Id"] = id };
        var dialog = await DialogService.ShowAsync(EditDialogType, "Editar Solicitud Suficiencia",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
            if (SelectedSolicitud?.PkidSolicitudSuficiencia == id)
            {
                await RefreshSelectedAndDetails();
            }
        }
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SolicitudSuficienciaResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidSolicitudSuficiencia,
            Requisicion = item.RequisicionDescripcion,
            FechaSolicitud = item.FechaSolicitud.ToString("dd/MM/yyyy"),
            FechaRequisicion = item.FechaRequisicion?.ToString("dd/MM/yyyy") ?? string.Empty,
            item.Justificacion,
            Estatus = item.EstatusDescripcion,
            item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.RequisicionDescripcion ?? "la solicitud de suficiencia";
    }

    protected override async Task ReloadData()
    {
        if (SelectedSolicitud == null && table != null)
        {
            await table.ReloadData();
        }
        else
        {
            await RefreshSelectedAndDetails();
        }
    }

    private async Task SelectSolicitud(SolicitudSuficienciaResponse item)
    {
        SelectedSolicitud = item;
        detalleSearchString = string.Empty;
        await LoadSelectedDetallesSummary();
        StateHasChanged();
    }

    private async Task RefreshSelectedAndDetails()
    {
        if (SelectedSolicitud == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedSolicitud.PkidSolicitudSuficiencia);
        if (response?.Success == true && response.Data != null)
        {
            SelectedSolicitud = response.Data;
        }

        await LoadSelectedDetallesSummary();
        await ReloadDetalles();
    }

    private void BackToTable()
    {
        SelectedSolicitud = null;
        SelectedDetalles.Clear();
        detalleSearchString = string.Empty;
        StateHasChanged();
    }

    private async Task<TableData<SolicitudSuficienciaDetalleResponse>> LoadDetallesServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedSolicitud == null)
        {
            return new TableData<SolicitudSuficienciaDetalleResponse> { Items = new List<SolicitudSuficienciaDetalleResponse>(), TotalItems = 0 };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "PartidaClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = SelectedSolicitud.PkidSolicitudSuficiencia });

        return new TableData<SolicitudSuficienciaDetalleResponse>
        {
            Items = response?.Items ?? new List<SolicitudSuficienciaDetalleResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task LoadSelectedDetallesSummary()
    {
        if (SelectedSolicitud == null)
        {
            SelectedDetalles.Clear();
            return;
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            1,
            int.MaxValue,
            string.Empty,
            "PartidaClave",
            SortDirection.Ascending,
            new Dictionary<string, object> { ["FkidSolicitudSuficienciaPres"] = SelectedSolicitud.PkidSolicitudSuficiencia });

        SelectedDetalles = response?.Items?.ToList() ?? new List<SolicitudSuficienciaDetalleResponse>();
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private static Color EstatusColor(int estatus) => estatus switch
    {
        1 => Color.Info,
        2 => Color.Warning,
        3 => Color.Success,
        4 => Color.Error,
        _ => Color.Default
    };

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DateOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string DateTimeOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";

    private static string Money(decimal? value) =>
        $"${(value ?? 0m).ToString("0.00", NumberCulture)}";

    private static string Quantity(decimal? value) =>
        (value ?? 0m).ToString("0.00", NumberCulture);

    private static decimal DetalleTotal(SolicitudSuficienciaDetalleResponse item) =>
        item.Total ?? item.Enero.GetValueOrDefault() + item.Febrero.GetValueOrDefault() +
        item.Marzo.GetValueOrDefault() + item.Abril.GetValueOrDefault() +
        item.Mayo.GetValueOrDefault() + item.Junio.GetValueOrDefault() +
        item.Julio.GetValueOrDefault() + item.Agosto.GetValueOrDefault() +
        item.Septiembre.GetValueOrDefault() + item.Octubre.GetValueOrDefault() +
        item.Noviembre.GetValueOrDefault() + item.Diciembre.GetValueOrDefault();

    private static string MesConMonto(SolicitudSuficienciaDetalleResponse item)
    {
        var months = new[]
        {
            ("Ene", item.Enero), ("Feb", item.Febrero), ("Mar", item.Marzo), ("Abr", item.Abril),
            ("May", item.Mayo), ("Jun", item.Junio), ("Jul", item.Julio), ("Ago", item.Agosto),
            ("Sep", item.Septiembre), ("Oct", item.Octubre), ("Nov", item.Noviembre), ("Dic", item.Diciembre)
        };

        var month = months.FirstOrDefault(x => x.Item2.GetValueOrDefault() > 0m);
        return month.Item1 == null ? "-" : $"{month.Item1} {Money(month.Item2)}";
    }

    private sealed class PartidaResumen
    {
        public string Partida { get; set; } = string.Empty;
        public int Bienes { get; set; }
        public decimal Total { get; set; }
    }
}
