@page "/Patrimonio/Resguardos"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MiniExcelLibs
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<ResguardoResponse, ResguardoResponse>

@inject SucursalStateService SucursalStateService
@inject IGenericCrudService<ResguardoDetalleResponse> ResguardoDetalleService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column resguardos-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        @if (SelectedResguardo == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Resguardos"
                            Subtitle="Administracion de responsables, areas y bienes bajo custodia"
                            Icon="@Icons.Material.Filled.AssignmentInd"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()" />

                <div class="summary-strip">
                    <div>
                        <span class="summary-label">Valor visible</span>
                        <strong>@Money(Elements.Sum(x => x.ValorActualResguardado ?? 0m))</strong>
                    </div>
                    <div>
                        <span class="summary-label">Resguardos</span>
                        <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
                    </div>
                    <div>
                        <span class="summary-label">Bienes visibles</span>
                        <strong>@Elements.Sum(x => x.TotalBienes ?? 0).ToString("N0", NumberCulture)</strong>
                    </div>
                    <div>
                        <span class="summary-label">Empresa</span>
                        <strong>@TextOrDash(SucursalStateService.EmpresaNombre)</strong>
                    </div>
                </div>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="ResguardoResponse"
                                  @ref="table"
                                  Title="Listado de resguardos"
                                  SearchPlaceholder="Buscar por folio, responsable o area..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="ResguardoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Ver bienes">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => SelectResguardo(cell.Item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="Patrimonio"
                        SubModulo="Resguardos"
                        Controlador="Resguardo"
                        EntidadId="@cell.Item.PkidResguardo"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@TextOrDash(cell.Item.Folio)"
                        RegistroDescripcion="@($"{TextOrDash(cell.Item.PersonaNombre)} | {TextOrDash(cell.Item.AreaNombre)}")" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidResguardo))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        Disabled="@((cell.Item.TotalBienes ?? 0) > 0)"
                        OnClick="@(() => DeleteItem(cell.Item.PkidResguardo))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Folio" Identifier="Folio" PropertyName="Folio" SortBy="x => x.Folio">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Folio)</div>
                        <span>ID @cell.Item.PkidResguardo</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Responsable" Identifier="PersonaNombre" PropertyName="PersonaNombre" SortBy="x => x.PersonaNombre">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.PersonaNombre)</div>
                        <span>@TextOrDash(cell.Item.PersonaClave)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Area" Identifier="AreaNombre" PropertyName="AreaNombre" SortBy="x => x.AreaNombre">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.AreaNombre)</div>
                        <span>@TextOrDash(cell.Item.AreaClave)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Fecha" Identifier="FechaResguardo" PropertyName="FechaResguardo" SortBy="x => x.FechaResguardo">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaResguardo.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Bienes" Identifier="TotalBienes" PropertyName="TotalBienes" SortBy="x => x.TotalBienes">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @(cell.Item.TotalBienes ?? 0) bienes
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Valor" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <strong>@Money(cell.Item.ValorActualResguardado ?? 0m)</strong>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoResponse" Title="Estado" Identifier="__column_7" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string"
                        Size="Size.Small"
                        Color="@(cell.Item.Activo ? Color.Success : Color.Error)"
                        Variant="Variant.Outlined">
                        @(cell.Item.Activo ? "Activo" : "Inactivo")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div Class="d-flex flex-column" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background: transparent; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="BackToTable"
                                   Tooltip="Volver al listado" />
                    <div class="selected-title ml-2">
                        <MudText Typo="Typo.h6">@TextOrDash(SelectedResguardo.Folio)</MudText>
                        <span>@TextOrDash(SelectedResguardo.PersonaNombre)</span>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @(SelectedResguardo.TotalBienes ?? 0) bienes
                    </MudChip>
                    @if (CanUpdate)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                   OnClick="OpenAgregarBienDialog"
                                   Class="ml-2">
                            Agregar bien
                        </MudButton>
                    }
                    <MudTooltip Text="Editar resguardo">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="@(() => EditItem(SelectedResguardo.PkidResguardo))"
                                       Class="ml-2" />
                    </MudTooltip>
                    <DocumentSupportButton Modulo="Patrimonio"
                                           SubModulo="Resguardos"
                                           Controlador="Resguardo"
                                           EntidadId="@SelectedResguardo.PkidResguardo"
                                           FkidEmpresaSis="@SelectedResguardo.FkidEmpresaSis"
                                           RegistroTitulo="@TextOrDash(SelectedResguardo.Folio)"
                                           RegistroDescripcion="@($"{TextOrDash(SelectedResguardo.PersonaNombre)} | {TextOrDash(SelectedResguardo.AreaNombre)}")" />
                </MudPaper>

                <MudCard Elevation="1" Style="flex-shrink: 0;">
                    <MudCardContent Style="padding: 10px 12px;">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Responsable</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@TextOrDash(SelectedResguardo.PersonaNombre)</MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Area</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@TextOrDash(SelectedResguardo.AreaNombre)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@SelectedResguardo.FechaResguardo.ToString("dd/MM/yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Bienes</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@(SelectedResguardo.TotalBienes ?? 0)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Valor</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 800;">@Money(SelectedResguardo.ValorActualResguardado ?? 0m)</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Observaciones</MudText>
                                <MudText Typo="Typo.body2">@TextOrDash(SelectedResguardo.Observaciones)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <GenericDataGrid TItem="ResguardoDetalleResponse"
                              @ref="detalleTable"
                              Title="Bienes bajo resguardo"
                              SearchPlaceholder="Buscar bien, clave o serie..."
                              ShowExportButton="false"
                              ShowAddButton="@CanUpdate"
                              AddButtonTooltip="Agregar bien"
                              AddButtonIcon="@Icons.Material.Filled.AddCircle"
                              PageSize="8"
                              ServerDataFunc="LoadDetalleServerData"
                              SearchString="@detalleSearchString"
                              SearchStringChanged="(s) => detalleSearchString = s"
                              OnSearch="ReloadDetalle"
                              OnAdd="OpenAgregarBienDialog">
            <Columns>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Liberar bien">
                        <MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn"
                        Visible="@CanUpdate"
                        Color="Color.Warning"
                        Size="Size.Small"
                        OnClick="@(() => LiberarDetalle(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Clave" Identifier="BienClave" PropertyName="BienClave" SortBy="x => x.BienClave">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.BienClave)</div>
                        <span>@TextOrDash(cell.Item.BienClaveAnterior)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Bien" Identifier="BienDescripcion" PropertyName="BienDescripcion" SortBy="x => x.BienDescripcion">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.BienDescripcion)</div>
                        <span>@TextOrDash(cell.Item.TipoBienDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Serie" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Serie)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Fecha" Identifier="FechaAsignacion" PropertyName="FechaAsignacion" SortBy="x => x.FechaAsignacion">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaAsignacion.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoDetalleResponse" Title="Valor" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <strong>@Money(cell.Item.ValorActual ?? 0m)</strong>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </div>
        }
    </MudContainer>
</AccessVerification>

<style>
    .resguardos-page .summary-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .resguardos-page .summary-strip > div {
        min-width: 0;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px 12px;
        background: var(--mud-palette-surface);
        box-shadow: var(--mud-elevation-1);
    }

    .resguardos-page .summary-label {
        display: block;
        font-size: .72rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

    .resguardos-page .summary-strip strong,
    .resguardos-page .main-cell {
        font-weight: 700;
        line-height: 1.15;
    }

    .resguardos-page td span,
    .resguardos-page .selected-title span {
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
    }

    .resguardos-page .selected-title {
        min-width: 0;
    }

    .resguardos-page .selected-title .mud-typography {
        font-weight: 700;
        line-height: 1.1;
    }

    @@media (max-width: 960px) {
        .resguardos-page .summary-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@code {
    private GenericDataGrid<ResguardoResponse> table = null!;
    private GenericDataGrid<ResguardoDetalleResponse>? detalleTable;
    private ResguardoResponse? SelectedResguardo;
    private string detalleSearchString = string.Empty;

    protected override string ModuleName => "Patrimonio";
    protected override string SubModuleName => "Resguardos";
    protected override Type CreateDialogType => typeof(ResguardoDialog);
    protected override Type EditDialogType => typeof(ResguardoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ResguardoResponse>);

    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("es-MX");

    protected override string GetDefaultSortLabel() => "FechaResguardo";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SucursalStateService.InitializeAsync();
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
    }

    protected override async Task<TableData<ResguardoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var filters = SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0
                ? new Dictionary<string, object> { ["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value }
                : null;

            var response = await Service.GetAllPaginadoAsync(
                CurrentPage,
                PageSize,
                SearchString,
                SortLabel,
                SortDirection,
                filters);

            if (response?.Success == true && response.Items != null)
            {
                Elements = response.Items.ToList();
                TotalCount = response.TotalCount;
            }
            else
            {
                Elements.Clear();
                TotalCount = 0;
                if (!string.IsNullOrWhiteSpace(response?.Message))
                {
                    Snackbar.Add(response.Message, Severity.Error);
                }
            }

            return new TableData<ResguardoResponse> { Items = Elements, TotalItems = TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar resguardos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<ResguardoResponse> { Items = new List<ResguardoResponse>(), TotalItems = 0 };
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task CreateItem()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0
        };

        var dialog = await DialogService.ShowAsync(CreateDialogType, "Crear resguardo",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
        }
    }

    protected override async Task EditItem(int id)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["EmpresaId"] = SucursalStateService.EmpresaId ?? 0
        };

        var dialog = await DialogService.ShowAsync(EditDialogType, "Editar resguardo",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadData();
            if (SelectedResguardo?.PkidResguardo == id)
            {
                await RefreshSelectedResguardo();
                await ReloadDetalle();
            }
        }
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.Folio ?? "el resguardo";
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ResguardoResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidResguardo,
            item.Folio,
            Responsable = item.PersonaNombre,
            item.PersonaClave,
            Area = item.AreaNombre,
            item.FechaResguardo,
            Bienes = item.TotalBienes,
            Valor = item.ValorActualResguardado,
            item.Observaciones,
            item.UsuarioCreacion,
            item.FechaCreacion
        });
    }

    protected override async Task ExportToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        Loading = true;
        StateHasChanged();

        try
        {
            var sortLabel = string.IsNullOrWhiteSpace(SortLabel) ? GetDefaultSortLabel() : SortLabel;
            var filters = SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0
                ? new Dictionary<string, object> { ["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value }
                : null;
            var response = await Service.GetAllPaginadoAsync(1, int.MaxValue, SearchString, sortLabel, SortDirection, filters);

            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add(response?.Message ?? "No hay datos para exportar", Severity.Warning);
                return;
            }

            using var memoryStream = new MemoryStream();
            await memoryStream.SaveAsAsync(MapToExcelData(response.Items));
            var base64 = Convert.ToBase64String(memoryStream.ToArray());

            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"{SubModuleName}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Exportacion exitosa: {response.Items.Count()} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    protected override async Task ReloadData()
    {
        if (SelectedResguardo == null && table != null)
        {
            await table.ReloadData();
            return;
        }

        await RefreshSelectedResguardo();
        await ReloadDetalle();
    }

    private void SelectResguardo(ResguardoResponse item)
    {
        SelectedResguardo = item;
        detalleSearchString = string.Empty;
        StateHasChanged();
    }

    private void BackToTable()
    {
        SelectedResguardo = null;
        detalleSearchString = string.Empty;
        StateHasChanged();
    }

    private async Task RefreshSelectedResguardo()
    {
        if (SelectedResguardo == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedResguardo.PkidResguardo);
        if (response?.Success == true && response.Data != null)
        {
            SelectedResguardo = response.Data;
        }
    }

    private async Task<TableData<ResguardoDetalleResponse>> LoadDetalleServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedResguardo == null)
        {
            return new TableData<ResguardoDetalleResponse> { Items = new List<ResguardoDetalleResponse>(), TotalItems = 0 };
        }

        var response = await ResguardoDetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "FechaAsignacion",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidResguardoAlma"] = SelectedResguardo.PkidResguardo });

        return new TableData<ResguardoDetalleResponse>
        {
            Items = response?.Items ?? new List<ResguardoDetalleResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task ReloadDetalle()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private async Task OpenAgregarBienDialog()
    {
        if (SelectedResguardo == null)
        {
            return;
        }

        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para agregar bienes al resguardo", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["ResguardoId"] = SelectedResguardo.PkidResguardo,
            ["ResguardoDescripcion"] = $"{TextOrDash(SelectedResguardo.Folio)} - {TextOrDash(SelectedResguardo.PersonaNombre)}",
            ["EmpresaId"] = SelectedResguardo.FkidEmpresaSis > 0
                ? SelectedResguardo.FkidEmpresaSis
                : SucursalStateService.EmpresaId ?? 0
        };

        var dialog = await DialogService.ShowAsync<ResguardoDetalleDialog>(
            "Agregar bien al resguardo",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSelectedResguardo();
            await ReloadDetalle();
        }
    }

    private async Task LiberarDetalle(ResguardoDetalleResponse detalle)
    {
        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para liberar bienes", Severity.Warning);
            return;
        }

        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Liberar el bien {TextOrDash(detalle.BienClave)} del resguardo?");
        if (!confirm)
        {
            return;
        }

        var response = await ResguardoDetalleService.DeleteAsync(detalle.PkidResguardoDetalle);
        if (response?.Success == true)
        {
            Snackbar.Add("Bien liberado correctamente", Severity.Success);
            await RefreshSelectedResguardo();
            await ReloadDetalle();
            return;
        }

        Snackbar.Add(response?.Message ?? "Error al liberar el bien", Severity.Error);
    }

    private async void OnEmpresaChanged(int _)
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string Money(decimal value) =>
        value.ToString("C2", NumberCulture);

    public void Dispose()
    {
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        SearchCts?.Cancel();
        SearchCts?.Dispose();
    }
}
