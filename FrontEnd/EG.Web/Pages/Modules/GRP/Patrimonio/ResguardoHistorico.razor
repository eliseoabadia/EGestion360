@page "/Patrimonio/Resguardo_Historico"
@using EG.Domain.DTOs.Responses.Patrimonio
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor
@implements IDisposable

@inject IGenericCrudService<ResguardoMovimientoResponse> Service
@inject SucursalStateService SucursalStateService

<MudContainer Class="px-3 d-flex flex-column resguardo-historico-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
    <PageHeader Title="Resguardo Historico"
                Subtitle="Movimientos de asignacion y liberacion de bienes"
                Icon="@Icons.Material.Filled.History"
                ShowCreateButton="false"
                OnRefresh="ReloadData" />

    <div Style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
        <GenericDataGrid TItem="ResguardoMovimientoResponse"
                      @ref="table"
                      Title="Movimientos de resguardo"
                      SearchPlaceholder="Buscar por bien, folio, responsable o movimiento..."
                      ShowExportButton="false"
                      ServerDataFunc="LoadServerData"
                      SearchString="@search"
                      SearchStringChanged="value => search = value"
                      OnSearch="ReloadData"
                      PageSize="20"
                      PageSizeOptions="new[] { 10, 20, 50, 100 }"
                      TableHeight="calc(100vh - 250px)">
            <Columns>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Fecha" Identifier="FechaMovimiento" PropertyName="FechaMovimiento" SortBy="x => x.FechaMovimiento">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Movimiento" Identifier="TipoMovimiento" PropertyName="TipoMovimiento" SortBy="x => x.TipoMovimiento">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="@MovementColor(cell.Item.TipoMovimiento)" Variant="Variant.Outlined">
                        @TextOrDash(cell.Item.TipoMovimiento)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Bien" Identifier="BienClave" PropertyName="BienClave" SortBy="x => x.BienClave">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@TextOrDash(cell.Item.BienClave)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.BienDescripcion)</MudText>
                        @if (!string.IsNullOrWhiteSpace(cell.Item.BienSerie))
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Serie @cell.Item.BienSerie</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Origen" Identifier="ResguardoOrigenFolio" PropertyName="ResguardoOrigenFolio" SortBy="x => x.ResguardoOrigenFolio">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2">@TextOrDash(cell.Item.ResguardoOrigenFolio)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.ResguardoOrigenResponsable)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Destino" Identifier="ResguardoDestinoFolio" PropertyName="ResguardoDestinoFolio" SortBy="x => x.ResguardoDestinoFolio">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2">@TextOrDash(cell.Item.ResguardoDestinoFolio)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.ResguardoDestinoResponsable)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ResguardoMovimientoResponse" Title="Observaciones" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Observaciones)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </div>
</MudContainer>

@code {
    private GenericDataGrid<ResguardoMovimientoResponse> table = null!;
    private string search = string.Empty;

    private Dictionary<string, object>? EmpresaFilters =>
        SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0
            ? new Dictionary<string, object> { ["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value }
            : null;

    protected override async Task OnInitializedAsync()
    {
        await SucursalStateService.InitializeAsync();
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
    }

    private async Task<TableData<ResguardoMovimientoResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await Service.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            search,
            state.SortLabel ?? "FechaMovimiento",
            state.SortDirection,
            EmpresaFilters);

        return new TableData<ResguardoMovimientoResponse>
        {
            Items = response?.Items ?? new List<ResguardoMovimientoResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task ReloadData()
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private static Color MovementColor(string? movement) =>
        movement?.Contains("LIBER", StringComparison.OrdinalIgnoreCase) == true ? Color.Warning :
        movement?.Contains("ASIGN", StringComparison.OrdinalIgnoreCase) == true ? Color.Success :
        Color.Info;

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async void OnEmpresaChanged(int _)
    {
        if (table != null)
        {
            await table.ReloadData();
        }
    }

    public void Dispose()
    {
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
    }
}
