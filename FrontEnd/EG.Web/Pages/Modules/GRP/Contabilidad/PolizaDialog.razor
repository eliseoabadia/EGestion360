@using EG.Common.GenericModel
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using MudBlazor

@inject IGenericCrudService<PolizaResponse> Service
@inject IGenericCrudService<TipoPolizaResponse> TipoPolizaService
@inject AnioPresupuestalStateService AnioStateService
@inject ISnackbar Snackbar

<BaseCrudDialog TItem="PolizaResponse"
                Title="@dialogTitle"
                Subtitle="Periodo, tipo y control de autorizacion de la poliza."
                TitleIcon="@Icons.Material.Filled.ReceiptLong"
                MaxWidth="MaxWidth.Medium"
                DialogClass="poliza-dialog crud-dialog-wide"
                ActionText="@actionText"
                ProcessingText="@processingText"
                LoadingMessage="Cargando datos..."
                OnConfirm="GuardarCambiosAsync">

    <BaseEntityForm TEntity="PolizaResponse"
                    @ref="form"
                    ShowHeader="true"
                    HeaderTitle="@dialogTitle">

        <div class="poliza-form">
            <section class="poliza-section poliza-section-period">
                <div class="poliza-section-heading">
                    <span class="poliza-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="poliza-section-title">Periodo y tipo</MudText>
                        <MudText Typo="Typo.caption" Class="poliza-section-subtitle">Ubica la poliza dentro del ejercicio contable.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="4">
                        <MudSelect T="int"
                                   @bind-Value="item.FkidMesSis"
                                   Label="Mes"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="El mes es requerido">
                            @foreach (var mes in MonthOptions)
                            {
                                <MudSelectItem T="int" Value="@mes.Id">@mes.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="8">
                        <PagedAutocomplete Value="@_selectedTipoPoliza"
                                           ValueChanged="value => _selectedTipoPoliza = value"
                                           Label="Tipo de poliza"
                                           Required="true"
                                           RequiredError="El tipo de poliza es requerido"
                                           LoadPage="LoadTiposPolizaPageAsync" />
                    </MudItem>
                </MudGrid>
            </section>

            <section class="poliza-section poliza-section-data">
                <div class="poliza-section-heading">
                    <span class="poliza-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="poliza-section-title">Datos contables</MudText>
                        <MudText Typo="Typo.caption" Class="poliza-section-subtitle">Clave, fecha y concepto principal de captura.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="item.ClavePoliza"
                                      Label="Clave"
                                      Variant="Variant.Outlined"
                                      MaxLength="10"
                                      Required="true"
                                      RequiredError="La clave es requerida" />
                    </MudItem>

                    <MudItem xs="12" md="8">
                        <MudDatePicker @bind-Date="_fechaPoliza"
                                       Label="Fecha"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="La fecha es requerida" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="item.NombrePoliza"
                                      Label="Nombre"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      MaxLength="1000"
                                      Required="true"
                                      RequiredError="El nombre de la poliza es requerido" />
                    </MudItem>
                </MudGrid>
            </section>

            <section class="poliza-section poliza-section-control">
                <div class="poliza-section-heading">
                    <span class="poliza-section-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" />
                    </span>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="poliza-section-title">Control</MudText>
                        <MudText Typo="Typo.caption" Class="poliza-section-subtitle">Permisos de modificacion y estado de autorizacion.</MudText>
                    </div>
                </div>

                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="6">
                        <div class="poliza-toggle-card">
                            <span class="poliza-toggle-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                            </span>
                            <div class="poliza-toggle-copy">
                                <span>Edicion</span>
                                <strong>@(_permitirModificar ? "Modificable" : "Bloqueada")</strong>
                            </div>
                            <MudSwitch T="bool"
                                       @bind-Value="_permitirModificar"
                                       Label="Permitir modificacion"
                                       Color="Color.Primary" />
                        </div>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <div class="poliza-toggle-card">
                            <span class="poliza-toggle-icon success" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                            </span>
                            <div class="poliza-toggle-copy">
                                <span>Estado</span>
                                <strong>@(_autorizado ? "Autorizada" : "Pendiente")</strong>
                            </div>
                            <MudSwitch T="bool"
                                       @bind-Value="_autorizado"
                                       Label="Autorizada"
                                       Color="Color.Success" />
                        </div>
                    </MudItem>
                </MudGrid>
            </section>
        </div>
    </BaseEntityForm>
</BaseCrudDialog>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private BaseEntityForm<PolizaResponse> form = null!;
    private PolizaResponse item = new()
    {
        Activo = true,
        FechaPoliza = DateTime.Today,
        FkidMesSis = DateTime.Today.Month,
        PermitirModificar = true,
        Autorizado = false
    };
    private DateTime? _fechaPoliza = DateTime.Today;
    private LookupItem? _selectedTipoPoliza;
    private bool _permitirModificar = true;
    private bool _autorizado;

    private string dialogTitle => Id.HasValue ? "Editar Poliza" : "Nueva Poliza";
    private string actionText => Id.HasValue ? "Actualizar" : "Crear";
    private string processingText => Id.HasValue ? "Actualizando..." : "Creando...";

    private static readonly IReadOnlyList<MonthOption> MonthOptions = new List<MonthOption>
    {
        new(1, "Enero"),
        new(2, "Febrero"),
        new(3, "Marzo"),
        new(4, "Abril"),
        new(5, "Mayo"),
        new(6, "Junio"),
        new(7, "Julio"),
        new(8, "Agosto"),
        new(9, "Septiembre"),
        new(10, "Octubre"),
        new(11, "Noviembre"),
        new(12, "Diciembre")
    };

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();

        if (Id.HasValue)
        {
            await CargarDatosAsync();
            return;
        }

        ApplyHeaderAnio();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await Service.GetByIdAsync(Id!.Value);
            if (response?.Success == true && response.Data != null)
            {
                item = response.Data;
                _fechaPoliza = item.FechaPoliza;
                _permitirModificar = item.PermitirModificar ?? true;
                _autorizado = item.Autorizado ?? false;
                _selectedTipoPoliza = new LookupItem
                {
                    Id = item.FkidTipoPolizaSis,
                    Text = TextOrDefault(item.TipoPoliza, item.FkidTipoPolizaSis)
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task GuardarCambiosAsync()
    {
        if (!await form.ValidateAsync())
        {
            Snackbar.Add("Completa los campos requeridos.", Severity.Warning);
            return;
        }

        ApplyHeaderAnio();
        if (item.FkidAnioSis <= 0)
        {
            Snackbar.Add("Selecciona el anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (_selectedTipoPoliza == null)
        {
            Snackbar.Add("Selecciona el tipo de poliza.", Severity.Warning);
            return;
        }

        if (item.FkidMesSis < 1 || item.FkidMesSis > 12)
        {
            Snackbar.Add("Selecciona un mes valido.", Severity.Warning);
            return;
        }

        item.FkidTipoPolizaSis = _selectedTipoPoliza.Id;
        item.FechaPoliza = _fechaPoliza ?? DateTime.Today;
        item.ClavePoliza = item.ClavePoliza?.Trim() ?? string.Empty;
        item.NombrePoliza = item.NombrePoliza?.Trim() ?? string.Empty;
        item.PermitirModificar = _permitirModificar;
        item.Autorizado = _autorizado;

        try
        {
            var response = Id.HasValue
                ? await Service.UpdateAsync(item, Id.Value)
                : await Service.CreateAsync(item);

            if (response?.Success == true)
            {
                Snackbar.Add(Id.HasValue ? "Poliza actualizada correctamente." : "Poliza creada correctamente.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            Snackbar.Add(response?.Message ?? "Error al guardar la poliza.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task<ComboLookupResult> LoadTiposPolizaPageAsync(int page, int pageSize, string filter, CancellationToken ct)
    {
        var response = await TipoPolizaService.GetAllPaginadoAsync(page, pageSize, filter, "Descripcion", SortDirection.Ascending);
        return ToComboResult(response?.Items?.Select(x => new LookupItem { Id = x.PkidTipoPoliza, Text = x.Descripcion }), response?.TotalCount);
    }

    private void ApplyHeaderAnio()
    {
        if (AnioStateService.AnioId is > 0)
        {
            item.FkidAnioSis = AnioStateService.AnioId.Value;
        }
    }

    private static ComboLookupResult ToComboResult(IEnumerable<LookupItem>? items, int? totalCount)
    {
        var list = items?.ToList() ?? new List<LookupItem>();
        return new ComboLookupResult { Items = list, TotalCount = totalCount ?? list.Count };
    }

    private static string TextOrDefault(string? text, int id) =>
        string.IsNullOrWhiteSpace(text) ? id.ToString() : text;

    private sealed record MonthOption(int Id, string Nombre);
}
