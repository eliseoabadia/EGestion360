@using EG.Web.Auth
@using EG.Web.Pages.Shared
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@implements IDisposable

@inject AuthenticationProviderJWT AuthProvider
@inject EG.Web.Services.AuthService UserAuthService
@inject EG.Web.Services.SucursalStateService SucursalStateService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<AccessVerification IsInitialized="@_isInitialized"
                    HasAccess="@_hasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="@_config.Title"
                    Subtitle="@_config.Subtitle"
                    Icon="@_config.Icon"
                    ShowCreateButton="false"
                    OnRefresh="ResetFilters" />

        <MudPaper Elevation="0" Class="pa-4" Style="overflow: auto; min-height: 0;">
            @if (_config.Links.Count > 0)
            {
                <MudGrid Spacing="2">
                    @foreach (var link in _config.Links)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@link.Icon"
                                       FullWidth="true"
                                       Style="height: 48px; justify-content: flex-start;"
                                       OnClick="@(() => Navigation.NavigateTo(link.Route))">
                                @link.Title
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-3">
                    @if (_config.ShowDateRange)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker Label="Fecha inicio"
                                           @bind-Date="_startDate"
                                           DateFormat="dd/MM/yyyy"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker Label="Fecha fin"
                                           @bind-Date="_endDate"
                                           DateFormat="dd/MM/yyyy"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                    }

                    @if (_config.ShowSingleDate)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudDatePicker Label="Fecha"
                                           @bind-Date="_singleDate"
                                           DateFormat="dd/MM/yyyy"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                    }

                    @if (_config.ShowNivel)
                    {
                        <MudItem xs="12" sm="6" md="2">
                            <MudNumericField T="int" Label="Nivel"
                                             @bind-Value="_nivel"
                                             Min="1"
                                             Max="10"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudSwitch T="bool" Label="Mes 13" @bind-Value="_usaMesTrece" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSwitch T="bool" Label="Solo cuentas presupuestales" @bind-Value="_soloCuentasPres" Color="Color.Primary" />
                        </MudItem>
                    }

                    @if (_config.ShowCuenta)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="int?" Label="Cuenta"
                                             @bind-Value="_cuenta"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>
                    }

                    @if (_config.ShowCierre)
                    {
                        <MudItem xs="12" sm="6" md="2">
                            <MudSwitch T="bool" Label="Cierre" @bind-Value="_esCierre" Color="Color.Primary" />
                        </MudItem>
                    }

                    @if (_config.IdParameter is not null)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="int?" Label="@_config.IdLabel"
                                             @bind-Value="_entityId"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>
                    }
                </MudGrid>

                @if (string.IsNullOrWhiteSpace(_config.ReportName))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Ruta registrada sin layout legacy disponible.
                    </MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Assessment"
                                   Disabled="@(!CanOpenReport)"
                                   OnClick="@(() => OpenReport(false))">
                            Ver reporte
                        </MudButton>
                        @if (IsReportDesignerEntryVisible)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.DesignServices"
                                       Disabled="@(!CanOpenReport)"
                                       OnClick="@(() => OpenReport(true))">
                                Disenador
                            </MudButton>
                        }
                    </MudStack>
                }
            }
        </MudPaper>
    </MudContainer>
</AccessVerification>

@code {
    private ReportPageConfig _config = ReportPageConfig.Empty;
    private string _currentRoute = string.Empty;
    private bool _isInitialized;
    private bool _hasAccess;
    private bool _canUpdate;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private DateTime? _singleDate;
    private int _nivel;
    private int? _cuenta;
    private int? _entityId;
    private int? _empresaId;
    private int? _usuarioId;
    private bool _usaMesTrece;
    private bool _soloCuentasPres;
    private bool _esCierre;

    private bool CanOpenReport => !string.IsNullOrWhiteSpace(_config.ReportName) &&
                                  (_config.IdParameter is null || _entityId.HasValue);
    private static bool IsReportDesignerEntryVisible => false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await LoadReportContextAsync();
        ResolveConfig(resetFilters: true);
        await AuthProvider.GetAuthenticationStateAsync();
        VerifyAccess();
        _isInitialized = true;
    }

    protected override void OnParametersSet()
    {
        ResolveConfig(resetFilters: false);
        if (_isInitialized)
        {
            VerifyAccess();
        }
    }

    private void ResolveConfig(bool resetFilters)
    {
        var route = NormalizeRoute(Navigation.ToBaseRelativePath(Navigation.Uri));
        if (route == _currentRoute && _config != ReportPageConfig.Empty)
        {
            return;
        }

        _currentRoute = route;
        _config = Configs.TryGetValue(route, out var config) ? config : ReportPageConfig.Empty;

        if (resetFilters || _isInitialized)
        {
            ResetFilters();
        }
    }

    private void VerifyAccess()
    {
        var canView = AuthProvider.HasPermission(_config.ModuleName, _config.SubModuleName, "view") ||
                      AuthProvider.HasPermission(_config.ModuleName, _config.SubModuleName, "view-menu");

        _canUpdate = AuthProvider.HasPermission(_config.ModuleName, _config.SubModuleName, "update");
        _hasAccess = canView;
    }

    private Task ResetFilters()
    {
        var today = DateTime.Today;
        _startDate = new DateTime(today.Year, 1, 1);
        _endDate = today;
        _singleDate = today;
        _nivel = 10;
        _cuenta = null;
        _entityId = null;
        _usaMesTrece = false;
        _soloCuentasPres = false;
        _esCierre = false;
        return Task.CompletedTask;
    }

    private async Task OpenReport(bool designer)
    {
        if (!CanOpenReport)
        {
            return;
        }

        var reportIdentifier = BuildReportIdentifier();
        var reportToken = CreateReportToken();
        await StoreReportRouteAsync(reportToken, reportIdentifier, _config.Title);

        var routeParameters = new Dictionary<string, string?>
        {
            ["name"] = reportToken
        };

        var route = designer ? "/Reporting/Designer" : "/Reporting/Viewer";
        Navigation.NavigateTo($"{route}?{BuildQuery(routeParameters)}");
    }

    private async Task StoreReportRouteAsync(string reportToken, string reportIdentifier, string title)
    {
        await JS.InvokeVoidAsync("sessionStorage.setItem", BuildReportStorageKey(reportToken), reportIdentifier);
        await JS.InvokeVoidAsync("sessionStorage.setItem", BuildReportTitleStorageKey(reportToken), title);
    }

    private string BuildReportIdentifier()
    {
        var parameters = BuildReportParameters();
        var query = BuildQuery(parameters);
        return string.IsNullOrWhiteSpace(query) ? _config.ReportName! : $"{_config.ReportName}?{query}";
    }

    private Dictionary<string, string?> BuildReportParameters()
    {
        var parameters = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);

        if (_empresaId.HasValue && _empresaId.Value > 0)
        {
            parameters["IdEmpresa"] = _empresaId.Value.ToString();
        }

        if (_usuarioId.HasValue && _usuarioId.Value > 0)
        {
            parameters["IdEmpleado"] = _usuarioId.Value.ToString();
        }

        if (_config.ShowDateRange)
        {
            parameters[_config.StartDateParameter] = FormatDate(_startDate);
            parameters[_config.EndDateParameter] = FormatDate(_endDate);
        }

        if (_config.ShowSingleDate)
        {
            parameters[_config.StartDateParameter] = FormatDate(_singleDate);
        }

        if (_config.ShowNivel)
        {
            parameters["p_nivel"] = _nivel.ToString();
            parameters["p_UsaMesTrece"] = _usaMesTrece ? "1" : "0";
            parameters["p_SoloCuentasPres"] = _soloCuentasPres ? "1" : "0";
        }

        if (_config.ShowCuenta && _cuenta.HasValue)
        {
            parameters[_config.CuentaParameter] = _cuenta.Value.ToString();
        }

        if (_config.ShowCierre)
        {
            parameters["EsCierre"] = _esCierre ? "1" : "0";
        }

        if (_config.IdParameter is not null && _entityId.HasValue)
        {
            parameters[_config.IdParameter] = _entityId.Value.ToString();
        }

        return parameters;
    }

    private async Task LoadReportContextAsync()
    {
        await SucursalStateService.InitializeAsync();
        _empresaId = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();

        var userId = await UserAuthService.GetUserIdAsync();
        _usuarioId = userId > 0 ? userId : null;
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static string BuildQuery(IReadOnlyDictionary<string, string?> values) =>
        string.Join("&",
            values
                .Where(value => !string.IsNullOrWhiteSpace(value.Key) && !string.IsNullOrWhiteSpace(value.Value))
                .Select(value => $"{Uri.EscapeDataString(value.Key)}={Uri.EscapeDataString(value.Value!)}"));

    private static string CreateReportToken() => $"RPT-{Guid.NewGuid():N}".Substring(0, 16);

    private static string BuildReportStorageKey(string token) => $"eg.report.{token}";

    private static string BuildReportTitleStorageKey(string token) => $"eg.report.title.{token}";

    private void NavigateToHome() => Navigation.NavigateTo("/");

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ResolveConfig(resetFilters: true);
        VerifyAccess();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;

    private static string NormalizeRoute(string route)
    {
        var path = route.Split('?', '#')[0].Trim('/');
        return "/" + path.ToLowerInvariant();
    }

