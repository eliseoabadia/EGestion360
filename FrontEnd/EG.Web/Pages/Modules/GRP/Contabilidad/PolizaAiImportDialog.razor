    private Task AskAssistant() => AskAssistant(forcePreviewAnswer: false);

    private async Task AskAssistant(bool forcePreviewAnswer)
    {
        if (!CanAskAssistant)
            return;

        _ragBusy = true;
        _ragAnswer = null;
        try
        {
            var questionText = _ragQuestion.Trim();
            var previewAnswer = TryBuildPreviewAnswer(questionText, forcePreviewAnswer);
            if (!string.IsNullOrWhiteSpace(previewAnswer))
            {
                SetLocalAssistantAnswer(questionText, previewAnswer);
                return;
            }

            if (_ragSession?.IndexedChunkCount <= 0)
            {
                SetLocalAssistantAnswer(questionText, "Primero analiza un archivo para revisar sus validaciones y contenido indexado.");
                return;
            }

            var response = await RagService.AskAsync(new DocumentRagAskRequest
            {
                SessionId = _ragSession!.SessionId,
                Question = questionText,
                TopK = 6
            });

            if (response.Success && response.Data != null)
            {
                _ragAnswer = response.Data;
                _isRagExpanded = true;
                if (!response.Data.AnsweredFromDocuments)
                {
                    var fallback = TryBuildPreviewAnswer(questionText, force: true);
                    if (!string.IsNullOrWhiteSpace(fallback))
                    {
                        SetLocalAssistantAnswer(questionText, fallback);
                        return;
                    }

                    Snackbar.Add("El RAG no encontro esa informacion en el archivo.", Severity.Warning);
                }

                return;
            }

            Snackbar.Add(response.Message ?? "No se pudo procesar la pregunta RAG.", Severity.Error);
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private string? TryBuildPreviewAnswer(string question, bool force)
    {
        if (_preview == null)
            return null;

        var normalized = NormalizeQuestion(question);
        var wantsLoadAnalysis = force || ContainsAny(normalized,
            "falta", "faltan", "completar", "carga", "cargar", "importar", "errores", "error",
            "validacion", "validar", "campo", "campos", "columna", "columnas", "mapeo", "resolver",
            "fila", "cuenta", "cuentas", "debe", "haber", "cuadrada", "diferencia", "poliza");

        if (!wantsLoadAnalysis)
            return null;

        var errors = _preview.Messages.Where(IsError).ToList();
        var warnings = _preview.Messages.Where(message => !IsError(message)).ToList();
        var sb = new StringBuilder();

        sb.AppendLine($"Contexto de carga: empresa {EmpresaText}, anio {HeaderAnioText}, mes {_header.FkidMesSis?.ToString() ?? "-"}.");
        sb.AppendLine($"La poliza tiene {_preview.Details.Count} movimiento(s), debe {Money(_preview.TotalDebe)}, haber {Money(_preview.TotalHaber)} y diferencia {Money(_preview.Diferencia)}.");

        if (_preview.CanImport && _preview.EstaCuadrada)
        {
            sb.AppendLine("La poliza ya esta lista. Puedes presionar Importar poliza.");
        }
        else
        {
            if (!_preview.EstaCuadrada)
                sb.AppendLine($"Bloqueo: la poliza no esta cuadrada. La diferencia actual es {Money(_preview.Diferencia)}.");

            if (errors.Count > 0)
            {
                sb.AppendLine("Para completar la carga necesitas resolver estos bloqueos:");
                foreach (var message in errors.Take(8))
                {
                    sb.AppendLine($"- {FormatMessage(message)}");
                }

                if (errors.Count > 8)
                    sb.AppendLine($"- Hay {errors.Count - 8} error(es) adicional(es).");
            }
        }

        AppendAccountAction(sb, "Cuenta debe", _selectedCuentaDebe, detail => IsDebitOnly(detail) || IsDoubleAmount(detail));
        AppendAccountAction(sb, "Cuenta haber", _selectedCuentaHaber, detail => IsCreditOnly(detail) || IsDoubleAmount(detail));

        foreach (var message in warnings.Take(4))
        {
            sb.AppendLine($"Aviso: {FormatMessage(message)}");
        }

        if (ContainsAny(normalized, "campo", "campos", "columna", "columnas", "mapeo"))
        {
            sb.AppendLine("Columnas detectadas:");
            sb.AppendLine(_preview.DetectedColumns.Count == 0
                ? "- No se detectaron columnas."
                : $"- {string.Join(", ", _preview.DetectedColumns.Take(24))}");
            sb.AppendLine("Campos clave esperados: Cuenta, Concepto/Descripcion, Debe y Haber.");
            sb.AppendLine("Si una fila trae Debe y Haber en la misma linea, se separa usando Cuenta debe y Cuenta haber.");
        }

        sb.AppendLine("Despues de ajustar cuentas manuales o corregir el archivo, presiona Analizar archivo otra vez si cambiaste el archivo. Importar poliza se habilita cuando no quedan errores y la poliza esta cuadrada.");
        return sb.ToString().Trim();
    }

    private void SetLocalAssistantAnswer(string question, string answer)
    {
        _ragAnswer = new DocumentRagAskResponse
        {
            SessionId = _ragSession?.SessionId ?? Guid.Empty,
            QuestionId = Guid.NewGuid(),
            Question = question,
            Answer = answer,
            AnsweredFromDocuments = false,
            AskedAtUtc = DateTime.UtcNow
        };
        _isRagExpanded = true;
    }

    private void AppendAccountAction(StringBuilder sb, string label, LookupItem? selected, Func<PolizaAiImportDetailRequest, bool> predicate)
    {
        var affectedRows = _baseMessages
            .Where(message => message.Code is "ACCOUNT_REQUIRED" or "DOUBLE_AMOUNT")
            .Select(message => message.RowNumber)
            .Where(row => row.HasValue)
            .Select(row => row!.Value)
            .Distinct()
            .Where(rowNumber => _baseDetails.Any(detail => detail.RowNumber == rowNumber && predicate(detail)))
            .OrderBy(row => row)
            .ToList();

        if (affectedRows.Count == 0)
            return;

        var rowsText = string.Join(", ", affectedRows.Take(8));
        if (affectedRows.Count > 8)
            rowsText += $" y {affectedRows.Count - 8} mas";

        if (selected == null)
            sb.AppendLine($"Accion: selecciona {label} para cubrir fila(s) {rowsText}.");
        else
            sb.AppendLine($"Cubierto: {label} usa {selected.Text} para fila(s) {rowsText}.");
    }

    private IReadOnlyList<string> BuildMissingHeaderFields()
    {
        var missing = new List<string>();

        if (_header.FkidAnioSis.GetValueOrDefault() <= 0)
            missing.Add("Anio");
        if (_header.FkidMesSis is < 1 or > 12 or null)
            missing.Add("Mes");
        if (_selectedTipoPoliza == null && _header.FkidTipoPolizaSis.GetValueOrDefault() <= 0)
            missing.Add("Tipo de poliza");
        if (_fechaPoliza == null)
            missing.Add("Fecha");
        if (_header.FkidEmpresaSis.GetValueOrDefault() <= 0)
            missing.Add("Empresa seleccionada");

        if (_preview != null)
        {
            if (string.IsNullOrWhiteSpace(_header.ClavePoliza))
                missing.Add("Clave sugerida");
            if (string.IsNullOrWhiteSpace(_header.NombrePoliza))
                missing.Add("Nombre de poliza");
        }

        return missing;
    }

    private string AccountHelpLabel(string label, bool debit)
        => IsAccountHelpRequired(debit) ? $"{label} *" : label;

    private bool IsAccountHelpRequired(bool debit)
        => _baseMessages.Any(message => IsAccountHelpMessageForSide(message, debit));

    private IReadOnlyList<string> BuildMissingAccountHelpFields()
    {
        var missing = new List<string>();

        if (_selectedCuentaDebe == null && IsAccountHelpRequired(debit: true))
            missing.Add("Cuenta debe");
        if (_selectedCuentaHaber == null && IsAccountHelpRequired(debit: false))
            missing.Add("Cuenta haber");

        return missing;
    }

    private bool IsAccountHelpMessageForSide(PolizaAiImportValidationMessage message, bool debit)
    {
        if (message.RowNumber == null
            || (message.Code != "ACCOUNT_REQUIRED" && message.Code != "DOUBLE_AMOUNT"))
            return false;

        var detail = _baseDetails.FirstOrDefault(x => x.RowNumber == message.RowNumber);
        if (detail == null)
            return false;

        return message.Code == "DOUBLE_AMOUNT"
            ? IsDoubleAmount(detail)
            : debit ? IsDebitOnly(detail) || IsDoubleAmount(detail) : IsCreditOnly(detail) || IsDoubleAmount(detail);
    }

