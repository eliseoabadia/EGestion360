@using System.Globalization
@using EG.Common.GenericModel
@using EG.Domain.DTOs.Requests.Contabilidad
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Contracts
@using EG.Web.Contracts.Modules.GRP.Contabilidad
@using EG.Web.Contracts.Platform.DocumentRag
@using EG.Web.Models
@using EG.Web.Models.Platform.DocumentRag
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using System.Text
@implements IAsyncDisposable

@inject IPolizaAiImportService ImportService
@inject IDocumentRagService RagService
@inject IGenericCrudService<TipoPolizaResponse> TipoPolizaService
@inject IGenericCrudService<CuentaContableResponse> CuentaService
@inject AnioPresupuestalStateService AnioStateService
@inject SucursalStateService SucursalStateService
@inject ISnackbar Snackbar

<MudDialog Class="poliza-ai-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Ayuda IA para poliza</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" Disabled="@_busy" />
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudSelect T="int?" @bind-Value="_header.FkidMesSis" Label="Mes" Variant="Variant.Outlined" Required="true" RequiredError="Selecciona un mes">
                    @foreach (var month in MonthOptions)
                    {
                        <MudSelectItem T="int?" Value="@month.Id">@month.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <PagedAutocomplete Value="@_selectedTipoPoliza"
                                   ValueChanged="OnTipoPolizaChanged"
                                   Label="Tipo de poliza"
                                   Required="true"
                                   RequiredError="Selecciona un tipo de poliza"
                                   LoadPage="LoadTiposPolizaPageAsync" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_header.ClavePoliza"
                              Label="Clave sugerida"
                              Variant="Variant.Outlined"
                              MaxLength="10"
                              Required="true"
                              RequiredError="Captura la clave de poliza" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_fechaPoliza"
                               Label="Fecha"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Selecciona una fecha" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField Value="@EmpresaText"
                              Label="Empresa seleccionada"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Selecciona una empresa"
                              ReadOnly="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_header.NombrePoliza"
                              Label="Nombre de poliza"
                              Variant="Variant.Outlined"
                              Lines="2"
                              Required="true"
                              RequiredError="Captura el nombre de la poliza" />
            </MudItem>
            <MudItem xs="12" md="6">
                <PagedAutocomplete Value="@_selectedCuentaDebe"
                                   ValueChanged="OnCuentaDebeChanged"
                                   Label="@(AccountHelpLabel("Cuenta debe", true))"
                                   Required="@IsAccountHelpRequired(true)"
                                   RequiredError="Selecciona cuenta debe"
                                   Clearable="true"
                                   LoadPage="LoadCuentasPageAsync" />
            </MudItem>
            <MudItem xs="12" md="6">
                <PagedAutocomplete Value="@_selectedCuentaHaber"
                                   ValueChanged="OnCuentaHaberChanged"
                                   Label="@(AccountHelpLabel("Cuenta haber", false))"
                                   Required="@IsAccountHelpRequired(false)"
                                   RequiredError="Selecciona cuenta haber"
                                   Clearable="true"
                                   LoadPage="LoadCuentasPageAsync" />
            </MudItem>
        </MudGrid>

        <InputFile id="@_inputId"
                   OnChange="OnFileSelected"
                   accept=".xlsx,.csv,.txt"
                   class="poliza-ai-file-input" />
        <label for="@_inputId" class="poliza-ai-dropzone">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" />
            <span>@(_file?.Name ?? "Seleccionar Excel, CSV o TXT *")</span>
            <small>Columnas esperadas: Cuenta, Concepto, Debe y Haber</small>
        </label>

        <div class="d-flex flex-wrap align-center gap-2 mt-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PsychologyAlt"
                       Disabled="@(_file == null || _busy)"
                       OnClick="Analyze">
                Analizar archivo
            </MudButton>
            <MudTooltip Text="@ImportBlockReason" Disabled="@CanImport">
                <span>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PostAdd"
                               Disabled="@(!CanImport)"
                               OnClick="Import">
                        Importar poliza
                    </MudButton>
                </span>
            </MudTooltip>
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </div>

        <MudExpansionPanels Elevation="0" Class="mt-3">
            <MudExpansionPanel Text="Ayuda de carga y consulta del archivo" @bind-Expanded="_isRagExpanded">
                <div class="poliza-rag-context">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@EmpresaText</MudChip>
                    @if (_ragSession != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(_ragSession.IndexedChunkCount > 0 ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                            @_ragSession.IndexedChunkCount chunk(s)
                        </MudChip>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_ragNotice))
                {
                    <MudAlert Severity="@_ragNoticeSeverity" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        @_ragNotice
                    </MudAlert>
                }

                <div class="poliza-rag-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Schema"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantFields">
                        Campos
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Rule"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantValidation">
                        Validacion
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Troubleshoot"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistantMapping">
                        Mapeo
                    </MudButton>
                </div>

                <div class="poliza-rag-question">
                    <MudTextField @bind-Value="_ragQuestion"
                                  Placeholder="Pregunta sobre el archivo cargado..."
                                  Variant="Variant.Outlined"
                                  Lines="1"
                                  Disabled="@(_ragBusy || _busy)"
                                  Immediate="true" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               Disabled="@(!CanAskAssistant)"
                               OnClick="AskAssistant">
                        Preguntar
                    </MudButton>
                    @if (_ragBusy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                </div>

                @if (_ragAnswer != null)
                {
                    <div class="poliza-rag-answer">
                        <div class="poliza-rag-answer-head">
                            <strong>Respuesta</strong>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@(_ragAnswer.AnsweredFromDocuments ? Color.Success : Color.Info)"
                                     Variant="Variant.Outlined">
                                @(_ragAnswer.AnsweredFromDocuments ? "Basada en el archivo" : "Resumen de validacion")
                            </MudChip>
                        </div>
                        <p>@_ragAnswer.Answer</p>
                        @if (_ragAnswer.Citations.Count > 0)
                        {
                            <div class="poliza-rag-citations">
                                @foreach (var citation in _ragAnswer.Citations.Take(3))
                                {
                                    <div>
                                        <span>@citation.DocumentName - @CitationLocation(citation)</span>
                                        <small>@citation.Snippet</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (_preview != null)
        {
            @if (MissingAccountHelpFields.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    <strong>Falta para importar:</strong> @string.Join(", ", MissingAccountHelpFields)
                </MudAlert>
            }
            <MudDivider Class="my-3" />
            <div class="poliza-ai-summary">
                <div><span>Debe</span><strong>@Money(_preview.TotalDebe)</strong></div>
                <div><span>Haber</span><strong>@Money(_preview.TotalHaber)</strong></div>
                <div><span>Diferencia</span><strong class="@(_preview.EstaCuadrada ? "ok" : "warn")">@Money(_preview.Diferencia)</strong></div>
                <div><span>Movimientos</span><strong>@_preview.Details.Count</strong></div>
            </div>

            @if (_preview.Messages.Count > 0)
            {
                <MudAlert Severity="@(_preview.CanImport ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var message in _preview.Messages)
                    {
                        <div>@FormatMessage(message)</div>
                    }
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Validaciones correctas. La poliza esta cuadrada y lista para importar.
                </MudAlert>
            }

            <MudTable Items="@_preview.Details" Dense="true" Hover="true" Class="mt-3 poliza-ai-preview-table" Height="260px" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Fila</MudTh>
                    <MudTh>Cuenta</MudTh>
                    <MudTh>Concepto</MudTh>
                    <MudTh>Debe</MudTh>
                    <MudTh>Haber</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RowNumber</MudTd>
                    <MudTd>
                        @if (IsDoubleAmount(context) && _selectedCuentaDebe != null && _selectedCuentaHaber != null)
                        {
                            <MudText Typo="Typo.body2">Debe: @_selectedCuentaDebe.Text</MudText>
                            <MudText Typo="Typo.body2">Haber: @_selectedCuentaHaber.Text</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@context.Cuenta</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CuentaDescripcion</MudText>
                        }
                    </MudTd>
                    <MudTd>@context.Descripcion</MudTd>
                    <MudTd>@Money(context.ImporteDebe ?? 0m)</MudTd>
                    <MudTd>@Money(context.ImporteHaber ?? 0m)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
</MudDialog>

<style>
    .poliza-ai-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .poliza-ai-dropzone {
        display: grid;
        place-items: center;
        gap: 4px;
        min-height: 72px;
        margin-top: 12px;
        border: 1px dashed var(--mud-palette-lines-inputs);
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        text-align: center;
    }

    .poliza-ai-dropzone span {
        font-weight: 650;
    }

    .poliza-ai-dropzone small {
        color: var(--mud-palette-text-secondary);
    }

    .poliza-ai-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 8px;
    }

    .poliza-ai-summary div {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 8px;
        background: var(--mud-palette-surface);
    }

    .poliza-ai-summary span,
    .poliza-ai-summary strong {
        display: block;
    }

    .poliza-ai-summary span {
        color: var(--mud-palette-text-secondary);
        font-size: 0.76rem;
    }

    .poliza-ai-summary .ok {
        color: #28745b;
    }

    .poliza-ai-summary .warn {
        color: #a35200;
    }

    .poliza-rag-context,
    .poliza-rag-actions,
    .poliza-rag-question {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .poliza-rag-actions {
        margin-top: 8px;
    }

    .poliza-rag-question {
        margin-top: 8px;
    }

    .poliza-rag-question .mud-input-control {
        flex: 1 1 320px;
    }

    .poliza-rag-answer {
        margin-top: 10px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px;
        background: var(--mud-palette-surface);
        max-height: 230px;
        overflow-y: auto;
    }

    .poliza-rag-answer-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .poliza-rag-answer p {
        margin: 6px 0 0;
        white-space: pre-wrap;
    }

    .poliza-rag-citations {
        display: grid;
        gap: 6px;
        margin-top: 10px;
    }

    .poliza-rag-citations div {
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-top: 6px;
    }

    .poliza-rag-citations span,
    .poliza-rag-citations small {
        display: block;
        color: var(--mud-palette-text-secondary);
    }

    .poliza-ai-preview-table .mud-table-container {
        overflow-x: auto;
    }
</style>

@code {
    [Parameter] public string CurrencySymbol { get; set; } = "$";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly string _inputId = $"poliza-ai-upload-{Guid.NewGuid():N}";
    private readonly PolizaAiImportHeaderRequest _header = new()
    {
        FechaPoliza = DateTime.Today,
        FkidMesSis = DateTime.Today.Month,
        PermitirModificar = true
    };

    private IBrowserFile? _file;
    private PolizaAiImportPreviewResponse? _preview;
    private LookupItem? _selectedTipoPoliza;
    private LookupItem? _selectedCuentaDebe;
    private LookupItem? _selectedCuentaHaber;
    private List<PolizaAiImportDetailRequest> _baseDetails = [];
    private List<PolizaAiImportValidationMessage> _baseMessages = [];
    private DateTime? _fechaPoliza = DateTime.Today;
    private DocumentRagSessionResponse? _ragSession;
    private DocumentRagAskResponse? _ragAnswer;
    private string _ragQuestion = string.Empty;
    private string? _indexedFileKey;
    private string _ragNotice = string.Empty;
    private Severity _ragNoticeSeverity = Severity.Info;
    private bool _busy;
    private bool _ragBusy;
    private bool _ragReleased;
    private bool _isRagExpanded;

    private bool CanImport => _preview?.CanImport == true
        && _preview.EstaCuadrada
        && !_busy
        && MissingHeaderFields.Count == 0;
    private IReadOnlyList<string> MissingHeaderFields => BuildMissingHeaderFields();
    private IReadOnlyList<string> MissingAccountHelpFields => BuildMissingAccountHelpFields();
    private string FirstBlockingError => _preview?.Messages.FirstOrDefault(IsError) is { } message
        ? FormatMessage(message)
        : "No hay errores pendientes.";
    private string ImportBlockReason
    {
        get
        {
            if (_busy)
                return "Proceso en curso.";
            if (_file == null)
                return "Selecciona un archivo.";

            var missingHeader = MissingHeaderFields;
            if (missingHeader.Count > 0)
                return $"Falta: {string.Join(", ", missingHeader)}.";

            if (_preview == null)
                return "Analiza el archivo primero.";

            var missingAccounts = MissingAccountHelpFields;
            if (missingAccounts.Count > 0)
                return $"Falta: {string.Join(", ", missingAccounts)}.";

            if (!_preview.EstaCuadrada)
                return $"La poliza no esta cuadrada. Diferencia {Money(_preview.Diferencia)}.";

            return _preview.Messages.Any(IsError)
                ? $"Corrige: {FirstBlockingError}"
                : string.Empty;
        }
    }
    private bool CanAskAssistant => (_preview != null || _ragSession?.IndexedChunkCount > 0)
        && !_busy
        && !_ragBusy
        && !string.IsNullOrWhiteSpace(_ragQuestion);
    private string EmpresaText => _header.FkidEmpresaSis is > 0
        ? $"{_header.FkidEmpresaSis} - {SucursalStateService.EmpresaNombre}"
        : "Sin empresa seleccionada";
    private string HeaderAnioText => _header.Anio?.ToString(CultureInfo.InvariantCulture)
        ?? AnioStateService.AnioClave?.ToString(CultureInfo.InvariantCulture)
        ?? "-";

    private static readonly IReadOnlyList<MonthOption> MonthOptions =
    [
        new(1, "Enero"),
        new(2, "Febrero"),
        new(3, "Marzo"),
        new(4, "Abril"),
        new(5, "Mayo"),
        new(6, "Junio"),
        new(7, "Julio"),
        new(8, "Agosto"),
        new(9, "Septiembre"),
        new(10, "Octubre"),
        new(11, "Noviembre"),
        new(12, "Diciembre")
    ];

    protected override async Task OnInitializedAsync()
    {
        await AnioStateService.InitializeAsync();
        await SucursalStateService.InitializeAsync();

        _header.FkidEmpresaSis = SucursalStateService.EmpresaId ?? await SucursalStateService.GetEmpresaIdAsync();

        ApplyHeaderAnio();
    }

    private Task OnTipoPolizaChanged(LookupItem? value)
    {
        _selectedTipoPoliza = value;
        _header.FkidTipoPolizaSis = value?.Id;
        _header.TipoPoliza = value?.Text;
        return Task.CompletedTask;
    }

    private Task OnCuentaDebeChanged(LookupItem? value)
    {
        _selectedCuentaDebe = value;
        ApplyManualAccountsAndRefreshAssistant();
        return Task.CompletedTask;
    }

    private Task OnCuentaHaberChanged(LookupItem? value)
    {
        _selectedCuentaHaber = value;
        ApplyManualAccountsAndRefreshAssistant();
        return Task.CompletedTask;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        if (_ragSession != null)
            await ReleaseRagSessionAsync(showSnackbar: false);

        _file = args.GetMultipleFiles(1).FirstOrDefault();
        _preview = null;
        _baseDetails = [];
        _baseMessages = [];
        _selectedCuentaDebe = null;
        _selectedCuentaHaber = null;
        _ragAnswer = null;
        _ragNotice = string.Empty;
        _ragQuestion = string.Empty;
        _indexedFileKey = null;
        _isRagExpanded = false;
    }

    private async Task Analyze()
    {
        if (_file == null)
            return;

        BuildHeader();
        if (_header.FkidAnioSis.GetValueOrDefault() <= 0)
        {
            Snackbar.Add("Selecciona un anio presupuestal en el encabezado.", Severity.Warning);
            return;
        }

        if (_header.FkidEmpresaSis.GetValueOrDefault() <= 0)
        {
            Snackbar.Add("Selecciona una empresa antes de importar la poliza.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var response = await ImportService.PreviewAsync(_header, _file);
            if (response.Data != null)
            {
                _preview = response.Data;
                _header.ClavePoliza = _preview.Header.ClavePoliza;
                _header.NombrePoliza = _preview.Header.NombrePoliza;
                _header.FkidMesSis = _preview.Header.FkidMesSis;
                _fechaPoliza = _preview.Header.FechaPoliza;
                _baseDetails = _preview.Details.Select(CloneDetail).ToList();
                _baseMessages = _preview.Messages.ToList();
                ApplyManualAccountsToPreview();
            }

            if (_preview != null)
                await IndexFileForRagAsync();

            Snackbar.Add(response.Message, response.Data?.CanImport == true ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Import()
    {
        ApplyManualAccountsToPreview();
        if (_preview == null || !CanImport)
            return;

        _busy = true;
        try
        {
            BuildHeader();
            SyncPreviewHeader();
            var details = BuildDetailsForImport();
            var response = await ImportService.ConfirmAsync(new PolizaAiImportConfirmRequest
            {
                SourceFileName = _preview.SourceFileName,
                Header = _preview.Header,
                Details = details
            });

            if (response.Success)
            {
                Snackbar.Add(response.Message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(response.Data?.Poliza));
                return;
            }

            _preview = response.Data ?? _preview;
            _baseDetails = _preview.Details.Select(CloneDetail).ToList();
            _baseMessages = _preview.Messages.ToList();
            ApplyManualAccountsToPreview();
            Snackbar.Add(response.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void BuildHeader()
    {
        _header.FechaPoliza = _fechaPoliza ?? DateTime.Today;
        ApplyHeaderAnio();
        _header.FkidTipoPolizaSis = _selectedTipoPoliza?.Id ?? _header.FkidTipoPolizaSis;
        _header.TipoPoliza = _selectedTipoPoliza?.Text ?? _header.TipoPoliza;
        _header.FkidEmpresaSis ??= SucursalStateService.EmpresaId;
    }

    private void ApplyHeaderAnio()
    {
        if (AnioStateService.AnioId is > 0)
        {
            _header.FkidAnioSis = AnioStateService.AnioId.Value;
        }

        _header.Anio = AnioStateService.AnioClave ?? _header.Anio;
    }

    private void SyncPreviewHeader()
    {
        if (_preview == null)
            return;

        _preview.Header.FkidEmpresaSis = _header.FkidEmpresaSis;
        _preview.Header.FkidAnioSis = _header.FkidAnioSis;
        _preview.Header.Anio = _header.Anio;
        _preview.Header.FkidMesSis = _header.FkidMesSis;
        _preview.Header.Mes = _header.Mes;
        _preview.Header.FkidTipoPolizaSis = _header.FkidTipoPolizaSis;
        _preview.Header.TipoPoliza = _header.TipoPoliza;
        _preview.Header.ClavePoliza = _header.ClavePoliza;
        _preview.Header.NombrePoliza = _header.NombrePoliza;
        _preview.Header.FechaPoliza = _header.FechaPoliza;
        _preview.Header.PermitirModificar = _header.PermitirModificar;
        _preview.Header.Autorizado = _header.Autorizado;
    }

    private async Task IndexFileForRagAsync()
    {
        if (_file == null)
            return;

        var fileKey = GetFileKey(_file);
        if (_ragSession?.IndexedChunkCount > 0 && string.Equals(_indexedFileKey, fileKey, StringComparison.Ordinal))
        {
            _ragNoticeSeverity = Severity.Info;
            _ragNotice = "El archivo actual ya esta indexado para consultas.";
            return;
        }

        _ragBusy = true;
        _ragNotice = "Indexando archivo para RAG...";
        _ragNoticeSeverity = Severity.Info;
        try
        {
            if (!await EnsureRagSessionAsync())
                return;

            var response = await RagService.UploadAsync(BuildRagSessionRequest(), _ragSession!.SessionId, _file);
            if (response.Success && response.Data != null)
            {
                await RefreshRagSessionAsync();
                _ragNoticeSeverity = response.Data.ChunkCount > 0 ? Severity.Success : Severity.Warning;
                _ragNotice = response.Data.ChunkCount > 0
                    ? "Archivo indexado para consultas RAG."
                    : response.Data.Message;
                _indexedFileKey = fileKey;
                _ragQuestion = string.IsNullOrWhiteSpace(_ragQuestion)
                    ? "Que me falta para completar correctamente la poliza?"
                    : _ragQuestion;
            }
            else
            {
                _ragNoticeSeverity = Severity.Warning;
                _ragNotice = response.Message ?? "No fue posible indexar el archivo para RAG.";
            }
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private async Task<bool> EnsureRagSessionAsync()
    {
        if (_ragSession != null)
            return true;

        var response = await RagService.CreateSessionAsync(BuildRagSessionRequest());
        if (response.Success && response.Data != null)
        {
            _ragSession = response.Data;
            _ragReleased = false;
            return true;
        }

        _ragNoticeSeverity = Severity.Error;
        _ragNotice = response.Message ?? "No fue posible crear la sesion RAG.";
        return false;
    }

    private async Task RefreshRagSessionAsync()
    {
        if (_ragSession == null)
            return;

        var response = await RagService.GetSessionAsync(_ragSession.SessionId);
        if (response.Success && response.Data != null)
            _ragSession = response.Data;
    }

    private DocumentRagSessionRequest BuildRagSessionRequest() => new()
    {
        Modulo = "Contabilidad",
        SubModulo = "Polizas",
        Controlador = "Poliza",
        Servicio = "AiImport",
        FkidEmpresaSis = _header.FkidEmpresaSis,
        Titulo = $"Poliza {_header.ClavePoliza ?? "sin clave"}",
        Descripcion = $"Empresa: {EmpresaText}. Anio: {HeaderAnioText}. Mes: {_header.FkidMesSis?.ToString() ?? "-"}. Archivo: {_file?.Name ?? "sin archivo"}."
    };

    private static string GetFileKey(IBrowserFile file)
        => $"{file.Name}|{file.Size}|{file.LastModified.ToUnixTimeMilliseconds()}";

