@page "/Contabilidad/Polizas"
@using System.Globalization
@using System.Net.Http.Json
@using EG.Dommain.DTOs.Responses
@using EG.Domain.DTOs.Responses.Contabilidad
@using EG.Web.Contracts
@using EG.Web.Models
@using EG.Web.Models.Platform.SoporteDocumental
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.Reporting
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<PolizaResponse, PolizaResponse>

@inject IGenericCrudService<PolizaDetalleResponse> DetalleService
@inject IGenericCrudService<UsuarioResponse> UsuarioService
@inject HttpClient Http

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        @if (SelectedPoliza == null)
        {
            <div Style="display: flex; flex-direction: column; flex-grow: 1; overflow: hidden; min-height: 0;">
                <PageHeader Title="Pólizas"
                            Subtitle="Administración contable de pólizas y movimientos"
                            Icon="@Icons.Material.Filled.Description"
                            CanCreate="@CanCreate"
                            OnCreate="CreateItem"
                            OnRefresh="() => table.ReloadData()">
                    <AdditionalButtons>
                        <MudTooltip Text="Ayuda IA para subir una poliza">
                            <MudButton StartIcon="@Icons.Material.Filled.AutoAwesome"
                                       Visible="@CanCreate"
                                       OnClick="OpenAiImport"
                                       Disabled="@IsBusy"
                                       Size="Size.Small" />
                        </MudTooltip>
                    </AdditionalButtons>
                </PageHeader>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="PolizaResponse"
                                  @ref="table"
                                  Title="Pólizas contables"
                                  SearchPlaceholder="Buscar por clave, nombre o tipo..."
                                  ShowExportButton="@CanExport"
                                  ServerDataFunc="LoadServerData"
                                  ExportFunc="ExportToExcel"
                                  SearchString="@SearchString"
                                  SearchStringChanged="(s) => SearchString = s"
                                  OnSearch="OnSearch">

                        <Columns>
                            <TemplateColumn T="PolizaResponse" Title="Acciones" Sortable="false" Filterable="false" Hideable="false">
                                <CellTemplate>
                                <MudTooltip Text="Ver detalle">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => SelectPoliza(context.Item))" />
                                </MudTooltip>
                                <DocumentSupportButton Modulo="Contabilidad"
                                                       SubModulo="Polizas"
                                                       Controlador="Poliza"
                                                       EntidadId="@context.Item.PkidPoliza"
                                                       RegistroTitulo="@TextOrDash(context.Item.ClavePoliza)"
                                                       RegistroDescripcion="@TextOrDash(context.Item.NombrePoliza)" />
                                <MudTooltip Text="@FirmaTooltip(context.Item)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   Disabled="@(_preparingFirmaPolizaId == context.Item.PkidPoliza || !context.Item.PuedeEnviarFirma)"
                                                   OnClick="@(() => PrepararPolizaParaFirma(context.Item, true))" />
                                </MudTooltip>
                                @if (context.Item.PuedeRechazarFirma)
                                {
                                    <MudTooltip Text="Rechazar envío y habilitar un nuevo intento">
                                        <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       Disabled="@(_preparingFirmaPolizaId == context.Item.PkidPoliza)"
                                                       OnClick="@(() => RechazarEnvioFirma(context.Item))" />
                                    </MudTooltip>
                                }
                                <ReportOpenButton ReportName="@PolizaReportName"
                                                  EntityId="@context.Item.PkidPoliza"
                                                  Title="@($"Reporte poliza {context.Item.ClavePoliza}")"
                                                  Tooltip="Ver reporte de poliza"
                                                  Color="Color.Secondary"
                                                  Visible="@CanView" />
                                <ReportDesignerOpenButton ReportName="@PolizaReportName"
                                                          Title="Disenador reporte poliza"
                                                          Tooltip="Editar diseno del reporte de poliza"
                                                          Color="Color.Primary"
                                                          Visible="@CanUpdate" />
                                <MudTooltip Text="Editar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Visible="@CanUpdate"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => EditItem(context.Item.PkidPoliza))" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Visible="@CanDelete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteItem(context.Item.PkidPoliza))" />
                                </MudTooltip>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="int" Property="x => x.PkidPoliza" Title="ID" Identifier="PkidPoliza" />
                            <PropertyColumn T="PolizaResponse" TProperty="string" Property="x => x.ClavePoliza" Title="Clave" Identifier="ClavePoliza">
                                <CellTemplate>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@TextOrDash(context.Item.ClavePoliza)</MudChip>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="string" Property="x => x.NombrePoliza" Title="Póliza" Identifier="NombrePoliza" />
                            <PropertyColumn T="PolizaResponse" TProperty="DateTime" Property="x => x.FechaPoliza" Title="Fecha" Identifier="FechaPoliza">
                                <CellTemplate>@context.Item.FechaPoliza.ToString("dd/MM/yyyy")</CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="string" Property="x => x.TipoPoliza" Title="Tipo" Identifier="TipoPoliza" />
                            <PropertyColumn T="PolizaResponse" TProperty="decimal" Property="x => x.TotalDebe" Title="Debe" Identifier="TotalDebe">
                                <CellTemplate>@Money(context.Item.TotalDebe)</CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="decimal" Property="x => x.TotalHaber" Title="Haber" Identifier="TotalHaber">
                                <CellTemplate>@Money(context.Item.TotalHaber)</CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="decimal?" Property="x => x.Diferencia" Title="Diferencia" Identifier="Diferencia">
                                <CellTemplate>
                                    <MudText Color="@DiferenciaColor(context.Item.Diferencia)" Typo="Typo.body2">
                                        @Money(context.Item.Diferencia ?? 0m)
                                    </MudText>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="bool" Property="x => x.EstaBalanceado" Title="Balance" Identifier="EstaBalanceado">
                                <CellTemplate>
                                    <MudChip T="string" Color="@(context.Item.EstaBalanceado ? Color.Success : Color.Warning)" Size="Size.Small">
                                        @(context.Item.EstaBalanceado ? "Balanceada" : "Pendiente")
                                    </MudChip>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn T="PolizaResponse" TProperty="bool?" Property="x => x.Autorizado" Title="Autorización" Identifier="Autorizado">
                                <CellTemplate>
                                    <MudChip T="string" Color="@(context.Item.Autorizado == true ? Color.Success : Color.Default)" Size="Size.Small">
                                        @(context.Item.Autorizado == true ? "Autorizada" : "Sin autorizar")
                                    </MudChip>
                                </CellTemplate>
                            </PropertyColumn>
                            <TemplateColumn T="PolizaResponse" Title="Firma" Identifier="EstadoFirma" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    <MudChip T="string" Color="@WorkflowStatusColor(context.Item.EstadoFirma)" Size="Size.Small">
                                        @WorkflowStatusText(context.Item.EstadoFirma)
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </GenericDataGrid>
                </div>
            </div>
        }
        else
        {
            <div Class="d-flex flex-column" Style="flex-grow: 1; overflow: hidden; min-height: 0; gap: 8px;">
                <MudPaper Elevation="0" Class="pa-0 d-flex align-center" Style="background: transparent; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   OnClick="BackToTable"
                                   Tooltip="Volver al listado" />
                    <div class="ml-2">
                        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.15;">
                            @SelectedPoliza.ClavePoliza
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @TextOrDash(SelectedPoliza.NombrePoliza)
                        </MudText>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedPoliza.EstaBalanceado ? Color.Success : Color.Warning)">
                        @(SelectedPoliza.EstaBalanceado ? "Balanceada" : "Descuadrada")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@(SelectedPoliza.Autorizado == true ? Color.Success : Color.Default)" Class="ml-1">
                        @(SelectedPoliza.Autorizado == true ? "Autorizada" : "Sin autorizar")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@WorkflowStatusColor(SelectedPoliza.EstadoFirma)" Class="ml-1">
                        Firma: @WorkflowStatusText(SelectedPoliza.EstadoFirma)
                    </MudChip>
                    <DocumentSupportButton Modulo="Contabilidad"
                                           SubModulo="Polizas"
                                           Controlador="Poliza"
                                           EntidadId="@SelectedPoliza.PkidPoliza"
                                           RegistroTitulo="@TextOrDash(SelectedPoliza.ClavePoliza)"
                                           RegistroDescripcion="@TextOrDash(SelectedPoliza.NombrePoliza)" />
                    <MudTooltip Text="@FirmaTooltip(SelectedPoliza)">
                        <MudIconButton Icon="@Icons.Material.Filled.Send"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@(_preparingFirmaPolizaId == SelectedPoliza.PkidPoliza || !SelectedPoliza.PuedeEnviarFirma)"
                                       OnClick="@(() => PrepararPolizaParaFirma(SelectedPoliza, true))"
                                       Class="ml-1" />
                    </MudTooltip>
                    @if (SelectedPoliza.PuedeRechazarFirma)
                    {
                        <MudTooltip Text="Rechazar envío y habilitar un nuevo intento">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           Disabled="@(_preparingFirmaPolizaId == SelectedPoliza.PkidPoliza)"
                                           OnClick="@(() => RechazarEnvioFirma(SelectedPoliza))"
                                           Class="ml-1" />
                        </MudTooltip>
                    }
                    <ReportOpenButton ReportName="@PolizaReportName"
                                      EntityId="@SelectedPoliza.PkidPoliza"
                                      Title="@($"Reporte poliza {SelectedPoliza.ClavePoliza}")"
                                      Tooltip="Ver reporte de poliza"
                                      Color="Color.Secondary"
                                      Visible="@CanView" />
                    <ReportDesignerOpenButton ReportName="@PolizaReportName"
                                              Title="Disenador reporte poliza"
                                              Tooltip="Editar diseno del reporte de poliza"
                                              Color="Color.Primary"
                                              Visible="@CanUpdate" />
                    <MudTooltip Text="Editar póliza">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Visible="@CanUpdate"
                                       OnClick="EditSelectedPoliza"
                                       Class="ml-2" />
                    </MudTooltip>
                    <MudTooltip Text="Agregar movimiento">
                        <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Visible="@CanCreate"
                                       OnClick="AddDetalle"
                                       Class="ml-1" />
                    </MudTooltip>
                    <MudTooltip Text="Actualizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="RefreshSelectedAndDetails"
                                       Class="ml-1" />
                    </MudTooltip>
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-3" Style="flex-shrink: 0; border-radius: 8px;">
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Fecha</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@SelectedPoliza.FechaPoliza.ToString("dd/MM/yyyy")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Periodo</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@SelectedPoliza.Mes @SelectedPoliza.Anio</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Tipo</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@TextOrDash(SelectedPoliza.TipoPoliza)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Debe</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@Money(SelectedPoliza.TotalDebe)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Haber</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@Money(SelectedPoliza.TotalHaber)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Diferencia</MudText>
                            <MudText Typo="Typo.body2" Color="@DiferenciaColor(SelectedPoliza.Diferencia)" Style="font-weight: 700;">
                                @Money(SelectedPoliza.Diferencia ?? 0m)
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">Movimientos</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@SelectedPoliza.TotalDetalles</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
                    <GenericDataGrid TItem="PolizaDetalleResponse"
                                  @ref="detalleTable"
                                  Title="Movimientos contables"
                                  SearchPlaceholder="Buscar por cuenta, concepto o tipo..."
                                  ShowExportButton="false"
                                  PageSize="10"
                                  ServerDataFunc="LoadDetallesServerData"
                                  SearchString="@detalleSearchString"
                                  SearchStringChanged="(s) => detalleSearchString = s"
                                  OnSearch="ReloadDetalles">
            <Columns>
                <TemplateColumn T="PolizaDetalleResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Editar movimiento">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditDetalle(cell.Item.PkidPolizaDetalle))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar movimiento">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteDetalle(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="ID" Identifier="PkidPolizaDetalle" PropertyName="PkidPolizaDetalle" SortBy="x => x.PkidPolizaDetalle">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidPolizaDetalle
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="Cuenta" Identifier="CuentaClave" PropertyName="CuentaClave" SortBy="x => x.CuentaClave">
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@TextOrDash(cell.Item.CuentaClave)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TextOrDash(cell.Item.CuentaDescripcion)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="Concepto" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Descripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="Tipo" Identifier="TipoDetallePoliza" PropertyName="TipoDetallePoliza" SortBy="x => x.TipoDetallePoliza">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.TipoDetallePoliza)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="Debe" Identifier="ImporteDebe" PropertyName="ImporteDebe" SortBy="x => x.ImporteDebe">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.ImporteDebe ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PolizaDetalleResponse" Title="Haber" Identifier="ImporteHaber" PropertyName="ImporteHaber" SortBy="x => x.ImporteHaber">
                    <CellTemplate Context="cell">
                        @Money(cell.Item.ImporteHaber ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
                </div>
            </div>
        }
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<PolizaResponse> table = null!;
    private GenericDataGrid<PolizaDetalleResponse> detalleTable = null!;
    private PolizaResponse? SelectedPoliza;
    private string detalleSearchString = string.Empty;
    private string _currencySymbol = "$";
    private int? _preparingFirmaPolizaId;
    private const string PolizaReportName = "Report_Polizas";

    protected override string ModuleName => "Contabilidad";
    protected override string SubModuleName => "Polizas";

    protected override Type CreateDialogType => typeof(PolizaDialog);
    protected override Type EditDialogType => typeof(PolizaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<PolizaResponse>);

    protected override string GetDefaultSortLabel() => "FechaPoliza";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadCurrencyAsync();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<PolizaResponse> items)
    {
        return items.Select(item => new
        {
            ID = item.PkidPoliza,
            Clave = item.ClavePoliza,
            Poliza = item.NombrePoliza,
            Fecha = item.FechaPoliza.ToString("dd/MM/yyyy"),
            Anio = item.Anio,
            Mes = item.Mes,
            Tipo = item.TipoPoliza,
            Debe = item.TotalDebe,
            Haber = item.TotalHaber,
            Diferencia = item.Diferencia ?? 0m,
            Balanceada = item.EstaBalanceado ? "Si" : "No",
            Autorizada = item.Autorizado == true ? "Si" : "No",
            UsuarioCreacion = item.UsuarioCreacion,
            FechaCreacion = item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty,
            UsuarioModificacion = item.UsuarioModificacion,
            FechaModificacion = item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty
        });
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        var response = await Service.GetByIdAsync(id);
        return response?.Data?.ClavePoliza ?? "la póliza";
    }

    protected override async Task ReloadData()
    {
        if (SelectedPoliza != null)
        {
            await RefreshSelectedPoliza();
            return;
        }

        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async Task SelectPoliza(PolizaResponse poliza)
    {
        SelectedPoliza = poliza;
        detalleSearchString = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task BackToTable()
    {
        SelectedPoliza = null;
        detalleSearchString = string.Empty;
        await InvokeAsync(StateHasChanged);

        if (table != null)
        {
            await table.ReloadData();
        }
    }

    private async Task<TableData<PolizaDetalleResponse>> LoadDetallesServerData(TableState state, CancellationToken cancellationToken)
    {
        if (SelectedPoliza == null)
        {
            return new TableData<PolizaDetalleResponse> { Items = new List<PolizaDetalleResponse>(), TotalItems = 0 };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detalleSearchString,
            state.SortLabel ?? "CuentaClave",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidPolizaConta"] = SelectedPoliza.PkidPoliza });

        return new TableData<PolizaDetalleResponse>
        {
            Items = response?.Items ?? new List<PolizaDetalleResponse>(),
            TotalItems = response?.TotalCount ?? 0
        };
    }

    private async Task EditSelectedPoliza()
    {
        if (SelectedPoliza == null)
        {
            return;
        }

        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Id"] = SelectedPoliza.PkidPoliza };
        var dialog = await DialogService.ShowAsync<PolizaDialog>(
            "Editar Póliza",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSelectedAndDetails();
        }
    }

    private async Task AddDetalle()
    {
        if (SelectedPoliza == null)
        {
            Snackbar.Add("Selecciona una póliza primero.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["PolizaId"] = SelectedPoliza.PkidPoliza,
            ["PolizaClave"] = SelectedPoliza.ClavePoliza,
            ["PolizaNombre"] = SelectedPoliza.NombrePoliza,
            ["CurrencySymbol"] = _currencySymbol
        };

        var dialog = await DialogService.ShowAsync<PolizaDetalleDialog>(
            "Agregar Movimiento",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSelectedAndDetails();
        }
    }

    private async Task OpenAiImport()
    {
        if (!CanCreate)
        {
            Snackbar.Add("No tienes permisos para crear polizas.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["CurrencySymbol"] = _currencySymbol
        };

        var dialog = await DialogService.ShowAsync<PolizaAiImportDialog>(
            "Ayuda IA para poliza",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            if (result.Data is PolizaResponse imported)
            {
                SelectedPoliza = imported;
                await RefreshSelectedAndDetails();
                return;
            }

            await ReloadData();
        }
    }

    private async Task EditDetalle(int id)
    {
        if (SelectedPoliza == null)
        {
            return;
        }

        if (!CanUpdate)
        {
            Snackbar.Add("No tienes permisos para editar.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["PolizaId"] = SelectedPoliza.PkidPoliza,
            ["PolizaClave"] = SelectedPoliza.ClavePoliza,
            ["PolizaNombre"] = SelectedPoliza.NombrePoliza,
            ["CurrencySymbol"] = _currencySymbol
        };

        var dialog = await DialogService.ShowAsync<PolizaDetalleDialog>(
            "Editar Movimiento",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSelectedAndDetails();
        }
    }

    private async Task DeleteDetalle(PolizaDetalleResponse detalle)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"Eliminar el movimiento {TextOrDash(detalle.Descripcion)}?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/PolizaDetalle/{detalle.PkidPolizaDetalle}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Movimiento eliminado correctamente.", Severity.Success);
                await RefreshSelectedAndDetails();
                return;
            }

            Snackbar.Add(result?.Message ?? "Error al eliminar el movimiento.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    private async Task RefreshSelectedAndDetails()
    {
        await RefreshSelectedPoliza();
        await ReloadDetalles();
    }

    private async Task PrepararPolizaParaFirma(PolizaResponse poliza, bool abrirSoporte)
    {
        if (poliza.PkidPoliza <= 0)
            return;

        if (!poliza.EstaBalanceado)
        {
            Snackbar.Add("La poliza debe estar balanceada antes de enviarla a firma.", Severity.Warning);
            return;
        }

        _preparingFirmaPolizaId = poliza.PkidPoliza;
        try
        {
            var response = await Http.PostAsync($"api/FirmaDocumental/polizas/{poliza.PkidPoliza}/preparar-firma", null);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<DocumentoResponse>>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add("Reporte oficial generado y enviado a firma.", Severity.Success);
                if (SelectedPoliza?.PkidPoliza == poliza.PkidPoliza)
                {
                    await RefreshSelectedPoliza();
                }
                else if (table != null)
                {
                    await table.ReloadData();
                }

                if (abrirSoporte)
                {
                    await OpenPolizaSupportDialog(poliza);
                }

                return;
            }

            Snackbar.Add(result?.Message ?? "No se pudo enviar la poliza a firma.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al preparar firma: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _preparingFirmaPolizaId = null;
        }
    }

    private async Task RechazarEnvioFirma(PolizaResponse poliza)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            "¿Rechazar el envío a firma? La acción de enviar se habilitará nuevamente.");
        if (!confirm)
        {
            return;
        }

        _preparingFirmaPolizaId = poliza.PkidPoliza;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/FirmaDocumental/polizas/{poliza.PkidPoliza}/rechazar-envio",
                "Rechazado desde la pantalla de pólizas");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Snackbar.Add(result.Message ?? "Envío a firma rechazado.", Severity.Success);
                if (SelectedPoliza?.PkidPoliza == poliza.PkidPoliza)
                {
                    await RefreshSelectedPoliza();
                }
                else if (table != null)
                {
                    await table.ReloadData();
                }

                return;
            }

            Snackbar.Add(result?.Message ?? "No se pudo rechazar el envío a firma.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al rechazar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
        finally
        {
            _preparingFirmaPolizaId = null;
        }
    }

    private async Task OpenPolizaSupportDialog(PolizaResponse poliza)
    {
        var parameters = new DialogParameters
        {
            [nameof(DocumentSupportDialog.Modulo)] = "Contabilidad",
            [nameof(DocumentSupportDialog.SubModulo)] = "Polizas",
            [nameof(DocumentSupportDialog.Controlador)] = "Poliza",
            [nameof(DocumentSupportDialog.EntidadId)] = (long)poliza.PkidPoliza,
            [nameof(DocumentSupportDialog.RegistroTitulo)] = TextOrDash(poliza.ClavePoliza),
            [nameof(DocumentSupportDialog.RegistroDescripcion)] = TextOrDash(poliza.NombrePoliza),
            [nameof(DocumentSupportDialog.CanManage)] = CanUpdate || CanCreate
        };

        var dialog = await DialogService.ShowAsync<DocumentSupportDialog>(
            "Soporte documental",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = false,
                BackgroundClass = "document-support-backdrop",
                CloseOnEscapeKey = true
            });

        await dialog.Result;
    }

    private async Task RefreshSelectedPoliza()
    {
        if (SelectedPoliza == null)
        {
            return;
        }

        var response = await Service.GetByIdAsync(SelectedPoliza.PkidPoliza);
        if (response?.Success == true && response.Data != null)
        {
            SelectedPoliza = response.Data;
            StateHasChanged();
        }
    }

    private async Task ReloadDetalles()
    {
        if (detalleTable != null)
        {
            await detalleTable.ReloadData();
        }
    }

    private static string TextOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private string Money(decimal value) => $"{_currencySymbol}{value.ToString("0.00", NumberCulture)}";

    private static Color DiferenciaColor(decimal? diferencia) =>
        decimal.Round(diferencia ?? 0m, 2) == 0m ? Color.Success : Color.Warning;

    private static string FirmaTooltip(PolizaResponse item) =>
        item.PuedeEnviarFirma
            ? "Generar reporte oficial y enviarlo a firma"
            : $"Envío bloqueado: estado {WorkflowStatusText(item.EstadoFirma)}";

    private static string WorkflowStatusText(string? status) => status?.ToUpperInvariant() switch
    {
        "PROCESANDO" => "Procesando",
        "ENVIADO" => "Enviado",
        "RECHAZADO" => "Rechazado",
        _ => "Pendiente"
    };

    private static Color WorkflowStatusColor(string? status) => status?.ToUpperInvariant() switch
    {
        "PROCESANDO" => Color.Info,
        "ENVIADO" => Color.Success,
        "RECHAZADO" => Color.Warning,
        _ => Color.Default
    };

    private async Task LoadCurrencyAsync()
    {
        try
        {
            var userIdString = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (int.TryParse(userIdString, out var userId) && userId > 0)
            {
                var response = await UsuarioService.GetByIdAsync(userId);
                if (response?.Success == true && response.Data != null)
                {
                    _currencySymbol = string.IsNullOrWhiteSpace(response.Data.SimboloMonedaBase) ? "$" : response.Data.SimboloMonedaBase;
                }
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("Polizas")
                .LogWarning(ex, "No se pudo cargar la moneda configurada para polizas.");
            AppSnackbar.Add("No se pudo confirmar la moneda de la empresa; se mostrara la moneda predeterminada.", Severity.Warning);
        }
    }
}
