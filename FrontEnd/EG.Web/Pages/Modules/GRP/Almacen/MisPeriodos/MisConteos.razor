@page "/ALMAConteo"
@page "/configuracion/almacen/Numero_Conteo"
@using System.Globalization
@using EG.Domain.DTOs.Responses.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Shared
@using EG.Web.Contracts
@inherits BaseCrudPage<ConteoResponse, ConteoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-2 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh;">

        <PageHeader Title="Mis Períodos de Conteo"
                    Subtitle="Gestión y seguimiento de los conteos cíclicos de inventario"
                    Icon="@Icons.Material.Filled.ListAlt"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => tableConteos.ReloadData()" />

        <MudTabs Elevation="2"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-4"
                 Class="mt-2"
                 ActivePanelIndex="@tabActivo"
                 ActivePanelIndexChanged="OnTabChanged">

            <!-- ========== TAB 1: CONTEOS ========== -->
            <MudTabPanel Text="Conteos" Icon="@Icons.Material.Filled.FactCheck" BadgeData="@TotalCount.ToString()" BadgeColor="Color.Primary">

                <GenericDataGrid TItem="ConteoResponse"
                              @ref="tableConteos"
                              Title="Lista de Conteos Cíclicos"
                              SearchPlaceholder="Buscar por descripción, tipo de bien, período..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerData"
                              ExportFunc="ExportToExcel"
                              SearchString="@SearchString"
                              SearchStringChanged="(s) => SearchString = s"
                              OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="ConteoResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Escanear Bienes">
                        <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner"
                        Color="Color.Success"
                        Size="Size.Small"
                        Disabled="@(!EsEstatus(cell.Item, "En Proceso"))"
                        OnClick="@(() => AbrirScanner(cell.Item))" />
                        </MudTooltip>
                        <DocumentSupportButton Modulo="conteociclico"
                        SubModulo="mis-periodos"
                        Controlador="Conteo"
                        EntidadId="@cell.Item.PkidConteo"
                        RegistroTitulo="@cell.Item.Descripcion"
                        RegistroDescripcion="@($"Periodo {cell.Item.NombrePeriodo}")" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Disabled="@(!PuedeEditarConteo(cell.Item))"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidConteo))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Disabled="@(!PuedeEditarConteo(cell.Item))"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidConteo))" />
                        </MudTooltip>
                        <MudTooltip Text="Ver Escaneos">
                        <MudIconButton Icon="@Icons.Material.Filled.List"
                        Color="Color.Secondary"
                        Size="Size.Small"
                        OnClick="@(() => VerEscaneosDeConteo(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="ID" Identifier="PkidConteo" PropertyName="PkidConteo" SortBy="x => x.PkidConteo">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidConteo
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Descripción" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        @cell.Item.Descripcion
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Tipo de Bien" Identifier="DescripcionTipoBien" PropertyName="DescripcionTipoBien" SortBy="x => x.DescripcionTipoBien">
                    <CellTemplate Context="cell">
                        <div>
                        <MudText Typo="Typo.body2">@cell.Item.DescripcionTipoBien</MudText>
                        @if (!string.IsNullOrEmpty(cell.Item.CodigoClaveTipoBien))
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cell.Item.CodigoClaveTipoBien</MudText>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Período" Identifier="NombrePeriodo" PropertyName="NombrePeriodo" SortBy="x => x.NombrePeriodo">
                    <CellTemplate Context="cell">
                        <div>
                        <MudText Typo="Typo.body2">@cell.Item.NombrePeriodo</MudText>
                        @if (!string.IsNullOrEmpty(cell.Item.CodigoPeriodo))
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cell.Item.CodigoPeriodo</MudText>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Fecha Inicio" Identifier="FechaInicio" PropertyName="FechaInicio" SortBy="x => x.FechaInicio">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaInicio.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Estatus" Identifier="EstatusPeriodo" PropertyName="EstatusPeriodo" SortBy="x => x.EstatusPeriodo">
                    <CellTemplate Context="cell">
                        <MudChip T="string"
                        Color="@GetEstatusColor(cell.Item.EstatusPeriodo)"
                        Size="Size.Small">
                        @(cell.Item.EstatusPeriodo ?? "–")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Estado" Identifier="EstadoConteo" PropertyName="EstadoConteo" SortBy="x => x.EstadoConteo">
                    <CellTemplate Context="cell">
                        <MudChip T="string"
                        Color="@GetEstadoConteoColor(cell.Item.EstadoConteo)"
                        Size="Size.Small">
                        @(cell.Item.EstadoConteo ?? "–")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Cantidad Inventario" Identifier="CantidadInventario" PropertyName="CantidadInventario" SortBy="x => x.CantidadInventario">
                    <CellTemplate Context="cell">
                        @if (EsEstatus(cell.Item, "En Proceso"))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VisibilityOff">
                                Conteo ciego
                            </MudChip>
                        }
                        else
                        {
                            <MudText Align="Align.Right">@Quantity(cell.Item.CantidadInventario)</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Lecturas" Identifier="TotalLecturas" PropertyName="TotalLecturas" SortBy="x => x.TotalLecturas">
                    <CellTemplate Context="cell">
                        <MudBadge Content="@cell.Item.TotalLecturas" Color="Color.Info" Overlap="true">
                        <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Size="Size.Small" />
                        </MudBadge>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Diferencia" Identifier="Diferencia">
                    <CellTemplate Context="cell">
                        @if (EsEstatus(cell.Item, "Completado") || EsEstatus(cell.Item, "Cerrado"))
                        {
                            <MudChip T="string" Size="Size.Small" Color="@GetDifferenceColor(cell.Item)" Variant="Variant.Outlined">
                                @FormatDifference(cell.Item)
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Disponible al completar</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Personas" Identifier="PersonasParticipantes" PropertyName="PersonasParticipantes" SortBy="x => x.PersonasParticipantes">
                    <CellTemplate Context="cell">
                        <MudBadge Content="@cell.Item.PersonasParticipantes" Color="Color.Success" Overlap="true">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        </MudBadge>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </MudTabPanel>

            <!-- ========== TAB 2: ESCANEOS / LECTURAS ========== -->
            <MudTabPanel Text="Escaneos / Lecturas" Icon="@Icons.Material.Filled.QrCodeScanner" BadgeData="@TotalEscaneos.ToString()" BadgeColor="Color.Secondary">

                @if (conteoSeleccionado != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                        <MudText>
                            Mostrando escaneos del conteo:
                            <strong>@conteoSeleccionado.Descripcion</strong>
                            (ID: @conteoSeleccionado.PkidConteo)
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                       Size="Size.Small"
                                       OnClick="LimpiarFiltroConteo"
                                       title="Ver todos los escaneos" />
                    </MudAlert>
                }

                <GenericDataGrid TItem="ConteoDetalleEscaneoResponse"
                              @ref="tableEscaneos"
                              Title="Escaneos de Bienes"
                              SearchPlaceholder="Buscar por código de barras, bien, persona..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerDataEscaneos"
                              ExportFunc="ExportEscaneosToExcel"
                              SearchString="@SearchStringEscaneos"
                              SearchStringChanged="(s) => SearchStringEscaneos = s"
                              OnSearch="OnSearchEscaneos">
            <Columns>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="ID" Identifier="PkidDetalleEscaneo" PropertyName="PkidDetalleEscaneo" SortBy="x => x.PkidDetalleEscaneo">
                    <CellTemplate Context="cell">
                        @cell.Item.PkidDetalleEscaneo
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Código de Barras" Identifier="CodigoBarras" PropertyName="CodigoBarras" SortBy="x => x.CodigoBarras">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Color="Color.Dark" Size="Size.Small">
                        @cell.Item.CodigoBarras
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Persona" Identifier="PersonaNombre" PropertyName="PersonaNombre" SortBy="x => x.PersonaNombre">
                    <CellTemplate Context="cell">
                        @cell.Item.PersonaNombre @cell.Item.PersonaPaterno @cell.Item.PersonaMaterno
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Clave Persona" Identifier="PersonaClave" PropertyName="PersonaClave" SortBy="x => x.PersonaClave">
                    <CellTemplate Context="cell">
                        @cell.Item.PersonaClave
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Clave Bien" Identifier="BienClave" PropertyName="BienClave" SortBy="x => x.BienClave">
                    <CellTemplate Context="cell">
                        @cell.Item.BienClave
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Bien" Identifier="BienDescripcion" PropertyName="BienDescripcion" SortBy="x => x.BienDescripcion">
                    <CellTemplate Context="cell">
                        <div>
                        <MudText Typo="Typo.body2">@cell.Item.BienDescripcion</MudText>
                        @if (!string.IsNullOrEmpty(cell.Item.BienModelo))
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Modelo: @cell.Item.BienModelo</MudText>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Serie" Identifier="BienSerie" PropertyName="BienSerie" SortBy="x => x.BienSerie">
                    <CellTemplate Context="cell">
                        @cell.Item.BienSerie
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Tipo de Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        <div>
                        <MudText Typo="Typo.body2">@cell.Item.TipoBienDescripcion</MudText>
                        @if (!string.IsNullOrEmpty(cell.Item.TipoBienCodigoClave))
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cell.Item.TipoBienCodigoClave</MudText>
                        }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoDetalleEscaneoResponse" Title="Fecha Escaneo" Identifier="FechaEscaneo" PropertyName="FechaEscaneo" SortBy="x => x.FechaEscaneo">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaEscaneo.ToString("dd/MM/yyyy HH:mm")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </MudTabPanel>

        </MudTabs>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ConteoResponse> tableConteos = null!;
    private GenericDataGrid<ConteoDetalleEscaneoResponse> tableEscaneos = null!;

    [Inject] private IGenericCrudService<ConteoDetalleEscaneoResponse> EscaneoService { get; set; } = null!;

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Numero_Conteo";

    protected override Type CreateDialogType => typeof(ConteoDialog);
    protected override Type EditDialogType => typeof(ConteoDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ConteoResponse>);

    protected override string GetDefaultSortLabel() => "FechaInicio";

    // Escaneos state
    private List<ConteoDetalleEscaneoResponse> Escaneos { get; set; } = new();
    private int TotalEscaneos { get; set; }
    private string SearchStringEscaneos { get; set; } = string.Empty;
    private CancellationTokenSource SearchCtsEscaneos { get; set; } = new();
    private ConteoResponse? conteoSeleccionado;
    private int tabActivo = 0;

    private async Task OnTabChanged(int index)
    {
        tabActivo = index;
        if (index == 1 && tableEscaneos != null)
        {
            await tableEscaneos.ReloadData();
        }
    }

    private async Task<TableData<ConteoDetalleEscaneoResponse>> LoadServerDataEscaneos(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            int page = state.Page + 1;
            int pageSize = state.PageSize;
            string sortLabel = state.SortLabel ?? "FechaEscaneo";
            var sortDir = state.SortDirection;

            if (conteoSeleccionado != null)
            {
                var selectedResponse = await EscaneoService.GetActionAsync($"ByConteo/{conteoSeleccionado.PkidConteo}");
                if (selectedResponse?.Success != true || selectedResponse.Items == null)
                    return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };

                var selectedItems = selectedResponse.Items.AsEnumerable();
                if (!string.IsNullOrWhiteSpace(SearchStringEscaneos))
                {
                    selectedItems = selectedItems.Where(e =>
                        (e.CodigoBarras?.Contains(SearchStringEscaneos, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (e.BienClave?.Contains(SearchStringEscaneos, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (e.BienDescripcion?.Contains(SearchStringEscaneos, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (e.PersonaNombre?.Contains(SearchStringEscaneos, StringComparison.OrdinalIgnoreCase) ?? false));
                }

                var filteredItems = selectedItems.ToList();
                TotalEscaneos = filteredItems.Count;
                Escaneos = filteredItems.Skip((page - 1) * pageSize).Take(pageSize).ToList();
                return new TableData<ConteoDetalleEscaneoResponse>
                {
                    Items = Escaneos,
                    TotalItems = TotalEscaneos
                };
            }

            var response = await EscaneoService.GetAllPaginadoAsync(
                page, pageSize, SearchStringEscaneos, sortLabel, sortDir);

            if (response?.Success == true && response.Items != null)
            {
                var items = response.Items.ToList();
                Escaneos = items;
                TotalEscaneos = response.TotalCount;

                return new TableData<ConteoDetalleEscaneoResponse>
                {
                    Items = Escaneos,
                    TotalItems = TotalEscaneos
                };
            }

            return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar escaneos: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
            return new TableData<ConteoDetalleEscaneoResponse> { Items = new List<ConteoDetalleEscaneoResponse>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchEscaneos()
    {
        SearchCtsEscaneos?.Cancel();
        SearchCtsEscaneos = new CancellationTokenSource();
        try
        {
            await Task.Delay(500, SearchCtsEscaneos.Token);
            if (!SearchCtsEscaneos.Token.IsCancellationRequested && tableEscaneos != null)
                await tableEscaneos.ReloadData();
        }
        catch (TaskCanceledException ex)
        {
            AppLoggerFactory.CreateLogger("MisConteos")
                .LogDebug(ex, "Se cancelo una busqueda de escaneos por una solicitud mas reciente.");
        }
    }

    private async Task VerEscaneosDeConteo(ConteoResponse conteo)
    {
        conteoSeleccionado = conteo;
        tabActivo = 1;
        StateHasChanged();
        // Cambiar al tab de escaneos
        if (tableEscaneos != null)
            await tableEscaneos.ReloadData();
    }

    private async Task LimpiarFiltroConteo()
    {
        conteoSeleccionado = null;
        StateHasChanged();
        if (tableEscaneos != null)
            await tableEscaneos.ReloadData();
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<ConteoResponse> items)
    {
        return items.Select(c => new
        {
            ID = c.PkidConteo,
            Descripción = c.Descripcion ?? "",
            Tipo_Bien = c.DescripcionTipoBien ?? "",
            Código_Clave = c.CodigoClaveTipoBien ?? "",
            Período = c.NombrePeriodo ?? "",
            Código_Período = c.CodigoPeriodo ?? "",
            Estatus_Período = c.EstatusPeriodo ?? "",
            Estado_Conteo = c.EstadoConteo ?? "",
            Cantidad_Inventario = c.CantidadInventario,
            Total_Cantidad_Contada = c.TotalCantidadContada,
            Total_Lecturas = c.TotalLecturas,
            Personas_Participantes = c.PersonasParticipantes,
            Fecha_Inicio = c.FechaInicio.ToString("dd/MM/yyyy"),
            Fecha_Fin = c.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin definir",
        });
    }

    private async Task ExportEscaneosToExcel()
    {
        if (!CanExport)
        {
            Snackbar.Add("No tienes permisos para exportar", Severity.Warning);
            return;
        }

        try
        {
            var response = await EscaneoService.GetAllPaginadoAsync(1, int.MaxValue, SearchStringEscaneos, "FechaEscaneo", SortDirection.Descending);
            if (response?.Success != true || response.Items == null || !response.Items.Any())
            {
                Snackbar.Add("No hay datos para exportar", Severity.Warning);
                return;
            }

            var items = response.Items.ToList();
            if (conteoSeleccionado != null)
                items = items.Where(e => e.FkidConteoAlma == conteoSeleccionado.PkidConteo).ToList();

            var excelData = items.Select(e => new
            {
                ID = e.PkidDetalleEscaneo,
                Conteo_ID = e.FkidConteoAlma,
                Código_Barras = e.CodigoBarras ?? "",
                Persona = e.PersonaNombre,
                Clave_Persona = e.PersonaClave ?? "",
                Clave_Bien = e.BienClave ?? "",
                Descripción_Bien = e.BienDescripcion ?? "",
                Serie = e.BienSerie ?? "",
                Modelo = e.BienModelo ?? "",
                Tipo_Bien = e.TipoBienDescripcion ?? "",
                Código_Tipo_Bien = e.TipoBienCodigoClave ?? "",
                Fecha_Escaneo = e.FechaEscaneo.ToString("dd/MM/yyyy HH:mm"),
            });

            using var ms = new MemoryStream();
            await ms.SaveAsAsync(excelData);
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JsRuntime.InvokeVoidAsync("downloadFile", base64,
                $"escaneos_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"✅ Exportación exitosa: {items.Count} registros", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {UserFacingExceptionMessages.ForDisplay(AppLoggerFactory, ex)}", Severity.Error);
        }
    }

    protected override async Task<string> GetItemNameForDelete(int id)
    {
        try
        {
            var response = await Service.GetByIdAsync(id);
            return response?.Data?.Descripcion ?? "el conteo";
        }
        catch
        {
            return "el conteo";
        }
    }

    protected override async Task ReloadData()
    {
        if (tableConteos != null)
        {
            await tableConteos.ReloadData();
            StateHasChanged();
        }
    }

    private Color GetEstatusColor(string? estatus) =>
        estatus?.ToLower() switch
        {
            "abierto" or "abierta" => Color.Success,
            "cerrado" or "cerrada" => Color.Error,
            "en proceso" or "proceso" => Color.Warning,
            "pendiente" => Color.Info,
            _ => Color.Default
        };

    private Color GetEstadoConteoColor(string? estado) =>
        estado?.ToLower() switch
        {
            "completado" or "completo" => Color.Success,
            "en proceso" => Color.Warning,
            "pendiente" or "iniciado" => Color.Info,
            "cerrado" => Color.Error,
            _ => Color.Default
        };

    private static readonly CultureInfo NumberCulture = CultureInfo.InvariantCulture;

    private static string Quantity(decimal value) => value.ToString("0.00", NumberCulture);

    private static decimal Difference(ConteoResponse conteo)
        => conteo.TotalLecturas - conteo.CantidadInventario;

    private static string FormatDifference(ConteoResponse conteo)
    {
        var difference = Difference(conteo);
        return difference > 0 ? $"+{Quantity(difference)}" : Quantity(difference);
    }

    private static Color GetDifferenceColor(ConteoResponse conteo)
        => Difference(conteo) == 0 ? Color.Success : Color.Error;

    private static bool EsEstatus(ConteoResponse conteo, string estatus)
        => string.Equals(conteo.EstatusPeriodo?.Trim(), estatus, StringComparison.OrdinalIgnoreCase);

    private static bool PuedeEditarConteo(ConteoResponse conteo)
        => conteo.TotalLecturas == 0 &&
           (EsEstatus(conteo, "Pendiente") || EsEstatus(conteo, "En Proceso"));

    private async Task AbrirScanner(ConteoResponse conteo)
    {
        var parameters = new DialogParameters
        {
            ["ConteoId"] = conteo.PkidConteo,
            ["FkidTipoBienAlma"] = conteo.IdTipoBien ?? 0,
            ["CodigoClaveTipoBien"] = conteo.CodigoClaveTipoBien,
            ["DescripcionTipoBien"] = conteo.DescripcionTipoBien ?? "Sin tipo de bien"
        };

        var dialog = await DialogService.ShowAsync<AgregarBienScannerDialog>(
            $"Escanear Bienes - {conteo.Descripcion}",
            parameters,
            new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            });

        var result = await dialog.Result;
        if (result?.Data is true)
        {
            Snackbar.Add("Bienes agregados exitosamente", Severity.Success);
            await tableConteos.ReloadData();
        }
    }
}
