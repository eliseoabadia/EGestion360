@page "/Almacen/Solicitudes_Salida"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<SolicitudSalidaResponse, SolicitudSalidaResponse>

@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<DetalleSolicitudSalidaResponse> DetalleService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column salida-page" MaxWidth="MaxWidth.False">
        <PageHeader Title="Solicitudes de salida"
                    Subtitle="Solicitud, autorizacion y trazabilidad de bienes de almacen"
                    Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="RefreshAll" />

        <div class="summary-strip">
            <div>
                <span>Solicitudes</span>
                <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
            </div>
            <div>
                <span>Pendientes visibles</span>
                <strong>@Elements.Count(x => !x.Autorizado && !x.EsFinal).ToString("N0", NumberCulture)</strong>
            </div>
            <div>
                <span>Bienes seleccionados</span>
                <strong>@(selectedSolicitud?.TotalDetalles.ToString("N0", NumberCulture) ?? "0")</strong>
            </div>
            <div>
                <span>Entidad</span>
                <strong>@TextOrDash(SucursalStateService.EmpresaNombre)</strong>
            </div>
        </div>

        <div class="split-shell">
            <div class="master-panel">
                <GenericDataGrid TItem="SolicitudSalidaResponse"
                              @ref="table"
                              Title="Solicitudes"
                              SearchPlaceholder="Buscar por folio, solicitante, area o justificacion..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerData"
                              ExportFunc="ExportToExcel"
                              SearchString="@SearchString"
                              SearchStringChanged="(s) => SearchString = s"
                              OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <DocumentSupportButton Modulo="Almacen"
                        SubModulo="Solicitudes_Salida"
                        Controlador="SolicitudSalida"
                        EntidadId="@cell.Item.PkidSolicitudSalida"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@TextOrDash(cell.Item.Folio)"
                        RegistroDescripcion="@TextOrDash(cell.Item.Solicitante)" />
                        <MudTooltip Text="Ver bienes">
                        <MudIconButton Icon="@Icons.Material.Filled.ListAlt"
                        Color="Color.Info"
                        Size="Size.Small"
                        OnClick="@(() => SelectSolicitud(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Autorizar">
                        <MudIconButton Icon="@Icons.Material.Filled.Verified"
                        Visible="@CanAuthorize"
                        Disabled="@(!CanWork(cell.Item))"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="@(() => AutorizarSolicitud(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Disabled="@(!CanWork(cell.Item))"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidSolicitudSalida))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Disabled="@(!CanWork(cell.Item))"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidSolicitudSalida))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Folio" Identifier="Folio" PropertyName="Folio" SortBy="x => x.Folio">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Folio)</div>
                        <span>ID @cell.Item.PkidSolicitudSalida</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Solicitante" Identifier="Solicitante" PropertyName="Solicitante" SortBy="x => x.Solicitante">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Solicitante)</div>
                        <span>@TextOrDash(cell.Item.AreaSolicitaNombre)</span>
                        <span>@TextOrDash(cell.Item.AreaEntregaNombre)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Fecha" Identifier="FechaSolicitud" PropertyName="FechaSolicitud" SortBy="x => x.FechaSolicitud">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@cell.Item.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                        <span>@DateOrDash(cell.Item.FechaRequerida)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Estatus" Identifier="EstatusDescripcion" PropertyName="EstatusDescripcion" SortBy="x => x.EstatusDescripcion">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Style="@StatusStyle(cell.Item)">
                        @TextOrDash(cell.Item.EstatusDescripcion)
                        </MudChip>
                        <span>@(cell.Item.Autorizado ? "Autorizada" : "Captura")</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Totales" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@cell.Item.TotalDetalles.ToString("N0", NumberCulture) bienes</div>
                        <span>Sol @Qty(cell.Item.TotalSolicitado)</span>
                        <span>Pend @Qty(cell.Item.TotalPendiente)</span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </div>

            <div class="detail-panel">
                <div class="detail-header">
                    <div>
                        <span>Detalle</span>
                        <strong>@(selectedSolicitud == null ? "Selecciona una solicitud" : selectedSolicitud.Folio)</strong>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(selectedSolicitud == null || !CanCreate || !CanWork(selectedSolicitud))"
                               OnClick="AgregarDetalle">
                        Agregar bien
                    </MudButton>
                </div>

                <GenericDataGrid TItem="DetalleSolicitudSalidaResponse"
                              @ref="detailTable"
                              Title="Bienes solicitados"
                              SearchPlaceholder="Buscar bien, clave o observaciones..."
                              ShowExportButton="false"
                              ServerDataFunc="LoadDetailData"
                              ExportFunc="() => Task.CompletedTask"
                              SearchString="@detailSearch"
                              SearchStringChanged="(s) => detailSearch = s"
                              OnSearch="OnDetailSearch">
            <Columns>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Disabled="@(selectedSolicitud == null || !CanWork(selectedSolicitud))"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditarDetalle(cell.Item))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Disabled="@(selectedSolicitud == null || !CanWork(selectedSolicitud))"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => EliminarDetalle(cell.Item))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.TipoBienDescripcion)</div>
                        <span>@TextOrDash(cell.Item.TipoBienClave)</span>
                        <span>@TextOrDash(cell.Item.AlmacenClave)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Solicitada" Identifier="CantidadSolicitada" PropertyName="CantidadSolicitada" SortBy="x => x.CantidadSolicitada">
                    <CellTemplate Context="cell">
                        <strong>@Qty(cell.Item.CantidadSolicitada)</strong>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Autorizada" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadAutorizada ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Entregada" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadEntregada ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Pendiente" Identifier="CantidadPendiente" PropertyName="CantidadPendiente" SortBy="x => x.CantidadPendiente">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="@(cell.Item.CantidadPendiente <= 0 ? Color.Success : Color.Warning)">
                        @Qty(cell.Item.CantidadPendiente)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Observaciones" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Observaciones)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </div>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<SolicitudSalidaResponse> table = null!;
    private GenericDataGrid<DetalleSolicitudSalidaResponse> detailTable = null!;
    private SolicitudSalidaResponse? selectedSolicitud;
    private string detailSearch = string.Empty;
    private int detailTotal;
    private List<DetalleSolicitudSalidaResponse> detailElements = new();
    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("es-MX");

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Solicitudes_Salida";
    protected override Type CreateDialogType => typeof(SolicitudSalidaDialog);
    protected override Type EditDialogType => typeof(SolicitudSalidaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SolicitudSalidaResponse>);

    protected override string GetDefaultSortLabel() => "FechaSolicitud";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        await SucursalStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
    }

    protected override async Task<TableData<SolicitudSalidaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;
            var filters = new Dictionary<string, object>();
            if (SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0)
            {
                filters["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value;
            }
            if (AnioStateService.AnioClave.HasValue)
            {
                filters["Anio"] = AnioStateService.AnioClave.Value;
            }

            var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection, filters);
            Elements = response?.Items?.ToList() ?? new List<SolicitudSalidaResponse>();
            TotalCount = response?.Success == true ? response.TotalCount : 0;
            selectedSolicitud = selectedSolicitud != null && Elements.Any(x => x.PkidSolicitudSalida == selectedSolicitud.PkidSolicitudSalida)
                ? selectedSolicitud
                : Elements.FirstOrDefault();
            return new TableData<SolicitudSalidaResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task<TableData<DetalleSolicitudSalidaResponse>> LoadDetailData(TableState state, CancellationToken cancellationToken)
    {
        if (selectedSolicitud == null)
        {
            detailElements.Clear();
            detailTotal = 0;
            return new TableData<DetalleSolicitudSalidaResponse> { Items = detailElements, TotalItems = detailTotal };
        }

        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detailSearch,
            state.SortLabel ?? "TipoBienDescripcion",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidSolicitudSalidaAlma"] = selectedSolicitud.PkidSolicitudSalida });

        detailElements = response?.Items?.ToList() ?? new List<DetalleSolicitudSalidaResponse>();
        detailTotal = response?.Success == true ? response.TotalCount : 0;
        return new TableData<DetalleSolicitudSalidaResponse> { Items = detailElements, TotalItems = detailTotal };
    }

    private async Task SelectSolicitud(SolicitudSalidaResponse item)
    {
        selectedSolicitud = item;
        await detailTable.ReloadData();
    }

    private async Task AgregarDetalle()
    {
        if (selectedSolicitud == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["SolicitudId"] = selectedSolicitud.PkidSolicitudSalida,
            ["SolicitudDescripcion"] = $"{selectedSolicitud.Folio} | {selectedSolicitud.Solicitante}"
        };
        var dialog = await DialogService.ShowAsync<DetalleSolicitudSalidaDialog>("Agregar bien", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshAll();
        }
    }

    private async Task EditarDetalle(DetalleSolicitudSalidaResponse detail)
    {
        var parameters = new DialogParameters
        {
            ["Id"] = detail.PkidDetalleSolicitudSalida,
            ["SolicitudId"] = detail.FkidSolicitudSalidaAlma,
            ["SolicitudDescripcion"] = selectedSolicitud == null ? detail.SolicitudFolio : $"{selectedSolicitud.Folio} | {selectedSolicitud.Solicitante}"
        };
        var dialog = await DialogService.ShowAsync<DetalleSolicitudSalidaDialog>("Editar bien", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshAll();
        }
    }

    private async Task EliminarDetalle(DetalleSolicitudSalidaResponse detail)
    {
        var parameters = new DialogParameters
        {
            ["Id"] = detail.PkidDetalleSolicitudSalida,
            ["ItemName"] = detail.TipoBienDescripcion,
            ["DeleteFunc"] = new Func<int, Task<bool>>(async id =>
            {
                var response = await DetalleService.DeleteAsync(id);
                if (response?.Success == true)
                {
                    Snackbar.Add(response.Message ?? "Detalle eliminado.", Severity.Success);
                    await RefreshAll();
                    return true;
                }

                Snackbar.Add(response?.Message ?? "No fue posible eliminar el detalle.", Severity.Error);
                return false;
            })
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog<DetalleSolicitudSalidaResponse>>("Eliminar bien", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
    }

    private async Task AutorizarSolicitud(SolicitudSalidaResponse item)
    {
        if (!await ConfirmWorkflowAsync(
                "Autorizar solicitud de salida",
                $"¿Seguro que deseas autorizar la solicitud {TextOrDash(item.Folio)}? Al autorizarla quedará lista para surtirse.",
                "Autorizar",
                Severity.Success,
                item.PkidSolicitudSalida))
        {
            return;
        }

        var response = await Service.PostActionAsync($"{item.PkidSolicitudSalida}/autorizar");
        if (response?.Success == true)
        {
            Snackbar.Add(response.Message ?? "Solicitud autorizada correctamente.", Severity.Success);
            selectedSolicitud = response.Data ?? item;
            await RefreshAll();
            return;
        }

        Snackbar.Add(response?.Message ?? "No fue posible autorizar la solicitud.", Severity.Error);
    }

    private async Task RefreshAll()
    {
        await table.ReloadData();
        if (detailTable != null)
        {
            await detailTable.ReloadData();
        }
    }

    protected override Task ReloadData() => RefreshAll();

    private async Task OnDetailSearch()
    {
        await Task.Delay(250);
        await detailTable.ReloadData();
    }

    protected override Task<string> GetItemNameForDelete(int id)
    {
        var item = Elements.FirstOrDefault(x => x.PkidSolicitudSalida == id);
        return Task.FromResult(item == null ? id.ToString() : $"{item.Folio} - {item.Solicitante}");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SolicitudSalidaResponse> items)
    {
        return items.Select(x => new
        {
            x.Folio,
            x.Solicitante,
            AreaSolicita = x.AreaSolicitaNombre,
            AreaEntrega = x.AreaEntregaNombre,
            Fecha = x.FechaSolicitud.ToString("dd/MM/yyyy"),
            Requerida = DateOrDash(x.FechaRequerida),
            Estatus = x.EstatusDescripcion,
            x.TotalDetalles,
            x.TotalSolicitado,
            x.TotalAutorizado,
            x.TotalEntregado,
            x.TotalPendiente,
            x.Justificacion
        });
    }

    private async void OnEmpresaChanged(int empresaId)
    {
        selectedSolicitud = null;
        await RefreshAll();
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(async () =>
        {
            selectedSolicitud = null;
            await RefreshAll();
        });
    }

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        SearchCts?.Cancel();
        SearchCts?.Dispose();
    }

    private static bool CanWork(SolicitudSalidaResponse item) => item.Activo && !item.Autorizado && !item.EsFinal;
    private static string StatusStyle(SolicitudSalidaResponse item)
    {
        var color = string.IsNullOrWhiteSpace(item.EstatusColor) ? "#E8F1FF" : item.EstatusColor;
        return $"background:{color}; color:#101828;";
    }

    private static string Qty(decimal value) => value.ToString("#,##0.####", CultureInfo.InvariantCulture);
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DateOrDash(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
}
