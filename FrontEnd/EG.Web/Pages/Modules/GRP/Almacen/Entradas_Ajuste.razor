@page "/Almacen/Entradas_Ajuste"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<AlmacenResponse, AlmacenResponse>

@inject SucursalStateService SucursalStateService

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column almacen-page" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Entradas por ajuste"
                    Subtitle="Movimientos manuales de entrada al almacen con soporte documental"
                    Icon="@Icons.Material.Filled.Inventory2"
                    CanCreate="@CanCreate"
                    OnCreate="CreateItem"
                    OnRefresh="() => table.ReloadData()" />

        <div class="summary-strip">
            <div>
                <span>Valor visible</span>
                <strong>@Money(Elements.Sum(x => x.Costo ?? 0m))</strong>
            </div>
            <div>
                <span>Unidades</span>
                <strong>@Qty(Elements.Sum(x => x.Cantidad))</strong>
            </div>
            <div>
                <span>Registros</span>
                <strong>@TotalCount.ToString("N0", NumberCulture)</strong>
            </div>
            <div>
                <span>Entidad</span>
                <strong>@TextOrDash(SucursalStateService.EmpresaNombre)</strong>
            </div>
        </div>

        <div Style="flex-grow: 1; overflow: hidden; min-height: 0;">
            <GenericDataGrid TItem="AlmacenResponse"
                          @ref="table"
                          Title="Entradas registradas"
                          SearchPlaceholder="Buscar por clave, bien, factura, lote o motivo..."
                          ShowExportButton="@CanExport"
                          ServerDataFunc="LoadServerData"
                          ExportFunc="ExportToExcel"
                          SearchString="@SearchString"
                          SearchStringChanged="(s) => SearchString = s"
                          OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="AlmacenResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <DocumentSupportButton Modulo="Almacen"
                        SubModulo="Entradas_Ajuste"
                        Controlador="Almacen"
                        EntidadId="@cell.Item.PkidAlmacen"
                        FkidEmpresaSis="@cell.Item.FkidEmpresaSis"
                        RegistroTitulo="@TextOrDash(cell.Item.Clave)"
                        RegistroDescripcion="@TextOrDash(cell.Item.TipoBienDescripcion)" />
                        <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                        Visible="@CanUpdate"
                        Disabled="@cell.Item.EstaBloqueado"
                        Color="Color.Primary"
                        Size="Size.Small"
                        OnClick="@(() => EditItem(cell.Item.PkidAlmacen))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                        Visible="@CanDelete"
                        Disabled="@cell.Item.EstaBloqueado"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteItem(cell.Item.PkidAlmacen))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Clave" Identifier="Clave" PropertyName="Clave" SortBy="x => x.Clave">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Clave)</div>
                        <span>ID @cell.Item.PkidAlmacen</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.TipoBienDescripcion)</div>
                        <span>@TextOrDash(cell.Item.TipoBienClave)</span>
                        <span>@TextOrDash(cell.Item.AreaNombre)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Cantidad" Identifier="Cantidad" PropertyName="Cantidad" SortBy="x => x.Cantidad">
                    <CellTemplate Context="cell">
                        <strong>@Qty(cell.Item.Cantidad)</strong>
                        <span>@TextOrDash(cell.Item.UnidadDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Valor" Identifier="Costo" PropertyName="Costo" SortBy="x => x.Costo">
                    <CellTemplate Context="cell">
                        <strong>@Money(cell.Item.Costo ?? 0m)</strong>
                        <span>CU @Qty(cell.Item.CostoUnitario ?? 0m)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Fecha" Identifier="FechaEntrada" PropertyName="FechaEntrada" SortBy="x => x.FechaEntrada">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@cell.Item.FechaEntrada.ToString("dd/MM/yyyy")</div>
                        <span>@DateOrDash(cell.Item.FechaCaducidad)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Documento" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Factura)</div>
                        <span>@TextOrDash(cell.Item.Remision)</span>
                        <span>@TextOrDash(cell.Item.Lote)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AlmacenResponse" Title="Estado" Identifier="__column_7" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="@(cell.Item.EstaBloqueado ? Color.Warning : Color.Success)">
                        @(cell.Item.EstaBloqueado ? "Bloqueado" : "Editable")
                        </MudChip>
                        <span>@TextOrDash(cell.Item.MotivoDescripcion)</span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
        </div>
    </MudContainer>
</AccessVerification>

<style>
    .almacen-page .summary-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin: 8px 0 12px;
    }

    .almacen-page .summary-strip > div {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 10px 12px;
        background: var(--mud-palette-surface);
        box-shadow: var(--mud-elevation-1);
    }

    .almacen-page .summary-strip span,
    .almacen-page td span {
        display: block;
        color: var(--mud-palette-text-secondary);
        font-size: .78rem;
    }

    .almacen-page .summary-strip strong,
    .almacen-page .main-cell {
        font-weight: 700;
        line-height: 1.15;
    }
</style>

@code {
    private GenericDataGrid<AlmacenResponse> table = null!;
    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("es-MX");

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Entradas_Ajuste";
    protected override Type CreateDialogType => typeof(AlmacenDialog);
    protected override Type EditDialogType => typeof(AlmacenDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<AlmacenResponse>);

    protected override string GetDefaultSortLabel() => "FechaEntrada";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SucursalStateService.InitializeAsync();
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
    }

    protected override async Task<TableData<AlmacenResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        Loading = true;
        try
        {
            CurrentPage = Math.Max(1, state.Page + 1);
            PageSize = state.PageSize;
            SortLabel = state.SortLabel ?? GetDefaultSortLabel();
            SortDirection = state.SortDirection;

            var filters = new Dictionary<string, object> { ["TipoMovimiento"] = "Entrada" };
            if (SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0)
            {
                filters["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value;
            }

            var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection, filters);
            Elements = response?.Items?.ToList() ?? new List<AlmacenResponse>();
            TotalCount = response?.Success == true ? response.TotalCount : 0;

            if (response?.Success != true && !string.IsNullOrWhiteSpace(response?.Message))
            {
                Snackbar.Add(response.Message, Severity.Error);
            }

            return new TableData<AlmacenResponse> { Items = Elements, TotalItems = TotalCount };
        }
        finally
        {
            Loading = false;
        }
    }

    protected override Task ReloadData() => table.ReloadData();

    protected override Task<string> GetItemNameForDelete(int id)
    {
        var item = Elements.FirstOrDefault(x => x.PkidAlmacen == id);
        return Task.FromResult(item == null ? id.ToString() : $"{item.Clave} - {item.TipoBienDescripcion}");
    }

    protected override IEnumerable<object> MapToExcelData(IEnumerable<AlmacenResponse> items)
    {
        return items.Select(x => new
        {
            x.Clave,
            Bien = x.TipoBienDescripcion,
            Area = x.AreaNombre,
            x.Cantidad,
            x.CostoUnitario,
            x.Costo,
            Fecha = x.FechaEntrada.ToString("dd/MM/yyyy"),
            x.Factura,
            x.Remision,
            x.Lote,
            Motivo = x.MotivoDescripcion
        });
    }

    private async void OnEmpresaChanged(int empresaId) => await table.ReloadData();

    public void Dispose()
    {
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        SearchCts?.Cancel();
        SearchCts?.Dispose();
    }

    private static string Money(decimal value) => value.ToString("$ #,##0.00 MXN", NumberCulture);
    private static string Qty(decimal value) => value.ToString("#,##0.####", CultureInfo.InvariantCulture);
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DateOrDash(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
}
