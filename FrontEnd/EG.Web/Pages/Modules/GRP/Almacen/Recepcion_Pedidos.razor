@page "/Almacen/Recepcion_Pedidos"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Adquisicion
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Contracts
@using EG.Web.Pages.Shared
@using EG.Web.Pages.Shared.SoporteDocumental
@using EG.Web.Services
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<OrdenCompraResponse, OrdenCompraResponse>
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<OrdenCompraDetalleResponse> OrdenDetalleService
@inject IGenericCrudService<AlmacenResponse> AlmacenService
@inject EG.Web.Auth.AuthenticationProviderJWT ReceiptAuth

<AccessVerification IsInitialized="@IsInitialized" HasAccess="@HasAccess" NavigateToHome="NavigateToHome">
<div class="recepcion-page">
    <PageTitle>Recepción de pedidos · EGestion360</PageTitle>
    <PageHeader Title="Recepción de pedidos" Subtitle="Selecciona una orden, captura la cantidad y confirma la entrada." Icon="@Icons.Material.Filled.MoveToInbox" Kicker="MÓDULO OPERATIVO" ShowCreateButton="false" OnRefresh="RefreshAll">
        <AdditionalButtons>
            @if (selectedOrden is not null)
            {
                <div class="receipt-header-order"><strong>@OrderLabel</strong><span>@selectedOrden.ProveedorNombre</span><small>@selectedOrden.FechaOrdenCompra.ToString("dd MMM yyyy", NumberCulture) · @selectedOrden.Total.ToString("C2", NumberCulture)</small></div>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ToggleOrders" StartIcon="@Icons.Material.Filled.SwapHoriz" aria-expanded="@showOrders">@(showOrders ? "Ocultar órdenes" : "Cambiar orden")</MudButton>
            <MudButton Variant="Variant.Text" OnClick="() => showSummary = true" aria-haspopup="dialog">Ver resumen</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(!CanReceive)" OnClick="FocusReceiptAsync">Nueva recepción</MudButton>
        </AdditionalButtons>
    </PageHeader>

    <MudDialog @bind-Visible="showSummary" Options="SummaryDialogOptions">
        <TitleContent><MudText Typo="Typo.h6">Resumen de recepción</MudText></TitleContent>
        <DialogContent>
    <section class="receipt-metrics receipt-summary-modal" aria-label="Resumen de recepción">
        <article><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" /><div><span>Órdenes autorizadas</span><strong>@TotalCount.ToString("N0")</strong><small>Resultado de la búsqueda actual</small></div></article>
        <article><MudIcon Icon="@Icons.Material.Filled.Inventory2" /><div><span>Renglones de la orden</span><strong>@detalleTotal.ToString("N0")</strong><small>@OrderLabel</small></div></article>
        <article><MudIcon Icon="@Icons.Material.Filled.PendingActions" /><div><span>Renglones pendientes visibles</span><strong>@detalles.Count(x => Pending(x) > 0)</strong><small>En esta página de la orden</small></div></article>
        <article><MudIcon Icon="@Icons.Material.Filled.LocalShipping" /><div><span>Bien seleccionado</span><strong>@(selectedDetalle is null ? "—" : Qty(Pending(selectedDetalle)))</strong><small>@(selectedDetalle is null ? "Selecciona un bien" : $"{selectedDetalle.UnidadMedida} por recibir")</small></div></article>
    </section>


        </DialogContent>
        <DialogActions><MudButton Color="Color.Primary" OnClick="() => showSummary = false">Cerrar</MudButton></DialogActions>
    </MudDialog>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@loadError</MudAlert>
    }

    <div class="receipt-workspace" hidden="@(!showCapture)">
        <section class="receipt-panel quick-receipt" aria-labelledby="quick-receipt-title">
            <header class="receipt-panel-heading"><MudIcon Icon="@Icons.Material.Filled.Bolt" /><div><h2 id="quick-receipt-title">Recepción rápida</h2><p>Captura la cantidad del bien seleccionado.</p></div><MudButton Disabled="@saving" OnClick="() => showCapture = false">Ocultar captura</MudButton></header>
            <MudForm @ref="receiptForm"><div class="receipt-panel-body">
                <div class="receipt-path" aria-label="Proceso de recepción"><span class="@(selectedOrden is null ? "" : "ready")">1 · Orden</span><span class="@(selectedDetalle is null ? "" : "ready")">2 · Bien</span><span>3 · Cantidad y confirmación</span></div>
                <div class="receipt-fields">
                    <MudAutocomplete T="OrdenCompraResponse" Value="@selectedOrden" ValueChanged="SelectOrden" SearchFunc="SearchOrdersAsync" ToStringFunc="@(x => x is null ? string.Empty : $"{x.NumeroOrdenCompra} · {x.ProveedorNombre}")" Label="Orden de compra" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" MinCharacters="0" MaxItems="20" Disabled="@(saving || contextRefreshing)" Clearable="false" />
                    <MudAutocomplete T="OrdenCompraDetalleResponse" Value="@selectedDetalle" ValueChanged="SelectDetalle" SearchFunc="SearchDetailsAsync" ToStringFunc="@(x => x is null ? string.Empty : $"{x.TipoBienCodigoClave} · {x.TipoBienDescripcion}")" Label="Buscar bien o código" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" MinCharacters="0" MaxItems="20" Disabled="@(selectedOrden is null || saving || detailLoading || contextRefreshing)" Clearable="false" />
                </div>
                <div class="receipt-selected" aria-live="polite" aria-busy="@detailLoading">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    <div class="receipt-selected-name"><span>Bien seleccionado</span><strong>@(selectedDetalle?.TipoBienDescripcion ?? (detailLoading ? "Cargando renglones…" : "Sin renglón seleccionado"))</strong><small>@selectedDetalle?.TipoBienCodigoClave</small></div>
                    <dl><div><dt>Solicitada</dt><dd>@(selectedDetalle is null ? "—" : Qty(selectedDetalle.CantidadSolicitada))</dd></div><div><dt>Recibida</dt><dd>@(selectedDetalle is null ? "—" : Qty(selectedDetalle.CantidadRecibida))</dd></div><div><dt>Pendiente</dt><dd>@(selectedDetalle is null ? "—" : Qty(Pending(selectedDetalle)))</dd></div></dl>
                </div>
                <div class="receipt-fields">
                    <MudNumericField T="decimal?" @ref="quantityField" @bind-Value="receiptQuantity" Label="Cantidad a recibir" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Format="0.####" Culture="@CultureInfo.InvariantCulture" Validation="@(new Func<decimal?, string?>(ValidateReceiptQuantity))" Disabled="@(!CanReceive)" Required="true" />
                    <MudDatePicker @bind-Date="receiptDate" Label="Fecha de entrada" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Culture="@NumberCulture" Editable="true" Required="true" Disabled="@(saving || contextRefreshing)" />
                </div>
                @if (!CanCreate)
                {
                    <MudAlert Dense="true" Severity="Severity.Info">Tu perfil permite consultar las recepciones.</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <MudAlert Dense="true" Severity="Severity.Warning">@saveError</MudAlert>
                }
                <div class="receipt-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" Disabled="@(!CanReceive || mustRefresh)" OnClick="ConfirmReceiptAsync">@(saving ? "Registrando…" : "Confirmar recepción")</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(saving || contextRefreshing)" OnClick="ResetCapture">Limpiar</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@(!CanReceive)" OnClick="OpenCompleteFormAsync">Más datos de la entrada</MudButton>
                </div>
                <p class="receipt-note">La entrada toma el bien, la unidad y el costo de la orden. Puedes agregar factura, ubicación o lote en “Más datos de la entrada”.</p>
            </div></MudForm>
        </section>

    </div>

    <section class="receipt-panel receipt-lines">
        <header class="receipt-panel-heading receipt-lines-heading"><div><span>Selecciona un renglón pendiente para registrar su entrada.</span></div>
            @if (selectedOrden is not null)
            {
                <DocumentSupportButton Modulo="Almacen" SubModulo="Recepcion_Pedidos" Controlador="OrdenCompra" EntidadId="@selectedOrden.PkidOrdenCompra" FkidEmpresaSis="@selectedOrden.FkidEmpresaSis" RegistroTitulo="@OrderLabel" RegistroDescripcion="@selectedOrden.ProveedorNombre" />
            }
        </header>
        <GenericDataGrid TItem="OrdenCompraDetalleResponse" @ref="detalleTable" Title="Bienes de la orden" Eyebrow="RECEPCIÓN Y SEGUIMIENTO" ColumnResizeMode="ResizeMode.None" FillAvailableHeight="false" ServerDataFunc="LoadDetalleData" SearchString="@detalleSearch" SearchStringChanged="s => detalleSearch = s" OnSearch="OnDetalleSearch" SearchPlaceholder="Buscar clave o descripción…" PageSize="5" PageSizeOptions="new[] { 5, 10, 20, 50 }">
            <Columns>
                <TemplateColumn T="OrdenCompraDetalleResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion"><CellTemplate><div class="receipt-item"><strong>@context.Item.TipoBienCodigoClave</strong><span>@context.Item.TipoBienDescripcion</span></div></CellTemplate></TemplateColumn>
                <PropertyColumn T="OrdenCompraDetalleResponse" TProperty="decimal" Property="x => x.CantidadSolicitada" Format="N4" Title="Solicitada" />
                <PropertyColumn T="OrdenCompraDetalleResponse" TProperty="decimal" Property="x => x.CantidadRecibida" Format="N4" Title="Recibida" />
                <TemplateColumn T="OrdenCompraDetalleResponse" Title="Pendiente" Sortable="false"><CellTemplate><MudChip T="string" Color="@(Pending(context.Item) > 0 ? Color.Warning : Color.Success)" Size="Size.Small">@Qty(Pending(context.Item))</MudChip></CellTemplate></TemplateColumn>
                <TemplateColumn T="OrdenCompraDetalleResponse" Title="Avance" Sortable="false"><CellTemplate><div class="receipt-progress"><MudProgressLinear Value="@Progress(context.Item)" Color="Color.Success" Rounded="true" /><span>@Progress(context.Item).ToString("0")%</span></div></CellTemplate></TemplateColumn>
                <TemplateColumn T="OrdenCompraDetalleResponse" Title="Acción" Sortable="false" Filterable="false" Hideable="false" Resizable="false"><CellTemplate>
                    <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Disabled="@(!CanCreate || saving || detailLoading || Pending(context.Item) <= 0)" OnClick="() => PrepareReceiptAsync(context.Item)">@(Pending(context.Item) <= 0 ? "Recibido" : "Recibir")</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" aria-label="Consultar entradas del renglón" Disabled="@saving" OnClick="() => ShowHistoryAsync(context.Item)" />
                </CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </section>

    <div class="receipt-orders" hidden="@(!showOrders)">
        <GenericDataGrid TItem="OrdenCompraResponse" @ref="table" Title="Órdenes de compra autorizadas" FillAvailableHeight="false" ServerDataFunc="LoadServerData" SearchString="@SearchString" SearchStringChanged="s => SearchString = s" OnSearch="OnSearch" SearchPlaceholder="Buscar orden o proveedor…" ShowExportButton="@CanExport" ExportFunc="ExportToExcel" PageSize="10">
            <Columns>
                <TemplateColumn T="OrdenCompraResponse" Title="Seleccionar" Sortable="false" Hideable="false"><CellTemplate><MudButton Size="Size.Small" Disabled="@saving" OnClick="() => SelectOrden(context.Item)">Abrir orden</MudButton></CellTemplate></TemplateColumn>
                <PropertyColumn T="OrdenCompraResponse" TProperty="string" Property="x => x.NumeroOrdenCompra" Title="Orden" />
                <PropertyColumn T="OrdenCompraResponse" TProperty="string" Property="x => x.ProveedorNombre" Title="Proveedor" />
                <TemplateColumn T="OrdenCompraResponse" Title="Entrega" Sortable="false"><CellTemplate>@DeliveryLabel(context.Item)</CellTemplate></TemplateColumn>
                <TemplateColumn T="OrdenCompraResponse" Title="Estado" Sortable="false"><CellTemplate>@context.Item.EstatusDescripcion</CellTemplate></TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </div>
    @if (showHistory)
    {
        <section class="receipt-panel receipt-history">
            <header class="receipt-panel-heading"><div><h2>Entradas del renglón</h2><p>@selectedDetalle?.TipoBienDescripcion</p></div><MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Cerrar historial" OnClick="() => showHistory = false" /></header>
            <GenericDataGrid TItem="AlmacenResponse" @ref="entradasTable" Title="Entradas registradas" FillAvailableHeight="false" ServerDataFunc="LoadEntradasData" SearchString="@entradasSearch" SearchStringChanged="s => entradasSearch = s" OnSearch="OnEntradasSearch">
                <Columns><PropertyColumn T="AlmacenResponse" TProperty="string" Property="x => x.Clave" Title="Clave" /><PropertyColumn T="AlmacenResponse" TProperty="decimal" Property="x => x.Cantidad" Title="Cantidad" /><TemplateColumn T="AlmacenResponse" Title="Fecha" Sortable="false"><CellTemplate>@context.Item.FechaEntrada.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn><PropertyColumn T="AlmacenResponse" TProperty="string" Property="x => x.AreaNombre" Title="Ubicación" /></Columns>
            </GenericDataGrid>
        </section>
    }
</div>
</AccessVerification>
