@page "/Almacen/Reporte_diferencias_Conteo"
@using System.Globalization
@using EG.Domain.DTOs.Responses.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<ConteoResponse, ConteoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Reporte diferencias de conteo"
                    Subtitle="Diferencias entre inventario teorico y cantidad contada"
                    Icon="@Icons.Material.Filled.Difference"
                    CanCreate="false"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="ConteoResponse"
                      @ref="table"
                      Title="Diferencias"
                      SearchPlaceholder="Buscar por periodo, bien o estado..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="ConteoResponse" Title="Periodo" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.NombrePeriodo)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Bien" Identifier="__column_1" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.DescripcionTipoBien)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Inventario" Identifier="__column_2" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadInventario)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Contado" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.TotalCantidadContada)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Diferencia" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <strong>@Qty(cell.Item.TotalCantidadContada - cell.Item.CantidadInventario)</strong>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Estado" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="@(HasDifference(cell.Item) ? Color.Warning : Color.Success)">@(HasDifference(cell.Item) ? "Diferencia" : "Cuadrado")</MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ConteoResponse> table = null!;
    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Reporte_diferencias_Conteo";
    protected override Type CreateDialogType => typeof(AlmacenDialog);
    protected override Type EditDialogType => typeof(AlmacenDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ConteoResponse>);
    protected override string GetDefaultSortLabel() => "FechaInicio";
    protected override Task ReloadData() => table.ReloadData();
    protected override IEnumerable<object> MapToExcelData(IEnumerable<ConteoResponse> items) =>
        items.Select(x => new { Periodo = x.NombrePeriodo, Bien = x.DescripcionTipoBien, x.CantidadInventario, x.TotalCantidadContada, Diferencia = x.TotalCantidadContada - x.CantidadInventario });
    private static bool HasDifference(ConteoResponse item) => item.TotalCantidadContada != item.CantidadInventario;
    private static string Qty(decimal value) => value.ToString("#,##0.####", CultureInfo.InvariantCulture);
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
