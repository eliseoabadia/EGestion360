@page "/Almacen/Conteo_ciclico"
@using System.Globalization
@using EG.Domain.DTOs.Responses.ConteoCiclico
@using EG.Web.Pages.Shared
@using EG.Web.Shared
@using MudBlazor
@inherits BaseCrudPage<ConteoResponse, ConteoResponse>

<AccessVerification IsInitialized="@IsInitialized"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="px-3 d-flex flex-column" MaxWidth="MaxWidth.False" Style="height: 100vh; overflow: hidden;">
        <PageHeader Title="Conteo ciclico"
                    Subtitle="Seguimiento operativo de conteos activos"
                    Icon="@Icons.Material.Filled.FactCheck"
                    CanCreate="false"
                    OnRefresh="() => table.ReloadData()" />
        <GenericDataGrid TItem="ConteoResponse"
                      @ref="table"
                      Title="Conteos"
                      SearchPlaceholder="Buscar por periodo, bien o estatus..."
                      ShowExportButton="@CanExport"
                      ServerDataFunc="LoadServerData"
                      ExportFunc="ExportToExcel"
                      SearchString="@SearchString"
                      SearchStringChanged="(s) => SearchString = s"
                      OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="ConteoResponse" Title="Descripcion" Identifier="Descripcion" PropertyName="Descripcion" SortBy="x => x.Descripcion">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.Descripcion)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Periodo" Identifier="NombrePeriodo" PropertyName="NombrePeriodo" SortBy="x => x.NombrePeriodo">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.NombrePeriodo)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Bien" Identifier="DescripcionTipoBien" PropertyName="DescripcionTipoBien" SortBy="x => x.DescripcionTipoBien">
                    <CellTemplate Context="cell">
                        @TextOrDash(cell.Item.DescripcionTipoBien)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Inicio" Identifier="FechaInicio" PropertyName="FechaInicio" SortBy="x => x.FechaInicio">
                    <CellTemplate Context="cell">
                        @cell.Item.FechaInicio.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Inventario" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadInventario)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Contado" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.TotalCantidadContada)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ConteoResponse" Title="Estado" Identifier="__column_6" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@TextOrDash(cell.Item.EstadoConteo)</MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
    </MudContainer>
</AccessVerification>

@code {
    private GenericDataGrid<ConteoResponse> table = null!;
    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "conteo_ciclico";
    protected override Type CreateDialogType => typeof(AlmacenDialog);
    protected override Type EditDialogType => typeof(AlmacenDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<ConteoResponse>);
    protected override string GetDefaultSortLabel() => "FechaInicio";
    protected override Task ReloadData() => table.ReloadData();
    protected override IEnumerable<object> MapToExcelData(IEnumerable<ConteoResponse> items) =>
        items.Select(x => new { x.Descripcion, Periodo = x.NombrePeriodo, Bien = x.DescripcionTipoBien, x.CantidadInventario, x.TotalCantidadContada, x.EstadoConteo });
    private static string Qty(decimal value) => value.ToString("#,##0.####", CultureInfo.InvariantCulture);
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
