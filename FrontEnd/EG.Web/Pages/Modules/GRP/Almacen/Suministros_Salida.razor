@page "/Almacen/Suministros_Salida"
@using System.Globalization
@using EG.Domain.DTOs.Responses.Almacen
@using EG.Web.Pages.Shared
@using EG.Web.Services
@using EG.Web.Shared
@using MudBlazor
@implements IDisposable
@inherits BaseCrudPage<SolicitudSalidaResponse, SolicitudSalidaResponse>

@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<DetalleSolicitudSalidaResponse> DetalleService

<AccessVerification IsInitialized="@(IsInitialized && contextReady)"
                    HasAccess="@HasAccess"
                    NavigateToHome="NavigateToHome">
    <MudContainer Class="operation-page px-3 d-flex flex-column suministro-page" MaxWidth="MaxWidth.False">
        <PageHeader Title="Suministros de salida"
                    Subtitle="Seguimiento de bienes entregados y pendientes por solicitud"
                    Icon="@Icons.Material.Filled.LocalShipping"
                    CanCreate="false"
                    OnRefresh="RefreshAll" />

        <ContextSummaryDialog Title="Resumen de la consulta">
<PreviewContent><span class="summary-label">Solicitudes visibles</span> <strong>@TotalCount.ToString("N0", NumberCulture)</strong></PreviewContent>
<ChildContent><div class="summary-strip">
            <div><span>Solicitudes visibles</span><strong>@TotalCount.ToString("N0", NumberCulture)</strong></div>
            <div><span>Pendiente visible</span><strong>@Qty(Elements.Sum(x => x.TotalPendiente))</strong></div>
            <div><span>Entregado visible</span><strong>@Qty(Elements.Sum(x => x.TotalEntregado))</strong></div>
            <div><span>Entidad</span><strong>@TextOrDash(SucursalStateService.EmpresaNombre)</strong></div>
        </div></ChildContent>
</ContextSummaryDialog>

        <OperationActionPanel Compact="true" Title="Consulta y registra las entregas" Description="La primera solicitud de esta página se abre al cargar. Revisa cantidades autorizadas, entregadas y pendientes." Icon="@Icons.Material.Filled.LocalShipping">
                <HelpContent>
                <ol>
                <li>Pulsa cualquier fila para cargar sus bienes. La solicitud elegida queda resaltada.</li>
                <li>Registrar entrega abre la captura del bien con la solicitud ya seleccionada.</li>
                <li>La autorización y el estado de la solicitud determinan si puedes registrar entregas; los saldos se validan al guardar.</li>
                </ol>
                </HelpContent>
                </OperationActionPanel>
        <div class="split-shell">
            <div class="master-panel">
                <GenericDataGrid FillAvailableHeight="false" TItem="SolicitudSalidaResponse"
                                      EmptyTitle="Sin solicitudes en este contexto"
                                      EmptyMessage="Revisa empresa, ejercicio y filtros. En Suministros sólo se muestran las solicitudes autorizadas." OnRowClick="SelectSolicitud" RowClassFunc="SolicitudRowClass"
                              @ref="table"
                              Title="Solicitudes para suministro"
                              SearchPlaceholder="Buscar por folio, solicitante o area..."
                              ShowExportButton="@CanExport"
                              ServerDataFunc="LoadServerData"
                              ExportFunc="ExportToExcel"
                              SearchString="@SearchString"
                              SearchStringChanged="(s) => SearchString = s"
                              OnSearch="OnSearch">
            <Columns>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInFull" OnClick="@(() => SelectSolicitud(cell.Item))">Ver entregas</MudButton>
                        @if (cell.Item.FkidPolizaConta is > 0)
                        {
                            <ReportOpenButton ReportName="Almacen.Suministros_Salida.Poliza"
                                              EntityId="@cell.Item.FkidPolizaConta"
                                              PrimaryKeyParameter="pk"
                                              Title="Póliza de salida de almacén"
                                              Tooltip="Ver póliza de salida"
                                              Icon="@Icons.Material.Filled.AccountBalance"
                                              Color="Color.Secondary"
                                              Visible="@CanExport" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Folio" Identifier="Folio" PropertyName="Folio" SortBy="x => x.Folio">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Folio)</div>
                        <span>@cell.Item.FechaSolicitud.ToString("dd/MM/yyyy")</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Solicitante" Identifier="Solicitante" PropertyName="Solicitante" SortBy="x => x.Solicitante">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.Solicitante)</div>
                        <span>@TextOrDash(cell.Item.Justificacion)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Areas" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.AreaSolicitaNombre)</div>
                        <span>Entrega: @TextOrDash(cell.Item.AreaEntregaNombre)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Avance" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <div class="main-cell">Ent @Qty(cell.Item.TotalEntregado)</div>
                        <span>Pend @Qty(cell.Item.TotalPendiente)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="SolicitudSalidaResponse" Title="Estatus" Identifier="__column_5" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Style="@StatusStyle(cell.Item)">
                        @TextOrDash(cell.Item.EstatusDescripcion)
                        </MudChip>
                        <span>@(cell.Item.Autorizado ? "Autorizada" : "Abierta")</span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </div>

            <div class="detail-panel">
                <div class="detail-header">
                    <div>
                        <span>Bienes por suministrar</span>
                        <strong>@(selectedSolicitud == null ? "Selecciona una solicitud" : selectedSolicitud.Folio)</strong>
                    </div>
                </div>
                <GenericDataGrid FillAvailableHeight="false" TItem="DetalleSolicitudSalidaResponse"
                                      EmptyTitle="Sin bienes en la solicitud"
                                      EmptyMessage="Revisa la solicitud seleccionada y la búsqueda del detalle." @key="selectedSolicitud?.PkidSolicitudSalida"
                              @ref="detailTable"
                              Title="Detalle de entrega"
                              SearchPlaceholder="Buscar bien..."
                              ShowExportButton="false"
                              ServerDataFunc="LoadDetailData"
                              ExportFunc="() => Task.CompletedTask"
                              SearchString="@detailSearch"
                              SearchStringChanged="(s) => detailSearch = s"
                              OnSearch="OnDetailSearch">
            <Columns>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Acciones" Identifier="__actions" Sortable="false" Filterable="false" Hideable="false" Resizable="false">
                    <CellTemplate Context="cell">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EditNote" Visible="@CanAuthorize" Disabled="@(selectedSolicitud == null || !CanWork(selectedSolicitud))" OnClick="@(() => EditarDetalle(cell.Item))">Registrar entrega</MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Bien" Identifier="TipoBienDescripcion" PropertyName="TipoBienDescripcion" SortBy="x => x.TipoBienDescripcion">
                    <CellTemplate Context="cell">
                        <div class="main-cell">@TextOrDash(cell.Item.TipoBienDescripcion)</div>
                        <span>@TextOrDash(cell.Item.AlmacenClave)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Autorizada" Identifier="__column_2" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadAutorizada ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Entregada" Identifier="__column_3" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        @Qty(cell.Item.CantidadEntregada ?? 0m)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="DetalleSolicitudSalidaResponse" Title="Pendiente" Identifier="__column_4" Sortable="false" Filterable="false">
                    <CellTemplate Context="cell">
                        <MudChip T="string" Size="Size.Small" Color="@(cell.Item.CantidadPendiente <= 0 ? Color.Success : Color.Warning)">
                        @Qty(cell.Item.CantidadPendiente)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </GenericDataGrid>
            </div>
        </div>
    </MudContainer>
</AccessVerification>

@code {
    private bool contextReady;
    private GenericDataGrid<SolicitudSalidaResponse> table = null!;
    private GenericDataGrid<DetalleSolicitudSalidaResponse> detailTable = null!;
    private SolicitudSalidaResponse? selectedSolicitud;
    private List<DetalleSolicitudSalidaResponse> detailElements = new();
    private string detailSearch = string.Empty;
    private int detailTotal;
    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("es-MX");

    protected override string ModuleName => "Almacen";
    protected override string SubModuleName => "Suministros_Salida";
    protected override Type CreateDialogType => typeof(SolicitudSalidaDialog);
    protected override Type EditDialogType => typeof(SolicitudSalidaDialog);
    protected override Type DeleteDialogType => typeof(DeleteDialog<SolicitudSalidaResponse>);
    protected override string GetDefaultSortLabel() => "FechaSolicitud";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await AnioStateService.InitializeAsync();
        await SucursalStateService.InitializeAsync();
        AnioStateService.OnAnioChanged += OnAnioChanged;
        SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
        contextReady = true;
    }

    protected override async Task<TableData<SolicitudSalidaResponse>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        CurrentPage = Math.Max(1, state.Page + 1);
        PageSize = state.PageSize;
        SortLabel = state.SortLabel ?? GetDefaultSortLabel();
        SortDirection = state.SortDirection;
        var filters = new Dictionary<string, object>();
        if (SucursalStateService.EmpresaId.HasValue && SucursalStateService.EmpresaId.Value > 0)
        {
            filters["FkidEmpresaSis"] = SucursalStateService.EmpresaId.Value;
        }
        if (AnioStateService.AnioId.HasValue && AnioStateService.AnioId.Value > 0)
        {
            filters["FkidAnioSis"] = AnioStateService.AnioId.Value;
        }
        filters["Autorizado"] = true;

        var response = await Service.GetAllPaginadoAsync(CurrentPage, PageSize, SearchString, SortLabel, SortDirection, filters);
        Elements = response?.Items?.ToList() ?? new List<SolicitudSalidaResponse>();
        TotalCount = response?.Success == true ? response.TotalCount : 0;
        selectedSolicitud = Elements.FirstOrDefault(x => x.PkidSolicitudSalida == selectedSolicitud?.PkidSolicitudSalida) ?? Elements.FirstOrDefault();
        await InvokeAsync(StateHasChanged);
        return new TableData<SolicitudSalidaResponse> { Items = Elements, TotalItems = TotalCount };
    }

    private async Task<TableData<DetalleSolicitudSalidaResponse>> LoadDetailData(TableState state, CancellationToken cancellationToken)
    {
        if (selectedSolicitud == null)
        {
            return new TableData<DetalleSolicitudSalidaResponse> { Items = new List<DetalleSolicitudSalidaResponse>(), TotalItems = 0 };
        }

        var solicitudId = selectedSolicitud.PkidSolicitudSalida;
        var response = await DetalleService.GetAllPaginadoAsync(
            Math.Max(1, state.Page + 1),
            state.PageSize,
            detailSearch,
            state.SortLabel ?? "TipoBienDescripcion",
            state.SortDirection,
            new Dictionary<string, object> { ["FkidSolicitudSalidaAlma"] = solicitudId });
        if (cancellationToken.IsCancellationRequested || selectedSolicitud?.PkidSolicitudSalida != solicitudId) return new() { Items = [], TotalItems = 0 };
        if (response?.Success != true) throw new InvalidOperationException("No se pudieron consultar los bienes de la solicitud.");
        detailElements = response?.Items?.ToList() ?? new List<DetalleSolicitudSalidaResponse>();
        detailTotal = response?.Success == true ? response.TotalCount : 0;
        return new TableData<DetalleSolicitudSalidaResponse> { Items = detailElements, TotalItems = detailTotal };
    }

    private string SolicitudRowClass(SolicitudSalidaResponse item, int _) => selectedSolicitud?.PkidSolicitudSalida == item.PkidSolicitudSalida ? "operation-selectable-row is-selected" : "operation-selectable-row";

    private async Task SelectSolicitud(SolicitudSalidaResponse item)
    {
        if (selectedSolicitud?.PkidSolicitudSalida == item.PkidSolicitudSalida) return;
        selectedSolicitud = item;
        detailSearch = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditarDetalle(DetalleSolicitudSalidaResponse detail)
    {
        if (selectedSolicitud == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Id"] = detail.PkidDetalleSolicitudSalida,
            ["SolicitudId"] = detail.FkidSolicitudSalidaAlma,
            ["AnioId"] = selectedSolicitud.FkidAnioSis,
            ["SolicitudDescripcion"] = $"{selectedSolicitud.Folio} | {selectedSolicitud.Solicitante}",
            ["ModoEntrega"] = true
        };
        var dialog = await DialogService.ShowAsync<DetalleSolicitudSalidaDialog>("Actualizar entrega", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshAll();
        }
    }

    private async Task RefreshAll()
    {
        await table.ReloadData();
        if (detailTable != null)
        {
            await detailTable.ReloadData();
        }
    }

    private async Task OnDetailSearch()
    {
        await Task.Delay(250);
        await detailTable.ReloadData();
    }

    protected override Task ReloadData() => RefreshAll();

    protected override IEnumerable<object> MapToExcelData(IEnumerable<SolicitudSalidaResponse> items)
    {
        return items.Select(x => new
        {
            x.Folio,
            x.Solicitante,
            AreaSolicita = x.AreaSolicitaNombre,
            AreaEntrega = x.AreaEntregaNombre,
            x.TotalSolicitado,
            x.TotalAutorizado,
            x.TotalEntregado,
            x.TotalPendiente,
            Estatus = x.EstatusDescripcion
        });
    }

    private async void OnEmpresaChanged(int empresaId)
    {
        selectedSolicitud = null;
        await RefreshAll();
    }

    private void OnAnioChanged(int? anioId)
    {
        _ = InvokeAsync(async () =>
        {
            selectedSolicitud = null;
            await RefreshAll();
        });
    }

    public void Dispose()
    {
        AnioStateService.OnAnioChanged -= OnAnioChanged;
        SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        SearchCts?.Cancel();
        SearchCts?.Dispose();
    }

    private static bool CanWork(SolicitudSalidaResponse item) => item.Activo && item.Autorizado && !item.EsFinal;
    private static string StatusStyle(SolicitudSalidaResponse item)
    {
        var color = string.IsNullOrWhiteSpace(item.EstatusColor) ? "#E8F1FF" : item.EstatusColor;
        return $"background:{color}; color:#101828;";
    }

    private static string Qty(decimal value) => value.ToString("#,##0.####", CultureInfo.InvariantCulture);
    private static string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
