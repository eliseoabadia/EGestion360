@using MudBlazor
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (Visible)
{
    <MudTooltip Text="@Tooltip">
        <MudIconButton Icon="@Icon"
                       Color="@Color"
                       Size="@Size"
                       Disabled="@Disabled"
                       OnClick="OpenReport" />
    </MudTooltip>
}

@code {
    [Parameter, EditorRequired] public string ReportName { get; set; } = string.Empty;
    [Parameter] public int? EntityId { get; set; }
    [Parameter] public string PrimaryKeyParameter { get; set; } = "pk";
    [Parameter] public IReadOnlyDictionary<string, string?>? Parameters { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Tooltip { get; set; } = "Ver reporte";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Assessment;
    [Parameter] public Color Color { get; set; } = Color.Secondary;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Visible { get; set; } = true;

    private async Task OpenReport()
    {
        if (string.IsNullOrWhiteSpace(ReportName))
        {
            return;
        }

        var reportIdentifier = BuildReportIdentifier();
        var reportToken = CreateReportToken();
        await StoreReportRouteAsync(reportToken, reportIdentifier, Title ?? ReportName);

        var routeParameters = new Dictionary<string, string?>
        {
            ["name"] = reportToken
        };

        Navigation.NavigateTo($"/Reporting/Viewer?{BuildQuery(routeParameters)}");
    }

    private async Task StoreReportRouteAsync(string reportToken, string reportIdentifier, string title)
    {
        await JS.InvokeVoidAsync("sessionStorage.setItem", BuildReportStorageKey(reportToken), reportIdentifier);
        await JS.InvokeVoidAsync("sessionStorage.setItem", BuildReportTitleStorageKey(reportToken), title);
    }

    private string BuildReportIdentifier()
    {
        var reportParameters = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);

        if (Parameters != null)
        {
            foreach (var parameter in Parameters)
            {
                reportParameters[parameter.Key] = parameter.Value;
            }
        }

        if (EntityId.HasValue)
        {
            reportParameters[PrimaryKeyParameter] = EntityId.Value.ToString();
        }

        var query = BuildQuery(reportParameters);
        return string.IsNullOrWhiteSpace(query) ? ReportName : $"{ReportName}?{query}";
    }

    private static string BuildQuery(IReadOnlyDictionary<string, string?> values)
    {
        return string.Join("&",
            values
                .Where(value => !string.IsNullOrWhiteSpace(value.Key) && !string.IsNullOrWhiteSpace(value.Value))
                .Select(value => $"{Uri.EscapeDataString(value.Key)}={Uri.EscapeDataString(value.Value!)}"));
    }

    private static string CreateReportToken() => $"RPT-{Guid.NewGuid():N}".Substring(0, 16);

    private static string BuildReportStorageKey(string token) => $"eg.report.{token}";

    private static string BuildReportTitleStorageKey(string token) => $"eg.report.title.{token}";
}
