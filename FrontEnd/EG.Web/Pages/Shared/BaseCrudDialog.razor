@using MudBlazor
@typeparam TItem

<MudDialog MaxWidth="@MaxWidth" FullWidth="true" CloseOnEscapeKey="true" Class="crud-dialog">
    <TitleContent>
        <div class="crud-dialog-title">
            <MudText Typo="Typo.h6" Class="crud-dialog-title-text">@Title</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                         OnClick="Cancelar" 
                         Disabled="@isProcessing"
                         Size="Size.Small"
                         Class="crud-dialog-close" />
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Overlay de carga global -->
        <MudOverlay Visible="@loading" Fixed="true" ZIndex="10">
            <div class="crud-dialog-loading d-flex flex-column align-center justify-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="mt-4">@LoadingMessage</MudText>
            </div>
        </MudOverlay>

        @if (!loading)
        {
            <CascadingValue Value="this" Name="BaseDialog">
                <MudPaper Class="crud-dialog-shell" Elevation="2">
                    @ChildContent

                    <div class="crud-dialog-actions">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   OnClick="@(() => { Console.WriteLine("🔔 Click en Cancelar"); Cancelar(); })"
                                   Disabled="@isProcessing">
                            @CancelText
                        </MudButton>

                        @if (ShowConfirmButton)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="@ActionColor"
                                       StartIcon="@ActionIcon"
                                       OnClick="OnConfirmar"
                                       Disabled="@(isProcessing || !CanConfirm)">
                                @if (isProcessing)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Default" Indeterminate="true" />
                                    <span class="ml-2">@ProcessingText</span>
                                }
                                else
                                {
                                    @ActionText
                                }
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            </CascadingValue>
        }
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.Medium;
    [Parameter] public Color ActionColor { get; set; } = Color.Primary;
    [Parameter] public string ActionIcon { get; set; } = Icons.Material.Filled.Save;
    [Parameter] public string ActionText { get; set; } = "Guardar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";
    [Parameter] public string ProcessingText { get; set; } = "Guardando...";
    [Parameter] public string LoadingMessage { get; set; } = "Cargando...";
    [Parameter] public bool CanConfirm { get; set; } = true;
    [Parameter] public bool ShowConfirmButton { get; set; } = true;
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }  // Señal de confirmación con resultado (bool)
    [Parameter] public EventCallback OnCancel { get; set; }
    // Nota: el cierre se notifica al padre mediante SignalClose(success)

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool loading = true;
    private bool isProcessing = false;
    private bool _closed = false;
    private Dictionary<string, object> _registeredComponents = new();

    protected override async Task OnInitializedAsync()
    {
        // No ejecutar LoadDataAsync aquí para evitar ejecución doble
        // El loading se maneja en OnAfterRender o manualmente
        loading = false;
        Console.WriteLine("✅ BaseCrudDialog: Listo para mostrar");
    }

    // Parametro de cierre: hijos pueden notificar éxito o fallo
    public void SignalClose(bool success)
    {
        if (_closed)
        {
            return;
        }

        Console.WriteLine($"🔔 SignalClose llamado con success={success}, MudDialog null? {MudDialog == null}");
        if (MudDialog == null)
        {
            Console.WriteLine("⚠️ SignalClose: MudDialog es null");
            return;
        }
        _closed = true;
        if (success)
        {
            Console.WriteLine("✅ Cerrando diálogo con Ok");
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Console.WriteLine("✅ Cerrando diálogo con Cancel");
            MudDialog.Close(DialogResult.Cancel());
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"📌 BaseCrudDialog renderizado, loading={loading}");
        base.OnAfterRender(firstRender);
    }

    protected virtual Task LoadDataAsync() => Task.CompletedTask;

    protected async Task OnConfirmar()
    {
        if (isProcessing || _closed || !CanConfirm)
        {
            return;
        }

        // Verificar que OnConfirm tiene un handler
        if (!OnConfirm.HasDelegate)
        {
            Console.WriteLine("⚠️ OnConfirm no tiene un handler asignado");
            Close(true);
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            await OnConfirm.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en OnConfirm: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            // Solo llamar StateHasChanged si el diálogo no fue cerrado durante la operación
            if (!_closed)
            {
                StateHasChanged();
            }
        }
    }

    public void Cancelar()
    {
        if (isProcessing || _closed)
        {
            return;
        }

        Console.WriteLine("🔔 Cancelar llamado - cerrando diálogo");
        _closed = true;
        MudDialog.Close(DialogResult.Cancel());
    }

    public void Close(bool success = true)
    {
        if (_closed)
        {
            return;
        }

        _closed = true;
        if (success)
            MudDialog.Close(DialogResult.Ok(true));
        else
            MudDialog.Close(DialogResult.Cancel());
    }

    public void RegisterComponent(string key, object component)
    {
        _registeredComponents[key] = component;
    }

    public TComponent? GetComponent<TComponent>(string key) where TComponent : class
    {
        return _registeredComponents.TryGetValue(key, out var component)
            ? component as TComponent
            : null;
    }

    private object? _lastRegistered;

    public void RegisterComponent(object component)
    {
        _lastRegistered = component;
    }

    public TComponent? GetComponent<TComponent>() where TComponent : class
    {
        return _lastRegistered as TComponent;
    }
}
