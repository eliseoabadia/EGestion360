@using MudBlazor

<section class="eg-page-header mb-4">
    <div class="eg-page-header-copy">
        <span class="eg-page-header-icon">
            <MudIcon Icon="@Icon" Size="Size.Large" />
        </span>
        <div>
            <span class="eg-page-header-kicker">@Kicker</span>
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
    </div>

    @if (HasActions)
    {
        <div class="eg-page-header-actions" aria-label="Acciones de pagina">
            @if (ShowCreateButton)
            {
                <MudTooltip Text="@CreateTooltip">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Visible="@CanCreate"
                                   OnClick="HandleCreate"
                                   Disabled="@IsBusy"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   aria-label="@CreateTooltip" />
                </MudTooltip>
            }
            @if (ShowRefreshButton)
            {
                <MudTooltip Text="Refrescar">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="HandleRefresh"
                                   Disabled="@IsBusy"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   aria-label="Refrescar" />
                </MudTooltip>
            }
            @AdditionalButtons
        </div>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Kicker { get; set; } = "Modulo operativo";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Business;
    [Parameter] public bool ShowCreateButton { get; set; } = true;
    [Parameter] public bool ShowRefreshButton { get; set; } = true;
    [Parameter] public string CreateTooltip { get; set; } = "Nuevo";
    [Parameter] public bool CanCreate { get; set; } = true;
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public RenderFragment? AdditionalButtons { get; set; }

    private bool actionInProgress;
    private bool IsBusy => actionInProgress;
    private bool HasActions => ShowCreateButton || ShowRefreshButton || AdditionalButtons is not null;

    private async Task HandleCreate()
    {
        await RunExclusiveAsync(async () => await OnCreate.InvokeAsync());
    }

    private async Task HandleRefresh()
    {
        await RunExclusiveAsync(async () => await OnRefresh.InvokeAsync());
    }

    private async Task RunExclusiveAsync(Func<Task> action)
    {
        if (actionInProgress)
        {
            return;
        }

        actionInProgress = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
        }
        finally
        {
            actionInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
