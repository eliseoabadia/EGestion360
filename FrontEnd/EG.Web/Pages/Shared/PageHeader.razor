@using EG.Web.Models.Guidance
@inject NavigationManager Navigation
@using MudBlazor

<section class="eg-page-header mb-4">
    <div class="eg-page-header-copy">
        <span class="eg-page-header-icon">
            <MudIcon Icon="@Icon" Size="Size.Large" />
        </span>
        <div>
            <span class="eg-page-header-kicker">@Kicker</span>
            <h1>@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
    </div>

    @if (HasActions)
    {
        <div class="eg-page-header-actions" aria-label="Acciones de pagina">
            @if (ShowCreateButton)
            {
                <MudTooltip Text="@CreateTooltip">
                    @if (!string.IsNullOrWhiteSpace(EffectiveCreateText))
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Visible="@CanCreate" OnClick="HandleCreate" Disabled="@IsBusy" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">@EffectiveCreateText</MudButton>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Visible="@CanCreate"
                                   OnClick="HandleCreate"
                                   Disabled="@IsBusy"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   aria-label="@CreateTooltip" />
                    }
                </MudTooltip>
            }
            @if (ShowRefreshButton)
            {
                <MudTooltip Text="Refrescar">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="HandleRefresh"
                                   Disabled="@IsBusy"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   aria-label="Refrescar" />
                </MudTooltip>
            }
            @AdditionalButtons
        </div>
    }
</section>

@if (ShowNextTask && guidance is null)
{
    <NextTaskPanel Next="@(NextStep ?? EG.Common.ApplicationText.NextTask.SelectRecord)"
                   Owner="@(NextOwner ?? EG.Common.ApplicationText.NextTask.UnknownOwner)"
                   UserTask="@(NextUserTask ?? (ShowCreateButton && CanCreate && OnCreate.HasDelegate
                       ? $"Busca un registro o usa {EffectiveCreateText} para iniciar una captura."
                       : EG.Common.ApplicationText.NextTask.ReadOnly))" />
}

@if (guidance is not null)
{
    <OperationActionPanel Title="@guidance.Title" Description="@guidance.Description" Icon="@Icons.Material.Filled.Info">
        <Actions>
            @foreach (var link in guidance.Links ?? Array.Empty<ModuleGuidanceLink>())
            {
                <ModuleShortcut Module="@link.Module" SubModule="@link.SubModule" Href="@link.Href" Text="@link.Text" />
            }
        </Actions>
        <HelpContent><ol>@foreach (var step in guidance.Steps) { <li>@step</li> }</ol></HelpContent>
    </OperationActionPanel>
}

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Kicker { get; set; } = "Modulo operativo";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Business;
    [Parameter] public bool ShowCreateButton { get; set; } = true;
    [Parameter] public bool ShowRefreshButton { get; set; } = true;
    [Parameter] public string CreateTooltip { get; set; } = "Nuevo";
    [Parameter] public string? CreateText { get; set; } = "Nuevo";
    [Parameter] public bool CanCreate { get; set; } = true;
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public RenderFragment? AdditionalButtons { get; set; }
    [Parameter] public bool ShowNextTask { get; set; } = true;
    [Parameter] public string? NextStep { get; set; }
    [Parameter] public string? NextOwner { get; set; }
    [Parameter] public string? NextUserTask { get; set; }

    private bool actionInProgress;
    private ScreenGuidance? guidance;
    private string? EffectiveCreateText => CreateText == "Nuevo" ? guidance?.CreateText ?? CreateText : CreateText;
    protected override void OnParametersSet()
    {
        var route = Uri.UnescapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]);
        guidance = ScreenGuidanceCatalog.Find(route);
    }
    private bool IsBusy => actionInProgress;
    private bool HasActions => ShowCreateButton || ShowRefreshButton || AdditionalButtons is not null;

    private async Task HandleCreate()
    {
        await RunExclusiveAsync(async () => await OnCreate.InvokeAsync());
    }

    private async Task HandleRefresh()
    {
        await RunExclusiveAsync(async () => await OnRefresh.InvokeAsync());
    }

    private async Task RunExclusiveAsync(Func<Task> action)
    {
        if (actionInProgress)
        {
            return;
        }

        actionInProgress = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await action();
        }
        finally
        {
            actionInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
