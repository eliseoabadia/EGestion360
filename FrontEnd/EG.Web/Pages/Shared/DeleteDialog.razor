@using MudBlazor
@typeparam TItem

<BaseCrudDialog TItem="TItem"
                 @ref="dialog"
                 Title="Eliminar registro"
                 MaxWidth="MaxWidth.Small"
                 ActionColor="Color.Error"
                 ActionIcon="@Icons.Material.Filled.Delete"
                 ActionText="@EG.Common.ApplicationText.Actions.Delete"
                 ProcessingText="Eliminando..."
                LoadingMessage="Cargando..."
                CanConfirm="@(DeleteFunc is not null && !isDeleted)"
                OnConfirm="Eliminar">

    <MudText Typo="Typo.body2">Confirma la baja del registro seleccionado.</MudText>

    @if (!string.IsNullOrEmpty(ItemName))
    {
        <MudText Color="Color.Warning" Class="my-4">
            <strong>@ItemName</strong>
        </MudText>
    }

    <MudAlert Severity="Severity.Warning">
        @ConfirmationMessage
    </MudAlert>
</BaseCrudDialog>
