@typeparam TItem
@using System.Globalization
@using MudBlazor
@implements IDisposable
@inject IJSRuntime JSRuntime

<MudPaper id="@tableElementId" Elevation="@Elevation" Class="pa-4 rounded-lg themed-table eg-generic-table">
    @if (HiddenColumnIndexes.Any())
    {
        <style>
            @((MarkupString)BuildAutoColumnVisibilityCss())
        </style>
    }

    @if (ShowBusyOverlay && actionInProgress)
    {
        <div class="eg-generic-table-busy">
            <div class="eg-generic-table-busy-panel">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Small"
                                     Indeterminate="true" />
                <MudText Typo="Typo.body2">@CurrentBusyMessage</MudText>
            </div>
        </div>
    }

    @if (ShowContextAssistant)
    {
        <section class="eg-context-assistant @ContextAssistantToneClass" aria-label="Asistente contextual">
            <span class="eg-context-assistant-icon">
                <MudIcon Icon="@ContextAssistantIcon" Size="Size.Small" />
            </span>
            <div class="eg-context-assistant-copy">
                <span>@ContextAssistantTitle</span>
                <strong>@EffectiveContextAssistantMessage</strong>
            </div>
            <div class="eg-context-assistant-chips" aria-label="Contexto de tabla">
                @if (!string.IsNullOrWhiteSpace(ContextAssistantScope))
                {
                    <em>@ContextAssistantScope</em>
                }
                <em>@EffectiveTotalCount.ToString("N0", CultureInfo.InvariantCulture) registro(s)</em>
                <em>@(ReadOnly ? "Solo lectura" : "Edicion habilitada")</em>
                @if (HasPendingSearch)
                {
                    <em>Busqueda sin aplicar</em>
                }
                else if (!string.IsNullOrWhiteSpace(AppliedSearchString))
                {
                    <em>Busqueda activa</em>
                }
            </div>
        </section>
    }

    <MudTable ServerData="LoadServerData"
              RowsPerPage="@PageSize"
              Page="@CurrentPage"
              RowCount="@EffectiveTotalCount"
              @ref="mudTableRef"
              FixedHeader="@FixedHeader"
              Height="@TableHeight"
              Dense="@Dense"
              Hover="@Hover"
              Striped="@Striped"
              Loading="@IsTableBusy"
              LoadingProgressColor="Color.Primary"
              ReadOnly="@ReadOnly"
              SortLabel="Ordenar por"
              InitialSortDirection="@InitialSortDirection"
              @bind-SelectedItem="SelectedItem"
              IsEditRowSwitchingBlocked="@BlockSwitch"
              ApplyButtonPosition="TableApplyButtonPosition.End"
              EditButtonPosition="TableEditButtonPosition.End"
              EditTrigger="TableEditTrigger.RowClick">

        <ToolBarContent>
            <div class="eg-table-title">
                <span class="eg-table-title-icon">
                    <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" />
                </span>
                <div>
                    <MudText Typo="Typo.h6">@Title</MudText>
                    <span>@EffectiveTotalCount.ToString("N0", CultureInfo.InvariantCulture) registro(s)</span>
                </div>
            </div>
            <MudSpacer />

            @if (ShowAutoColumnSelector)
            {
                <MudTooltip Text="Mostrar u ocultar columnas">
                    <MudMenu Icon="@Icons.Material.Filled.ViewColumn"
                             Color="Color.Primary"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Class="mr-2"
                             Disabled="@IsTableBusy">
                        <div class="eg-column-menu" @onclick:stopPropagation="true">
                            <MudText Typo="Typo.subtitle2" Class="eg-column-menu-title">Columnas visibles</MudText>
                            @foreach (var column in autoColumnOptions)
                            {
                                <MudCheckBox T="bool"
                                             Dense="true"
                                             Label="@column.Label"
                                             Value="@IsAutoColumnVisible(column.Index)"
                                             ValueChanged="@((bool visible) => SetAutoColumnVisibility(column.Index, visible))"
                                             Disabled="@IsAutoColumnToggleDisabled(column)" />
                            }
                            <MudDivider Class="my-1" />
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="ResetAutoColumnVisibility">
                                Restablecer
                            </MudButton>
                        </div>
                    </MudMenu>
                </MudTooltip>
            }

            @if (ShowExportButton)
            {
                <MudTooltip Text="Exportar a Excel">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel"
                               Size="Size.Small"
                               Class="mr-2"
                               Disabled="@IsTableBusy">
                        @if (actionInProgress)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Exportando...</span>
                        }
                        else
                        {
                            <span>Exportar Excel</span>
                        }
                    </MudButton>
                </MudTooltip>
            }

            @if (ShowAddButton)
            {
                <MudTooltip Text="@AddButtonTooltip">
                    <MudIconButton Icon="@AddButtonIcon"
                                   Color="@AddButtonColor"
                                   Size="Size.Small"
                                   Disabled="@IsTableBusy"
                                   OnClick="AddItem"
                                   Class="mr-2" />
                </MudTooltip>
            }

            @if (ToolbarActions is not null)
            {
                @ToolbarActions
            }

            <MudTextField Value="@SearchString"
                          ValueChanged="@((string? value) => OnSearchTextChanged(value))"
                          Placeholder="@SearchPlaceholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          @ref="searchField"
                          OnKeyUp="HandleKeyUp"
                          Class="eg-table-search mt-0" />
        </ToolBarContent>

        <HeaderContent>
            @Header
        </HeaderContent>

        <RowTemplate>
            @Row(context)
        </RowTemplate>

        <ChildRowContent>
            @if (ChildRow is not null)
            {
                @ChildRow(context)
            }
        </ChildRowContent>

        <NoRecordsContent>
            <div class="eg-table-empty">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" />
                <strong>No se encontraron registros</strong>
                <span>Ajusta la busqueda, filtros o recarga la informacion.</span>
            </div>
        </NoRecordsContent>

        <LoadingContent>
            <div class="eg-generic-table-loading-row">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Small"
                                     Indeterminate="true" />
                <MudText Typo="Typo.body2">@CurrentBusyMessage</MudText>
            </div>
        </LoadingContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página"
                           FirstPageIcon="@Icons.Material.Filled.FirstPage"
                           LastPageIcon="@Icons.Material.Filled.LastPage"
                           NextPageIcon="@Icons.Material.Filled.NavigateNext"
                           PreviousPageIcon="@Icons.Material.Filled.NavigateBefore"
                           PageSizeOptions="@PageSizeOptions"
                           ShowFirstLastPage="true"
                           ShowPageSizeSelector="true"
                           ShowPaginationText="true"
                           InfoFormat="{first_item}-{last_item} de {all_items}"
                           Disabled="@IsTableBusy" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public int Elevation { get; set; } = 2;
    [Parameter] public string SearchPlaceholder { get; set; } = "Buscar...";
    [Parameter] public bool ShowExportButton { get; set; } = true;
    [Parameter] public bool ShowAddButton { get; set; }
    [Parameter] public bool ShowBusyOverlay { get; set; } = true;
    [Parameter] public bool ShowContextAssistant { get; set; } = true;
    [Parameter] public string ContextAssistantTitle { get; set; } = "Asistente contextual";
    [Parameter] public string? ContextAssistantMessage { get; set; }
    [Parameter] public string? ContextAssistantScope { get; set; }
    [Parameter] public bool EnableAutoColumnSelector { get; set; } = true;
    [Parameter] public int AutoColumnSelectorThreshold { get; set; } = 0;
    [Parameter] public bool EnableColumnInteractions { get; set; } = true;
    [Parameter] public string AddButtonTooltip { get; set; } = "Agregar";
    [Parameter] public string AddButtonIcon { get; set; } = Icons.Material.Filled.AddCircleOutline;
    [Parameter] public Color AddButtonColor { get; set; } = Color.Success;
    [Parameter] public string LoadingMessage { get; set; } = "Cargando datos...";
    [Parameter] public string ActionLoadingMessage { get; set; } = "Procesando...";
    [Parameter] public string OpenFormLoadingMessage { get; set; } = "Abriendo formulario...";
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 5, 10, 20, 50 };

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int CurrentPage { get; set; } = 0;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Hover { get; set; } = true;
    [Parameter] public bool Striped { get; set; } = false;
    [Parameter] public bool ReadOnly { get; set; } = true;
    [Parameter] public bool BlockSwitch { get; set; }
    [Parameter] public bool FixedHeader { get; set; } = true;
    [Parameter] public string TableHeight { get; set; } = "100%";
    [Parameter] public SortDirection InitialSortDirection { get; set; } = SortDirection.Descending;
    [Parameter] public TItem? SelectedItem { get; set; }

    [Parameter] public string SearchString { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchStringChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public int SearchDebounceMilliseconds { get; set; } = 400;

    [Parameter] public RenderFragment Header { get; set; } = null!;
    [Parameter] public RenderFragment<TItem> Row { get; set; } = null!;
    [Parameter] public RenderFragment<TItem>? ChildRow { get; set; }
    [Parameter] public RenderFragment? ToolbarActions { get; set; }
    [Parameter] public Func<TableState, CancellationToken, Task<TableData<TItem>>> ServerDataFunc { get; set; } = null!;
    [Parameter] public Func<Task> ExportFunc { get; set; } = null!;
    [Parameter] public EventCallback OnAdd { get; set; }

    private MudTable<TItem>? mudTableRef;
    private MudTextField<string>? searchField;
    private readonly string tableElementId = $"eg-generic-table-{Guid.NewGuid():N}";
    private readonly HashSet<int> hiddenAutoColumnIndexes = new();
    private readonly HashSet<int> hiddenControlColumnIndexes = new();
    private List<AutoColumnOption> autoColumnOptions = new();
    private string autoColumnSignature = string.Empty;
    private bool columnEnhancementsInitialized;
    private bool isLoading = false;
    private bool actionInProgress = false;
    private int? loadedTotalCount;
    private string appliedSearchString = string.Empty;
    private string submittedSearchString = string.Empty;
    private int searchDebounceVersion;
    private bool disposed;
    private bool IsTableBusy => Loading || isLoading || actionInProgress;
    private int EffectiveTotalCount => loadedTotalCount ?? TotalCount;
    private string AppliedSearchString => appliedSearchString;
    private bool HasPendingSearch => !SearchEquals(SearchString, submittedSearchString);
    private string CurrentBusyMessage => actionInProgress ? ActionLoadingMessage : LoadingMessage;
    private string EffectiveContextAssistantMessage => string.IsNullOrWhiteSpace(ContextAssistantMessage)
        ? BuildContextAssistantMessage()
        : ContextAssistantMessage.Trim();
    private string ContextAssistantTone => IsTableBusy || HasPendingSearch ? "info" : EffectiveTotalCount == 0 ? "warning" : "success";
    private string ContextAssistantToneClass => $"tone-{ContextAssistantTone}";
    private string ContextAssistantIcon => ContextAssistantTone switch
    {
        "success" => Icons.Material.Filled.CheckCircle,
        "warning" => Icons.Material.Filled.Lightbulb,
        _ => Icons.Material.Filled.AutoAwesome
    };
    private bool ShowAutoColumnSelector => EnableAutoColumnSelector && autoColumnOptions.Count > Math.Max(0, AutoColumnSelectorThreshold);
    private int VisibleAutoColumnCount => autoColumnOptions.Count(column => IsAutoColumnVisible(column.Index));
    private IEnumerable<int> HiddenColumnIndexes => hiddenAutoColumnIndexes.Concat(hiddenControlColumnIndexes).Distinct();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(submittedSearchString)
            && string.IsNullOrWhiteSpace(appliedSearchString)
            && !string.IsNullOrWhiteSpace(SearchString))
        {
            submittedSearchString = SearchString.Trim();
            appliedSearchString = submittedSearchString;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (columnEnhancementsInitialized)
        {
            return;
        }

        await SetupActionColumnsAsync();

        if (!EnableAutoColumnSelector && !EnableColumnInteractions)
        {
            return;
        }

        if (EnableAutoColumnSelector)
        {
            await SyncAutoColumnOptionsAsync();
        }

        if (EnableColumnInteractions)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("egestionTableColumns.setupInteractions", tableElementId);
            }
            catch (JSException)
            {
                // Optional browser enhancement; the table remains usable without it.
            }
        }

        columnEnhancementsInitialized = true;
    }

    private async Task SetupActionColumnsAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("egestionTableColumns.setupActionColumns", tableElementId);
        }
        catch (JSException)
        {
            // Optional browser enhancement; the table remains usable without it.
        }
    }

    private async Task<TableData<TItem>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        isLoading = true;

        try
        {
            if (ServerDataFunc != null)
            {
                var tableData = await ServerDataFunc(state, cancellationToken);
                loadedTotalCount = tableData.TotalItems;
                appliedSearchString = submittedSearchString;
                return tableData;
            }

            loadedTotalCount = 0;
            appliedSearchString = submittedSearchString;
            return new TableData<TItem> { Items = new List<TItem>(), TotalItems = 0 };
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildContextAssistantMessage()
    {
        if (IsTableBusy)
        {
            return "Estoy actualizando la informacion; espera a que termine antes de ejecutar otra accion.";
        }

        if (HasPendingSearch)
        {
            var typedSearch = SearchString?.Trim() ?? string.Empty;

            return string.IsNullOrWhiteSpace(typedSearch)
                ? "Limpiaste la busqueda. La lista se recargara automaticamente."
                : $"Escribiste \"{typedSearch}\". La busqueda se aplicara automaticamente.";
        }

        if (EffectiveTotalCount == 0 && !string.IsNullOrWhiteSpace(AppliedSearchString))
        {
            return $"No hay coincidencias para \"{AppliedSearchString}\". Limpia la busqueda o revisa filtros activos.";
        }

        if (EffectiveTotalCount == 0)
        {
            return ShowAddButton
                ? "No hay registros en este contexto. Crea uno nuevo o revisa empresa, ejercicio y filtros."
                : "No hay registros para mostrar. Revisa empresa activa, ejercicio, permisos o filtros aplicados.";
        }

        if (!string.IsNullOrWhiteSpace(AppliedSearchString))
        {
            return $"Busqueda aplicada con {EffectiveTotalCount.ToString("N0", CultureInfo.InvariantCulture)} resultado(s). Cambia el texto para recargar.";
        }

        if (ReadOnly)
        {
            return "Vista lista para consulta. Puedes ordenar columnas, ajustar visibilidad, buscar o exportar si tienes permiso.";
        }

        return "Datos listos. Revisa los campos obligatorios antes de guardar y usa la busqueda para enfocar el trabajo.";
    }

    private async Task HandleKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            searchDebounceVersion++;
            await ApplySearchAsync();
        }
    }

    private async Task OnSearchTextChanged(string? value)
    {
        SearchString = value ?? string.Empty;
        await SearchStringChanged.InvokeAsync(SearchString);
        QueueSearchDebounce();
    }

    private void QueueSearchDebounce()
    {
        var version = ++searchDebounceVersion;
        _ = DebounceSearchAsync(version);
    }

    private async Task DebounceSearchAsync(int version)
    {
        try
        {
            await Task.Delay(Math.Max(0, SearchDebounceMilliseconds));

            if (disposed || version != searchDebounceVersion)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                if (disposed || version != searchDebounceVersion)
                {
                    return;
                }

                await ApplySearchAsync();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task ApplySearchAsync()
    {
        if (IsTableBusy)
        {
            return;
        }

        submittedSearchString = SearchString?.Trim() ?? string.Empty;
        await SearchStringChanged.InvokeAsync(SearchString);

        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync();
            return;
        }

        if (mudTableRef is not null)
        {
            await mudTableRef.ReloadServerData();
        }
    }

    private async Task ExportToExcel()
    {
        await RunTableActionAsync(async () =>
        {
            if (ExportFunc != null)
            {
                await ExportFunc();
            }
        });
    }

    private async Task AddItem()
    {
        if (IsTableBusy)
        {
            return;
        }

        await OnAdd.InvokeAsync();
    }

    public async Task ReloadData()
    {
        if (isLoading || mudTableRef is null)
        {
            return;
        }

        await mudTableRef.ReloadServerData();
    }

    private async Task RunTableActionAsync(Func<Task> action)
    {
        if (IsTableBusy)
        {
            return;
        }

        actionInProgress = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await action();
        }
        finally
        {
            actionInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncAutoColumnOptionsAsync()
    {
        try
        {
            var columns = await JSRuntime.InvokeAsync<List<DetectedTableColumn>>("egestionTableColumns.getColumns", tableElementId);
            var detectedDataColumns = columns
                .Where(column => !column.IsAction)
                .Select(column => new AutoColumnOption(column.Index, string.IsNullOrWhiteSpace(column.Label) ? $"Columna {column.Index}" : column.Label.Trim()))
                .ToList();

            var controlColumnIndexes = detectedDataColumns
                .Where(column => IsControlColumnLabel(column.Label))
                .Select(column => column.Index)
                .ToHashSet();

            var signature = string.Join("|", detectedDataColumns.Select(column => $"{column.Index}:{column.Label}:{controlColumnIndexes.Contains(column.Index)}"));

            if (signature == autoColumnSignature)
            {
                return;
            }

            hiddenControlColumnIndexes.Clear();
            foreach (var columnIndex in controlColumnIndexes)
            {
                hiddenControlColumnIndexes.Add(columnIndex);
            }

            var dataColumns = detectedDataColumns
                .Where(column => !hiddenControlColumnIndexes.Contains(column.Index))
                .ToList();

            autoColumnOptions = dataColumns;
            autoColumnSignature = signature;
            hiddenAutoColumnIndexes.RemoveWhere(index => autoColumnOptions.All(column => column.Index != index));
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            autoColumnOptions.Clear();
            hiddenAutoColumnIndexes.Clear();
            hiddenControlColumnIndexes.Clear();
            autoColumnSignature = string.Empty;
        }
    }

    private bool IsAutoColumnVisible(int columnIndex)
        => !hiddenAutoColumnIndexes.Contains(columnIndex) && !hiddenControlColumnIndexes.Contains(columnIndex);

    private bool IsAutoColumnToggleDisabled(AutoColumnOption column)
        => IsAutoColumnVisible(column.Index) && VisibleAutoColumnCount <= 1;

    private void SetAutoColumnVisibility(int columnIndex, bool visible)
    {
        if (visible)
        {
            hiddenAutoColumnIndexes.Remove(columnIndex);
            return;
        }

        if (VisibleAutoColumnCount > 1)
        {
            hiddenAutoColumnIndexes.Add(columnIndex);
        }
    }

    private void ResetAutoColumnVisibility() => hiddenAutoColumnIndexes.Clear();

    private string BuildAutoColumnVisibilityCss()
    {
        var css = new System.Text.StringBuilder();

        foreach (var columnIndex in HiddenColumnIndexes.OrderBy(index => index))
        {
            css.Append('#').Append(tableElementId)
                .Append(" .mud-table > .mud-table-container > table.mud-table-root > thead > tr > th:nth-child(")
                .Append(columnIndex)
                .Append("),#").Append(tableElementId)
                .Append(" .mud-table > .mud-table-container > table.mud-table-root > tbody > tr > td:nth-child(")
                .Append(columnIndex)
                .Append("){display:none!important;}");
        }

        return css.ToString();
    }

    private static bool IsControlColumnLabel(string label)
    {
        var normalized = NormalizeColumnLabel(label);

        return normalized is "activo"
            or "activa"
            or "inactivo"
            or "inactiva"
            or "registroactivo"
            or "estatusregistro"
            or "creacion"
            or "modificacion"
            or "createdby"
            or "createddate"
            or "createdat"
            or "updatedby"
            or "updateddate"
            or "updatedat"
            || normalized.Contains("fechacreacion", StringComparison.Ordinal)
            || normalized.Contains("usuariocreacion", StringComparison.Ordinal)
            || normalized.Contains("fechamodificacion", StringComparison.Ordinal)
            || normalized.Contains("usuariomodificacion", StringComparison.Ordinal)
            || normalized.Contains("fechaalta", StringComparison.Ordinal)
            || normalized.Contains("usuarioalta", StringComparison.Ordinal)
            || normalized.Contains("fechabaja", StringComparison.Ordinal)
            || normalized.Contains("usuariobaja", StringComparison.Ordinal);
    }

    private static string NormalizeColumnLabel(string value)
    {
        var normalized = value.ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var builder = new System.Text.StringBuilder(normalized.Length);

        foreach (var character in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character) != System.Globalization.UnicodeCategory.NonSpacingMark
                && char.IsLetterOrDigit(character))
            {
                builder.Append(character);
            }
        }

        return builder.ToString();
    }

    private static bool SearchEquals(string? left, string? right) =>
        string.Equals(left?.Trim() ?? string.Empty, right?.Trim() ?? string.Empty, StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        disposed = true;
        searchDebounceVersion++;
    }

    private sealed record AutoColumnOption(int Index, string Label);

    private sealed class DetectedTableColumn
    {
        public int Index { get; set; }
        public string Label { get; set; } = string.Empty;
        public bool IsAction { get; set; }
    }
}
