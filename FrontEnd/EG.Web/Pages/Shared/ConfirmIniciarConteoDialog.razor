@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudContainer Class="pa-4">
            <div class="d-flex align-center justify-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Info" 
                         Color="@Color.Info" 
                         Size="Size.Large" 
                         Class="mr-3" />
                <MudText Typo="Typo.h6">@Title</MudText>
            </div>
            <MudText Class="text-center mb-4">@Message</MudText>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" 
                   Color="Color.Default" 
                   Variant="Variant.Text">
            Cancelar
        </MudButton>
        <MudButton OnClick="Confirm" 
                   Color="@ConfirmColor" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Check">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Title { get; set; } = "Confirmar";
    [Parameter] public string Message { get; set; } = "¿Está seguro de continuar?";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
}
