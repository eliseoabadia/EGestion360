@using EG.Web.Models.PresupuestoModificado

<div class="budget-monthly-grid">
    @foreach (var month in BudgetCaptureUi.Months)
    {
        <div @key="month.Index">
            <MudNumericField T="decimal?" Value="@GetAmount(month.Index)"
                             ValueChanged="value => OnAmountChanged.InvokeAsync(new BudgetMonthChange(month.Index, value))"
                             Label="@month.Label" Margin="Margin.Dense" Variant="Variant.Outlined"
                             Immediate="true" DebounceInterval="250" Validation="@(new Func<decimal?, string?>(BudgetCaptureUi.ValidateAmount))"
                             Format="0.00" Culture="@BudgetCaptureUi.NumberCulture" Disabled="@Disabled" />
        </div>
    }
</div>
