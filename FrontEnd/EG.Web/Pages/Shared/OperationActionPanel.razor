@using Microsoft.AspNetCore.Components
@using MudBlazor

<section class="operation-action-panel" aria-label="@Title">
    <div class="operation-action-heading">
        <span class="operation-action-icon"><MudIcon Icon="@Icon" /></span>
        <div class="operation-action-copy">
            <h2>@Title</h2>
            <p>@Description</p>
        </div>
        @if (Actions is not null)
        {
            <div class="operation-action-buttons">@Actions</div>
        }
    </div>
    @if (HelpContent is not null)
    {
        <details class="operation-action-help">
            <summary><MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" /> Guía rápida</summary>
            <div class="operation-action-help-content">@HelpContent</div>
        </details>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Assignment;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? HelpContent { get; set; }
}
