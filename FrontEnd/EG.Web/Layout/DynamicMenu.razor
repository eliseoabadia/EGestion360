@using EG.Web.Extensions
@using EG.Web.Models.Configuration
@using EG.Web.Services
@using EG.Web.Contracts.Configuration
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inject INavigateService NavigateService
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject IJSRuntime _jsRuntime
@inject HttpClient Http

<AuthorizeView>
    <Authorized>
        <div class="bootstrap-sidebar @(IsCollapsed ? "collapsed" : "expanded")">
            @if (!IsCollapsed)
            {
                <div class="sidebar-search-section">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Buscar men&uacute;..."
                               value="@_searchText" @oninput="OnSearchChanged" />
                    </div>
                </div>

                @if (_favorites.Any())
                {
                    <div class="sidebar-favorites">
                        <div class="favorites-header">
                            <i class="bi bi-star-fill"></i>
                            <span>Accesos R&aacute;pidos</span>
                        </div>
                        <div class="favorites-list">
                            @foreach (var fav in _favorites.Take(5))
                            {
                                <div class="favorite-item" @onclick="@(() => NavigateToFavorite(fav.Key))">
                                    <i class="bi @fav.Value"></i>
                                    <span>@fav.Key</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <nav class="sidebar-nav flex-column nav nav-pills">
                @if (Items != null)
                {
                    @foreach (var item in Items.OrderBy(m => m.Orden))
                    {
                        <DynamicMenuItem Item="item" Level="0" IsCollapsed="IsCollapsed"
                            GetExpandedState="GetExpandedState"
                            SetExpandedState="SetExpandedState"
                            GetIcon="GetIcon"
                            FindItemByRoute="FindItemByRoute"
                            AllItems="Items" />
                    }
                }
            </nav>

            <div class="sidebar-version">
                Versi&oacute;n: <span>@_version</span>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool loading = false;
    private bool _isInitialized = false;
    private int _userId;
    private string _token = string.Empty;
    private string _currentPath = string.Empty;

    [Parameter] public List<MenuItem> Items { get; set; } = new();
    [Parameter] public bool IsCollapsed { get; set; } = false;

    private string _version = "1.0.0";
    
    private string _searchText = string.Empty;
    private List<MenuItem> _filteredItems = new();
    
    private Dictionary<string, string> _favorites = new();

    private Dictionary<long, bool> expandedStates = new();

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await base.OnInitializedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        CollapseSameLevelGroups();
        StateHasChanged();
    }

    private void CollapseSameLevelGroups()
    {
        if (string.IsNullOrEmpty(_currentPath)) return;
        var activeItem = FindItemByRoute(Items, _currentPath);
        if (activeItem == null) return;

        var allMenuItems = GetAllMenuItems(Items);
        foreach (var item in allMenuItems.Where(i => i.Children?.Any() == true))
        {
            expandedStates[item.PkidMenu] = false;
        }
        ExpandPathToItem(activeItem);
    }

    private void ExpandPathToItem(MenuItem item)
    {
        var ancestors = GetAncestors(item);
        foreach (var ancestor in ancestors.Where(a => a.Children?.Any() == true))
        {
            expandedStates[ancestor.PkidMenu] = true;
        }
        if (item.Children?.Any() == true)
        {
            expandedStates[item.PkidMenu] = true;
        }
    }

    private List<MenuItem> GetAncestors(MenuItem item)
    {
        var ancestors = new List<MenuItem>();
        var current = item;
        while (current.FkidMenuSis.HasValue)
        {
            var parent = FindItemById(Items, current.FkidMenuSis.Value);
            if (parent != null)
            {
                ancestors.Add(parent);
                current = parent;
            }
            else break;
        }
        return ancestors;
    }

    private List<MenuItem> GetAllMenuItems(List<MenuItem> items)
    {
        var result = new List<MenuItem>(items);
        foreach (var item in items.Where(i => i.Children?.Any() == true))
        {
            result.AddRange(GetAllMenuItems(item.Children));
        }
        return result;
    }

    private MenuItem? FindItemByRoute(List<MenuItem> items, string route)
    {
        foreach (var item in items)
        {
            if (!string.IsNullOrEmpty(item.Ruta) && 
                (item.Ruta == "/" ? route == "/" : route.StartsWith(item.Ruta.TrimEnd('/'))))
            {
                return item;
            }
            if (item.Children?.Any() == true)
            {
                var found = FindItemByRoute(item.Children, route);
                if (found != null) return found;
            }
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
            await LoadMenuAsync();
            await LoadVersionAsync();
        }
    }

    private async Task LoadMenuAsync()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        if (uri == "login" || uri.StartsWith("login?")) return;

        loading = true;
        StateHasChanged();

        try
        {
            string? rawToken = await GetLocalStorageItemWithTimeoutAsync("authToken", 2000);
            if (string.IsNullOrWhiteSpace(rawToken))
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            rawToken = rawToken.Trim();
            if ((rawToken.StartsWith("\"") && rawToken.EndsWith("\"")) ||
                (rawToken.StartsWith("'") && rawToken.EndsWith("'")))
            {
                rawToken = rawToken.Substring(1, rawToken.Length - 2);
            }

            _token = rawToken.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? rawToken.Substring("Bearer ".Length) : rawToken;

            _userId = await GetUserIdAsync();
            if (_userId == 0)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            var result = await NavigateService.GetMenuAsync(_userId);
            if (result?.Items?.Any() == true)
            {
                Items = result.Items;
                InitializeExpandedStates();
            }
            else
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar men&uacute;: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadVersionAsync()
    {
        try
        {
            var versionResponse = await Http.GetFromJsonAsync<VersionApiResult>("api/Navigate/version");
            if (versionResponse != null && versionResponse.Success)
            {
                _version = versionResponse.Version;
            }
        }
        catch
        {
            _version = "1.0.0";
        }
    }
    
    private class VersionApiResult
    {
        public string Version { get; set; } = string.Empty;
        public bool Success { get; set; }
    }

    private void InitializeExpandedStates()
    {
        foreach (var item in Items.Where(m => m.Children?.Any() == true))
        {
            if (!expandedStates.ContainsKey(item.PkidMenu))
            {
                expandedStates[item.PkidMenu] = false;
            }
        }
    }

    private async Task<int> GetUserIdAsync()
    {
        var userId = await AuthService.GetUserIdAsync();
        if (userId != 0) return userId;

        var parsed = ParseUserIdFromToken(_token);
        if (parsed.HasValue) return parsed.Value;

        var stored = await GetLocalStorageItemWithTimeoutAsync("userId", 1000);
        if (!string.IsNullOrEmpty(stored) && int.TryParse(stored, out var sId)) return sId;

        return 0;
    }

    private async Task<string?> GetLocalStorageItemWithTimeoutAsync(string key, int timeoutMs = 1500)
    {
        try
        {
            var task = _jsRuntime.InvokeAsync<string>("localStorage.getItem", key).AsTask();
            var completed = await Task.WhenAny(task, Task.Delay(timeoutMs));
            return completed == task ? await task : null;
        }
        catch { return null; }
    }

    private static int? ParseUserIdFromToken(string jwt)
    {
        try
        {
            var parts = jwt.Split('.');
            if (parts.Length < 2) return null;
            string payload = parts[1];
            int mod4 = payload.Length % 4;
            if (mod4 > 0) payload += new string('=', 4 - mod4);
            var bytes = Convert.FromBase64String(payload);
            var json = System.Text.Encoding.UTF8.GetString(bytes);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            string[] keys = { "UserId", "userId", "id", "Id", "sub", "nameid", "pkIdUsuario" };
            foreach (var prop in root.EnumerateObject())
            {
                if (keys.Any(k => string.Equals(prop.Name, k, StringComparison.OrdinalIgnoreCase)))
                {
                    var val = prop.Value.GetString() ?? prop.Value.ToString();
                    if (int.TryParse(val, out var numeric)) return numeric;
                    var match = System.Text.RegularExpressions.Regex.Match(val ?? "", @"\d+");
                    if (match.Success && int.TryParse(match.Value, out var numeric2)) return numeric2;
                }
            }
        }
        catch { }
        return null;
    }

    private bool GetExpandedState(long? pkId) => 
        pkId.HasValue && expandedStates.TryGetValue(pkId.Value, out var state) ? state : false;

    private void SetExpandedState(long? pkId, bool expanded)
    {
        if (!pkId.HasValue) return;
        expandedStates[pkId.Value] = expanded;
        if (expanded) CollapseSiblings(pkId.Value);
        StateHasChanged();
    }

    private void CollapseSiblings(long expandedId)
    {
        var expandedItem = FindItemById(Items, expandedId);
        if (expandedItem == null) return;
        var parentId = expandedItem.FkidMenuSis;
        var siblings = parentId == null 
            ? Items.Where(i => i.PkidMenu != expandedId && i.Children?.Any() == true)
            : GetChildrenById(Items, parentId)?.Where(i => i.PkidMenu != expandedId && i.Children?.Any() == true);
        if (siblings != null)
        {
            foreach (var sibling in siblings)
            {
                expandedStates[sibling.PkidMenu] = false;
            }
        }
    }

    private MenuItem? FindItemById(List<MenuItem> items, long id)
    {
        foreach (var item in items)
        {
            if (item.PkidMenu == id) return item;
            if (item.Children?.Any() == true)
            {
                var found = FindItemById(item.Children, id);
                if (found != null) return found;
            }
        }
        return null;
    }

    private List<MenuItem>? GetChildrenById(List<MenuItem> items, long? parentId)
    {
        if (!parentId.HasValue) return null;
        var item = FindItemById(items, parentId.Value);
        return item?.Children;
    }

    private static readonly Dictionary<string, string> _iconMap = IconosDisponibles.Lista
        .GroupBy(x => x.Valor)
        .ToDictionary(g => g.Key, g => g.First().BootstrapIcon);

    private string GetIcon(string imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl)) return "bi bi-info-circle";
        return _iconMap.TryGetValue(imageUrl, out var icon) ? icon : "bi bi-info-circle";
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        await Task.CompletedTask;
    }
    
    private void NavigateToFavorite(string itemName)
    {
        var item = FindItemByName(Items, itemName);
        if (item?.Ruta != null)
        {
            NavigationManager.NavigateTo(item.Ruta);
        }
    }
    
    private MenuItem? FindItemByName(List<MenuItem> items, string name)
    {
        foreach (var item in items)
        {
            if (item.Nombre == name) return item;
            if (item.Children?.Any() == true)
            {
                var found = FindItemByName(item.Children, name);
                if (found != null) return found;
            }
        }
        return null;
    }
}

<style>
    .bootstrap-sidebar {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--mud-palette-drawer-background);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .sidebar-search-section {
        padding: 12px;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .sidebar-search-section .input-group-text {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        color: var(--mud-palette-drawer-text);
    }

    .sidebar-search-section .form-control {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-divider);
        color: var(--mud-palette-drawer-text);
        font-size: 0.85rem;
    }

    .sidebar-search-section .form-control::placeholder {
        color: var(--mud-palette-text-disabled);
    }

    .sidebar-search-section .form-control:focus {
        border-color: var(--mud-palette-primary);
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
        background: var(--mud-palette-surface);
        color: var(--mud-palette-drawer-text);
    }

    .sidebar-favorites {
        padding: 8px 12px;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .favorites-header {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--mud-palette-text-secondary);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .favorites-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .favorite-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.82rem;
        color: var(--mud-palette-drawer-text);
        transition: all 0.2s ease;
    }

    .favorite-item:hover {
        background: rgba(99, 102, 241, 0.15);
        color: var(--mud-palette-primary);
    }

    .favorite-item i {
        font-size: 0.9rem;
        color: #fbbf24;
    }

    .sidebar-nav {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px;
        gap: 2px;
    }

    .sidebar-nav::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar-nav::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-nav::-webkit-scrollbar-thumb {
        background: var(--mud-palette-divider);
        border-radius: 4px;
    }

    .sidebar-version {
        padding: 12px 16px;
        text-align: center;
        border-top: 1px solid var(--mud-palette-divider);
        color: var(--mud-palette-text-secondary);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        flex-shrink: 0;
    }

    .sidebar-version span {
        color: var(--mud-palette-primary);
    }

    /* ===================== COLLAPSED STATE ===================== */
    .bootstrap-sidebar.collapsed .sidebar-search-section,
    .bootstrap-sidebar.collapsed .sidebar-favorites,
    .bootstrap-sidebar.collapsed .sidebar-version {
        display: none;
    }

    .bootstrap-sidebar.collapsed .sidebar-nav {
        padding: 4px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .bootstrap-sidebar.collapsed .sidebar-group-header {
        justify-content: center;
        padding: 10px;
        border-radius: 8px;
    }

    .bootstrap-sidebar.collapsed .sidebar-group-header .group-left span,
    .bootstrap-sidebar.collapsed .sidebar-group-header .chevron {
        display: none;
    }

    .bootstrap-sidebar.collapsed .sidebar-group-header .group-left i {
        margin-right: 0;
        font-size: 1.3rem;
    }

    .bootstrap-sidebar.collapsed .sidebar-children {
        display: none;
    }

    /* ===================== THEME: MORENA ===================== */
    .bootstrap-sidebar.morena {
        background: linear-gradient(180deg, #1A1209 0%, #2D1B0F 50%, #3D2A1C 100%) !important;
    }

    .bootstrap-sidebar.morena .sidebar-search-section .input-group-text,
    .bootstrap-sidebar.morena .sidebar-search-section .form-control {
        background: #2D1B0F;
        border-color: #5D3A1A;
        color: #F4E4C1;
    }

    .bootstrap-sidebar.morena .sidebar-search-section .form-control::placeholder {
        color: #8B7355;
    }

    .bootstrap-sidebar.morena .favorites-header {
        color: #8B7355;
    }

    .bootstrap-sidebar.morena .favorite-item {
        color: #F4E4C1;
    }

    .bootstrap-sidebar.morena .favorite-item:hover {
        background: rgba(205, 133, 63, 0.2);
        color: #DEB887;
    }

    .bootstrap-sidebar.morena .sidebar-version {
        border-top-color: #5D3A1A;
        color: #8B7355;
    }

    /* Morena - Level 0: Amber-Brown gradient */
    .bootstrap-sidebar.morena .sidebar-link.level-0,
    .bootstrap-sidebar.morena .sidebar-group-header.level-0 {
        background: linear-gradient(135deg, rgba(205, 133, 63, 0.22) 0%, rgba(139, 92, 246, 0.08) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-0::before,
    .bootstrap-sidebar.morena .sidebar-group-header.level-0::before {
        background: linear-gradient(180deg, #CD853F 0%, #DEB887 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-0:hover,
    .bootstrap-sidebar.morena .sidebar-group-header.level-0:hover {
        background: linear-gradient(135deg, rgba(205, 133, 63, 0.35) 0%, rgba(222, 184, 135, 0.15) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-0.active,
    .bootstrap-sidebar.morena .sidebar-group-header.level-0.active {
        background: linear-gradient(135deg, rgba(205, 133, 63, 0.45) 0%, rgba(222, 184, 135, 0.25) 100%);
    }

    /* Morena - Level 1: Olive-Green gradient */
    .bootstrap-sidebar.morena .sidebar-link.level-1,
    .bootstrap-sidebar.morena .sidebar-group-header.level-1 {
        background: linear-gradient(135deg, rgba(107, 142, 35, 0.18) 0%, rgba(85, 107, 47, 0.10) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-1::before,
    .bootstrap-sidebar.morena .sidebar-group-header.level-1::before {
        background: linear-gradient(180deg, #6B8E23 0%, #556B2F 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-1:hover,
    .bootstrap-sidebar.morena .sidebar-group-header.level-1:hover {
        background: linear-gradient(135deg, rgba(107, 142, 35, 0.30) 0%, rgba(85, 107, 47, 0.18) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-1.active,
    .bootstrap-sidebar.morena .sidebar-group-header.level-1.active {
        background: linear-gradient(135deg, rgba(107, 142, 35, 0.40) 0%, rgba(85, 107, 47, 0.25) 100%);
    }

    /* Morena - Level 2: Terracotta gradient */
    .bootstrap-sidebar.morena .sidebar-link.level-2,
    .bootstrap-sidebar.morena .sidebar-group-header.level-2 {
        background: linear-gradient(135deg, rgba(210, 105, 30, 0.18) 0%, rgba(178, 34, 34, 0.10) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-2::before,
    .bootstrap-sidebar.morena .sidebar-group-header.level-2::before {
        background: linear-gradient(180deg, #D2691E 0%, #B22222 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-2:hover,
    .bootstrap-sidebar.morena .sidebar-group-header.level-2:hover {
        background: linear-gradient(135deg, rgba(210, 105, 30, 0.30) 0%, rgba(178, 34, 34, 0.18) 100%);
    }

    .bootstrap-sidebar.morena .sidebar-link.level-2.active,
    .bootstrap-sidebar.morena .sidebar-group-header.level-2.active {
        background: linear-gradient(135deg, rgba(210, 105, 30, 0.40) 0%, rgba(178, 34, 34, 0.25) 100%);
    }

    /* Morena - scrollbar */
    .bootstrap-sidebar.morena .sidebar-nav::-webkit-scrollbar-thumb,
    .bootstrap-sidebar.morena .sidebar-children::-webkit-scrollbar-thumb {
        background: rgba(205, 133, 63, 0.4);
    }

    .bootstrap-sidebar.morena .sidebar-nav::-webkit-scrollbar-thumb:hover,
    .bootstrap-sidebar.morena .sidebar-children::-webkit-scrollbar-thumb:hover {
        background: rgba(205, 133, 63, 0.6);
    }
</style>
