@using EG.Web.Extensions
@using EG.Web.Helpers
@using EG.Web.Models.Configuration
@using EG.Web.Services
@using EG.Web.Contracts.Configuration
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

@inject INavigateService NavigateService
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime _jsRuntime
@inject IDialogService DialogService

<style>
    /* ========================================
     * DISEÑO PROFESIONAL - MENÚ LATERAL
     * ======================================== */
    
    .professional-nav-menu {
        background: linear-gradient(180deg, #0f172a 0%, #1e293b 50%, #334155 100%) !important;
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
        padding: 12px 8px;
        min-height: 100vh;
        overflow-y: auto;
        border-right: 1px solid rgba(148, 163, 184, 0.1);
    }

    /* Scrollbar personalizado */
    .professional-nav-menu::-webkit-scrollbar {
        width: 6px;
    }

    .professional-nav-menu::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.5);
        border-radius: 3px;
    }

    .professional-nav-menu::-webkit-scrollbar-thumb {
        background: rgba(99, 102, 241, 0.5);
        border-radius: 3px;
        transition: background 0.3s ease;
    }

    .professional-nav-menu::-webkit-scrollbar-thumb:hover {
        background: rgba(99, 102, 241, 0.8);
    }

    /* Items del menú - Base */
    .menu-item {
        margin: 4px 8px;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 500;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
    }

    .menu-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 100%;
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.1) 0%, transparent 100%);
        transition: width 0.4s ease;
        z-index: 0;
    }

    .menu-item:hover::before {
        width: 100%;
    }

    .menu-item > * {
        position: relative;
        z-index: 1;
    }

    /* NIVEL 0 - Índigo premium */
    .menu-item-level-0 {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.12) 0%, rgba(99, 102, 241, 0.04) 100%);
        border-left: 4px solid rgba(99, 102, 241, 0.6);
        padding: 11px 14px !important;
        font-weight: 600;
        font-size: 0.93rem;
        margin: 6px 8px;
    }

    .menu-item-level-0:hover {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.24) 0%, rgba(99, 102, 241, 0.12) 100%);
        border-left-color: #6366f1;
        transform: translateX(4px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }

    .menu-item-level-0.active {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.32) 0%, rgba(99, 102, 241, 0.18) 100%);
        border-left-color: #6366f1;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
    }

    /* NIVEL 1 - Emerald */
    .menu-item-level-1 {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.10) 0%, rgba(16, 185, 129, 0.03) 100%);
        border-left: 3px solid rgba(16, 185, 129, 0.5);
        margin: 4px 8px 4px 14px;
        padding: 9px 12px !important;
        font-size: 0.91rem;
    }

    .menu-item-level-1:hover {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.20) 0%, rgba(16, 185, 129, 0.08) 100%);
        border-left-color: #10b981;
        transform: translateX(3px);
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.2);
    }

    .menu-item-level-1.active {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.28) 0%, rgba(16, 185, 129, 0.14) 100%);
        border-left-color: #10b981;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
    }

    /* NIVEL 2 - Amber */
    .menu-item-level-2 {
        background: linear-gradient(90deg, rgba(245, 158, 11, 0.08) 0%, rgba(245, 158, 11, 0.02) 100%);
        border-left: 3px solid rgba(245, 158, 11, 0.4);
        margin: 4px 8px 4px 22px;
        padding: 8px 11px !important;
        font-size: 0.89rem;
    }

    .menu-item-level-2:hover {
        background: linear-gradient(90deg, rgba(245, 158, 11, 0.18) 0%, rgba(245, 158, 11, 0.06) 100%);
        border-left-color: #f59e0b;
        transform: translateX(3px);
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.15);
    }

    .menu-item-level-2.active {
        background: linear-gradient(90deg, rgba(245, 158, 11, 0.24) 0%, rgba(245, 158, 11, 0.10) 100%);
        border-left-color: #f59e0b;
        font-weight: 600;
        box-shadow: 0 3px 10px rgba(245, 158, 11, 0.2);
    }

    /* NIVEL 3+ - Rose/Purple gradient */
    .menu-item-level-3, .menu-item-level-4, .menu-item-level-5, .menu-item-level-6 {
        background: linear-gradient(90deg, rgba(236, 72, 153, 0.08) 0%, rgba(139, 92, 246, 0.04) 100%);
        border-left: 2px solid rgba(236, 72, 153, 0.35);
        margin: 4px 8px 4px 30px;
        padding: 7px 10px !important;
        font-size: 0.87rem;
        font-weight: 500;
    }

    .menu-item-level-3:hover, .menu-item-level-4:hover, .menu-item-level-5:hover, .menu-item-level-6:hover {
        background: linear-gradient(90deg, rgba(236, 72, 153, 0.16) 0%, rgba(139, 92, 246, 0.08) 100%);
        border-left-color: #ec4899;
        transform: translateX(2px);
        box-shadow: 0 2px 6px rgba(236, 72, 153, 0.15);
    }

    .menu-item-level-3.active, .menu-item-level-4.active, .menu-item-level-5.active, .menu-item-level-6.active {
        background: linear-gradient(90deg, rgba(236, 72, 153, 0.22) 0%, rgba(139, 92, 246, 0.12) 100%);
        border-left-color: #ec4899;
        font-weight: 600;
        box-shadow: 0 3px 8px rgba(236, 72, 153, 0.18);
    }

    /* Iconos - Mejorados */
    .mud-nav-link .mud-icon-size-medium,
    .mud-nav-group-header .mud-icon-size-medium {
        font-size: 22px !important;
        margin-right: 11px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0.85;
    }

    .menu-item:hover .mud-icon-size-medium {
        opacity: 1;
        transform: scale(1.1);
        filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.4));
    }

    .menu-item.active .mud-icon-size-medium {
        opacity: 1;
        filter: drop-shadow(0 0 12px rgba(99, 102, 241, 0.6));
    }

    /* Texto y colores */
    .mud-nav-link, .mud-nav-group-header {
        color: #e2e8f0 !important;
        transition: all 0.3s ease;
    }

    .mud-nav-link:hover, .mud-nav-group-header:hover {
        color: #ffffff !important;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    }

    .mud-nav-link.active, .mud-nav-group-header.active {
        color: #fff !important;
        font-weight: 650;
        text-shadow: 0 0 24px rgba(99, 102, 241, 0.5);
    }

    /* Grupos expandidos */
    .mud-nav-group-expanded .mud-nav-group-header {
        font-weight: 600;
        background: rgba(99, 102, 241, 0.15) !important;
    }

    /* Badge para sub-items */
    .menu-badge {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        border-radius: 12px;
        padding: 2px 8px;
        font-size: 0.72rem;
        font-weight: 700;
        margin-left: auto;
        box-shadow: 0 2px 6px rgba(99, 102, 241, 0.4);
    }

    /* Botón Agregar Menú Global */
    .add-global-button {
        padding: 12px 16px;
        margin: 12px 8px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(139, 92, 246, 0.1) 100%);
        border: 1px solid rgba(99, 102, 241, 0.3);
        transition: all 0.3s ease;
    }

    .add-global-button:hover {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(139, 92, 246, 0.2) 100%);
        border-color: rgba(99, 102, 241, 0.6);
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
        transform: translateY(-2px);
    }
    
    /* Búsqueda IA y Favoritos */
    .menu-search-favorites {
        padding: 16px 12px;
        margin: 8px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(139, 92, 246, 0.05) 100%);
        border: 1px solid rgba(99, 102, 241, 0.2);
    }
    
    .search-section {
        margin-bottom: 16px;
    }
    
    .search-input .mud-input-control {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
    }
    
    .favorites-header {
        display: flex;
        align-items: center;
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }
    
    .favorites-list {
        padding: 0;
        background: transparent;
    }
    
    .favorite-item {
        padding: 6px 8px;
        border-radius: 6px;
        transition: all 0.2s ease;
        cursor: pointer;
        font-size: 0.85rem;
    }
    
    .favorite-item:hover {
        background: rgba(99, 102, 241, 0.15);
    }
    
    .favorite-icon {
        color: #fbbf24;
    }

    /* ========================================
     * TEMA CLARO - Opcional
     * ======================================== */
    .mud-theme-light .professional-nav-menu {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 50%, #f1f5f9 100%) !important;
        border-right: 1px solid #e2e8f0;
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.08);
    }

    .mud-theme-light .menu-item-level-0 {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.08) 0%, rgba(99, 102, 241, 0.02) 100%);
        border-left-color: rgba(99, 102, 241, 0.8);
    }

    .mud-theme-light .menu-item-level-0:hover {
        background: linear-gradient(90deg, rgba(99, 102, 241, 0.16) 0%, rgba(99, 102, 241, 0.06) 100%);
    }

    .mud-theme-light .mud-nav-link,
    .mud-theme-light .mud-nav-group-header {
        color: #1e293b !important;
    }

    .mud-theme-light .mud-nav-link:hover,
    .mud-theme-light .mud-nav-group-header:hover {
        color: #4f46e5 !important;
    }

    .mud-theme-light .mud-nav-link.active,
    .mud-theme-light .mud-nav-group-header.active {
        color: #4338ca !important;
    }
</style>

    <AuthorizeView>
        <Authorized>
            <MudNavMenu Class="professional-nav-menu">
                @if (Items != null)
                {
                    @foreach (var item in Items.OrderBy(m => m.Orden))
                    {
                        <DynamicMenuItem Item="item" Level="0" IsCollapsed="IsCollapsed" 
                                         GetExpandedState="GetExpandedState" 
                                         SetExpandedState="SetExpandedState" GetIcon="GetIcon" 
                                         FindItemByRoute="FindItemByRoute" AllItems="Items" />
                    }
                }
            </MudNavMenu>
            
            @if (!IsCollapsed)
            {
                <!-- Sección de Búsqueda IA y Favoritos -->
                <div class="menu-search-favorites">
                    <div class="search-section">
                        <MudTextField @bind-Value="_searchText"
                                      Label="Buscar menú..."
                                      Placeholder="Escribe para buscar..."
                                      Variant="Variant.Filled"
                                      FullWidth
                                      Immediate="true"
                                      @oninput="OnSearchChanged"
                                      Icon="@Icons.Material.Filled.Search"
                                      Class="search-input" />
                    </div>
                    
                    <div class="favorites-section">
                        <div class="favorites-header">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                            <span>Accesos Rápidos</span>
                        </div>
                        <MudList T="string" Class="favorites-list">
                            @foreach (var fav in _favorites.Take(5))
                            {
                                <MudListItem OnClick="@(() => NavigateToFavorite(fav.Key))" Class="favorite-item">
                                    <MudIcon Icon="@fav.Value" Class="mr-2 favorite-icon" />
                                    @fav.Key
                                </MudListItem>
                            }
                        </MudList>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>

<MudDialog @bind-IsVisible="_showMenuDialog" 
            Title="@(_isEditing ? "Editar Menú" : "Nuevo Menú")"
            MaxWidth="MaxWidth.Small">
    <DialogContent>
        <MudTextField @bind-Value="_editingItem!.Nombre" Label="Nombre" FullWidth Class="mb-3" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editingItem!.Ruta" Label="Ruta" FullWidth Class="mb-3" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_editingItem!.ImageUrl" Label="Icono" FullWidth Class="mb-3" Variant="Variant.Outlined" />
        <MudNumericField @bind-Value="_editingItem!.Orden" Label="Orden" FullWidth Class="mb-3" Variant="Variant.Outlined" />
        <MudSwitch T="bool" @bind-Checked="_editingItem!.Activo" Label="Activo" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showMenuDialog = false)">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveMenuItem">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool loading = false;
    private bool _isInitialized = false;
    private int _userId;
    private string _token = string.Empty;
    private string _currentPath = string.Empty;

    [Parameter] public List<MenuItem> Items { get; set; } = new();
    [Parameter] public bool IsCollapsed { get; set; } = false;

    private bool _showMenuDialog = false;
    private MenuItem? _editingItem = null;
    private bool _isEditing = false;
    private MenuItem? _parentForNewItem = null;
    
    // Búsqueda IA
    private string _searchText = string.Empty;
    private List<MenuItem> _filteredItems = new();
    
    // Favoritos (Top 5)
    private Dictionary<string, string> _favorites = new();

    private Dictionary<long, bool> expandedStates = new();

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await base.OnInitializedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        CollapseSameLevelGroups();
        StateHasChanged();
    }

    private void CollapseSameLevelGroups()
    {
        if (string.IsNullOrEmpty(_currentPath)) return;
        var activeItem = FindItemByRoute(Items, _currentPath);
        if (activeItem == null) return;

        var allMenuItems = GetAllMenuItems(Items);
        foreach (var item in allMenuItems.Where(i => i.Children?.Any() == true))
        {
            expandedStates[item.PkidMenu] = false;
        }
        ExpandPathToItem(activeItem);
    }

    private void ExpandPathToItem(MenuItem item)
    {
        var ancestors = GetAncestors(item);
        foreach (var ancestor in ancestors.Where(a => a.Children?.Any() == true))
        {
            expandedStates[ancestor.PkidMenu] = true;
        }
        if (item.Children?.Any() == true)
        {
            expandedStates[item.PkidMenu] = true;
        }
    }

    private List<MenuItem> GetAncestors(MenuItem item)
    {
        var ancestors = new List<MenuItem>();
        var current = item;
        while (current.FkidMenuSis.HasValue)
        {
            var parent = FindItemById(Items, current.FkidMenuSis.Value);
            if (parent != null)
            {
                ancestors.Add(parent);
                current = parent;
            }
            else break;
        }
        return ancestors;
    }

    private List<MenuItem> GetAllMenuItems(List<MenuItem> items)
    {
        var result = new List<MenuItem>(items);
        foreach (var item in items.Where(i => i.Children?.Any() == true))
        {
            result.AddRange(GetAllMenuItems(item.Children));
        }
        return result;
    }

    private MenuItem? FindItemByRoute(List<MenuItem> items, string route)
    {
        foreach (var item in items)
        {
            if (!string.IsNullOrEmpty(item.Ruta) && 
                (item.Ruta == "/" ? route == "/" : route.StartsWith(item.Ruta.TrimEnd('/'))))
            {
                return item;
            }
            if (item.Children?.Any() == true)
            {
                var found = FindItemByRoute(item.Children, route);
                if (found != null) return found;
            }
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
            await LoadMenuAsync();
        }
    }

    private async Task LoadMenuAsync()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        if (uri == "login" || uri.StartsWith("login?")) return;

        loading = true;
        StateHasChanged();

        try
        {
            string? rawToken = await GetLocalStorageItemWithTimeoutAsync("authToken", 2000);
            if (string.IsNullOrWhiteSpace(rawToken))
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            rawToken = rawToken.Trim();
            if ((rawToken.StartsWith("\"") && rawToken.EndsWith("\"")) ||
                (rawToken.StartsWith("'") && rawToken.EndsWith("'")))
            {
                rawToken = rawToken.Substring(1, rawToken.Length - 2);
            }

            _token = rawToken.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
                ? rawToken.Substring("Bearer ".Length) : rawToken;

            _userId = await GetUserIdAsync();
            if (_userId == 0)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            var result = await NavigateService.GetMenuAsync(_userId);
            if (result?.Items?.Any() == true)
            {
                Items = result.Items;
                InitializeExpandedStates();
            }
            else
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void InitializeExpandedStates()
    {
        foreach (var item in Items.Where(m => m.Children?.Any() == true))
        {
            if (!expandedStates.ContainsKey(item.PkidMenu))
            {
                expandedStates[item.PkidMenu] = false;
            }
        }
    }

    private async Task<int> GetUserIdAsync()
    {
        var userId = await AuthService.GetUserIdAsync();
        if (userId != 0) return userId;

        var parsed = ParseUserIdFromToken(_token);
        if (parsed.HasValue) return parsed.Value;

        var stored = await GetLocalStorageItemWithTimeoutAsync("userId", 1000);
        if (!string.IsNullOrEmpty(stored) && int.TryParse(stored, out var sId)) return sId;

        return 0;
    }

    private async Task<string?> GetLocalStorageItemWithTimeoutAsync(string key, int timeoutMs = 1500)
    {
        try
        {
            var task = _jsRuntime.InvokeAsync<string>("localStorage.getItem", key).AsTask();
            var completed = await Task.WhenAny(task, Task.Delay(timeoutMs));
            return completed == task ? await task : null;
        }
        catch { return null; }
    }

    private static int? ParseUserIdFromToken(string jwt)
    {
        try
        {
            var parts = jwt.Split('.');
            if (parts.Length < 2) return null;
            string payload = parts[1];
            int mod4 = payload.Length % 4;
            if (mod4 > 0) payload += new string('=', 4 - mod4);
            var bytes = Convert.FromBase64String(payload);
            var json = System.Text.Encoding.UTF8.GetString(bytes);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            string[] keys = { "UserId", "userId", "id", "Id", "sub", "nameid", "pkIdUsuario" };
            foreach (var prop in root.EnumerateObject())
            {
                if (keys.Any(k => string.Equals(prop.Name, k, StringComparison.OrdinalIgnoreCase)))
                {
                    var val = prop.Value.GetString() ?? prop.Value.ToString();
                    if (int.TryParse(val, out var numeric)) return numeric;
                    var match = System.Text.RegularExpressions.Regex.Match(val ?? "", @"\d+");
                    if (match.Success && int.TryParse(match.Value, out var numeric2)) return numeric2;
                }
            }
        }
        catch { }
        return null;
    }

    private bool GetExpandedState(long? pkId) => 
        pkId.HasValue && expandedStates.TryGetValue(pkId.Value, out var state) ? state : false;

    private void SetExpandedState(long? pkId, bool expanded)
    {
        if (!pkId.HasValue) return;
        expandedStates[pkId.Value] = expanded;
        if (expanded) CollapseSiblings(pkId.Value);
        StateHasChanged();
    }

    private void CollapseSiblings(long expandedId)
    {
        var expandedItem = FindItemById(Items, expandedId);
        if (expandedItem == null) return;
        var parentId = expandedItem.FkidMenuSis;
        var siblings = parentId == null 
            ? Items.Where(i => i.PkidMenu != expandedId && i.Children?.Any() == true)
            : GetChildrenById(Items, parentId)?.Where(i => i.PkidMenu != expandedId && i.Children?.Any() == true);
        if (siblings != null)
        {
            foreach (var sibling in siblings)
            {
                expandedStates[sibling.PkidMenu] = false;
            }
        }
    }

    private MenuItem? FindItemById(List<MenuItem> items, long id)
    {
        foreach (var item in items)
        {
            if (item.PkidMenu == id) return item;
            if (item.Children?.Any() == true)
            {
                var found = FindItemById(item.Children, id);
                if (found != null) return found;
            }
        }
        return null;
    }

    private List<MenuItem>? GetChildrenById(List<MenuItem> items, long? parentId)
    {
        if (!parentId.HasValue) return null;
        var item = FindItemById(items, parentId.Value);
        return item?.Children;
    }

    private static readonly Dictionary<string, string> _iconMap = IconosDisponibles.Lista
        .GroupBy(x => x.Valor)
        .ToDictionary(g => g.Key, g => g.First().MaterialIcon);

    private string GetIcon(string imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl)) return Icons.Material.Filled.Info;
        return _iconMap.TryGetValue(imageUrl, out var icon) ? icon : Icons.Material.Filled.Info;
    }

    private void AddGlobalMenuItem()
    {
        _editingItem = new MenuItem { PkidMenu = 0, FkidMenuSis = null, Orden = (Items?.Count ?? 0) + 1, Activo = true };
        _parentForNewItem = null;
        _isEditing = false;
        _showMenuDialog = true;
    }

    private void AddChildMenuItem(MenuItem parent)
    {
        _editingItem = new MenuItem { PkidMenu = 0, FkidMenuSis = parent.PkidMenu, Orden = (parent.Children?.Count ?? 0) + 1, Activo = true };
        _parentForNewItem = parent;
        _isEditing = false;
        _showMenuDialog = true;
    }

    private void EditMenuItem(MenuItem item)
    {
        _editingItem = new MenuItem 
        { 
            PkidMenu = item.PkidMenu,
            Nombre = item.Nombre,
            Ruta = item.Ruta,
            ImageUrl = item.ImageUrl,
            FkidMenuSis = item.FkidMenuSis,
            Orden = item.Orden ?? 1,
            Activo = item.Activo,
            LegacyName = item.LegacyName,
            Lenguaje = item.Lenguaje,
            Tipo = item.Tipo
        };
        _isEditing = true;
        _showMenuDialog = true;
    }

    private async Task DeleteMenuItem(MenuItem item)
    {
        // Solo notificación - la funcionalidad real requiere implementar los métodos en el backend
        Snackbar.Add($"Eliminar pendiente: {item.Nombre}", Severity.Info);
        await Task.CompletedTask;
    }

    private async Task SaveMenuItem()
    {
        if (_editingItem == null) return;
        
        // Notificación de que la funcionalidad está pendiente
        Snackbar.Add("Función de guardado pendiente de implementar - Los métodos del servicio no están disponibles", Severity.Info);
        _showMenuDialog = false;
        await Task.CompletedTask;
    }

    public void OnMenuChanged()
    {
        StateHasChanged();
    }
    
    private async Task OnSearchChanged()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _filteredItems = new List<MenuItem>();
        }
        else
        {
            _filteredItems = SearchMenuItems(Items, _searchText.ToLower());
        }
        await Task.CompletedTask;
    }
    
    private List<MenuItem> SearchMenuItems(List<MenuItem> items, string searchTerm)
    {
        var results = new List<MenuItem>();
        
        foreach (var item in items)
        {
            if (item.Nombre.ToLower().Contains(searchTerm) || 
                (item.Ruta?.ToLower().Contains(searchTerm) ?? false))
            {
                results.Add(item);
            }
            
            if (item.Children?.Any() == true)
            {
                results.AddRange(SearchMenuItems(item.Children, searchTerm));
            }
        }
        
        return results;
    }
    
    private void NavigateToFavorite(string itemName)
    {
        var item = FindItemByName(Items, itemName);
        if (item?.Ruta != null)
        {
            NavigationManager.NavigateTo(item.Ruta);
        }
    }
    
    private MenuItem? FindItemByName(List<MenuItem> items, string name)
    {
        foreach (var item in items)
        {
            if (item.Nombre == name) return item;
            if (item.Children?.Any() == true)
            {
                var found = FindItemByName(item.Children, name);
                if (found != null) return found;
            }
        }
        return null;
    }
    
    private void AddToFavorites(MenuItem item)
    {
        if (!_favorites.ContainsKey(item.Nombre) && _favorites.Count < 5)
        {
            _favorites.Add(item.Nombre, item.ImageUrl);
            StateHasChanged();
        }
    }
}
