@using EG.Web.Models.Configuration

@{
    var hasChildren = Item.Children?.Any() == true;
    var level = Math.Min(Level, 2);
    var isExpanded = GetExpandedState(Item.PkidMenu);
    var isActive = IsActiveRoute(Item.Ruta);
    var linkCss = $"sidebar-link level-{level}{(isActive ? " active" : string.Empty)}";
    var groupHeaderCss = $"sidebar-group-header level-{level}{(isExpanded ? " expanded" : string.Empty)}";
    var childrenId = $"sidebar-children-{Item.PkidMenu}";
    var childrenCss = $"sidebar-children {(isExpanded ? "expanded" : "collapsed")}";
    var chevronCss = $"bi bi-chevron-right chevron {(isExpanded ? "expanded" : "")}";
    var iconClass = GetIcon(Item.ImageUrl);
}

@if (hasChildren)
{
    <div class="sidebar-group">
        <button type="button"
                class="@groupHeaderCss"
                title="@(IsCollapsed ? Item.Nombre : null)"
                aria-expanded="@isExpanded"
                aria-controls="@childrenId"
                disabled="@IsNavigationLocked"
                @onclick="ToggleExpand">
            <span class="group-left">
                <i class="bi @iconClass sidebar-icon" aria-hidden="true"></i>
                @if (!IsCollapsed)
                {
                    <span class="menu-label">@Item.Nombre</span>
                }
            </span>

            @if (!IsCollapsed)
            {
                <i class="@chevronCss" aria-hidden="true"></i>
            }
        </button>

        @if (!IsCollapsed)
        {
            <div id="@childrenId" class="@childrenCss" role="group">
                <div class="sidebar-children-inner">
                    @foreach (var child in Item.Children.OrderBy(m => m.Orden ?? int.MaxValue).ThenBy(m => m.Nombre))
                    {
                        <DynamicMenuItem Item="child"
                                         Level="@(Level + 1)"
                                         IsCollapsed="IsCollapsed"
                                         IsNavigationLocked="IsNavigationLocked"
                                         GetExpandedState="GetExpandedState"
                                         SetExpandedState="SetExpandedState"
                                         GetIcon="GetIcon"
                                         IsActiveRoute="IsActiveRoute"
                                         OnNavigate="OnNavigate" />
                    }
                </div>
            </div>
        }
    </div>
}
else if (Item.AbrirEnNuevaVentana)
{
    <div class="sidebar-item @(IsCollapsed ? "sidebar-item-collapsed" : string.Empty)" title="@(IsCollapsed ? Item.Nombre : null)">
        <a class="@linkCss"
           href="@Href"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="@Item.Nombre"
           aria-current="@(isActive ? "page" : null)">
            <i class="bi @iconClass sidebar-icon" aria-hidden="true"></i>
            @if (!IsCollapsed)
            {
                <span class="menu-label">@Item.Nombre</span>
                <i class="bi bi-box-arrow-up-right external-icon" aria-hidden="true"></i>
            }
        </a>
    </div>
}
else
{
    <div class="sidebar-item @(IsCollapsed ? "sidebar-item-collapsed" : string.Empty)" title="@(IsCollapsed ? Item.Nombre : null)">
        <a class="@linkCss"
           href="@Href"
           aria-label="@Item.Nombre"
           aria-current="@(isActive ? "page" : null)"
           @onclick="HandleNavigateAsync"
           @onclick:preventDefault="true">
            <i class="bi @iconClass sidebar-icon" aria-hidden="true"></i>
            @if (!IsCollapsed)
            {
                <span class="menu-label">@Item.Nombre</span>
            }
        </a>
    </div>
}

@code {
    [Parameter] public MenuItem Item { get; set; } = default!;
    [Parameter] public int Level { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsNavigationLocked { get; set; }
    [Parameter] public Func<int?, bool> GetExpandedState { get; set; } = default!;
    [Parameter] public Action<int?, bool> SetExpandedState { get; set; } = default!;
    [Parameter] public Func<string?, string> GetIcon { get; set; } = default!;
    [Parameter] public Func<string?, bool> IsActiveRoute { get; set; } = _ => false;
    [Parameter] public EventCallback<MenuItem> OnNavigate { get; set; }

    private string Href => string.IsNullOrWhiteSpace(Item.Ruta) ? "#" : Item.Ruta;

    private void ToggleExpand()
    {
        if (IsNavigationLocked)
            return;

        SetExpandedState(Item.PkidMenu, !GetExpandedState(Item.PkidMenu));
    }

    private Task HandleNavigateAsync()
    {
        if (IsNavigationLocked)
            return Task.CompletedTask;

        return OnNavigate.InvokeAsync(Item);
    }
}
