@using EG.Web.Models.Configuration

@{
    var hasChildren = Item.Children?.Any() == true;
    var level = Math.Min(Level, 2);
    var isExpanded = GetExpandedState(Item.PkidMenu);
    var isDirectlyActive = IsActiveRoute(Item.Ruta);
    var hasActiveDescendant = hasChildren && HasActiveDescendant(Item);
    var isActive = isDirectlyActive || hasActiveDescendant;
    var selectedCss = isDirectlyActive ? " current" : hasActiveDescendant ? " active-branch" : string.Empty;
    var groupCss = $"sidebar-group level-{level}-group{(isExpanded ? " expanded" : string.Empty)}{(hasActiveDescendant ? " active-branch" : string.Empty)}";
    var linkCss = $"sidebar-link level-{level}{(isActive ? " active" : string.Empty)}{selectedCss}";
    var groupHeaderCss = $"sidebar-group-header level-{level}{(isExpanded ? " expanded" : string.Empty)}{(isActive ? " active" : string.Empty)}{selectedCss}";
    var childrenId = $"sidebar-children-{Item.PkidMenu}";
    var childrenCss = $"sidebar-children level-{level}-children {(isExpanded ? "expanded" : "collapsed")}";
    var chevronCss = $"chevron {(isExpanded ? "expanded" : "")}";
    var iconClass = GetIcon(Item.ImageUrl);
    var dashboardRoute = Level == 0 ? GetDashboardRoute(Item) : null;
    var hasDashboardShortcut = !string.IsNullOrWhiteSpace(dashboardRoute);
    var dashboardCss = $"dashboard-shortcut{(hasDashboardShortcut && IsActiveRoute(dashboardRoute) ? " active" : string.Empty)}";
}

@if (hasChildren)
{
    <div class="@groupCss">
        <div class="sidebar-group-row @(hasDashboardShortcut && !IsCollapsed ? "has-dashboard" : string.Empty)">
            <button type="button"
                    class="@groupHeaderCss"
                    title="@(IsCollapsed ? Item.Nombre : null)"
                    aria-expanded="@isExpanded"
                    aria-controls="@childrenId"
                    disabled="@IsNavigationLocked"
                    @onclick="ToggleExpand">
                <span class="group-left">
                    <MudIcon Icon="@iconClass" Class="sidebar-icon" Size="Size.Small" />
                    @if (!IsCollapsed)
                    {
                        <span class="menu-label">@Item.Nombre</span>
                        @if (isDirectlyActive)
                        {
                            <span class="selected-indicator" aria-hidden="true"></span>
                        }
                    }
                </span>

                @if (!IsCollapsed)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="@chevronCss" Size="Size.Small" />
                }
            </button>

            @if (hasDashboardShortcut && !IsCollapsed)
            {
                <button type="button"
                        class="@dashboardCss"
                        title="@($"Dashboard {Item.Nombre}")"
                        aria-label="@($"Abrir dashboard de {Item.Nombre}")"
                        disabled="@IsNavigationLocked"
                        @onclick="@(() => HandleDashboardNavigateAsync(dashboardRoute))">
                    <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" />
                </button>
            }
        </div>

        @if (!IsCollapsed)
        {
            <div id="@childrenId" class="@childrenCss" role="group">
                <div class="sidebar-children-inner">
                    @foreach (var child in Item.Children.OrderBy(m => m.Orden ?? int.MaxValue).ThenBy(m => m.Nombre))
                    {
                        <DynamicMenuItem Item="child"
                                         Level="@(Level + 1)"
                                         IsCollapsed="IsCollapsed"
                                         IsNavigationLocked="IsNavigationLocked"
                                         GetExpandedState="GetExpandedState"
                                         SetExpandedState="SetExpandedState"
                                         GetIcon="GetIcon"
                                         IsActiveRoute="IsActiveRoute"
                                         GetDashboardRoute="GetDashboardRoute"
                                         OnNavigate="OnNavigate"
                                         OnDashboardNavigate="OnDashboardNavigate" />
                    }
                </div>
            </div>
        }
    </div>
}
else if (Item.AbrirEnNuevaVentana)
{
    <div class="sidebar-item @(IsCollapsed ? "sidebar-item-collapsed" : string.Empty)" title="@(IsCollapsed ? Item.Nombre : null)">
        <a class="@linkCss"
           href="@Href"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="@Item.Nombre"
           aria-current="@(isActive ? "page" : null)">
            <MudIcon Icon="@iconClass" Class="sidebar-icon" Size="Size.Small" />
            @if (!IsCollapsed)
            {
                <span class="menu-label">@Item.Nombre</span>
                @if (isDirectlyActive)
                {
                    <span class="selected-indicator" aria-hidden="true"></span>
                }
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="external-icon" Size="Size.Small" />
            }
        </a>
    </div>
}
else
{
    <div class="sidebar-item @(IsCollapsed ? "sidebar-item-collapsed" : string.Empty) @(hasDashboardShortcut && !IsCollapsed ? "sidebar-item-with-dashboard" : string.Empty)" title="@(IsCollapsed ? Item.Nombre : null)">
        <a class="@linkCss"
           href="@Href"
           aria-label="@Item.Nombre"
           aria-current="@(isActive ? "page" : null)"
           @onclick="HandleNavigateAsync">
            <MudIcon Icon="@iconClass" Class="sidebar-icon" Size="Size.Small" />
            @if (!IsCollapsed)
            {
                <span class="menu-label">@Item.Nombre</span>
                @if (isDirectlyActive)
                {
                    <span class="selected-indicator" aria-hidden="true"></span>
                }
            }
        </a>
        @if (hasDashboardShortcut && !IsCollapsed)
        {
            <button type="button"
                    class="@dashboardCss"
                    title="@($"Dashboard {Item.Nombre}")"
                    aria-label="@($"Abrir dashboard de {Item.Nombre}")"
                    disabled="@IsNavigationLocked"
                    @onclick="@(() => HandleDashboardNavigateAsync(dashboardRoute))">
                <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" />
            </button>
        }
    </div>
}

@code {
    [Parameter] public MenuItem Item { get; set; } = default!;
    [Parameter] public int Level { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsNavigationLocked { get; set; }
    [Parameter] public Func<int?, bool> GetExpandedState { get; set; } = default!;
    [Parameter] public Action<int?, bool> SetExpandedState { get; set; } = default!;
    [Parameter] public Func<string?, string> GetIcon { get; set; } = default!;
    [Parameter] public Func<string?, bool> IsActiveRoute { get; set; } = _ => false;
    [Parameter] public Func<MenuItem, string?> GetDashboardRoute { get; set; } = _ => null;
    [Parameter] public EventCallback<MenuItem> OnNavigate { get; set; }
    [Parameter] public EventCallback<string> OnDashboardNavigate { get; set; }

    private string Href => string.IsNullOrWhiteSpace(Item.Ruta) ? "#" : Item.Ruta;

    private void ToggleExpand()
    {
        if (IsNavigationLocked)
            return;

        SetExpandedState(Item.PkidMenu, !GetExpandedState(Item.PkidMenu));
    }

    private Task HandleNavigateAsync()
    {
        if (IsNavigationLocked)
            return Task.CompletedTask;

        return OnNavigate.InvokeAsync(Item);
    }

    private Task HandleDashboardNavigateAsync(string? route)
    {
        if (IsNavigationLocked || string.IsNullOrWhiteSpace(route))
            return Task.CompletedTask;

        return OnDashboardNavigate.InvokeAsync(route);
    }

    private bool HasActiveDescendant(MenuItem item)
        => item.Children?.Any(child => IsActiveRoute(child.Ruta) || HasActiveDescendant(child)) == true;
}
