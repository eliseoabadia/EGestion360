    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private static string BuildCacheBustedRoute(string route, string reason)
    {
        var separator = route.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{route}{separator}{reason}=1&t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
    }

    private string GetHeaderCompanyName()
    {
        return "EGestion360";
    }

    private async Task RefreshHeaderCompanyNameAsync()
    {
        var fallback = FirstText(SucursalStateService.EmpresaNombreCorto, SucursalStateService.EmpresaNombre, GetHeaderCompanyName());
        _headerCompanyName = fallback;

        if (SucursalStateService.EmpresaId is not > 0)
        {
            return;
        }

        try
        {
            var response = await EmpresaService.GetByIdAsync(SucursalStateService.EmpresaId.Value);
            var empresa = response?.Data ?? response?.Items?.FirstOrDefault();
            if (empresa == null)
            {
                return;
            }

            var shortName = FirstText(empresa.NombreCorto, empresa.EmpresaNombre, empresa.RazonSocial, fallback);
            var fullName = FirstText(empresa.EmpresaNombre, empresa.RazonSocial, shortName);
            _headerCompanyName = shortName;
            await SucursalStateService.SetEmpresaInfoAsync(empresa.PkidEmpresa, fullName, shortName, notify: false);
        }
        catch
        {
            _headerCompanyName = fallback;
        }
    }

    private static string FirstText(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private string _version = "1.0.0";

    private class VersionApiResult
    {
        public string Version { get; set; } = string.Empty;
        public bool Success { get; set; }
    }

    private async Task LoadVersionAsync()
    {
        try
        {
            var versionResponse = await Http.GetFromJsonAsync<VersionApiResult>("api/Navigate/version");
            if (versionResponse != null && versionResponse.Success)
            {
                _version = versionResponse.Version;
            }
        }
        catch
        {
            _version = "1.0.0";
        }
    }

    public void Dispose()
    {
        ThemeStateService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        if (_sucursalChangeSubscribed)
        {
            SucursalStateService.OnSucursalChanged -= OnSucursalChanged;
        }

        if (_empresaChangeSubscribed)
        {
            SucursalStateService.OnEmpresaChanged -= OnEmpresaChanged;
        }
    }
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        min-height: 100dvh;
        overflow: hidden;
    }

    :root,
    body,
    .layout-root,
    .mud-dialog {
        --eg-primary: var(--mud-palette-primary);
        --eg-primary-light: var(--mud-palette-primary-lighten, var(--mud-palette-primary));
        --eg-primary-dark: var(--mud-palette-primary-darken, var(--mud-palette-primary));
        --eg-secondary: var(--mud-palette-secondary);
        --eg-secondary-light: var(--mud-palette-secondary-lighten, var(--mud-palette-secondary));
        --eg-secondary-dark: var(--mud-palette-secondary-darken, var(--mud-palette-secondary));
        --eg-accent: var(--mud-palette-drawer-icon, var(--mud-palette-secondary));
        --eg-on-primary: var(--mud-palette-primary-text, var(--mud-palette-white));
        --eg-primary-soft: color-mix(in srgb, var(--eg-primary) 14%, transparent);
        --eg-primary-hover: color-mix(in srgb, var(--eg-primary) 24%, transparent);
        --eg-primary-active: color-mix(in srgb, var(--eg-primary) 34%, transparent);
