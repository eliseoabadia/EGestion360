@inherits LayoutComponentBase
@implements IDisposable
@using EG.Domain.DTOs.Responses.Presupuestales
@inject NavigationManager NavigationManager
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject ThemeStateService ThemeStateService
@inject IGenericCrudService<AniosResponse> AnioService
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="layout-root">
    <MudAppBar Elevation="0" Class="modern-app-bar">
        @if (!esPaginaLogin)
        {
            <MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@((e) => DrawerToggle())"
                           class="menu-toggle" />
        }

        <div class="app-branding">
            <button type="button"
                    class="brand-home-button"
                    title="Ir a inicio"
                    aria-label="Ir a inicio"
                    @onclick="NavigateHome">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="brand-icon" />
            </button>
            <MudText Typo="Typo.h5" Class="app-title">EGestion<span class="title-accent">360</span></MudText>
        </div>

        <MudSpacer />
        
        @if (!esPaginaLogin)
        {
            <!-- Información del usuario y sucursal -->
            <div class="user-section">
                @if (!string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre))
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Business"
                             class="user-chip">
                        @SucursalStateService.EmpresaNombre
                    </MudChip>
                }

                <MudSelect T="int?"
                           Value="@_selectedAnioId"
                           ValueChanged="OnAnioSeleccionado"
                           Label="Año"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="@_aniosLoading"
                           Class="anio-header-select"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.CalendarMonth">
                    @foreach (var anio in _anios)
                    {
                        <MudSelectItem T="int?" Value="@anio.PkidAnio">@anio.Clave</MudSelectItem>
                    }
                </MudSelect>

                <MudChip T="string"
                         Color="Color.Secondary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Store"
                         class="user-chip">
                    @(SucursalStateService.SucursalNombre ?? "Sin sucursal")
                </MudChip>
                
                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Person"
                         class="user-chip">
                    @nombreUsuario
                </MudChip>

                <NotificationBell />
                
                <!-- Selector de tema -->
                <MudMenu Icon="@Icons.Material.Filled.Palette"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="theme-menu">
                    @foreach (var option in Enum.GetValues<AppThemeOption>())
                    {
                        <MudMenuItem OnClick="@(() => SelectThemeOption(option))">
                            <div class="theme-option">
                                <MudIcon Icon="@GetThemeIcon(option)" />
                                <span>@GetThemeLabel(option)</span>
                                @if (option == _selectedThemeOption)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="theme-check" />
                                }
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>
                
                <!-- Menú de usuario -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                         Color="Color.Inherit" 
                         AnchorOrigin="Origin.BottomRight" 
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="@NavigateToProfile">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" />
                        Perfil
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="@Logout">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesión
                    </MudMenuItem>
                </MudMenu>
            </div>
        }
    </MudAppBar>

    @if (!esPaginaLogin)
    {
        <div class="page-body">
            <div class="sidebar-container @(_drawerOpen ? "expanded" : "collapsed")">
                <DynamicMenu IsCollapsed="!_drawerOpen" ThemeKey="@_selectedTheme" />
            </div>
            <button type="button"
                    class="sidebar-resize-handle @(_drawerOpen ? "visible" : "collapsed")"
                    title="Arrastra para ajustar el menu"
                    aria-label="Ajustar ancho del menu lateral"
                    aria-hidden="@(!_drawerOpen)"
                    tabindex="@(_drawerOpen ? "0" : "-1")"></button>
            <main class="main-content">
                <div class="content-wrapper">
                    @Body
                </div>
            </main>
        </div>
        
        <div class="version-footer">
            Versión: <span>@_version</span>
        </div>
    }
    else
    {
        <div class="login-page-container">
            @Body
        </div>
    }
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">??</a>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private AppThemeOption _selectedThemeOption { get; set; } = AppThemeOption.Oscuro;

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private string _selectedTheme = "default";
    private MudTheme _theme = new MudTheme();
    private string nombreUsuario = "Usuario";
    private List<AniosResponse> _anios = new();
    private int? _selectedAnioId;
    private bool _aniosLoading;
    private bool _shellInitialized;
    private bool _sidebarResizeInitialized;
    private bool _sucursalChangeSubscribed;
    private bool esPaginaLogin => NavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ThemeStateService.InitializeAsync();
        ApplyThemeFromState();
        ThemeStateService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        if (esPaginaLogin)
        {
            await LoadVersionAsync();
            return;
        }

        await EnsureShellInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (esPaginaLogin || _sidebarResizeInitialized)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("egestionSidebarResize.initialize");
            _sidebarResizeInitialized = true;
        }
        catch
        {
            _sidebarResizeInitialized = false;
        }
    }

    private async Task EnsureShellInitializedAsync()
    {
        if (_shellInitialized || esPaginaLogin)
            return;

        await CargarUsuarioAsync();
        await SucursalStateService.InitializeAsync();
        await AnioStateService.InitializeAsync();
        await LoadAniosAsync();
        await LoadVersionAsync();

        if (!_sucursalChangeSubscribed)
        {
            SucursalStateService.OnSucursalChanged += OnSucursalChanged;
            _sucursalChangeSubscribed = true;
        }

        _shellInitialized = true;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (e.Location.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            _shellInitialized = false;
            _sidebarResizeInitialized = false;
            _anios.Clear();
            _selectedAnioId = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(async () =>
        {
            await EnsureShellInitializedAsync();
            StateHasChanged();
        });
    }

    private void OnSucursalChanged(int sucursalId, string sucursalNombre)
    {
        StateHasChanged();
    }

    private async Task LoadAniosAsync()
    {
        try
        {
            _aniosLoading = true;
            var response = await AnioService.GetAllPaginadoAsync(1, 100, string.Empty, "Clave", SortDirection.Descending);
            if (response?.Success != true || response.Items == null || response.Items.Count == 0)
            {
                Console.WriteLine($"LoadAniosAsync: GetAllPaginado no regreso anios. Success={response?.Success}, Message={response?.Message}");
                response = await AnioService.GetAllAsync();
            }

            _anios = response?.Items?.Where(x => x.Activo).OrderByDescending(x => x.Clave).ToList() ?? new List<AniosResponse>();

            if (!_anios.Any())
            {
                Console.WriteLine("LoadAniosAsync: no hay anios presupuestales activos para mostrar.");
                return;
            }

            var selected = _anios.FirstOrDefault(x => x.PkidAnio == AnioStateService.AnioId)
                ?? _anios.FirstOrDefault(x => x.Clave == DateTime.Today.Year)
                ?? _anios.First();

            _selectedAnioId = selected.PkidAnio;
            if (AnioStateService.AnioId != selected.PkidAnio)
                await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadAniosAsync: error al cargar anios presupuestales. {ex.Message}");
            _anios = new List<AniosResponse>();
        }
        finally
        {
            _aniosLoading = false;
        }
    }

    private async Task OnAnioSeleccionado(int? anioId)
    {
        _selectedAnioId = anioId;
        var selected = _anios.FirstOrDefault(x => x.PkidAnio == anioId);
        if (selected == null)
        {
            await AnioStateService.ClearAnioAsync();
            return;
        }

        await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
    }

    private async Task CargarUsuarioAsync()
    {
        try
        {
            var userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userName");
            if (!string.IsNullOrEmpty(userName))
            {
                nombreUsuario = userName;
            }
            else
            {
                var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
                if (!string.IsNullOrEmpty(userId))
                {
                    nombreUsuario = $"ID: {userId}";
                }
            }
        }
        catch { }
    }

    private async Task Logout()
    {
        if (AuthenticationStateProvider is AuthenticationProviderJWT authProvider)
        {
            await authProvider.LogoutAsync();
        }

        NavigationManager.NavigateTo("/login", replace: true);
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/perfil");
    }

    private async Task SelectThemeOption(AppThemeOption option)
    {
        await ThemeStateService.SetThemeAsync(option);
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("mudBlazorTheme.applyTheme");
    }

    private void OnThemeChanged(AppThemeOption option)
    {
        ApplyThemeFromState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyThemeFromState()
    {
        _selectedThemeOption = ThemeStateService.SelectedOption;
        _isDarkMode = ThemeStateService.IsDarkMode;
        _selectedTheme = ThemeStateService.ThemeKey;
        LoadTheme();
    }

    private static string GetThemeIcon(AppThemeOption option) => option switch
    {
        AppThemeOption.Claro => Icons.Material.Outlined.LightMode,
        AppThemeOption.Oscuro => Icons.Material.Outlined.DarkMode,
        AppThemeOption.Morena => Icons.Material.Filled.Park,
        _ => Icons.Material.Outlined.DarkMode
    };

    private static string GetThemeLabel(AppThemeOption option) =>
        EG.Web.Services.ThemeStateService.GetThemeName(option);

    private void LoadTheme()
    {
        _theme = new MudTheme
        {
            PaletteLight = GetLightPalette(),
            PaletteDark = GetDarkPalette(),
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "10px"
            },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Segoe UI", "Roboto", "Arial", "sans-serif" },
                    FontSize = "0.95rem"
                },
                H5 = new H5Typography
                {
                    FontWeight = "700",
                    FontSize = "1.4rem"
                },
                Overline = new OverlineTypography
                {
                    FontSize = "0.8rem",
                    FontWeight = "500"
                },
                Subtitle2 = new Subtitle2Typography
                {
                    FontSize = "0.875rem",
                    FontWeight = "500"
                }
            }
        };
    }

    private PaletteLight GetLightPalette()
    {
        if (_selectedTheme == "morena")
        {
            return new PaletteLight
            {
                Primary = "#A11A1F",
                PrimaryLighten = "#C43A3F",
                PrimaryDarken = "#6F000B",
                Secondary = "#D8A13A",
                SecondaryLighten = "#F0C66A",
                SecondaryDarken = "#A77418",
                Tertiary = "#7B0010",
                TertiaryLighten = "#9D1B2A",
                TertiaryDarken = "#520008",
                Background = "#F7F7F8",
                Surface = "#FFFFFF",
                AppbarBackground = "#76000D",
                AppbarText = "#FFFFFF",
                DrawerBackground = "#A11A1F",
                DrawerText = "#FFFFFF",
                DrawerIcon = "#FFC928",
                TextDisabled = "#9CA3AF",
                ActionDefault = "#A11A1F",
                ActionDisabled = "#C7B9B9",
                ActionDisabledBackground = "#F3EAEA",
                Divider = "#E7D6D6",
                LinesDefault = "#E7D6D6",
                TableLines = "#E7D6D6",
                Info = "#6F000B",
                Success = "#198754",
                Warning = "#D8A13A",
                Error = "#D71920",
                GrayLight = "#E7D6D6",
                GrayLighter = "#F3EAEA",
                OverlayLight = "#6F000B40",
                Black = "#000000",
                White = "#FFFFFF",
            };
        }

        return new PaletteLight
        {
            Primary = "#2563EB",
            PrimaryLighten = "#3B82F6",
            PrimaryDarken = "#1D4ED8",
            Secondary = "#7C3AED",
            SecondaryLighten = "#8B5CF6",
            SecondaryDarken = "#6D28D9",
            Tertiary = "#059669",
            TertiaryLighten = "#10B981",
            TertiaryDarken = "#047857",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#F1F5F9",
            DrawerText = "#1E293B",
            DrawerIcon = "#2563EB",
            TextDisabled = "#94A3B8",
            ActionDefault = "#2563EB",
            ActionDisabled = "#CBD5E1",
            ActionDisabledBackground = "#F1F5F9",
            Divider = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            TableLines = "#E2E8F0",
            Info = "#0284C7",
            Success = "#059669",
            Warning = "#D97706",
            Error = "#DC2626",
            GrayLight = "#E2E8F0",
            GrayLighter = "#F1F5F9",
            OverlayLight = "#00000040",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private PaletteDark GetDarkPalette()
    {
        if (_selectedTheme == "morena")
        {
            return new PaletteDark
            {
                Primary = "#B91C2B",
                PrimaryLighten = "#DC3545",
                PrimaryDarken = "#7B0010",
                Secondary = "#D8A13A",
                SecondaryLighten = "#F0C66A",
                SecondaryDarken = "#A77418",
                Tertiary = "#FFC928",
                Background = "#1A0709",
                Surface = "#2A0B0F",
                AppbarBackground = "#65000A",
                AppbarText = "#F8FAFC",
                DrawerBackground = "#8F151C",
                DrawerText = "#FFFFFF",
                DrawerIcon = "#FFC928",
                TextDisabled = "#C9A7AA",
                ActionDefault = "#D8A13A",
                ActionDisabled = "#704046",
                ActionDisabledBackground = "#3A1015",
                Divider = "#5A1A20",
                LinesDefault = "#5A1A20",
                TableLines = "#5A1A20",
                Info = "#F0C66A",
                Success = "#74C69D",
                Warning = "#FFC928",
                Error = "#FF6B6B",
                GrayLight = "#5A1A20",
                GrayLighter = "#3A1015",
                OverlayLight = "#1A070980",
                Black = "#000000",
                White = "#FFFFFF",
            };
        }

        return new PaletteDark
        {
            Primary = "#3B82F6",
            PrimaryLighten = "#60A5FA",
            PrimaryDarken = "#2563EB",
            Secondary = "#8B5CF6",
            SecondaryLighten = "#A78BFA",
            SecondaryDarken = "#7C3AED",
            Tertiary = "#10B981",
            TertiaryLighten = "#34D399",
            TertiaryDarken = "#059669",
            Background = "#0F172A",
            Surface = "#1E293B",
            AppbarBackground = "#1E293B",
            AppbarText = "#F8FAFC",
            DrawerBackground = "#0F172A",
            DrawerText = "#F8FAFC",
            DrawerIcon = "#3B82F6",
            TextDisabled = "#64748B",
            ActionDefault = "#3B82F6",
            ActionDisabled = "#475569",
            ActionDisabledBackground = "#1E293B",
            Divider = "#334155",
            LinesDefault = "#334155",
            TableLines = "#334155",
            Info = "#38BDF8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            GrayLight = "#334155",
            GrayLighter = "#1E293B",
            OverlayLight = "#0F172A80",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private string _version = "1.0.0";

    private class VersionApiResult
    {
        public string Version { get; set; } = string.Empty;
        public bool Success { get; set; }
    }

    private async Task LoadVersionAsync()
    {
        try
        {
            var versionResponse = await Http.GetFromJsonAsync<VersionApiResult>("api/Navigate/version");
            if (versionResponse != null && versionResponse.Success)
            {
                _version = versionResponse.Version;
            }
        }
        catch
        {
            _version = "1.0.0";
        }
    }

    public void Dispose()
    {
        ThemeStateService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        if (_sucursalChangeSubscribed)
        {
            SucursalStateService.OnSucursalChanged -= OnSucursalChanged;
        }
    }
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100vh;
        overflow: hidden;
    }

    :root,
    body,
    .layout-root,
    .mud-dialog {
        --eg-primary: var(--mud-palette-primary);
        --eg-primary-light: var(--mud-palette-primary-lighten, var(--mud-palette-primary));
        --eg-primary-dark: var(--mud-palette-primary-darken, var(--mud-palette-primary));
        --eg-secondary: var(--mud-palette-secondary);
        --eg-secondary-light: var(--mud-palette-secondary-lighten, var(--mud-palette-secondary));
        --eg-secondary-dark: var(--mud-palette-secondary-darken, var(--mud-palette-secondary));
        --eg-accent: var(--mud-palette-drawer-icon, var(--mud-palette-secondary));
        --eg-on-primary: var(--mud-palette-primary-text, var(--mud-palette-white));
        --eg-primary-soft: color-mix(in srgb, var(--eg-primary) 14%, transparent);
        --eg-primary-hover: color-mix(in srgb, var(--eg-primary) 24%, transparent);
        --eg-primary-active: color-mix(in srgb, var(--eg-primary) 34%, transparent);
        --eg-accent-soft: color-mix(in srgb, var(--eg-accent) 18%, transparent);
    }

    .layout-root {
        --eg-appbar-height: 64px;
        --eg-footer-height: 30px;
        --eg-sidebar-width: 320px;
        --eg-sidebar-collapsed-width: 64px;
        --eg-sidebar-min-width: 260px;
        --eg-sidebar-max-width: 420px;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .modern-app-bar {
        background: var(--mud-palette-appbar-background) !important;
        border-bottom: 1px solid var(--mud-palette-divider);
        height: var(--eg-appbar-height);
        min-height: var(--eg-appbar-height);
        max-height: var(--eg-appbar-height);
        align-items: center;
        padding: 0 16px;
        flex-shrink: 0;
        z-index: 1200;
    }

    .app-branding {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .brand-home-button {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: inherit;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .brand-home-button:hover {
        background: var(--mud-palette-action-default-hover);
        transform: translateY(-1px);
    }

    .brand-home-button:focus-visible {
        outline: 2px solid var(--mud-palette-primary);
        outline-offset: 2px;
    }

    .brand-icon {
        font-size: 1.5rem;
        color: var(--mud-palette-drawer-icon);
    }

    .app-title {
        font-weight: 700;
        color: var(--mud-palette-appbar-text);
    }

    .title-accent {
        color: var(--mud-palette-drawer-icon);
    }

    .menu-toggle {
        min-width: 36px;
    }

    .user-section {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 12px;
    }

    .anio-header-select {
        width: 130px;
        flex-shrink: 0;
    }

    .anio-header-select .mud-input-control {
        margin-top: 0;
    }

    .modern-app-bar .mud-input,
    .modern-app-bar .mud-input input,
    .modern-app-bar .mud-select-input,
    .modern-app-bar .mud-input-label,
    .modern-app-bar .mud-input-adornment,
    .modern-app-bar .mud-input-adornment .mud-icon-root {
        color: var(--mud-palette-appbar-text) !important;
        opacity: 1;
    }

    .modern-app-bar .mud-input-label {
        background: var(--mud-palette-appbar-background);
        padding: 0 4px;
    }

    .modern-app-bar .mud-input-outlined-border {
        border-color: color-mix(in srgb, var(--mud-palette-appbar-text) 78%, transparent) !important;
    }

    .modern-app-bar .mud-input:hover .mud-input-outlined-border,
    .modern-app-bar .mud-input:focus-within .mud-input-outlined-border {
        border-color: var(--eg-accent) !important;
    }

    .modern-app-bar .mud-chip {
        color: var(--mud-palette-appbar-text);
    }

    .modern-app-bar .mud-chip .mud-icon-root,
    .modern-app-bar .mud-button-root .mud-icon-root {
        color: var(--eg-accent);
    }

    .user-chip {
        background: var(--eg-primary-soft);
        border: 1px solid color-mix(in srgb, var(--eg-accent) 70%, transparent);
        color: var(--mud-palette-appbar-text);
    }

    .theme-option {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 132px;
    }

    .theme-check {
        margin-left: auto;
        color: var(--mud-palette-primary);
    }

    .page-body {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
        padding-top: var(--eg-appbar-height);
    }

    .sidebar-container {
        width: var(--eg-sidebar-width);
        flex-shrink: 0;
        background: var(--mud-palette-drawer-background);
        border-right: 1px solid var(--mud-palette-divider);
        overflow: hidden;
        transition: width 180ms ease, box-shadow 180ms ease;
        align-self: stretch;
