@inherits LayoutComponentBase
@implements IDisposable
@using EG.Domain.DTOs.Responses.General
@using EG.Domain.DTOs.Responses.Presupuestales
@inject NavigationManager NavigationManager
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject ThemeStateService ThemeStateService
@inject IGenericCrudService<AniosResponse> AnioService
@inject IGenericCrudService<EmpresaResponse> EmpresaService
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="layout-root @ShellThemeClass">
    <MudAppBar Elevation="0" Class="modern-app-bar">
        <div class="header-left">
            @if (!esPaginaLogin)
            {
                <MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@((e) => DrawerToggle())"
                               class="menu-toggle" />
            }

            <div class="app-branding">
                <button type="button"
                        class="brand-home-button"
                        title="@BrandTitle"
                        aria-label="Ir a inicio"
                        @onclick="NavigateHome">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="brand-icon" />
                </button>
                <MudText Typo="Typo.h5" Class="app-title" title="@BrandTitle">@_headerCompanyName</MudText>
            </div>
        </div>

        <div class="appbar-spacer" aria-hidden="true"></div>
        
        @if (!esPaginaLogin)
        {
            <!-- Información del usuario y sucursal -->
            <div class="user-section">
                @if (!string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre))
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Business"
                             class="user-chip">
                        @SucursalStateService.EmpresaNombre
                    </MudChip>
                }

                <MudSelect T="int?"
                           Value="@_selectedAnioId"
                           ValueChanged="OnAnioSeleccionado"
                           Label="Año"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="@_aniosLoading"
                           Class="anio-header-select"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.CalendarMonth">
                    @foreach (var anio in _anios)
                    {
                        <MudSelectItem T="int?" Value="@anio.PkidAnio">@anio.Clave</MudSelectItem>
                    }
                </MudSelect>

                <MudChip T="string"
                         Color="Color.Secondary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Store"
                         class="user-chip">
                    @(SucursalStateService.SucursalNombre ?? "Sin sucursal")
                </MudChip>
                
                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Person"
                         class="user-chip">
                    @nombreUsuario
                </MudChip>

                <NotificationBell />
                
                <!-- Selector de tema -->
                <MudMenu Icon="@Icons.Material.Filled.Palette"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="theme-menu">
                    @foreach (var option in Enum.GetValues<AppThemeOption>())
                    {
                        <MudMenuItem OnClick="@(() => SelectThemeOption(option))" Class="theme-menu-item">
                            <div class="theme-option">
                                <span class="theme-swatch @GetThemeSwatchClass(option)" aria-hidden="true">
                                    <MudIcon Icon="@GetThemeIcon(option)" Size="Size.Small" />
                                </span>
                                <span class="theme-copy">
                                    <span>@GetThemeLabel(option)</span>
                                    <small>@GetThemeDescription(option)</small>
                                </span>
                                @if (option == _selectedThemeOption)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="theme-check" />
                                }
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>
                
                <!-- Menú de usuario -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                         Color="Color.Inherit" 
                         AnchorOrigin="Origin.BottomRight" 
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="@NavigateToProfile">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" />
                        Perfil
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="@Logout">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesión
                    </MudMenuItem>
                </MudMenu>
            </div>
        }
    </MudAppBar>

    @if (!esPaginaLogin)
    {
        <div class="page-body">
            <div class="sidebar-container @(_drawerOpen ? "expanded" : "collapsed")">
                <DynamicMenu IsCollapsed="!_drawerOpen" ThemeKey="@_selectedTheme" />
            </div>
            <button type="button"
                    class="sidebar-resize-handle @(_drawerOpen ? "visible" : "collapsed")"
                    title="Arrastra para ajustar el menú"
                    aria-label="Ajustar ancho del menú lateral"
                    aria-hidden="@(!_drawerOpen)"
                    tabindex="@(_drawerOpen ? "0" : "-1")"></button>
            <main class="main-content">
                <div class="content-wrapper">
                    @Body
                </div>
            </main>
        </div>
        
        <div class="version-footer">
            Versión: <span>@_version</span>
        </div>
    }
    else
    {
        <div class="login-page-container">
            @Body
        </div>
    }
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">??</a>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private AppThemeOption _selectedThemeOption { get; set; } = AppThemeOption.Oscuro;

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private string _selectedTheme = "default";
    private MudTheme _theme = new MudTheme();
    private string nombreUsuario = "Usuario";
    private string _headerCompanyName = "EGestion360";
    private List<AniosResponse> _anios = new();
    private int? _selectedAnioId;
    private bool _aniosLoading;
    private bool _shellInitialized;
    private bool _sidebarResizeInitialized;
    private bool _sucursalChangeSubscribed;
    private bool _empresaChangeSubscribed;
    private bool esPaginaLogin => NavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);
    private string BrandTitle => string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre)
        ? _headerCompanyName
        : SucursalStateService.EmpresaNombre;
    private string ShellThemeClass => _selectedTheme == "morena"
        ? "theme-morena"
        : _isDarkMode ? "theme-oscuro" : "theme-claro";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _headerCompanyName = GetHeaderCompanyName();
        await ThemeStateService.InitializeAsync();
        ApplyThemeFromState();
        ThemeStateService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        if (esPaginaLogin)
        {
            await LoadVersionAsync();
            return;
        }

        await EnsureShellInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (esPaginaLogin || _sidebarResizeInitialized)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("egestionSidebarResize.initialize");
            _sidebarResizeInitialized = true;
        }
        catch
        {
            _sidebarResizeInitialized = false;
        }
    }

    private async Task EnsureShellInitializedAsync()
    {
        if (_shellInitialized || esPaginaLogin)
            return;

        await CargarUsuarioAsync();
        await SucursalStateService.InitializeAsync();
        await RefreshHeaderCompanyNameAsync();
        await AnioStateService.InitializeAsync();
        await LoadAniosAsync();
        await LoadVersionAsync();

        if (!_sucursalChangeSubscribed)
        {
            SucursalStateService.OnSucursalChanged += OnSucursalChanged;
            _sucursalChangeSubscribed = true;
        }

        if (!_empresaChangeSubscribed)
        {
            SucursalStateService.OnEmpresaChanged += OnEmpresaChanged;
            _empresaChangeSubscribed = true;
        }

        _shellInitialized = true;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (e.Location.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            _shellInitialized = false;
            _sidebarResizeInitialized = false;
            _anios.Clear();
            _selectedAnioId = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(async () =>
        {
            await EnsureShellInitializedAsync();
            StateHasChanged();
        });
    }

    private void OnSucursalChanged(int sucursalId, string sucursalNombre)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshHeaderCompanyNameAsync();
            StateHasChanged();
        });
    }

    private void OnEmpresaChanged(int empresaId)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshHeaderCompanyNameAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAniosAsync()
    {
        try
        {
            _aniosLoading = true;
            var response = await AnioService.GetAllPaginadoAsync(1, 100, string.Empty, "Clave", SortDirection.Descending);
            if (response?.Success != true || response.Items == null || response.Items.Count == 0)
            {
                response = await AnioService.GetAllAsync();
            }

            _anios = response?.Items?.Where(x => x.Activo).OrderByDescending(x => x.Clave).ToList() ?? new List<AniosResponse>();

            if (!_anios.Any())
            {
                return;
            }

            var selected = _anios.FirstOrDefault(x => x.PkidAnio == AnioStateService.AnioId)
                ?? _anios.FirstOrDefault(x => x.Clave == DateTime.Today.Year)
                ?? _anios.First();

            _selectedAnioId = selected.PkidAnio;
            if (AnioStateService.AnioId != selected.PkidAnio)
                await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
        }
        catch (Exception ex)
        {
            _anios = new List<AniosResponse>();
        }
        finally
        {
            _aniosLoading = false;
        }
    }

    private async Task OnAnioSeleccionado(int? anioId)
    {
        _selectedAnioId = anioId;
        var selected = _anios.FirstOrDefault(x => x.PkidAnio == anioId);
        if (selected == null)
        {
            await AnioStateService.ClearAnioAsync();
            return;
        }

        await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
    }

    private async Task CargarUsuarioAsync()
    {
        try
        {
            var userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userName");
            if (!string.IsNullOrEmpty(userName))
            {
                nombreUsuario = userName;
            }
            else
            {
                var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
                if (!string.IsNullOrEmpty(userId))
                {
                    nombreUsuario = $"ID: {userId}";
                }
            }
        }
        catch (Exception ex)
        {
            AppLoggerFactory.CreateLogger("MainLayout")
                .LogDebug(ex, "No se pudo recuperar el nombre del usuario desde el almacenamiento local.");
        }
    }

    private async Task Logout()
    {
        if (AuthenticationStateProvider is AuthenticationProviderJWT authProvider)
        {
            await authProvider.LogoutAsync();
        }

        NavigationManager.NavigateTo(BuildCacheBustedRoute("/login", "logout"), forceLoad: true, replace: true);
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/perfil");
    }

    private async Task SelectThemeOption(AppThemeOption option)
    {
        await ThemeStateService.SetThemeAsync(option);
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("mudBlazorTheme.applyTheme");
    }

    private void OnThemeChanged(AppThemeOption option)
    {
        ApplyThemeFromState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyThemeFromState()
    {
        _selectedThemeOption = ThemeStateService.SelectedOption;
        _isDarkMode = ThemeStateService.IsDarkMode;
        _selectedTheme = ThemeStateService.ThemeKey;
        LoadTheme();
    }

    private static string GetThemeIcon(AppThemeOption option) => option switch
    {
        AppThemeOption.Claro => Icons.Material.Outlined.LightMode,
        AppThemeOption.Oscuro => Icons.Material.Outlined.DarkMode,
        AppThemeOption.Morena => Icons.Material.Filled.LocalFireDepartment,
        _ => Icons.Material.Outlined.DarkMode
    };

    private static string GetThemeLabel(AppThemeOption option) =>
        EG.Web.Services.ThemeStateService.GetThemeName(option);

    private static string GetThemeDescription(AppThemeOption option) => option switch
    {
        AppThemeOption.Claro => "Azul institucional, limpio y diurno",
        AppThemeOption.Oscuro => "Azul profundo para jornadas largas",
        AppThemeOption.Morena => "Carbon, terracota y cobre nocturno",
        _ => string.Empty
    };

    private static string GetThemeSwatchClass(AppThemeOption option) => option switch
    {
        AppThemeOption.Claro => "theme-swatch-claro",
        AppThemeOption.Oscuro => "theme-swatch-oscuro",
        AppThemeOption.Morena => "theme-swatch-morena",
        _ => "theme-swatch-oscuro"
    };

    private void LoadTheme()
    {
        _theme = new MudTheme
        {
            PaletteLight = GetLightPalette(),
            PaletteDark = GetDarkPalette(),
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "12px"
            },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Segoe UI Variable", "Segoe UI", "Roboto", "Arial", "sans-serif" },
                    FontSize = "0.95rem"
                },
                H5 = new H5Typography
                {
                    FontWeight = "700",
                    FontSize = "1.4rem"
                },
                Overline = new OverlineTypography
                {
                    FontSize = "0.8rem",
                    FontWeight = "500"
                },
                Subtitle2 = new Subtitle2Typography
                {
                    FontSize = "0.875rem",
                    FontWeight = "500"
                }
            }
        };
    }

