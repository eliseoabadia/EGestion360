@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject SucursalStateService SucursalStateService
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<link href="/css/menu-overlays.css" rel="stylesheet" />
<script src="/js/download.js"></script>
<script src="/js/mudBlazorTheme.js"></script>

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="layout-root">
<MudAppBar Elevation="0" Class="modern-app-bar">
@if (!esPaginaLogin)
{
<MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
Color="Color.Inherit"
Edge="Edge.Start"
OnClick="@((e) => DrawerToggle())"
class="menu-toggle" />
}

<div class="app-branding">
<MudIcon Icon="@Icons.Material.Filled.Assessment" Class="brand-icon" />
<MudText Typo="Typo.h5" Class="app-title">EGestion<span class="title-accent">360</span></MudText>
</div>
@if (!esPaginaLogin)
{
<MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
Color="Color.Inherit"
Edge="Edge.Start"
OnClick="@((e) => DrawerToggle())"
class="menu-toggle" />
}

<MudSpacer />
        
        @if (!esPaginaLogin)
        {
            <!-- Información del usuario y sucursal -->
            <div class="user-section">
                <MudChip T="string" 
                         Color="Color.Secondary" 
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Store"
                         class="user-chip">
                    @(SucursalStateService.SucursalNombre ?? "Sin sucursal")
                </MudChip>
                
        <MudChip T="string"
        Color="Color.Primary"
        Variant="Variant.Outlined"
        Size="Size.Small"
        Icon="@Icons.Material.Filled.Person">
        @nombreUsuario
        </MudChip>
                
                <!-- Selector de tema -->
                <MudMenu Icon="@Icons.Material.Filled.Palette"
                        Color="Color.Inherit"
                        AnchorOrigin="Origin.BottomRight"
                        TransformOrigin="Origin.TopRight"
                        Class="theme-menu">
                    @foreach (var option in Enum.GetValues<ThemeOption>())
                    {
                        <MudMenuItem OnClick="@(() => SelectThemeOption(option))">
                            <div class="theme-option">
                                @if (option == ThemeOption.Claro)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.LightMode" />
                                }
                                else if (option == ThemeOption.Oscuro)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.DarkMode" />
                                }
                                else if (option == ThemeOption.Morena)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Park" Style="color: #8B4513;" />
                                }
                                <span>@option.ToString()</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>
                
                <!-- Men� de usuario -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                        Color="Color.Inherit" 
                        AnchorOrigin="Origin.BottomRight" 
                        TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="@Logout">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesi�n
                    </MudMenuItem>
                </MudMenu>
            </div>
        }
    </MudAppBar>

@if (!esPaginaLogin)
{
<MudDrawer Open="_drawerOpen"
ClipMode="DrawerClipMode.Always"
Elevation="2"
Width="@(_drawerOpen ? "17%" : "60px")"
Class="custom-drawer">
<DynamicMenu IsCollapsed="!_drawerOpen" />
</MudDrawer>

<div class="content-area @(_drawerOpen ? "drawer-open" : "")">
<div class="content-wrapper">
@Body
</div>
</div>
}
else
{
<div class="login-page-container">
@Body
</div>
}
    </div>

    @if (!esPaginaLogin)
    {
        <div class="version-footer">
            Versión: <span>@_version</span>
        </div>
    }

    <div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">??</a>
</div>

@code {
    public enum ThemeOption
    {
        Claro,
        Oscuro,
        Morena
    }

    private MudThemeProvider _themeProvider = null!;
    private ThemeOption _selectedThemeOption { get; set; } = ThemeOption.Oscuro;

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private string _selectedTheme = "default";
    private MudTheme _theme = new MudTheme();
    private string nombreUsuario = "Usuario";
    private bool esPaginaLogin => NavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

protected override async Task OnInitializedAsync()
{
base.OnInitialized();
OnThemeOptionChanged();
await CargarUsuarioAsync();
await SucursalStateService.InitializeAsync();
await LoadVersionAsync();
SucursalStateService.OnSucursalChanged += OnSucursalChanged;
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
if (firstRender)
{
await ApplyMenuThemeClass();
}
}

    private void OnSucursalChanged(int sucursalId, string sucursalNombre)
    {
        StateHasChanged();
    }

    private async Task CargarUsuarioAsync()
    {
        try
        {
            var userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userName");
            if (!string.IsNullOrEmpty(userName))
            {
                nombreUsuario = userName;
            }
            else
            {
                var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
                if (!string.IsNullOrEmpty(userId))
                {
                    nombreUsuario = $"ID: {userId}";
                }
            }
        }
        catch { }
    }

    private async Task Logout()
    {
        NavigationManager.NavigateTo("/login", forceLoad: true);
        await Task.CompletedTask;
    }

private async Task SelectThemeOption(ThemeOption option)
{
_selectedThemeOption = option;
OnThemeOptionChanged();
await InvokeAsync(StateHasChanged);
await JSRuntime.InvokeVoidAsync("mudBlazorTheme.applyTheme");

// Forzar actualización del menú - aplicar clase morena si corresponde
await Task.Delay(100); // Esperar a que el DOM se actualice
await ApplyMenuThemeClass();
}

private async Task ApplyMenuThemeClass()
{
try
{
if (_selectedTheme == "morena")
{
await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('.professional-nav-menu').forEach(el => el.classList.add('morena'))");
}
else
{
await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('.professional-nav-menu').forEach(el => el.classList.remove('morena'))");
}
}
catch { }
}

    private void OnThemeOptionChanged()
    {
        switch (_selectedThemeOption)
        {
            case ThemeOption.Claro:
                _isDarkMode = false;
                _selectedTheme = "default";
                break;
            case ThemeOption.Oscuro:
                _isDarkMode = true;
                _selectedTheme = "default";
                break;
            case ThemeOption.Morena:
                _isDarkMode = true;
                _selectedTheme = "morena";
                break;
        }
        LoadTheme();
    }

    private void LoadTheme()
    {
        _theme = new MudTheme
        {
            PaletteLight = GetLightPalette(),
            PaletteDark = GetDarkPalette(),
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "10px"
            },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Segoe UI", "Roboto", "Arial", "sans-serif" },
                    FontSize = "0.95rem"
                },
                H5 = new H5Typography
                {
                    FontWeight = "700",
                    FontSize = "1.4rem"
                },
                Overline = new OverlineTypography
                {
                    FontSize = "0.8rem",
                    FontWeight = "500"
                },
                Subtitle2 = new Subtitle2Typography
                {
                    FontSize = "0.875rem",
                    FontWeight = "500"
                }
            }
        };
    }

    private PaletteLight GetLightPalette()
    {
        return new PaletteLight
        {
            Primary = "#2563EB",
            PrimaryLighten = "#3B82F6",
            PrimaryDarken = "#1D4ED8",
            Secondary = "#7C3AED",
            SecondaryLighten = "#8B5CF6",
            SecondaryDarken = "#6D28D9",
            Tertiary = "#059669",
            TertiaryLighten = "#10B981",
            TertiaryDarken = "#047857",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#F1F5F9",
            DrawerText = "#1E293B",
            DrawerIcon = "#2563EB",
            TextDisabled = "#94A3B8",
            ActionDefault = "#2563EB",
            ActionDisabled = "#CBD5E1",
            ActionDisabledBackground = "#F1F5F9",
            Divider = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            TableLines = "#E2E8F0",
            Info = "#0284C7",
            Success = "#059669",
            Warning = "#D97706",
            Error = "#DC2626",
            GrayLight = "#E2E8F0",
            GrayLighter = "#F1F5F9",
            OverlayLight = "#00000040",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private PaletteDark GetDarkPalette()
    {
        if (_selectedTheme == "morena")
        {
            return new PaletteDark
            {
                Primary = "#CD853F",
                PrimaryLighten = "#DEB887",
                PrimaryDarken = "#8B4513",
                Secondary = "#D2691E",
                SecondaryLighten = "#DEB887",
                SecondaryDarken = "#8B4513",
                Tertiary = "#6B8E23",
                Background = "#1A1209",
                Surface = "#2D1B0F",
                AppbarBackground = "#2D1B0F",
                AppbarText = "#F4E4C1",
                DrawerBackground = "#1A1209",
                DrawerText = "#F4E4C1",
                DrawerIcon = "#CD853F",
                TextDisabled = "#8B7355",
                ActionDefault = "#CD853F",
                ActionDisabled = "#5D3A1A",
                ActionDisabledBackground = "#3D2A1C",
                Divider = "#5D3A1A",
                LinesDefault = "#5D3A1A",
                TableLines = "#5D3A1A",
                Info = "#5F9EA0",
                Success = "#6B8E23",
                Warning = "#D97706",
                Error = "#B22222",
                GrayLight = "#5D3A1A",
                GrayLighter = "#3D2A1C",
                OverlayLight = "#1A120980",
                Black = "#000000",
                White = "#FFFFFF",
            };
        }

        return new PaletteDark
        {
            Primary = "#3B82F6",
            PrimaryLighten = "#60A5FA",
            PrimaryDarken = "#2563EB",
            Secondary = "#8B5CF6",
            SecondaryLighten = "#A78BFA",
            SecondaryDarken = "#7C3AED",
            Tertiary = "#10B981",
            TertiaryLighten = "#34D399",
            TertiaryDarken = "#059669",
            Background = "#0F172A",
            Surface = "#1E293B",
            AppbarBackground = "#1E293B",
            AppbarText = "#F8FAFC",
            DrawerBackground = "#0F172A",
            DrawerText = "#F8FAFC",
            DrawerIcon = "#3B82F6",
            TextDisabled = "#64748B",
            ActionDefault = "#3B82F6",
            ActionDisabled = "#475569",
            ActionDisabledBackground = "#1E293B",
            Divider = "#334155",
            LinesDefault = "#334155",
            TableLines = "#334155",
            Info = "#38BDF8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            GrayLight = "#334155",
            GrayLighter = "#1E293B",
            OverlayLight = "#0F172A80",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private string _version = "1.0.0";

    private class VersionApiResult
    {
        public string Version { get; set; } = string.Empty;
        public bool Success { get; set; }
    }

    private async Task LoadVersionAsync()
    {
        try
        {
            var versionResponse = await Http.GetFromJsonAsync<VersionApiResult>("api/Navigate/version");
            if (versionResponse != null && versionResponse.Success)
            {
                _version = versionResponse.Version;
            }
        }
        catch
        {
            _version = "1.0.0";
        }
    }
}

<style>
.modern-app-bar {
background: var(--mud-palette-appbar-background) !important;
border-bottom: 1px solid var(--mud-palette-divider);
padding: 2px 16px;
min-height: 40px;
backdrop-filter: blur(10px);
transition: all 0.3s ease;
}

/* Header height variable for easy reference */
:root {
--header-height: 40px;
}

.menu-toggle {
color: var(--mud-palette-text-secondary) !important;
transition: all 0.3s ease;
}

.menu-toggle:hover {
color: var(--mud-palette-primary) !important;
transform: scale(1.1);
}

.app-branding {
display: flex;
align-items: center;
gap: 12px;
margin-left: 8px;
}

.brand-icon {
color: var(--mud-palette-primary);
font-size: 28px;
animation: pulse 2s infinite;
}

@@keyframes pulse {
0%, 100% { transform: scale(1); }
50% { transform: scale(1.1); }
}

.app-title {
font-weight: 700;
color: var(--mud-palette-appbar-text) !important;
letter-spacing: 0.5px;
}

.title-accent {
color: var(--mud-palette-primary);
font-weight: 300;
}

    .global-search {
        margin: 0 16px;
        max-width: 400px;
        flex: 1;
    }

    .search-field .mud-input-control {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .search-field .mud-input-control:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(99, 102, 241, 0.5);
    }

    .search-field .mud-input-control.mud-focused {
        background: rgba(255, 255, 255, 0.15);
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .user-section {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-chip {
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #e2e8f0;
    }

    .theme-option {
        display: flex;
        align-items: center;
        gap: 12px;
    }
/* Estructura del layout con footer fijo */
.layout-root {
display: flex;
flex-direction: column;
min-height: 100vh;
}

.main-layout {
display: flex;
flex: 1;
min-height: calc(100vh - 40px - 30px); /* altura appbar - altura footer */
}

.content-area {
flex: 1;
display: flex;
flex-direction: column;
overflow-y: auto;
padding-bottom: 10px;
padding-top: 8px; /* Espacio adicional debajo del header */
margin-left: 60px; /* Ancho mínimo del drawer colapsado */
margin-top: 40px; /* Header height para que no oculte el contenido */
transition: margin-left 0.3s ease;
}

/* Cuando el drawer está abierto, agregar margen */
.content-area.drawer-open {
margin-left: 17%;
}

.content-wrapper {
flex: 1;
padding: 16px;
padding-top: 24px; /* Espacio adicional para que el header no oculte el contenido */
}

.version-footer {
    height: 30px;
    background-color: var(--mud-palette-surface);
    color: var(--mud-palette-text-secondary);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--mud-palette-lines-default);
    padding: 0 16px;
    flex-shrink: 0;
}

.version-footer span {
font-weight: 500;
margin-left: 8px;
color: var(--mud-palette-primary);
}

/* Contenedor para página de login - centrado sin sidebar */
.login-page-container {
display: flex;
justify-content: center;
align-items: center;
min-height: calc(100vh - 40px);
width: 100%;
}

/* Drawer sin padding para maximizar espacio */
.custom-drawer {
padding: 0 !important;
margin: 0 !important;
}

.custom-drawer > div {
padding: 0 !important;
}
</style>
