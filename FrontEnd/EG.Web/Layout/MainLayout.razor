@inherits LayoutComponentBase
@using EG.Domain.DTOs.Responses.Presupuestales
@inject NavigationManager NavigationManager
@inject SucursalStateService SucursalStateService
@inject AnioPresupuestalStateService AnioStateService
@inject IGenericCrudService<AniosResponse> AnioService
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<link href="/css/menu-overlays.css" rel="stylesheet" />
<script src="/js/download.js"></script>
<script src="/js/mudBlazorTheme.js"></script>

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="layout-root">
    <MudAppBar Elevation="0" Class="modern-app-bar">
        @if (!esPaginaLogin)
        {
            <MudIconButton Icon="@(_drawerOpen? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@((e) => DrawerToggle())"
                           class="menu-toggle" />
        }

        <div class="app-branding">
            <button type="button"
                    class="brand-home-button"
                    title="Ir a inicio"
                    aria-label="Ir a inicio"
                    @onclick="NavigateHome">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="brand-icon" />
            </button>
            <MudText Typo="Typo.h5" Class="app-title">EGestion<span class="title-accent">360</span></MudText>
        </div>

        <MudSpacer />
        
        @if (!esPaginaLogin)
        {
            <!-- Información del usuario y sucursal -->
            <div class="user-section">
                @if (!string.IsNullOrWhiteSpace(SucursalStateService.EmpresaNombre))
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Business"
                             class="user-chip">
                        @SucursalStateService.EmpresaNombre
                    </MudChip>
                }

                <MudSelect T="int?"
                           Value="@_selectedAnioId"
                           ValueChanged="OnAnioSeleccionado"
                           Label="Año"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="@_aniosLoading"
                           Class="anio-header-select"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.CalendarMonth">
                    @foreach (var anio in _anios)
                    {
                        <MudSelectItem T="int?" Value="@anio.PkidAnio">@anio.Clave</MudSelectItem>
                    }
                </MudSelect>

                <MudChip T="string" 
                         Color="Color.Secondary" 
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Store"
                         class="user-chip">
                    @(SucursalStateService.SucursalNombre ?? "Sin sucursal")
                </MudChip>
                
                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.Person">
                    @nombreUsuario
                </MudChip>
                
                <!-- Selector de tema -->
                <MudMenu Icon="@Icons.Material.Filled.Palette"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="theme-menu">
                    @foreach (var option in Enum.GetValues<ThemeOption>())
                    {
                        <MudMenuItem OnClick="@(() => SelectThemeOption(option))">
                            <div class="theme-option">
                                @if (option == ThemeOption.Claro)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.LightMode" />
                                }
                                else if (option == ThemeOption.Oscuro)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.DarkMode" />
                                }
                                else if (option == ThemeOption.Morena)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Park" Style="color: #8B4513;" />
                                }
                                <span>@option.ToString()</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>
                
                <!-- Menú de usuario -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                         Color="Color.Inherit" 
                         AnchorOrigin="Origin.BottomRight" 
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="@Logout">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesión
                    </MudMenuItem>
                </MudMenu>
            </div>
        }
    </MudAppBar>

    @if (!esPaginaLogin)
    {
        <div class="page-body">
            <div class="sidebar-container @(_drawerOpen ? "expanded" : "collapsed")">
                <DynamicMenu IsCollapsed="!_drawerOpen" />
            </div>
            <main class="main-content">
                <div class="content-wrapper">
                    @Body
                </div>
            </main>
        </div>
        
        <div class="version-footer">
            Versión: <span>@_version</span>
        </div>
    }
    else
    {
        <div class="login-page-container">
            @Body
        </div>
    }
</div>

    <div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">??</a>
</div>

@code {
    public enum ThemeOption
    {
        Claro,
        Oscuro,
        Morena
    }

    private MudThemeProvider _themeProvider = null!;
    private ThemeOption _selectedThemeOption { get; set; } = ThemeOption.Oscuro;

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private string _selectedTheme = "default";
    private MudTheme _theme = new MudTheme();
    private string nombreUsuario = "Usuario";
    private List<AniosResponse> _anios = new();
    private int? _selectedAnioId;
    private bool _aniosLoading;
    private bool esPaginaLogin => NavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

protected override async Task OnInitializedAsync()
{
base.OnInitialized();
OnThemeOptionChanged();
await CargarUsuarioAsync();
await SucursalStateService.InitializeAsync();
if (!esPaginaLogin)
{
await AnioStateService.InitializeAsync();
await LoadAniosAsync();
}
await LoadVersionAsync();
SucursalStateService.OnSucursalChanged += OnSucursalChanged;
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
if (firstRender)
{
await ApplyMenuThemeClass();
}
}

    private void OnSucursalChanged(int sucursalId, string sucursalNombre)
    {
        StateHasChanged();
    }

    private async Task LoadAniosAsync()
    {
        try
        {
            _aniosLoading = true;
            var response = await AnioService.GetAllPaginadoAsync(1, 100, string.Empty, "Clave", SortDirection.Descending);
            _anios = response?.Items?.Where(x => x.Activo).OrderByDescending(x => x.Clave).ToList() ?? new List<AniosResponse>();

            if (!_anios.Any())
                return;

            var selected = _anios.FirstOrDefault(x => x.PkidAnio == AnioStateService.AnioId)
                ?? _anios.FirstOrDefault(x => x.Clave == DateTime.Today.Year)
                ?? _anios.First();

            _selectedAnioId = selected.PkidAnio;
            if (AnioStateService.AnioId != selected.PkidAnio)
                await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
        }
        catch
        {
            _anios = new List<AniosResponse>();
        }
        finally
        {
            _aniosLoading = false;
        }
    }

    private async Task OnAnioSeleccionado(int? anioId)
    {
        _selectedAnioId = anioId;
        var selected = _anios.FirstOrDefault(x => x.PkidAnio == anioId);
        if (selected == null)
        {
            await AnioStateService.ClearAnioAsync();
            return;
        }

        await AnioStateService.SetAnioAsync(selected.PkidAnio, selected.Clave, selected.Descripcion);
    }

    private async Task CargarUsuarioAsync()
    {
        try
        {
            var userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userName");
            if (!string.IsNullOrEmpty(userName))
            {
                nombreUsuario = userName;
            }
            else
            {
                var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
                if (!string.IsNullOrEmpty(userId))
                {
                    nombreUsuario = $"ID: {userId}";
                }
            }
        }
        catch { }
    }

    private async Task Logout()
    {
        NavigationManager.NavigateTo("/login", forceLoad: true);
        await Task.CompletedTask;
    }

private async Task SelectThemeOption(ThemeOption option)
{
_selectedThemeOption = option;
OnThemeOptionChanged();
await InvokeAsync(StateHasChanged);
await JSRuntime.InvokeVoidAsync("mudBlazorTheme.applyTheme");

// Forzar actualización del menú - aplicar clase morena si corresponde
await Task.Delay(100); // Esperar a que el DOM se actualice
await ApplyMenuThemeClass();
}

private async Task ApplyMenuThemeClass()
{
try
{
if (_selectedTheme == "morena")
{
await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('.professional-nav-menu').forEach(el => el.classList.add('morena'))");
}
else
{
await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('.professional-nav-menu').forEach(el => el.classList.remove('morena'))");
}
}
catch { }
}

    private void OnThemeOptionChanged()
    {
        switch (_selectedThemeOption)
        {
            case ThemeOption.Claro:
                _isDarkMode = false;
                _selectedTheme = "default";
                break;
            case ThemeOption.Oscuro:
                _isDarkMode = true;
                _selectedTheme = "default";
                break;
            case ThemeOption.Morena:
                _isDarkMode = true;
                _selectedTheme = "morena";
                break;
        }
        LoadTheme();
    }

    private void LoadTheme()
    {
        _theme = new MudTheme
        {
            PaletteLight = GetLightPalette(),
            PaletteDark = GetDarkPalette(),
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "10px"
            },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Segoe UI", "Roboto", "Arial", "sans-serif" },
                    FontSize = "0.95rem"
                },
                H5 = new H5Typography
                {
                    FontWeight = "700",
                    FontSize = "1.4rem"
                },
                Overline = new OverlineTypography
                {
                    FontSize = "0.8rem",
                    FontWeight = "500"
                },
                Subtitle2 = new Subtitle2Typography
                {
                    FontSize = "0.875rem",
                    FontWeight = "500"
                }
            }
        };
    }

    private PaletteLight GetLightPalette()
    {
        return new PaletteLight
        {
            Primary = "#2563EB",
            PrimaryLighten = "#3B82F6",
            PrimaryDarken = "#1D4ED8",
            Secondary = "#7C3AED",
            SecondaryLighten = "#8B5CF6",
            SecondaryDarken = "#6D28D9",
            Tertiary = "#059669",
            TertiaryLighten = "#10B981",
            TertiaryDarken = "#047857",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#F1F5F9",
            DrawerText = "#1E293B",
            DrawerIcon = "#2563EB",
            TextDisabled = "#94A3B8",
            ActionDefault = "#2563EB",
            ActionDisabled = "#CBD5E1",
            ActionDisabledBackground = "#F1F5F9",
            Divider = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            TableLines = "#E2E8F0",
            Info = "#0284C7",
            Success = "#059669",
            Warning = "#D97706",
            Error = "#DC2626",
            GrayLight = "#E2E8F0",
            GrayLighter = "#F1F5F9",
            OverlayLight = "#00000040",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private PaletteDark GetDarkPalette()
    {
        if (_selectedTheme == "morena")
        {
            return new PaletteDark
            {
                Primary = "#CD853F",
                PrimaryLighten = "#DEB887",
                PrimaryDarken = "#8B4513",
                Secondary = "#D2691E",
                SecondaryLighten = "#DEB887",
                SecondaryDarken = "#8B4513",
                Tertiary = "#6B8E23",
                Background = "#1A1209",
                Surface = "#2D1B0F",
                AppbarBackground = "#2D1B0F",
                AppbarText = "#F4E4C1",
                DrawerBackground = "#1A1209",
                DrawerText = "#F4E4C1",
                DrawerIcon = "#CD853F",
                TextDisabled = "#8B7355",
                ActionDefault = "#CD853F",
                ActionDisabled = "#5D3A1A",
                ActionDisabledBackground = "#3D2A1C",
                Divider = "#5D3A1A",
                LinesDefault = "#5D3A1A",
                TableLines = "#5D3A1A",
                Info = "#5F9EA0",
                Success = "#6B8E23",
                Warning = "#D97706",
                Error = "#B22222",
                GrayLight = "#5D3A1A",
                GrayLighter = "#3D2A1C",
                OverlayLight = "#1A120980",
                Black = "#000000",
                White = "#FFFFFF",
            };
        }

        return new PaletteDark
        {
            Primary = "#3B82F6",
            PrimaryLighten = "#60A5FA",
            PrimaryDarken = "#2563EB",
            Secondary = "#8B5CF6",
            SecondaryLighten = "#A78BFA",
            SecondaryDarken = "#7C3AED",
            Tertiary = "#10B981",
            TertiaryLighten = "#34D399",
            TertiaryDarken = "#059669",
            Background = "#0F172A",
            Surface = "#1E293B",
            AppbarBackground = "#1E293B",
            AppbarText = "#F8FAFC",
            DrawerBackground = "#0F172A",
            DrawerText = "#F8FAFC",
            DrawerIcon = "#3B82F6",
            TextDisabled = "#64748B",
            ActionDefault = "#3B82F6",
            ActionDisabled = "#475569",
            ActionDisabledBackground = "#1E293B",
            Divider = "#334155",
            LinesDefault = "#334155",
            TableLines = "#334155",
            Info = "#38BDF8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            GrayLight = "#334155",
            GrayLighter = "#1E293B",
            OverlayLight = "#0F172A80",
            Black = "#000000",
            White = "#FFFFFF",
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private string _version = "1.0.0";

    private class VersionApiResult
    {
        public string Version { get; set; } = string.Empty;
        public bool Success { get; set; }
    }

    private async Task LoadVersionAsync()
    {
        try
        {
            var versionResponse = await Http.GetFromJsonAsync<VersionApiResult>("api/Navigate/version");
            if (versionResponse != null && versionResponse.Success)
            {
                _version = versionResponse.Version;
            }
        }
        catch
        {
            _version = "1.0.0";
        }
    }
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100vh;
        overflow: hidden;
    }

    .layout-root {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .modern-app-bar {
        background: var(--mud-palette-appbar-background) !important;
        border-bottom: 1px solid var(--mud-palette-divider);
        padding: 2px 16px;
        min-height: 40px;
        flex-shrink: 0;
        z-index: 10;
    }

    .app-branding {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .brand-home-button {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: inherit;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .brand-home-button:hover {
        background: var(--mud-palette-action-default-hover);
        transform: translateY(-1px);
    }

    .brand-home-button:focus-visible {
        outline: 2px solid var(--mud-palette-primary);
        outline-offset: 2px;
    }

    .brand-icon {
        font-size: 1.5rem;
        color: var(--mud-palette-primary);
    }

    .app-title {
        font-weight: 700;
        color: var(--mud-palette-appbar-text);
    }

    .title-accent {
        color: var(--mud-palette-primary);
    }

    .menu-toggle {
        min-width: 36px;
    }

    .user-section {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .anio-header-select {
        width: 130px;
        flex-shrink: 0;
    }

    .anio-header-select .mud-input-control {
        margin-top: 0;
    }

    .user-chip {
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #e2e8f0;
    }

    .theme-option {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .page-body {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
        padding-top: 40px;
    }

    .sidebar-container {
        width: 270px;
        flex-shrink: 0;
        background: var(--mud-palette-drawer-background);
        border-right: 1px solid var(--mud-palette-divider);
        overflow: hidden;
        transition: width 0.3s ease;
        align-self: stretch;
    }

    .sidebar-container.collapsed {
        width: 64px;
    }

    .sidebar-container.expanded {
        width: 270px;
    }

    .main-content {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        background: var(--mud-palette-background);
        min-height: 0;
    }

    .content-wrapper {
        padding: 24px;
        padding-top: 16px;
        min-height: 100%;
    }

    .version-footer {
        height: 30px;
        background-color: var(--mud-palette-surface);
        color: var(--mud-palette-text-secondary);
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-top: 1px solid var(--mud-palette-lines-default);
        padding: 0 16px;
        flex-shrink: 0;
    }

    .version-footer span {
        font-weight: 500;
        margin-left: 8px;
        color: var(--mud-palette-primary);
    }

    .login-page-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: calc(100vh - 40px - 30px);
        width: 100%;
        flex: 1;
    }
</style>
