            SecondaryContrastText = "#FFFFFF",
            SecondaryLighten = "#64748B",
            SecondaryDarken = "#334155",
            Tertiary = "#0F766E",
            TertiaryContrastText = "#FFFFFF",
            TertiaryLighten = "#15958A",
            TertiaryDarken = "#0A554F",
            Background = "#F7F9FC",
