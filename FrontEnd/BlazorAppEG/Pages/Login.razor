@page "/"
@inject BlazorAppEG.Services.LoginService LoginService

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Login EGestion360</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
            
            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">@resultMessage</MudAlert>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnLoginClick" FullWidth="true" Disabled="isLoading">
                @(isLoading ? "Conectando..." : "Ingresar")
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private string email = "";
    private string password = "";
    private string resultMessage = "";
    private bool isLoading = false;

    private async Task OnLoginClick()
    {
        isLoading = true;
        resultMessage = "Llamando al backend...";
        StateHasChanged();
        
        resultMessage = await LoginService.LoginAsync(email, password);
        
        isLoading = false;
        StateHasChanged();
    }
}
